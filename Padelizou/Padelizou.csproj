<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>287393b4-5141-4aed-8644-93a3dfeeb932</UserSecretsId>

    <!-- NENHUMA pasta de build entra como conteúdo do projeto.
         O MSBuild exclui sozinho a pasta de saída DA VEZ, e só ela. Como aqui cada sessão
         compila numa pasta própria (`-p:BaseOutputPath=bin/<sessao>/`, pra não brigar pelo
         bin/Debug), a saída de uma virava CONTEÚDO da outra: bin/opus dentro de bin/fable,
         bin/fable dentro de bin/nata2, e assim por diante, até o caminho passar dos 260
         caracteres do Windows e o build parar de compilar com um erro de CÓPIA DE ARQUIVO —
         que não parece, mas é isto aqui. Aconteceu três vezes em 08/08/2026. -->
    <DefaultItemExcludesInProjectFolder>bin/**;obj/**</DefaultItemExcludesInProjectFolder>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Apis.Auth" Version="1.75.0" />
    <PackageReference Include="Google.Apis.Calendar.v3" Version="1.75.0.4206" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Design" Version="10.0.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- Só pra desenhar o QR do Pix copia e cola. PngByteQRCode não depende de System.Drawing,
         então roda igual no Windows daqui e no Linux do VPS. -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="SkiaSharp" Version="4.150.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.150.1" />
    <PackageReference Include="WebPush" Version="1.0.13" />
  </ItemGroup>

</Project>
