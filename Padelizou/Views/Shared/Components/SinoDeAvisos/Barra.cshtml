@model int
@{
    var teto = ViewBag.Teto as int? ?? 9;
    var rotulo = Model > teto ? $"{teto}+" : Model.ToString();
}

@*
    O SINO FORA DO SANDUÍCHE.

    O do menu (Default.cshtml) só é visto por quem ABRE o menu — e no celular, que é onde este
    produto é usado, o menu nasce fechado: a bolinha de "3 avisos novos" ficava escondida atrás
    do ícone de três linhas. Na prática o aviso mais importante do dia só era encontrado por
    quem já sabia que ele existia.

    Aqui ele fica na barra, ao lado do sanduíche, visível ao entrar em qualquer tela. Some no
    desktop (d-xl-none no layout), onde o menu já está aberto e o item "Avisos" aparece nele —
    e onde a barra não tem folga pra mais um ícone (ver o comentário de largura em .pdz-voltar).
*@
<a class="pdz-sino-barra" asp-controller="Notificacoes" asp-action="Index"
   title="@(Model == 0 ? "Notificações" : $"{Model} aviso(s) não lido(s)")"
   aria-label="@(Model == 0 ? "Notificações" : $"Notificações, {Model} não lidos")">
    <i class="bi @(Model > 0 ? "bi-bell-fill" : "bi-bell")"></i>
    @if (Model > 0)
    {
        <span class="pdz-sino-bolinha">@rotulo</span>
    }
</a>
