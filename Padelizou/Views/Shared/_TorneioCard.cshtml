@model Padelizou.Models.Torneio
@{
    var aberto = Model.Status == "Inscrições Abertas";
    var textoBotao = aberto ? "Ver Torneio e Inscrever-se" : (Model.Status == "Finalizado" ? "Ver Resultado" : "Ver Torneio");

    // QUANDO é a primeira pergunta de quem bate o olho num torneio — antes do preço e até
    // do lugar. A formatação saiu daqui e virou Services/DataDoTorneioNaTela quando a página
    // do torneio passou a mostrar a data também: eram duas telas pra uma regra só.
    var quando = Padelizou.Services.DataDoTorneioNaTela.Frase(Model);
}
<div class="col" data-torneio-nome="@Model.Nome.ToLower()">
    <div class="card h-100 shadow-sm border-0 overflow-hidden">
        @* A CAPA APARECE INTEIRA (Felipe, 08/08/2026: "o folder sempre fica cortado").
           Era `object-fit: cover`, que preenche a caixa cortando o que sobra — e o que sobra
           num folder de torneio é justamente a informação: no "Americano das Gurias" sumiam a
           faixa de cima e o troféu de baixo; no NATA PADEL TOUR, as pontas do escudo.

           Agora a arte cabe inteira (`contain`) sobre uma cópia dela mesma borrada e ampliada,
           que preenche o resto. O fundo borrado existe pra que a sobra não vire duas tarjas
           lisas: a capa continua ocupando o mesmo retângulo e a cor do fundo sai da própria
           arte, seja ela vertical, quadrada ou um banner deitado.

           A altura é FIXA e vive no CSS junto com o caso sem capa: card de altura variável
           desalinharia a grade, e os dois ramos precisam medir igual. *@
        @if (!string.IsNullOrEmpty(Model.ImagemCapa))
        {
            <div class="pdz-capa-torneio">
                <img class="pdz-capa-fundo" src="@Model.ImagemCapa" alt="" aria-hidden="true" />
                <img class="pdz-capa-arte" src="@Model.ImagemCapa" alt="Capa do torneio @Model.Nome" />
            </div>
        }
        else
        {
            <div class="pdz-capa-torneio pdz-capa-vazia">
                @* Fundo é o gradiente navy fixo: disco escuro sumiria — vão as raquetes soltas. *@
                <img src="~/image/logo-raquetes.webp" asp-append-version="true" alt="" class="pdz-capa-marca" />
            </div>
        }

        <div class="card-body">
            @* Sem o selo, o cancelado fica idêntico a um torneio de pé na lista de quem
               organiza — e é justamente ele que não pode ser confundido. *@
            @if (Padelizou.Services.CancelamentoDoTorneio.EstaCancelado(Model.Status))
            {
                <span class="badge bg-danger mb-2">Cancelado</span>
            }
            @* Mesma ideia do selo acima: este card só chega às mãos de quem organiza (a
               listagem esconde o oculto de todo mundo), e sem o selo ele fica idêntico a um
               torneio no ar — o organizador conferiria a lista, veria o torneio lá e concluiria
               que está divulgado. *@
            @if (Model.Oculto)
            {
                <span class="badge bg-secondary mb-2"><i class="bi bi-eye-slash-fill"></i> Oculto</span>
            }
            <h5 class="card-title fw-bold" style="color: var(--pdz-ink);">@Model.Nome</h5>
            <p class="card-text small mb-1 fw-semibold" style="color: var(--pdz-ink);">
                <i class="bi bi-calendar-event"></i> @quando
            </p>
            <p class="card-text text-muted small mb-1">
                <i class="bi bi-geo-alt-fill"></i> Local: @(string.IsNullOrEmpty(Model.LocalTorneio) ? "A definir" : Model.LocalTorneio)
            </p>
            <p class="card-text text-muted small mb-1">
                <i class="bi bi-cash"></i> Inscrição: @Model.PrecoInscricao.ToString("C")
            </p>
            @* ATÉ QUANDO DÁ PRA ENTRAR (Felipe, 04/09/2026). O campo já existia e já vinha
               preenchido, mas só aparecia na página do torneio — e é AQUI que a pessoa decide
               se clica. A frase vem do serviço, o mesmo que a página usa: duas cópias da
               mesma regra divergem na primeira mudança (foi o que fez o DataDoTorneioNaTela
               nascer).

               Perto do prazo ela conta os dias, e é por isso que ganha destaque: nesse ponto
               a linha deixa de ser informação e vira motivo pra clicar hoje. *@
            @if (Padelizou.Services.PrazoDaInscricaoNaTela.Frase(Model, DateTime.Today) is { } prazoDaInscricao)
            {
                <p class="card-text small mb-0 fw-semibold text-warning-emphasis">
                    <i class="bi bi-hourglass-split"></i> @prazoDaInscricao
                </p>
            }
        </div>
        <div class="card-footer bg-white border-0 pb-3 text-center">
            <a asp-controller="Torneios" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-padel w-100 rounded-pill">
                <i class="bi bi-card-checklist me-2"></i> @textoBotao
            </a>
        </div>
    </div>
</div>
