@model Padelizou.ViewModels.OnboardingVM
@*
    Primeiros passos. Só aparece enquanto houver passo pendente — quando o jogador termina
    tudo, o cartão some sozinho e o painel fica limpo.
*@
@if (!Model.Completo)
{
    var proximo = Model.Proximo!;

    <div class="card border-0 shadow-sm mb-4" style="border-left: 4px solid var(--padel-green) !important;">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <h6 class="fw-bold mb-0" style="color: var(--pdz-ink);">
                    <i class="bi bi-rocket-takeoff"></i> Primeiros passos
                </h6>
                <span class="badge rounded-pill" style="background: var(--padel-green); color: #14261a;">
                    @Model.Concluidos de @Model.Total
                </span>
            </div>

            <div class="progress mb-3" style="height: 6px;">
                <div class="progress-bar" role="progressbar"
                     style="width: @Model.Percentual%; background: var(--padel-green);"
                     aria-valuenow="@Model.Percentual" aria-valuemin="0" aria-valuemax="100"></div>
            </div>

            @* O próximo passo ganha destaque; os outros ficam na lista abaixo. *@
            <div class="d-flex align-items-center gap-3 p-3 rounded-3 mb-2" style="background: rgba(139,195,74,.10);">
                <i class="bi @proximo.Icone fs-3" style="color: var(--padel-green);"></i>
                <div class="flex-grow-1">
                    <div class="fw-bold" style="color: var(--pdz-ink);">@proximo.Titulo</div>
                    <div class="small text-muted">@proximo.Explicacao</div>
                </div>
                @if (proximo.Controller != null)
                {
                    <a asp-controller="@proximo.Controller" asp-action="@proximo.Action"
                       class="btn btn-sm btn-padel rounded-pill px-3 fw-bold text-nowrap">@proximo.TextoBotao</a>
                }
            </div>

            <ul class="list-unstyled mb-0 small">
                @foreach (var passo in Model.Passos.Where(p => p != proximo))
                {
                    <li class="d-flex align-items-center gap-2 py-1 @(passo.Concluido ? "text-muted" : "")">
                        <i class="bi @(passo.Concluido ? "bi-check-circle-fill" : "bi-circle")"
                           style="@(passo.Concluido ? "color: var(--padel-green);" : "opacity:.35;")"></i>
                        <span style="@(passo.Concluido ? "text-decoration: line-through;" : "")">@passo.Titulo</span>
                        @if (!passo.Concluido && passo.Controller != null)
                        {
                            <a asp-controller="@passo.Controller" asp-action="@passo.Action"
                               class="ms-auto text-decoration-none small">@passo.TextoBotao →</a>
                        }
                    </li>
                }
            </ul>
        </div>
    </div>
}
