@model Padelizou.Services.PalpiteirosDoTorneio
@*
    O RANKING DO PALPITÔMETRO — pódio, régua de pontos e tabela. NÃO inclui o nome do torneio
    nem a contagem de "jogos apurados": quem chama decide como apresentar esses dois, porque
    um já sabe em que torneio está (a aba dentro da própria página) e o outro precisa dizer
    (a página cheia, que pode ser aberta direto de um link).

    Extraído de Views/Torneios/Palpiteiros.cshtml (07/09/2026) pra ser a TERCEIRA tela que
    mostra o mesmo ranking, sem virar a terceira cópia: a página cheia
    (/Torneios/Palpiteiros), a aba do hub do Ranking, e agora a aba "Palpiteiros" dentro da
    própria página do torneio (pedido do Felipe: "deixe uma aba no torneio pra verificar o
    ranking do palpitômetro"). As três já dividiam `_TabelaDePalpiteiros`; faltava dividir o
    pódio e a régua também.
*@
@{
    var podio = Model.Linhas.Where(l => l.Posicao <= 3).ToList();
    var lider = Model.Linhas.FirstOrDefault();

    // A tela só fala em PLACAR quando alguém deste torneio palpitou placar. Num torneio em que
    // ninguém teve essa opção, "cravar o placar vale 3" ensina um jeito de pontuar que não
    // existia ali — e a coluna de cravadas seria uma fileira de zeros.
    bool comPlacar = Model.PalpitesComPlacar > 0;
}

@* ── O RECORTE DE FASE ──────────────────────────────────────────────────────────────────
   12/09/2026 — 🗣️ Felipe: *"também no palpitometro, colocar um filtro 'por chaves' 'Por mata
   mata' 'Apenas finais'"*.

   ⚠️ VEM ANTES DO PÓDIO de propósito: o recorte é um RANKING PRÓPRIO (escolha do Felipe), e
   quem muda é a tabela INTEIRA — pódio, régua e posições. Botão embaixo do pódio faria o
   leitor ver o campeão do torneio e só depois descobrir que podia recortar.

   ⚠️ LINK, e não botão de JS: esta conta é do SERVIDOR. Os pontos do mata-mata são outra
   apuração, não um subconjunto de linhas — um `onclick` prometeria filtro instantâneo e
   entregaria o número do torneio inteiro debaixo do rótulo da fase.

   ⚠️ A URL PRESERVA A QUERY QUE JÁ ESTAVA LÁ (os filtros de jogos do Details, por exemplo) e
   troca só o `fasePalpiteiros`. Montar de novo do zero apagaria o resto sem avisar.

   ⚠️ E A ÂNCORA VEM DE QUEM CHAMA: dentro da página do torneio o link tem que voltar pra ABA
   dos palpiteiros (`#palpiteiros`), senão filtrar joga o leitor no topo, na primeira aba. Na
   página cheia não há aba, e ela não manda âncora nenhuma.

   ⚠️ E NÃO É O `manter-posicao-na-lista.js` (12/09/2026, PR #274, "filtrar não joga mais a
   página pro topo") de propósito: aquele mecanismo é pra POST → redirect → GET de FORMULÁRIO,
   com memória em sessionStorage e opt-in no `<form>`. Aqui o recorte é navegação por LINK, e a
   âncora do próprio navegador já faz o trabalho — sem JS, sem memória, e funcionando com o
   link colado no WhatsApp, que é o caso que a página cheia existe pra atender. *@
@if (Model.MostrarFiltroDeFase)
{
    var ancora = ViewData["AncoraDosPalpiteiros"] as string ?? "";
    var demaisParametros = Context.Request.Query
        .Where(p => p.Key != "fasePalpiteiros")
        .SelectMany(p => p.Value.Select(valor => $"{Uri.EscapeDataString(p.Key)}={Uri.EscapeDataString(valor ?? "")}"))
        .ToList();

    string UrlDoRecorte(string recorte)
    {
        var partes = new List<string>(demaisParametros);
        // "Todas as fases" é o padrão: ele sai da URL em vez de virar `?fasePalpiteiros=tudo`.
        if (recorte != Padelizou.Services.FaseDoPalpitometro.Tudo)
            partes.Add("fasePalpiteiros=" + recorte);

        return Context.Request.Path
            + (partes.Count > 0 ? "?" + string.Join("&", partes) : "")
            + ancora;
    }

    <div class="pdz-filtro-de-fase btn-group btn-group-sm mb-3 flex-wrap" role="group"
         aria-label="Recortar o ranking por fase">
        @foreach (var recorte in Model.RecortesComJogo)
        {
            bool aceso = recorte == Model.Recorte;
            <a href="@UrlDoRecorte(recorte)" class="btn btn-outline-secondary @(aceso ? "active" : "")"
               aria-current="@(aceso ? "true" : null)">@Padelizou.Services.FaseDoPalpitometro.Rotulo(recorte)</a>
        }
    </div>

    @if (Model.Recorte != Padelizou.Services.FaseDoPalpitometro.Tudo)
    {
        @* ⚠️ A TELA DIZ QUE ESTÁ RECORTADA. Sem esta linha, um pódio de três nomes com 3 pontos
           parece o ranking do torneio inteiro com a conta quebrada — e quem chega por link
           compartilhado não viu ninguém clicar em botão nenhum. *@
        <p class="small text-muted mb-3">
            <i class="bi bi-funnel"></i>
            Só <strong>@Padelizou.Services.FaseDoPalpitometro.NaFrase(Model.Recorte)</strong> —
            os pontos, os acertos e as posições aqui são só desta parte do torneio.
        </p>
    }
}

@* ── O PÓDIO ────────────────────────────────────────────────────────────────────────────
   Só quando há gente com ponto: um pódio de zeros anuncia campeão de nada. *@
@if (lider != null && lider.Pontos > 0)
{
    <div class="card border-0 shadow-sm rounded-4 mb-4" style="background: var(--pdz-navy-fixed);">
        <div class="card-body text-center py-4 text-white">
            <div class="small text-uppercase mb-3" style="letter-spacing:.12em; color: var(--padel-green);">
                Quem mais acertou
            </div>

            <div class="d-flex justify-content-center align-items-end gap-3 flex-wrap">
                @foreach (var p in podio)
                {
                    bool primeiro = p.Posicao == 1;
                    int tamanho = primeiro ? 88 : 64;
                    <div style="width: @(tamanho + 56)px; max-width: 30vw;">
                        <img src="@(string.IsNullOrEmpty(p.Foto) ? "/img/default-avatar.png" : p.Foto)"
                             alt="" class="rounded-circle mb-2"
                             style="width:@(tamanho)px;height:@(tamanho)px;object-fit:cover;border:3px solid @(primeiro ? "var(--padel-green)" : "rgba(255,255,255,.35)");" />
                        <div class="small fw-bold text-truncate" title="@p.Nome">@p.Nome</div>
                        <div class="small" style="color: var(--padel-green);">
                            @p.Pontos @(p.Pontos == 1 ? "ponto" : "pontos")
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

@* ── ANTES DO PRIMEIRO RESULTADO ────────────────────────────────────────────────────────
   🗣️ Felipe, 10/09/2026, com o torneio no ar e 41 jogos já votados: *"acho que o ranking do
   palpitometro ja tem que aparecer"*. Aparece — e diz, na primeira linha, que ainda não é
   ranking: uma tabela de zeros sem esta frase parece conta quebrada, não véspera. *@
@if (Model.ModoParticipacao)
{
    <div class="alert alert-success border-0 rounded-4 small">
        <i class="bi bi-hourglass-split"></i>
        <strong>Ainda não há jogo apurado.</strong>
        A pontuação começa quando o <strong>primeiro jogo</strong> terminar — por enquanto, quem
        já palpitou:
        <strong>@Model.PalpitesEmAberto @(Model.PalpitesEmAberto == 1 ? "palpite" : "palpites")</strong>
        esperando resultado.
    </div>
}

@* ── A RÉGUA, ANTES DA TABELA ───────────────────────────────────────────────────────────
   ⚠️ Ela vem PRIMEIRO de propósito. Sem ela, quem vê um 100% de aproveitamento ABAIXO
   de um 75% conclui que a conta quebrou — e conta que parece quebrada é conta em que
   ninguém confia, por mais certa que esteja. *@
<div class="alert alert-light border rounded-4 small">
    <strong>Como conta:</strong>
    @if (comPlacar)
    {
        <text>
            cravar o placar vale <strong>@Padelizou.Services.PontosDoPalpite.Cravou</strong>,
            chegar perto (errar por um game) vale <strong>@Padelizou.Services.PontosDoPalpite.ChegouPerto</strong>,
            acertar só quem venceu vale <strong>@Padelizou.Services.PontosDoPalpite.SoOVencedor</strong>,
            e errar o vencedor vale <strong>0</strong>.
        </text>
    }
    else
    {
        <text>
            cada jogo em que você acertou quem venceu vale
            <strong>@Padelizou.Services.PontosDoPalpite.SoOVencedor</strong> ponto; errar vale <strong>0</strong>.
        </text>
    }
    <div class="text-muted mt-1">
        Ganha quem soma <strong>mais pontos</strong> — quem acerta 9 de 11 fica na frente de
        quem acerta 8 de 8. O aproveitamento só desempata. Quem está em quadra não pontua no
        próprio jogo.
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body">
        @* O `TorneioId` é o que faz o nome abrir "o que esta pessoa palpitou" (12/09/2026) —
           sem ele, a tabela do hub continua mandando o nome pro perfil. *@
        <partial name="_TabelaDePalpiteiros"
                 model='@(new Padelizou.ViewModels.TabelaDePalpiteirosVM(Model.Linhas, Model.EuId, comPlacar, Model.PalpitesEmAberto > 0, !Model.ModoParticipacao, Model.TorneioId))' />
    </div>
</div>

<p class="text-muted small mt-3 mb-0">
    A conta é refeita a cada visita, direto dos palpites e dos placares — placar corrigido
    pelo organizador acerta o ranking sozinho.
</p>
