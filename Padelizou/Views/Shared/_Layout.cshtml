@using System.Security.Claims
@using Padelizou.Middleware
@inject Microsoft.Extensions.Options.IOptions<Padelizou.Services.BetaSettings> BetaOpcoes
@inject Microsoft.Extensions.Options.IOptions<Padelizou.Services.SuporteSettings> SuporteOpcoes
@inject IWebHostEnvironment Ambiente
@{
    var beta = BetaOpcoes.Value;
    var suporte = SuporteOpcoes.Value;
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    string NavActive(params string[] controllers) => controllers.Contains(currentController) ? "active" : "";
    var nomeUsuario = User.Identity?.IsAuthenticated == true ? User.FindFirstValue(ClaimTypes.Name) : null;
    var meuId = User.Identity?.IsAuthenticated == true ? User.FindFirstValue(ClaimTypes.NameIdentifier) : null;
    var minhaFoto = User.Identity?.IsAuthenticated == true ? User.FindFirstValue("FotoPerfil") : null;
    var souProfessor = User.Identity?.IsAuthenticated == true && User.FindFirstValue("IsProfessor") == "true";
    var souAdmin = User.Identity?.IsAuthenticated == true && User.FindFirstValue("IsAdmin") == "true";

    @* ASSISTENTE DO SISTEMA: vê tudo, não muda nada. A credencial é SEPARADA do IsAdmin de
       propósito — somá-las abriria os caminhos de escrita junto. Ver Services/PoderesNoSistema.

       O menu do painel abre pra ele (souAdmin || souAssistente) porque "ver tudo" sem achar a
       porta não é ver nada; quem recusa a escrita é o servidor, não este menu. *@
    var souAssistente = User.Identity?.IsAuthenticated == true && User.FindFirstValue("Assistente") == "true";
    var souSoOlhando = souAssistente && !souAdmin;

    @* O painel mora num subdomínio só dele em produção (ver AdminHostMiddleware), então "onde
       estou" muda o que a barra pode oferecer. *@
    var ehDesenvolvimento = Ambiente.IsDevelopment();
    var dentroDoPainel = AdminHostMiddleware.ServeSoOPainel(ViewContext.HttpContext, ehDesenvolvimento);
    var linkPainelAdmin = AdminHostMiddleware.LinkDoPainel(ViewContext.HttpContext, ehDesenvolvimento);
    @* Dentro do painel, link relativo pro site cai no 404 do próprio host: os poucos que
       sobram (rodapé) precisam apontar pra fora. Fora dali fica nulo = link relativo normal. *@
    var hostDoSite = dentroDoPainel ? AdminHostMiddleware.SitePublicoHost : null;
    var protocoloDoSite = dentroDoPainel ? "https" : null;

    @* A mensagem já sai identificando quem é: do outro lado chega um número desconhecido, e
       saber o nome antes de responder economiza a primeira pergunta de toda conversa. *@
    var linkContato = Padelizou.Services.WhatsAppLinkHelper.GerarLink(suporte.WhatsApp,
        string.IsNullOrWhiteSpace(nomeUsuario)
            ? "Olá! Estou no site do Padelizou e queria falar com vocês."
            : $"Olá! Aqui é {nomeUsuario}, do Padelizou.");
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <script>
        (function () {
            var tema = localStorage.getItem('pdz-theme');
            if (!tema) {
                tema = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            }
            document.documentElement.setAttribute('data-bs-theme', tema);
        })();
    </script>
    <meta charset="utf-8" />
    @* viewport-fit=cover: instalado no iPhone, o app ocupa a tela toda, inclusive atrás do
       "furo" da câmera e da barrinha de baixo. Quem devolve o espaço é o env(safe-area-*)
       no site.css — sem ele o menu ficaria embaixo do relógio. *@
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    @*
        Home fica só "Padelizou"; internas viram "Página - Padelizou".
        Boa parte das views já escreve "- Padelizou" no próprio Title (e virava
        "Entrar - Padelizou - Padelizou"), então só completamos quando falta.
    *@
    @{
        var tituloPagina = (ViewData["Title"] as string)?.Trim();
        var tituloAba = string.IsNullOrWhiteSpace(tituloPagina) ? "Padelizou"
            : tituloPagina.EndsWith("Padelizou", StringComparison.OrdinalIgnoreCase) ? tituloPagina
            : $"{tituloPagina} - Padelizou";
    }
    <title>@tituloAba</title>
    <meta name="theme-color" content="#141d33" />
    @* iOS antigo (antes do 16.4) ignora o manifest e só obedece estas três. Sem elas, quem
       adiciona à tela de início nesses aparelhos abre o site DENTRO do Safari, com barra de
       endereço e tudo — deixa de parecer app. *@
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Padelizou" />
    <link rel="manifest" href="~/manifest.json" />
    @* Fica no <head> porque o Chrome dispara este evento cedo: capturado só no fim do
       <body>, ele às vezes já passou, e o botão "Instalar agora" nunca apareceria.
       O preventDefault tira a barrinha automática do Chrome — quem convida a instalar
       é o nosso modal, na hora certa, e não uma tarja no meio da tela. *@
    <script>
        window.pdzEventoInstalacao = null;
        window.addEventListener('beforeinstallprompt', function (e) {
            e.preventDefault();
            window.pdzEventoInstalacao = e;
            document.dispatchEvent(new CustomEvent('pdz:instalavel'));
        });
        window.addEventListener('appinstalled', function () {
            window.pdzEventoInstalacao = null;
            document.dispatchEvent(new CustomEvent('pdz:instalado'));
        });
    </script>
    @* O arquivo se chama favicon-32 mas tem 64x64 de verdade (é a versão 2x, e serve também de
       selo das notificações no Android, onde 32 ficaria borrado). O nome ficou; o `sizes` diz a
       verdade — declarar tamanho errado faz o navegador descartar o ícone. *@
    <link rel="icon" type="image/png" sizes="64x64" href="~/image/favicon-32.png" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/image/apple-touch-icon.png" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/Padelizou.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @* Carimbo antifalsificação de onde o JavaScript tira o valor (ver `cabecalhoAntifalsificacao`
       em site.js). Fica no layout porque as chamadas por fetch() estão espalhadas em 4 telas, e
       repetir isto em cada uma seria esquecer numa. É o PRIMEIRO do documento de propósito: a
       busca do JS pega o primeiro que encontra, então a origem fica sempre a mesma. *@
    @Html.AntiForgeryToken()
    <header>
        @* expand-XL, não expand-lg: entre 992 e 1199px os itens do menu abriam todos ao mesmo
           tempo e não cabiam — 1221px de conteúdo pra 985px de tela, medido em 1000px, o que
           dava rolagem lateral em todo notebook pequeno. O remendo do `max-width: 120px` no
           nome do usuário (ver site.css) foi uma tentativa anterior de espremer isso.
           Nessa faixa o menu passa a ficar no sanduíche, onde sobra espaço de sobra.
           As regras de CSS que dependem de "o menu está recolhido" acompanharam pra 1199.98. *@
        <nav class="navbar navbar-expand-xl navbar-dark pdz-navbar sticky-top">
            <div class="container">
                @* A seta de voltar é do APP, não da página — por isso mora aqui na barra e não
                   no corpo. Quase 60 telas já têm um "Voltar ao X" próprio, que diz PRA ONDE
                   vai; repetir um genérico dentro do conteúdo daria dois botões em cada uma.

                   Nasce como <a href> de verdade, com destino de reserva no href: sem
                   JavaScript, ou pra quem chegou direto por link do WhatsApp, ele ainda leva a
                   algum lugar. O script troca isso por history.back() quando há de onde voltar.

                   Some nos destinos que já estão a um toque na barra (ver NavegacaoDeVolta). *@
                @if (Padelizou.Services.NavegacaoDeVolta.Mostrar(currentController, currentAction))
                {
                    <a class="pdz-voltar" id="pdzVoltar" aria-label="Voltar"
                       href="@Padelizou.Services.NavegacaoDeVolta.DestinoDeReserva(currentController)">
                        <i class="bi bi-arrow-left"></i>
                    </a>
                }

                <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    @* Na barra vão as raquetes SOLTAS, não o logo completo: o disco do logo é
                       escuro (#3C404B) e a barra também — contraste de 1,7:1, o círculo some.
                       O logo completo continua onde o fundo é claro (login, relatório, ícones). *@
                    <img src="~/image/logo-raquetes.webp" asp-append-version="true" alt="Padelizou" class="pdz-brand-logo" />
                    <span class="pdz-wordmark">Padelizou</span>
                    @if (beta.Habilitado)
                    {
                        <span class="pdz-selo-beta">@beta.Rotulo</span>
                    }
                </a>

                @* O SINO FICA FORA DO SANDUÍCHE NO CELULAR. Ele existia só como item do menu,
                   e menu no celular nasce FECHADO: a bolinha de avisos novos ficava atrás do
                   ícone de três linhas, invisível pra quem não abrisse o menu por conta
                   própria. Como o push alcança 5 aparelhos em 154, esta caixa é o canal que
                   de fato chega em todo mundo — e ela precisa ser vista ao entrar.

                   d-xl-none porque acima disso o menu já está aberto com o item "Avisos"
                   dentro, e a barra não tem folga pra mais um ícone entre 1200 e 1400px (ver
                   o comentário de largura em .pdz-voltar, no site.css). *@
                @if (User.Identity?.IsAuthenticated == true && !dentroDoPainel)
                {
                    <div class="ms-auto d-xl-none">
                        @await Component.InvokeAsync("SinoDeAvisos", new { naBarra = true })
                    </div>
                }

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#pdzNav"
                        aria-controls="pdzNav" aria-expanded="false" aria-label="Abrir menu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse" id="pdzNav">
                    <ul class="navbar-nav mx-lg-auto mb-2 mb-lg-0">
                        @if (dentroDoPainel)
                        {
                            @* Aqui dentro só existem /Admin e /Auth (AdminHostMiddleware): o menu do
                               site inteiro daria 404 item por item. Fica a porta de volta, e ela
                               precisa ser absoluta — relativa cairia no 404 deste mesmo host. *@
                            <li class="nav-item">
                                <a class="nav-link" href="@AdminHostMiddleware.LinkDoSitePublico">
                                    <i class="bi bi-arrow-left"></i> Voltar ao site
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @NavActive("Admin")" asp-controller="Admin" asp-action="Index">
                                    <i class="bi bi-shield-lock-fill"></i> Painel Admin
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link @NavActive("Home")" asp-area="" asp-controller="Home" asp-action="Index">
                                    <i class="bi bi-house-door"></i> Início
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @NavActive("Torneios")" asp-area="" asp-controller="Torneios" asp-action="Index">
                                    <i class="bi bi-trophy"></i> Torneio
                                </a>
                            </li>
                            if (souProfessor)
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(currentController == "Aulas" && currentAction == "Dashboard" ? "active" : "")" asp-area="" asp-controller="Aulas" asp-action="Dashboard">
                                        <i class="bi bi-clipboard-data"></i> Painel do Professor
                                    </a>
                                </li>
                            }
                            @* Dono/administrador de clube tinha painel, mas nenhum caminho no
                               menu: só um card na home. Quem paga mensalidade não pode depender
                               de lembrar onde fica. *@
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                @await Component.InvokeAsync("MenuClube")
                            }
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Aulas" && currentAction != "Dashboard" ? "active" : "")" asp-area="" asp-controller="Aulas" asp-action="Solicitar">
                                    <i class="bi bi-calendar-plus"></i> Aula
                                </a>
                            </li>
                            @* Três coisas que eram itens soltos e disputavam espaço no topo. São o mesmo
                               assunto — jogar — então viraram um menu só. A Agenda saiu daqui: ela é
                               pessoal, e o lugar dela é dentro do perfil. *@
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @NavActive("Avisos", "MarcarJogo", "Grupos")"
                                   href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-dribbble"></i> Jogos
                                </a>
                                <ul class="dropdown-menu">
                                    <li>
                                        <a class="dropdown-item" asp-area="" asp-controller="Avisos" asp-action="Index">
                                            <i class="bi bi-megaphone me-1"></i> Buscar jogo
                                        </a>
                                    </li>
                                    @if (User.Identity?.IsAuthenticated == true)
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-controller="MarcarJogo" asp-action="Index">
                                                <i class="bi bi-calendar2-plus me-1"></i> Marcar jogo
                                            </a>
                                        </li>
                                    }
                                    <li>
                                        <a class="dropdown-item" asp-area="" asp-controller="Grupos" asp-action="Index">
                                            <i class="bi bi-shield-lock me-1"></i> Grupos
                                        </a>
                                    </li>
                                </ul>
                            </li>
                            if (souAdmin || souAssistente)
                            {
                                @* Mesma aba: o painel é uma tela do sistema como qualquer outra. Em
                                   produção ele mora noutro host, e por isso o endereço vem pronto de
                                   LinkDoPainel — no localhost e no dev ele é aqui mesmo. *@
                                <li class="nav-item">
                                    <a class="nav-link @NavActive("Admin")" href="@linkPainelAdmin">
                                        <i class="bi bi-shield-lock-fill"></i> Painel Admin
                                    </a>
                                </li>
                            }
                            <li class="nav-item">
                                @* Aqui é por AÇÃO, não por controller: Ranking e Buscar moram os dois
                                   em Jogadores, e marcar pelo controller acenderia os dois juntos. *@
                                <a class="nav-link @(currentController == "Jogadores" && currentAction == "Ranking" ? "active" : "")"
                                   asp-controller="Jogadores" asp-action="Ranking">
                                    <i class="bi bi-graph-up-arrow"></i> Ranking
                                </a>
                            </li>
                            <li class="nav-item">
                                @* Era "Times". Virou "Buscar" porque a tela acha jogador E time — quem
                                   procura alguém pra jogar não pensa "vou no menu Times". *@
                                <a class="nav-link @(currentController == "Times" || (currentController == "Jogadores" && currentAction == "Buscar") ? "active" : "")"
                                   asp-controller="Jogadores" asp-action="Buscar">
                                    <i class="bi bi-search"></i> Buscar
                                </a>
                            </li>

                            @* A caixa de entrada de avisos. Fica junto do resto do menu, e não
                               escondida no menu do avatar: é onde cai o convite pra jogo, e
                               convite que ninguém acha não é convite. *@
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                @await Component.InvokeAsync("SinoDeAvisos")
                            }
                        }
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @* O convite pra instalar aparece sozinho UMA vez por aparelho. Quem
                               fechou sem querer não tinha como voltar atrás — este item é a porta
                               de sempre. Nasce escondido e o instalar-app.js decide: some pra quem
                               já instalou e pra quem está num navegador que não instala. *@
                            @* d-lg-none: só no celular (decisão do Felipe, 30/07). O Chrome de
                               desktop também instala PWA — por isso o item aparecia lá — mas o
                               app na mesa de trabalho não é o produto; no bolso é. O !important
                               do d-lg-none vence o display que o instalar-app.js setar. *@
                            <li class="nav-item d-lg-none" id="pdzMenuInstalar" style="display:none;">
                                <a class="nav-link" href="#" onclick="abrirInstalarPwaModal(); return false;">
                                    <i class="bi bi-phone"></i> Instalar o app
                                </a>
                            </li>
                        }
                        @* O contato saiu do topo e foi pro rodapé (decisão do Felipe, 30/07): a
                           barra é pra navegar no site, e falar com a gente é o tipo de coisa
                           que se procura no fim da página — onde o número já estava escrito. *@
                    </ul>

                    <div class="d-flex align-items-center gap-2 pdz-authbar">
                        <button type="button" id="pdzThemeToggle" class="btn btn-sm pdz-btn-ghost rounded-pill" title="Alternar tema claro/escuro">
                            <i class="bi bi-moon-stars-fill" id="pdzThemeIcon"></i>
                        </button>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @* O nome vai no title porque o chip corta com reticências no desktop. *@
                            <a class="pdz-user-chip" asp-controller="Auth" asp-action="Perfil" title="Meu perfil — @nomeUsuario">
                                @if (!string.IsNullOrWhiteSpace(minhaFoto))
                                {
                                    <img src="@minhaFoto" alt="" class="rounded-circle" style="width:22px;height:22px;object-fit:cover;" />
                                }
                                else
                                {
                                    <i class="bi bi-person-circle"></i>
                                }
                                <span class="text-truncate">@nomeUsuario</span>
                            </a>
                            <a class="btn btn-sm pdz-btn-ghost rounded-pill" asp-controller="Auth" asp-action="Logout" title="Sair">
                                <i class="bi bi-box-arrow-right"></i>
                            </a>
                        }
                        else
                        {
                            <a class="btn btn-sm btn-padel rounded-pill px-3" asp-controller="Auth" asp-action="Login">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Entrar
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>

        @if (beta.Habilitado)
        {
            @* A faixa de beta é o lugar natural do canal de feedback: aparece em toda tela,
               e quem topa com um problema não precisa procurar onde reclamar. *@
            <div class="pdz-faixa-beta">
                <div class="container d-flex align-items-center flex-wrap gap-2">
                    <i class="bi bi-cone-striped"></i>
                    <span>@beta.Texto</span>
                    <a asp-controller="Auth" asp-action="ReportarProblema" class="pdz-link-beta">
                        Sugestão, bug ou crítica <i class="bi bi-arrow-right-short"></i>
                    </a>
                </div>
            </div>
        }
    </header>

    <main role="main" class="pdz-main">
        <div class="container">
            @*
                Falha ao salvar imagem aparece AQUI, e não em cada tela. São três telas que aceitam
                upload (perfil, time, capa de torneio) e cada uma redireciona pra um lugar diferente
                depois de salvar — repetir o bloco em todas seria esquecer numa.

                O cadastro segue mesmo quando a imagem falha (perder um formulário longo por causa
                de uma foto é pior), mas seguir calado fazia o sistema mentir: a pessoa escolhia o
                arquivo, salvava e ia embora achando que a foto estava lá.
            *@
            @if (TempData["ErroImagem"] != null)
            {
                <div class="alert alert-warning alert-dismissible border-0 shadow-sm mt-3" role="alert">
                    <i class="bi bi-image me-1"></i>
                    @TempData["ErroImagem"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
                </div>
            }

            @* A faixa do assistente fica NO LAYOUT, e não em cada tela: ele circula pelo painel
               inteiro e pela gestão de qualquer torneio, e o aviso tem que acompanhar. Aparece
               só onde há o que editar — na Home e no perfil dele não faz sentido. *@
            @if (souSoOlhando && (dentroDoPainel || Context.Request.Path.StartsWithSegments("/Admin")
                 || Context.Request.Path.StartsWithSegments("/Torneios")))
            {
                <div class="alert alert-info border-0 shadow-sm d-flex gap-2 align-items-start mt-3" role="status">
                    <i class="bi bi-eyeglasses fs-5 lh-1 mt-1"></i>
                    <div class="small">@Padelizou.Services.PoderesNoSistema.AvisoDeSoLeitura</div>
                </div>
            }

            @RenderBody()
        </div>
    </main>

    <footer class="pdz-footer">
        <div class="container">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
                <div class="d-flex align-items-center gap-2">
                    @* Raquetes soltas: a 26px o disco completo vira um borrão escuro. *@
                    <img src="~/image/logo-raquetes.webp" asp-append-version="true" alt="Padelizou" style="width: 26px;" />
                    <span class="fw-semibold">Padelizou</span>
                </div>
                @* Canal de opinião do site: fica no rodapé de toda página, mas só quem está
                   logado escreve — feedback anônimo não dá pra responder nem conferir. *@
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Feedback" asp-action="Index" asp-host="@hostDoSite" asp-protocol="@protocoloDoSite" class="small fw-semibold">
                        <i class="bi bi-chat-heart"></i> O que você achou do Padelizou?
                    </a>
                }
                @* Agora que o contato saiu do topo, este é o ÚNICO lugar dele — então diz o que
                   é ("Entre em contato") e mostra o número ESCRITO. Em celular não existe passar
                   o mouse pra ver o title, e tem quem prefira salvar o contato a clicar no link. *@
                <a href="@linkContato" target="_blank" rel="noopener" class="small fw-semibold text-decoration-none">
                    <i class="bi bi-whatsapp"></i> Entre em contato
                    <span class="text-muted">· @suporte.WhatsAppFormatado</span>
                </a>
                <span class="small text-muted">&copy; 2026 Padelizou &middot; <a asp-area="" asp-controller="Home" asp-action="Privacy" asp-host="@hostDoSite" asp-protocol="@protocoloDoSite">Privacidade</a></span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @* Vem ANTES do push.js e do modal: os dois chamam pdzAppInstalado()/pdzPlataforma() daqui.
       No iPhone, saber se o app está instalado é o que decide se o push existe. *@
    <script src="~/js/instalar-app.js" asp-append-version="true"></script>
    <script src="~/js/push.js" asp-append-version="true"></script>
    <script src="~/js/mascaras.js" asp-append-version="true"></script>
    <script src="~/js/hora-sugerida.js" asp-append-version="true"></script>
    @* Confirmação bonita no lugar do confirm() do navegador. Vale em TODA tela: basta o
       formulário ter data-confirmar. Ver Views/Shared/_ModalConfirmar.cshtml. *@
    <partial name="_ModalConfirmar" />
    <script src="~/js/confirmar.js" asp-append-version="true"></script>
    @if (User.Identity?.IsAuthenticated == true)
    {
        @* O push.js religa sozinho a inscrição de quem já autorizou os avisos, e pra isso
           precisa saber que tem alguém logado — o POST de um visitante anônimo cairia no
           login. É o único jeito: a permissão vive no navegador, a conta vive aqui. *@
        <script>window.pdzJogadorLogado = true;</script>
        <partial name="_InstalarPwaModal" />
        @* Irmão do de cima e o passo seguinte dele: instalou, agora liga o aviso. *@
        <partial name="_AtivarAvisosModal" />
    }
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/sw.js');
            });
        }
    </script>
    <script>
        (function () {
            var botao = document.getElementById('pdzThemeToggle');
            var icone = document.getElementById('pdzThemeIcon');

            function atualizarIcone() {
                var escuro = document.documentElement.getAttribute('data-bs-theme') === 'dark';
                icone.className = escuro ? 'bi bi-sun-fill' : 'bi bi-moon-stars-fill';
                botao.title = escuro ? 'Mudar pro tema claro' : 'Mudar pro tema escuro';
            }

            botao.addEventListener('click', function () {
                var atual = document.documentElement.getAttribute('data-bs-theme');
                var novo = atual === 'dark' ? 'light' : 'dark';
                document.documentElement.setAttribute('data-bs-theme', novo);
                localStorage.setItem('pdz-theme', novo);
                atualizarIcone();
            });

            atualizarIcone();
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
