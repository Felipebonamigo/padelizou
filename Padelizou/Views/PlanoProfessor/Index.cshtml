@model Jogador
@using Padelizou.Services
@{
    ViewData["Title"] = "Meu Plano de Professor - Padelizou";

    var cfg = (PlanoProfessorSettings)ViewBag.Cfg;
    var situacao = (PlanoDoProfessor.Situacao)ViewBag.Situacao;
    DateTime? fimDoTeste = ViewBag.FimDoTeste;
    var cobrancaPendente = ViewBag.CobrancaPendente as Padelizou.Models.Pagamento;
    var pixPendente = ViewBag.PixPendente as Padelizou.Models.Pagamento;

    int diasRestantes = fimDoTeste.HasValue
        ? Math.Max(0, (int)Math.Ceiling((fimDoTeste.Value - DateTime.Now).TotalDays)) : 0;

    // O exemplo de 20 aulas de R$ 100 no mês. ⚠️ Quem PAGA a taxa depende do ModoComissao,
    // então a conta vem pronta de ExemploDoPlanoNaTela — fazê-la aqui foi o que deixou o card
    // anos dizendo "o Avulso paga R$ 200" sem dizer que, no modo padrão, quem paga é o aluno.
    var exemplo = (ExemploDoPlanoNaTela.Conta)ViewBag.Exemplo;

    // Quanto o anual poupa contra 12 mensalidades. Vem do serviço, não de conta na tela: os
    // dois preços saem de configuração e podem mudar sem passar por aqui.
    decimal economiaAnual = PlanoDoProfessor.EconomiaDoAnual(cfg);
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">

            <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
                <div>
                    <h2 class="fw-bold mb-0" style="color: var(--pdz-ink);">Meu plano</h2>
                    <div class="text-muted">Como o Padelizou cobra pelas suas aulas.</div>
                </div>
                <a asp-controller="Aulas" asp-action="Dashboard" class="btn btn-outline-secondary rounded-pill">
                    <i class="bi bi-arrow-left"></i> Voltar ao Painel
                </a>
            </div>

            @if (TempData["Sucesso"] != null)
            {
                <div class="alert alert-success">@TempData["Sucesso"]</div>
            }
            @if (TempData["Erro"] != null)
            {
                <div class="alert alert-danger">@TempData["Erro"]</div>
            }

            @* ---- Onde você está agora ---- *@
            @switch (situacao)
            {
                case PlanoDoProfessor.Situacao.EmTeste:
                    <div class="alert alert-info d-flex align-items-center gap-2">
                        <i class="bi bi-hourglass-split fs-4"></i>
                        <div>
                            <strong>Você está no período de teste</strong> — condições de Assinante, sem pagar mensalidade,
                            até <strong>@fimDoTeste!.Value.ToString("dd/MM")</strong>
                            (@diasRestantes @(diasRestantes == 1 ? "dia" : "dias")).
                            Escolha seu plano até lá; sem escolha, você segue no Avulso.
                        </div>
                    </div>
                    break;
                case PlanoDoProfessor.Situacao.AssinanteEmDia:
                    <div class="alert alert-success d-flex align-items-center gap-2">
                        <i class="bi bi-patch-check-fill fs-4"></i>
                        <div>
                            <strong>Assinante em dia</strong> — mensalidade quitada até
                            <strong>@Model.AssinaturaProfessorPagaAte!.Value.ToString("dd/MM/yyyy")</strong>.
                            Taxa por aula: @cfg.PercentualAssinantePix.ToString("0.#")% no Pix,
                            @cfg.PercentualAssinanteCartao.ToString("0.#")% no cartão.
                        </div>
                    </div>
                    break;
                @* ⚠️ NUNCA "mensalidade QUITADA" aqui, que é o texto do caso acima: não houve
                   mensalidade, houve permuta. Dizer "quitada" seria mentir todo dia pra
                   contraparte do negócio — e ela sabe que não pagou nada. *@
                case PlanoDoProfessor.Situacao.Cortesia:
                    <div class="alert alert-primary d-flex align-items-center gap-2">
                        <i class="bi bi-gift-fill fs-4"></i>
                        <div>
                            <strong>Plano garantido pelo Padelizou</strong> — condições de Assinante até
                            <strong>@Model.CortesiaProfessorAte!.Value.ToString("dd/MM/yyyy")</strong>,
                            <strong>sem mensalidade</strong>.
                            Taxa por aula: @cfg.PercentualAssinantePix.ToString("0.#")% no Pix,
                            @cfg.PercentualAssinanteCartao.ToString("0.#")% no cartão.
                        </div>
                    </div>
                    break;
                case PlanoDoProfessor.Situacao.AssinanteEmAtraso:
                    <div class="alert alert-warning d-flex align-items-center gap-2">
                        <i class="bi bi-exclamation-triangle-fill fs-4"></i>
                        <div>
                            <strong>Mensalidade em aberto.</strong> Enquanto ela não entra, suas aulas voltam
                            pra taxa de @cfg.PercentualAvulso.ToString("0.#")% — pague abaixo e a taxa menor
                            volta na hora.
                        </div>
                    </div>
                    break;
                @* ⚠️ O RAMO DO AVULSO FICA, mesmo com o plano fora de cartaz: tem professor
                   com ele gravado, e sem esta linha ele cairia no `default:` — que fala de
                   quem NÃO escolheu, quando ele escolheu. Ver OAvulsoSaiDeCartazTests.
                   E NADA AQUI PROMETE BLOQUEIO: ele ainda não existe, e tela que anuncia
                   consequência que o código não aplica é a mentira de rótulo de sempre. *@
                case PlanoDoProfessor.Situacao.Avulso:
                    <div class="alert alert-warning d-flex align-items-center gap-2">
                        <i class="bi bi-exclamation-triangle fs-4"></i>
                        <div>
                            <strong>O plano Avulso saiu de cartaz.</strong> Hoje você ainda paga
                            @cfg.PercentualAvulso.ToString("0.#")% por aula paga no app. Assinando, a taxa
                            cai pra @cfg.PercentualAssinantePix.ToString("0.#")%.
                        </div>
                    </div>
                    break;
                default:
                    <div class="alert alert-secondary d-flex align-items-center gap-2">
                        <i class="bi bi-info-circle fs-4"></i>
                        <div>
                            <strong>Seu período de teste terminou</strong> e você ainda não assinou — suas
                            aulas pagas no app saem a @cfg.PercentualAvulso.ToString("0.#")%. Assinando, a
                            taxa cai pra @cfg.PercentualAssinantePix.ToString("0.#")%.
                        </div>
                    </div>
                    break;
            }

            @* A dúvida nº 1 de quem lê uma tabela de taxas é "então vou pagar 10% de TUDO que
               eu ganho?". Não: a taxa nasce junto com a cobrança (PagamentoInscricaoService),
               e aula paga na mão nunca passa por lá. Dizer isso ANTES dos dois cards, senão a
               pessoa fecha a tela com a conta errada na cabeça. *@
            <div class="alert alert-success border-0 d-flex align-items-start gap-2 mt-3">
                <i class="bi bi-hand-thumbs-up-fill fs-5"></i>
                <div>
                    <strong>Receber por fora sempre pode.</strong>
                    Se o aluno te paga direto — Pix na sua chave, dinheiro, na recepção do clube —
                    o Padelizou <strong>não cobra nada</strong>: o valor não passa por aqui.
                    As porcentagens abaixo valem só para as aulas que o aluno paga <strong>dentro do app</strong>.
                </div>
            </div>

            @* ---- O plano ---- *@
            <div class="row g-3 mt-1">
                <div class="col-md-8 mx-auto">
                    <div class="card h-100 shadow-sm @(Model.PlanoProfessor == PlanoDoProfessor.Assinante ? "border-success" : "border-0")">
                        <div class="card-body p-4 d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start">
                                <h5 class="fw-bold">Assinante</h5>
                                @if (Model.PlanoProfessor == PlanoDoProfessor.Assinante)
                                {
                                    <span class="badge bg-success">seu plano</span>
                                }
                            </div>
                            <div class="fs-3 fw-bold" style="color: var(--padel-green);">
                                @cfg.MensalidadeAssinante.ToString("C")<span class="fs-6 text-muted fw-normal">/mês</span>
                            </div>
                            <div class="small text-muted">
                                ou <strong>@cfg.AnuidadeAssinante.ToString("C")</strong> por 12 meses
                                @if (economiaAnual > 0)
                                {
                                    <span class="badge rounded-pill bg-success-subtle text-success-emphasis border border-success-subtle">
                                        economize @economiaAnual.ToString("C")
                                    </span>
                                }
                            </div>
                            <ul class="list-unstyled small mt-2 mb-3">
                                <li class="mb-1"><i class="bi bi-check-circle-fill text-success"></i>
                                    <strong>@cfg.PercentualAssinantePix.ToString("0.#")%</strong> por aula paga no app, no Pix</li>
                                <li class="mb-1"><i class="bi bi-check-circle-fill text-success"></i>
                                    <strong>@cfg.PercentualAssinanteCartao.ToString("0.#")%</strong> no cartão</li>
                                <li class="mb-1"><i class="bi bi-check-circle-fill text-success"></i>
                                    Previsível: mês cheio não aumenta a mordida</li>
                            </ul>
                            <div class="mt-auto">
                                @* ⚠️ EM CORTESIA, NENHUM BOTÃO DE PAGAR — e este ramo tem que vir
                                   PRIMEIRO. Hoje os botões só somem quando há cobrança em aberto,
                                   NUNCA por ele já estar em dia: sem este `if`, o parceiro de
                                   permuta vê "Pagar 12 meses (R$ 499,90)" na tela e pode pagar
                                   uma coisa que já é dele. O POST também trava (PagarMensalidade),
                                   mas oferecer e recusar depois é pior que não oferecer. *@
                                @if (situacao == PlanoDoProfessor.Situacao.Cortesia)
                                {
                                    <div class="alert alert-primary mb-0 small">
                                        <i class="bi bi-gift-fill"></i>
                                        Está por nossa conta até
                                        <strong>@Model.CortesiaProfessorAte!.Value.ToString("dd/MM/yyyy")</strong>
                                        — não precisa pagar nada.
                                    </div>
                                }
                                else if (Model.PlanoProfessor != PlanoDoProfessor.Assinante)
                                {
                                    <form asp-action="Escolher" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="plano" value="@PlanoDoProfessor.Assinante" />
                                        <button type="submit" class="btn btn-padel w-100 rounded-pill fw-bold">Quero ser Assinante</button>
                                    </form>
                                }
                                else if (pixPendente != null)
                                {
                                    @* O Pix aberto vem antes da fatura de gateway: se os dois
                                       existem, pagar os dois cobraria a assinatura em dobro.
                                       O VALOR vai no botão porque com dois ciclos "a cobrança
                                       em aberto" não diz mais qual das duas é. *@
                                    <a asp-controller="Pagamentos" asp-action="Pix" asp-route-id="@pixPendente.Id"
                                       class="btn btn-padel w-100 rounded-pill fw-bold">
                                        <i class="bi bi-qr-code"></i>
                                        @(pixPendente.Status == PixDireto.AguardandoConfirmacao
                                            ? "Pix enviado — acompanhar"
                                            : $"Pagar com Pix ({pixPendente.Valor:C})")
                                    </a>
                                }
                                else if (cobrancaPendente != null)
                                {
                                    <a href="@LinkDoPagamento.Para(cobrancaPendente)"
                                       class="btn btn-padel w-100 rounded-pill fw-bold">
                                        <i class="bi bi-credit-card"></i>
                                        Pagar a cobrança em aberto (@cobrancaPendente.Valor.ToString("C"))
                                    </a>
                                }
                                else
                                {
                                    @* Os dois ciclos no MESMO form, cada botão mandando o seu
                                       `ciclo`: dois formulários separados dariam duas chances
                                       de clique e é assim que nascem duas cobranças abertas. *@
                                    <form asp-action="PagarMensalidade" method="post" class="d-grid gap-2">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" name="ciclo" value="@PlanoDoProfessor.CicloMensal"
                                                class="btn btn-padel rounded-pill fw-bold">
                                            <i class="bi bi-credit-card"></i> Pagar 1 mês (@cfg.MensalidadeAssinante.ToString("C"))
                                        </button>
                                        <button type="submit" name="ciclo" value="@PlanoDoProfessor.CicloAnual"
                                                class="btn btn-outline-success rounded-pill fw-bold">
                                            <i class="bi bi-calendar-check"></i> Pagar 12 meses (@cfg.AnuidadeAssinante.ToString("C"))
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @* A conta que decide — e ela é DUAS contas, porque quem paga a taxa muda com o
               ModoComissao. Dizer só o valor, sem o dono, é o que fazia o professor no modo
               padrão achar que economizava do próprio bolso um dinheiro que era do aluno.

               ⚠️ Os campos ainda se chamam `...Avulso`, e os NÚMEROS continuam certos: o que
               era a taxa do plano Avulso virou a taxa de quem não assinou (teste vencido,
               atraso, ou o Avulso antigo). Renomear arrastaria `PercentualAvulso`, que é chave
               de appsettings — troca de configuração no meio de uma mudança de tela. Fica pra
               quando o bloqueio entrar. *@
            <div class="card border-0 shadow-sm mt-3">
                <div class="card-body small">
                    <strong><i class="bi bi-calculator"></i> Na prática:</strong>
                    com @exemplo.Aulas.ToString("0") aulas de @exemplo.PrecoDaAula.ToString("C") no mês
                    <strong>pagas pelo app</strong> (todas no Pix)&nbsp;—

                    @if (exemplo.TaxaSaiDoAluno)
                    {
                        <text>
                            quem paga a taxa é o <strong>seu aluno</strong>, e você recebe os
                            @exemplo.PrecoDaAula.ToString("C") cheios dos dois jeitos. O que muda é o
                            preço final pra ele: <strong>@exemplo.AlunoPagaAvulso.ToString("C")</strong> por
                            aula <strong>sem assinatura</strong> contra
                            <strong>@exemplo.AlunoPagaAssinante.ToString("C")</strong> assinando. Do
                            <strong>seu</strong> bolso sai só a mensalidade
                            (@exemplo.CustoMensalAssinante.ToString("C")) — o que ela compra é a sua aula
                            ficar mais barata pra quem contrata.
                        </text>
                    }
                    else
                    {
                        <text>
                            a taxa sai da <strong>sua parte</strong> (seu aluno paga os
                            @exemplo.PrecoDaAula.ToString("C") anunciados). No mês, <strong>sem assinatura</strong>
                            te custa <strong>@exemplo.CustoMensalAvulso.ToString("C")</strong>; assinando,
                            <strong>@exemplo.CustoMensalAssinante.ToString("C")</strong>
                            (@cfg.MensalidadeAssinante.ToString("C") + @cfg.PercentualAssinantePix.ToString("0.#")%).
                            Quanto mais aulas, maior a diferença.
                        </text>
                    }

                    <div class="text-muted mt-2">
                        Quem paga a taxa é escolha sua, em
                        <a asp-controller="Pagamentos" asp-action="Configurar">Meus Pagamentos</a>.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
