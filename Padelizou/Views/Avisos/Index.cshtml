@using System.Security.Claims
@model IEnumerable<AvisoJogo>
@{
    ViewData["Title"] = "Buscar Jogo - Padelizou";
    var userId = User.Identity!.IsAuthenticated ? int.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier)!) : 0;
    @* Quem está chamando, pro texto da mensagem: o aviso chega no WhatsApp do dono do horário
       como um número desconhecido, e "Oi, tem vaga?" sem assinatura não diz quem é. *@
    var meuNome = NomeBonito.Curto(User.FindFirstValue(ClaimTypes.Name));
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold" style="color: var(--pdz-ink);">Buscar Jogo</h2>
            <p class="text-muted mb-0">Avisos de quem está procurando jogadores.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Parceiros" asp-action="Index" class="btn btn-outline-primary rounded-pill">
                <i class="bi bi-person-plus"></i> Procurar Parceiro
            </a>
            <a asp-controller="Avisos" asp-action="Criar" class="btn btn-padel rounded-pill">
                <i class="bi bi-plus-circle"></i> Criar Aviso
            </a>
        </div>
    </div>

    <div class="row">
        @if (Model != null && Model.Any())
        {
            @foreach (var aviso in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card shadow-sm border-0 h-100" style="border-left: 5px solid var(--padel-green);">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge bg-primary">@aviso.CategoriaPadrao.Nome</span>
                                <span class="text-muted fw-bold small"><i class="bi bi-clock-history"></i> @aviso.DataHora.ToString("dd/MM/yyyy HH:mm")</span>
                            </div>

                            <h5 class="fw-bold mb-1" style="color: var(--pdz-ink);">
                                <i class="bi bi-geo-alt-fill text-danger"></i> @aviso.Clube.Nome
                            </h5>

                            <p class="text-muted small mb-2">
                                <i class="bi bi-person-circle"></i> Criado por @aviso.Criador.Nome
                            </p>

                            @if (!string.IsNullOrWhiteSpace(aviso.Observacoes))
                            {
                                <p class="small fst-italic">"@aviso.Observacoes"</p>
                            }

                            @* O aviso É um pedido de contato — a tela dizia de quem era o horário e
                               não dava jeito nenhum de falar com a pessoa. O link só ABRE o WhatsApp
                               com o texto pronto: quem manda é o jogador, não o Padelizou.

                               A régua de privacidade é a mesma do perfil (Services/ContatoDoJogador):
                               perfil privado e conta excluída não têm o número exposto aqui. Quando
                               não dá pra chamar, sobra o perfil — melhor que um card sem saída. *@
                            @if (aviso.CriadorId != userId)
                            {
                                if (ContatoDoJogador.PodeChamarNoWhatsApp(aviso.Criador, userId))
                                {
                                    var mensagem = (string.IsNullOrWhiteSpace(meuNome)
                                            ? $"Oi, {aviso.Criador.ComoChamar}! Vi seu aviso no Padelizou: "
                                            : $"Oi, {aviso.Criador.ComoChamar}! Aqui é {meuNome}, do Padelizou. Vi seu aviso: ")
                                        + $"{aviso.CategoriaPadrao.Nome} em {aviso.Clube.Nome}, "
                                        + $"dia {aviso.DataHora:dd/MM 'às' HH:mm}. Ainda tem vaga?";

                                    <a href="@WhatsAppLinkHelper.GerarLink(aviso.Criador.Celular, mensagem)"
                                       target="_blank" rel="noopener"
                                       class="btn btn-sm btn-success rounded-pill w-100 fw-bold mt-2">
                                        <i class="bi bi-whatsapp"></i> Chamar no WhatsApp
                                    </a>
                                }
                                else
                                {
                                    <a asp-controller="Jogadores" asp-action="Perfil" asp-route-id="@aviso.CriadorId"
                                       class="btn btn-sm btn-outline-secondary rounded-pill w-100 mt-2">
                                        <i class="bi bi-person-lines-fill"></i> Ver quem avisou
                                    </a>
                                }
                            }

                            @if (aviso.CriadorId == userId)
                            {
                                <form asp-controller="Avisos" asp-action="Cancelar" method="post">
                                    <input type="hidden" name="id" value="@aviso.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger w-100 mt-2">
                                        <i class="bi bi-x-circle"></i> Cancelar meu aviso
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <partial name="_Vazio" model='@(new EstadoVazio("Nenhum aviso ativo no momento. Seja o primeiro a avisar que está procurando jogadores.", "Criar aviso", "Avisos", "Criar"))' />
            </div>
        }
    </div>
</div>
