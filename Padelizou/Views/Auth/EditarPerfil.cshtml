@model Jogador
@{
    ViewData["Title"] = "Editar Perfil - Padelizou";
    var meuTimeDono = ViewBag.MeuTimeDono as Padelizou.Models.Time;
    var timesDisponiveis = ViewBag.Times as List<Padelizou.Models.Time> ?? new List<Padelizou.Models.Time>();
    var clubesDisponiveis = ViewBag.Clubes as List<Padelizou.Models.Clube> ?? new List<Padelizou.Models.Clube>();
    bool ehDonoAtual = meuTimeDono != null;
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="fw-bold" style="color: var(--pdz-ink);">Editar Perfil</h2>
                    <p class="text-muted mb-0">Seus dados pessoais. Preferências de jogo ficam em "Minhas Preferências".</p>
                </div>
                <a asp-controller="Auth" asp-action="Perfil" class="btn btn-outline-secondary rounded-pill">Voltar ao Perfil</a>
            </div>

            @if (ViewBag.Erro != null)
            {
                <div class="alert alert-danger">@ViewBag.Erro</div>
            }

            @* Girar a foto é a única ação que volta PRA CÁ em vez de ir pro perfil, e o
               "Sucesso" só era mostrado lá. Sem isto a confirmação não sumia: ficava guardada
               e aparecia na próxima vez que a pessoa abrisse o perfil, fora de hora. *@
            @if (TempData["Sucesso"] != null)
            {
                <div class="alert alert-success">@TempData["Sucesso"]</div>
            }

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <form asp-controller="Auth" asp-action="EditarPerfil" method="post" enctype="multipart/form-data">

                        <div class="mb-4 text-center">
                            @if (!string.IsNullOrEmpty(Model.FotoPerfil))
                            {
                                <img src="@Model.FotoPerfil" alt="Foto de perfil" class="rounded-circle mb-2" style="width: 96px; height: 96px; object-fit: cover;" />

                                @* Girar é um botão SEPARADO do resto do formulário: o giro acontece
                                   no arquivo em disco na hora, e não faz sentido esperar a pessoa
                                   apertar "Salvar Alterações" pra ver a foto de pé. O atributo
                                   `form` faz cada botão enviar o formulário lá de baixo, porque
                                   formulário dentro de formulário não existe em HTML. *@
                                <div class="d-flex justify-content-center gap-2 mb-1">
                                    <button type="submit" form="girar-esquerda" class="btn btn-sm btn-outline-secondary rounded-pill"
                                            title="Girar um quarto de volta pra esquerda">
                                        <i class="bi bi-arrow-counterclockwise"></i>
                                    </button>
                                    <button type="submit" form="girar-direita" class="btn btn-sm btn-outline-secondary rounded-pill"
                                            title="Girar um quarto de volta pra direita">
                                        <i class="bi bi-arrow-clockwise"></i>
                                    </button>
                                </div>
                                <div class="text-muted small mb-2">
                                    Foto de lado? Gire aqui — vale na hora, sem precisar salvar o resto.
                                </div>
                            }
                            else
                            {
                                <i class="bi bi-person-circle d-block" style="font-size: 96px; color: var(--pdz-ink);"></i>
                            }
                            <label class="form-label fw-bold text-muted small d-block mt-2">Trocar foto de perfil</label>
                            <input type="file" name="foto" class="form-control" accept="image/*" style="max-width: 320px; margin: 0 auto;" />
                        </div>

                        @* A regra tem que ser lida ANTES de digitar. Descobrir a carência só
                           depois de salvar seria gastar a troca do semestre por engano — e é
                           justamente o que o aviso existe pra impedir. *@
                        @{
                            var agoraPerfil = DateTime.Now;
                            var podeNome = Padelizou.Services.TrocaDeNome.PodeTrocarNome(Model.NomeAlteradoEm, agoraPerfil);
                            var podeApelido = Padelizou.Services.TrocaDeNome.PodeTrocarApelido(Model.ApelidoAlteradoEm, agoraPerfil);
                        }

                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted small">Nome Completo</label>
                            <input type="text" name="nome" class="form-control bg-light" maxlength="100" required
                                   value="@Model.Nome" readonly="@(!podeNome.Pode)" />
                            @if (podeNome.Pode)
                            {
                                <small class="text-muted">
                                    <i class="bi bi-info-circle"></i>
                                    Você pode corrigir seu nome <strong>uma única vez</strong>. Depois disso ele fica fixo,
                                    @Padelizou.Services.TrocaDeNome.PorQueONomeTrava
                                </small>
                            }
                            else
                            {
                                <small class="text-warning">
                                    <i class="bi bi-lock-fill"></i>
                                    Seu nome já foi corrigido e agora fica fixo,
                                    @Padelizou.Services.TrocaDeNome.PorQueONomeTrava
                                    Precisa mesmo mudar? Fale com a gente pelo <strong>"Reportar problema"</strong>.
                                </small>
                            }
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted small">Apelido <span class="fw-normal">(opcional)</span></label>
                            <input type="text" name="apelido" class="form-control bg-light" maxlength="40"
                                   placeholder="Como te chamam na quadra" value="@Model.Apelido"
                                   readonly="@(!podeApelido.Pode)" />
                            <small class="text-muted d-block">
                                Se preencher, é assim que você aparece nas listas, no placar e na chamada do torneio —
                                e as pessoas te acham buscando pelo apelido.
                            </small>
                            @if (podeApelido.Pode)
                            {
                                <small class="text-muted">
                                    <i class="bi bi-info-circle"></i>
                                    @Padelizou.Services.TrocaDeNome.AvisoAntesDeTrocar("o apelido",
                                        Padelizou.Services.TrocaDeNome.MesesParaTrocarApelido)
                                </small>
                            }
                            else
                            {
                                <small class="text-warning">
                                    <i class="bi bi-lock-fill"></i>
                                    Você trocou o apelido há pouco. A próxima troca a partir de
                                    <strong>@podeApelido.LiberaEm?.ToString("dd/MM/yyyy")</strong>.
                                </small>
                            }
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted small">E-mail</label>
                            <input type="email" name="email" class="form-control bg-light" required value="@Model.Email" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted small">Celular / WhatsApp</label>
                            <input type="tel" name="celular" class="form-control bg-light"
                                   data-mascara="celular" inputmode="numeric" placeholder="(51) 99999-9999" value="@Model.Celular" />
                        </div>

                        @* CEP primeiro, e cidade/UF logo abaixo já preenchidas: quem informa o
                           CEP não digita mais nada, e a cidade chega escrita de um jeito só.
                           Quem não quiser informar continua digitando a cidade à mão — o campo
                           é opcional de verdade. *@
                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted small">
                                CEP <span class="fw-normal">(opcional)</span>
                            </label>
                            <input type="text" name="cep" data-cep data-mascara="cep" class="form-control bg-light"
                                   inputmode="numeric" placeholder="00000-000" style="max-width: 12rem;"
                                   value="@Model.Cep" />
                            <small id="pdzCepRecado" class="d-block mt-1 small text-muted">
                                Informe e a gente preenche cidade, estado, rua e bairro pra você.
                            </small>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-8">
                                <label class="form-label fw-bold text-muted small">Cidade</label>
                                <input type="text" id="pdzCidade" name="cidade" class="form-control bg-light" value="@Model.Cidade" />
                            </div>
                            <div class="col-md-4 mt-3 mt-md-0">
                                <label class="form-label fw-bold text-muted small">Estado (UF)</label>
                                <input type="text" id="pdzEstado" name="estado" class="form-control bg-light" maxlength="2" style="text-transform: uppercase;" value="@Model.Estado" />
                            </div>
                        </div>

                        @* Rua e bairro são só leitura: eles vêm do CEP, e campo editável ao
                           lado de um preenchimento automático é convite pra divergirem. Nasce
                           escondido quando não há endereço — bloco vazio na tela é ruído. *@
                        <div id="pdzEnderecoAchado" class="row mb-3 @(string.IsNullOrWhiteSpace(Model.Cep) ? "d-none" : "")">
                            <div class="col-md-8">
                                <label class="form-label fw-bold text-muted small">Rua</label>
                                <input type="text" id="pdzLogradouro" class="form-control bg-light" value="@Model.Logradouro" readonly />
                            </div>
                            <div class="col-md-4 mt-3 mt-md-0">
                                <label class="form-label fw-bold text-muted small">Bairro</label>
                                <input type="text" id="pdzBairro" class="form-control bg-light" value="@Model.Bairro" readonly />
                            </div>
                        </div>

                        <div class="mb-4 p-3 rounded" style="background-color: var(--pdz-surface-alt);">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="enderecoPublico" value="true"
                                       id="switchEnderecoPublico" @(Model.EnderecoPublico ? "checked" : "") />
                                <label class="form-check-label fw-bold" for="switchEnderecoPublico" style="color: var(--pdz-ink);">
                                    Mostrar minha rua e meu bairro no perfil
                                </label>
                            </div>
                            <small class="text-muted d-block mt-2">
                                Desligado, só você vê. <strong>Cidade e estado continuam aparecendo</strong> de qualquer
                                jeito — é o que faz o ranking e a busca da sua região funcionarem. O CEP nunca aparece
                                pra ninguém.
                            </small>
                        </div>

                        @* SEXO — pedido a quem se cadastrou antes de o campo existir.
                           Fica em DESTAQUE (amarelo) enquanto estiver vazio, porque quem abre o
                           perfil pra resolver isso precisa achar o campo de primeira; preenchido,
                           ele vira um campo comum como qualquer outro. *@
                        @{
                            var faltaSexo = !Padelizou.Services.SexoDoJogador.Informou(Model);
                        }
                        <div class="row mb-4 @(faltaSexo ? "p-3 rounded border border-warning" : "")"
                             style="@(faltaSexo ? "background-color: var(--pdz-surface-alt);" : "")">
                            <div class="col-12">
                                <label class="form-label fw-bold text-muted small">
                                    Sexo
                                    @if (faltaSexo)
                                    {
                                        <span class="badge bg-warning text-dark ms-1">falta preencher</span>
                                    }
                                </label>
                                <div class="d-flex gap-3">
                                    @foreach (var opcao in new[] { Padelizou.Services.SexoDoJogador.Masculino, Padelizou.Services.SexoDoJogador.Feminino })
                                    {
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="sexo" value="@opcao"
                                                   id="sexo_@opcao" checked="@(Model.Sexo == opcao)" />
                                            <label class="form-check-label" for="sexo_@opcao">@opcao</label>
                                        </div>
                                    }
                                </div>
                                <small class="text-muted">
                                    O sexo com que você se identifica. Usado só pra categorias de dupla
                                    mista e de casais, que são de um homem e uma mulher —
                                    <strong>sem ele você não consegue se inscrever nessas duas</strong>.
                                </small>
                            </div>
                        </div>

                        <div class="mb-4 p-3 rounded" style="background-color: var(--pdz-surface-alt);">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="isProfessor" value="true" id="isProfessor" style="transform: scale(1.2);" @(Model.IsProfessor ? "checked" : "") />
                                <label class="form-check-label fw-bold" for="isProfessor">Sou Professor de Padel</label>
                            </div>
                            <small class="text-muted d-block mt-2">Ative pra receber agendamentos de aulas e gerenciar sua agenda de professor no sistema.</small>
                        </div>

                        <div class="mb-4 p-3 rounded" style="background-color: var(--pdz-surface-alt);">
                            <h6 class="fw-bold mb-1"><i class="bi bi-shield-fill"></i> Meu time</h6>
                            <p class="text-muted small mb-3">Seus pontos de torneio somam para o time no ranking de times.</p>

                            <div class="form-check form-switch mb-3">
                                <input class="form-check-input" type="checkbox" name="ehDonoTime" value="true" id="ehDonoTime" style="transform: scale(1.2);" @(ehDonoAtual ? "checked" : "") onchange="toggleDonoTime()" />
                                <label class="form-check-label fw-bold" for="ehDonoTime">Sou dono de um time</label>
                            </div>

                            <!-- Não é dono: escolhe um time existente -->
                            <div id="blocoTimeExistente" style="display: @(ehDonoAtual ? "none" : "block");">
                                <label class="form-label fw-bold text-muted small">Escolha seu time</label>
                                <select name="timeId" class="form-select bg-light">
                                    <option value="">— Sem time —</option>
                                    @foreach (var t in timesDisponiveis)
                                    {
                                        <option value="@t.Id" selected="@(Model.TimeId == t.Id)">@t.Nome</option>
                                    }
                                </select>
                            </div>

                            <!-- É dono: cria/edita o próprio time -->
                            <div id="blocoTimeDono" style="display: @(ehDonoAtual ? "block" : "none");">
                                <label class="form-label fw-bold text-muted small">Nome do time</label>
                                <input type="text" name="nomeTime" class="form-control bg-light mb-2" placeholder="Ex: Nata Padel" value="@(meuTimeDono?.Nome)" />

                                @if (!string.IsNullOrEmpty(meuTimeDono?.Logo))
                                {
                                    <div class="mb-1"><img src="@meuTimeDono.Logo" alt="Logo do time" class="rounded border bg-white p-1" style="height:56px;object-fit:contain;" /></div>
                                }
                                <label class="form-label fw-bold text-muted small">Logo do time</label>
                                <input type="file" name="logoTime" class="form-control mb-2" accept="image/*" />

                                <label class="form-label fw-bold text-muted small">Clube sede (opcional)</label>
                                <select name="clubeSedeId" class="form-select bg-light">
                                    <option value="">— Sem clube —</option>
                                    @* Agrupado por cidade: o navegador desenha o título do grupo
                                       sozinho, e num seletor grande é o que separa duas "Arena
                                       Central" de cidades diferentes sem uma linha de JS. *@
                                    @foreach (var grupo in Padelizou.Services.CatalogoLocais.AgrupadosPorCidade(clubesDisponiveis))
                                    {
                                        <optgroup label="@grupo.Key">
                                            @foreach (var c in grupo)
                                            {
                                                <option value="@c.Id" selected="@(meuTimeDono?.ClubeId == c.Id)">@c.Nome</option>
                                            }
                                        </optgroup>
                                    }
                                </select>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-padel btn-lg w-100 rounded-pill">Salvar Alterações</button>
                    </form>

                    @* Os dois formulários do giro, fora do de cima porque HTML não aninha
                       formulário. Quem os aciona são os botões lá em cima, pelo atributo `form`.
                       O token anti-CSRF entra sozinho: todo form com method="post" e tag helper
                       ganha o dele. *@
                    @if (!string.IsNullOrEmpty(Model.FotoPerfil))
                    {
                        <form id="girar-esquerda" asp-controller="Auth" asp-action="GirarFoto" method="post" class="d-none">
                            <input type="hidden" name="quartosDeVolta" value="3" />
                        </form>
                        <form id="girar-direita" asp-controller="Auth" asp-action="GirarFoto" method="post" class="d-none">
                            <input type="hidden" name="quartosDeVolta" value="1" />
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function toggleDonoTime() {
        var dono = document.getElementById('ehDonoTime').checked;
        document.getElementById('blocoTimeDono').style.display = dono ? 'block' : 'none';
        document.getElementById('blocoTimeExistente').style.display = dono ? 'none' : 'block';
    }
</script>
