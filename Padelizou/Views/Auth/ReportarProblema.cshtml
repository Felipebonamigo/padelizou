@{
    ViewData["Title"] = "Sugestão, bug ou crítica - Padelizou";
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="mb-4">
                <h2 class="fw-bold" style="color: var(--pdz-ink);">Sugestão, bug ou crítica</h2>
                <p class="text-muted mb-0">
                    O Padelizou está em beta e sua opinião muda o que vem pela frente.
                    Escreva aqui e a gente abre o WhatsApp com a mensagem pronta — é só apertar enviar.
                </p>
            </div>

            @if (ViewBag.Erro != null)
            {
                <div class="alert alert-danger">@ViewBag.Erro</div>
            }

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <form asp-controller="Auth" asp-action="ReportarProblema" method="post">
                        @Html.AntiForgeryToken()

                        <label class="form-label fw-bold text-muted small d-block">O que você quer nos dizer?</label>
                        <div class="btn-group w-100 mb-4" role="group">
                            <input type="radio" class="btn-check" name="tipo" id="tipoSugestao" value="Sugestão" autocomplete="off" checked />
                            <label class="btn btn-outline-primary" for="tipoSugestao">
                                <i class="bi bi-lightbulb"></i> Sugestão
                            </label>

                            <input type="radio" class="btn-check" name="tipo" id="tipoBug" value="Bug" autocomplete="off" />
                            <label class="btn btn-outline-primary" for="tipoBug">
                                <i class="bi bi-bug"></i> Bug
                            </label>

                            <input type="radio" class="btn-check" name="tipo" id="tipoCritica" value="Crítica" autocomplete="off" />
                            <label class="btn btn-outline-primary" for="tipoCritica">
                                <i class="bi bi-chat-quote"></i> Crítica
                            </label>
                        </div>

                        <label class="form-label fw-bold text-muted small d-block" for="mensagem">Conta pra gente</label>
                        <textarea class="form-control" name="mensagem" id="mensagem" rows="6" required
                                  placeholder="Se for um bug, diz o que você estava fazendo quando aconteceu — ajuda muito a achar."></textarea>

                        @if (User.Identity?.IsAuthenticated != true)
                        {
                            <label class="form-label fw-bold text-muted small d-block mt-3" for="contato">
                                Seu nome ou contato <span class="fw-normal">(opcional)</span>
                            </label>
                            <input type="text" class="form-control" name="contato" id="contato" maxlength="120"
                                   placeholder="Pra gente saber com quem falar" />
                        }

                        <button type="submit" class="btn btn-padel btn-lg w-100 rounded-pill mt-4">
                            <i class="bi bi-whatsapp me-1"></i> Enviar pelo WhatsApp
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
