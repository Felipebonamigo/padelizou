@model Jogador
@{
    ViewData["Title"] = "Minhas Preferências - Padelizou";
    var preferencias = new Padelizou.ViewModels.PreferenciasViewModel
    {
        LadoQuadra = Model.LadoQuadra,
        Lateralidade = Model.Lateralidade,
        PerfilPrivado = Model.PerfilPrivado,
        Instagram = Model.Instagram,
        NotificarEmail = Model.NotificarEmail,
        NotificarWhatsApp = Model.NotificarWhatsApp,
        AceitaConvitesJogo = Model.AceitaConvitesJogo,
        NotificarTorneiosAbertos = Model.NotificarTorneiosAbertos,
        NotificarSeguidosTorneio = Model.NotificarSeguidosTorneio,
        NotificarAvisoJogo = Model.NotificarAvisoJogo,
        NotificarJogoAula = Model.NotificarJogoAula,
        NotificarRaqueteLivre = Model.NotificarRaqueteLivre,
        NotificarHorarioVagoRegiao = Model.NotificarHorarioVagoRegiao,
        CategoriasSelecionadas = Model.JogadorCategorias.Select(c => c.CategoriaPadraoId).ToHashSet(),
        ClubesSelecionados = Model.JogadorClubes.Select(c => c.ClubeId).ToHashSet(),
        DiasHorariosSelecionados = Model.JogadorDiasHorarios.Select(d => $"{d.DiaSemana}|{d.Periodo}").ToHashSet(),
        CidadesSelecionadas = Model.JogadorCidades.Select(c => c.CidadeId).ToHashSet()
    };
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="fw-bold" style="color: var(--pdz-ink);">Minhas Preferências</h2>
                    <p class="text-muted mb-0">Isso controla os avisos de jogo que você recebe.</p>
                </div>
                <a asp-controller="Auth" asp-action="Perfil" class="btn btn-outline-secondary rounded-pill">Voltar ao Perfil</a>
            </div>

            @if (TempData["Sucesso"] != null)
            {
                <div class="alert alert-success">@TempData["Sucesso"]</div>
            }

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <form asp-controller="Auth" asp-action="Preferencias" method="post">
                        <partial name="_PreferenciasFields" model="preferencias" />
                        <button type="submit" class="btn btn-padel btn-lg w-100 rounded-pill mt-3">Salvar Preferências</button>
                    </form>
                </div>
            </div>

            @* O RECIBO DO ACEITE. A prova de consentimento não serve de nada guardada só do
               nosso lado: quem aceitou tem direito de saber O QUE aceitou e QUANDO (LGPD,
               art. 9º). Quem se cadastrou antes de 10/08/2026 não tem registro, e a tela
               diz isso em vez de inventar uma data — "não temos registro" é a verdade, e
               "não aceitou" não seria. *@
            @if (Model.TermosAceitosEm is DateTime aceitoEm)
            {
                <p class="small text-muted text-center mt-3 mb-0">
                    <i class="bi bi-file-earmark-check"></i>
                    Você aceitou os
                    <a asp-controller="Home" asp-action="Termos">Termos de Uso</a> e a
                    <a asp-controller="Home" asp-action="Privacy">Política de Privacidade</a>
                    em @aceitoEm.ToString("dd/MM/yyyy")@(Model.VersaoDosTermosAceita is string versao ? $" (versão {versao})" : "").
                </p>
            }
            else
            {
                <p class="small text-muted text-center mt-3 mb-0">
                    <i class="bi bi-file-earmark-text"></i>
                    Sua conta é anterior ao registro de aceite, então não temos essa data guardada. Valem
                    os <a asp-controller="Home" asp-action="Termos">Termos de Uso</a> e a
                    <a asp-controller="Home" asp-action="Privacy">Política de Privacidade</a> em vigor.
                </p>
            }
        </div>
    </div>
</div>
