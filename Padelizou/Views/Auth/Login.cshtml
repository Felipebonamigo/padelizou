@{
    ViewData["Title"] = "Entrar - Padelizou";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-sm border-0" style="border-top: 4px solid var(--padel-green);">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <img src="~/image/logo-icon.webp" asp-append-version="true" alt="Padelizou" style="height: 60px;" />
                        <h3 class="mt-3 fw-bold" style="color: var(--pdz-ink);">Área do Jogador</h3>
                    </div>

                    @if (ViewBag.Erro != null)
                    {
                        <div class="alert alert-danger text-center">@ViewBag.Erro</div>
                    }
                    @if (TempData["Sucesso"] != null)
                    {
                        <div class="alert alert-success text-center">@TempData["Sucesso"]</div>
                    }

                    <form asp-controller="Auth" asp-action="Login" method="post">
                        @* De onde a pessoa veio. Quem chegou aqui empurrado pela inscrição do
                           torneio volta pra ela depois de entrar, em vez de cair no perfil e
                           ter que achar o torneio de novo. *@
                        <input type="hidden" name="returnUrl" value="@(ViewBag.ReturnUrl as string)" />
                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted">E-mail ou login</label>
                            @* type="text" e não "email": com "email" o navegador recusaria
                               um login como "Bona" antes mesmo de enviar o formulário. *@
                            <input type="text" name="email" class="form-control form-control-lg"
                                   required autocapitalize="none" autocomplete="username"
                                   placeholder="seu@email.com ou seu login" />
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-bold text-muted">Senha</label>
                            <div class="input-group">
                                <input type="password" name="senha" class="form-control form-control-lg" required placeholder="••••••••" />
                                <button type="button" class="btn btn-outline-secondary" onclick="pdzAlternarSenha(this)" tabindex="-1" aria-label="Mostrar senha">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-padel btn-lg w-100 rounded-pill">Entrar na Quadra</button>
                        <div class="text-center mt-3">
                            <a asp-action="EsqueciSenha" class="small">Esqueci minha senha</a>
                        </div>
                        <div class="text-center mt-3">
                            <a asp-action="Cadastro" class="text-decoration-none fw-bold" style="color: var(--pdz-ink);">Ainda não tem conta? Cadastre-se</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>