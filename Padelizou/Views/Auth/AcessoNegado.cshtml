@{
    ViewData["Title"] = "Sem acesso";
}

@* Esta tela é o destino de todo Forbid() do site. Ela precisa dizer duas coisas: que NÃO é
   erro (o link está certo, a conta é que não alcança) e o que fazer agora — senão a pessoa
   fica recarregando, achando que o site quebrou. *@
<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm text-center">
                <div class="card-body p-4 p-md-5">
                    <i class="bi bi-shield-lock-fill" style="font-size: 3rem; color: var(--padel-green);"></i>
                    <h4 class="fw-bold mt-3" style="color: var(--pdz-ink);">Essa parte não é sua</h4>
                    <p class="text-muted">
                        O link está certo — sua conta é que não tem acesso a esta tela. Costuma ser
                        coisa de organizador ou de quem criou o torneio.
                    </p>
                    <p class="text-muted small">
                        Se você ajuda a organizar um torneio, algumas telas ficam só com quem o criou —
                        o dinheiro é uma delas. Fale com essa pessoa.
                    </p>
                    <div class="d-flex gap-2 justify-content-center flex-wrap mt-3">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-padel rounded-pill px-4">
                            <i class="bi bi-house-door"></i> Ir pro início
                        </a>
                        <a asp-controller="Auth" asp-action="ReportarProblema" class="btn btn-outline-secondary rounded-pill px-4">
                            <i class="bi bi-chat-dots"></i> Avisar que algo está errado
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
