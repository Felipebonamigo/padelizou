@{
    ViewData["Title"] = "Criar nova senha - Padelizou";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        @* Mesma largura fixa da tela de entrar — ver .pdz-auth-col no site.css. *@
        <div class="col-12 pdz-auth-col">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4 p-sm-5">
                    <h3 class="fw-bold mb-3" style="color: var(--pdz-ink);">Criar nova senha</h3>

                    @if (ViewBag.Erro != null)
                    {
                        <div class="alert alert-danger">@ViewBag.Erro</div>
                    }

                    <form asp-action="RedefinirSenha" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="token" value="@ViewBag.Token" />

                        <label class="form-label fw-bold text-muted">Nova senha</label>
                        <div class="input-group">
                            <input type="password" name="senha" class="form-control form-control-lg" required
                                   minlength="6" autocomplete="new-password" placeholder="••••••••" />
                            <button type="button" class="btn btn-outline-secondary" onclick="pdzAlternarSenha(this)" tabindex="-1">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <small class="text-muted d-block mt-1">Pelo menos 6 caracteres.</small>

                        <button type="submit" class="btn btn-padel btn-lg w-100 rounded-pill mt-3">
                            Salvar e entrar
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
