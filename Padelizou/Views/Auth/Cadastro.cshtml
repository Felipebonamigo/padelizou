@{
    ViewData["Title"] = "Cadastro - Padelizou";
    var catalogoCategorias = (List<CategoriaPadrao>)ViewBag.CatalogoCategorias;
    var catalogoClubes = (List<Clube>)ViewBag.CatalogoClubes;
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card shadow-sm border-0" style="border-top: 4px solid var(--padel-green);">
                <div class="card-body p-4 p-md-5">
                    <div class="text-center mb-4">
                        <h3 class="fw-bold" style="color: var(--pdz-ink);">Crie seu Perfil</h3>
                        <p class="text-muted">Junte-se ao Padelizou para acompanhar seu ranking e gerenciar seus jogos.</p>
                    </div>

                    @if (ViewBag.Erro != null)
                    {
                        <div class="alert alert-danger text-center">@ViewBag.Erro</div>
                    }

                    <!-- ATENÇÃO AO ENCTYPE: Obrigatório para a foto funcionar -->
                    <form asp-controller="Auth" asp-action="Cadastro" method="post" enctype="multipart/form-data">
                        @* Pra onde voltar depois de criar a conta — o convite que trouxe a
                           pessoa até aqui. Vai escondido no formulário pra sobreviver às
                           recusas: sem isto, um CPF digitado errado apagava o destino. *@
                        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

                        <!-- Dados Pessoais -->
                        <div class="row mb-3">
                            <div class="col-md-7">
                                <label class="form-label fw-bold text-muted small">Nome Completo</label>
                                <input type="text" name="nome" class="form-control bg-light" maxlength="100" required placeholder="Ex: José Carlos da Silva" value="@(ViewBag.FormNome as string)" />
                                @* O porquê fica na tela: sem ele, "precisa de sobrenome" parece
                                   implicância e a pessoa enfia o apelido aqui pra passar. *@
                                <small class="text-muted">
                                    Nome e sobrenome, como no documento — é assim que os rankings e os torneios
                                    te encontram. Tem apelido? Ele tem campo próprio logo abaixo.
                                </small>
                            </div>
                            <div class="col-md-5 mt-3 mt-md-0">
                                <label class="form-label fw-bold text-muted small">CPF (Apenas números)</label>
                                <input type="text" name="cpf" class="form-control bg-light" required
                                       data-mascara="cpf" inputmode="numeric" placeholder="000.000.000-00" value="@(ViewBag.FormCpf as string)" />
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-12">
                                <label class="form-label fw-bold text-muted small">Apelido <span class="fw-normal">(opcional)</span></label>
                                <input type="text" name="apelido" class="form-control bg-light" maxlength="40"
                                       placeholder="Como te chamam na quadra — ex: Zeca" value="@(ViewBag.FormApelido as string)" />
                                <small class="text-muted">É assim que você aparece nas listas e no placar, e como as pessoas te acham.</small>
                            </div>
                        </div>

                        @* SEXO: obrigatório no cadastro desde 08/08/2026, e existe por uma razão
                           só — a Mista e a Casais são categorias de um homem e uma mulher, e
                           sem esse dado o sistema não tinha como conferir nem avisar.

                           "com que você se identifica" é a pergunta certa, e não "sexo
                           biológico": o que a regra do torneio precisa saber é como a pessoa
                           joga e se apresenta na quadra. *@
                        <div class="row mb-3">
                            <div class="col-12">
                                <label class="form-label fw-bold text-muted small">Sexo</label>
                                <div class="d-flex gap-3">
                                    @foreach (var opcao in new[] { Padelizou.Services.SexoDoJogador.Masculino, Padelizou.Services.SexoDoJogador.Feminino })
                                    {
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="sexo" value="@opcao"
                                                   id="sexo_@opcao" required
                                                   checked="@((ViewBag.FormSexo as string) == opcao)" />
                                            <label class="form-check-label" for="sexo_@opcao">@opcao</label>
                                        </div>
                                    }
                                </div>
                                <small class="text-muted">
                                    O sexo com que você se identifica. Usado só pra categorias de dupla
                                    mista e de casais, que são de um homem e uma mulher.
                                </small>
                            </div>
                        </div>

                        <!-- Dados de Acesso -->
                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted small">Login</label>
                            <input type="text" name="login" class="form-control bg-light" required minlength="4" maxlength="30" placeholder="Ex: felipe.bona" value="@(ViewBag.FormLogin as string)" />
                            <small class="text-muted d-block mt-1">Mínimo de 4 caracteres, e precisa ser único. Usado por organizadores de torneio pra te encontrar e te adicionar como organizador.</small>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted small">E-mail</label>
                            <input type="email" name="email" class="form-control bg-light" required placeholder="seu@email.com" value="@(ViewBag.FormEmail as string)" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted small">Celular / WhatsApp</label>
                            <input type="tel" name="celular" class="form-control bg-light"
                                   data-mascara="celular" inputmode="numeric" placeholder="(51) 99999-9999" value="@(ViewBag.FormCelular as string)" />
                            <small class="text-muted d-block mt-1">Usado pra te avisar de jogos e convites por WhatsApp. Deixe em branco se preferir não informar.</small>
                        </div>

                        @* CEP no cadastro é o que conserta a cidade na ORIGEM: até aqui esta
                           tela não perguntava cidade nenhuma, e ela só aparecia depois, digitada
                           à mão em Editar Perfil ou na inscrição de torneio — de onde saíram
                           "GRAVATAI", "POA" e companhia. Continua opcional. *@
                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted small">
                                CEP <span class="fw-normal">(opcional)</span>
                            </label>
                            <input type="text" name="cep" data-cep data-mascara="cep" class="form-control bg-light"
                                   inputmode="numeric" placeholder="00000-000" style="max-width: 12rem;"
                                   value="@(ViewBag.FormCep as string)" />
                            <small id="pdzCepRecado" class="d-block mt-1 small text-muted">
                                Preenche sua cidade sozinho — assim você aparece no ranking da sua região.
                            </small>
                        </div>

                        @* Cidade e UF ficam escondidos e só leitura: no cadastro eles são
                           RESULTADO do CEP, não pergunta. Quem não informar o CEP preenche a
                           cidade depois, no perfil — pedir as duas coisas aqui alongaria um
                           formulário que já é longo. *@
                        <div id="pdzEnderecoAchado" class="mb-3 @(string.IsNullOrWhiteSpace(ViewBag.FormCep as string) ? "d-none" : "")">
                            <div class="row">
                                <div class="col-8">
                                    <label class="form-label fw-bold text-muted small">Cidade</label>
                                    <input type="text" id="pdzCidade" class="form-control bg-light" readonly />
                                </div>
                                <div class="col-4">
                                    <label class="form-label fw-bold text-muted small">UF</label>
                                    <input type="text" id="pdzEstado" class="form-control bg-light" readonly />
                                </div>
                            </div>
                            <div class="row mt-2">
                                <div class="col-8">
                                    <label class="form-label fw-bold text-muted small">Rua</label>
                                    <input type="text" id="pdzLogradouro" class="form-control bg-light" readonly />
                                </div>
                                <div class="col-4">
                                    <label class="form-label fw-bold text-muted small">Bairro</label>
                                    <input type="text" id="pdzBairro" class="form-control bg-light" readonly />
                                </div>
                            </div>
                            <div class="form-check form-switch mt-3">
                                <input class="form-check-input" type="checkbox" name="enderecoPublico" value="true"
                                       id="switchEnderecoPublico" checked="@(ViewBag.FormEnderecoPublico as bool? == true)" />
                                <label class="form-check-label small" for="switchEnderecoPublico">
                                    Mostrar minha rua e meu bairro no meu perfil
                                </label>
                                <small class="text-muted d-block mt-1">
                                    Desligado, só você vê. Cidade e estado aparecem de qualquer jeito — é o que faz o
                                    ranking da sua região funcionar. O CEP nunca aparece pra ninguém.
                                </small>
                            </div>
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-bold text-muted small">Senha</label>
                            <div class="input-group">
                                <input type="password" name="senha" class="form-control bg-light" required placeholder="••••••••" />
                                <button type="button" class="btn btn-outline-secondary" onclick="pdzAlternarSenha(this)" tabindex="-1" aria-label="Mostrar senha">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                        </div>

                        <!-- O Switch Inteligente de Professor -->
                        <div class="mb-4 p-3 rounded" style="background-color: var(--pdz-surface-alt); border-left: 4px solid var(--pdz-navy-fixed);">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="isProfessor" value="true" id="switchProfessor" style="transform: scale(1.3); margin-right: 10px;" checked="@(ViewBag.FormIsProfessor as bool? == true)">
                                <label class="form-check-label fw-bold" for="switchProfessor" style="color: var(--pdz-ink);">
                                    Sou Professor de Padel
                                </label>
                            </div>
                            <small class="text-muted d-block mt-2">Marque esta opção se você deseja receber agendamentos de aulas e gerenciar sua agenda no sistema.</small>
                        </div>

                        <!-- Upload da Foto -->
                        <div class="mb-4 p-3 rounded" style="border: 2px dashed var(--pdz-border);">
                            <label class="form-label fw-bold text-muted mb-2">
                                <i class="bi bi-camera-fill me-1"></i> Foto de Perfil (Opcional)
                            </label>
                            <input type="file" name="foto" class="form-control" accept="image/*" />
                            <small class="text-muted d-block mt-1">Formatos aceitos: JPG ou PNG.</small>
                        </div>

                        <!-- Meu time -->
                        <div class="mb-4 p-3 rounded" style="background-color: var(--pdz-surface-alt); border-left: 4px solid var(--pdz-lime);">
                            <label class="form-label fw-bold text-muted small d-block" for="timeId">
                                <i class="bi bi-flag-fill me-1"></i> Meu time <span class="fw-normal">(opcional)</span>
                            </label>

                            @{
                                var catalogoTimes = ViewBag.CatalogoTimes as List<Padelizou.Models.Time> ?? new List<Padelizou.Models.Time>();
                            }
                            <select name="timeId" id="timeId" class="form-select">
                                <option value="">-- Não jogo por nenhum time --</option>
                                @foreach (var time in catalogoTimes)
                                {
                                    <option value="@time.Id">@time.Nome</option>
                                }
                            </select>

                            <div class="mt-2">
                                <input type="text" name="nomeTime" class="form-control" maxlength="80"
                                       placeholder="Não achou o seu? Escreva o nome e a gente cria" />
                                <small class="text-muted d-block mt-1">
                                    Você vira o dono e pode colocar o logo depois. Cada pessoa pode criar um time só.
                                </small>
                            </div>
                        </div>

                        <hr class="my-4" />
                        <h5 class="fw-bold text-muted mb-3">Preferências de jogo</h5>
                        <p class="small text-muted mt-n2 mb-3">
                            Usamos isso pra te avisar de jogos que combinam com você. Pode deixar em branco
                            (ou usar os botões "qualquer") e mudar tudo depois em "Minhas Preferências".
                        </p>

                        <partial name="_PreferenciasFields" model="@(new Padelizou.ViewModels.PreferenciasViewModel())" />

                        @* ACEITE DOS TERMOS — colado no botão, que é onde a pessoa está olhando
                           na hora de decidir. Até 10/08/2026 o cadastro não dizia uma palavra
                           sobre os dois documentos (eles só existiam no rodapé) e nada ficava
                           gravado: não havia prova nenhuma de consentimento, e o ônus dessa
                           prova é de quem controla os dados (LGPD, art. 8º §2).

                           Sem caixa de marcar, de propósito: o que os Termos pedem é aceite de
                           CONTRATO, e os consentimentos que a LGPD exige marcados um a um
                           (WhatsApp, notificação, rua e bairro) já são interruptores separados
                           aqui na tela. Uma caixa a mais barraria cadastro sem provar mais
                           nada — o que prova é a frase estar aqui, a versão estar gravada na
                           linha da pessoa (Jogador.TermosAceitosEm) e o texto daquela versão
                           estar no histórico do repositório. *@
                        <p class="small text-muted mt-4 mb-0 text-center">
                            Ao finalizar, você aceita os
                            <a asp-controller="Home" asp-action="Termos" target="_blank" rel="noopener">Termos de Uso</a>
                            e a
                            <a asp-controller="Home" asp-action="Privacy" target="_blank" rel="noopener">Política de Privacidade</a>
                            (versão de @Padelizou.Services.VersaoDosDocumentos.EmVigorDesdeNaTela).
                        </p>
                        <button type="submit" class="btn btn-padel btn-lg w-100 rounded-pill mt-2">Finalizar Cadastro</button>
                    </form>

                    <div class="text-center mt-4">
                        <a asp-action="Login" class="text-decoration-none fw-bold" style="color: var(--pdz-ink);">Já tem uma conta? Faça Login</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>