@model Clube
@inject Padelizou.Services.PortaDoMarcarJogo PortaMarcarJogo
@{
    ViewData["Title"] = $"Gerenciar {Model.Nome} - Padelizou";
    var souDono = (bool)ViewBag.SouDono;
    var administradores = (List<ClubeAdministrador>)ViewBag.Administradores;
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold" style="color: var(--pdz-ink);">@Model.Nome</h2>
            <p class="text-muted mb-0">
                Dono: @(Model.Dono != null ? Model.Dono.Nome : "—")
            </p>
        </div>
        @* Esta tela é só sobre QUEM pode administrar. Quem chega aqui procurando a agenda, as
           quadras ou o financeiro precisa de um caminho — senão conclui que o clube não tem
           painel nenhum. *@
        <div class="d-flex gap-2 flex-wrap">
            <a asp-controller="ClubeGestao" asp-action="Painel" asp-route-id="@Model.Id" class="btn btn-padel rounded-pill">
                <i class="bi bi-speedometer2"></i> Painel do clube
            </a>
            <a asp-controller="RaqueteLivre" asp-action="Criar" asp-route-clubeId="@Model.Id" class="btn btn-outline-secondary rounded-pill">
                <i class="bi bi-megaphone"></i> Publicar Raquete Livre
            </a>
        </div>
    </div>

    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success">@TempData["Sucesso"]</div>
    }

    @* O interruptor da agenda só aparece com o módulo de pé. Enquanto o Marcar Jogo está
       escondido (Services/PortaDoMarcarJogo), ligar aqui não colocaria o clube em vitrine
       nenhuma: o dono cadastraria quadras e horários pra ninguém, e concluiria que o
       Padelizou não funciona. O estado fica guardado — quem já ligou continua ligado. *@
    @if (await PortaMarcarJogo.PodeUsarAsync(User))
    {
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <h6 class="fw-bold text-muted mb-3">Marcar Jogo pelo Padelizou</h6>
            <form asp-controller="Clubes" asp-action="AtivarMarcacaoHorarios" method="post" class="mb-2">
                <input type="hidden" name="clubeId" value="@Model.Id" />
                <input type="hidden" name="ativa" value="@((!Model.MarcacaoHorariosAtiva).ToString())" />
                <div class="form-check form-switch d-inline-block">
                    <input class="form-check-input" type="checkbox" role="switch" @(Model.MarcacaoHorariosAtiva ? "checked" : "")
                           onchange="this.form.submit()" style="transform: scale(1.2);" />
                    <label class="form-check-label">Permitir que jogadores marquem horário de quadra por aqui</label>
                </div>
            </form>

            @if (Model.MarcacaoHorariosAtiva)
            {
                <form asp-controller="Clubes" asp-action="AtivarNotificacaoDiaria" method="post" class="mb-3">
                    <input type="hidden" name="clubeId" value="@Model.Id" />
                    <input type="hidden" name="ativa" value="@((!Model.NotificarHorariosDiariamente).ToString())" />
                    <div class="form-check form-switch d-inline-block">
                        <input class="form-check-input" type="checkbox" role="switch" @(Model.NotificarHorariosDiariamente ? "checked" : "")
                               onchange="this.form.submit()" style="transform: scale(1.2);" />
                        <label class="form-check-label">Avisar diariamente jogadores da região quando houver horário livre</label>
                    </div>
                </form>

                <a asp-controller="HorarioMarcacao" asp-action="Index" asp-route-clubeId="@Model.Id" class="btn btn-sm btn-outline-primary rounded-pill">
                    <i class="bi bi-calendar-week"></i> Gerenciar Horários
                </a>
            }
            else
            {
                <p class="text-muted small mb-0">Ative pra cadastrar quadras e horários disponíveis.</p>
            }
        </div>
    </div>
    }

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <h6 class="fw-bold text-muted mb-3">Administradores</h6>
            <div class="list-group mb-3">
                @if (administradores.Any())
                {
                    @foreach (var admin in administradores)
                    {
                        <div class="list-group-item d-flex justify-content-between align-items-center">
                            <span>@admin.Jogador.ComoChamar</span>
                            @if (souDono)
                            {
                                <form asp-controller="Clubes" asp-action="RemoverAdministrador" method="post">
                                    <input type="hidden" name="clubeId" value="@Model.Id" />
                                    <input type="hidden" name="jogadorId" value="@admin.JogadorId" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Remover</button>
                                </form>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="list-group-item text-muted">Nenhum administrador ainda.</div>
                }
            </div>

            <label class="form-label fw-bold small">Adicionar administrador (por CPF ou login)</label>
            @{
                ViewData["BuscaOrgActionUrl"] = Url.Action("AdicionarAdministrador", "Clubes");
                ViewData["BuscaOrgExtraFieldName"] = "clubeId";
                ViewData["BuscaOrgExtraFieldValue"] = Model.Id;
            }
            <partial name="_BuscaOrganizador" />
            @{
                ViewData["BuscaOrgActionUrl"] = null;
                ViewData["BuscaOrgExtraFieldName"] = null;
                ViewData["BuscaOrgExtraFieldValue"] = null;
            }
        </div>
    </div>
</div>
