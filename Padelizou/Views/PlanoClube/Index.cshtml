@model Padelizou.Models.Clube
@using Padelizou.Services
@{
    var cfg = (PlanoClubeSettings)ViewBag.Cfg;
    var situacao = (PlanoDoClube.Situacao)ViewBag.Situacao;
    var fimDoTeste = ViewBag.FimDoTeste as DateTime?;
    var aberta = ViewBag.CobrancaAberta as Padelizou.Models.Pagamento;
    ViewData["Title"] = $"Plano do clube — {Model.Nome}";

    var escolhido = Model.PlanoDoClube;
    var emTeste = situacao == PlanoDoClube.Situacao.EmTeste;

    // Enquanto a emissão não está no ar, o card do Fiscal continua na tela — a vitrine do que
    // vem aí vale, e é ela que mede o interesse — mas sem botão de comprar. Ver PlanoDoClube.
    // Sem a informação, assume-se NÃO à venda: o pior caso desse lado é um botão a menos por
    // um dia; o pior caso do outro é alguém pagando por um módulo que não emite nada.
    var fiscalAVenda = ViewBag.FiscalAVenda is bool a && a;
}

<div class="container mt-4 mb-5" style="max-width: 900px;">

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div>
            <h2 class="fw-bold mb-0" style="color: var(--pdz-ink);"><i class="bi bi-stars"></i> Plano do clube</h2>
            <p class="text-muted small mb-0">@Model.Nome</p>
        </div>
        <a asp-controller="ClubeGestao" asp-action="Painel" asp-route-id="@Model.Id"
           class="btn btn-outline-secondary rounded-pill px-3">
            <i class="bi bi-arrow-left"></i> Voltar ao painel
        </a>
    </div>

    @if (TempData["Erro"] != null)
    {
        <div class="alert alert-warning border-0"><i class="bi bi-exclamation-triangle-fill me-1"></i> @TempData["Erro"]</div>
    }
    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success border-0"><i class="bi bi-check-circle-fill me-1"></i> @TempData["Sucesso"]</div>
    }

    @* A situação vem primeiro: quem abre esta tela quer saber "até quando eu tenho?" antes
       de qualquer preço. *@
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div>
                <div class="fw-bold">@PlanoDoClube.RotuloDoPlano(escolhido)</div>
                <div class="small text-muted">@PlanoDoClube.Recado(Model, DateTime.Now, cfg)</div>
            </div>
            @if (emTeste && fimDoTeste != null)
            {
                var diasQueFaltam = Math.Max(0, (fimDoTeste.Value.Date - DateTime.Today).Days);
                <span class="badge rounded-pill bg-info-subtle text-info-emphasis px-3 py-2">
                    @diasQueFaltam @(diasQueFaltam == 1 ? "dia" : "dias") de teste
                </span>
            }
            else if (situacao == PlanoDoClube.Situacao.EmDia)
            {
                <span class="badge rounded-pill bg-success-subtle text-success-emphasis px-3 py-2">Em dia</span>
            }
            else if (situacao == PlanoDoClube.Situacao.EmAtraso)
            {
                <span class="badge rounded-pill bg-warning-subtle text-warning-emphasis px-3 py-2">Vencido</span>
            }
        </div>
    </div>

    @if (aberta != null)
    {
        <div class="alert alert-light border d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div class="small">
                <strong>Você tem uma cobrança de @aberta.Valor.ToString("C") em aberto.</strong>
                <span class="text-muted">@PixDireto.Situacao(aberta)</span>
            </div>
            @if (aberta.MetodoPagamento == PixDireto.Metodo)
            {
                <a asp-controller="Pagamentos" asp-action="Pix" asp-route-id="@aberta.Id"
                   class="btn btn-sm btn-padel fw-bold rounded-pill px-3">Ver o Pix</a>
            }
            else
            {
                <a href="@LinkDoPagamento.Para(aberta)" class="btn btn-sm btn-padel fw-bold rounded-pill px-3">
                    Ver a fatura
                </a>
            }
        </div>
    }

    <div class="row g-3 mb-4">
        @* ---- REDE: o que já é grátis e continua sendo ---- *@
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex flex-column">
                    <h5 class="fw-bold mb-1">Clube Rede</h5>
                    <div class="fs-4 fw-bold mb-2">Grátis</div>
                    <ul class="small text-muted ps-3 mb-3 flex-grow-1">
                        <li>Torneios e chaves</li>
                        <li>Ranking e Padelímetro</li>
                        <li>Reserva de quadra</li>
                        <li>Rede de jogadores</li>
                    </ul>
                    <div class="small text-muted">Já é seu — e continua sendo.</div>
                </div>
            </div>
        </div>

        @* ---- GESTÃO ---- *@
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100 @(escolhido == PlanoDoClube.Gestao ? "border-start border-4 border-success" : "")">
                <div class="card-body d-flex flex-column">
                    <h5 class="fw-bold mb-1">
                        Clube Gestão
                        @if (escolhido == PlanoDoClube.Gestao)
                        {
                            <span class="badge bg-success-subtle text-success-emphasis ms-1">seu plano</span>
                        }
                    </h5>
                    <div class="fs-4 fw-bold mb-0">@cfg.MensalidadeGestao.ToString("C")<span class="fs-6 fw-normal text-muted">/mês</span></div>
                    <div class="small text-muted mb-2">
                        ou @cfg.AnuidadeGestao.ToString("C")/ano
                        (economiza @PlanoDoClube.EconomiaDoAnual(PlanoDoClube.Gestao, cfg).ToString("C"))
                    </div>
                    <ul class="small text-muted ps-3 mb-3 flex-grow-1">
                        <li>Tudo do Rede</li>
                        <li><strong>Bar e comanda</strong></li>
                        <li><strong>Estoque e caixa do dia</strong></li>
                        <li><strong>Contas a pagar e receber</strong></li>
                    </ul>
                    @if (escolhido != PlanoDoClube.Gestao)
                    {
                        <form asp-action="Escolher" method="post" class="d-grid">
                            <input type="hidden" name="clubeId" value="@Model.Id" />
                            <input type="hidden" name="plano" value="@PlanoDoClube.Gestao" />
                            <button type="submit" class="btn btn-outline-secondary rounded-pill fw-bold">Escolher</button>
                        </form>
                    }
                </div>
            </div>
        </div>

        @* ---- FISCAL ---- *@
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100 @(escolhido == PlanoDoClube.Fiscal ? "border-start border-4 border-success" : "")">
                <div class="card-body d-flex flex-column">
                    <h5 class="fw-bold mb-1">
                        Clube Fiscal
                        @if (escolhido == PlanoDoClube.Fiscal)
                        {
                            <span class="badge bg-success-subtle text-success-emphasis ms-1">seu plano</span>
                        }
                        else if (!fiscalAVenda)
                        {
                            <span class="badge bg-secondary-subtle text-secondary-emphasis ms-1">em breve</span>
                        }
                    </h5>
                    <div class="fs-4 fw-bold mb-0">@cfg.MensalidadeFiscal.ToString("C")<span class="fs-6 fw-normal text-muted">/mês</span></div>
                    <div class="small text-muted mb-2">
                        ou @cfg.AnuidadeFiscal.ToString("C")/ano
                        (economiza @PlanoDoClube.EconomiaDoAnual(PlanoDoClube.Fiscal, cfg).ToString("C"))
                    </div>
                    <ul class="small text-muted ps-3 mb-3 flex-grow-1">
                        <li>Tudo do Gestão</li>
                        <li><strong>Nota de serviço (NFS-e)</strong> de aula e quadra</li>
                        <li><strong>Cupom do bar (NFC-e)</strong></li>
                        @* A franquia é o número que o clube compara com o concorrente — e a
                           nossa é 25% maior. Escondê-la aqui é entregar o argumento de venda
                           de graça pro outro lado (ver FISCAL.md, "O VEREDITO"). *@
                        <li><strong>@cfg.FranquiaNfseMensal notas de serviço + @cfg.FranquiaNfceMensal cupons</strong> por mês</li>
                        <li>Relatório pro contador</li>
                    </ul>
                    <div class="small text-muted mb-3">
                        Passou da franquia? @cfg.ExcedenteNfse.ToString("C") por nota de serviço e
                        @cfg.ExcedenteNfce.ToString("C") por cupom. A franquia é mensal e não acumula.
                    </div>
                    @if (!fiscalAVenda)
                    {
                        <div class="small text-muted fst-italic">
                            Ainda não está no ar — por isso não dá pra assinar. Avisamos você
                            quando a emissão de nota começar a funcionar.
                        </div>
                    }
                    else if (escolhido != PlanoDoClube.Fiscal)
                    {
                        <form asp-action="Escolher" method="post" class="d-grid">
                            <input type="hidden" name="clubeId" value="@Model.Id" />
                            <input type="hidden" name="plano" value="@PlanoDoClube.Fiscal" />
                            <button type="submit" class="btn btn-outline-secondary rounded-pill fw-bold">Escolher</button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (PlanoDoClube.EstaAVenda(escolhido, fiscalAVenda) && aberta == null)
    {
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body">
                <h6 class="fw-bold mb-2">Pagar @PlanoDoClube.RotuloDoPlano(escolhido)</h6>
                <div class="d-flex flex-wrap gap-2">
                    <form asp-action="Pagar" method="post">
                        <input type="hidden" name="clubeId" value="@Model.Id" />
                        <input type="hidden" name="ciclo" value="@CicloDeAssinatura.Mensal" />
                        <button type="submit" class="btn btn-padel rounded-pill fw-bold px-4">
                            Mensal — @PlanoDoClube.ValorDo(escolhido, CicloDeAssinatura.Mensal, cfg).ToString("C")
                        </button>
                    </form>
                    <form asp-action="Pagar" method="post">
                        <input type="hidden" name="clubeId" value="@Model.Id" />
                        <input type="hidden" name="ciclo" value="@CicloDeAssinatura.Anual" />
                        <button type="submit" class="btn btn-outline-secondary rounded-pill fw-bold px-4">
                            Anual — @PlanoDoClube.ValorDo(escolhido, CicloDeAssinatura.Anual, cfg).ToString("C")
                        </button>
                    </form>
                </div>
                @* Não é recorrência automática, e a tela precisa dizer isso: quem espera
                   débito automático descobre que não era no dia em que o bar fecha. *@
                <small class="text-muted d-block mt-2">
                    Cada pagamento estende a vigência — não há débito automático. Avisamos antes de vencer.
                </small>
            </div>
        </div>
    }

    <div class="alert alert-light border small mb-0">
        <i class="bi bi-info-circle"></i>
        O plano é do <strong>clube</strong>, mas a cobrança sai no nome de quem paga (é assim que
        o meio de pagamento funciona). Qualquer administrador do clube pode gerar e pagar — e só
        existe <strong>uma cobrança aberta por vez</strong>, pra ninguém pagar duas.
    </div>
</div>
