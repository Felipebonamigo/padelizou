@model List<Padelizou.Models.ProdutoBar>
@using Padelizou.Models
@using Padelizou.Services
@{
    var clube = (Clube)ViewBag.Clube;
    ViewData["Title"] = $"Cardápio do bar — {clube.Nome}";
    var fiscal = ViewBag.Fiscal == true;
}

<div class="container mt-4 mb-5" style="max-width: 900px;">

    @if (ViewBag.EmConstrucao == true)
    {
        <div class="alert alert-dark border-0 d-flex align-items-center gap-2 py-2">
            <i class="bi bi-cone-striped"></i>
            <div class="small"><strong>Em construção — só você está vendo isto.</strong></div>
        </div>
    }

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div>
            <h2 class="fw-bold mb-0" style="color: var(--pdz-ink);"><i class="bi bi-list-ul"></i> Cardápio</h2>
            <p class="text-muted small mb-0">@clube.Nome · o que o bar vende e por quanto</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Estoque" asp-route-id="@clube.Id" class="btn btn-outline-secondary rounded-pill px-3">
                <i class="bi bi-box-seam"></i> Estoque
            </a>
            @if (fiscal)
            {
                <a asp-action="Fiscal" asp-route-id="@clube.Id" class="btn btn-outline-secondary rounded-pill px-3">
                    <i class="bi bi-receipt"></i> Dados fiscais
                </a>
            }
            <a asp-action="Index" asp-route-id="@clube.Id" class="btn btn-outline-secondary rounded-pill px-3">
                <i class="bi bi-arrow-left"></i> Voltar ao balcão
            </a>
        </div>
    </div>

    @if (TempData["ErroBar"] != null)
    {
        <div class="alert alert-warning border-0"><i class="bi bi-exclamation-triangle-fill me-1"></i> @TempData["ErroBar"]</div>
    }

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <h6 class="fw-bold mb-3">Novo produto</h6>
            <form asp-action="SalvarProduto" method="post" class="row g-2 align-items-end">
                <input type="hidden" name="clubeId" value="@clube.Id" />
                <div class="col-md-5">
                    <label class="form-label small fw-bold mb-1">Nome</label>
                    <input type="text" name="nome" class="form-control" maxlength="80" required
                           placeholder="Ex: Heineken lata 350ml" />
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label small fw-bold mb-1">Preço</label>
                    <div class="input-group">
                        <span class="input-group-text">R$</span>
                        <input type="number" name="preco" step="0.01" min="0" required class="form-control pdz-dinheiro" />
                    </div>
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small fw-bold mb-1">Grupo</label>
                    <input type="text" name="categoria" class="form-control" maxlength="30" placeholder="Bebidas" />
                </div>
                <div class="col-md-2 d-grid">
                    <button type="submit" class="btn btn-padel fw-bold">Adicionar</button>
                </div>

                @* Estoque é opcional POR PRODUTO: lata entra e sai inteira, porção não — a
                   saída dela depende da mão de quem serve, e saldo que mente é pior que
                   saldo nenhum. *@
                <div class="col-12">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="controlaEstoque" value="true"
                               id="pdzControlaEstoque" onchange="document.getElementById('pdzCamposEstoque').style.display = this.checked ? '' : 'none';">
                        <label class="form-check-label small fw-bold" for="pdzControlaEstoque">
                            Controlar estoque deste produto
                        </label>
                    </div>
                </div>
                <div class="col-12" id="pdzCamposEstoque" style="display:none;">
                    <div class="row g-2">
                        <div class="col-6 col-md-3">
                            <label class="form-label small fw-bold mb-1">Unidades por caixa</label>
                            <input type="number" name="unidadesPorEmbalagem" value="1" min="1" class="form-control" />
                            <small class="text-muted">Compra caixa com 24, vende lata? Ponha 24.</small>
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label small fw-bold mb-1">Avisar quando tiver</label>
                            <input type="number" name="estoqueMinimo" min="0" placeholder="0" class="form-control" />
                            <small class="text-muted">Em branco (ou 0) desliga o aviso.</small>
                        </div>
                    </div>
                </div>
            </form>
            <small class="text-muted d-block mt-2">
                O preço vale a partir de agora. Comanda já lançada guarda o preço de quando foi
                vendida — mudar aqui não mexe em nada do que já passou.
            </small>
        </div>
    </div>

    @if (!Model.Any())
    {
        <partial name="_Vazio" model='@(new Padelizou.ViewModels.EstadoVazio("Nenhum produto no cardápio ainda. Cadastre os campeões de venda primeiro — cerveja, água, refrigerante."))' />
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle bg-white shadow-sm rounded">
                <thead>
                    <tr class="small text-muted">
                        <th>Produto</th>
                        <th class="d-none d-sm-table-cell">Grupo</th>
                        @if (fiscal)
                        {
                            <th class="d-none d-md-table-cell">Fiscal</th>
                        }
                        <th class="text-end">Preço</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr class="@(p.Ativo ? "" : "text-muted")">
                            <td>
                                <span class="fw-bold">@p.Nome</span>
                                @if (!p.Ativo)
                                {
                                    <span class="badge bg-secondary ms-1">fora de linha</span>
                                }
                                @if (p.ControlaEstoque)
                                {
                                    <span class="badge bg-info-subtle text-info-emphasis ms-1"
                                          title="Estoque controlado">
                                        <i class="bi bi-box-seam"></i>
                                    </span>
                                }
                                <span class="d-sm-none d-block small text-muted">@(p.Categoria ?? "—")</span>
                            </td>
                            <td class="d-none d-sm-table-cell">@(p.Categoria ?? "—")</td>
                            @if (fiscal)
                            {
                                var faltaNoItem = FiscalDoProduto.FaltaParaEmitir(p.TipoFiscal, p.Ncm, p.Cfop, p.UnidadeComercial);
                                <td class="d-none d-md-table-cell small">
                                    @if (faltaNoItem.Count == 0)
                                    {
                                        <span class="badge bg-success-subtle text-success-emphasis">
                                            @FiscalDoProduto.DocumentoDoTipo(p.TipoFiscal)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis">incompleto</span>
                                    }
                                </td>
                            }
                            <td class="text-end fw-bold text-nowrap">@p.Preco.ToString("C")</td>
                            <td class="text-end text-nowrap">
                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                        title="Editar" aria-label="Editar produto"
                                        onclick="pdzEditarProduto(@p.Id, this)"
                                        data-nome="@p.Nome" data-preco="@p.Preco.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                        data-categoria="@p.Categoria" data-ordem="@p.Ordem">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                @* Inativa, nunca apaga: as comandas antigas continuam apontando
                                   pro produto, e apagar levaria junto o histórico de venda. *@
                                @if (fiscal)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-secondary"
                                            data-bs-toggle="collapse" data-bs-target="#pdzFiscal_@p.Id"
                                            title="Dados fiscais" aria-label="Dados fiscais do produto">
                                        <i class="bi bi-receipt"></i>
                                    </button>
                                }
                                <form asp-action="AlternarProduto" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@p.Id" />
                                    <button type="submit" class="btn btn-sm @(p.Ativo ? "btn-outline-danger" : "btn-outline-success")"
                                            title="@(p.Ativo ? "Tirar de linha" : "Voltar pro cardápio")"
                                            aria-label="@(p.Ativo ? "Tirar de linha" : "Voltar pro cardápio")">
                                        <i class="bi @(p.Ativo ? "bi-eye-slash" : "bi-eye")"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>

                        @if (fiscal)
                        {
                            @* A linha fiscal fica DOBRADA: ela é preenchida uma vez na vida do
                               produto, junto com o contador, e depois nunca mais. Aberta por
                               padrão, empurraria o cardápio inteiro pra baixo todo dia por
                               causa de um cadastro anual. *@
                            <tr class="collapse" id="pdzFiscal_@p.Id">
                                <td colspan="@(fiscal ? 5 : 4)" class="bg-light">
                                    <form asp-action="SalvarProduto" method="post" class="row g-2 align-items-end small">
                                        <input type="hidden" name="clubeId" value="@clube.Id" />
                                        <input type="hidden" name="id" value="@p.Id" />
                                        @* Nome, preço e grupo viajam junto porque a ação é a
                                           mesma do cardápio — sem eles, salvar o NCM apagaria
                                           o preço do produto. *@
                                        <input type="hidden" name="nome" value="@p.Nome" />
                                        <input type="hidden" name="preco" value="@p.Preco.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                                        <input type="hidden" name="categoria" value="@p.Categoria" />
                                        <input type="hidden" name="ordem" value="@p.Ordem" />

                                        <div class="col-12">
                                            <label class="form-label small fw-bold mb-1">O que este item é</label>
                                            <select name="tipoFiscal" class="form-select form-select-sm">
                                                <option value="">Não definido</option>
                                                @foreach (var t in FiscalDoProduto.Tipos)
                                                {
                                                    <option value="@t" selected="@(p.TipoFiscal == t)">@FiscalDoProduto.RotuloDoTipo(t)</option>
                                                }
                                            </select>
                                            <small class="text-muted">
                                                Decide qual documento sai — e o aluguel não sai em nenhum.
                                            </small>
                                        </div>

                                        <div class="col-6 col-md-3">
                                            <label class="form-label small fw-bold mb-1">NCM</label>
                                            <input type="text" name="ncm" class="form-control form-control-sm"
                                                   maxlength="8" value="@p.Ncm" placeholder="8 dígitos" />
                                        </div>
                                        <div class="col-6 col-md-2">
                                            <label class="form-label small fw-bold mb-1">CFOP</label>
                                            <input type="text" name="cfop" class="form-control form-control-sm"
                                                   maxlength="4" value="@p.Cfop" placeholder="5102" />
                                        </div>
                                        <div class="col-6 col-md-2">
                                            <label class="form-label small fw-bold mb-1">Unidade</label>
                                            <input type="text" name="unidadeComercial" class="form-control form-control-sm"
                                                   maxlength="6" value="@p.UnidadeComercial" placeholder="UN" />
                                        </div>
                                        <div class="col-6 col-md-2">
                                            <label class="form-label small fw-bold mb-1">CEST</label>
                                            <input type="text" name="cest" class="form-control form-control-sm"
                                                   maxlength="7" value="@p.Cest" />
                                        </div>
                                        <div class="col-6 col-md-3">
                                            <label class="form-label small fw-bold mb-1">Código de barras</label>
                                            <input type="text" name="codigoBarras" class="form-control form-control-sm"
                                                   maxlength="14" value="@p.CodigoBarras" />
                                        </div>

                                        <div class="col-6 col-md-3">
                                            <label class="form-label small fw-bold mb-1">Origem</label>
                                            <input type="number" name="origemMercadoria" min="0" max="8"
                                                   class="form-control form-control-sm" value="@p.OrigemMercadoria"
                                                   placeholder="0 = nacional" />
                                        </div>
                                        <div class="col-6 col-md-3">
                                            <label class="form-label small fw-bold mb-1">CSOSN / CST</label>
                                            <input type="text" name="csosnOuCst" class="form-control form-control-sm"
                                                   maxlength="4" value="@p.CsosnOuCst" />
                                            <small class="text-muted">Bebida costuma ter ICMS-ST — confirme.</small>
                                        </div>
                                        <div class="col-md-6 d-grid d-md-block text-md-end">
                                            <button type="submit" class="btn btn-sm btn-padel fw-bold px-3">
                                                Salvar dados fiscais
                                            </button>
                                        </div>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <form asp-action="SalvarProduto" method="post" id="pdzFormEditar" class="d-none">
            <input type="hidden" name="clubeId" value="@clube.Id" />
            <input type="hidden" name="id" />
            <input type="hidden" name="nome" />
            <input type="hidden" name="preco" />
            <input type="hidden" name="categoria" />
            <input type="hidden" name="ordem" />
        </form>
    }
</div>

<script>
    // Edição por prompt: são três campos e o cardápio muda de vez em quando, não o dia todo.
    // Uma tela de edição própria aqui seria mais código pra sustentar do que valor entregue.
    function pdzEditarProduto(id, botao) {
        var nome = prompt('Nome do produto:', botao.dataset.nome);
        if (nome === null) return;

        var preco = prompt('Preço (use vírgula ou ponto):', botao.dataset.preco);
        if (preco === null) return;

        var categoria = prompt('Grupo (Bebidas, Comidas...):', botao.dataset.categoria || '');
        if (categoria === null) return;

        var form = document.getElementById('pdzFormEditar');
        form.id.value = id;
        form.nome.value = nome;
        // O servidor lê vírgula E ponto (Services/DinheiroModelBinder), então o que a pessoa
        // digitar do jeito dela chega certo.
        form.preco.value = preco;
        form.categoria.value = categoria;
        form.ordem.value = botao.dataset.ordem;
        form.submit();
    }

    document.querySelectorAll('.pdz-dinheiro').forEach(function (el) {
        el.addEventListener('blur', function () {
            if (el.value === '') return;
            var n = parseFloat(el.value);
            if (!isNaN(n)) el.value = n.toFixed(2);
        });
        el.addEventListener('focus', function () { setTimeout(function () { el.select(); }, 0); });
        el.addEventListener('mouseup', function (ev) { ev.preventDefault(); });
    });
</script>
