@using Padelizou.Services
@{
    ViewData["Title"] = "Gerenciar Horários - Padelizou";
    var clube = (Clube)ViewBag.Clube;
    var quadras = (List<QuadraClube>)ViewBag.Quadras;
    var horarios = (List<HorarioMarcacaoDisponivel>)ViewBag.Horarios;
    string[] diasSemana = { "Domingo", "Segunda", "Terça", "Quarta", "Quinta", "Sexta", "Sábado" };
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold" style="color: var(--pdz-ink);">Horários — @clube.Nome</h2>
            <p class="text-muted mb-0">Quadras e disponibilidade semanal recorrente pra marcação.</p>
        </div>
        <div class="d-flex gap-2">
            @if (clube.NotificarHorariosDiariamente)
            {
                <form asp-controller="HorarioMarcacao" asp-action="AvisarVagaHoje" method="post">
                    <input type="hidden" name="clubeId" value="@clube.Id" />
                    <button type="submit" class="btn btn-outline-primary rounded-pill">
                        <i class="bi bi-bell"></i> Avisar vaga hoje
                    </button>
                </form>
            }
            <a asp-controller="Clubes" asp-action="Gerenciar" asp-route-id="@clube.Id" class="btn btn-outline-secondary rounded-pill">Voltar</a>
        </div>
    </div>

    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success">@TempData["Sucesso"]</div>
    }
    @* A tela só mostrava sucesso: uma recusa (duração que não cabe na janela) voltava sem
       dizer nada, e o dono concluía que o botão não funciona. *@
    @if (TempData["Erro"] != null)
    {
        <div class="alert alert-warning">@TempData["Erro"]</div>
    }

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <h6 class="fw-bold text-muted mb-3">Quadras</h6>
            <div class="d-flex flex-wrap gap-2 mb-3">
                @foreach (var quadra in quadras)
                {
                    <span class="badge bg-light text-dark border">@quadra.Nome</span>
                }
                @if (!quadras.Any())
                {
                    <span class="text-muted small">Nenhuma quadra cadastrada ainda.</span>
                }
            </div>
            <form asp-controller="HorarioMarcacao" asp-action="CriarQuadra" method="post" class="d-flex gap-2">
                <input type="hidden" name="clubeId" value="@clube.Id" />
                <input type="text" name="nome" class="form-control form-control-sm" placeholder="Nome da quadra (ex: Quadra 1)" style="max-width: 260px;" required />
                <button type="submit" class="btn btn-sm btn-outline-primary">Adicionar quadra</button>
            </form>
        </div>
    </div>

    @if (!quadras.Any())
    {
        <div class="alert alert-warning">Cadastre pelo menos uma quadra antes de definir horários.</div>
    }
    else
    {
        @* O caminho principal do clube novo: monta a semana inteira num clique. Os três
           botões JÁ SÃO o envio — escolher duração num select e clicar em "gerar" seria
           um passo a mais pra decisão que o botão inteiro consegue dizer sozinho. *@
        <div class="card shadow-sm border-0 mb-4" style="border-left: 4px solid var(--padel-green) !important;">
            <div class="card-body">
                <h6 class="fw-bold text-muted mb-1"><i class="bi bi-lightning-charge"></i> Montar a grade de uma vez</h6>
                <p class="small text-muted mb-3">
                    Escolha o período de funcionamento e clique na duração do jogo — os horários são
                    criados pra cada dia e quadra marcados. O que já existir naquela faixa é preservado.
                </p>
                <form asp-controller="HorarioMarcacao" asp-action="GerarGrade" method="post">
                    <input type="hidden" name="clubeId" value="@clube.Id" />
                    <div class="row g-2 align-items-end">
                        <div class="col-md-3">
                            <label class="form-label small fw-bold text-muted mb-1">Quadra</label>
                            <select name="quadraClubeId" class="form-select form-select-sm">
                                <option value="">Todas as quadras</option>
                                @foreach (var quadra in quadras)
                                {
                                    <option value="@quadra.Id">Só @quadra.Nome</option>
                                }
                            </select>
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label small fw-bold text-muted mb-1">Abre às</label>
                            <input type="time" name="horaInicio" class="form-control form-control-sm" value="07:00" required />
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label small fw-bold text-muted mb-1">Fecha às</label>
                            <input type="time" name="horaFim" class="form-control form-control-sm" value="23:00" required />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small fw-bold text-muted mb-1">Preço por jogo</label>
                            <input type="number" name="preco" class="form-control form-control-sm" min="0" step="0.01" placeholder="Vazio = grátis" />
                        </div>
                    </div>
                    <div class="d-flex flex-wrap gap-3 align-items-center mt-2">
                        <span class="small fw-bold text-muted">Dias:</span>
                        @for (int d = 0; d < diasSemana.Length; d++)
                        {
                            <div class="form-check form-check-inline m-0">
                                <input class="form-check-input" type="checkbox" name="dias" value="@d"
                                       id="grade-dia-@d" checked>
                                <label class="form-check-label small" for="grade-dia-@d">@diasSemana[d].Substring(0, 3)</label>
                            </div>
                        }
                    </div>
                    @* Os três com o MESMO peso visual, de propósito: destacar um deles (o 1h
                       era verde) fazia o grupo parecer seleção — "o 1h está escolhido" — em
                       vez de três ações equivalentes. Feedback do Felipe em tela, 30/07. *@
                    <div class="d-flex flex-wrap gap-2 mt-3">
                        <button type="submit" name="duracaoMinutos" value="30" class="btn btn-padel rounded-pill px-3">
                            Gerar jogos de <strong>30 min</strong>
                        </button>
                        <button type="submit" name="duracaoMinutos" value="60" class="btn btn-padel rounded-pill px-3">
                            Gerar jogos de <strong>1h</strong>
                        </button>
                        <button type="submit" name="duracaoMinutos" value="90" class="btn btn-padel rounded-pill px-3">
                            Gerar jogos de <strong>1h30</strong>
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body">
                <h6 class="fw-bold text-muted mb-3">Novo horário recorrente</h6>
                <form asp-controller="HorarioMarcacao" asp-action="CriarHorario" method="post" class="row g-2">
                    <input type="hidden" name="clubeId" value="@clube.Id" />
                    <div class="col-md-3">
                        <select name="quadraClubeId" class="form-select" required>
                            @foreach (var quadra in quadras)
                            {
                                <option value="@quadra.Id">@quadra.Nome</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <select name="diaSemana" class="form-select" required>
                            @for (int i = 0; i < diasSemana.Length; i++)
                            {
                                <option value="@i">@diasSemana[i]</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <input type="time" name="horaInicio" class="form-control" required />
                        <div class="form-text">Início</div>
                    </div>
                    <div class="col-md-2">
                        <input type="time" name="horaFim" class="form-control" required />
                        <div class="form-text">Fim</div>
                    </div>
                    <div class="col-md-1">
                        <input type="number" name="duracaoMinutos" class="form-control" value="60" min="15" step="15" required />
                        <div class="form-text">Min</div>
                    </div>
                    <div class="col-md-2">
                        <input type="number" name="preco" class="form-control" min="0" step="0.01" placeholder="80,00" />
                        <div class="form-text">Preço (vazio = grátis)</div>
                    </div>
                    <div class="col-md-1">
                        <button type="submit" class="btn btn-padel w-100 rounded-pill">+</button>
                    </div>
                </form>
                <div class="form-text mt-2">
                    O preço é do horário inteiro (uma regra de 1h30 a R$ 120 cobra os R$ 120).
                    Para horário nobre mais caro, crie uma regra separada só para aquela faixa.
                </div>
            </div>
        </div>

        @* Reajustar preço linha a linha num clube de 3 quadras × 7 dias × 2 faixas são 42
           edições. Aqui é de uma vez — e o que ficar em branco NÃO é alterado, senão mudar só
           a duração zeraria o preço do clube inteiro. *@
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body">
                <h6 class="fw-bold text-muted mb-3"><i class="bi bi-lightning-charge"></i> Aplicar em vários de uma vez</h6>
                @* A confirmação fica no CLIQUE de cada botão, não no envio do formulário:
                   o "Excluir todos" divide este form (via formaction) e cada ação precisa
                   da própria pergunta — confirmar exclusão com o texto de aplicar seria
                   pedir sim pra pergunta errada. *@
                <form asp-controller="HorarioMarcacao" asp-action="AplicarEmTodos" method="post" class="row g-2 align-items-end">
                    <input type="hidden" name="clubeId" value="@clube.Id" />
                    <div class="col-md-4">
                        <label class="form-label small fw-bold mb-1">Onde</label>
                        <select name="quadraClubeId" class="form-select">
                            <option value="">Todas as quadras</option>
                            @foreach (var quadra in quadras)
                            {
                                <option value="@quadra.Id">Só @quadra.Nome</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold mb-1">Duração</label>
                        <select name="duracaoTodos" class="form-select">
                            <option value="">Não mudar</option>
                            @foreach (var op in HorarioDoClube.DuracoesComuns)
                            {
                                <option value="@op">@HorarioDoClube.Rotulo(op)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold mb-1">Preço</label>
                        <input type="number" name="precoTodos" class="form-control" min="0" step="0.01" placeholder="Não mudar" />
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-padel w-100 rounded-pill"
                                onclick="return confirm('Aplicar nos horários selecionados? O que estiver em branco não muda.');">
                            Aplicar
                        </button>
                    </div>
                    <div class="col-12 d-flex justify-content-end">
                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3"
                                formaction="@Url.Action("ExcluirTodos", "HorarioMarcacao")"
                                onclick="return confirm('Excluir TODOS os horários selecionados em Onde? Eles somem da tela do jogador na hora, e reservas antigas dessas faixas deixam de mostrar valor no financeiro. Pra tirar do ar sem apagar, use Desativar na lista.');">
                            <i class="bi bi-trash"></i> Excluir todos
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table align-middle bg-white shadow-sm rounded text-nowrap">
                <thead>
                    <tr>
                        <th>Quadra</th>
                        <th>Dia</th>
                        <th>Início</th>
                        <th>Fim</th>
                        <th>Duração e preço</th>
                        <th></th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (horarios.Any())
                    {
                        @foreach (var h in horarios)
                        {
                            <tr class="@(h.Ativo ? "" : "text-muted")">
                                <td>@h.QuadraClube.Nome</td>
                                <td>@diasSemana[h.DiaSemana]</td>
                                <td>@h.HoraInicio.ToString(@"hh\:mm")</td>
                                <td>@h.HoraFim.ToString(@"hh\:mm")</td>
                                @* Duração e preço no MESMO formulário: são as duas coisas que se
                                   reajusta, e separá-las em dois botões faria salvar uma
                                   descartar o que foi digitado na outra. *@
                                <td colspan="2">
                                    <form asp-controller="HorarioMarcacao" asp-action="AtualizarHorario" method="post"
                                          class="d-flex gap-1 align-items-center">
                                        <input type="hidden" name="id" value="@h.Id" />
                                        <input type="hidden" name="clubeId" value="@clube.Id" />
                                        <select name="duracaoMinutos" class="form-select form-select-sm" style="width: 6.5rem;">
                                            @foreach (var op in HorarioDoClube.Opcoes(h.DuracaoMinutos))
                                            {
                                                <option value="@op" selected="@(op == h.DuracaoMinutos)">@HorarioDoClube.Rotulo(op)</option>
                                            }
                                        </select>
                                        <input type="number" name="preco" value="@(h.Preco?.ToString("0.00"))"
                                               class="form-control form-control-sm" style="width: 6rem;"
                                               min="0" step="0.01" placeholder="Grátis" />
                                        <button type="submit" class="btn btn-sm btn-outline-secondary">Salvar</button>
                                    </form>
                                </td>
                                <td><span class="badge @(h.Ativo ? "bg-success" : "bg-secondary")">@(h.Ativo ? "Ativo" : "Inativo")</span></td>
                                <td>
                                    <form asp-controller="HorarioMarcacao" asp-action="AlternarHorario" method="post">
                                        <input type="hidden" name="id" value="@h.Id" />
                                        <input type="hidden" name="clubeId" value="@clube.Id" />
                                        <button type="submit" class="btn btn-sm @(h.Ativo ? "btn-outline-danger" : "btn-outline-success")">
                                            @(h.Ativo ? "Desativar" : "Reativar")
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">Nenhum horário cadastrado.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
