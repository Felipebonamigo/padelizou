@model Jogador
@inject Microsoft.Extensions.Options.IOptions<Padelizou.Services.TaxasExibicao> TaxasOpcoes
@{
    // A taxa do "por fora" sai da configuração, não escrita à mão: ela já mudou uma vez, e
    // um número solto na tela viraria mentira no dia seguinte.
    var taxaExterno = TaxasOpcoes.Value.ComissaoPercentualExterno.ToString("0.#");

    ViewData["Title"] = "Receber Pagamentos - Padelizou";
    var comissoes = ViewBag.ComissoesPorTipo as IDictionary<string, decimal> ?? new Dictionary<string, decimal>();
    var minimas = ViewBag.MinimasPorTipo as IDictionary<string, decimal> ?? new Dictionary<string, decimal>();
    decimal minima = ViewBag.ComissaoMinima ?? 4m;
    decimal minimaAula = minimas.TryGetValue("Aula", out var ma) ? ma : minima;
    string modoAtual = Model.ModoComissao ?? (string)(ViewBag.ModoPadrao ?? "Somada");

    // O exemplo é de AULA, não de torneio. Em torneio o modo é fixo em "Descontada" desde
    // 27/07/2026 (ver Models/Torneio.cs) — ilustrar a escolha com um torneio, como esta tela
    // fazia, mostrava uma decisão que ali não existe mais.
    decimal percentualAula = comissoes.TryGetValue("Aula", out var pa) ? pa : 10m;
    decimal exemploValor = 100m;
    decimal exemploComissao = Math.Max(Math.Round(exemploValor * percentualAula / 100m, 2), minimaAula);

    bool jaConectado = Padelizou.Services.ContaDeRecebimento.Conectada(Model);
    bool podeAbrirConta = ViewBag.PodeAbrirConta == true && !jaConectado;
    string? faltaNoPerfil = ViewBag.FaltaNoPerfil as string;
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="fw-bold" style="color: var(--pdz-ink);">Receber pelo app</h2>
                    <p class="text-muted mb-0">
                        O dinheiro dos seus torneios, aulas e quadras cai direto na sua conta.
                    </p>
                </div>
                <a asp-controller="Auth" asp-action="Perfil" class="btn btn-outline-secondary rounded-pill">Voltar ao Perfil</a>
            </div>

            @if (TempData["Sucesso"] != null)
            {
                <div class="alert alert-success">@TempData["Sucesso"]</div>
            }
            @if (TempData["Erro"] != null)
            {
                <div class="alert alert-danger">@TempData["Erro"]</div>
            }

            @* O estado vem primeiro e em uma linha só: a dúvida que traz a pessoa a esta tela
               é "isso está ligado ou não?", e antes ela tinha que deduzir pelo switch. *@
            @if (jaConectado)
            {
                <div class="alert alert-success border-0 d-flex gap-2 align-items-center">
                    <i class="bi bi-check-circle-fill fs-4 lh-1"></i>
                    <div>
                        <strong>Sua conta está conectada.</strong>
                        <div class="small">O dinheiro cai direto nela — o Padelizou não segura nada no caminho.</div>
                    </div>
                </div>
            }

            @* ── Como funciona: a pergunta que todo organizador faz primeiro ──────────────
               "Como eu recebo?" tem duas respostas que importam: ONDE cai e QUANDO cai. As
               duas ficam aqui em cima, antes de qualquer campo pra preencher. *@
            <div class="card shadow-sm border-0 mb-3">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-3"><i class="bi bi-arrow-down-circle text-success"></i> Como o dinheiro chega até você</h6>
                    <p class="small text-muted">
                        O jogador paga dentro do app e o valor vai <strong>direto pra sua conta</strong>,
                        sem passar pelo caixa do Padelizou. A gente só retém a taxa combinada.
                    </p>

                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-2">
                            <thead>
                                <tr class="small text-muted">
                                    <th>Se o jogador pagar com</th>
                                    <th class="text-end">Você recebe em</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr><td>Pix</td><td class="text-end"><span class="badge bg-success">na hora</span></td></tr>
                                <tr><td>Cartão de débito</td><td class="text-end">3 dias</td></tr>
                                <tr><td>Cartão de crédito</td><td class="text-end"><span class="text-danger fw-semibold">32 dias</span></td></tr>
                            </tbody>
                        </table>
                    </div>

                    @* O valor NÃO muda com a forma — só o prazo. É contraintuitivo e vale dizer
                       com todas as letras: o repasse é por valor fixo, então o custo da forma
                       de pagamento sai do nosso lado, não do dele. *@
                    <div class="small" style="color: var(--padel-green);">
                        <i class="bi bi-check-circle-fill"></i>
                        <strong>O valor que você recebe é o mesmo em qualquer forma</strong> — muda só o prazo.
                    </div>
                </div>
            </div>

            @* ── Caminho novo: abrir a conta aqui dentro ──────────────────────────────────
               Antes o único jeito era sair do site, criar conta no gateway, achar um código
               chamado "Wallet ID" e voltar pra colar. Cinco passos, dois deles fora daqui —
               e cada um é um lugar onde o organizador desiste e volta pro "por fora". *@
            @if (podeAbrirConta)
            {
                <div class="card shadow-sm border-0 mb-3" style="border-top: 4px solid var(--pdz-lime) !important;">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-1"><i class="bi bi-magic text-success"></i> Criar minha conta agora</h5>
                        <p class="text-muted small">
                            Sem sair do Padelizou. A gente abre pra você e já deixa conectada.
                        </p>

                        @if (faltaNoPerfil != null)
                        {
                            <div class="alert alert-warning border-0 small mb-0">
                                <i class="bi bi-exclamation-triangle-fill"></i> @faltaNoPerfil
                                <a asp-controller="Auth" asp-action="EditarPerfil" class="alert-link">Editar meu perfil</a>
                            </div>
                        }
                        else
                        {
                            <form asp-controller="Pagamentos" asp-action="AbrirConta" method="post">
                                @Html.AntiForgeryToken()

                                <div class="small text-muted mb-3">
                                    Vamos usar o que já está no seu perfil: <strong>@Model.Nome</strong>,
                                    @Model.Email e seu CPF. Faltam só estes:
                                </div>

                                <div class="row g-2 mb-2">
                                    @* Obrigatória no meio de pagamento, e não está no nosso
                                       cadastro. Como o endereço, passa e não fica guardada. *@
                                    <div class="col-6 col-md-4">
                                        <label class="form-label small fw-semibold mb-1" for="dataNascimento">
                                            Data de nascimento
                                        </label>
                                        <input type="date" class="form-control" id="dataNascimento"
                                               name="dataNascimento" required>
                                    </div>
                                    <div class="col-6 col-md-4">
                                        <label class="form-label small fw-semibold mb-1" for="cep">CEP</label>
                                        <input type="text" class="form-control" id="cep" name="cep"
                                               inputmode="numeric" maxlength="9" placeholder="00000-000" required>
                                    </div>
                                    <div class="col-12 col-md-8">
                                        <label class="form-label small fw-semibold mb-1" for="endereco">Rua / Avenida</label>
                                        <input type="text" class="form-control" id="endereco" name="endereco" required>
                                    </div>
                                    <div class="col-6 col-md-4">
                                        <label class="form-label small fw-semibold mb-1" for="numero">Número</label>
                                        <input type="text" class="form-control" id="numero" name="numero"
                                               placeholder="S/N se não tiver" required>
                                    </div>
                                    <div class="col-6 col-md-8">
                                        <label class="form-label small fw-semibold mb-1" for="bairro">Bairro</label>
                                        <input type="text" class="form-control" id="bairro" name="bairro" required>
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label class="form-label small fw-semibold mb-1" for="faturamentoMensal">
                                            Quanto você fatura por mês, mais ou menos?
                                        </label>
                                        <input type="text" class="form-control" id="faturamentoMensal"
                                               name="faturamentoMensal" inputmode="decimal" placeholder="3.000,00" required>
                                        <div class="form-text">Pode ser estimativa. É exigência do cadastro.</div>
                                    </div>
                                </div>

                                @* Endereço não fica guardado aqui, e isso merece estar escrito na
                                   tela: é dado que a pessoa está entregando, ela tem o direito de
                                   saber pra onde vai. *@
                                <div class="small text-muted mb-3">
                                    <i class="bi bi-shield-check"></i>
                                    Estes dados vão direto para o meio de pagamento e
                                    <strong>não ficam guardados no Padelizou</strong>.
                                </div>

                                <button type="submit" class="btn btn-padel rounded-pill w-100">
                                    <i class="bi bi-check2-circle"></i> Criar minha conta de recebimento
                                </button>
                                <div class="form-text text-center mt-2">
                                    Depois você recebe um e-mail para ativar e enviar documentos.
                                </div>
                            </form>
                        }
                    </div>
                </div>

                <div class="text-center text-muted small mb-3">— ou, se você já tem conta —</div>
            }

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <form asp-controller="Pagamentos" asp-action="Configurar" method="post">
                        @Html.AntiForgeryToken()

                        @* A chave só aparece pra quem JÁ está conectado, que é quem precisa
                           dela — pra desligar. Pra quem está entrando, colar o código já é o
                           consentimento, e o switch em cima do formulário só criava um passo
                           a mais antes de poder digitar qualquer coisa. *@
                        @if (jaConectado)
                        {
                            <div class="form-check form-switch mb-3">
                                <input class="form-check-input" type="checkbox" role="switch"
                                       id="receberPagamentoOnline" name="receberPagamentoOnline" value="true"
                                       @(Model.ReceberPagamentoOnline ? "checked" : "")>
                                <input type="hidden" name="receberPagamentoOnline" value="false">
                                <label class="form-check-label fw-semibold" for="receberPagamentoOnline">
                                    Receber pelo app
                                </label>
                                <div class="text-muted small">
                                    Desligando, nada se perde: você volta a combinar por fora, como sempre fez.
                                </div>
                            </div>
                        }
                        else
                        {
                            @* Sem a chave visível, o valor precisa ir junto assim mesmo —
                               senão o binder receberia false e desligaria o recebimento de
                               quem acabou de colar o código. *@
                            <input type="hidden" name="receberPagamentoOnline" value="true">
                        }

                        <div id="camposRecebimento" class="@(jaConectado && !Model.ReceberPagamentoOnline ? "d-none" : "")">
                            @* Aqui NÃO se ensina a abrir conta: quem chega neste bloco já tem
                               uma. O bloco de cima é que abre. Ter os dois ensinando a criar
                               conta fazia a tela parecer repetida — e a repetição escondia
                               qual dos dois caminhos era o fácil. *@
                            <h6 class="fw-bold mb-1">Já tenho conta no Asaas</h6>
                            <p class="text-muted small mb-3">
                                Entre no Asaas, vá em <strong>Configurações › Integrações</strong> e copie o
                                <strong>"Wallet ID"</strong>. É um código comprido com traços, tipo
                                <code class="user-select-all">8a2c4b1e-9f33-4d0a-b7c1-5e6f7a8b9c0d</code>.
                                Ele só diz pra onde mandar o seu dinheiro — <strong>não dá acesso à sua conta</strong>.
                            </p>

                            <div class="mb-4">
                                <label for="asaasWalletId" class="form-label fw-semibold">
                                    Código da sua conta de recebimento
                                </label>
                                <input type="text" class="form-control font-monospace" id="asaasWalletId" name="asaasWalletId"
                                       value="@Model.AsaasWalletId" placeholder="8a2c4b1e-9f33-4d0a-b7c1-5e6f7a8b9c0d"
                                       autocomplete="off" spellcheck="false">
                                <div class="form-text">
                                    Confira antes de salvar: um caractere trocado e o dinheiro não encontra
                                    o caminho de volta pra você.
                                </div>
                            </div>

                            <div class="mb-2">
                                <label class="form-label fw-semibold">Quem paga a taxa do Padelizou?</label>
                                <div class="text-muted small mb-3">
                                    Ficamos com
                                    @string.Join(", ", comissoes.Select(c => $"{c.Value.ToString("0.##")}% em {c.Key.ToLower()}s"))
                                    — com mínimo de @minimaAula.ToString("C") em aulas e jogos.
                                </div>

                                @* Sem "aluno" nem "jogador" nos rótulos: nesta tela cai quem dá
                                   aula, quem organiza torneio e quem tem clube. Descrever o que
                                   ACONTECE com o preço serve pros três; dizer quem paga só serve
                                   pra um, e deixa os outros dois traduzindo. *@
                                <div class="form-check border rounded-3 p-3 mb-2">
                                    <input class="form-check-input ms-0 me-2" type="radio" name="modoComissao"
                                           id="modoSomada" value="Somada" @(modoAtual == "Somada" ? "checked" : "")>
                                    <label class="form-check-label" for="modoSomada">
                                        <strong>A taxa vai por cima do meu preço</strong>
                                        <div class="text-muted small mt-1">
                                            Você anuncia @exemploValor.ToString("C"), quem contrata paga
                                            <strong>@((exemploValor + exemploComissao).ToString("C"))</strong>
                                            e você recebe os @exemploValor.ToString("C") cheios.
                                        </div>
                                    </label>
                                </div>

                                <div class="form-check border rounded-3 p-3">
                                    <input class="form-check-input ms-0 me-2" type="radio" name="modoComissao"
                                           id="modoDescontada" value="Descontada" @(modoAtual == "Descontada" ? "checked" : "")>
                                    <label class="form-check-label" for="modoDescontada">
                                        <strong>A taxa sai de dentro do meu preço</strong>
                                        <div class="text-muted small mt-1">
                                            Você anuncia @exemploValor.ToString("C"), quem contrata paga
                                            @exemploValor.ToString("C") e você recebe
                                            <strong>@((exemploValor - exemploComissao).ToString("C"))</strong>.
                                        </div>
                                    </label>
                                </div>

                                @* Torneio não entra nesta escolha, e omitir isso fazia o organizador
                                   supor que dava pra somar a taxa por cima da inscrição. *@
                                <div class="form-text mt-2">
                                    <i class="bi bi-info-circle"></i>
                                    Vale para aulas e aluguel de quadra. <strong>Em torneios</strong> o jogador
                                    sempre paga exatamente o valor anunciado, e a taxa sai de dentro dele.
                                </div>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-padel btn-lg w-100 rounded-pill mt-4">Salvar</button>
                    </form>
                </div>
            </div>

            @* ── A terceira opção, que existe e não estava escrita ────────────────────────
               A tela oferecia dois jeitos de receber pelo app e nenhum de dizer "não quero".
               Quem chega aqui e não quer conta em gateway nenhum saía sem saber que já podia
               trabalhar do mesmo jeito. Vale pra QUEM RECEBE, não só pra professor: quem dá
               aula, quem organiza torneio e quem tem clube caem todos nesta tela. *@
            <div class="card border-0 mt-3" style="background-color: var(--pdz-surface-alt);">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-2"><i class="bi bi-hand-thumbs-up"></i> Não quer nada disso?</h6>
                    <p class="small mb-2">
                        Tudo bem — dá pra usar o Padelizou inteiro sem conectar conta nenhuma.
                        Você combina o pagamento direto com a pessoa, como sempre fez.
                    </p>
                    <ul class="small mb-2">
                        <li>
                            <strong>Aula e aluguel de quadra:</strong> marca por fora e o Padelizou
                            <strong>não cobra nada</strong> por isso. A agenda, os avisos e o histórico
                            continuam funcionando igual.
                        </li>
                        <li>
                            <strong>Torneio:</strong> existe a opção <strong>"Por fora"</strong> na criação —
                            @taxaExterno% sobre os inscritos, pago depois. As chaves saem quando essa taxa
                            estiver acertada.
                        </li>
                    </ul>
                    <p class="small text-muted mb-0">
                        Conectar a conta serve pra uma coisa só: o jogador pagar na hora de se inscrever,
                        em vez de você correr atrás de quem não pagou.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // A chave só existe pra quem já está conectado (é o botão de desligar). Sem ela na
        // tela, não há nada a alternar — e procurar o elemento sem conferir quebrava o script
        // inteiro pra quem está chegando agora.
        var chave = document.getElementById('receberPagamentoOnline');
        if (chave) {
            chave.addEventListener('change', function () {
                document.getElementById('camposRecebimento').classList.toggle('d-none', !this.checked);
            });
        }
    </script>
}
