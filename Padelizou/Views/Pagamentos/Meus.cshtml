@model Padelizou.ViewModels.ExtratoFinanceiroVM
@{
    ViewData["Title"] = "Financeiro - Padelizou";

    Func<string, string> corDoStatus = status => status switch
    {
        "Confirmado" => "success",
        "Pendente" => "warning text-dark",
        "AguardandoConfirmacao" => "info text-dark",
        "Estornado" or "Cancelado" => "danger",
        _ => "secondary"
    };

    // O nome interno do status do Pix direto não é frase — traduz só ele, os outros já são.
    Func<string, string> rotuloStatus = status => status == "AguardandoConfirmacao" ? "Conferindo" : status;

    Func<string, string> rotuloTipo = tipo => tipo switch
    {
        "Aula" => "Aula",
        "Jogo" => "Quadra",
        "AssinaturaProfessor" => "Mensalidade",
        "TaxaTorneio" => "Taxa do Padelizou",
        _ => "Torneio"
    };

    string UrlPeriodo(string p) => "/Pagamentos/Meus" + (p == "sempre" ? "" : "?periodo=" + p);
}

@if (TempData["Sucesso"] != null)
{
    <div class="container"><div class="alert alert-success">@TempData["Sucesso"]</div></div>
}
@if (TempData["Erro"] != null)
{
    <div class="container"><div class="alert alert-danger">@TempData["Erro"]</div></div>
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
        <div>
            <h2 class="fw-bold mb-1" style="color: var(--pdz-ink);">Financeiro</h2>
            <p class="text-muted mb-0">O que você recebeu pelos seus torneios, aulas e quadras.</p>
        </div>
        <a asp-controller="Pagamentos" asp-action="Configurar" class="btn btn-outline-secondary rounded-pill">
            <i class="bi bi-gear"></i> Configurar recebimento
        </a>
    </div>

    <!-- Período: recorta todos os números da tela -->
    <div class="d-flex align-items-center gap-2 mb-4 flex-wrap">
        <span class="text-muted small fw-semibold"><i class="bi bi-calendar3"></i> Período:</span>
        <div class="btn-group btn-group-sm" role="group">
            <a href="@UrlPeriodo("mes")" class="btn @(Model.Periodo == "mes" ? "btn-primary" : "btn-outline-secondary")">Este mês</a>
            <a href="@UrlPeriodo("ano")" class="btn @(Model.Periodo == "ano" ? "btn-primary" : "btn-outline-secondary")">Este ano</a>
            <a href="@UrlPeriodo("sempre")" class="btn @(Model.Periodo == "sempre" ? "btn-primary" : "btn-outline-secondary")">Sempre</a>
        </div>
    </div>

    <!-- Resumo do período -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small"><i class="bi bi-check-circle-fill text-success"></i> Recebido</div>
                    <div class="fs-4 fw-bold text-success">@Model.Recebido.ToString("C")</div>
                    <div class="small text-muted">@Model.QtdRecebimentos pagamento@(Model.QtdRecebimentos == 1 ? "" : "s") @Model.PeriodoRotulo</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small"><i class="bi bi-hourglass-split text-warning"></i> A receber</div>
                    <div class="fs-4 fw-bold text-warning">@Model.AReceber.ToString("C")</div>
                    <div class="small text-muted">@Model.Pendentes.Count aguardando pagamento</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small"><i class="bi bi-percent"></i> Taxa do Padelizou</div>
                    <div class="fs-4 fw-bold text-secondary">@Model.TaxaPaga.ToString("C")</div>
                    <div class="small text-muted">já descontada do recebido</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            @if (Model.EhAdmin)
            {
                <div class="card border-0 shadow-sm h-100" style="background: var(--pdz-ink); color: #fff;">
                    <div class="card-body">
                        <div class="small opacity-75"><i class="bi bi-shield-fill"></i> Comissão da plataforma</div>
                        <div class="fs-4 fw-bold">@Model.ComissaoPlataforma.ToString("C")</div>
                        <div class="small opacity-75">+ @Model.ComissaoPlataformaPendente.ToString("C") pendente</div>
                    </div>
                </div>
            }
            else
            {
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <div class="text-muted small"><i class="bi bi-arrow-counterclockwise text-danger"></i> Estornado</div>
                        <div class="fs-4 fw-bold @(Model.Estornado > 0 ? "text-danger" : "text-muted")">@Model.Estornado.ToString("C")</div>
                        <div class="small text-muted">devolvido a jogadores</div>
                    </div>
                </div>
            }
        </div>
    </div>

    @if (!Model.TemMovimento)
    {
        <div class="text-center py-5 rounded-3 bg-light" style="border: 2px dashed var(--pdz-border);">
            <i class="bi bi-cash-stack display-4 text-muted mb-3 d-block"></i>
            <h5 class="fw-bold text-secondary">Nada movimentado @Model.PeriodoRotulo</h5>
            <p class="text-muted mb-3">
                Para receber pelo app: ative em <strong>Configurar recebimento</strong> e coloque
                preço nos seus torneios, aulas ou horários de quadra.
            </p>
            <a asp-action="Configurar" class="btn btn-padel rounded-pill px-4">Configurar recebimento</a>
        </div>
    }
    else
    {
        <!-- Quem está devendo: o "a cobrar" do dia a dia -->
        @if (Model.Pendentes.Any())
        {
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-warning-subtle border-0">
                    <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-hourglass-split"></i> Aguardando pagamento (@Model.Pendentes.Count)</h6>
                </div>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr class="text-muted small">
                                <th>Quem</th>
                                <th>Origem</th>
                                <th class="text-end">Valor</th>
                                <th>Vence</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.Pendentes)
                            {
                                <tr>
                                    <td class="fw-semibold">@(p.Jogador?.Nome ?? "—")</td>
                                    <td class="small text-muted">@rotuloTipo(p.Tipo)</td>
                                    <td class="text-end fw-semibold">@p.ValorRepasse.ToString("C")</td>
                                    <td class="small text-muted">@(p.ExpiraEm?.ToString("dd/MM HH:mm") ?? "—")</td>
                                    <td class="text-end">
                                        @if (!string.IsNullOrEmpty(p.InvoiceUrl))
                                        {
                                            <a href="@p.InvoiceUrl" target="_blank" rel="noopener"
                                               class="btn btn-sm btn-outline-primary rounded-pill px-3">Link de pagamento</a>
                                        }
                                        <form asp-action="Estornar" asp-route-id="@p.Id" method="post" class="d-inline"
                                              onsubmit="return confirm('Cancelar esta cobrança?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">Cancelar</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <!-- De onde veio o dinheiro -->
        @if (Model.PorOrigem.Any())
        {
            <h5 class="fw-bold mb-3">De onde veio</h5>
            <div class="row g-3 mb-4">
                @foreach (var o in Model.PorOrigem)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start gap-2">
                                    <div>
                                        <div class="fw-bold" style="color: var(--pdz-ink);">
                                            <i class="bi @o.Icone text-secondary"></i> @o.Nome
                                        </div>
                                        <div class="small text-muted">@o.Qtd pagamento@(o.Qtd == 1 ? "" : "s")</div>
                                    </div>
                                    <div class="text-end">
                                        <div class="fw-bold text-success">@o.Recebido.ToString("C")</div>
                                        @if (o.Pendente > 0)
                                        {
                                            <div class="small text-warning">+ @o.Pendente.ToString("C") a receber</div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        <!-- Extrato detalhado -->
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h5 class="fw-bold mb-0">Extrato</h5>
            <a asp-action="ExportarCsv" asp-route-periodo="@Model.Periodo"
               class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                <i class="bi bi-filetype-csv"></i> Exportar CSV
            </a>
        </div>
        <div class="table-responsive mb-5">
            <table class="table align-middle">
                <thead>
                    <tr class="text-muted small">
                        <th>Quando</th>
                        <th>Quem pagou</th>
                        <th>Tipo</th>
                        <th class="text-end">Você recebe</th>
                        <th class="text-end">Taxa</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Movimentos)
                    {
                        <tr>
                            <td class="small">@((p.ConfirmadoEm ?? p.CriadoEm).ToString("dd/MM/yy HH:mm"))</td>
                            <td>@(p.Jogador?.Nome ?? "-")</td>
                            <td class="small">@rotuloTipo(p.Tipo)</td>
                            <td class="text-end fw-semibold">@p.ValorRepasse.ToString("C")</td>
                            <td class="text-end small text-muted">@p.Comissao.ToString("C")</td>
                            <td><span class="badge bg-@corDoStatus(p.Status)">@p.Status</span></td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Comprovante" asp-route-id="@p.Id"
                                   class="btn btn-sm btn-outline-secondary rounded-pill px-2" title="Comprovante">
                                    <i class="bi bi-receipt"></i>
                                </a>
                                @if (p.Status == "Confirmado")
                                {
                                    @* Campo em branco devolve TUDO (e desfaz a inscrição); com valor,
                                       devolve só aquela parte e a inscrição continua de pé. *@
                                    <form asp-action="Estornar" asp-route-id="@p.Id" method="post"
                                          class="d-inline-flex align-items-center gap-1"
                                          data-quem="@(p.Jogador?.Nome ?? "o jogador")"
                                          data-total="@p.Valor.ToString("C")"
                                          onsubmit="return confirmarDevolucao(this);">
                                        @Html.AntiForgeryToken()
                                        <input type="text" name="valor" inputmode="decimal" placeholder="Tudo"
                                               class="form-control form-control-sm text-end" style="width: 5.5rem;"
                                               aria-label="Quanto devolver — em branco devolve tudo">
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                            Estornar
                                        </button>
                                    </form>
                                }
                                else if (p.Status == "Pendente")
                                {
                                    <form asp-action="Estornar" asp-route-id="@p.Id" method="post" class="d-inline"
                                          onsubmit="return confirm('Cancelar esta cobrança?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                            Cancelar
                                        </button>
                                    </form>
                                }
                                @if (p.ValorEstornado > 0)
                                {
                                    <div class="small text-muted mt-1">
                                        @p.ValorEstornado.ToString("C") devolvidos
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (Model.MinhasCompras.Any())
    {
        <h5 class="fw-bold mb-3">O que eu paguei</h5>
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr class="text-muted small">
                        <th>Quando</th>
                        <th>Tipo</th>
                        <th class="text-end">Valor</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.MinhasCompras)
                    {
                        <tr>
                            <td class="small">@((p.ConfirmadoEm ?? p.CriadoEm).ToString("dd/MM/yy HH:mm"))</td>
                            <td class="small">@rotuloTipo(p.Tipo)</td>
                            <td class="text-end fw-semibold">@p.Valor.ToString("C")</td>
                            <td><span class="badge bg-@corDoStatus(p.Status)">@rotuloStatus(p.Status)</span></td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Comprovante" asp-route-id="@p.Id"
                                   class="btn btn-sm btn-outline-secondary rounded-pill px-2" title="Comprovante">
                                    <i class="bi bi-receipt"></i>
                                </a>
                                @if (p.Status == "Pendente" && !string.IsNullOrEmpty(p.InvoiceUrl))
                                {
                                    <a href="@p.InvoiceUrl" target="_blank" rel="noopener"
                                       class="btn btn-sm btn-padel rounded-pill px-3">Pagar</a>
                                }
                                else if (p.MetodoPagamento == Padelizou.Services.PixDireto.Metodo
                                    && (p.Status == "Pendente" || p.Status == "AguardandoConfirmacao"))
                                {
                                    @* Pix direto não tem fatura de gateway — o caminho de volta é a nossa tela do QR. *@
                                    <a asp-action="Pix" asp-route-id="@p.Id"
                                       class="btn btn-sm btn-padel rounded-pill px-3">Pagar</a>
                                }
                                @* Quem cobrou a mais foi o Padelizou, então quem devolve é o Padelizou.
                                   O organizador segue devolvendo o que ELE recebeu, lá no extrato. *@
                                @if (Model.EhAdmin && p.Status == "Confirmado"
                                    && p.MetodoPagamento != Padelizou.Services.PixDireto.Metodo)
                                {
                                    <form asp-action="Estornar" asp-route-id="@p.Id" method="post"
                                          class="d-inline-flex align-items-center gap-1 ms-1"
                                          data-quem="você"
                                          data-total="@p.Valor.ToString("C")"
                                          onsubmit="return confirmarDevolucao(this);">
                                        @Html.AntiForgeryToken()
                                        <input type="text" name="valor" inputmode="decimal" placeholder="Tudo"
                                               class="form-control form-control-sm text-end" style="width: 5.5rem;"
                                               aria-label="Quanto devolver — em branco devolve tudo">
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                            Devolver
                                        </button>
                                    </form>
                                }
                                @if (p.ValorEstornado > 0)
                                {
                                    <div class="small text-muted mt-1">
                                        @p.ValorEstornado.ToString("C") devolvidos
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<script>
    // Devolver TUDO e devolver UMA PARTE têm consequências diferentes — tudo desfaz a
    // inscrição, parte não —, então o aviso precisa dizer qual dos dois vai acontecer.
    // O nome de quem recebe vem por data-attribute pra apóstrofo no nome não quebrar o script.
    function confirmarDevolucao(form) {
        var campo = form.querySelector('input[name="valor"]');
        var digitado = (campo && campo.value || '').trim();
        var quem = form.dataset.quem;

        if (!digitado) {
            return confirm('Devolver TUDO (' + form.dataset.total + ') para ' + quem
                + '?\n\nA inscrição também é desfeita.');
        }

        return confirm('Devolver R$ ' + digitado + ' para ' + quem
            + '?\n\nA inscrição continua de pé, valendo o que sobrar. O organizador devolve a '
            + 'parte dele junto.');
    }
</script>
