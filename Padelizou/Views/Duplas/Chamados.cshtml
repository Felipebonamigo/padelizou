@model List<Padelizou.Models.ChamadoDoMural>
@using Padelizou.ViewModels
@{
    ViewData["Title"] = "Quem quer jogar com você - Padelizou";
    var dupla = (Padelizou.Models.Dupla)ViewBag.Dupla;
    var torneio = (Padelizou.Models.Torneio)ViewBag.Torneio;
    string? motivoParaNaoAceitar = ViewBag.MotivoParaNaoAceitar as string;
    // Quem destes está inscrito SOZINHO nesta mesma categoria: aceitar junta as duas
    // inscrições (a dele sai, a vaga é a mesma). Precisa estar dito antes do clique.
    var comInscricaoSolo = ViewBag.CandidatosComInscricaoSolo as HashSet<int> ?? new HashSet<int>();
    // E quem destes JÁ FECHOU dupla nesta categoria: aceitar seria inscrevê-lo duas vezes, e o
    // servidor recusa. Melhor dizer aqui do que deixar o dono descobrir apertando o botão —
    // cobre os chamados que já estavam de pé e quem chamou e fechou dupla depois.
    var jaFecharam = ViewBag.CandidatosQueJaFecharam as Dictionary<int, string> ?? new Dictionary<int, string>();
}

<div class="container mt-4 mb-5" style="max-width: 34rem;">
    @if (TempData["Erro"] != null)
    {
        <div class="alert alert-danger">@TempData["Erro"]</div>
    }
    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success">@TempData["Sucesso"]</div>
    }

    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h4 class="fw-bold mb-1" style="color: var(--pdz-ink);">
                <i class="bi bi-people-fill"></i> Quem quer jogar com você
            </h4>
            <p class="text-muted small mb-0">@torneio.Nome · @dupla.Categoria.Nome</p>
        </div>
        <a asp-controller="Torneios" asp-action="Details" asp-route-id="@torneio.Id"
           class="btn btn-outline-secondary rounded-pill">Voltar ao torneio</a>
    </div>

    @* Por que não dá pra aceitar, quando não dá. Aparece NO LUGAR dos botões, não junto:
       oferecer um "Aceitar" que o servidor vai recusar é desleixo que o usuário paga. *@
    @if (motivoParaNaoAceitar != null)
    {
        <div class="alert alert-warning">
            @motivoParaNaoAceitar
            @if (dupla.Jogador2Id != null)
            {
                <text> Seu parceiro é <strong>@(dupla.Jogador2?.ComoChamar ?? "outro jogador")</strong>.</text>
            }
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="card shadow-sm border-0">
            <div class="card-body text-center p-4">
                <i class="bi bi-inbox fs-1 text-muted"></i>
                <p class="mb-1 mt-2"><strong>Ninguém chamou ainda.</strong></p>
                <p class="text-muted small mb-0">
                    Sua inscrição aparece na lista do torneio como "procurando parceiro" —
                    quem se interessar chama por lá, e o pedido cai aqui.
                </p>
            </div>
        </div>
    }
    else
    {
        <p class="text-muted small">
            @Model.Count pessoa(s) chamaram. Aceitar fecha a dupla na hora — os outros pedidos somem junto.
        </p>

        foreach (var chamado in Model)
        {
            <div class="card shadow-sm border-0 mb-2">
                <div class="card-body d-flex align-items-center gap-3 flex-wrap">
                    <partial name="_FotoDoJogador" model='FotoDoJogadorVM.De(chamado.Candidato, 56)' />

                    <div class="flex-grow-1" style="min-width: 10rem;">
                        <a asp-controller="Jogadores" asp-action="Perfil" asp-route-id="@chamado.CandidatoId"
                           class="fw-bold text-decoration-none" style="color: var(--pdz-ink);">
                            @chamado.Candidato.ComoChamar
                        </a>
                        <div class="small text-muted">
                            @* O perfil é o que dá lastro pra decisão — nível, histórico, elogios.
                               Fica como link no nome E como texto aqui: numa lista de nomes que a
                               pessoa não conhece, "ver o perfil" precisa estar dito. *@
                            <a asp-controller="Jogadores" asp-action="Perfil" asp-route-id="@chamado.CandidatoId">
                                ver o perfil
                            </a>
                            · chamou @Padelizou.Services.TempoRelativo.Curto(chamado.CriadoEm)
                        </div>

                        @* ⚠️ ELE TAMBÉM ESTÁ INSCRITO SOZINHO AQUI — o caso comum do mural:
                           os dois estão na mesma lista de "procurando parceiro", e foi por
                           isso que um chamou o outro. Aceitar junta as duas inscrições, e
                           dizer isso ANTES do clique é o que faz o efeito não ser surpresa.
                           (Até 19/08/2026 o servidor RECUSAVA esse aceite pedindo pra marcar
                           uma caixa que só existe na tela de inscrição — nada era aceitável
                           por aqui.) *@
                        @if (comInscricaoSolo.Contains(chamado.CandidatoId))
                        {
                            <div class="small mt-1" style="color: var(--pdz-ink);">
                                <i class="bi bi-arrow-left-right"></i>
                                Ele(a) também está inscrito(a) sozinho(a) nesta categoria —
                                aceitar junta as duas inscrições numa só. A vaga é a mesma,
                                ninguém perde lugar.
                            </div>
                        }
                    </div>

                    @* ⚠️ ACEITAR E RECUSAR FORAM DESMEMBRADOS (21/08/2026). Os dois viviam sob o
                       mesmo `@if`: quando o Aceitar não podia aparecer, o Recusar sumia junto — e
                       o dono ficava sem como limpar uma linha morta da própria lista. Recusar
                       agora aparece sempre. *@
                    <div class="d-flex gap-2">
                        @if (jaFecharam.TryGetValue(chamado.CandidatoId, out var parceiroDele))
                        {
                            <div class="alert alert-warning py-2 px-3 small mb-0 flex-grow-1">
                                <i class="bi bi-exclamation-triangle"></i>
                                Ele(a) já fechou dupla nesta categoria com <strong>@parceiroDele</strong> —
                                não dá pra aceitar. Você pode recusar pra tirar da lista.
                            </div>
                        }
                        else if (motivoParaNaoAceitar == null)
                        {
                            @* Confirmação no Aceitar porque ele FECHA a dupla e derruba os
                               outros pedidos — é a ação irreversível desta tela. Recusar só
                               apaga uma linha da própria lista. *@
                            <form asp-action="AceitarChamado" method="post"
                                  data-confirmar="A dupla fecha com @chamado.Candidato.ComoChamar e os outros pedidos somem. Ele(a) é avisado.@(comInscricaoSolo.Contains(chamado.CandidatoId) ? " A inscrição sozinha dele(a) nesta categoria sai e vira esta — a vaga é a mesma." : "")"
                                  data-confirmar-titulo="Fechar dupla?"
                                  data-confirmar-ok="Fechar dupla">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="duplaId" value="@dupla.Id" />
                                <input type="hidden" name="candidatoId" value="@chamado.CandidatoId" />
                                <button type="submit" class="btn btn-padel rounded-pill px-3 fw-bold">
                                    <i class="bi bi-check-lg"></i> Aceitar
                                </button>
                            </form>
                        }

                        <form asp-action="RecusarChamado" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="duplaId" value="@dupla.Id" />
                            <input type="hidden" name="candidatoId" value="@chamado.CandidatoId" />
                            @* O título diz a verdade sobre o efeito: quem recusa precisa
                               saber que a outra pessoa recebe um aviso — decidir sem saber
                               disso é decidir no escuro. *@
                            <button type="submit" class="btn btn-outline-secondary rounded-pill px-3"
                                    title="Recusar (ele(a) recebe um aviso de que não deu)">
                                Recusar
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }

        @if (motivoParaNaoAceitar == null)
        {
            @* ⚠️ Este texto dizia "recusar é silencioso: quem chamou não recebe aviso nenhum"
               — e é o contrário do que o servidor faz desde 17/08/2026 (RecusarChamado manda
               "Não deu dessa vez"). Tela que descreve errado o efeito do próprio botão faz a
               pessoa recusar achando que ninguém fica sabendo. *@
            <p class="text-muted small mt-3 mb-0">
                Recusar avisa quem chamou (<em>"não deu dessa vez"</em>) — sem isso a pessoa
                fica esperando resposta e perde tempo de procurar outro parceiro.
            </p>
        }
    }
</div>
