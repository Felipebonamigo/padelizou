@{
    ViewData["Title"] = "Acesso Antecipado - Padelizou";
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Acesso Antecipado - Padelizou</title>
    <link rel="icon" type="image/png" sizes="32x32" href="~/image/favicon-32.png" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>
    @* Ambiente de TESTE: o aviso vem ANTES do formulário, ocupando a tela, porque a hora de
       perceber que se errou de endereço é antes de entrar — depois do portão as duas
       instalações são visualmente idênticas. O erro que ele evita é caro: inscrever gente de
       verdade, cobrar de verdade e marcar torneio de verdade num banco que é apagado sem
       aviso. Ligado por `Beta__AmbienteDeTeste=true` no systemd do dev. *@
    @if (ViewBag.AmbienteDeTeste == true)
    {
        <div class="pdz-aviso-dev">
            <div class="pdz-aviso-dev-caixa">
                <div class="pdz-aviso-dev-titulo">
                    <i class="bi bi-cone-striped"></i> AMBIENTE DE DESENVOLVIMENTO
                </div>
                <p class="pdz-aviso-dev-texto mb-2">
                    <strong>Este NÃO é o Padelizou oficial.</strong>
                </p>
                <p class="pdz-aviso-dev-texto mb-0">
                    É a cópia usada para testar coisas novas. Tudo aqui — conta, torneio,
                    inscrição, pagamento — é <strong>de mentira</strong> e pode ser apagado a
                    qualquer momento, sem aviso.
                </p>
                <a href="https://padelizou.com.br" class="pdz-aviso-dev-link">
                    Ir para o Padelizou oficial <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    }

    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-5">
                <div class="card shadow-sm border-0" style="border-top: 4px solid var(--padel-green);">
                    <div class="card-body p-4 p-md-5">
                        <div class="text-center mb-4">
                            <img src="~/image/logo-icon.webp" asp-append-version="true" alt="Padelizou" style="height: 60px;" />
                            <h3 class="mt-3 fw-bold" style="color: var(--pdz-ink);">Acesso Antecipado</h3>
                            <p class="text-muted mb-0">O Padelizou ainda está em teste fechado. Peça o usuário e senha pra quem te convidou.</p>
                        </div>

                        @* Quem JÁ TEM CONTA entra direto com o login dele — e precisa ver isso
                           ANTES do formulário, senão lê "peça a senha pra quem te convidou",
                           não tem a quem pedir e desiste na porta da própria conta. *@
                        <div class="alert alert-success d-flex align-items-center gap-2 py-2 small">
                            <i class="bi bi-person-check-fill fs-5"></i>
                            <div>
                                <strong>Já tem conta no Padelizou?</strong><br />
                                <a asp-controller="Auth" asp-action="Login" asp-route-returnUrl="@ViewBag.ReturnUrl" class="fw-bold">
                                    Entrar com meu login <i class="bi bi-arrow-right"></i>
                                </a>
                            </div>
                        </div>

                        @if (ViewBag.Erro != null)
                        {
                            <div class="alert alert-danger">@ViewBag.Erro</div>
                        }

                        <form asp-controller="AcessoAntecipado" asp-action="Entrar" method="post">
                            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                            <div class="mb-3">
                                <label class="form-label fw-bold text-muted small">Usuário</label>
                                <input type="text" name="usuario" class="form-control bg-light" required autofocus />
                            </div>
                            <div class="mb-4">
                                <label class="form-label fw-bold text-muted small">Senha</label>
                                <div class="input-group">
                                    <input type="password" name="senha" class="form-control bg-light" required />
                                    <button type="button" class="btn btn-outline-secondary" onclick="pdzAlternarSenha(this)" tabindex="-1" aria-label="Mostrar senha">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </div>
                            </div>
                            <button type="submit" class="btn btn-padel btn-lg w-100 rounded-pill">Entrar</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
