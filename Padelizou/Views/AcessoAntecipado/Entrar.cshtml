@{
    ViewData["Title"] = "Acesso Antecipado - Padelizou";
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Acesso Antecipado - Padelizou</title>
    <link rel="icon" type="image/png" sizes="32x32" href="~/image/favicon-32.png" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>
    @* Ambiente de TESTE (Beta__AmbienteDeTeste=true no systemd do dev): a tela é OUTRA — toda
       preta, sem a cara do site, decisão do Felipe na véspera do lançamento. O portão do dev
       não é convite ("peça a senha a quem te convidou"); é parede: quem chegou aqui errou de
       endereço, e a tela inteira existe pra dizer isso antes de qualquer formulário. As
       credenciais são exclusivas do dev e moram só no systemd dele — não há o atalho "entrar
       com meu login", porque no dev não existe conta de usuário de verdade a proteger. *@
    @if (ViewBag.AmbienteDeTeste == true)
    {
        <div style="position:fixed; inset:0; background:#000; color:#fff; overflow:auto;
                    display:flex; align-items:center; justify-content:center; padding:24px;
                    font-family:'Segoe UI',system-ui,sans-serif;">
            <div style="max-width:560px; width:100%; text-align:center;">
                <p style="font-size:1.35rem; font-weight:800; letter-spacing:.04em; line-height:1.6; margin:0 0 8px;">
                    VOCÊ ESTÁ NO AMBIENTE DE DESENVOLVIMENTO.
                </p>
                <p style="font-size:1.05rem; font-weight:600; letter-spacing:.03em; line-height:1.6; color:#bbb; margin:0 0 22px;">
                    ESTA ÁREA É DEDICADA AO DESENVOLVIMENTO.<br />
                    ABRA <a href="https://padelizou.com.br" style="color:#a3d827; text-decoration:underline;">PADELIZOU.COM.BR</a>
                    PARA ENTRAR NO SISTEMA.
                </p>

                @if (ViewBag.Erro != null)
                {
                    <p style="color:#ff6b5e; font-weight:700; margin:0 0 14px;">@ViewBag.Erro</p>
                }

                <form asp-controller="AcessoAntecipado" asp-action="Entrar" method="post"
                      style="max-width:320px; margin:0 auto; text-align:left;">
                    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                    <label style="display:block; font-size:.75rem; font-weight:700; letter-spacing:.08em; color:#888; margin:0 0 4px;">LOGIN</label>
                    <input type="text" name="usuario" required autofocus autocomplete="username"
                           style="width:100%; background:#111; border:1px solid #333; color:#fff; padding:10px 12px; border-radius:6px; margin-bottom:14px;" />
                    <label style="display:block; font-size:.75rem; font-weight:700; letter-spacing:.08em; color:#888; margin:0 0 4px;">SENHA</label>
                    <input type="password" name="senha" required autocomplete="current-password"
                           style="width:100%; background:#111; border:1px solid #333; color:#fff; padding:10px 12px; border-radius:6px; margin-bottom:20px;" />
                    <button type="submit"
                            style="width:100%; background:#a3d827; color:#000; font-weight:800; letter-spacing:.05em; border:0; padding:12px; border-radius:6px; cursor:pointer;">
                        ENTRAR NO DEV
                    </button>
                </form>
            </div>
        </div>
    }
    else
    {
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-5">
                <div class="card shadow-sm border-0" style="border-top: 4px solid var(--padel-green);">
                    <div class="card-body p-4 p-md-5">
                        <div class="text-center mb-4">
                            <img src="~/image/logo-icon.webp" asp-append-version="true" alt="Padelizou" style="height: 60px;" />
                            <h3 class="mt-3 fw-bold" style="color: var(--pdz-ink);">Acesso Antecipado</h3>
                            <p class="text-muted mb-0">O Padelizou ainda está em teste fechado. Peça o usuário e senha pra quem te convidou.</p>
                        </div>

                        @* Quem JÁ TEM CONTA entra direto com o login dele — e precisa ver isso
                           ANTES do formulário, senão lê "peça a senha pra quem te convidou",
                           não tem a quem pedir e desiste na porta da própria conta. *@
                        <div class="alert alert-success d-flex align-items-center gap-2 py-2 small">
                            <i class="bi bi-person-check-fill fs-5"></i>
                            <div>
                                <strong>Já tem conta no Padelizou?</strong><br />
                                <a asp-controller="Auth" asp-action="Login" asp-route-returnUrl="@ViewBag.ReturnUrl" class="fw-bold">
                                    Entrar com meu login <i class="bi bi-arrow-right"></i>
                                </a>
                            </div>
                        </div>

                        @if (ViewBag.Erro != null)
                        {
                            <div class="alert alert-danger">@ViewBag.Erro</div>
                        }

                        <form asp-controller="AcessoAntecipado" asp-action="Entrar" method="post">
                            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                            <div class="mb-3">
                                <label class="form-label fw-bold text-muted small">Usuário</label>
                                <input type="text" name="usuario" class="form-control bg-light" required autofocus />
                            </div>
                            <div class="mb-4">
                                <label class="form-label fw-bold text-muted small">Senha</label>
                                <div class="input-group">
                                    <input type="password" name="senha" class="form-control bg-light" required />
                                    <button type="button" class="btn btn-outline-secondary" onclick="pdzAlternarSenha(this)" tabindex="-1" aria-label="Mostrar senha">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </div>
                            </div>
                            <button type="submit" class="btn btn-padel btn-lg w-100 rounded-pill">Entrar</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
    }
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
