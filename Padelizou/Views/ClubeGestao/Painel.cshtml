@model Padelizou.ViewModels.PainelClubeVM
@using System.Globalization
@inject Padelizou.Services.PortaDoMarcarJogo PortaMarcarJogo
@{
    ViewData["Title"] = Model.Clube.Nome + " — Painel do Clube";
    var ptBr = CultureInfo.GetCultureInfo("pt-BR");
    string[] diasCurtos = { "dom", "seg", "ter", "qua", "qui", "sex", "sáb" };
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-0" style="color: var(--pdz-ink);">
                <i class="bi bi-shop"></i> @Model.Clube.Nome
            </h2>
            <p class="text-muted mb-0">Painel do clube — agenda, quadras e financeiro num lugar.</p>
        </div>
        @* Enquanto o Marcar Jogo está escondido não existe "como o jogador vê": a tela do
           jogador responde 404 pra ele (Services/PortaDoMarcarJogo). *@
        @if (await PortaMarcarJogo.PodeUsarAsync(User))
        {
            <a asp-controller="MarcarJogo" asp-action="Clube" asp-route-clubeId="@Model.Clube.Id"
               class="btn btn-outline-secondary rounded-pill">
                <i class="bi bi-eye"></i> Ver como o jogador vê
            </a>
        }
    </div>

    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success">@TempData["Sucesso"]</div>
    }
    @if (TempData["Erro"] != null)
    {
        <div class="alert alert-warning">@TempData["Erro"]</div>
    }

    @* Sem quadra ou sem horário publicado o clube não aparece pra ninguém marcar — a mesma
       armadilha da escada do professor. O painel diz isso na entrada, com o caminho. *@
    @if (Model.PrecisaDeQuadra)
    {
        <div class="alert alert-warning border-0 shadow-sm d-flex gap-2 align-items-start">
            <i class="bi bi-exclamation-triangle-fill mt-1"></i>
            <div>
                <strong>Nenhuma quadra cadastrada.</strong> Enquanto não houver, ninguém consegue
                marcar jogo no seu clube.
                <a asp-controller="HorarioMarcacao" asp-action="Index" asp-route-clubeId="@Model.Clube.Id"
                   class="fw-bold">Cadastrar quadra →</a>
            </div>
        </div>
    }
    else if (Model.PrecisaDeHorario)
    {
        <div class="alert alert-warning border-0 shadow-sm d-flex gap-2 align-items-start">
            <i class="bi bi-exclamation-triangle-fill mt-1"></i>
            <div>
                <strong>Nenhum horário publicado.</strong> A quadra existe, mas sem horário o
                jogador abre a sua página e não encontra nada pra marcar.
                <a asp-controller="HorarioMarcacao" asp-action="Index" asp-route-clubeId="@Model.Clube.Id"
                   class="fw-bold">Publicar horários →</a>
            </div>
        </div>
    }
    else if (!Model.Clube.MarcacaoHorariosAtiva)
    {
        <div class="alert alert-secondary border-0 shadow-sm d-flex gap-2 align-items-start">
            <i class="bi bi-pause-circle-fill mt-1"></i>
            <div>
                <strong>Marcação desligada.</strong> Seus horários existem, mas o clube não aparece
                na tela de Marcar Jogo. É assim que se pausa sem apagar nada.
            </div>
        </div>
    }

    <!-- NÚMEROS -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100 text-center p-3">
                <div class="fw-bold fs-3" style="color: var(--pdz-ink);">@Model.ReservasHoje</div>
                <small class="text-muted">reserva(s) hoje</small>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100 text-center p-3">
                <div class="fw-bold fs-3" style="color: var(--pdz-ink);">@Model.ReservasNaSemana</div>
                <small class="text-muted">nesta semana</small>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100 text-center p-3">
                <div class="fw-bold fs-3" style="color: var(--padel-green);">@Model.PercentualOcupacaoSemana%</div>
                <small class="text-muted">ocupação da semana</small>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100 text-center p-3">
                <div class="fw-bold fs-3" style="color: var(--pdz-ink);">@Model.ReceitaDoMes.ToString("C0", ptBr)</div>
                <small class="text-muted">no mês</small>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- O DIA DE HOJE, EM ORDEM DE HORA -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-body">
                    <h6 class="fw-bold mb-3" style="color: var(--pdz-ink);">
                        <i class="bi bi-sun"></i> Hoje · @DateTime.Today.ToString("dddd, dd/MM", ptBr)
                    </h6>

                    @if (!Model.Hoje.Any())
                    {
                        <p class="small text-muted mb-0">Nenhum horário publicado pra hoje. O dia de amanhã em diante fica logo abaixo.</p>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var r in Model.Hoje)
                            {
                                @if (r.Livre)
                                {
                                    @* O livre É clicável: o balcão mora aqui. Sem isso o dono
                                       precisa navegar até o mapa pra registrar quem ligou. *@
                                    <button type="button"
                                            class="list-group-item list-group-item-action px-0 d-flex gap-3 align-items-center pdz-btn-horario"
                                            data-quadra="@r.QuadraId" data-quadra-nome="@r.Quadra"
                                            data-quando="@r.DataHora.ToString("yyyy-MM-ddTHH:mm")">
                                        <div class="text-center flex-shrink-0" style="width: 54px;">
                                            <div class="fw-bold text-muted">@r.DataHora.ToString("HH:mm")</div>
                                        </div>
                                        <div class="flex-grow-1 text-start text-muted">
                                            Livre · @r.Quadra
                                            @if (r.Valor > 0)
                                            {
                                                <span>· @r.Valor!.Value.ToString("C0", ptBr)</span>
                                            }
                                        </div>
                                        <span class="small text-success flex-shrink-0"><i class="bi bi-plus-circle"></i> marcar</span>
                                    </button>
                                }
                                else
                                {
                                    <div class="list-group-item px-0 d-flex gap-3 align-items-center">
                                        <div class="text-center flex-shrink-0" style="width: 54px;">
                                            <div class="fw-bold" style="color: var(--pdz-ink);">@r.DataHora.ToString("HH:mm")</div>
                                        </div>
                                        <div class="flex-grow-1 overflow-hidden">
                                            @if (r.EhBloqueio)
                                            {
                                                <span class="fw-semibold text-muted">
                                                    <i class="bi bi-lock-fill"></i> @(r.MotivoBloqueio ?? "Bloqueado")
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="fw-semibold d-block text-truncate" style="color: var(--pdz-ink);">
                                                    @r.Jogador
                                                    @if (r.EhMensalista)
                                                    {
                                                        <span class="badge rounded-pill ms-1" style="background: rgba(13,202,240,.18); color:#0aa2c0;">mensalista</span>
                                                    }
                                                    @if (r.Selo == "pago")
                                                    {
                                                        <span class="badge rounded-pill ms-1" style="background: rgba(25,135,84,.15); color: var(--padel-green);">pago</span>
                                                    }
                                                    else if (r.Selo == "paga lá")
                                                    {
                                                        <span class="badge rounded-pill ms-1 bg-warning text-dark">paga lá</span>
                                                    }
                                                </span>
                                            }
                                            <small class="text-muted">
                                                <i class="bi bi-geo-alt"></i> @r.Quadra
                                                @if (r.Valor > 0)
                                                {
                                                    <span>· @r.Valor!.Value.ToString("C", ptBr)</span>
                                                }
                                            </small>
                                        </div>
                                        @if (r.Selo == "paga lá")
                                        {
                                            <form asp-action="ReceberPagamento" method="post" class="flex-shrink-0">
                                                <input type="hidden" name="marcacaoId" value="@r.MarcacaoId" />
                                                <button type="submit" class="btn btn-sm btn-outline-warning rounded-pill"
                                                        title="Marcar como recebido">recebi</button>
                                            </form>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(r.Celular))
                                        {
                                            <a href="https://wa.me/55@(new string(r.Celular.Where(char.IsDigit).ToArray()))"
                                               target="_blank" rel="noopener"
                                               class="btn btn-sm btn-outline-success rounded-pill flex-shrink-0"
                                               title="Falar com @r.Jogador no WhatsApp">
                                                <i class="bi bi-whatsapp"></i>
                                            </a>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- PRÓXIMOS DIAS -->
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h6 class="fw-bold mb-3" style="color: var(--pdz-ink);">
                        <i class="bi bi-calendar-check"></i> Próximos dias
                    </h6>

                    @if (!Model.Proximas.Any())
                    {
                        <p class="small text-muted mb-0">Nenhuma reserva de amanhã em diante ainda.</p>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var r in Model.Proximas)
                            {
                                <div class="list-group-item px-0 d-flex gap-3 align-items-center">
                                    <div class="text-center flex-shrink-0" style="width: 54px;">
                                        <div class="fw-bold" style="color: var(--pdz-ink);">@r.DataHora.ToString("HH:mm")</div>
                                        <small class="text-muted" style="font-size:.72rem;">
                                            @diasCurtos[(int)r.DataHora.DayOfWeek] @r.DataHora.ToString("dd/MM")
                                        </small>
                                    </div>
                                    <div class="flex-grow-1 overflow-hidden">
                                        @if (r.EhBloqueio)
                                        {
                                            <span class="fw-semibold text-muted">
                                                <i class="bi bi-lock-fill"></i> @(r.MotivoBloqueio ?? "Bloqueado")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="fw-semibold d-block text-truncate" style="color: var(--pdz-ink);">
                                                @r.Jogador
                                                @if (r.EhMensalista)
                                                {
                                                    <span class="badge rounded-pill ms-1" style="background: rgba(13,202,240,.18); color:#0aa2c0;">mensalista</span>
                                                }
                                                @if (r.Selo == "paga lá")
                                                {
                                                    <span class="badge rounded-pill ms-1 bg-warning text-dark">paga lá</span>
                                                }
                                            </span>
                                        }
                                        <small class="text-muted">
                                            <i class="bi bi-geo-alt"></i> @r.Quadra
                                            @if (r.Valor > 0)
                                            {
                                                <span>· @r.Valor!.Value.ToString("C", ptBr)</span>
                                            }
                                        </small>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(r.Celular))
                                    {
                                        <a href="https://wa.me/55@(new string(r.Celular.Where(char.IsDigit).ToArray()))"
                                           target="_blank" rel="noopener"
                                           class="btn btn-sm btn-outline-success rounded-pill flex-shrink-0"
                                           title="Falar com @r.Jogador no WhatsApp">
                                            <i class="bi bi-whatsapp"></i>
                                        </a>
                                    }
                                </div>
                            }
                        </div>
                    }
                    <a asp-action="Ocupacao" asp-route-id="@Model.Clube.Id"
                       class="btn btn-sm btn-outline-secondary rounded-pill mt-3">
                        Ver o mapa da semana inteira →
                    </a>
                </div>
            </div>
        </div>

        <!-- ATALHOS -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-body">
                    <h6 class="fw-bold mb-3" style="color: var(--pdz-ink);">
                        <i class="bi bi-sliders"></i> Administrar
                    </h6>

                    <div class="list-group list-group-flush">
                        <a asp-action="Ocupacao" asp-route-id="@Model.Clube.Id" class="list-group-item list-group-item-action px-0">
                            <span class="fw-semibold" style="color: var(--pdz-ink);">
                                <i class="bi bi-grid-3x3"></i> Mapa da semana
                            </span>
                            <small class="d-block text-muted">Quem está em cada quadra e hora. Bloquear horário e criar mensalista.</small>
                        </a>
                        <a asp-controller="HorarioMarcacao" asp-action="Index" asp-route-clubeId="@Model.Clube.Id"
                           class="list-group-item list-group-item-action px-0">
                            <span class="fw-semibold" style="color: var(--pdz-ink);">
                                <i class="bi bi-clock-history"></i> Quadras, horários e preços
                            </span>
                            <small class="d-block text-muted">
                                @Model.QuadrasAtivas quadra(s) · @Model.HorariosPublicados horário(s) publicado(s).
                                <strong>Virou fixo? Desligue o horário</strong> — ele sai da tela do jogador sem apagar nada.
                            </small>
                        </a>
                        <a asp-action="Financeiro" asp-route-id="@Model.Clube.Id" class="list-group-item list-group-item-action px-0">
                            <span class="fw-semibold" style="color: var(--pdz-ink);">
                                <i class="bi bi-cash-coin"></i> Financeiro
                            </span>
                            <small class="d-block text-muted">Receita por quadra e por dia da semana, cancelamentos e faltas.</small>
                        </a>
                        <a asp-controller="PlanoClube" asp-action="Index" asp-route-id="@Model.Clube.Id"
                           class="list-group-item list-group-item-action px-0">
                            <span class="fw-semibold" style="color: var(--pdz-ink);">
                                <i class="bi bi-stars"></i> Plano do clube
                            </span>
                            <small class="d-block text-muted">O que está incluso, até quando está pago e como assinar.</small>
                        </a>
                        @* O bar está EM CONSTRUÇÃO: enquanto Bar:Habilitado estiver desligado,
                           este atalho só aparece pra admin do Padelizou. O BarController repete
                           a checagem — esconder o link nunca é a trava, só a cortesia. *@
                        @if (ViewBag.MostrarBar == true)
                        {
                            <a asp-controller="Bar" asp-action="Index" asp-route-id="@Model.Clube.Id"
                               class="list-group-item list-group-item-action px-0">
                                <span class="fw-semibold" style="color: var(--pdz-ink);">
                                    <i class="bi bi-cup-straw"></i> Bar
                                    @if (ViewBag.BarEmConstrucao == true)
                                    {
                                        <span class="badge bg-dark ms-1">em construção</span>
                                    }
                                </span>
                                <small class="d-block text-muted">Comandas do dia, cardápio e fechamento de caixa.</small>
                            </a>
                            <a asp-controller="Contas" asp-action="Index" asp-route-id="@Model.Clube.Id"
                               class="list-group-item list-group-item-action px-0">
                                <span class="fw-semibold" style="color: var(--pdz-ink);">
                                    <i class="bi bi-wallet2"></i> Contas a pagar e a receber
                                    @if (ViewBag.BarEmConstrucao == true)
                                    {
                                        <span class="badge bg-dark ms-1">em construção</span>
                                    }
                                </span>
                                <small class="d-block text-muted">Fornecedor, aluguel, luz — e quem ficou devendo.</small>
                            </a>
                        }
                        <a asp-action="Ocupacao" asp-route-id="@Model.Clube.Id" class="list-group-item list-group-item-action px-0">
                            <span class="fw-semibold" style="color: var(--pdz-ink);">
                                <i class="bi bi-shield-check"></i> Política de cancelamento
                            </span>
                            <small class="d-block text-muted">
                                Hoje: cancelamento até @Model.Clube.HorasMinimasCancelamento h antes;
                                falta @(Model.Clube.CobraNoShow ? "é cobrada" : "não é cobrada").
                            </small>
                        </a>
                    </div>
                </div>
            </div>

            @* ── O QUE DISSERAM DO CLUBE ──────────────────────────────────────────────────
               Vem da enquete de fim de torneio (Services/EnqueteDoTorneio): quem jogou aqui
               dá nota e pode escrever. O dono do clube é um dos destinatários combinados com
               quem respondeu — inclusive de quem escreveu sem se identificar.

               ⚠️ O nome não vem nem pra esta tela quando a resposta é anônima: o serviço não
               o entrega. É o que faz a promessa da tela de resposta valer. *@
            @{
                var doClube = ViewBag.ComentariosDoClube as List<Padelizou.Services.ComentarioDoTorneio>;
            }
            @if (doClube != null && doClube.Count > 0)
            {
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-body">
                        <h6 class="fw-bold mb-1" style="color: var(--pdz-ink);">
                            <i class="bi bi-chat-square-heart-fill" style="color: var(--pdz-lima, #A3D827);"></i>
                            O que disseram do seu clube
                        </h6>
                        <p class="small text-muted mb-3">
                            De quem jogou torneio aqui. Publicar um comentário no mural do torneio
                            é feito na página dele.
                        </p>

                        @foreach (var c in doClube)
                        {
                            <div class="border-top pt-2 mt-2">
                                <div class="small text-muted mb-1">
                                    <i class="bi bi-star-fill text-warning"></i> @c.NotaClube ·
                                    @c.Torneio · @c.Quando.ToString("dd/MM/yyyy")
                                    @if (c.Anonimo)
                                    {
                                        <span class="badge rounded-pill bg-secondary-subtle text-secondary-emphasis ms-1">
                                            sem identificação
                                        </span>
                                    }
                                </div>
                                <div class="small">@c.SobreOClube</div>
                            </div>
                        }
                    </div>
                </div>
            }

            @* O plano é conversado caso a caso — então o painel não inventa número, só abre a
               conversa. Sem isto, o dono não tem por onde pedir mudança. *@
            <div class="card border-0 shadow-sm" style="border-left: 4px solid var(--padel-green) !important;">
                <div class="card-body">
                    <h6 class="fw-bold mb-1" style="color: var(--pdz-ink);">
                        <i class="bi bi-patch-check-fill" style="color: var(--padel-green);"></i> Seu plano
                    </h6>
                    <p class="small text-muted mb-2">
                        A marcação de quadra pelo Padelizou é um serviço combinado com o clube.
                        Quer mudar algo do seu plano, incluir quadra ou tirar dúvida de cobrança?
                    </p>
                    <a asp-controller="Auth" asp-action="ReportarProblema" class="btn btn-sm btn-padel rounded-pill px-3">
                        Falar com o Padelizou
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal do balcão (aberto pelo clique num horário livre do dia) -->
<div class="modal fade" id="modalHorario" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title fw-bold" id="horarioResumo">Horário</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form asp-action="MarcarBalcao" method="post">
                    <input type="hidden" name="clubeId" value="@Model.Clube.Id" />
                    <input type="hidden" name="voltarPara" value="Painel" />
                    <input type="hidden" name="quadraId" class="pdz-campo-quadra" />
                    <input type="hidden" name="dataHora" class="pdz-campo-quando" />
                    <label class="form-label small fw-bold text-muted mb-1">Nome de quem reservou</label>
                    <input type="text" name="nome" class="form-control mb-2" maxlength="80" required
                           placeholder="Como a pessoa é conhecida" />
                    <label class="form-label small fw-bold text-muted mb-1">Celular (opcional)</label>
                    <input type="tel" name="celular" class="form-control mb-2" data-mascara="celular"
                           placeholder="(51) 99999-9999" />
                    <div class="d-flex gap-3 mb-3 small">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="jaPagou" value="false" id="pagaLa" checked>
                            <label class="form-check-label" for="pagaLa">Paga no clube</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="jaPagou" value="true" id="jaPagou">
                            <label class="form-check-label" for="jaPagou">Já pagou</label>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-padel rounded-pill px-4 w-100">Marcar</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Mesmo mecanismo do mapa: o clique no horário livre preenche quadra e hora.
        (function () {
            var modalEl = document.getElementById('modalHorario');
            if (!modalEl) return;
            var modal = new bootstrap.Modal(modalEl);

            document.querySelectorAll('.pdz-btn-horario').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    modalEl.querySelectorAll('.pdz-campo-quadra').forEach(function (c) { c.value = btn.dataset.quadra; });
                    modalEl.querySelectorAll('.pdz-campo-quando').forEach(function (c) { c.value = btn.dataset.quando; });
                    document.getElementById('horarioResumo').textContent =
                        btn.dataset.quadraNome + ' — ' + btn.dataset.quando.replace('T', ' às ');
                    var nome = modalEl.querySelector('input[name="nome"]');
                    nome.value = '';
                    modal.show();
                    setTimeout(function () { nome.focus(); }, 200);
                });
            });
        })();
    </script>
}
