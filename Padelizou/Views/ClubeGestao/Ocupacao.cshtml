@model Padelizou.ViewModels.OcupacaoClubeVM
@using System.Globalization
@{
    ViewData["Title"] = $"Ocupação — {Model.Clube.Nome}";
    var ptBr = CultureInfo.GetCultureInfo("pt-BR");
    var dias = Enumerable.Range(0, 7).Select(i => Model.InicioSemana.AddDays(i)).ToList();
}

<div class="container-fluid mt-4 mb-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div>
            <h2 class="fw-bold mb-0" style="color: var(--pdz-ink);"><i class="bi bi-grid-3x3"></i> Mapa de ocupação</h2>
            <p class="text-muted small mb-0">@Model.Clube.Nome</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Financeiro" asp-route-id="@Model.Clube.Id" class="btn btn-outline-primary rounded-pill px-3">
                <i class="bi bi-cash-coin"></i> Financeiro
            </a>
            <a asp-controller="Clubes" asp-action="Gerenciar" asp-route-id="@Model.Clube.Id" class="btn btn-outline-secondary rounded-pill px-3">
                <i class="bi bi-gear"></i> Configurações
            </a>
        </div>
    </div>

    @if (TempData["Sucesso"] != null) { <div class="alert alert-success">@TempData["Sucesso"]</div> }
    @if (TempData["Erro"] != null) { <div class="alert alert-danger">@TempData["Erro"]</div> }

    <!-- Navegação de semana + resumo -->
    <div class="card border-0 shadow-sm mb-3 p-3">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="btn-group">
                <a asp-action="Ocupacao" asp-route-id="@Model.Clube.Id" asp-route-semana="@Model.InicioSemana.AddDays(-7).ToString("yyyy-MM-dd")"
                   class="btn btn-sm btn-outline-secondary"><i class="bi bi-chevron-left"></i></a>
                <a asp-action="Ocupacao" asp-route-id="@Model.Clube.Id"
                   class="btn btn-sm btn-outline-secondary">Hoje</a>
                <a asp-action="Ocupacao" asp-route-id="@Model.Clube.Id" asp-route-semana="@Model.InicioSemana.AddDays(7).ToString("yyyy-MM-dd")"
                   class="btn btn-sm btn-outline-secondary"><i class="bi bi-chevron-right"></i></a>
            </div>
            <strong style="color: var(--pdz-ink);">
                @Model.InicioSemana.ToString("dd/MM") a @Model.FimSemana.ToString("dd/MM")
            </strong>
            <div class="d-flex gap-3 align-items-center">
                <span class="small text-muted">
                    <strong style="color: var(--pdz-ink);">@Model.PercentualOcupacao%</strong> ocupado
                    (@Model.SlotsOcupados/@Model.TotalSlots)
                </span>
                <span class="small text-muted">
                    Receita: <strong class="text-success">@Model.ReceitaSemana.ToString("C0", ptBr)</strong>
                </span>
            </div>
        </div>
    </div>

    @if (!Model.Horarios.Any() || !Model.Quadras.Any())
    {
        <div class="alert alert-light border">
            <i class="bi bi-info-circle"></i>
            Este clube ainda não tem quadras ativas ou horários cadastrados.
            Configure em <a asp-controller="HorarioMarcacao" asp-action="Index" asp-route-clubeId="@Model.Clube.Id">Gerenciar Horários</a>.
        </div>
        return;
    }

    <!-- MAPA: uma tabela por quadra, dias nas colunas -->
    @foreach (var q in Model.Quadras)
    {
        <h6 class="fw-bold mt-4 mb-2" style="color: var(--pdz-ink);"><i class="bi bi-square"></i> @q.Nome</h6>
        <div class="table-responsive">
            <table class="table table-sm table-bordered align-middle mb-0 pdz-mapa">
                <thead>
                    <tr class="text-center small">
                        <th style="width: 62px;">Hora</th>
                        @foreach (var d in dias)
                        {
                            <th class="@(d.Date == DateTime.Today ? "table-warning" : "")">
                                <div class="text-uppercase" style="font-size:.65rem;">@ptBr.DateTimeFormat.GetAbbreviatedDayName(d.DayOfWeek)</div>
                                <div>@d.ToString("dd/MM")</div>
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var h in Model.Horarios)
                    {
                        <tr>
                            <td class="text-center small fw-bold text-muted">@h.ToString(@"hh\:mm")</td>
                            @foreach (var d in dias)
                            {
                                var slot = Model.Slots.GetValueOrDefault((q.Id, d.Date, h));
                                // Monta o valor antes: "data" + "T" + "hora" colados no Razor
                                // fazem o parser tratar o T como início de expressão.
                                var quandoIso = d.Date.Add(h).ToString("yyyy-MM-ddTHH:mm");
                                if (slot == null)
                                {
                                    <td class="text-center pdz-livre" title="Livre — clique pra marcar ou bloquear">
                                        <button type="button" class="btn btn-link btn-sm p-0 text-muted pdz-btn-horario"
                                                data-quadra="@q.Id" data-quadra-nome="@q.Nome" data-quando="@quandoIso"
                                                title="Marcar pra alguém ou bloquear">+</button>
                                    </td>
                                }
                                else if (slot.EhBloqueio)
                                {
                                    <td class="text-center pdz-bloqueado small" title="@slot.Titulo">
                                        <i class="bi bi-lock-fill"></i>
                                        <form asp-action="Desbloquear" method="post" class="d-inline">
                                            <input type="hidden" name="marcacaoId" value="@slot.MarcacaoId" />
                                            <button type="submit" class="btn btn-link btn-sm p-0 text-danger" title="Remover bloqueio">×</button>
                                        </form>
                                    </td>
                                }
                                else
                                {
                                    <td class="text-center pdz-ocupado small text-truncate" style="max-width:110px;"
                                        title="@slot.Titulo@(slot.EhMensalista ? " (mensalista)" : "")@(slot.EhBalcao ? " — reserva de balcão" : "")@(slot.Selo == "" ? "" : $" — {slot.Selo}")">
                                        @if (slot.EhMensalista)
                                        {
                                            <i class="bi bi-arrow-repeat" title="Mensalista"></i>
                                        }
                                        @if (slot.Selo == "paga lá")
                                        {
                                            <i class="bi bi-cash-coin text-warning" title="Paga no clube"></i>
                                        }
                                        @slot.Titulo.Split(' ')[0]
                                        @if (slot.EhBalcao)
                                        {
                                            @* Cliente de telefone desiste por telefone — o × desfaz sem
                                               sair da tela. Reserva do site não tem × aqui: ela envolve
                                               a conta (e às vezes o dinheiro) do jogador. *@
                                            <form asp-action="CancelarBalcao" method="post" class="d-inline"
                                                  onsubmit="return confirm('Cancelar a reserva de @slot.Titulo?');">
                                                <input type="hidden" name="marcacaoId" value="@slot.MarcacaoId" />
                                                <button type="submit" class="btn btn-link btn-sm p-0 text-danger" title="Cancelar reserva">×</button>
                                            </form>
                                        }
                                    </td>
                                }
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <!-- Legenda -->
    <div class="d-flex flex-wrap gap-3 mt-3 small text-muted">
        <span><span class="pdz-chip pdz-livre"></span> livre — o <strong>+</strong> marca pra alguém ou bloqueia</span>
        <span><span class="pdz-chip pdz-ocupado"></span> reservado</span>
        <span><span class="pdz-chip pdz-bloqueado"></span> bloqueado pelo clube</span>
        <span><i class="bi bi-arrow-repeat"></i> horário fixo (mensalista)</span>
        <span><i class="bi bi-cash-coin text-warning"></i> paga no clube</span>
    </div>

    <!-- Criar mensalista -->
    <div class="card border-0 shadow-sm mt-4">
        <div class="card-body">
            <h6 class="fw-bold mb-1" style="color: var(--pdz-ink);"><i class="bi bi-arrow-repeat"></i> Horário fixo (mensalista)</h6>
            <p class="small text-muted">Reserva o mesmo horário toda semana. Se algum já estiver ocupado, ele é pulado.</p>
            <form asp-action="CriarMensalista" method="post">
                <input type="hidden" name="clubeId" value="@Model.Clube.Id" />
                <div class="row g-2">
                    <div class="col-6 col-md-3">
                        <label class="form-label small fw-bold text-muted mb-1">Quadra</label>
                        <select name="quadraId" class="form-select form-select-sm" required>
                            @foreach (var q in Model.Quadras)
                            {
                                <option value="@q.Id">@q.Nome</option>
                            }
                        </select>
                    </div>
                    <div class="col-6 col-md-2">
                        <label class="form-label small fw-bold text-muted mb-1">Jogador (id)</label>
                        <input type="number" name="jogadorId" class="form-control form-control-sm" required />
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label small fw-bold text-muted mb-1">1º dia e hora</label>
                        <input type="datetime-local" name="primeiraData" class="form-control form-control-sm" required />
                    </div>
                    <div class="col-3 col-md-2">
                        <label class="form-label small fw-bold text-muted mb-1">Minutos</label>
                        <input type="number" name="duracaoMinutos" class="form-control form-control-sm" value="60" />
                    </div>
                    <div class="col-3 col-md-2">
                        <label class="form-label small fw-bold text-muted mb-1">Semanas</label>
                        <input type="number" name="semanas" class="form-control form-control-sm" value="4" min="1" max="52" />
                    </div>
                </div>
                <button type="submit" class="btn btn-sm btn-padel rounded-pill px-4 mt-2 fw-bold">Criar horário fixo</button>
            </form>
        </div>
    </div>

    <!-- Política do clube -->
    <div class="card border-0 shadow-sm mt-3">
        <div class="card-body">
            <h6 class="fw-bold mb-1" style="color: var(--pdz-ink);"><i class="bi bi-shield-check"></i> Cancelamento e no-show</h6>
            <form asp-action="SalvarPolitica" method="post">
                <input type="hidden" name="clubeId" value="@Model.Clube.Id" />
                <div class="row g-2 align-items-end">
                    <div class="col-6 col-md-3">
                        <label class="form-label small fw-bold text-muted mb-1">Avisar com quantas horas?</label>
                        <input type="number" name="horasMinimas" min="0" max="168" class="form-control form-control-sm"
                               value="@Model.Clube.HorasMinimasCancelamento" />
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="form-check form-switch mt-3">
                            <input class="form-check-input" type="checkbox" name="cobraNoShow" value="true"
                                   id="cobraNoShow" @(Model.Clube.CobraNoShow ? "checked" : "")>
                            <label class="form-check-label small" for="cobraNoShow">Cobro quem não aparece</label>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label small fw-bold text-muted mb-1">Texto pro jogador (opcional)</label>
                        <input type="text" name="texto" class="form-control form-control-sm"
                               value="@Model.Clube.PoliticaCancelamentoTexto" placeholder="Escreva do seu jeito..." />
                    </div>
                </div>
                <button type="submit" class="btn btn-sm btn-padel rounded-pill px-4 mt-2">Salvar política</button>
            </form>
        </div>
    </div>
</div>

<!-- Modal do horário livre (preenchido pelo clique no +): marcar pra alguém OU bloquear.
     A ação principal é o balcão — é a cena de todo dia; bloquear fica num <details>
     porque acontece de vez em quando. -->
<div class="modal fade" id="modalHorario" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title fw-bold" id="horarioResumo">Horário</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form asp-action="MarcarBalcao" method="post">
                    <input type="hidden" name="clubeId" value="@Model.Clube.Id" />
                    <input type="hidden" name="quadraId" class="pdz-campo-quadra" />
                    <input type="hidden" name="dataHora" class="pdz-campo-quando" />
                    <div class="fw-bold small mb-2" style="color: var(--pdz-ink);">
                        <i class="bi bi-person-plus"></i> Marcar pra alguém
                    </div>
                    <label class="form-label small fw-bold text-muted mb-1">Nome de quem reservou</label>
                    <input type="text" name="nome" class="form-control mb-2" maxlength="80" required
                           placeholder="Como a pessoa é conhecida" />
                    <label class="form-label small fw-bold text-muted mb-1">Celular (opcional)</label>
                    <input type="tel" name="celular" class="form-control mb-2" data-mascara="celular"
                           placeholder="(51) 99999-9999" />
                    @* "Paga lá" é o padrão porque é a vida real do telefone: reserva primeiro,
                       dinheiro na hora do jogo. O selo fica pendurado na agenda até o dono
                       tocar em "recebi". *@
                    <div class="d-flex gap-3 mb-3 small">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="jaPagou" value="false" id="pagaLa" checked>
                            <label class="form-check-label" for="pagaLa">Paga no clube</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="jaPagou" value="true" id="jaPagou">
                            <label class="form-check-label" for="jaPagou">Já pagou</label>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-padel rounded-pill px-4 w-100">Marcar</button>
                </form>

                <details class="mt-3">
                    <summary class="small text-muted" style="cursor: pointer;">
                        <i class="bi bi-lock"></i> Ou bloquear este horário (manutenção, evento, aula)
                    </summary>
                    <form asp-action="Bloquear" method="post" class="mt-2">
                        <input type="hidden" name="clubeId" value="@Model.Clube.Id" />
                        <input type="hidden" name="quadraId" class="pdz-campo-quadra" />
                        <input type="hidden" name="dataHora" class="pdz-campo-quando" />
                        <label class="form-label small fw-bold text-muted mb-1">Motivo</label>
                        <input type="text" name="motivo" class="form-control mb-2" placeholder="Manutenção, evento, aula..." />
                        <label class="form-label small fw-bold text-muted mb-1">Duração (min)</label>
                        <input type="number" name="duracaoMinutos" class="form-control mb-2" value="60" />
                        <button type="submit" class="btn btn-outline-secondary rounded-pill px-4">Bloquear</button>
                    </form>
                </details>
            </div>
        </div>
    </div>
</div>

<style>
    .pdz-mapa td { padding: .25rem; height: 34px; }
    .pdz-livre { background: rgba(139,195,74,.06); }
    .pdz-ocupado { background: rgba(139,195,74,.30); font-weight: 600; }
    .pdz-bloqueado { background: rgba(220,53,69,.18); }
    .pdz-chip { display: inline-block; width: 12px; height: 12px; border-radius: 3px; vertical-align: -1px; margin-right: 3px; }
    .pdz-btn-horario { opacity: 0; transition: opacity .1s; }
    .pdz-livre:hover .pdz-btn-horario { opacity: 1; }
    @@media (hover: none) {
        /* No celular não existe hover: o + fica sempre visível, senão o balcão some. */
        .pdz-btn-horario { opacity: .55; }
    }
</style>

@section Scripts {
    <script>
        // Clique no "+" de um slot livre abre o modal já com quadra e horário preenchidos —
        // nos DOIS formulários (marcar e bloquear), que compartilham o slot clicado.
        (function () {
            var modalEl = document.getElementById('modalHorario');
            if (!modalEl) return;
            var modal = new bootstrap.Modal(modalEl);

            document.querySelectorAll('.pdz-btn-horario').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    modalEl.querySelectorAll('.pdz-campo-quadra').forEach(function (c) { c.value = btn.dataset.quadra; });
                    modalEl.querySelectorAll('.pdz-campo-quando').forEach(function (c) { c.value = btn.dataset.quando; });
                    document.getElementById('horarioResumo').textContent =
                        btn.dataset.quadraNome + ' — ' + btn.dataset.quando.replace('T', ' às ');
                    var nome = modalEl.querySelector('input[name="nome"]');
                    nome.value = '';
                    modal.show();
                    setTimeout(function () { nome.focus(); }, 200);
                });
            });
        })();
    </script>
}
