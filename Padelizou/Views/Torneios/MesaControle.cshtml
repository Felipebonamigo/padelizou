@model IEnumerable<Padelizou.Models.Partida>
@{
    ViewData["Title"] = "Mesa de Controle";
    Layout = "_Layout"; // Mantém o layout padrão
}

<div class="container mt-3 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h3 class="fw-bold text-danger"><i class="bi bi-broadcast"></i> Mesa de Controle (Ao Vivo)</h3>
        <a asp-action="Details" asp-route-id="@ViewBag.TorneioId" class="btn btn-outline-secondary">Voltar</a>
    </div>

    @* O selo que conta a verdade sobre a rede. No ginásio o 3G morre toda hora; a Mesa segue
       funcionando e o organizador precisa SABER disso — senão para de marcar achando que
       quebrou, e é exatamente aí que os placares se perdem. *@
    <div id="mesaStatus" class="pdz-mesa-status pdz-mesa-ok mb-3">Placar sincronizado</div>

    @if (Model != null && Model.Any())
    {
        <div class="row">
            @foreach (var partida in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4" id="cartao_@partida.Id">
                    <div class="card shadow border-0" style="border-top: 5px solid red;">
                        @* ONDE ESTE JOGO ESTÁ ACONTECENDO (21/08/2026).
                           A Mesa é a tela de quem CHAMA pra quadra, e até aqui ela não dizia
                           quadra nenhuma — o mesário sabia porque estava vendo de onde estava.
                           Com o torneio em dois clubes isso desmorona: o mesário do Batata via
                           os jogos do Nata misturados aos dele, sem nenhuma marca. Ver
                           Services/LugarDoJogo. *@
                        <div class="card-header bg-white text-center fw-bold text-danger">
                            <span class="spinner-grow spinner-grow-sm me-1" role="status"></span> AO VIVO
                            @if (LugarDoJogo.Etiqueta(ViewData.Sedes(), partida.NomeQuadra) is { } ondeJoga)
                            {
                                <span class="d-block small fw-normal text-muted">
                                    <i class="bi bi-geo-alt-fill"></i> @ondeJoga
                                </span>
                            }
                        </div>
                        <div class="card-body p-2">

                            <!-- DUPLA A (ou TIME, na categoria de times) -->
                            <div class="p-3 mb-2 rounded bg-light border">
                                <h6 class="fw-bold text-truncate">
                                    @if (partida.Dupla1.EhTime)
                                    {
                                        <span class="text-dark"><i class="bi bi-people-fill"></i> @partida.Dupla1.NomeTime</span>
                                    }
                                    else
                                    {
                                        <a asp-controller="Jogadores" asp-action="Perfil" asp-route-id="@partida.Dupla1.Jogador1Id" class="text-decoration-none text-dark">@partida.Dupla1.Jogador1.ComoChamar</a> <text>/</text>
                                        <a asp-controller="Jogadores" asp-action="Perfil" asp-route-id="@partida.Dupla1.Jogador2Id" class="text-decoration-none text-dark">@(partida.Dupla1.Jogador2?.ComoChamar ?? "A definir")</a>
                                    }
                                </h6>

                                <div class="d-flex justify-content-between align-items-center mt-3">
                                    <div class="text-center">
                                        <small class="text-muted d-block fw-bold">SETS</small>
                                        <div class="btn-group">
                                            <button onclick="MesaOffline.tocar(@partida.Id, 'sets1', -1)" class="btn btn-sm btn-outline-secondary">-</button>
                                            <span class="btn btn-sm btn-light fw-bold fs-5 px-3" id="setsA_@partida.Id">@partida.SetsDupla1</span>
                                            <button onclick="MesaOffline.tocar(@partida.Id, 'sets1', 1)" class="btn btn-sm btn-success">+</button>
                                        </div>
                                    </div>
                                    <div class="text-center">
                                        <small class="text-muted d-block fw-bold">GAMES</small>
                                        <div class="btn-group">
                                            <button onclick="MesaOffline.tocar(@partida.Id, 'games1', -1)" class="btn pdz-mesa-passo pdz-mesa-passo-menos">−</button>
                                            <span class="pdz-mesa-numero" id="gamesA_@partida.Id">@partida.GamesDupla1</span>
                                            <button onclick="MesaOffline.tocar(@partida.Id, 'games1', 1)" class="btn pdz-mesa-passo pdz-mesa-passo-mais">+</button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- DUPLA B (ou TIME, na categoria de times) -->
                            <div class="p-3 rounded bg-light border">
                                <h6 class="fw-bold text-truncate">
                                    @if (partida.Dupla2.EhTime)
                                    {
                                        <span class="text-dark"><i class="bi bi-people-fill"></i> @partida.Dupla2.NomeTime</span>
                                    }
                                    else
                                    {
                                        <a asp-controller="Jogadores" asp-action="Perfil" asp-route-id="@partida.Dupla2.Jogador1Id" class="text-decoration-none text-dark">@partida.Dupla2.Jogador1.ComoChamar</a> <text>/</text>
                                        <a asp-controller="Jogadores" asp-action="Perfil" asp-route-id="@partida.Dupla2.Jogador2Id" class="text-decoration-none text-dark">@(partida.Dupla2.Jogador2?.ComoChamar ?? "A definir")</a>
                                    }
                                </h6>

                                <div class="d-flex justify-content-between align-items-center mt-3">
                                    <div class="text-center">
                                        <div class="btn-group">
                                            <button onclick="MesaOffline.tocar(@partida.Id, 'sets2', -1)" class="btn btn-sm btn-outline-secondary">-</button>
                                            <span class="btn btn-sm btn-light fw-bold fs-5 px-3" id="setsB_@partida.Id">@partida.SetsDupla2</span>
                                            <button onclick="MesaOffline.tocar(@partida.Id, 'sets2', 1)" class="btn btn-sm btn-success">+</button>
                                        </div>
                                    </div>
                                    <div class="text-center">
                                        <div class="btn-group">
                                            <button onclick="MesaOffline.tocar(@partida.Id, 'games2', -1)" class="btn pdz-mesa-passo pdz-mesa-passo-menos">−</button>
                                            <span class="pdz-mesa-numero" id="gamesB_@partida.Id">@partida.GamesDupla2</span>
                                            <button onclick="MesaOffline.tocar(@partida.Id, 'games2', 1)" class="btn pdz-mesa-passo pdz-mesa-passo-mais">+</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <form asp-action="FinalizarPartida" method="post" class="mt-3" onsubmit="return MesaOffline.finalizar(event, @partida.Id)">
                                <input type="hidden" name="partidaId" value="@partida.Id" />
                                <button type="submit" class="btn btn-dark w-100 fw-bold" id="btnFim_@partida.Id">
                                    <i class="bi bi-flag-fill"></i> Finalizar Partida
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        @* Antes esta tela dizia só "nenhuma partida marcada como Em Andamento" — status que
           nem existe na interface (o nome lá é "Ao Vivo") e sem dizer ONDE marcar. No dia do
           torneio o organizador abria a Mesa, via a tela vazia e ficava sem saber o caminho. *@
        <div class="alert alert-secondary text-center py-5">
            <i class="bi bi-info-circle display-4 d-block mb-3"></i>
            <p class="fw-bold mb-2">Nenhum jogo está Ao Vivo ainda.</p>
            <p class="mb-3">
                A Mesa mostra só os jogos em andamento. Para colocar um jogo no ar, abra
                <strong>Jogos</strong>, escolha a partida e mude o status para
                <strong>🔴 Ao Vivo</strong> — o cronômetro começa e ela aparece aqui.
            </p>
            <a asp-controller="Torneios" asp-action="Jogos" asp-route-id="@ViewBag.TorneioId"
               class="btn btn-padel rounded-pill px-4">
                <i class="bi bi-list-ul"></i> Ver os jogos do torneio
            </a>
        </div>
    }
</div>

@* A Mesa funciona sem internet: cada toque atualiza a tela na hora e entra numa fila no
   aparelho, entregue quando a rede deixar. A regra e a fila moram em mesa-offline.js;
   aqui só se diz QUAIS partidas estão na tela. *@
<script src="~/js/mesa-offline.js" asp-append-version="true"></script>
<script>
@{
    // Cada jogo carrega o limite de games da FASE dele: o organizador configura "grupos até
    // 4, final até 6" e a mesma Mesa mostra os dois lado a lado. Antes isto era um `9` fixo
    // aqui, e o que ele escolhia no cadastro não valia em lugar nenhum.
    var torneioDaMesa = ViewBag.Torneio as Padelizou.Models.Torneio;
    var partidasDaMesa = (Model ?? Enumerable.Empty<Padelizou.Models.Partida>())
        .Select(p => $"{{id:{p.Id},games:{Padelizou.Services.FormatoDaPartida.De(torneioDaMesa, p.Fase).Games}}}");

    // A CONTAGEM é do torneio inteiro (não muda por fase), então vai uma vez só. Vem do
    // mesmo serviço que o servidor usa pra validar — se a Mesa decidisse isso sozinha,
    // voltaria o bug do `9` cravado, agora em forma de "somar quando era até".
    var contagemDaMesa = Padelizou.Services.ContagemDeGamesDoTorneio
        .Valido(torneioDaMesa?.ContagemDeGames);
}
    MesaOffline.iniciar({
        torneioId: @ViewBag.TorneioId,
        limiteGames: @Padelizou.Services.FormatoDaPartida.De(torneioDaMesa, Padelizou.Services.FasesTorneio.FaseDeGrupos).Games,
        contagem: "@contagemDaMesa",
        partidas: [@Html.Raw(string.Join(",", partidasDaMesa))]
    });
</script>