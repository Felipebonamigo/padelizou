@model List<Padelizou.Models.Torneio>
@{
    var lugar = (Padelizou.Services.TorneiosPorCidade.Lugar)ViewBag.Lugar;

    @* O título é a frase que a pessoa digitou na busca, na ordem em que ela digitou. Trocar
       por "Porto Alegre - Torneios" faria a página deixar de parecer a resposta. *@
    ViewData["Title"] = $"Torneios de padel em {lugar.Nome} - Padelizou";

    var quantos = Model.Count;
    var plural = quantos == 1 ? "torneio" : "torneios";
    var hoje = DateTime.Today;

    @* Passado e futuro em blocos separados: quem chega aqui quer se inscrever em algo, e
       torneio do mês passado no topo da lista responde a outra pergunta. O que já aconteceu
       fica — é ele que mostra que a cidade tem movimento de verdade. *@
    var proximos = Model.Where(t => t.DataInicio == null || t.DataInicio.Value.Date >= hoje).ToList();
    var passados = Model.Where(t => t.DataInicio != null && t.DataInicio.Value.Date < hoje)
        .OrderByDescending(t => t.DataInicio).ToList();

    ViewData["Descricao"] = $"{quantos} {plural} de padel em {lugar.Nome}"
        + (lugar.Uf == null ? "" : $" ({lugar.Uf})")
        + ": datas, locais, categorias e valor. Inscreva-se pelo site e acompanhe as chaves ao vivo.";
}

@* O caminho até aqui, pro resultado da busca sair "Padelizou › Torneios › Gravataí" em vez do
   endereço cru. É a mesma trilha da migalha visual logo abaixo — as duas contam a mesma
   história de propósito: o buscador compara o que você declara com o que a página mostra. *@
@section Head {
    @{
        var baseDaTrilha = $"{Context.Request.Scheme}://{Context.Request.Host}";
        var trilha = Padelizou.Services.DadosEstruturados.Migalhas(baseDaTrilha,
            ("Padelizou", "/"),
            ("Torneios", "/Torneios"),
            (lugar.Nome, null));
    }
    <script type="application/ld+json">@Html.Raw(trilha)</script>
}

<div class="container mt-4 mb-5">

    <nav aria-label="Você está aqui" class="mb-2">
        <ol class="breadcrumb small mb-0">
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Torneios</a></li>
            <li class="breadcrumb-item active" aria-current="page">@lugar.Nome</li>
        </ol>
    </nav>

    <h1 class="fw-bold mb-1" style="color: var(--pdz-ink); font-size: 1.9rem;">
        Torneios de padel em @lugar.Nome
    </h1>
    <p class="text-muted">
        @quantos @plural @(quantos == 1 ? "aberto" : "abertos") ou já realizados em @lugar.NomeNaTela.
        Inscrição pelo site, chaves e resultados ao vivo.
    </p>

    @if (proximos.Any())
    {
        <h2 class="h5 fw-bold mt-4 mb-3">
            <i class="bi bi-calendar-event text-primary"></i> O que vem por aí
        </h2>
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var torneio in proximos)
            {
                <partial name="_TorneioCard" model="torneio" />
            }
        </div>
    }
    else
    {
        @* Sem torneio marcado a página continua existindo (os que já aconteceram seguem lá),
           mas ela precisa dizer isso — senão a pessoa rola a lista achando que os antigos
           estão abertos. *@
        <div class="alert alert-light border mt-4">
            <i class="bi bi-info-circle"></i>
            Nenhum torneio com data marcada em @lugar.Nome no momento.
            <a asp-action="Index" class="fw-semibold text-decoration-none">Veja os torneios de outras cidades</a>.
        </div>
    }

    @if (passados.Any())
    {
        <h2 class="h5 fw-bold mt-5 mb-3">
            <i class="bi bi-clock-history text-muted"></i> Já aconteceram
        </h2>
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var torneio in passados)
            {
                <partial name="_TorneioCard" model="torneio" />
            }
        </div>
    }

    <hr class="my-5" />

    <p class="text-muted small mb-0">
        Organiza torneio em @lugar.Nome?
        <a asp-action="Index" class="text-decoration-none fw-semibold">Publique o seu no Padelizou</a>
        — inscrição, pagamento, chaves e resultados num lugar só.
    </p>
</div>
