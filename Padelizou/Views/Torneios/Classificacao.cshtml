@model Dictionary<string, List<Padelizou.ViewModels.ClassificacaoGrupoViewModel>>
@{
    ViewData["Title"] = "Classificação";
    var torneio = ViewBag.Torneio;
    int classificadosPorGrupo = ViewBag.RegraClassificados;

    var oQueFalta = ViewBag.OQueFalta as Dictionary<string, Padelizou.Services.OQuePrecisaParaClassificar.Quadro>
        ?? new Dictionary<string, Padelizou.Services.OQuePrecisaParaClassificar.Quadro>();
}

<div class="container mt-4">
    <h2 class="mb-2">🏆 Classificação - @torneio.Nome</h2>

    @* A tabela vira arte pro Instagram — uma por grupo. O link aparece sempre: a página de
       destino é que decide se há grupo com jogo terminado, e ela explica o que falta quando
       não há. Esconder o botão aqui exigiria repetir essa conta na tela, e seriam duas
       respostas pra mesma pergunta. *@
    <div class="mb-4">
        <a asp-controller="Cartoes" asp-action="Classificacao" asp-route-id="@torneio.Id"
           asp-route-categoriaId="@((int)ViewBag.CategoriaId)"
           class="btn btn-sm btn-outline-primary rounded-pill px-3">
            <i class="bi bi-image"></i> Card da classificação
        </a>
        <a asp-controller="Cartoes" asp-action="Resultados" asp-route-id="@torneio.Id"
           asp-route-categoriaId="@((int)ViewBag.CategoriaId)"
           class="btn btn-sm btn-outline-primary rounded-pill px-3">
            <i class="bi bi-list-ol"></i> Card dos resultados
        </a>
        <a asp-controller="Cartoes" asp-action="Chave" asp-route-id="@torneio.Id"
           asp-route-categoriaId="@((int)ViewBag.CategoriaId)"
           class="btn btn-sm btn-outline-primary rounded-pill px-3">
            <i class="bi bi-diagram-3"></i> Card da chave
        </a>
        <small class="text-muted ms-2">Artes prontas pra postar.</small>
    </div>

    <div class="row">
        @foreach (var grupo in Model)
        {
            <div class="col-md-6 mb-4">
                <div class="card shadow-sm border-secondary">
                    <div class="card-header bg-dark text-white fw-bold">
                        Grupo @grupo.Key
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover table-bordered mb-0 text-center align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 50px;">Pos</th>
                                    <th class="text-start">Dupla</th>
                                    <th title="Jogos" style="width: 40px;">J</th>
                                    <th title="Vitórias" style="width: 40px;">V</th>
                                    <th title="Derrotas" style="width: 40px;">D</th>
                                    <th title="Saldo de Games" style="width: 50px;">SG</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int posicao = 1;
                                }
                                @foreach (var stats in grupo.Value)
                                {
                                    // Pinta a linha de um verde bem claro se a dupla estiver na zona de classificação
                                    string classeLinha = posicao <= classificadosPorGrupo ? "table-success" : "";

                                    <tr class="@classeLinha">
                                        <td class="fw-bold">@(posicao)º</td>
                                        <td class="text-start text-truncate" style="max-width: 150px;">
                                            @if (stats.Dupla.EhTime)
                                            {
                                                <span class="fw-bold text-dark"><i class="bi bi-people-fill"></i> @stats.Dupla.NomeTime</span>
                                            }
                                            else
                                            {
                                                <a asp-controller="Jogadores" asp-action="Perfil" asp-route-id="@stats.Dupla.Jogador1Id" class="text-decoration-none text-dark">@stats.Dupla.Jogador1.ComoChamar</a> <br />
                                                <small class="text-muted"><a asp-controller="Jogadores" asp-action="Perfil" asp-route-id="@stats.Dupla.Jogador2Id" class="text-decoration-none text-muted">@(stats.Dupla.Jogador2?.ComoChamar ?? "A definir")</a></small>
                                            }
                                        </td>
                                        <td>@stats.JogosJogados</td>
                                        <td class="text-success fw-bold">@stats.Vitorias</td>
                                        <td class="text-danger">@stats.Derrotas</td>
                                        <td class="fw-bold">@stats.SaldoGames</td>
                                    </tr>
                                    posicao++;
                                }
                            </tbody>
                        </table>
                    </div>

                    @* ── O QUE CADA UM PRECISA PRA CLASSIFICAR ─────────────────────────────
                       Só aparece no grupo em que falta UM jogo — antes disso não há resposta
                       pra dar, e depois o grupo já acabou. Nasce fechado: quem só quer ver a
                       tabela não precisa passar por cima de um bloco de cenários. *@
                    @if (oQueFalta.TryGetValue(grupo.Key, out var quadro))
                    {
                        var alvo = $"oQuePrecisa{grupo.Key.Replace(" ", "")}";
                        <div class="card-footer bg-body border-top">
                            <button class="btn btn-sm btn-outline-primary w-100 rounded-pill"
                                    type="button" data-bs-toggle="collapse" data-bs-target="#@alvo"
                                    aria-expanded="false" aria-controls="@alvo">
                                <i class="bi bi-question-circle"></i>
                                O que cada um precisa para passar
                            </button>

                            @* O CONTEÚDO mora em `_OQuePrecisaParaClassificar` desde 11/09/2026:
                               o card do grupo na página do torneio passou a desenhar o mesmo
                               painel (num pop-up), e duas cópias seriam duas verdades sobre a
                               mesma régua. Aqui continua abrindo NO LUGAR — quem embrulha é
                               quem chama, e ninguém reclamou deste collapse. *@
                            <div class="collapse mt-3" id="@alvo">
                                <partial name="_OQuePrecisaParaClassificar" model="quadro" />
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>