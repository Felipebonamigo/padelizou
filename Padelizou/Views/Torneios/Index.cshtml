@{
    ViewData["Title"] = "Torneios";
    var abertos = ViewBag.Abertos as List<Padelizou.Models.Torneio> ?? new();
    var emAndamento = ViewBag.EmAndamento as List<Padelizou.Models.Torneio> ?? new();
    var emBreve = ViewBag.EmBreve as List<Padelizou.Models.Torneio> ?? new();
    var finalizados = ViewBag.Finalizados as List<Padelizou.Models.Torneio> ?? new();
    // O controller só põe torneio cancelado aqui pra quem organiza (e pro admin) — pra todo o
    // resto a lista chega vazia, e aí a seção inteira não existe.
    var cancelados = ViewBag.Cancelados as List<Padelizou.Models.Torneio> ?? new();
}

<div class="container px-0 mt-4 mb-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <h2 class="fw-bold mb-0" style="color: var(--pdz-ink);"><i class="bi bi-trophy-fill"></i> Torneios</h2>
        <a asp-controller="Torneios" asp-action="Create" class="btn btn-padel rounded-pill px-4">
            <i class="bi bi-plus-circle-fill me-1"></i> Criar seu Torneio
        </a>
    </div>

    @* PEDIR A LIBERAÇÃO DO TORNEIO OFICIAL.
       Fica aqui, e não só na tela de criação, porque é olhando torneio dos outros que dá
       vontade de fazer o próprio — na criação o convite chega tarde, a pessoa já entrou
       querendo criar. Só aparece pra quem está logado E ainda não pode: pra quem já pode,
       seria um botão que não faz nada. *@
    @{
        var estadoDoPedido = ViewBag.EstadoDoPedido as Padelizou.Services.PermissaoDeOrganizador.EstadoDoPedido?
            ?? Padelizou.Services.PermissaoDeOrganizador.EstadoDoPedido.PodeCriar;
        var estouLogado = ViewBag.EstouLogado == true;
        var podePedir = estouLogado
            && estadoDoPedido != Padelizou.Services.PermissaoDeOrganizador.EstadoDoPedido.PodeCriar;
    }
    @if (podePedir)
    {
        var esperando = estadoDoPedido == Padelizou.Services.PermissaoDeOrganizador.EstadoDoPedido.Esperando;
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body d-flex flex-wrap align-items-center gap-3">
                <i class="bi @(esperando ? "bi-hourglass-split" : "bi-trophy") fs-3" style="color: var(--padel-green);"></i>
                <div class="flex-grow-1" style="min-width: 15rem;">
                    <div class="fw-bold" style="color: var(--pdz-ink);">
                        @(esperando ? "Pedido enviado" : "Quer criar torneio Oficial?")
                    </div>
                    <div class="small text-muted">
                        @Padelizou.Services.TextoDoPedidoDeOrganizador.Frase(estadoDoPedido)
                    </div>
                </div>
                @* Quem está esperando NÃO vê botão: apertar de novo não adianta, e um botão
                   ativo faria a pessoa achar que o primeiro pedido não foi. *@
                @if (!esperando)
                {
                    <button type="button" class="btn btn-padel rounded-pill px-4" data-bs-toggle="modal"
                            data-bs-target="#modalPedirOrganizador">
                        <i class="bi bi-hand-index-thumb"></i> Solicitar permissão
                    </button>
                }
            </div>
        </div>

        <div class="modal fade" id="modalPedirOrganizador" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog">
                <form asp-controller="Torneios" asp-action="SolicitarPerfilDeOrganizador" method="post" class="modal-content">
                    @Html.AntiForgeryToken()
                    <div class="modal-header">
                        <h5 class="modal-title"><i class="bi bi-trophy"></i> Pedir pra criar torneio Oficial</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                    </div>
                    <div class="modal-body">
                        <p class="small text-muted">
                            O torneio Oficial tem duplas fixas, chave e vale ranking — por isso a
                            liberação é uma a uma. O <strong>Americano</strong> você já pode criar
                            agora, sem pedir nada.
                        </p>
                        <label class="form-label fw-bold small" for="motivoPedido">
                            Conte rapidinho (opcional)
                        </label>
                        @* Opcional de verdade: campo obrigatório aqui faria gente desistir no
                           meio. Mas é ELE que resolve o pedido em cinco segundos do outro lado
                           — daí o exemplo concreto no lugar de "descreva sua solicitação". *@
                        <textarea name="motivo" id="motivoPedido" class="form-control" rows="3" maxlength="500"
                                  placeholder="Ex: sou professor no Batata Padel e faço um interno todo mês."></textarea>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Agora não</button>
                        <button type="submit" class="btn btn-padel fw-bold">Enviar pedido</button>
                    </div>
                </form>
            </div>
        </div>
    }

    <div class="mb-4">
        <input type="text" id="buscaTorneioNome" class="form-control" placeholder="Buscar torneio pelo nome...">
    </div>

    @* A ORDEM DAS SEÇÕES é decisão do Felipe (08/08/2026): EM ANDAMENTO primeiro, depois
       Inscrições Abertas, Em breve e Finalizados.

       O que está acontecendo AGORA é o que mais gente abre a página pra ver — é o jogo de
       hoje, o placar ao vivo, a chave que acabou de sair. Inscrição é decisão de uma vez só;
       torneio rolando é a tela que a pessoa volta pra ver várias vezes no mesmo dia. A ordem
       também acompanha a urgência: acontecendo agora > dá pra entrar > vai abrir > acabou. *@
    <h5 class="pdz-section-title mb-3">Em Andamento</h5>
    <div class="row row-cols-1 row-cols-md-3 g-4 mb-5 torneio-secao" data-vazio="Nenhum torneio em andamento no momento.">
        @if (emAndamento.Any())
        {
            foreach (var torneio in emAndamento)
            {
                <partial name="_TorneioCard" model="torneio" />
            }
        }
        else
        {
            <div class="col-12 text-center text-muted"><p>Nenhum torneio em andamento no momento.</p></div>
        }
    </div>

    <h5 class="pdz-section-title mb-3">Inscrições Abertas</h5>
    <div class="row row-cols-1 row-cols-md-3 g-4 mb-5 torneio-secao" data-vazio="Nenhum torneio com inscrições abertas no momento.">
        @if (abertos.Any())
        {
            foreach (var torneio in abertos)
            {
                <partial name="_TorneioCard" model="torneio" />
            }
        }
        else
        {
            <div class="col-12 text-center text-muted"><p>Nenhum torneio com inscrições abertas no momento.</p></div>
        }
    </div>

    @* EM BREVE: o torneio já existe e já dá pra ver (local, data, preço, categorias), mas a
       inscrição ainda não abriu. Sem esta seção ele caía em "Em Andamento" — anunciando como
       acontecendo um torneio que o organizador ainda está montando.

       Aparece SÓ quando tem algum: seção vazia com "nenhum torneio em breve" é ruído numa
       página que já tem quatro blocos. As outras têm texto de vazio porque a ausência delas
       significa alguma coisa; a ausência desta não. *@
    @if (emBreve.Any())
    {
        <h5 class="pdz-section-title mb-1">Em breve</h5>
        <p class="text-muted small mb-3">
            <i class="bi bi-hourglass-split"></i>
            As inscrições ainda não abriram. Dá pra ver os detalhes e voltar quando abrir.
        </p>
        <div class="row row-cols-1 row-cols-md-3 g-4 mb-5 torneio-secao">
            @foreach (var torneio in emBreve)
            {
                <partial name="_TorneioCard" model="torneio" />
            }
        </div>
    }

    @* CANCELADOS: seção só de quem organiza. É aqui que ele reencontra o torneio pra resolver
       as devoluções — some da lista pública, mas não pode sumir DELE. Aparece aberta, e não
       recolhida como Finalizados, porque cancelamento costuma ter dinheiro pendente. *@
    @if (cancelados.Any())
    {
        <h5 class="pdz-section-title mb-1">Cancelados</h5>
        <p class="text-muted small mb-3">
            <i class="bi bi-eye-slash"></i> Só você vê estes aqui — eles saíram da lista pública.
        </p>
        <div class="row row-cols-1 row-cols-md-3 g-4 mb-5 torneio-secao">
            @foreach (var torneio in cancelados)
            {
                <partial name="_TorneioCard" model="torneio" />
            }
        </div>
    }

    <h5 class="pdz-section-title mb-3">
        <button class="btn btn-sm btn-outline-secondary rounded-pill" type="button" data-bs-toggle="collapse" data-bs-target="#secaoFinalizados">
            Finalizados (@finalizados.Count) <i class="bi bi-chevron-down"></i>
        </button>
    </h5>
    <div class="collapse" id="secaoFinalizados">
        <div class="row row-cols-1 row-cols-md-3 g-4 torneio-secao" data-vazio="Nenhum torneio finalizado ainda.">
            @if (finalizados.Any())
            {
                foreach (var torneio in finalizados)
                {
                    <partial name="_TorneioCard" model="torneio" />
                }
            }
            else
            {
                <div class="col-12 text-center text-muted"><p>Nenhum torneio finalizado ainda.</p></div>
            }
        </div>
    </div>
</div>

<script>
    (function () {
        var input = document.getElementById('buscaTorneioNome');
        input.addEventListener('input', function () {
            var termo = input.value.trim().toLowerCase();
            document.querySelectorAll('.torneio-secao').forEach(function (secao) {
                var cards = secao.querySelectorAll('[data-torneio-nome]');
                var algumVisivel = false;
                cards.forEach(function (card) {
                    var visivel = card.getAttribute('data-torneio-nome').includes(termo);
                    card.style.display = visivel ? '' : 'none';
                    if (visivel) algumVisivel = true;
                });
                if (cards.length > 0) {
                    // Se tem cards de torneio nessa seção, só mostra "vazio" quando a busca não bate com nada
                    var semResultado = termo.length > 0 && !algumVisivel;
                    secao.querySelectorAll('.pdz-busca-sem-resultado').forEach(function (el) { el.remove(); });
                    if (semResultado) {
                        var aviso = document.createElement('div');
                        aviso.className = 'col-12 text-center text-muted pdz-busca-sem-resultado';
                        aviso.innerHTML = '<p>Nenhum torneio encontrado com esse nome.</p>';
                        secao.appendChild(aviso);
                    }
                    // Expande a seção de Finalizados automaticamente quando a busca encontra algo lá dentro
                    if (termo.length > 0 && algumVisivel) {
                        var colapsoFinalizados = document.getElementById('secaoFinalizados');
                        if (secao.closest('#secaoFinalizados') && !colapsoFinalizados.classList.contains('show')) {
                            new bootstrap.Collapse(colapsoFinalizados, { show: true });
                        }
                    }
                }
            });
        });
    })();
</script>
