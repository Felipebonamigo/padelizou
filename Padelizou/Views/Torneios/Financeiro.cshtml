@model Padelizou.ViewModels.FinanceiroTorneioVM
@using System.Globalization
@{
    ViewData["Title"] = $"Financeiro — {Model.Torneio.Nome}";
    var ptBr = CultureInfo.GetCultureInfo("pt-BR");
    string SoDigitos(string? s) => new string((s ?? "").Where(char.IsDigit).ToArray());
}

<div class="container mt-4 mb-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div>
            <h2 class="fw-bold mb-0" style="color: var(--pdz-ink);"><i class="bi bi-cash-stack"></i> Financeiro do torneio</h2>
            <p class="text-muted small mb-0">@Model.Torneio.Nome</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Relatorio" asp-route-id="@Model.Torneio.Id" class="btn btn-outline-primary rounded-pill px-3">
                <i class="bi bi-file-earmark-text"></i> Relatório
            </a>
            <a asp-action="Details" asp-route-id="@Model.Torneio.Id" class="btn btn-outline-secondary rounded-pill px-3">
                <i class="bi bi-arrow-left"></i> Torneio
            </a>
        </div>
    </div>

    @if (Model.EhGratuito)
    {
        <div class="alert alert-light border">
            <i class="bi bi-info-circle"></i>
            Este torneio é <strong>gratuito</strong> (inscrição R$ 0,00), então não há cobrança pra acompanhar aqui.
            Os números de inscritos continuam valendo.
        </div>
    }

    @* Os quatro cartões liam SÓ do gateway. Num torneio "por fora" não passa cobrança
       nenhuma por lá, então ficavam em R$ 0,00 pra sempre enquanto a caderneta logo abaixo
       mostrava milhares recebidos — e o organizador lia o zero em letra garrafal e achava
       que o sistema tinha perdido o dinheiro dele. Agora cada número lê da fonte certa. *@
    @if (Model.CobraPorFora)
    {
        <p class="small text-muted mb-2">
            <i class="bi bi-info-circle"></i>
            Neste torneio o dinheiro <strong>não passa pelo Padelizou</strong> — os números abaixo
            saem do que você marcou como recebido na sua caderneta.
        </p>
    }

    <div class="row g-2 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm p-3 h-100">
                <small class="text-muted text-uppercase" style="font-size:.7rem;">
                    @(Model.CobraPorFora ? "Você já recebeu" : "Arrecadado")
                </small>
                <div class="fw-bold fs-4 text-success">@Model.ArrecadadoNaTela.ToString("C", ptBr)</div>
                <small class="text-muted">
                    @Model.PagantesNaTela @(Model.CobraPorFora ? "acertaram" : "pagante(s)")
                </small>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm p-3 h-100">
                <small class="text-muted text-uppercase" style="font-size:.7rem;">
                    @(Model.CobraPorFora ? "A receber" : "Aguardando")
                </small>
                <div class="fw-bold fs-4 text-warning">@Model.AguardandoNaTela.ToString("C", ptBr)</div>
                <small class="text-muted">
                    @if (Model.CobraPorFora)
                    {
                        @(Model.CobrancaPorFora.Count(c => !c.Pago)) <text> ainda devem</text>
                    }
                    else
                    {
                        @Model.Pendentes.Count <text> cobrança(s)</text>
                    }
                </small>
            </div>
        </div>
        @* Estorno é coisa de cobrança do site: no "por fora" quem devolve é o organizador,
           por fora também, e o sistema não tem como saber. Um zero ali seria só ruído. *@
        @if (Model.MostraEstornado)
        {
            <div class="col-6 col-lg-3">
                <div class="card border-0 shadow-sm p-3 h-100">
                    <small class="text-muted text-uppercase" style="font-size:.7rem;">Estornado</small>
                    <div class="fw-bold fs-4 text-danger">@Model.Estornado.ToString("C", ptBr)</div>
                    <small class="text-muted">devolvido</small>
                </div>
            </div>
        }
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm p-3 h-100">
                <small class="text-muted text-uppercase" style="font-size:.7rem;">Líquido pra você</small>
                <div class="fw-bold fs-4" style="color: var(--pdz-ink);">@Model.LiquidoNaTela.ToString("C", ptBr)</div>
                <small class="text-muted">
                    @if (Model.CobraPorFora && Model.TaxaNaTela == 0)
                    {
                        <text>taxa do Padelizou já acertada</text>
                    }
                    else
                    {
                        <text>taxa: @Model.TaxaNaTela.ToString("C", ptBr)</text>
                    }
                </small>
            </div>
        </div>
    </div>

    <!-- Por categoria -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <h6 class="fw-bold mb-3" style="color: var(--pdz-ink);"><i class="bi bi-layers"></i> Por categoria</h6>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        @* No celular ficam Categoria, Inscritos e Arrecadado — o que o
                           organizador olha no dia. Espera e Estornado somem abaixo de 576px
                           (quase sempre valem "—") em vez de empurrar a tabela pra 381px numa
                           tela de 294, obrigando a arrastar pra ver quanto entrou. *@
                        <tr class="small text-muted">
                            <th>Categoria</th>
                            <th class="text-center">Inscritos</th>
                            <th class="text-center d-none d-sm-table-cell">Espera</th>
                            <th class="text-end">Arrecadado</th>
                            <th class="text-end d-none d-sm-table-cell">Estornado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model.PorCategoria)
                        {
                            <tr>
                                <td class="fw-bold" style="color: var(--pdz-ink);">@c.Categoria</td>
                                <td class="text-center">@c.Inscritos</td>
                                <td class="text-center d-none d-sm-table-cell">
                                    @if (c.ListaDeEspera > 0)
                                    {
                                        <span class="badge bg-warning text-dark">@c.ListaDeEspera</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="text-end text-success">@c.Arrecadado.ToString("C", ptBr)</td>
                                <td class="text-end text-muted d-none d-sm-table-cell">@(c.Estornado > 0 ? c.Estornado.ToString("C", ptBr) : "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (Model.Pendente > 0)
            {
                <p class="small text-muted mb-0 mt-2">
                    As cobranças <strong>aguardando pagamento</strong> não aparecem por categoria porque a inscrição
                    só é criada quando o dinheiro entra — elas estão listadas abaixo.
                </p>
            }
        </div>
    </div>

    @* ── A caderneta do "por fora" ─────────────────────────────────────────────────────
       Neste torneio o dinheiro não passa pelo site, então a lista "aguardando pagamento"
       (feita das cobranças do gateway) é sempre vazia. O organizador ficava com a conta de
       cabeça, marcando dupla por dupla no meio da lista de gestão — e depois de encerrar as
       inscrições o botão de marcar pago nem aparecia mais, justo quando o pessoal paga. *@
    @if (Model.CobraPorFora)
    {
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                    <h6 class="fw-bold mb-0" style="color: var(--pdz-ink);">
                        <i class="bi bi-journal-check"></i> Quem já acertou com você
                    </h6>
                    <div class="small">
                        <span class="text-success fw-bold">@Model.RecebidoPorFora.ToString("C", ptBr) recebido</span>
                        @if (Model.AReceberPorFora > 0)
                        {
                            <span class="text-danger fw-bold ms-2">@Model.AReceberPorFora.ToString("C", ptBr) a receber</span>
                        }
                    </div>
                </div>

                <p class="small text-muted">
                    O Padelizou não vê esse dinheiro — quem marca é você, conforme o Pix cai.
                    @if (!string.IsNullOrWhiteSpace(Model.Torneio.ChavePixOrganizador))
                    {
                        <text>Sua chave Pix aparece pro jogador na página do torneio.</text>
                    }
                </p>

                @if (!Model.CobrancaPorFora.Any())
                {
                    <p class="text-muted mb-0">Nenhuma inscrição ainda.</p>
                }
                else
                {
                    @foreach (var c in Model.CobrancaPorFora)
                    {
                        <div class="d-flex align-items-center gap-2 py-2 border-top">
                            <div class="flex-grow-1 overflow-hidden">
                                <span class="d-block fw-bold text-truncate" style="color: var(--pdz-ink);">@c.Nomes</span>
                                <small class="text-muted">
                                    @c.Categoria
                                    @if (c.EmListaDeEspera)
                                    {
                                        <span class="badge bg-warning text-dark ms-1">lista de espera</span>
                                    }
                                    @if (c.Pago && c.PagoEm != null)
                                    {
                                        <span class="text-success">· pago em @c.PagoEm.Value.ToString("dd/MM")</span>
                                    }
                                </small>
                            </div>

                            <span class="fw-bold text-nowrap @(c.Pago ? "text-success" : "text-danger")">
                                @c.Valor.ToString("C", ptBr)
                            </span>

                            @* Cobrar é o que o organizador faz mais: a mensagem já vai pronta,
                               com o valor e a chave Pix, pra ele não digitar trinta vezes. *@
                            @if (!c.Pago && !string.IsNullOrWhiteSpace(c.Celular))
                            {
                                var texto = $"Oi {c.PrimeiroNome}! Sua inscrição em {Model.Torneio.Nome} "
                                          + $"({c.Categoria}) é {c.Valor.ToString("C", ptBr)}."
                                          + (string.IsNullOrWhiteSpace(Model.Torneio.ChavePixOrganizador)
                                             ? ""
                                             : $" Pix: {Model.Torneio.ChavePixOrganizador}");
                                <a href="https://wa.me/55@(SoDigitos(c.Celular))?text=@Uri.EscapeDataString(texto)"
                                   target="_blank" rel="noopener"
                                   class="btn btn-sm btn-outline-success rounded-pill flex-shrink-0" title="Cobrar no WhatsApp">
                                    <i class="bi bi-whatsapp"></i>
                                </a>
                            }

                            @* Vale em QUALQUER status do torneio: muita gente paga depois das
                               inscrições encerradas, e antes o botão sumia justo nessa hora. *@
                            <form asp-controller="Torneios"
                                  asp-action="@(c.EhDupla ? "AlternarPagamentoDupla" : "AlternarPagamentoAmericano")"
                                  method="post" class="flex-shrink-0">
                                <input type="hidden" name="@(c.EhDupla ? "duplaId" : "inscricaoId")" value="@c.Id" />
                                <input type="hidden" name="voltarPara" value="Financeiro" />
                                <button type="submit" class="btn btn-sm rounded-pill @(c.Pago ? "btn-outline-secondary" : "btn-success")"
                                        title="@(c.Pago ? "Desmarcar" : "Marcar como pago")">
                                    <i class="bi @(c.Pago ? "bi-arrow-counterclockwise" : "bi-check-lg")"></i>
                                </button>
                            </form>
                        </div>
                    }
                }
            </div>
        </div>
    }

    <!-- Aguardando pagamento -->
    @if (Model.Pendentes.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h6 class="fw-bold mb-3" style="color: var(--pdz-ink);">
                    <i class="bi bi-hourglass-split"></i> Aguardando pagamento
                </h6>
                @foreach (var p in Model.Pendentes)
                {
                    <div class="d-flex align-items-center gap-2 py-2 border-top">
                        <div class="flex-grow-1 overflow-hidden">
                            <span class="d-block text-truncate fw-bold" style="color: var(--pdz-ink);">@p.Jogador</span>
                            <small class="text-muted">
                                gerada @p.CriadoEm.ToString("dd/MM HH:mm")
                                @if (p.ExpiraEm != null)
                                {
                                    <span>· expira @p.ExpiraEm.Value.ToString("dd/MM HH:mm")</span>
                                }
                            </small>
                        </div>
                        <span class="fw-bold text-warning text-nowrap">@p.Valor.ToString("C", ptBr)</span>
                        @if (!string.IsNullOrWhiteSpace(p.LinkCobranca))
                        {
                            <a href="@p.LinkCobranca" target="_blank" rel="noopener"
                               class="btn btn-sm btn-outline-primary rounded-pill flex-shrink-0" title="Abrir cobrança">
                                <i class="bi bi-link-45deg"></i>
                            </a>
                        }
                        @if (!string.IsNullOrWhiteSpace(p.Celular))
                        {
                            var msg = Uri.EscapeDataString($"Oi {p.Jogador.Split(' ')[0]}! Sua inscrição em {Model.Torneio.Nome} está aguardando pagamento. {p.LinkCobranca}");
                            <a href="https://wa.me/55@(SoDigitos(p.Celular))?text=@msg" target="_blank" rel="noopener"
                               class="btn btn-sm btn-outline-success rounded-pill flex-shrink-0" title="Cobrar no WhatsApp">
                                <i class="bi bi-whatsapp"></i>
                            </a>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>
