@model Padelizou.Models.Dupla

@* UMA LINHA DA CHAMADA: a dupla, a hora em que chegou e o botão que grava.

   Vive num parcial porque a MESMA linha é desenhada em dois lugares desde 10/09/2026 — dentro
   do jogo que vem, na fila do dia, e na lista por categoria do "Resto do torneio". Duas cópias
   do formulário divergiriam na primeira mudança, e é ele que grava presença.

   ⚠️ O BOTÃO QUE GRAVA saiu daqui em 12/09/2026 e foi pro `_BotaoDoCheckIn`: a aba Jogos passou
   a marcar presença também, numa bolinha, e as duas roupas precisam gravar a MESMA coisa. O que
   sobra aqui é a linha — nome, hora da chegada e o ícone do estado.

   ⚠️ Sem `[Authorize]`/checagem aqui, de propósito: quem decide quem enxerga isto é a tela, e
   o `MarcarCheckIn` confere de novo no servidor a cada clique (PodeOperarODiaDeJogoAsync). *@

@if (Model == null) { return; }

@{ bool chegou = Model.CheckInEm != null; }

<div class="list-group-item d-flex align-items-center gap-3 px-2 @(chegou ? "bg-light" : "")">
    <i class="bi @(chegou ? "bi-check-circle-fill" : "bi-circle") fs-4"
       style="color: @(chegou ? "var(--padel-green)" : "#ccc");"></i>
    <div class="flex-grow-1 overflow-hidden">
        <span class="d-block text-truncate fw-bold" style="color: var(--pdz-ink);">
            @if (Model.EhTime)
            {
                <span><i class="bi bi-people-fill"></i> @Model.NomeTime</span>
            }
            else
            {
                @Model.Jogador1.ComoChamar
                @if (Model.Jogador2 != null)
                {
                    <span>/ @Model.Jogador2.ComoChamar</span>
                }
                else
                {
                    <em class="text-muted small">/ sem parceiro</em>
                }
            }
        </span>
        @if (chegou)
        {
            <small class="text-muted">chegou @Model.CheckInEm!.Value.ToString("HH:mm")</small>
        }
    </div>
    @* Sem `voltarPara`: quem clica aqui já está na tela de Check-in, e é pra ela que volta. *@
    <partial name="_BotaoDoCheckIn" model="(Model, false, (string?)null)" />
</div>
