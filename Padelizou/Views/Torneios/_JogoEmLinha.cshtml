@model (Padelizou.Models.Partida Jogo, bool EhOrganizador, bool Finalizada, Padelizou.ViewModels.PalpiteResumoVM? Palpites, int? MeuId)
@*
    Um jogo na lista de Agendadas / Finalizadas.

    Três perguntas se responde aqui, e a linha antiga respondia mal duas delas: QUEM joga
    (só o nome, sem rosto — numa lista de 47 jogos ninguém acha o seu), QUANDO e ONDE
    (categoria, fase e quadra saíam como um risco de texto cinza de 11px, o mesmo peso do
    resto). Agora: rosto junto do nome, e categoria/fase/quadra como etiquetas na primeira
    linha, que é onde o olho bate primeiro.

    O cartão grande (placar gigante, cronômetro) continua sendo do AO VIVO — ali a tela tem
    um assunto só. Aqui é lista, e lista se varre.
*@
@{
    var jogo = Model.Jogo;
    // Pra onde o POST das setas volta (a aba de onde se clicou). Fora do atributo `model=""` de
    // propósito: aspas dentro de aspas quebram o parser do Razor.
    var voltarParaAqui = ViewData["TargetAction"] as string;

    // O RÓTULO DO JOGO nos modais (⇄, relógio, quadra) e o horário no formato do
    // `<input type="datetime-local">`. Eram a mesma expressão copiada em três botões; viraram
    // variável quando o quarto uso (o menu ⋯) apareceu — e porque `model=""` de partial não
    // aceita aspas dentro, pela mesma razão do `voltarParaAqui` aqui em cima.
    var rotuloDoJogo = $"{jogo.Codigo} · {jogo.HorarioPrevisto?.ToString("dd/MM HH:mm") ?? "sem horário"} · {jogo.Dupla1.NomeDeExibicao} x {jogo.Dupla2.NomeDeExibicao}";
    var horarioDoJogoNoInput = jogo.HorarioPrevisto?.ToString("yyyy-MM-dd'T'HH:mm") ?? "";
    var referenciaDoJogo = jogo.Id.ToString();
    // As setas ↑↓ do menu só em jogo AGENDADO: mover quem está em quadra é reescrever o que
    // está acontecendo. O menu em si continua no AO VIVO, por causa do relógio.
    var ehAgendado = jogo.Status == "Agendada";
    var g1 = jogo.GamesDupla1 ?? 0;
    var g2 = jogo.GamesDupla2 ?? 0;
    var venceu1 = Model.Finalizada && g1 > g2;
    var venceu2 = Model.Finalizada && g2 > g1;

    var r = Model.Palpites;
    bool temPalpite = r != null && r.TotalVotos > 0;
    bool podeVotar = jogo.Status == "Agendada" && Model.MeuId.HasValue;

    // O palpitômetro aparece em TODO jogo que ainda vai acontecer, com ou sem voto, e nos
    // que acabaram só se alguém palpitou (aí ele é histórico).
    //
    // Antes ele dependia de haver voto OU de estar logado — e o resultado era uma lista
    // salpicada, com o bloco aparecendo em dois jogos e sumindo em dez, do lado de jogos
    // idênticos. Quem visita deslogado é justamente quem ainda pode virar usuário: ver a
    // barra e o convite pra entrar é o convite; ver nada não convida ninguém.
    bool mostraPalpitometro = temPalpite || jogo.Status == "Agendada";

    // NOME E SOBRENOME, não só o primeiro nome (Felipe, 08/08/2026): "aqui no americano está
    // difícil de entender quem é quem".
    //
    // ⚠️ No Americano o primeiro nome não identifica ninguém, e isso é estrutural do formato:
    // as MESMAS dez pessoas se repetem em dezenas de linhas, embaralhadas em duplas novas a
    // cada rodada. No primeiro Americano real havia duas Carolines e duas Natálias — a lista
    // inteira virava adivinhação. Num torneio de chave dava pra viver com o primeiro nome
    // porque cada dupla aparece poucas vezes; aqui não dá.
    //
    // `NomeBonito.Curto` é a MESMA régua do chip do jogador e da tabela de classificação
    // (primeiro + último sobrenome, partícula e "Junior" tratados) — cortar no primeiro espaço
    // era a segunda cópia da regra, e a que estava errada.
    string NomeCurto(Padelizou.Models.Jogador? j) =>
        j == null ? "?" : Padelizou.Services.NomeBonito.Curto(j.Nome);

    // Nome da dupla em texto puro — o modal "quem votou" recebe por atributo, então aqui
    // não pode vir marcação.
    string NomeDaDupla(Padelizou.Models.Dupla? d) =>
        d == null ? "A definir"
        : d.EhTime ? (d.NomeTime ?? "Time")
        // Vaga em aberto (09/09/2026): "Paulo / ?" parecia dado corrompido.
        : $"{NomeCurto(d.Jogador1)} / {(d.Jogador2 == null ? "parceiro" : NomeCurto(d.Jogador2))}";

    int pct1 = temPalpite ? (int)Math.Round(r!.PercentualDupla1) : 50;
    int pct2 = temPalpite ? (int)Math.Round(r!.PercentualDupla2) : 50;

    // O organizador abriu a marcação de placar? (Services/QuemMarcaOPlacar). Quem entra por
    // aqui vê SÓ o play e o lápis — trocar horário/quadra, voltar pra agendado e reabrir
    // continuam da organização. O servidor confere tudo de novo em cada POST.
    bool podeMarcarSemSerDaMesa = !Model.EhOrganizador
        && Padelizou.Services.QuemMarcaOPlacar.Liberado(
            ViewData["QuemMarcaPlacar"] as string, Model.MeuId, jogo,
            ViewData["EhInscritoDoTorneio"] as bool? ?? false);

    // A BOLINHA DO CHECK-IN, do lado do nome de cada dupla (12/09/2026).
    //
    // 🗣️ Felipe, num print desta lista no celular: *"Temos q por uma forma de fazer o checkin
    // nessa tela por jogo"*, e escolhendo o formato: *"uma bolinha do lado de cada nome, apenas o
    // organizador ve"*.
    //
    // 🕳️ A presença já existia e já era por jogo (a tela de Check-in virou fila de jogos em
    // 10/09) — o que faltava era o CAMINHO: quem está aqui chamando quadra, dando a largada e
    // marcando placar tinha que sair da lista, marcar na outra tela e voltar. No sábado de manhã
    // as duas perguntas ("quem joga agora?" e "essa dupla chegou?") são feitas na mesma linha.
    //
    // As três condições juntas, e cada uma por um motivo diferente:
    //   • `Model.EhOrganizador` — é a régua do DIA DE JOGO (PodeOperarODiaDeJogoAsync), a mesma
    //     que já liga o ▶, o ✏️ e o 📍 desta linha e a mesma da tela de Check-in. Inventar uma
    //     segunda aqui seria o marcador ganhar o play e perder a chamada.
    //   • `UsaCheckIn` — torneio que desligou a chamada não ganha bolinha nenhuma; oferecer e
    //     recusar depois é fazer o organizador descobrir a regra pelo erro.
    //   • `ehAgendado` — jogo em quadra ou encerrado já respondeu a pergunta por outra via. Quem
    //     precisar corrigir tem o bloco do fim da tela de Check-in.
    bool bolinhaDoCheckIn = Model.EhOrganizador
        && ViewData["UsaCheckIn"] as bool? == true
        && ehAgendado;

    // A bolinha do saque só em jogo EM QUADRA. Ela responde "quem está sacando AGORA" —
    // numa partida agendada não há saque nenhum, e o campo pode vir preenchido de um
    // "colocar no ar" desfeito ou de um placar corrigido depois. Em jogo finalizado ela
    // também não diz nada: quem sacava no último ponto é trivia, não informação.
    int? sacandoAgora = jogo.Status == "AoVivo" ? jogo.DuplaSacandoId : null;
}

@* Os rostos da dupla, sobrepostos. É o que faz alguém achar o próprio jogo varrendo a
   lista — nome sozinho, numa tela de 47 jogos, obriga a ler tudo. Time entra com um ícone
   só: lá não são duas pessoas, é uma equipe. *@
@functions {
    private static string Foto(Padelizou.Models.Jogador? j) =>
        string.IsNullOrEmpty(j?.FotoPerfil) ? "/img/default-avatar.png" : j!.FotoPerfil!;

    // O ESCUDO DO TIME, do lado do nome. 🗣️ Felipe, 11/09/2026, olhando a aba Jogos em
    // produção: *"aqui nos jogos tambem coloque as bandeiras igual tinha me mostrado no plano
    // A"*. Aqui não há nome de time escrito — o escudo é a pista inteira, e por isso leva o
    // nome no alt e no title.
    //
    // ⚠️ HtmlEncode no src E no alt: esta linha é montada em STRING (HtmlContentBuilder), então
    // o encoding que o Razor faz sozinho em `@atributo` NÃO acontece aqui — e o nome do time é
    // texto que quem cadastra digita. Uma aspa nele fecharia o atributo.
    //
    // Só quem tem logo cadastrado desenha: os 44 times importados do ranking nasceram sem
    // nenhum, e `src=""` é ícone quebrado repetido em 97 linhas.
    private static string Escudo(Padelizou.Models.Jogador? j)
    {
        var time = j?.Time;
        if (time == null || string.IsNullOrEmpty(time.Logo)) return "";

        var src = System.Net.WebUtility.HtmlEncode(time.Logo);
        var nome = System.Net.WebUtility.HtmlEncode(time.Nome);
        return $"<img class=\"pdz-jl-escudo\" src=\"{src}\" alt=\"{nome}\" title=\"{nome}\" loading=\"lazy\" />";
    }
}

@* Um lado da partida: rostos e nomes, CADA JOGADOR clicável pro perfil dele.
   O link existia no cartão antigo e se perdeu quando a linha foi compactada — o nome
   virou texto puro. É o caminho de sempre pra ver o histórico de quem vai jogar, e some
   sem avisar: nada na tela indica que aquilo deixou de ser clicável. *@
@{
    Func<Padelizou.Models.Dupla, Microsoft.AspNetCore.Html.IHtmlContent> LadoDaDupla = d =>
    {
        var html = new Microsoft.AspNetCore.Html.HtmlContentBuilder();

        if (d == null)
        {
            html.AppendHtml("<span class=\"pdz-jl-nome text-muted\">A definir</span>");
            return html;
        }

        if (d.EhTime)
        {
            html.AppendHtml("<span class=\"pdz-jl-rostos\"><span class=\"pdz-jl-rosto pdz-jl-rosto-time\"><i class=\"bi bi-people-fill\"></i></span></span>");
            html.AppendHtml("<span class=\"pdz-jl-nome\">").Append(d.NomeTime ?? "Time").AppendHtml("</span>");
            return html;
        }

        // ⚠️ O SEGUNDO ROSTO SÓ EXISTE SE HOUVER SEGUNDA PESSOA (09/09/2026). Com a inscrição
        // sozinha entrando na chave, `Foto(null)` devolvia o avatar padrão e a dupla incompleta
        // aparecia com DUAS caras — uma delas de ninguém.
        html.AppendHtml($"<span class=\"pdz-jl-rostos\">"
            + $"<img class=\"pdz-jl-rosto\" src=\"{Foto(d.Jogador1)}\" alt=\"\" loading=\"lazy\" />"
            + (d.Jogador2 == null ? "" : $"<img class=\"pdz-jl-rosto\" src=\"{Foto(d.Jogador2)}\" alt=\"\" loading=\"lazy\" />")
            + "</span>");

        html.AppendHtml("<span class=\"pdz-jl-nome\">");
        html.AppendHtml($"<a href=\"/Jogadores/Perfil/{d.Jogador1Id}\">").Append(NomeCurto(d.Jogador1)).AppendHtml("</a>");
        html.AppendHtml(Escudo(d.Jogador1));
        html.AppendHtml("<span class=\"pdz-jl-barra\"> / </span>");

        if (d.Jogador2Id is int segundo)
        {
            html.AppendHtml($"<a href=\"/Jogadores/Perfil/{segundo}\">").Append(NomeCurto(d.Jogador2)).AppendHtml("</a>");
            html.AppendHtml(Escudo(d.Jogador2));
        }
        else
        {
            // Vaga de parceiro em aberto (09/09/2026): a inscrição sozinha entra na chave, então
            // esta lista passou a mostrá-la. "?" parecia dado corrompido; sem link porque não há
            // perfil pra abrir.
            html.Append("parceiro");
        }

        html.AppendHtml("</span>");
        return html;
    };
}

@* O ENDEREÇO do jogo na página: é pra cá que aponta o "Vencedor Quartas de Final 2" de uma
   linha projetada. Só faz sentido no mata-mata, que é onde o jogo tem número dentro da fase;
   jogo de grupo não é citado por ninguém. Ver Services/AncoraDoJogo. *@
@{
    var numeroDoJogo = (ViewData["NumeroNaFase"] as Dictionary<int, int>)
                       ?? (ViewBag.NumeroNaFase as Dictionary<int, int>);
    var ancora = numeroDoJogo != null && numeroDoJogo.TryGetValue(jogo.Id, out var meuNumero)
        ? Padelizou.Services.AncoraDoJogo.Id(jogo.Categoria.Nome, jogo.Fase, meuNumero)
        : null;
}
<div class="pdz-jl @(Model.Finalizada ? "pdz-jl-fim" : "")" id="@ancora">
    <div class="pdz-jl-cabecalho">
        <span class="pdz-jl-quando">
            @if (jogo.HorarioPrevisto is DateTime h)
            {
                <strong>@h.ToString("HH:mm")</strong>
                <span>@DiaDaSemana.Curto(h) @h.ToString("dd/MM")</span>
            }
            else
            {
                @* Torneio por ordem de liberação: não há hora, e inventar uma seria mentir. *@
                <strong>por ordem</strong>
            }

            @* COMEÇOU, TERMINOU E QUANTO DUROU, debaixo do horário previsto (Felipe,
               11/09/2026: "coloque também o tempo de duração da partida, em baixo do horario
               previsto (...) mas nao pode ocupar muito a tela, nao podemos poluir muito").

               ⚠️ É também o que torna LEGÍVEL a ordem das Finalizadas: a lista é ordenada pelo
               fim real, e o card mostrava só o horário PREVISTO — quem varria a tela lia
               "21:20 · 20:30 · 22:05" e concluía que a ordem tinha quebrado. Ver
               Services/DuracaoDoJogo, que é a mesma régua dos dois.

               Uma linha de ~20 caracteres em .7rem, e NULA no jogo que não entrou em quadra:
               a lista de Agendadas, que usa este mesmo card, não ganha nada. *@
            @if (Padelizou.Services.DuracaoDoJogo.Rotulo(jogo) is { } duracao)
            {
                <span class="pdz-jl-durou">@duracao</span>
            }
        </span>

        <span class="pdz-jl-etiquetas">
            <span class="pdz-jl-etiqueta pdz-jl-categoria">@jogo.Categoria.Nome</span>
            @* Fase NUMERADA no mata-mata ("Quartas de Final 2"): é assim que os jogos que
               ainda vão acontecer citam este, e sem o número na etiqueta a referência
               "Vencedor Quartas de Final 2" não teria onde ser encontrada. Jogo de grupo não
               numera — o nome do grupo já identifica. *@
            @{
                var faseNaTela = jogo.Fase != "Final"
                                 && numeroDoJogo != null && numeroDoJogo.TryGetValue(jogo.Id, out var n)
                    ? $"{jogo.Fase} {n}"
                    : jogo.Fase;
            }
            <span class="pdz-jl-etiqueta pdz-jl-fase">@faseNaTela</span>
            @* ONDE É O JOGO — clube e quadra (Services/LugarDoJogo).
               ⚠️ A guarda é a ETIQUETA, e não `NomeQuadra`: jogo por ordem de chegada não tem
               quadra e MESMO ASSIM tem lugar. Perguntar pela quadra era o que fazia os 97
               jogos do 2º Etapa não dizerem uma palavra sobre onde (Felipe, 09/09/2026). *@
            @if (LugarDoJogo.Etiqueta(ViewData.Sedes(), jogo.NomeQuadra, jogo.CategoriaId, jogo.ClubeId) is { } ondeJoga)
            {
                <span class="pdz-jl-etiqueta pdz-jl-quadra"><i class="bi bi-geo-alt-fill"></i> @ondeJoga</span>
            }
            @* W.O.: sem este selo o jogo aparece como um 6x0 comum, e quem varre a lista
               depois não tem como saber que ninguém entrou em quadra — o placar é o mesmo
               de propósito (ver Services/EncerramentoPorWo). *@
            @if (Padelizou.Services.EncerramentoPorWo.Foi(jogo))
            {
                <span class="pdz-jl-etiqueta pdz-jl-wo" title="Alguém não compareceu — não contou pro Padelímetro">
                    <i class="bi bi-person-x-fill"></i> @Padelizou.Services.EncerramentoPorWo.Rotulo
                </span>
            }
        </span>

        @if (Model.EhOrganizador)
        {
            <span class="pdz-jl-acoes">
                @if (!Model.Finalizada)
                {
                    @* Verde, não vermelho: play vermelho é o botão do YouTube (lê como
                       "assistir") e vermelho é a cor do destrutivo no resto do site.

                       ⚠️ SEM QUADRA, O VERDE NÃO COMEÇA: ele PERGUNTA ONDE (11/09/2026). No "por
                       ordem de liberação" o jogo chega aqui sem lugar de propósito — quem joga é
                       quem a quadra que vagou chamar —, e dizer onde era custava voltar, achar o
                       jogo na lista e abrir o modal de mudar de quadra. Duas telas pra uma
                       decisão só, no minuto em que tem gente esperando em quadra.

                       Com quadra não há o que preencher, e formulário pra confirmar o que já
                       está decidido é atrito: cai na pergunta seca do confirmar.js. *@
                    @if (string.IsNullOrWhiteSpace(jogo.NomeQuadra))
                    {
                        <button type="button" class="btn btn-sm btn-success"
                                data-bs-toggle="modal" data-bs-target="#modalIniciarJogo"
                                data-jogo-id="@jogo.Id"
                                data-jogo-rotulo="@rotuloDoJogo"
                                data-jogo-link="@jogo.LinkTransmissao"
                                title="Começar o jogo" aria-label="Começar o jogo">
                            <i class="bi bi-play-fill"></i>
                        </button>
                    }
                    else
                    {
                        <form asp-controller="Partidas" asp-action="ColocarNoAr" asp-route-id="@jogo.Id" asp-route-voltarPara="@ViewData["TargetAction"]" method="post"
                              data-confirmar="O jogo entra AO VIVO na @jogo.NomeQuadra e o cronômetro começa a contar agora."
                              data-confirmar-titulo="Começar este jogo?"
                              data-confirmar-ok="Começar">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-success" title="Começar o jogo" aria-label="Começar o jogo">
                                <i class="bi bi-play-fill"></i>
                            </button>
                        </form>
                    }
                    <button type="button" class="btn btn-sm btn-outline-secondary"
                            data-bs-toggle="modal" data-bs-target="#modalTrocarHorario"
                            data-jogo-id="@jogo.Id"
                            data-jogo-rotulo="@rotuloDoJogo"
                            title="Trocar horário" aria-label="Trocar horário">
                        <i class="bi bi-arrow-left-right"></i>
                    </button>
                }
                @* Mudar SÓ a quadra. Trocar horário arrasta o slot inteiro (hora + quadra), e
                   quase nunca é o que se quer quando a quadra molha ou a final merece a do
                   meio. Vale também pro jogo EM QUADRA: é justamente aí que remanejar importa. *@
                @if (!Model.Finalizada)
                {
                    <button type="button" class="btn btn-sm btn-outline-secondary"
                            data-bs-toggle="modal" data-bs-target="#modalTrocarQuadra"
                            data-jogo-id="@jogo.Id"
                            data-jogo-quadra="@jogo.NomeQuadra"
                            data-jogo-rotulo="@rotuloDoJogo"
                            title="Mudar de quadra" aria-label="Mudar de quadra">
                        <i class="bi bi-geo-alt"></i>
                    </button>
                }
                @* DESFAZER o clique errado. De celular, no balcão, tocar no play do jogo de
                   baixo ou finalizar a partida errada acontece — e não tinha volta. *@
                @if (jogo.Status == "AoVivo")
                {
                    <form asp-controller="Partidas" asp-action="VoltarParaAgendado" asp-route-id="@jogo.Id" method="post"
                          data-confirmar="O jogo volta pra lista de agendados, com a mesma hora e a mesma quadra. O placar em tela é zerado."
                          data-confirmar-titulo="Tirar da quadra?"
                          data-confirmar-ok="Voltar pra agendado">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-secondary"
                                title="Voltar pra agendado" aria-label="Voltar pra agendado">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </button>
                    </form>
                }
                else if (Model.Finalizada)
                {
                    <form asp-controller="Partidas" asp-action="ReabrirPartida" asp-route-id="@jogo.Id" method="post"
                          data-confirmar="O jogo volta pra AO VIVO e o resultado deixa de valer: o Padelímetro é desfeito e a fase seguinte, se tiver nascido deste resultado, é apagada e montada de novo quando você confirmar. Se a fase seguinte já começou, o sistema recusa."
                          data-confirmar-titulo="Reabrir este jogo?"
                          data-confirmar-ok="Reabrir">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-secondary"
                                title="Reabrir (voltar pra ao vivo)" aria-label="Reabrir (voltar pra ao vivo)">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </button>
                    </form>
                }
                <a asp-controller="Partidas" asp-action="ControlePlacar" asp-route-id="@jogo.Id" asp-route-voltarPara="@(ViewData["TargetAction"] as string)"
                   class="btn btn-sm btn-outline-secondary"
                   title="@(Model.Finalizada ? "Corrigir placar" : "Marcar placar")"
                   aria-label="@(Model.Finalizada ? "Corrigir placar" : "Marcar placar")">
                    <i class="bi bi-pencil"></i>
                </a>
                @* ⋯ — o relógio (definir horário na mão) e as setas ↑↓ moram aqui desde
                   10/09/2026 (🗣️ *"tira o ⇄ e o relogio pra um menu ⋯"*, depois corrigido pra
                   *"relogio e as setas"*). Fica por ÚLTIMO na barra, que é onde todo mundo
                   procura um ⋯, e só enquanto o jogo não acabou: em jogo finalizado não há
                   horário pra marcar nem linha pra subir.

                   ⚠️ As setas SÓ em jogo agendado — mover quem está em quadra seria reescrever
                   o que está acontecendo. O menu continua existindo no AO VIVO por causa do
                   relógio, e é por isso que a decisão vem daqui e não de dentro da partial. *@
                @if (!Model.Finalizada)
                {
                    <partial name="_MenuDoJogo" model="(jogo.TorneioId, referenciaDoJogo, voltarParaAqui, horarioDoJogoNoInput, rotuloDoJogo, ehAgendado)" />
                }
            </span>
        }
        else if (podeMarcarSemSerDaMesa)
        {
            <span class="pdz-jl-acoes">
                @if (!Model.Finalizada)
                {
                    @* O mesmo play do organizador: dar a largada no próprio jogo faz parte
                       de marcar o placar quando o torneio abriu essa porta. *@
                    <form asp-controller="Partidas" asp-action="ColocarNoAr" asp-route-id="@jogo.Id" asp-route-voltarPara="@ViewData["TargetAction"]" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-success" title="Começar o jogo" aria-label="Começar o jogo">
                            <i class="bi bi-play-fill"></i>
                        </button>
                    </form>
                }
                <a asp-controller="Partidas" asp-action="ControlePlacar" asp-route-id="@jogo.Id" asp-route-voltarPara="@(ViewData["TargetAction"] as string)"
                   class="btn btn-sm btn-outline-secondary"
                   title="@(Model.Finalizada ? "Corrigir placar" : "Marcar placar")"
                   aria-label="@(Model.Finalizada ? "Corrigir placar" : "Marcar placar")">
                    <i class="bi bi-pencil"></i>
                </a>
                @if (Model.Finalizada && !string.IsNullOrEmpty(jogo.LinkTransmissao))
                {
                    <a href="@jogo.LinkTransmissao" target="_blank" rel="noopener"
                       class="btn btn-sm btn-outline-secondary" title="Assistir" aria-label="Assistir">
                        <i class="bi bi-play-btn"></i>
                    </a>
                }
            </span>
        }
        else if (Model.Finalizada && !string.IsNullOrEmpty(jogo.LinkTransmissao))
        {
            <span class="pdz-jl-acoes">
                <a href="@jogo.LinkTransmissao" target="_blank" rel="noopener"
                   class="btn btn-sm btn-outline-secondary" title="Assistir" aria-label="Assistir">
                    <i class="bi bi-play-btn"></i>
                </a>
            </span>
        }
    </div>

    @* As duas duplas EMPILHADAS, uma por linha, em qualquer tamanho de tela.
       Lado a lado só cabia no desktop, e mesmo lá o "×" no meio fazia o olho ir e voltar
       pra ler o confronto. Empilhado, cada dupla é uma linha com rosto, nome e — quando há
       palpitômetro — a PORCENTAGEM DELA na ponta: assim o número aponta pra uma dupla, em
       vez de o leitor ter que adivinhar se os 100% da esquerda são de quem está em cima.

       O container do palpitômetro abraça as duas linhas + a barra porque o JS que vota e
       atualiza procura os data-pct DENTRO dele (wwwroot/js/palpitometro.js). *@
    @* ⚠️ `pdz-palpite-linha` NÃO é decoração: é a marca que diz ao JS que esta é a versão
       EM LINHA do palpitômetro. Sem ela, o atualizarPalpitometro cai no comportamento do
       cartão grande — carimba a setinha e ESCONDE o lado perdedor. Na linha isso apagava uma
       das duas porcentagens depois do voto, e como a porcentagem é o próprio botão, sumia
       junto o único jeito de trocar de opinião. Ver wwwroot/js/palpitometro.js. *@
    @{
        int? meuVencedor = r != null && r.PalpiteiOPlacar ? Math.Max(r.MeuPlacarLado1!.Value, r.MeuPlacarLado2!.Value) : null;
        int? meuPerdedor = r != null && r.PalpiteiOPlacar ? Math.Min(r.MeuPlacarLado1!.Value, r.MeuPlacarLado2!.Value) : null;
        string moedaDoPlacar = r != null && r.PlacarEmSets ? "sets" : "games";
    }
    <div class="pdz-jl-corpo @(mostraPalpitometro ? "pdz-palpitometro pdz-palpite-linha" : "") @(temPalpite ? "" : "pdz-palpite-vazio")"
         @(mostraPalpitometro ? Html.Raw($"data-partida-id=\"{jogo.Id}\" data-dupla1-id=\"{jogo.Dupla1Id}\" data-meu-voto=\"{r?.MeuVotoDuplaId}\"") : null)>

        @if (mostraPalpitometro)
        {
            @* O rótulo fica em cima da COLUNA de porcentagens, não numa linha própria
               embaixo: ali ele nomeia os números que estão logo abaixo dele, e a linha
               extra some. Antes era um rodapé com rótulo, barra e votos — três coisas
               ocupando uma altura inteira pra dizer o que os dois números já dizem. *@
            <div class="pdz-jl-palpite-topo">
                <span class="pdz-palpite-rotulo">
                    <i class="bi bi-graph-up"></i> PALPITÔMETRO
                    <span class="pdz-palpite-ajuda">
                        @if (Model.Finalizada)
                        {
                            <text>· como a galera palpitou</text>
                        }
                        else if (podeVotar)
                        {
                            <text>· toque na % pra votar</text>
                        }
                        else if (!Model.MeuId.HasValue)
                        {
                            <a asp-controller="Auth" asp-action="Login">· entre pra palpitar</a>
                        }
                    </span>
                    @* "Ver quem votou" existia só no cartão grande. Na lista o palpitômetro
                       virava um número anônimo — e metade da graça dele é justamente saber
                       QUEM apostou contra você. Vale nas agendadas e nas finalizadas: depois
                       do jogo é que se cobra quem errou o palpite. *@
                    @if (temPalpite)
                    {
                        <button type="button" class="pdz-ver-votos"
                                data-partida-id="@jogo.Id"
                                data-nome1="@NomeDaDupla(jogo.Dupla1)"
                                data-nome2="@NomeDaDupla(jogo.Dupla2)"
                                onclick="verVotos(this.dataset.partidaId, this.dataset.nome1, this.dataset.nome2)">
                            · <span class="pdz-total-votos">@r!.TotalVotos voto(s)</span>
                        </button>
                    }
                    else
                    {
                        <span class="pdz-total-votos">· 0 voto(s)</span>
                    }
                    @* RETIRAR (10/09/2026 — 🗣️ *"tambem permita retirar o palpite colocado"*).
                       Só pra quem pode votar: a janela de retirar é a MESMA de palpitar, e o
                       servidor recusa depois que o jogo começa. Nasce escondido pra quem ainda
                       não palpitou, e o JS mostra/esconde sozinho a cada palpite — sem F5. *@
                    @if (podeVotar)
                    {
                        <button type="button" class="pdz-ver-votos pdz-retirar-palpite"
                                title="Retirar meu palpite" onclick="retirarPalpite(this)"
                                hidden="@(r?.MeuVotoDuplaId == null)">
                            · <span class="text-danger">retirar</span>
                        </button>
                    }
                </span>
            </div>
        }

        <div class="pdz-jl-dupla @(venceu1 ? "pdz-jl-venceu" : venceu2 ? "pdz-jl-perdeu" : "")">
            @* A BOLINHA VEM ANTES DOS ROSTOS, na ponta esquerda: é assim que as duas viram uma
               coluna que se varre de cima a baixo, como na tela de Check-in. Do outro lado ela
               brigaria com a porcentagem do palpitômetro, que já mora na direita. *@
            @if (bolinhaDoCheckIn)
            {
                <partial name="_BotaoDoCheckIn" model="(jogo.Dupla1, true, voltarParaAqui)" />
            }
            @LadoDaDupla(jogo.Dupla1)
            @if (sacandoAgora == jogo.Dupla1Id)
            {
                <span class="pdz-bolinha" title="Sacando"></span>
            }
            @if (Model.Finalizada)
            {
                <span class="pdz-jl-games">@g1</span>
            }
            @if (mostraPalpitometro)
            {
                <span class="pdz-palpite-pct text-success @(r?.MeuVotoDuplaId == jogo.Dupla1Id ? "pdz-palpite-meu" : "") @(podeVotar ? "votavel" : "")"
                      data-pct="1" data-dupla-id="@jogo.Dupla1Id" data-votavel="@podeVotar.ToString().ToLower()"
                      onclick="votarPalpite(this)">@pct1%</span>
            }
        </div>

        <div class="pdz-jl-dupla @(venceu2 ? "pdz-jl-venceu" : venceu1 ? "pdz-jl-perdeu" : "")">
            @if (bolinhaDoCheckIn)
            {
                <partial name="_BotaoDoCheckIn" model="(jogo.Dupla2, true, voltarParaAqui)" />
            }
            @LadoDaDupla(jogo.Dupla2)
            @if (sacandoAgora == jogo.Dupla2Id)
            {
                <span class="pdz-bolinha" title="Sacando"></span>
            }
            @if (Model.Finalizada)
            {
                <span class="pdz-jl-games">@g2</span>
            }
            @if (mostraPalpitometro)
            {
                <span class="pdz-palpite-pct text-primary @(r?.MeuVotoDuplaId == jogo.Dupla2Id ? "pdz-palpite-meu" : "") @(podeVotar ? "votavel" : "")"
                      data-pct="2" data-dupla-id="@jogo.Dupla2Id" data-votavel="@podeVotar.ToString().ToLower()"
                      onclick="votarPalpite(this)">@pct2%</span>
            }
        </div>

        @* ── O PLACAR (mesmo bloco do cartão grande — ver _Palpitometro.cshtml) ──────────
           Só aparece DEPOIS do voto e é OPCIONAL: palpitar continua sendo um toque no nome,
           e quem quiser dá o segundo escolhendo a ficha. *@
        @if (podeVotar && r != null && r.PlacaresDoFormato.Count > 0)
        {
            <div class="pdz-palpite-placar mt-1" style="display: @(r.MeuVotoDuplaId != null ? "block" : "none");">
                @* ⚠️ DEPOIS DE ESCOLHER, AS FICHAS SE RECOLHEM (11/09/2026). 🗣️ Felipe, num print do
                   cartão com as nove fichas ainda abertas debaixo do palpite dele: *"acho que tambem
                   podemos 'minimizar' os placares depois de votado, pra nao ficar poluindo a tela"*.
                   Numa lista de 97 jogos, cada cartão votado carregava uma fileira inteira que já
                   cumpriu o papel dela.
                   ⚠️ Quem decide qual dos dois nasce aberto é o DADO (`PalpiteiOPlacar`), e não o JS
                   depois de carregar: senão a tela piscaria a fileira inteira a cada F5. *@
@* ⚠️ SEM `d-flex` (visto no navegador, 11/09/2026): as utilitárias do Bootstrap são
                   `!important`, e `.d-flex` ganha do `style.display = 'none'` que o JS escreve — o
                   resumo ficava na tela ao lado das fichas reabertas. O `flex` vem do próprio
                   `style`, que é o mesmo lugar de onde ele some. *@
                <div class="pdz-palpite-placar-resumo small text-muted align-items-center gap-2"
                     style="display: @(r.PalpiteiOPlacar ? "flex" : "none");">
                    <span>Seu palpite: <strong class="pdz-resumo-placar">@meuVencedor x @meuPerdedor</strong></span>
                    <button type="button" class="btn btn-link btn-sm p-0 pdz-trocar-placar"
                            onclick="trocarPlacar(this)">trocar</button>
                </div>

                <div class="pdz-palpite-fichas" style="display: @(r.PalpiteiOPlacar ? "none" : "block");">
                    <div class="small text-muted mb-1">
                        E o placar? <span class="text-body-secondary">(em @moedaDoPlacar, de quem você acha que vence)</span>
                    </div>
                    <div class="d-flex flex-wrap gap-1">
                        @foreach (var placar in r.PlacaresDoFormato)
                        {
                            bool escolhida = meuVencedor == placar.Vencedor && meuPerdedor == placar.Perdedor;
                            <button type="button"
                                    class="btn btn-sm rounded-pill py-0 px-2 pdz-ficha-placar @(escolhida ? "btn-success" : "btn-outline-secondary")"
                                    data-vencedor="@placar.Vencedor" data-perdedor="@placar.Perdedor"
                                    onclick="palpitarPlacar(this)">@placar.Vencedor x @placar.Perdedor</button>
                        }
                    </div>
                </div>
            </div>
        }

        @* ⚠️ SEM `@if`: a linha NASCE na página, escondida quando ainda não há leitura da galera
           (o mesmo desenho do cartão grande). Com o limiar de dois palpites no mesmo placar, o
           caso mais comum de ela passar a existir é o SEU palpite formando o par — e o
           `atualizarPalpitometro` só sabe mostrar um elemento que já está no DOM. Gerada por
           `@if`, a leitura da galera só apareceria no F5. *@
        @if (mostraPalpitometro)
        {
            @* 🗣️ Felipe, 10/09/2026, com esta frase marcada num print: *"tambem permita clicar
               e ver quem colocou o palpitometro e qual o placar"*. Ela é o lugar mais natural
               pra perguntar "quem foi que cravou?", e era texto morto — o único caminho pro
               modal era o "N voto(s)" lá em cima.
               ⚠️ O `div` externo CONTINUA sendo o `pdz-palpite-consenso`: é ele que o JS acha
               pra mostrar/esconder e pra reescrever o placar depois do voto. O botão vai por
               dentro, senão o `style.display` do JS mandaria no botão e não na linha. *@
            <div class="mt-1 small text-muted pdz-palpite-consenso"
                 style="display: @(r != null && r.TemPlacarMaisPalpitado ? "block" : "none");">
                <button type="button" class="pdz-ver-votos"
                        data-partida-id="@jogo.Id"
                        data-nome1="@NomeDaDupla(jogo.Dupla1)"
                        data-nome2="@NomeDaDupla(jogo.Dupla2)"
                        title="Ver quem palpitou e o placar de cada um"
                        onclick="verVotos(this.dataset.partidaId, this.dataset.nome1, this.dataset.nome2)">
                    <i class="bi bi-people"></i>
                    @* ⚠️ `r?.` e não `r!.`: agora que a linha nasce escondida, ela é desenhada
                       também no jogo sem palpite nenhum (`r` nulo). Os números ficam vazios, e
                       quem os escreve na hora de mostrar é o JS. *@
                    Placar mais palpitado: <strong class="pdz-consenso-placar">@r?.PlacarMaisPalpitadoLado1 x @r?.PlacarMaisPalpitadoLado2</strong>
                    <span class="pdz-consenso-votos">(@(r?.PlacarMaisPalpitadoVotos ?? 0) de @(r?.PalpitesComPlacar ?? 0))</span>
                </button>
            </div>
        }

        @if (Model.Finalizada && r != null && r.CravaramOPlacar.Count > 0)
        {
            <div class="mt-1 small text-success fw-semibold">
                <i class="bi bi-bullseye"></i>
                @(r.CravaramOPlacar.Count == 1 ? "Cravou o placar:" : "Cravaram o placar:")
                @string.Join(", ", r.CravaramOPlacar)
            </div>
        }

    </div>
</div>
