@model (Padelizou.Models.Partida Jogo, bool EhOrganizador, bool Finalizada, Padelizou.ViewModels.PalpiteResumoVM? Palpites, int? MeuId)
@*
    Um jogo na lista de Agendadas / Finalizadas.

    Três perguntas se responde aqui, e a linha antiga respondia mal duas delas: QUEM joga
    (só o nome, sem rosto — numa lista de 47 jogos ninguém acha o seu), QUANDO e ONDE
    (categoria, fase e quadra saíam como um risco de texto cinza de 11px, o mesmo peso do
    resto). Agora: rosto junto do nome, e categoria/fase/quadra como etiquetas na primeira
    linha, que é onde o olho bate primeiro.

    O cartão grande (placar gigante, cronômetro) continua sendo do AO VIVO — ali a tela tem
    um assunto só. Aqui é lista, e lista se varre.
*@
@{
    var jogo = Model.Jogo;
    var g1 = jogo.GamesDupla1 ?? 0;
    var g2 = jogo.GamesDupla2 ?? 0;
    var venceu1 = Model.Finalizada && g1 > g2;
    var venceu2 = Model.Finalizada && g2 > g1;

    var r = Model.Palpites;
    bool temPalpite = r != null && r.TotalVotos > 0;
    bool podeVotar = jogo.Status == "Agendada" && Model.MeuId.HasValue;

    // O palpitrômetro aparece em TODO jogo que ainda vai acontecer, com ou sem voto, e nos
    // que acabaram só se alguém palpitou (aí ele é histórico).
    //
    // Antes ele dependia de haver voto OU de estar logado — e o resultado era uma lista
    // salpicada, com o bloco aparecendo em dois jogos e sumindo em dez, do lado de jogos
    // idênticos. Quem visita deslogado é justamente quem ainda pode virar usuário: ver a
    // barra e o convite pra entrar é o convite; ver nada não convida ninguém.
    bool mostraPalpitrometro = temPalpite || jogo.Status == "Agendada";

    // NOME E SOBRENOME, não só o primeiro nome (Felipe, 08/08/2026): "aqui no americano está
    // difícil de entender quem é quem".
    //
    // ⚠️ No Americano o primeiro nome não identifica ninguém, e isso é estrutural do formato:
    // as MESMAS dez pessoas se repetem em dezenas de linhas, embaralhadas em duplas novas a
    // cada rodada. No primeiro Americano real havia duas Carolines e duas Natálias — a lista
    // inteira virava adivinhação. Num torneio de chave dava pra viver com o primeiro nome
    // porque cada dupla aparece poucas vezes; aqui não dá.
    //
    // `NomeBonito.Curto` é a MESMA régua do chip do jogador e da tabela de classificação
    // (primeiro + último sobrenome, partícula e "Junior" tratados) — cortar no primeiro espaço
    // era a segunda cópia da regra, e a que estava errada.
    string NomeCurto(Padelizou.Models.Jogador? j) =>
        j == null ? "?" : Padelizou.Services.NomeBonito.Curto(j.Nome);

    // Nome da dupla em texto puro — o modal "quem votou" recebe por atributo, então aqui
    // não pode vir marcação.
    string NomeDaDupla(Padelizou.Models.Dupla? d) =>
        d == null ? "A definir"
        : d.EhTime ? (d.NomeTime ?? "Time")
        : $"{NomeCurto(d.Jogador1)} / {NomeCurto(d.Jogador2)}";

    int pct1 = temPalpite ? (int)Math.Round(r!.PercentualDupla1) : 50;
    int pct2 = temPalpite ? (int)Math.Round(r!.PercentualDupla2) : 50;

    // A bolinha do saque só em jogo EM QUADRA. Ela responde "quem está sacando AGORA" —
    // numa partida agendada não há saque nenhum, e o campo pode vir preenchido de um
    // "colocar no ar" desfeito ou de um placar corrigido depois. Em jogo finalizado ela
    // também não diz nada: quem sacava no último ponto é trivia, não informação.
    int? sacandoAgora = jogo.Status == "AoVivo" ? jogo.DuplaSacandoId : null;
}

@* Os rostos da dupla, sobrepostos. É o que faz alguém achar o próprio jogo varrendo a
   lista — nome sozinho, numa tela de 47 jogos, obriga a ler tudo. Time entra com um ícone
   só: lá não são duas pessoas, é uma equipe. *@
@functions {
    private static string Foto(Padelizou.Models.Jogador? j) =>
        string.IsNullOrEmpty(j?.FotoPerfil) ? "/img/default-avatar.png" : j!.FotoPerfil!;
}

@* Um lado da partida: rostos e nomes, CADA JOGADOR clicável pro perfil dele.
   O link existia no cartão antigo e se perdeu quando a linha foi compactada — o nome
   virou texto puro. É o caminho de sempre pra ver o histórico de quem vai jogar, e some
   sem avisar: nada na tela indica que aquilo deixou de ser clicável. *@
@{
    Func<Padelizou.Models.Dupla, Microsoft.AspNetCore.Html.IHtmlContent> LadoDaDupla = d =>
    {
        var html = new Microsoft.AspNetCore.Html.HtmlContentBuilder();

        if (d == null)
        {
            html.AppendHtml("<span class=\"pdz-jl-nome text-muted\">A definir</span>");
            return html;
        }

        if (d.EhTime)
        {
            html.AppendHtml("<span class=\"pdz-jl-rostos\"><span class=\"pdz-jl-rosto pdz-jl-rosto-time\"><i class=\"bi bi-people-fill\"></i></span></span>");
            html.AppendHtml("<span class=\"pdz-jl-nome\">").Append(d.NomeTime ?? "Time").AppendHtml("</span>");
            return html;
        }

        html.AppendHtml($"<span class=\"pdz-jl-rostos\">"
            + $"<img class=\"pdz-jl-rosto\" src=\"{Foto(d.Jogador1)}\" alt=\"\" loading=\"lazy\" />"
            + $"<img class=\"pdz-jl-rosto\" src=\"{Foto(d.Jogador2)}\" alt=\"\" loading=\"lazy\" />"
            + "</span>");

        html.AppendHtml("<span class=\"pdz-jl-nome\">");
        html.AppendHtml($"<a href=\"/Jogadores/Perfil/{d.Jogador1Id}\">").Append(NomeCurto(d.Jogador1)).AppendHtml("</a>");
        html.AppendHtml("<span class=\"pdz-jl-barra\"> / </span>");

        if (d.Jogador2Id is int segundo)
        {
            html.AppendHtml($"<a href=\"/Jogadores/Perfil/{segundo}\">").Append(NomeCurto(d.Jogador2)).AppendHtml("</a>");
        }
        else
        {
            html.Append("?");
        }

        html.AppendHtml("</span>");
        return html;
    };
}

@* O ENDEREÇO do jogo na página: é pra cá que aponta o "Vencedor Quartas de Final 2" de uma
   linha projetada. Só faz sentido no mata-mata, que é onde o jogo tem número dentro da fase;
   jogo de grupo não é citado por ninguém. Ver Services/AncoraDoJogo. *@
@{
    var numeroDoJogo = (ViewData["NumeroNaFase"] as Dictionary<int, int>)
                       ?? (ViewBag.NumeroNaFase as Dictionary<int, int>);
    var ancora = numeroDoJogo != null && numeroDoJogo.TryGetValue(jogo.Id, out var meuNumero)
        ? Padelizou.Services.AncoraDoJogo.Id(jogo.Categoria.Nome, jogo.Fase, meuNumero)
        : null;
}
<div class="pdz-jl @(Model.Finalizada ? "pdz-jl-fim" : "")" id="@ancora">
    <div class="pdz-jl-cabecalho">
        <span class="pdz-jl-quando">
            @if (jogo.HorarioPrevisto is DateTime h)
            {
                <strong>@h.ToString("HH:mm")</strong>
                <span>@h.ToString("dd/MM")</span>
            }
            else
            {
                @* Torneio por ordem de liberação: não há hora, e inventar uma seria mentir. *@
                <strong>por ordem</strong>
            }
        </span>

        <span class="pdz-jl-etiquetas">
            <span class="pdz-jl-etiqueta pdz-jl-categoria">@jogo.Categoria.Nome</span>
            @* Fase NUMERADA no mata-mata ("Quartas de Final 2"): é assim que os jogos que
               ainda vão acontecer citam este, e sem o número na etiqueta a referência
               "Vencedor Quartas de Final 2" não teria onde ser encontrada. Jogo de grupo não
               numera — o nome do grupo já identifica. *@
            @{
                var faseNaTela = jogo.Fase != "Final"
                                 && numeroDoJogo != null && numeroDoJogo.TryGetValue(jogo.Id, out var n)
                    ? $"{jogo.Fase} {n}"
                    : jogo.Fase;
            }
            <span class="pdz-jl-etiqueta pdz-jl-fase">@faseNaTela</span>
            @if (!string.IsNullOrEmpty(jogo.NomeQuadra))
            {
                <span class="pdz-jl-etiqueta pdz-jl-quadra"><i class="bi bi-geo-alt-fill"></i> @LugarDoJogo.Etiqueta(ViewData.Sedes(), jogo.NomeQuadra)</span>
            }
            @* W.O.: sem este selo o jogo aparece como um 6x0 comum, e quem varre a lista
               depois não tem como saber que ninguém entrou em quadra — o placar é o mesmo
               de propósito (ver Services/EncerramentoPorWo). *@
            @if (Padelizou.Services.EncerramentoPorWo.Foi(jogo))
            {
                <span class="pdz-jl-etiqueta pdz-jl-wo" title="Alguém não compareceu — não contou pro Padelímetro">
                    <i class="bi bi-person-x-fill"></i> @Padelizou.Services.EncerramentoPorWo.Rotulo
                </span>
            }
        </span>

        @if (Model.EhOrganizador)
        {
            <span class="pdz-jl-acoes">
                @if (!Model.Finalizada)
                {
                    @* Verde, não vermelho: play vermelho é o botão do YouTube (lê como
                       "assistir") e vermelho é a cor do destrutivo no resto do site. *@
                    <form asp-controller="Partidas" asp-action="ColocarNoAr" asp-route-id="@jogo.Id" asp-route-voltarPara="@ViewData["TargetAction"]" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-success" title="Começar o jogo" aria-label="Começar o jogo">
                            <i class="bi bi-play-fill"></i>
                        </button>
                    </form>
                    <button type="button" class="btn btn-sm btn-outline-secondary"
                            data-bs-toggle="modal" data-bs-target="#modalTrocarHorario"
                            data-jogo-id="@jogo.Id"
                            data-jogo-rotulo="@jogo.Codigo · @(jogo.HorarioPrevisto?.ToString("dd/MM HH:mm") ?? "sem horário") · @jogo.Dupla1.NomeDeExibicao x @jogo.Dupla2.NomeDeExibicao"
                            title="Trocar horário" aria-label="Trocar horário">
                        <i class="bi bi-arrow-left-right"></i>
                    </button>
                }
                @* Mudar SÓ a quadra. Trocar horário arrasta o slot inteiro (hora + quadra), e
                   quase nunca é o que se quer quando a quadra molha ou a final merece a do
                   meio. Vale também pro jogo EM QUADRA: é justamente aí que remanejar importa. *@
                @if (!Model.Finalizada)
                {
                    <button type="button" class="btn btn-sm btn-outline-secondary"
                            data-bs-toggle="modal" data-bs-target="#modalTrocarQuadra"
                            data-jogo-id="@jogo.Id"
                            data-jogo-quadra="@jogo.NomeQuadra"
                            data-jogo-rotulo="@jogo.Codigo · @(jogo.HorarioPrevisto?.ToString("dd/MM HH:mm") ?? "sem horário") · @jogo.Dupla1.NomeDeExibicao x @jogo.Dupla2.NomeDeExibicao"
                            title="Mudar de quadra" aria-label="Mudar de quadra">
                        <i class="bi bi-geo-alt"></i>
                    </button>
                }
                @* DESFAZER o clique errado. De celular, no balcão, tocar no play do jogo de
                   baixo ou finalizar a partida errada acontece — e não tinha volta. *@
                @if (jogo.Status == "AoVivo")
                {
                    <form asp-controller="Partidas" asp-action="VoltarParaAgendado" asp-route-id="@jogo.Id" method="post"
                          data-confirmar="O jogo volta pra lista de agendados, com a mesma hora e a mesma quadra. O placar em tela é zerado."
                          data-confirmar-titulo="Tirar da quadra?"
                          data-confirmar-ok="Voltar pra agendado">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-secondary"
                                title="Voltar pra agendado" aria-label="Voltar pra agendado">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </button>
                    </form>
                }
                else if (Model.Finalizada)
                {
                    <form asp-controller="Partidas" asp-action="ReabrirPartida" asp-route-id="@jogo.Id" method="post"
                          data-confirmar="O jogo volta pra AO VIVO e o resultado deixa de valer: o Padelímetro é desfeito e a fase seguinte, se tiver nascido deste resultado, é apagada e montada de novo quando você confirmar. Se a fase seguinte já começou, o sistema recusa."
                          data-confirmar-titulo="Reabrir este jogo?"
                          data-confirmar-ok="Reabrir">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-secondary"
                                title="Reabrir (voltar pra ao vivo)" aria-label="Reabrir (voltar pra ao vivo)">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </button>
                    </form>
                }
                <a asp-controller="Partidas" asp-action="ControlePlacar" asp-route-id="@jogo.Id" asp-route-voltarPara="@(ViewData["TargetAction"] as string)"
                   class="btn btn-sm btn-outline-secondary"
                   title="@(Model.Finalizada ? "Corrigir placar" : "Marcar placar")"
                   aria-label="@(Model.Finalizada ? "Corrigir placar" : "Marcar placar")">
                    <i class="bi bi-pencil"></i>
                </a>
            </span>
        }
        else if (Model.Finalizada && !string.IsNullOrEmpty(jogo.LinkTransmissao))
        {
            <span class="pdz-jl-acoes">
                <a href="@jogo.LinkTransmissao" target="_blank" rel="noopener"
                   class="btn btn-sm btn-outline-secondary" title="Assistir" aria-label="Assistir">
                    <i class="bi bi-play-btn"></i>
                </a>
            </span>
        }
    </div>

    @* As duas duplas EMPILHADAS, uma por linha, em qualquer tamanho de tela.
       Lado a lado só cabia no desktop, e mesmo lá o "×" no meio fazia o olho ir e voltar
       pra ler o confronto. Empilhado, cada dupla é uma linha com rosto, nome e — quando há
       palpitrômetro — a PORCENTAGEM DELA na ponta: assim o número aponta pra uma dupla, em
       vez de o leitor ter que adivinhar se os 100% da esquerda são de quem está em cima.

       O container do palpitrômetro abraça as duas linhas + a barra porque o JS que vota e
       atualiza procura os data-pct DENTRO dele (wwwroot/js/palpitrometro.js). *@
    @* ⚠️ `pdz-palpite-linha` NÃO é decoração: é a marca que diz ao JS que esta é a versão
       EM LINHA do palpitrômetro. Sem ela, o atualizarPalpitrometro cai no comportamento do
       cartão grande — carimba a setinha e ESCONDE o lado perdedor. Na linha isso apagava uma
       das duas porcentagens depois do voto, e como a porcentagem é o próprio botão, sumia
       junto o único jeito de trocar de opinião. Ver wwwroot/js/palpitrometro.js. *@
    @{
        int? meuVencedor = r != null && r.PalpiteiOPlacar ? Math.Max(r.MeuPlacarLado1!.Value, r.MeuPlacarLado2!.Value) : null;
        int? meuPerdedor = r != null && r.PalpiteiOPlacar ? Math.Min(r.MeuPlacarLado1!.Value, r.MeuPlacarLado2!.Value) : null;
        string moedaDoPlacar = r != null && r.PlacarEmSets ? "sets" : "games";
    }
    <div class="pdz-jl-corpo @(mostraPalpitrometro ? "pdz-palpitrometro pdz-palpite-linha" : "") @(temPalpite ? "" : "pdz-palpite-vazio")"
         @(mostraPalpitrometro ? Html.Raw($"data-partida-id=\"{jogo.Id}\" data-dupla1-id=\"{jogo.Dupla1Id}\" data-meu-voto=\"{r?.MeuVotoDuplaId}\"") : null)>

        @if (mostraPalpitrometro)
        {
            @* O rótulo fica em cima da COLUNA de porcentagens, não numa linha própria
               embaixo: ali ele nomeia os números que estão logo abaixo dele, e a linha
               extra some. Antes era um rodapé com rótulo, barra e votos — três coisas
               ocupando uma altura inteira pra dizer o que os dois números já dizem. *@
            <div class="pdz-jl-palpite-topo">
                <span class="pdz-palpite-rotulo">
                    <i class="bi bi-graph-up"></i> PALPITRÔMETRO
                    <span class="pdz-palpite-ajuda">
                        @if (Model.Finalizada)
                        {
                            <text>· como a galera palpitou</text>
                        }
                        else if (podeVotar)
                        {
                            <text>· toque na % pra votar</text>
                        }
                        else if (!Model.MeuId.HasValue)
                        {
                            <a asp-controller="Auth" asp-action="Login">· entre pra palpitar</a>
                        }
                    </span>
                    @* "Ver quem votou" existia só no cartão grande. Na lista o palpitrômetro
                       virava um número anônimo — e metade da graça dele é justamente saber
                       QUEM apostou contra você. Vale nas agendadas e nas finalizadas: depois
                       do jogo é que se cobra quem errou o palpite. *@
                    @if (temPalpite)
                    {
                        <button type="button" class="pdz-ver-votos"
                                data-partida-id="@jogo.Id"
                                data-nome1="@NomeDaDupla(jogo.Dupla1)"
                                data-nome2="@NomeDaDupla(jogo.Dupla2)"
                                onclick="verVotos(this.dataset.partidaId, this.dataset.nome1, this.dataset.nome2)">
                            · <span class="pdz-total-votos">@r!.TotalVotos voto(s)</span>
                        </button>
                    }
                    else
                    {
                        <span class="pdz-total-votos">· 0 voto(s)</span>
                    }
                </span>
            </div>
        }

        <div class="pdz-jl-dupla @(venceu1 ? "pdz-jl-venceu" : venceu2 ? "pdz-jl-perdeu" : "")">
            @LadoDaDupla(jogo.Dupla1)
            @if (sacandoAgora == jogo.Dupla1Id)
            {
                <span class="pdz-bolinha" title="Sacando"></span>
            }
            @if (Model.Finalizada)
            {
                <span class="pdz-jl-games">@g1</span>
            }
            @if (mostraPalpitrometro)
            {
                <span class="pdz-palpite-pct text-success @(r?.MeuVotoDuplaId == jogo.Dupla1Id ? "pdz-palpite-meu" : "") @(podeVotar ? "votavel" : "")"
                      data-pct="1" data-dupla-id="@jogo.Dupla1Id" data-votavel="@podeVotar.ToString().ToLower()"
                      onclick="votarPalpite(this)">@pct1%</span>
            }
        </div>

        <div class="pdz-jl-dupla @(venceu2 ? "pdz-jl-venceu" : venceu1 ? "pdz-jl-perdeu" : "")">
            @LadoDaDupla(jogo.Dupla2)
            @if (sacandoAgora == jogo.Dupla2Id)
            {
                <span class="pdz-bolinha" title="Sacando"></span>
            }
            @if (Model.Finalizada)
            {
                <span class="pdz-jl-games">@g2</span>
            }
            @if (mostraPalpitrometro)
            {
                <span class="pdz-palpite-pct text-primary @(r?.MeuVotoDuplaId == jogo.Dupla2Id ? "pdz-palpite-meu" : "") @(podeVotar ? "votavel" : "")"
                      data-pct="2" data-dupla-id="@jogo.Dupla2Id" data-votavel="@podeVotar.ToString().ToLower()"
                      onclick="votarPalpite(this)">@pct2%</span>
            }
        </div>

        @* ── O PLACAR (mesmo bloco do cartão grande — ver _Palpitrometro.cshtml) ──────────
           Só aparece DEPOIS do voto e é OPCIONAL: palpitar continua sendo um toque no nome,
           e quem quiser dá o segundo escolhendo a ficha. *@
        @if (podeVotar && r != null && r.PlacaresDoFormato.Count > 0)
        {
            <div class="pdz-palpite-placar mt-1" style="display: @(r.MeuVotoDuplaId != null ? "block" : "none");">
                <div class="small text-muted mb-1">
                    E o placar? <span class="text-body-secondary">(em @moedaDoPlacar, de quem você acha que vence)</span>
                </div>
                <div class="d-flex flex-wrap gap-1">
                    @foreach (var placar in r.PlacaresDoFormato)
                    {
                        bool escolhida = meuVencedor == placar.Vencedor && meuPerdedor == placar.Perdedor;
                        <button type="button"
                                class="btn btn-sm rounded-pill py-0 px-2 pdz-ficha-placar @(escolhida ? "btn-success" : "btn-outline-secondary")"
                                data-vencedor="@placar.Vencedor" data-perdedor="@placar.Perdedor"
                                onclick="palpitarPlacar(this)">@placar.Vencedor x @placar.Perdedor</button>
                    }
                </div>
            </div>
        }

        @if (r != null && r.TemPlacarMaisPalpitado)
        {
            <div class="mt-1 small text-muted pdz-palpite-consenso">
                <i class="bi bi-people"></i>
                A galera crava <strong class="pdz-consenso-placar">@r.PlacarMaisPalpitadoLado1 x @r.PlacarMaisPalpitadoLado2</strong>
                <span class="pdz-consenso-votos">(@r.PlacarMaisPalpitadoVotos de @r.PalpitesComPlacar)</span>
            </div>
        }

        @if (Model.Finalizada && r != null && r.CravaramOPlacar.Count > 0)
        {
            <div class="mt-1 small text-success fw-semibold">
                <i class="bi bi-bullseye"></i>
                @(r.CravaramOPlacar.Count == 1 ? "Cravou o placar:" : "Cravaram o placar:")
                @string.Join(", ", r.CravaramOPlacar)
            </div>
        }

    </div>
</div>
