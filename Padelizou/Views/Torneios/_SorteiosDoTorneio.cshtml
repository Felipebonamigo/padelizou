@model List<Padelizou.Models.SorteioDoTorneio>
@*
    OS SORTEIOS DE BRINDE DO TORNEIO (21/11/2026), à vista de todos — é o resultado público que
    impede o "foi armado". O refeito continua aqui, riscado, com a hora em que foi refeito.
*@
<div class="card shadow-sm border-0 mb-4" id="pdzSorteios">
    <div class="card-body">
        <h6 class="fw-bold mb-3"><i class="bi bi-gift-fill"></i> Sorteios</h6>
        @foreach (var s in Model)
        {
            var refeito = s.SubstituidoPorId != null;
            <div class="mb-3 @(refeito ? "opacity-50" : "")">
                <div class="small text-muted">
                    @s.FeitoEm.ToString("dd/MM HH:mm")
                    @if (refeito)
                    {
                        <span class="badge bg-secondary ms-1">refeito às @(s.SubstituidoEm?.ToString("HH:mm"))</span>
                    }
                </div>
                <div class="fw-semibold @(refeito ? "text-decoration-line-through" : "")">
                    @(s.Premio ?? "Sorteio")
                </div>
                <ol class="mb-0 ps-3 @(refeito ? "text-decoration-line-through" : "")">
                    @foreach (var g in s.Ganhadores.OrderBy(g => g.Ordem))
                    {
                        <li>@g.Jogador.NomeNaTela</li>
                    }
                </ol>
            </div>
        }
    </div>
</div>
