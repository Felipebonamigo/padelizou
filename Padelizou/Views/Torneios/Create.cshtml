@model Padelizou.Models.Torneio
@inject Microsoft.Extensions.Options.IOptions<Padelizou.Services.TaxasExibicao> TaxasOpcoes
@inject Microsoft.Extensions.Options.IOptions<Padelizou.Services.AsaasSettings> AsaasOpcoes
@inject Microsoft.Extensions.Options.IOptions<Padelizou.Services.SuporteSettings> SuporteOpcoes
@{
    ViewData["Title"] = "Criar Novo Torneio";
    // Lista vazia em vez de nulo: são 3 laços em cima disto, e um catálogo faltando derrubaria a
    // tela inteira de criar torneio em vez de mostrar a parte que funciona.
    var catalogo = ViewBag.CatalogoCategorias as List<padelizou.Models.CategoriaPadrao> ?? new List<padelizou.Models.CategoriaPadrao>();
    var catalogoClubes = ViewBag.CatalogoClubes as List<Padelizou.Models.Clube>;
    var taxas = TaxasOpcoes.Value;
    var asaas = AsaasOpcoes.Value;
    var comissaoOnline = asaas.ComissaoPercentualPorTipo.TryGetValue("Torneio", out var p) ? p : asaas.ComissaoPercentualPadrao;

    // Porta pra combinar a taxa do "por fora" ANTES de criar o torneio. A mensagem já vai
    // identificando quem é: do outro lado chega um número desconhecido.
    // Quem não conectou conta não consegue receber pelo site — e escolher assim mesmo criava
    // um torneio que não cobrava ninguém, calado. Aqui as opções nascem travadas e "Por fora"
    // já vem marcada, que é o que de fato vai acontecer com ele.
    bool recebimentoConectado = ViewBag.RecebimentoConectado == true;

    // Numa recusa, o formulário volta e as categorias marcadas se perdiam: quem tinha
    // escolhido oito categorias remarcava as oito. Sempre foi assim, mas passou a doer agora
    // que a forma de pagamento também recusa — e essa recusa é comum, não rara.
    var categoriasMarcadas = ViewBag.CategoriasSelecionadas as int[] ?? Array.Empty<int>();

    var quemFala = User.Identity?.Name;
    var linkCombinarTaxa = Padelizou.Services.WhatsAppLinkHelper.GerarLink(
        SuporteOpcoes.Value.WhatsApp,
        $"Olá! Sou {(string.IsNullOrWhiteSpace(quemFala) ? "organizador" : quemFala)} e vou criar um torneio no Padelizou "
        + $"na forma \"por fora\" ({taxas.ComissaoPercentualExterno.ToString("0.#")}%). Queria combinar a taxa com vocês.");

    // Os três formatos não esgotam o que dá pra jogar (liga, ranking por temporada, formato
    // meio-a-meio...). Em vez de fingir que só existe isso, o quarto "botão" é pedir pro
    // Padelizou montar o jeito certo pra aquele torneio.
    var linkFormatoPersonalizado = Padelizou.Services.WhatsAppLinkHelper.GerarLink(
        SuporteOpcoes.Value.WhatsApp,
        $"Olá! Sou {(string.IsNullOrWhiteSpace(quemFala) ? "organizador" : quemFala)} e queria montar um torneio no Padelizou "
        + "que não é Oficial, nem Americano, nem Americano de Duplas. Podem me ajudar a montar o formato certo?");
}

<div class="container mt-4 mb-5">
    <div class="card shadow-sm border-0" style="border-top: 4px solid var(--pdz-navy-fixed);">
        <div class="card-body p-4 p-md-5">
            <h2 class="fw-bold mb-4" style="color: var(--pdz-ink);"><i class="bi bi-trophy-fill"></i> Criar Novo Torneio</h2>

            @* O botão de publicar fica no PÉ de um formulário longo, e a recusa nasce aqui em
               cima: sem rolar até ela, apertar publicar parecia não fazer nada. O id serve pro
               script no fim da página trazer a tela até aqui. *@
            @if (ViewBag.Erro != null)
            {
                <div class="alert alert-danger" id="pdzErroCriacao" tabindex="-1">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i> @ViewBag.Erro
                </div>
            }

            <form asp-action="Create" method="post" enctype="multipart/form-data" id="pdzFormCriacao">

                <!-- DADOS BÁSICOS DO TORNEIO -->
                <h5 class="fw-bold text-muted border-bottom pb-2 mb-3">1. Informações Gerais</h5>

                <div class="row mb-3">
                    <div class="col-12">
                        <label class="form-label fw-bold small">Formato do Torneio</label>
                        @* O AMERICANO é livre: qualquer pessoa cadastrada cria o rodízio dela.
                           O Oficial (duplas fixas, com chave) é liberado organizador por
                           organizador — ele publica chave, cobra inscrição e vale ranking, e
                           ali a credibilidade de quem organiza importa.

                           Quem não tem o perfil vê a opção DESABILITADA em vez de não vê-la:
                           esconder faria a pessoa achar que o Padelizou não faz torneio de
                           chave. Desabilitada com o motivo do lado, ela sabe que existe e sabe
                           como pedir. *@
                        <div class="d-flex gap-3 flex-wrap">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="Formato" id="formatoPadrao" value="Padrao"
                                       checked="@(ViewBag.PodeCriarOficial == true)"
                                       disabled="@(ViewBag.PodeCriarOficial != true)">
                                <label class="form-check-label @(ViewBag.PodeCriarOficial != true ? "text-muted" : "")" for="formatoPadrao">
                                    Torneio Oficial (duplas fixas)
                                    @if (ViewBag.PodeCriarOficial != true)
                                    {
                                        <i class="bi bi-lock-fill small"></i>
                                    }
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="Formato" id="formatoAmericano" value="Americano"
                                       checked="@(ViewBag.PodeCriarOficial != true)">
                                <label class="form-check-label" for="formatoAmericano">Torneio Americano (parceiros rotativos)</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="Formato" id="formatoAmericanoDuplas" value="AmericanoDuplas">
                                <label class="form-check-label" for="formatoAmericanoDuplas">Americano de Duplas (duplas fixas, todos contra todos)</label>
                            </div>
                            @* Quarta opção, mas não é radio: não dá pra "selecionar" um formato
                               que o sistema ainda não sabe montar sozinho. É uma porta pro
                               WhatsApp, não um quarto valor de Formato. *@
                            <a href="@linkFormatoPersonalizado" target="_blank" rel="noopener"
                               class="btn btn-sm btn-outline-secondary rounded-pill align-self-start">
                                <i class="bi bi-whatsapp"></i> Não é nenhum desses? Fale conosco que montamos seu tipo de torneio
                            </a>
                        </div>
                        @if (ViewBag.PodeCriarOficial != true)
                        {
                            @* A recusa com SAÍDA. Antes ela terminava em "fale com a gente pelo
                               WhatsApp" — e quem chegou aqui às 23h de domingo não abre conversa
                               com desconhecido: fecha o app. O botão põe o pedido numa fila que
                               o admin resolve em dois minutos. *@
                            var estadoAqui = ViewBag.EstadoDoPedido as Padelizou.Services.PermissaoDeOrganizador.EstadoDoPedido?
                                ?? Padelizou.Services.PermissaoDeOrganizador.EstadoDoPedido.NuncaPediu;
                            var jaPediu = estadoAqui == Padelizou.Services.PermissaoDeOrganizador.EstadoDoPedido.Esperando;

                            <div class="alert @(jaPediu ? "alert-success" : "alert-secondary") small mt-2 mb-0 d-flex gap-2 align-items-start flex-wrap">
                                <i class="bi @(jaPediu ? "bi-hourglass-split" : "bi-lock-fill")"></i>
                                <div class="flex-grow-1" style="min-width: 14rem;">
                                    @(jaPediu
                                        ? Padelizou.Services.TextoDoPedidoDeOrganizador.Frase(estadoAqui)
                                        : (string)ViewBag.ComoPedirOPerfil)
                                </div>
                                @if (!jaPediu)
                                {
                                    <form asp-controller="Torneios" asp-action="SolicitarPerfilDeOrganizador" method="post" class="ms-auto">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="voltarPara" value="Create" />
                                        <button type="submit" class="btn btn-sm btn-padel rounded-pill px-3">
                                            <i class="bi bi-hand-index-thumb"></i> Solicitar permissão
                                        </button>
                                    </form>
                                }
                            </div>
                        }
                        @* O que cada formato significa, trocando junto com o radio (script no fim). *@
                        <small class="text-muted d-block mt-1" id="dicaFormatoPadrao">No Oficial, as duplas se inscrevem fechadas e o torneio é fase de grupos + mata-mata.</small>
                        <small class="text-muted d-block mt-1" id="dicaFormatoAmericano" style="display: none;">No Americano, cada jogador se inscreve individualmente e joga com um parceiro diferente a cada rodada.</small>
                        <small class="text-muted d-block mt-1" id="dicaFormatoAmericanoDuplas" style="display: none;">No Americano de Duplas, a dupla se inscreve fechada e enfrenta todas as outras — vence a dupla que somar mais games.</small>

                        @* Só faz sentido nos dois Americanos — no formato padrão o mata-mata já
                           resolve quem é campeão. *@
                        <div id="opcoesAmericano" class="mt-3 p-3 rounded" style="display: none; background-color: var(--pdz-surface-alt);">

                            @* RANKING AMERICANO — o preço aparece ANTES de publicar, e não depois.
                               O Americano tem ranking próprio, separado do oficial: rodízio com
                               parceiro rodando não é a mesma coisa que torneio de chave, e somar
                               os dois estragaria os dois. Valer ponto é contratado, porque ponto
                               de graça é ponto que se fabrica — quatro amigos, placares
                               inventados, ranking novo toda semana. *@
                            <div class="p-3 mb-3 rounded" style="background-color: var(--pdz-surface); border: 1px solid var(--pdz-border);">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" asp-for="PontuaNoRankingAmericano"
                                           id="pontuaRankingAmericano" onchange="pdzCustoRanking(); pdzAtualizarSimulacao();" />
                                    <label class="form-check-label fw-bold" for="pontuaRankingAmericano">
                                        <i class="bi bi-trophy"></i> Quero que este Americano valha ponto no Ranking Americano
                                    </label>
                                </div>
                                <div class="small text-muted mt-2">
                                    <strong>R$ @Padelizou.Services.PontosDoAmericano.PrecoPorPessoa.ToString("0.00") por pessoa inscrita.</strong>
                                    Quem terminar na frente leva ponto, e o valor cresce com o tamanho:
                                    ganhar um Americano de 16 vale o dobro de ganhar um de 8.
                                    <div class="mt-2">
                                        Vale <strong>a partir de @Padelizou.Services.PontosDoAmericano.MinimoParaPontuar inscritos</strong>.
                                        Fechou com menos, ninguém pontua — e você não paga nada.
                                    </div>
                                    <div class="mt-2">
                                        O Americano <strong>não pontua no ranking oficial</strong> em nenhum caso — lá é
                                        torneio de chave. Este é o ranking dele, separado.
                                    </div>
                                    <div class="mt-2 fw-bold" id="pdzCustoRanking" style="color: var(--pdz-ink); display: none;"></div>
                                </div>
                            </div>

                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" asp-for="DesempateAmericano" id="desempateAmericano" />
                                <label class="form-check-label fw-bold" for="desempateAmericano">
                                    Se der empate em games na liderança, jogar uma partida final
                                </label>
                            </div>
                            <small class="text-muted d-block mt-1" id="dicaDesempateIndividual">
                                Cada empatado escolhe um parceiro e sai um jogo só, pra decidir o título.
                                Desligado, o critério do empate fica com você.
                            </small>
                            <small class="text-muted d-block mt-1" id="dicaDesempateDuplas" style="display: none;">
                                As duas duplas empatadas jogam uma partida final, criada sozinha pelo sistema.
                                Desligado, o critério do empate fica com você.
                            </small>

                            @* QUANTAS PESSOAS FECHAM. O organizador precisa saber disto ANTES de
                               abrir inscrição: a regra do Americano é que cada um jogue com cada
                               um sem repetir parceiro e todos joguem a mesma quantidade — e isso
                               só é possível em certos números. Descobrir na hora do sorteio, com
                               a galera na quadra, é tarde demais. *@
                            <div id="soAmericanoIndividual">
                                <hr class="my-3" />
                                <div class="fw-bold small mb-1" style="color: var(--pdz-ink);">
                                    <i class="bi bi-people-fill"></i> Quantos inscritos fecham o Americano
                                </div>
                                <div class="small text-muted">
                                    No Americano cada um joga com <strong>cada um</strong> sem repetir parceiro, e
                                    todos jogam a mesma quantidade de jogos. Isso só fecha nestes números:
                                    <div class="mt-2 mb-2">
                                        @foreach (var n in Enumerable.Range(4, 29).Where(Padelizou.Services.DivisaoDoAmericano.Aceita))
                                        {
                                            <span class="badge bg-secondary me-1 mb-1">@n</span>
                                        }
                                        <span class="text-muted">…</span>
                                    </div>
                                    <strong>6, 7, 11, 14, 19, 22 e 23 não fecham</strong> — com 6 pessoas seriam 15
                                    duplas a formar e cada jogo forma 2, o que daria 7,5 jogos. Não existe meio jogo.
                                    <div class="mt-2">
                                        A partir de 8, dá pra <strong>dividir em grupos</strong> na hora do sorteio —
                                        10 vira 2 grupos de 5, 15 vira 3 grupos de 5. Os primeiros de cada grupo
                                        disputam um <strong>grupo final</strong>, que decide o campeão. Você escolhe a
                                        divisão depois, quando souber quantos vieram, e o sistema mostra quanto tempo
                                        de quadra cada opção leva.
                                    </div>
                                </div>
                            </div>

                            @* No Americano de DUPLAS a conta é a de um todos-contra-todos comum:
                               qualquer quantidade fecha, então aqui a única aritmética que o
                               organizador precisa conhecer é a do relógio. *@
                            <div id="soAmericanoDuplas" style="display: none;">
                                <hr class="my-3" />
                                <div class="fw-bold small mb-1" style="color: var(--pdz-ink);">
                                    <i class="bi bi-people-fill"></i> Como fecha o Americano de Duplas
                                </div>
                                <div class="small text-muted">
                                    <strong>Qualquer quantidade de duplas fecha</strong> (a partir de 2): cada dupla
                                    enfrenta todas as outras uma vez, e vence a que somar mais games. Com número
                                    ímpar, uma dupla descansa por rodada — e o descanso reveza sozinho.
                                    <div class="mt-2">
                                        A conta do relógio: <strong>N duplas são N−1 rodadas</strong> (N rodadas se
                                        for ímpar) e N×(N−1)÷2 jogos — 8 duplas, por exemplo, são 7 rodadas e 28
                                        jogos. O sistema mostra os números certos na hora do sorteio, quando souber
                                        quantas vieram.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                @* "Local / Clube" saiu daqui: era o mesmo dado do "Clube/Local" logo abaixo,
                   pedido duas vezes. O local do torneio passa a vir dali. *@
                <div class="row mb-3">
                    <div class="col-12">
                        <label class="form-label fw-bold small">Nome do Torneio</label>
                        <input type="text" asp-for="Nome" class="form-control bg-light" maxlength="150" required placeholder="Ex: Padel Garden Open" />
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-12">
                        <label class="form-label fw-bold small">Imagem de Capa (Opcional)</label>
                        <input type="file" name="capa" class="form-control" accept="image/*" />
                        <small class="text-muted d-block mt-1">Aparece como cartaz do torneio na Home e na listagem de Torneios.</small>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-4">
                        <label class="form-label fw-bold small">Clube/Local</label>
                        @* "Clube Responsável" virou "Clube/Local" (Felipe, 08/08/2026): quem lia
                           "clube" entendia TIME de padel e travava, porque não pertence a
                           nenhum. Aqui é só ONDE o torneio acontece — a arena, a quadra do
                           condomínio, o clube de verdade. O nome do campo é o que decide se a
                           pessoa preenche ou desiste. *@
                        @{ var temClube = catalogoClubes != null && catalogoClubes.Any(); }
                        @* Sem clube nenhum cadastrado, um select obrigatorio e vazio trava a
                           criacao do torneio. Entao aqui tambem da pra escrever o nome. *@
                        <select asp-for="ClubeId" class="form-select bg-light" required="@temClube">
                            <option value="">@(temClube ? "-- Selecione o local --" : "-- Nenhum cadastrado ainda --")</option>
                            @if (catalogoClubes != null)
                            {
                                foreach (var clube in catalogoClubes)
                                {
                                    <option value="@clube.Id">@clube.Nome</option>
                                }
                            }
                        </select>
                        <input type="text" name="novoClubeNome" id="pdzNovoClube" class="form-control form-control-sm mt-2"
                               maxlength="80" placeholder="Não achou? Escreva o nome do local" />
                        <small id="pdzAvisoClubeEscrito" class="text-muted d-none mt-1">
                            <i class="bi bi-arrow-up"></i> Vale o nome que você escreveu — o seletor fica de fora.
                        </small>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold small">Data de Início</label>
                        <input type="date" asp-for="DataInicio" id="dataInicio" class="form-control bg-light" required />

                    </div>
                    @* A PERGUNTA QUE DESPOLUI A TELA. Metade dos campos daqui só existe pra
                       montar grade de horário — e a maioria dos torneios (o rodízio de sábado,
                       o interno do clube) roda chamando o jogo conforme a quadra vaga. Perguntar
                       antes tira quatro campos da frente de quem não vai usá-los.

                       Nasce em "não" de propósito: horário inventado que ninguém cumpre é pior
                       que horário nenhum, porque o jogador confia nele e vai embora de casa na
                       hora errada. Quem quer grade responde "sim" e os campos aparecem. *@
                    <div class="col-12">
                        <div class="p-3 rounded" style="background-color: var(--pdz-surface-alt); border-left: 4px solid var(--pdz-lime);">
                            <label class="form-label fw-bold small mb-2" style="color: var(--pdz-ink);">
                                <i class="bi bi-clock me-1"></i> Você quer marcar dia e horário de cada jogo?
                            </label>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="SemHorarioPrevisto"
                                       value="true" id="pdzPorOrdem" checked />
                                <label class="form-check-label" for="pdzPorOrdem">
                                    <strong>Não</strong> — os jogos saem numa <strong>ordem</strong>, e eu chamo
                                    conforme a quadra vaga.
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="SemHorarioPrevisto"
                                       value="false" id="pdzComHorario" />
                                <label class="form-check-label" for="pdzComHorario">
                                    <strong>Sim</strong> — quero uma grade com dia e hora de cada jogo.
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4 pdz-so-com-horario">
                        <label class="form-label fw-bold small">Precisa terminar até <span class="fw-normal">(opcional)</span></label>
                        <input type="date" asp-for="DataFim" class="form-control bg-light" />
                        <small class="text-muted d-block mt-1">Até quando você tem a quadra. Serve pro sistema avisar se os jogos não couberem.</small>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold small">Inscrição <span class="fw-normal">(por pessoa)</span></label>
                        @* min=0 porque torneio de graça é válido; o que não existe é preço
                           negativo. O valor nasce em 150 (ver TorneiosController.Criacao) e o
                           campo se seleciona sozinho ao receber o foco — quem digita substitui
                           o número inteiro em vez de emendar dígito no que já estava lá. *@
                        <input type="number" asp-for="PrecoInscricao" id="precoInscricao" step="0.01" min="0"
                               class="form-control bg-light pdz-dinheiro" required placeholder="Ex: 75,00"
                               oninput="pdzAtualizarSimulacao()" />
                        <small class="text-muted d-block mt-1">É o valor que cada jogador paga. Uma dupla paga o dobro.</small>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold small">Qtd. de Quadras Disponíveis</label>
                        @* `name` na mão, sem asp-for: o modelo traz 0 e o asp-for escreveria
                           esse 0 no campo. Campo com 0 dentro é armadilha — quem digita "1"
                           em cima acaba com 10 ou 01 e publica o torneio com a grade errada.
                           Vazio + `required` pede o número em vez de sugerir um errado. *@
                        <input type="number" name="QuantidadeQuadras" id="quantidadeQuadras" min="1" class="form-control bg-light" required placeholder="Ex: 3" oninput="gerarCamposQuadra()" />
                        <small class="text-muted d-block mt-1">Quantos jogos rodam ao mesmo tempo na grade.</small>
                    </div>
                    <div class="col-md-4 pdz-so-com-horario">
                        <label class="form-label fw-bold small">Duração de cada jogo</label>
                        <div class="input-group">
                            <input type="number" asp-for="TempoPrevistoPartidaMinutos" min="10" max="180" class="form-control bg-light" required />
                            <span class="input-group-text">min</span>
                        </div>
                    </div>
                    @* Duas aberturas porque o torneio de fim de semana tem duas: sexta à
                       noite (todo mundo trabalha de dia) e sábado/domingo cedo. *@
                    <div class="col-md-8 pdz-so-com-horario">
                        <label class="form-label fw-bold small">Horários dos jogos</label>
                        <div class="row g-2">
                            <div class="col-6 col-md-4">
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text">1º dia</span>
                                    <input type="time" asp-for="HoraInicioDoDia" class="form-control bg-light" required />
                                </div>
                            </div>
                            <div class="col-6 col-md-4">
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text">demais</span>
                                    <input type="time" asp-for="HoraInicioDiasSeguintes" class="form-control bg-light" required />
                                </div>
                            </div>
                            <div class="col-12 col-md-4">
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text">último jogo até</span>
                                    <input type="time" asp-for="HoraFimDoDia" class="form-control bg-light" required />
                                </div>
                            </div>
                        </div>
                        @* O organizador escolhe a janela sem saber onde ela cai: com jogo de
                           1h a partir das 18h, o teto de 23h50 vira 23h — a cadência não
                           alcança 23h50. Melhor ele ver isso antes de anunciar. *@
                        <small id="pdzUltimoJogo" class="d-block mt-1 fw-bold" style="color: var(--pdz-ink);"></small>
                        <small class="text-muted d-block mt-1">
                            É a hora em que o último jogo <strong>começa</strong> — ele pode virar a madrugada.
                            O que não couber no dia vai pro seguinte.
                        </small>
                    </div>

                    @* "Cabe?" é a pergunta que nenhum campo responde sozinho: depende do número
                       de jogos, que depende de quantas duplas entram. Na criação ninguém sabe
                       ainda, então o organizador estima e o sistema mostra onde isso termina. *@
                    <div class="col-12 pdz-so-com-horario">
                        <div class="p-3 rounded" style="background-color: var(--pdz-surface-alt); border-left: 4px solid var(--pdz-lime);">
                            <label class="form-label fw-bold small mb-2" style="color: var(--pdz-ink);">
                                <i class="bi bi-calendar-check me-1"></i> Vai caber?
                            </label>
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <span class="small text-muted" id="pdzRotuloEspera">Você espera quantas duplas?</span>
                                <input type="number" id="pdzDuplasEsperadas" min="2" max="256" value="50"
                                       class="form-control form-control-sm" style="width: 90px;" />
                                <span class="small text-muted">(só pra simular — não é limite)</span>
                            </div>
                            <div id="pdzPrevisao" class="mt-2 small"></div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold small">Limite total de duplas no torneio (opcional)</label>
                        <input type="number" asp-for="LimiteDuplasTotal" min="1" class="form-control bg-light" placeholder="Sem limite" />
                        <small class="text-muted d-block mt-1">Somando todas as categorias. Quem se inscrever depois de esgotado vai pra lista de espera.</small>
                    </div>

                    @* ── Já abre pra inscrição? ──────────────────────────────────────────
                       Quem monta o torneio em duas sentadas estava obrigado a deixar o
                       formulário aceitando gente enquanto ainda mexia em categoria, quadra e
                       preço — e a inscrição que entra no meio disso pega o torneio pela
                       metade.

                       ⚠️ O hidden é o que faz o "não" chegar: caixa desmarcada simplesmente
                       não é enviada pelo navegador, e sem ele o parâmetro cairia no valor
                       padrão (true) — desmarcar não faria nada.

                       ⚠️⚠️ E ele vem DEPOIS do checkbox, que é a ordem do asp-for do próprio
                       ASP.NET. O binder de bool fica com o PRIMEIRO valor: com o hidden na
                       frente, marcar mandava "false,true" e valia o `false` — a caixa fazia
                       exatamente o contrário do que dizia. Medido no navegador, não deduzido. *@
                    <div class="col-12">
                        <div class="p-3 rounded" style="background-color: var(--pdz-surface-alt); border-left: 4px solid var(--pdz-lime);">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="abrirInscricoes"
                                       value="true" id="abrirInscricoes" checked />
                                <label class="form-check-label" for="abrirInscricoes">
                                    <span class="fw-bold">Já quero receber inscrições</span>
                                    <span class="d-block small text-muted">
                                        Desmarque se ainda está montando o torneio. Ele fica na
                                        seção <strong>"Em breve"</strong> — dá pra ver os detalhes e
                                        o link funciona, mas ninguém se inscreve até você abrir.
                                        Abrir depois é um botão em Gerenciar Torneio.
                                    </span>
                                </label>
                                <input type="hidden" name="abrirInscricoes" value="false" />
                            </div>
                        </div>
                    </div>

                    @* "Quando fecha?" e "quando sai a chave?" são as duas perguntas que o
                       organizador responde no WhatsApp o torneio inteiro. Publicadas aqui, ele
                       responde uma vez só. São PREVISÕES: nada fecha nem sorteia sozinho —
                       encerrar inscrições e gerar chaves seguem sendo botão dele. *@
                    <div class="col-md-4">
                        <label class="form-label fw-bold small">
                            Inscrições devem fechar em <span class="fw-normal">(opcional)</span>
                        </label>
                        <input type="date" asp-for="PrevisaoEncerramentoInscricoes" class="form-control bg-light" />
                        <small class="text-muted d-block mt-1">
                            Só um aviso pros jogadores. Quem encerra de verdade é você, no botão.
                        </small>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold small">
                            Chaveamento previsto pra <span class="fw-normal">(opcional)</span>
                        </label>
                        <input type="date" asp-for="PrevisaoChaveamento" class="form-control bg-light" />
                        <small class="text-muted d-block mt-1">
                            Quando os grupos e jogos devem sair. Evita o "já saiu a chave?" no zap.
                        </small>
                    </div>

                    @* Recado geral, não é só do "por fora": vale pra qualquer torneio ("levem
                       bola", "estacionamento pelos fundos", "confirma no grupo"). *@
                    <div class="col-12">
                        <label class="form-label fw-bold small">
                            Recado pra quem se inscrever <span class="fw-normal">(opcional)</span>
                        </label>
                        <textarea asp-for="RecadoAosInscritos" class="form-control bg-light" rows="2" maxlength="600"
                                  placeholder="Ex: confirme no grupo do WhatsApp depois de pagar. Estacionamento pelos fundos."></textarea>
                        <small class="text-muted d-block mt-1">
                            Aparece na tela de inscrição e no comprovante. Dá pra mudar depois, editando o torneio.
                        </small>
                    </div>
                </div>

                @* ── Como o dinheiro vai correr ────────────────────────────────────────
                   O organizador precisa decidir isso de olhos abertos: o cartão de
                   crédito só cai 32 dias depois, e quadra e premiação vencem antes. *@
                <div class="mb-4 p-3 rounded" style="background-color: var(--pdz-surface-alt); border-left: 4px solid var(--pdz-lime);">
                    <label class="form-label fw-bold" style="color: var(--pdz-ink);">
                        <i class="bi bi-cash-coin me-1"></i> Como você vai receber as inscrições?
                    </label>

                    @* Sem conta conectada, as duas opções "pelo site" são promessa que o sistema
                       não cumpre: a cobrança não nasce e o torneio roda sem cobrar ninguém.
                       Ficam visíveis (pra ele saber que existem) mas travadas, com a saída
                       escrita junto. *@
                    @if (!recebimentoConectado)
                    {
                        <div class="alert alert-warning border-0 d-flex gap-2 align-items-start mb-3">
                            <i class="bi bi-exclamation-triangle-fill fs-5 lh-1 mt-1"></i>
                            <div>
                                <strong>Pra receber pelo site, falta conectar sua conta.</strong>
                                <div class="small mt-1">
                                    Enquanto isso você pode criar o torneio normalmente na opção
                                    <strong>Por fora</strong> — combina o Pix direto com o jogador e o
                                    Padelizou cuida da organização.
                                </div>
                                <a asp-controller="Pagamentos" asp-action="Configurar" target="_blank"
                                   class="btn btn-sm btn-warning rounded-pill mt-2">
                                    <i class="bi bi-wallet2"></i> Conectar minha conta
                                </a>
                            </div>
                        </div>
                    }

                    @* A taxa muda com a escolha do ORGANIZADOR, nunca com a forma que o jogador
                       escolhe no checkout: o split é fixado quando a cobrança nasce, e ele
                       precisa saber quanto recebe antes de anunciar o preço. *@
                    <div class="form-check p-3 rounded mb-2 @(recebimentoConectado ? "" : "opacity-50")" style="border: 1px solid var(--pdz-border);">
                        <input class="form-check-input" type="radio" asp-for="FormaPagamento" value="OnlinePix"
                               id="pagPix" disabled="@(!recebimentoConectado)"
                               onchange="pdzAtualizarSimulacao()" />
                        <label class="form-check-label w-100" for="pagPix">
                            <span class="fw-bold">Pelo site, só Pix</span>
                            <span class="badge bg-success ms-1 pdz-selo-taxa">taxa @taxas.ComissaoPercentualSomentePix.ToString("0.#")%</span>
                            <div class="small text-muted mt-1">
                                O jogador paga por Pix na hora de se inscrever e a vaga já nasce confirmada.
                                <strong>O dinheiro cai na sua conta na hora.</strong> É a opção mais barata —
                                e no padel, Pix é como quase todo mundo paga.
                            </div>
                        </label>
                    </div>

                    <div class="form-check p-3 rounded mb-2 @(recebimentoConectado ? "" : "opacity-50")" style="border: 1px solid var(--pdz-border);">
                        <input class="form-check-input" type="radio" asp-for="FormaPagamento" value="OnlineTodas"
                               id="pagTodas" disabled="@(!recebimentoConectado)" onchange="pdzAtualizarSimulacao()" />
                        <label class="form-check-label w-100" for="pagTodas">
                            <span class="fw-bold">Pelo site, todas as formas</span>
                            <span class="badge bg-secondary ms-1 pdz-selo-taxa">taxa @taxas.ComissaoPercentualSomentePix.ToString("0.#")% a @taxas.ComissaoPercentualTodasFormas.ToString("0.#")%</span>
                            <div class="small text-muted mt-1">
                                Pix, boleto, débito e cartão de crédito — inclusive parcelado. Facilita pra quem
                                não tem o valor à vista, mas o cartão demora a cair.
                            </div>
                            @* A régua por forma efetiva é o que faz esta opção deixar de ser um
                               castigo: aceitar cartão não encarece mais as inscrições que vierem
                               por Pix, que na prática são a maioria. *@
                            <div class="small mt-1" style="color: var(--padel-green);">
                                <i class="bi bi-check-circle-fill"></i>
                                <strong>Você paga a taxa da forma que o jogador escolher:</strong>
                                quem pagar por Pix ou boleto custa @taxas.ComissaoPercentualSomentePix.ToString("0.#")%,
                                não @taxas.ComissaoPercentualTodasFormas.ToString("0.#")%.
                            </div>
                            <div class="small text-muted mt-1">
                                <button type="button" class="btn btn-link btn-sm p-0 align-baseline"
                                        data-bs-toggle="modal" data-bs-target="#modalComoRecebo">
                                    Ver os prazos
                                </button>
                            </div>
                        </label>
                    </div>

                    <div class="form-check p-3 rounded" style="border: 1px solid var(--pdz-border);">
                        <input class="form-check-input" type="radio" asp-for="FormaPagamento" value="Externo"
                               id="pagExterno" onchange="pdzAtualizarSimulacao()" />
                        <label class="form-check-label w-100" for="pagExterno">
                            <span class="fw-bold">Por fora</span>
                            <span class="badge bg-success ms-1 pdz-selo-taxa">taxa @taxas.ComissaoPercentualExterno.ToString("0.#")%</span>
                            <div class="small text-muted mt-1">
                                Você combina Pix ou dinheiro direto com o jogador. O Padelizou
                                <strong>não toca no dinheiro</strong>: cuida só da organização — chaves, jogos,
                                placar ao vivo e ranking. Depois você paga a taxa sobre o que foi inscrito.
                            </div>
                            <div class="small text-muted mt-1">
                                <i class="bi bi-info-circle"></i>
                                Em compensação, cobrar é por sua conta: o sistema não tem como saber quem pagou.
                            </div>
                            @* A condição do 5% escrita ANTES da escolha, não depois. Nesta forma o
                               dinheiro não passa por aqui, então a taxa depende de o organizador
                               pagar — e quem só descobre a condição na hora de gerar as chaves
                               sente que mudou a regra no meio do jogo. *@
                            <div class="alert alert-warning border-0 small mt-2 mb-0 py-2" id="pdzCondicaoExterno">
                                <strong><i class="bi bi-key-fill"></i> Condição desta forma:</strong>
                                as <strong>chaves são liberadas mediante o pagamento da taxa</strong> —
                                ou mediante negociação combinada com o Padelizou (prazo, parcelamento
                                ou isenção). Nas formas pelo site isso não existe: a taxa já sai
                                automática de cada inscrição.
                            </div>
                        </label>

                        @* FORA do <label> de propósito: dentro dele, clicar no botão marcaria o
                           rádio junto — e quem só queria perguntar acabaria escolhendo a forma.
                           A porta fica aqui, na hora de ESCOLHER, e não só lá no fim quando as
                           chaves travam: quem precisa de prazo ou isenção quer saber disso antes
                           de decidir como vai receber. *@
                        <div class="ps-4 mt-2">
                            <a id="pdzCombinarTaxa" href="@linkCombinarTaxa" target="_blank" rel="noopener"
                               class="btn btn-sm btn-outline-success rounded-pill">
                                <i class="bi bi-whatsapp"></i> Prefiro combinar com o Padelizou
                            </a>
                            <div class="small text-muted mt-1">
                                Abre uma conversa no WhatsApp pra acertar prazo, parcelamento ou isenção
                                da taxa. Dá pra criar o torneio do mesmo jeito e combinar depois.
                            </div>
                        </div>

                        @* Só aparece nesta forma: nas outras o jogador paga pelo site e uma chave
                           Pix na tela seria um segundo caminho pro mesmo dinheiro — ninguém saberia
                           qual vale. Fica escondido por padrão e o script mostra quando "Por fora"
                           está marcado. *@
                        <div class="ps-4 mt-3" id="pdzBlocoPix" style="display:none;">
                            <label class="form-label fw-bold small mb-1" for="chavePix">
                                <i class="bi bi-qr-code"></i> Sua chave Pix <span class="fw-normal">(opcional)</span>
                            </label>
                            <input type="text" asp-for="ChavePixOrganizador" id="chavePix" maxlength="140"
                                   class="form-control" placeholder="CPF, celular, e-mail ou chave aleatória" />
                            <small class="text-muted d-block mt-1">
                                Aparece pro jogador na hora de se inscrever, junto com o valor.
                                O dinheiro cai direto na sua conta — o Padelizou não passa por ele
                                e não tem como saber quem pagou.
                            </small>
                        </div>
                    </div>

                    @* A conta enxuta: quanto o jogador paga, quanto é taxa, quanto sobra.
                       Só isso — o resto (prazos, formas de pagamento) vive no modal. *@
                    <div class="border rounded p-3 mt-3 mb-3" style="background: var(--pdz-surface);">
                        <table class="table table-sm mb-0 align-middle">
                            <tbody>
                                <tr>
                                    <td class="small">Cada jogador paga</td>
                                    <td class="text-end fw-bold" id="pdzJogadorPaga">—</td>
                                </tr>
                                <tr class="text-danger">
                                    <td class="small" id="pdzComissaoRotulo">− Taxa do Padelizou</td>
                                    <td class="text-end fw-bold" id="pdzComissaoValor">—</td>
                                </tr>
                                <tr class="border-top">
                                    <td class="fw-bold" id="pdzRecebeRotulo">= Você recebe, por jogador</td>
                                    <td class="text-end fw-bold fs-5 text-success" id="pdzVoceRecebe">—</td>
                                </tr>
                            </tbody>
                        </table>
                        <div id="pdzSimulacao" class="small text-muted mt-2"></div>
                    </div>

                    <div class="border-top pt-3">
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" asp-for="PagamentoObrigatorioNaInscricao"
                                   id="pagObrigatorio" onchange="pdzPrazoVisivel()" style="transform: scale(1.2); margin-right: 8px;" />
                            <label class="form-check-label fw-bold small" for="pagObrigatorio">
                                Só confirmo a inscrição depois de pago
                            </label>
                            <div class="small text-muted ps-1">
                                Ligado, a vaga só existe com o pagamento — acaba o calote e o "depois eu te acerto".
                                Desligado, o jogador garante a vaga na hora e acerta com você depois.
                            </div>
                        </div>

                        <div id="pdzBlocoPrazo" style="display:none;" class="ps-1">
                            <div class="row g-2 align-items-end">
                                <div class="col-md-5">
                                    <label class="form-label fw-bold small mb-1">Prazo pra pagar (opcional)</label>
                                    <input type="date" asp-for="PrazoPagamento" class="form-control form-control-sm" />
                                </div>
                                <div class="col-md-7">
                                    @* ⚠️ O TEXTO ANTIGO PROMETIA O QUE O CÓDIGO NUNCA FEZ: "quem
                                       não pagar perde a vaga" sugeria exclusão automática, e a
                                       coluna não era lida por uma linha sequer — o organizador
                                       do NATA PADEL TOUR passou o torneio inteiro achando que o
                                       sistema limparia sozinho. Agora a caixinha diz o que
                                       acontece de verdade: o sistema PERGUNTA. O rótulo mora em
                                       Services/DecisaoSobreQuemNaoPagou pra não voltar a
                                       divergir do comportamento. *@
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" asp-for="ExcluirSeNaoPagar" id="excluirSeNaoPagar" />
                                        <label class="form-check-label small" for="excluirSeNaoPagar">
                                            @Padelizou.Services.DecisaoSobreQuemNaoPagou.RotuloDaCaixinha
                                        </label>
                                        <div class="small text-muted">
                                            @Padelizou.Services.DecisaoSobreQuemNaoPagou.ExplicacaoDaCaixinha
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-12">
                        <label class="form-label fw-bold small">Nome de cada Quadra (opcional)</label>
                        <div id="camposNomesQuadras" class="row g-2"></div>
                    </div>
                </div>

                @* ── Pacote adicional: nós registramos os resultados ───────────────────── *@
                @if (ViewBag.RegistroHabilitado == true)
                {
                    <div class="card border-0 shadow-sm mb-4 pdz-tinta-azul">
                        <div class="card-body">
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" name="querRegistroDeResultados"
                                       value="true" id="registroSwitch" onchange="toggleRegistro()"
                                       style="transform: scale(1.3); margin-right: 10px;">
                                <label class="form-check-label fw-bold" for="registroSwitch" style="color: var(--pdz-ink);">
                                    🙋 Nós registramos os resultados para você
                                    <span class="text-muted fw-normal">(verificar disponibilidade)</span>
                                </label>
                            </div>

                            <p class="small text-muted mb-2 ps-4">
                                Mandamos gente ao seu torneio para lançar os jogos na hora: placar, quem
                                ganhou, chaves andando sozinhas. Você cuida do torneio, a gente cuida do sistema.
                            </p>

                            <div id="blocoRegistro" class="ps-4" style="display:none;">
                                <div class="alert alert-light border small mb-3">
                                    <div class="fs-6 mb-1">
                                        <strong>@(((decimal)(ViewBag.RegistroPrecoPorJogo ?? 12m)).ToString("C")) por jogo</strong>,
                                        mínimo de <strong>@(((decimal)(ViewBag.RegistroValorMinimo ?? 500m)).ToString("C"))</strong>.
                                    </div>
                                    <div class="text-muted">
                                        O total sai do tamanho real do torneio — quantas duplas entrarem, quantos
                                        jogos derem. <span id="pdzRegistroResumo"></span>
                                    </div>
                                    <div class="text-muted mt-1">
                                        Isto é um <strong>pedido</strong>, não uma compra: vamos verificar se temos
                                        equipe para a sua data e confirmar o valor (clube longe pode mudar).
                                        Nada é cobrado agora.
                                    </div>
                                </div>

                                <label class="form-label fw-bold small">Algo que a gente precise saber?</label>
                                <textarea name="observacoesRegistro" class="form-control bg-light" rows="2"
                                          placeholder="Ex: sábado começa 8h e vai até tarde, o ginásio fica a 40 min do centro, meu telefone é..."></textarea>
                            </div>
                        </div>
                    </div>
                }
                <div class="row mb-4" id="blocoCheckIn">
                    <div class="col-md-12">
                        <div class="form-check form-switch mb-2">
                            @* Nasce desmarcado (o modelo já vem assim): quem faz torneio grande
                               liga aqui, e o interno de 8 duplas não ganha uma tela a mais. *@
                            <input class="form-check-input" type="checkbox" asp-for="UsaCheckIn" id="checkInSwitch" style="transform: scale(1.3); margin-right: 10px;">
                            <label class="form-check-label fw-bold text-muted" for="checkInSwitch">Usar check-in no dia do torneio?</label>
                            <div class="small text-muted ps-1 mb-3">
                                Lista pra ir marcando quem já chegou, direto do celular na quadra.
                                Ajuda em torneio grande; num interno pequeno costuma sobrar.
                            </div>
                        </div>
                    </div>
                </div>
                @* Impedimento é uma DUPLA marcando o horário em que não pode jogar, antes
                   mesmo de o sorteio existir. No Americano (os dois sabores) não há dupla
                   fixa nesse sentido — no individual o parceiro muda a cada rodada, e a
                   ideia de bloquear um turno inteiro não se aplica a como o torneio roda. *@
                <div class="row mb-4" id="blocoImpedimentos">
                    <div class="col-md-12">
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" asp-for="PermiteImpedimentos" id="impSwitch" onchange="toggleImpedimentos()" style="transform: scale(1.3); margin-right: 10px;">
                            <label class="form-check-label fw-bold text-muted" for="impSwitch">Permitir Impedimentos de Horário?</label>
                        </div>
                        <div id="turnosImpedimento" class="ps-4" style="display: none;">
                            <p class="small text-muted mb-2">Quais turnos as duplas podem marcar como impedimento?</p>
                            @* A quinta só vale pra torneio que COMEÇA na quinta — a linha
                               aparece e some conforme a data escolhida (ver o script no fim
                               da página). Num fim de semana comum, oferecer o turno seria
                               oferecer um dia que não existe. *@
                            <div class="form-check" id="linhaImpQuinta" style="display: none;">
                                <input class="form-check-input" type="checkbox" asp-for="PermiteImpedimentoQuintaNoite" id="impQuinta">
                                <label class="form-check-label" for="impQuinta">Quinta à noite</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" asp-for="PermiteImpedimentoSextaNoite" id="impSexta">
                                <label class="form-check-label" for="impSexta">Sexta à noite</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" asp-for="PermiteImpedimentoSabadoManha" id="impSabManha">
                                <label class="form-check-label" for="impSabManha">Sábado de manhã</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" asp-for="PermiteImpedimentoSabadoTarde" id="impSabTarde">
                                <label class="form-check-label" for="impSabTarde">Sábado à tarde</label>
                            </div>

                            @* Cada impedimento tira uma janela da grade. Cobrar por isso faz
                               quem realmente precisa pagar pela flexibilidade que tirou, e
                               desestimula quem marca "por via das dúvidas". *@
                            <div class="mt-3" style="max-width: 320px;">
                                <label class="form-label fw-bold small mb-1" for="taxaImpedimento">
                                    Cobrar a mais por impedimento?
                                </label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text">R$</span>
                                    @* Vazio, não "0": o placeholder já diz que em branco é de
                                       graça, e um 0 escrito no campo vira 10 ou 05 quando a
                                       pessoa digita em cima dele. *@
                                    <input type="number" name="TaxaPorImpedimento" id="taxaImpedimento"
                                           step="0.01" min="0" class="form-control pdz-dinheiro" placeholder="0,00" />
                                </div>
                                <small class="text-muted d-block mt-1">
                                    Cobrado <strong>por impedimento marcado</strong>, somado à inscrição.
                                    Deixe zerado pra não cobrar nada.
                                </small>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-12">
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" asp-for="Restrito" id="restritoSwitch" onchange="toggleOculto()" style="transform: scale(1.3); margin-right: 10px;">
                            <label class="form-check-label fw-bold text-muted" for="restritoSwitch">
                                <i class="bi bi-key-fill"></i> Torneio Restrito (exige chave de acesso pra se inscrever)
                            </label>
                        </div>
                        <small class="text-muted d-block">
                            Só quem tiver a chave consegue se inscrever — você compartilha com quem quiser convidar.
                            <strong class="d-block mt-1">Torneio restrito não conta pontos pro ranking:</strong>
                            ele é evento fechado (interno de clube, grupo de amigos). Os jogos, o título e a
                            participação continuam aparecendo no perfil de quem jogou.
                        </small>

                        <div id="campoChaveAcesso" class="ps-4 mt-2" style="display: none;">
                            <label class="form-label small fw-bold mb-1" for="chaveAcessoEscolhida">Chave de acesso</label>
                            <input type="text" class="form-control" id="chaveAcessoEscolhida" name="chaveAcessoEscolhida"
                                   maxlength="20" autocomplete="off" placeholder="deixe vazio pra gerar uma sozinho" />
                            @* Chave que a pessoa consegue repetir no telefone vale mais que chave
                               difícil: quem não consegue repetir liga pro organizador. *@
                            <small class="text-muted d-block mt-1">
                                Escolha uma palavra fácil de passar pro grupo (ex.: <em>virgili10</em>), de 4 a 20
                                letras ou números, sem espaço. Deixando vazio, o sistema sorteia uma de 6 caracteres.
                                Na hora de se inscrever, tanto faz maiúscula ou minúscula.
                            </small>
                        </div>

                        <div id="opcaoOculto" class="ps-4 mt-2" style="display: none;">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" asp-for="Oculto" id="ocultoCheck">
                                <label class="form-check-label" for="ocultoCheck">
                                    <i class="bi bi-eye-slash"></i> Ocultar este torneio da listagem pública (só quem tiver o link direto consegue ver)
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-12">
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" asp-for="PermiteMultiplasCategorias" id="multiCatSwitch" style="transform: scale(1.3); margin-right: 10px;">
                            <label class="form-check-label fw-bold text-muted" for="multiCatSwitch">
                                <i class="bi bi-layers-fill"></i> Permitir o mesmo jogador em mais de uma categoria
                            </label>
                        </div>
                        <small class="text-muted d-block">
                            Ligado (padrão): o jogador pode disputar quantas categorias quiser.
                            Desligado: cada jogador fica preso a uma categoria só — útil pra evitar choque de horário no dia do torneio.
                        </small>

                        @* O preço da 2ª categoria acompanha a chave acima: sem múltiplas
                           categorias ninguém chega a uma segunda inscrição. Só aparece com a
                           chave ligada (o JS abaixo cuida disso ao vivo). *@
                        <div class="mt-3 p-3 rounded" id="pdzBlocoSegundoPreco"
                             style="background-color: var(--pdz-surface-alt); border-left: 4px solid var(--pdz-lime);">
                            <label class="form-label fw-bold small mb-1" for="precoSegunda">
                                Preço da 2ª categoria do mesmo jogador <span class="fw-normal">(opcional)</span>
                            </label>
                            <div class="input-group input-group-sm" style="max-width: 16rem;">
                                <span class="input-group-text">R$</span>
                                <input type="number" step="0.01" min="0" class="form-control"
                                       id="precoSegunda" asp-for="PrecoSegundaInscricao" placeholder="mesmo preço" />
                            </div>
                            <small class="text-muted d-block mt-1">
                                É o normal no padel: quem joga duas categorias paga menos na segunda.
                                <strong>Em branco = sem desconto</strong>, cada inscrição custa o preço cheio.
                                O desconto é <strong>por jogador</strong> — numa dupla em que só um repete,
                                o outro paga cheio.
                            </small>
                        </div>
                    </div>
                </div>

                <script>
                    // O bloco do segundo preço só faz sentido com múltiplas categorias ligadas.
                    (function () {
                        var chave = document.getElementById('multiCatSwitch');
                        var bloco = document.getElementById('pdzBlocoSegundoPreco');
                        function ajustar() { bloco.style.display = chave.checked ? 'block' : 'none'; }
                        chave.addEventListener('change', ajustar);
                        ajustar();
                    })();
                </script>

                @* A restrição por histórico DAQUI (Torneio.RestricaoCategoria) saiu da tela em
                   06/08/2026: quem nivela é o Ranking RS, que enxerga o estado inteiro em vez de
                   só quem já jogou no Padelizou. O motor continua no código e testado — voltar a
                   oferecer é devolver um <select> aqui. Ver RANKING.md. *@
                <div class="row mb-4" id="blocoRankingRs">
                    <div class="col-md-12">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" asp-for="ValidarPeloRankingRs" id="createRankingRs">
                            <label class="form-check-label fw-bold text-muted" for="createRankingRs">
                                <i class="bi bi-graph-up-arrow"></i> Conferir as inscrições no @Padelizou.Services.MarcaDoRanking.Nome
                            </label>
                        </div>
                        <div class="small text-muted mt-2">
                            Consulta o ranking oficial na hora da inscrição e barra quem já pontuou numa categoria
                            <strong>mais forte</strong> do que a escolhida. Quem for barrado aparece na página do torneio
                            e <strong>você decide</strong> se mantém ou libera.
                            Se o ranking estiver fora do ar, a inscrição passa normalmente — ninguém fica travado por isso.
                            <br />
                            Cada categoria que você marcar acima é ligada à do ranking automaticamente pelo nome
                            (a 7ª e Iniciantes não existem lá, então ficam de fora). Depois de criar, dá pra
                            revisar uma a uma em <strong>Editar torneio</strong>.
                        </div>
                    </div>
                </div>

                <!-- REGRAS DE SETS E GAMES -->
                <h5 class="fw-bold text-muted border-bottom pb-2 mb-3 mt-5">2. Formato das Partidas</h5>

                <div class="form-check form-switch mb-3 p-3 rounded" style="background-color: var(--pdz-surface-alt);">
                    <input class="form-check-input ms-0 me-2" type="checkbox" asp-for="FormatoUnico" id="formatoUnico" checked onchange="toggleFases()" style="transform: scale(1.3);">
                    <label class="form-check-label fw-bold ms-2" for="formatoUnico" style="color: var(--pdz-ink);">
                        Formato Único (Todas as partidas do torneio terão a mesma regra)
                    </label>
                </div>

                @* COMO os games são contados. Vale pro torneio inteiro (o número muda por
                   fase, o significado dele não), e vale nos três formatos — o rodízio de
                   games fixos é justamente o mais comum no Americano. *@
                <div class="p-3 rounded mb-3" style="background-color: var(--pdz-surface-alt);">
                    <label class="form-label fw-bold small mb-2" style="color: var(--pdz-ink);">
                        <i class="bi bi-123 me-1"></i> Como contar os games
                    </label>
                    <div class="d-flex gap-3 flex-wrap">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" asp-for="ContagemDeGames"
                                   value="@Padelizou.Services.ContagemDeGamesDoTorneio.Ate"
                                   id="contagemAte" checked onchange="pdzContagem()" />
                            <label class="form-check-label" for="contagemAte">
                                <strong>Até</strong> X games — quem chegar primeiro vence
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" asp-for="ContagemDeGames"
                                   value="@Padelizou.Services.ContagemDeGamesDoTorneio.Soma"
                                   id="contagemSoma" onchange="pdzContagem()" />
                            <label class="form-check-label" for="contagemSoma">
                                <strong>Soma de</strong> X games — jogam-se X games no total
                            </label>
                        </div>
                    </div>
                    <small class="text-muted d-block mt-2" id="dicaContagemAte">
                        O de sempre: num jogo até 9, vence quem fizer 9. Em número par vale o
                        "vencer por dois" — até 4 empatado em 3x3 vai até 5.
                    </small>
                    <small class="text-muted d-block mt-2" id="dicaContagemSoma" style="display: none;">
                        O jogo tem tamanho fixo: numa <strong>soma de 7</strong> o placar sempre fecha
                        em 7 (4x3, 5x2, 7x0…) e vence quem fizer mais. É o que mantém a grade no
                        horário, porque todo jogo dura o mesmo.
                    </small>
                    @* ⚠️ Soma PAR empata (8 fecha em 4x4), e o sistema recusa finalizar
                       partida empatada — "no padel alguém tem que fechar o jogo". Avisar aqui
                       é bem mais barato que descobrir com a quadra ocupada. *@
                    <div class="alert alert-warning small mt-2 mb-0 py-2 px-3" id="avisoSomaPar" style="display: none;">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <strong>Número par empata.</strong> Numa soma de <span id="avisoSomaParN">8</span>
                        dá <span id="avisoSomaParMeio">4x4</span>, e o sistema não finaliza jogo empatado.
                        Prefira um número <strong>ímpar</strong> — aí sempre sai um vencedor.
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="card bg-light border-0 p-3 h-100">
                            <h6 class="fw-bold" style="color: var(--pdz-ink);">Fase de Grupos (ou Geral)</h6>
                            <label class="small text-muted mt-2">Quantidade de Sets</label>
                            <input type="number" asp-for="SetsFaseGrupos" class="form-control mb-2" value="1" required />
                            <label class="small text-muted pdz-rotulo-games">Games por Set</label>
                            <input type="number" asp-for="GamesFaseGrupos" class="form-control" value="9" required />
                        </div>
                    </div>

                    <!-- Fases Finais (Escondidas por padrão pelo JS) -->
                    <div class="col-md-4 fase-extra" style="display: none;">
                        <div class="card bg-light border-0 p-3 h-100">
                            <h6 class="fw-bold text-secondary">Fases Eliminatórias (Mata-Mata)</h6>
                            <label class="small text-muted mt-2">Quantidade de Sets</label>
                            <input type="number" asp-for="SetsFaseMataMata" class="form-control mb-2" value="1" />
                            <label class="small text-muted pdz-rotulo-games">Games por Set</label>
                            <input type="number" asp-for="GamesFaseMataMata" class="form-control" value="9" />
                        </div>
                    </div>

                    <div class="col-md-4 fase-extra" style="display: none;">
                        <div class="card bg-light border-0 p-3 h-100">
                            <h6 class="fw-bold text-danger">A Grande Final</h6>
                            <label class="small text-muted mt-2">Quantidade de Sets</label>
                            <input type="number" asp-for="SetsFaseFinal" class="form-control mb-2" value="3" />
                            <label class="small text-muted pdz-rotulo-games">Games por Set</label>
                            <input type="number" asp-for="GamesFaseFinal" class="form-control" value="6" />
                        </div>
                    </div>
                </div>

                <!-- OUTROS ORGANIZADORES -->
                <h5 class="fw-bold text-muted border-bottom pb-2 mb-3 mt-5">3. Outros Organizadores (opcional)</h5>
                <p class="small text-muted mt-n2 mb-3">Além de você, quem mais vai poder gerenciar este torneio? Busque por CPF ou login de quem já tem conta no Padelizou.</p>
                @{ ViewData["BuscaOrgHiddenName"] = "organizadoresSelecionados"; }
                <partial name="_BuscaOrganizador" />
                @{ ViewData["BuscaOrgHiddenName"] = null; }

                <!-- CATEGORIAS (O CATÁLOGO) -->
                <h5 class="fw-bold text-muted border-bottom pb-2 mb-3 mt-5">4. Categorias Disponíveis neste Torneio</h5>

                <div class="row">
                    <!-- Coluna Masculina -->
                    <div class="col-md-4 mb-4">
                        <h6 class="fw-bold mb-3" style="color: var(--pdz-ink);"><i class="bi bi-gender-male"></i> Masculinas</h6>
                        @foreach (var cat in catalogo.Where(c => c.Tipo == "Masculina"))
                        {
                            <div class="form-check mb-2 d-flex align-items-center gap-2">
                                <div class="flex-grow-1">
                                    <input class="form-check-input border-secondary" type="checkbox" name="categoriasSelecionadas" value="@cat.Id" id="cat_@cat.Id" checked="@categoriasMarcadas.Contains(cat.Id)">
                                    <label class="form-check-label text-muted" for="cat_@cat.Id">@cat.Nome</label>
                                </div>
                                <input type="number" name="limiteCategoria[@cat.Id]" min="1" class="form-control form-control-sm" placeholder="Vagas" style="width: 90px;" title="Limite de duplas nesta categoria (opcional)" />
                            </div>
                        }
                    </div>

                    <!-- Coluna Feminina -->
                    <div class="col-md-4 mb-4">
                        <h6 class="fw-bold mb-3" style="color: var(--padel-green);"><i class="bi bi-gender-female"></i> Femininas</h6>
                        @foreach (var cat in catalogo.Where(c => c.Tipo == "Feminina"))
                        {
                            <div class="form-check mb-2 d-flex align-items-center gap-2">
                                <div class="flex-grow-1">
                                    <input class="form-check-input border-secondary" type="checkbox" name="categoriasSelecionadas" value="@cat.Id" id="cat_@cat.Id" checked="@categoriasMarcadas.Contains(cat.Id)">
                                    <label class="form-check-label text-muted" for="cat_@cat.Id">@cat.Nome</label>
                                </div>
                                <input type="number" name="limiteCategoria[@cat.Id]" min="1" class="form-control form-control-sm" placeholder="Vagas" style="width: 90px;" title="Limite de duplas nesta categoria (opcional)" />
                            </div>
                        }
                    </div>

                    <!-- Coluna Mista -->
                    <div class="col-md-4 mb-4">
                        <h6 class="fw-bold mb-3 text-warning"><i class="bi bi-people-fill"></i> Mistas</h6>
                        @foreach (var cat in catalogo.Where(c => c.Tipo == "Mista"))
                        {
                            <div class="form-check mb-2 d-flex align-items-center gap-2">
                                <div class="flex-grow-1">
                                    <input class="form-check-input border-secondary" type="checkbox" name="categoriasSelecionadas" value="@cat.Id" id="cat_@cat.Id" checked="@categoriasMarcadas.Contains(cat.Id)">
                                    <label class="form-check-label text-muted" for="cat_@cat.Id">@cat.Nome</label>
                                </div>
                                <input type="number" name="limiteCategoria[@cat.Id]" min="1" class="form-control form-control-sm" placeholder="Vagas" style="width: 90px;" title="Limite de duplas nesta categoria (opcional)" />
                            </div>
                        }

                        @* Casal fica na coluna da mista, e não numa quarta: são as duas
                           categorias de dupla com um de cada, e uma coluna só pra um item
                           quebraria a grade de três. *@
                        @if (catalogo.Any(c => c.Tipo == "Casal"))
                        {
                            <h6 class="fw-bold mb-2 mt-4 text-warning"><i class="bi bi-heart-fill"></i> Casal</h6>
                            <p class="small text-muted mb-2">Casais de verdade jogando juntos — sem nível.</p>
                            @foreach (var cat in catalogo.Where(c => c.Tipo == "Casal"))
                            {
                                <div class="form-check mb-2 d-flex align-items-center gap-2">
                                    <div class="flex-grow-1">
                                        <input class="form-check-input border-secondary" type="checkbox" name="categoriasSelecionadas" value="@cat.Id" id="cat_@cat.Id" checked="@categoriasMarcadas.Contains(cat.Id)">
                                        <label class="form-check-label text-muted" for="cat_@cat.Id">@cat.Nome</label>
                                    </div>
                                    <input type="number" name="limiteCategoria[@cat.Id]" min="1" class="form-control form-control-sm" placeholder="Vagas" style="width: 90px;" title="Limite de duplas nesta categoria (opcional)" />
                                </div>
                            }
                        }
                    </div>
                </div>

                @* CATEGORIA DE TIMES: times se enfrentando, como se fossem duplas — grupos e
                   mata-mata, dividindo as mesmas quadras e horários das outras categorias.
                   Jogador não se inscreve nela: os times são cadastrados pelo organizador
                   depois, na tela de times. Escondida no formato Americano (script abaixo). *@
                <div class="card bg-light border-0 p-3 mb-2" id="cardCategoriaTimes">
                    <div class="form-check mb-2">
                        <input class="form-check-input border-secondary" type="checkbox" name="categoriaDeTimes"
                               value="true" id="chkCategoriaTimes"
                               onchange="document.getElementById('configCategoriaTimes').style.display = this.checked ? 'flex' : 'none';">
                        <label class="form-check-label fw-bold" for="chkCategoriaTimes" style="color: var(--pdz-ink);">
                            <i class="bi bi-people-fill"></i> Categoria de times (times se enfrentando)
                        </label>
                        <div class="small text-muted">
                            Você define a estrutura agora e cadastra os times depois, na página do torneio.
                            A conta <strong>grupos × classificados</strong> precisa fechar um quadro de mata-mata (2, 4, 8 ou 16).
                        </div>
                    </div>
                    <div class="gap-2 flex-wrap align-items-end" id="configCategoriaTimes" style="display: none;">
                        <div>
                            <label class="form-label small mb-0">Nome da categoria</label>
                            <input type="text" name="nomeCategoriaTimes" value="Times" maxlength="80"
                                   class="form-control form-control-sm" style="width: 160px;" />
                        </div>
                        <div>
                            <label class="form-label small mb-0">Quantos times</label>
                            <input type="number" name="quantidadeTimes" min="2" max="32" value="8"
                                   class="form-control form-control-sm" style="width: 100px;" />
                        </div>
                        <div>
                            <label class="form-label small mb-0">Quantos grupos</label>
                            <input type="number" name="quantidadeGruposTimes" min="1" max="8" value="2"
                                   class="form-control form-control-sm" style="width: 100px;" />
                        </div>
                        <div>
                            <label class="form-label small mb-0">Classificam por grupo</label>
                            <input type="number" name="classificadosPorGrupoTimes" min="1" max="4" value="2"
                                   class="form-control form-control-sm" style="width: 120px;" />
                        </div>
                    </div>
                </div>

                <hr class="my-4" />
                @* Publicar sobe a capa, cria o torneio, as categorias e as quadras: leva alguns
                   segundos. Sem sinal nenhum na tela, o organizador acha que o clique não pegou
                   e aperta de novo — e o segundo clique é justamente o que criava torneio
                   duplicado. O botão trava a si mesmo e diz o que está fazendo. *@
                <button type="submit" id="pdzPublicar" class="btn btn-padel btn-lg w-100 rounded-pill shadow-sm">
                    <span id="pdzPublicarParado">
                        <i class="bi bi-check-circle-fill"></i> Publicar Torneio e Abrir Inscrições
                    </span>
                    <span id="pdzPublicarIndo" class="d-none">
                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                        Publicando o torneio…
                    </span>
                </button>
            </form>
        </div>
    </div>
</div>

@* Detalhe de prazo fica aqui, atrás de um botão: quem está criando o torneio quer decidir
   o preço, não estudar meio de pagamento. Mas quem precisar do dado, acha. *@
<div class="modal fade" id="modalComoRecebo" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Como e quando você recebe</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <p class="small">
                    O jogador escolhe como quer pagar, e isso <strong>não muda o quanto você recebe</strong> —
                    muda só o prazo. O dinheiro cai direto na sua conta, já com a taxa descontada.
                </p>
                <table class="table table-sm small align-middle">
                    <thead>
                        <tr><th>Se ele pagar com…</th><th class="text-end">Você recebe em</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var forma in taxas.Todas)
                        {
                            <tr class="@(forma.Demora ? "table-warning" : "")">
                                <td>@forma.Nome</td>
                                <td class="text-end @(forma.Demora ? "fw-bold" : "")">@forma.PrazoEscrito</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="small text-danger">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <strong>Cartão de crédito só cai em @taxas.CreditoAVista.PrazoEscrito</strong>, à vista ou
                    parcelado. Se a quadra, a bola e a premiação vencem antes disso, o caixa sai do seu bolso.
                </div>
                <div class="small text-success mt-1">
                    <i class="bi bi-check-circle-fill"></i>
                    <strong>Pix cai na hora.</strong> Se o seu caixa depende das inscrições pra pagar a quadra,
                    é ele que você quer incentivar.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-padel rounded-pill" data-bs-dismiss="modal">Entendi</button>
            </div>
        </div>
    </div>
</div>

<!-- SCRIPT PARA ESCONDER/MOSTRAR AS FASES FINAIS -->
<script>
    function toggleFases() {
        var isUnico = document.getElementById('formatoUnico').checked;
        var fasesExtras = document.querySelectorAll('.fase-extra');

        fasesExtras.forEach(function(el) {
            el.style.display = isUnico ? 'none' : 'block';
        });
    }

    // O turno de QUINTA só existe em torneio que começa na quinta (pedido do Chakra,
    // 06/08/2026: quinta a domingo). Some quando a data muda pra outro dia — e desmarca
    // junto, senão ficaria gravado um turno que a tela não mostra mais.
    function ajustarTurnoDeQuinta() {
        var data = document.getElementById('dataInicio');
        var linha = document.getElementById('linhaImpQuinta');
        if (!data || !linha) return;

        // 'T12:00' evita o fuso comer um dia: 'yyyy-MM-dd' puro é UTC, e no Brasil isso
        // vira 21h do dia anterior — uma quinta lida como quarta.
        var ehQuinta = data.value && new Date(data.value + 'T12:00').getDay() === 4;
        linha.style.display = ehQuinta ? 'block' : 'none';
        if (!ehQuinta) {
            var caixa = document.getElementById('impQuinta');
            if (caixa) caixa.checked = false;
        }
    }

    document.addEventListener('DOMContentLoaded', function () {
        var data = document.getElementById('dataInicio');
        if (data) data.addEventListener('change', ajustarTurnoDeQuinta);
        ajustarTurnoDeQuinta();
    });

    function toggleImpedimentos() {
        var ligado = document.getElementById('impSwitch').checked;
        document.getElementById('turnosImpedimento').style.display = ligado ? 'block' : 'none';
        ajustarTurnoDeQuinta();
    }

    // O nome do torneio entra na mensagem do WhatsApp SE já tiver sido digitado. É melhoria
    // progressiva: o link já sai pronto do servidor com uma mensagem que se explica sozinha,
    // e isto só acrescenta. Se o script não rodar, o botão continua funcionando.
    (function () {
        var botao = document.getElementById('pdzCombinarTaxa');
        var campoNome = document.getElementById('Nome');
        if (!botao || !campoNome) return;

        botao.addEventListener('click', function () {
            var nome = (campoNome.value || '').trim();
            if (!nome) return;
            var url = new URL(botao.href);
            var texto = url.searchParams.get('text') || '';
            if (texto.indexOf(nome) === -1) {
                url.searchParams.set('text', texto + ' O torneio se chama "' + nome + '".');
                botao.href = url.toString();
            }
        });
    })();

    function toggleOculto() {
        var restrito = document.getElementById('restritoSwitch').checked;
        document.getElementById('opcaoOculto').style.display = restrito ? 'block' : 'none';
        document.getElementById('campoChaveAcesso').style.display = restrito ? 'block' : 'none';
        if (!restrito) {
            document.getElementById('ocultoCheck').checked = false;
            // Some da tela E deixa de ir no POST: chave digitada e depois escondida viraria
            // chave de um torneio que não é mais restrito.
            document.getElementById('chaveAcessoEscolhida').value = '';
        }
    }

    // ── Pacote "nós registramos os resultados" ───────────────────────────────────────
    // O resumo mostra o que é FATO (quantas pessoas o torneio pede, por quantos dias) e
    // não inventa preço: quanto custa depende de quem consegue ir e de onde vem, e um
    // valor estimado aqui viraria promessa na cabeça do organizador.
    function toggleRegistro() {
        var ligado = document.getElementById('registroSwitch').checked;
        document.getElementById('blocoRegistro').style.display = ligado ? 'block' : 'none';
        if (ligado) atualizarResumoRegistro();
    }

    // Usa o número que o organizador já digitou no painel "vai caber?" pra dar uma ordem de
    // grandeza. Se ele não digitou nada, não inventa total nenhum: a regra por jogo já está
    // escrita acima, e um número chutado aqui viraria promessa.
    //
    // ⚠️ O total de jogos vem do SERVIDOR (`pdzUltimaPrevisao`), não de uma conta local.
    // Aqui morava uma SEXTA cópia da régua de grupos-de-3 + mata-mata, e ela era aplicada a
    // QUALQUER formato: um Americano de 16 pessoas (60 jogos de verdade) era orçado como se
    // fosse uma chave de 16 duplas (26). Agora o número acompanha o formato escolhido.
    function atualizarResumoRegistro() {
        var alvo = document.getElementById('pdzRegistroResumo');
        if (!alvo) return;

        var previsao = pdzUltimaPrevisao;
        if (!previsao || !previsao.temConta || !previsao.fecha || !previsao.resumo) {
            alvo.textContent = '';
            return;
        }

        var total = Math.max(previsao.totalDeJogos * @(ViewBag.RegistroPrecoPorJogo ?? 12m), @(ViewBag.RegistroValorMinimo ?? 500m));

        alvo.textContent = 'Com ' + previsao.resumo.inscritos + ' seriam ~' + previsao.totalDeJogos
            + ' jogos, algo em torno de R$ ' + total.toFixed(2).replace('.', ',') + '.';
    }

    function gerarCamposQuadra() {
        var quantidade = Math.max(0, Math.min(26, parseInt(document.getElementById('quantidadeQuadras').value, 10) || 0));
        var container = document.getElementById('camposNomesQuadras');
        var valoresAtuais = Array.from(container.querySelectorAll('input')).map(function (i) { return i.value; });

        container.innerHTML = '';
        for (var i = 0; i < quantidade; i++) {
            var col = document.createElement('div');
            col.className = 'col-md-3 col-6';
            var input = document.createElement('input');
            input.type = 'text';
            input.name = 'nomesQuadras';
            input.className = 'form-control form-control-sm';
            input.placeholder = 'Quadra ' + String.fromCharCode(65 + i);
            input.value = valoresAtuais[i] || '';
            col.appendChild(input);
            container.appendChild(col);
        }
    }

    document.addEventListener('DOMContentLoaded', gerarCamposQuadra);

    // Clube: quem escreve o nome manda. Não é escolha da tela, é o que o servidor já faz —
    // vindo nome escrito, AcharOuCriarClubeAsync sobrepõe o ClubeId que o seletor mandou. Com
    // os dois preenchidos, a tela mostrava um clube e o torneio nascia em outro.
    //
    // O seletor é DESATIVADO, e não zerado: navegador não envia campo desativado (então o
    // valor antigo não vai escondido no POST, e o `required` dele não trava o envio), e apagar
    // a escolha faria a pessoa procurar o clube de novo se resolvesse limpar o texto.
    function pdzClubeEscrito() {
        var texto = document.getElementById('pdzNovoClube');
        var lista = document.getElementById('ClubeId');
        var aviso = document.getElementById('pdzAvisoClubeEscrito');
        if (!texto || !lista) return;

        var escreveu = texto.value.trim() !== '';
        lista.disabled = escreveu;
        if (aviso) aviso.classList.toggle('d-none', !escreveu);
    }

    document.addEventListener('DOMContentLoaded', function () {
        var texto = document.getElementById('pdzNovoClube');
        if (texto) texto.addEventListener('input', pdzClubeEscrito);
        // Também na abertura: voltar pra tela (ou uma recusa) pode trazer o campo já escrito.
        pdzClubeEscrito();
    });

    // Torneio por ORDEM esconde tudo que só serve pra montar grade de horário: até quando tem
    // a quadra, duração do jogo, as três horas do dia e o "vai caber?".
    //
    // O `required` sai junto, e isso não é detalhe: campo obrigatório ESCONDIDO faz o navegador
    // recusar o envio do formulário inteiro sem mostrar erro nenhum — a pessoa clica em Criar e
    // não acontece nada. O campo continua HABILITADO (só o required cai), pra que os valores
    // padrão sigam indo no POST: o torneio pode virar "com horário" depois, na tela de gestão,
    // e aí encontra 18h/08h/23h50 no lugar de meia-noite.
    function pdzHorariosDosJogos() {
        var porOrdem = document.getElementById('pdzPorOrdem');
        if (!porOrdem) return;
        var esconder = porOrdem.checked;

        document.querySelectorAll('.pdz-so-com-horario').forEach(function (bloco) {
            bloco.classList.toggle('d-none', esconder);
            bloco.querySelectorAll('input, select').forEach(function (campo) {
                if (esconder) {
                    if (campo.required) { campo.dataset.pdzEraObrigatorio = '1'; campo.required = false; }
                } else if (campo.dataset.pdzEraObrigatorio === '1') {
                    campo.required = true;
                }
            });
        });
    }

    document.addEventListener('DOMContentLoaded', function () {
        ['pdzPorOrdem', 'pdzComHorario'].forEach(function (id) {
            var opcao = document.getElementById(id);
            if (opcao) opcao.addEventListener('change', pdzHorariosDosJogos);
        });
        pdzHorariosDosJogos();
    });

    // "Até X" × "Soma de X": troca os textos da seção de formato e avisa quando o total é PAR.
    // A conta do aviso é a mesma de ContagemDeGamesDoTorneio.PodeEmpatar — soma par alcança o
    // empate (8 fecha em 4x4) e o sistema recusa finalizar jogo empatado.
    function pdzContagem() {
        var soma = (document.getElementById('contagemSoma') || {}).checked;

        var mostrar = function (id, quando) {
            var el = document.getElementById(id);
            if (el) el.style.display = quando ? 'block' : 'none';
        };
        mostrar('dicaContagemAte', !soma);
        mostrar('dicaContagemSoma', soma);

        // O rótulo do campo tem que dizer o que o número significa: "9" quer dizer coisas
        // diferentes em cada modo, e é o rótulo que separa os dois.
        document.querySelectorAll('.pdz-rotulo-games').forEach(function (r) {
            r.textContent = soma ? 'Games no total' : 'Games por Set';
        });

        // O aviso do par olha o campo da fase geral, que é o que vale pra grupo e Americano.
        var geral = document.getElementById('GamesFaseGrupos');
        var n = parseInt((geral || {}).value, 10) || 0;
        var par = soma && n > 0 && n % 2 === 0;
        mostrar('avisoSomaPar', par);
        if (par) {
            var nEl = document.getElementById('avisoSomaParN');
            var meioEl = document.getElementById('avisoSomaParMeio');
            if (nEl) nEl.textContent = n;
            if (meioEl) meioEl.textContent = (n / 2) + 'x' + (n / 2);
        }
    }

    document.addEventListener('DOMContentLoaded', function () {
        var geral = document.getElementById('GamesFaseGrupos');
        if (geral) ['input', 'change'].forEach(function (e) { geral.addEventListener(e, pdzContagem); });
        pdzContagem();
    });

    // As opções do Americano aparecem nos DOIS sabores (individual e de duplas), cada um com
    // os próprios textos — e a categoria de times só existe no formato padrão (os Americanos
    // não têm grupos nem mata-mata de times).
    function pdzOpcoesAmericano() {
        var individual = document.getElementById('formatoAmericano');
        var deDuplas = document.getElementById('formatoAmericanoDuplas');
        if (!individual || !deDuplas) return;
        var algumAmericano = individual.checked || deDuplas.checked;

        function mostrar(id, quando) {
            var el = document.getElementById(id);
            if (el) el.style.display = quando ? 'block' : 'none';
        }

        mostrar('opcoesAmericano', algumAmericano);
        mostrar('soAmericanoIndividual', individual.checked);
        mostrar('soAmericanoDuplas', deDuplas.checked);
        mostrar('dicaDesempateIndividual', !deDuplas.checked);
        mostrar('dicaDesempateDuplas', deDuplas.checked);
        mostrar('dicaFormatoPadrao', !algumAmericano);
        mostrar('dicaFormatoAmericano', individual.checked);
        mostrar('dicaFormatoAmericanoDuplas', deDuplas.checked);

        var cardTimes = document.getElementById('cardCategoriaTimes');
        if (cardTimes) {
            cardTimes.style.display = algumAmericano ? 'none' : 'block';
            if (algumAmericano) {
                var chk = document.getElementById('chkCategoriaTimes');
                if (chk) { chk.checked = false; }
                var config = document.getElementById('configCategoriaTimes');
                if (config) { config.style.display = 'none'; }
            }
        }

        // Check-in, Impedimentos e Ranking RS são conceitos do torneio de chave (Oficial):
        // impedimento é dupla travando um turno antes do sorteio existir, e o Ranking RS
        // nivela categoria por categoria fechada. Nenhum dos dois casa com o Americano —
        // desmarcados também, pra não submeter uma flag ligada que a tela escondeu.
        mostrar('blocoCheckIn', !algumAmericano);
        mostrar('blocoImpedimentos', !algumAmericano);
        mostrar('blocoRankingRs', !algumAmericano);
        if (algumAmericano) {
            ['checkInSwitch', 'impSwitch', 'createRankingRs'].forEach(function (id) {
                var el = document.getElementById(id);
                if (el) el.checked = false;
            });
            var turnos = document.getElementById('turnosImpedimento');
            if (turnos) turnos.style.display = 'none';
        }
    }

    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('[name="Formato"]').forEach(function (r) {
            r.addEventListener('change', pdzOpcoesAmericano);
        });
        pdzOpcoesAmericano();
    });

    // Quanto vai custar pro Americano valer ponto. O organizador ainda não sabe quantos vêm,
    // então a conta sai do número que ele mesmo espera — e some enquanto ele não marca a
    // caixa, pra não parecer cobrança de quem não pediu nada.
    function pdzCustoRanking() {
        var marcado = document.getElementById('pontuaRankingAmericano');
        var alvo = document.getElementById('pdzCustoRanking');
        if (!marcado || !alvo) return;

        if (!marcado.checked) { alvo.style.display = 'none'; return; }

        var esperados = parseInt((document.getElementById('pdzDuplasEsperadas') || {}).value, 10);
        alvo.style.display = 'block';

        // O piso aparece aqui também, e não só no texto acima: é no número que ele acabou de
        // digitar que a pessoa percebe que o Americano dela não alcança.
        if (esperados > 0 && esperados < 8) {
            alvo.innerHTML = 'Com <strong>' + esperados + '</strong> não vale ponto — ' +
                'o Ranking Americano começa em <strong>8 inscritos</strong>. Nada a pagar.';
            return;
        }

        alvo.innerHTML = esperados > 0
            ? 'Com <strong>' + esperados + '</strong> inscritos, dá <strong>R$ ' +
              (esperados * 5).toFixed(2).replace('.', ',') + '</strong>. ' +
              'A conta final é pelo número real de inscritos.'
            : 'O valor final sai do número real de inscritos, no fim das inscrições.';
    }

    document.addEventListener('DOMContentLoaded', function () {
        var esperados = document.getElementById('pdzDuplasEsperadas');
        if (esperados) esperados.addEventListener('input', pdzCustoRanking);
        pdzCustoRanking();
    });

    // A última resposta do servidor, guardada porque TRÊS painéis leem dela (o ritmo do dia,
    // o "vai caber?" e a estimativa do registro) e o painel do registro também é redesenhado
    // quando a pessoa liga o interruptor, sem que campo nenhum tenha mudado.
    var pdzUltimaPrevisao = null;
    var pdzPedidoEmVoo = 0;
    var pdzTimerPrevisao = null;

    // ⚠️ Procura por id E por name, igual ao laço que liga os eventos lá embaixo — e não é
    // preciosismo: em 09/08/2026 o campo da data ganhou um `id="dataInicio"` (pro turno de
    // quinta) que atropelou o `id="DataInicio"` que o asp-for escrevia. Os eventos seguiram
    // disparando (aquele laço já caía no name), mas a data chegava VAZIA ao servidor, e a
    // tela respondia "Preencha a data de início" com a data preenchida na frente da pessoa.
    // Buscar pelos dois é o que faz um id novo não derrubar o painel em silêncio.
    function pdzValor(id) {
        var campo = document.getElementById(id) || document.querySelector('[name="' + id + '"]');
        return campo ? campo.value : '';
    }

    // Uma pergunta só pro servidor, servindo os três painéis — eles saem dos mesmos campos e
    // mudam juntos, então duas requisições só dariam chance de discordarem entre si.
    //
    // ⚠️ Duas proteções que não são luxo: sem o DEBOUNCE, cada tecla digitada no número vira
    // uma requisição; e sem o NÚMERO DE SEQUÊNCIA, a resposta lenta de "5" chegando depois da
    // de "50" repinta a tela com a conta do número que a pessoa já apagou — o tipo de erro
    // que aparece só no 3G do clube.
    function pdzPedirPrevisao() {
        clearTimeout(pdzTimerPrevisao);
        pdzTimerPrevisao = setTimeout(function () {
            var meuPedido = ++pdzPedidoEmVoo;

            var consulta = new URLSearchParams({
                formato: pdzFormatoAtual(),
                numero: pdzValor('pdzDuplasEsperadas') || '0',
                duracao: pdzValor('TempoPrevistoPartidaMinutos') || '0',
                quadras: pdzValor('quantidadeQuadras') || '1',
                horaInicio: pdzValor('HoraInicioDoDia'),
                horaSeguintes: pdzValor('HoraInicioDiasSeguintes'),
                horaFim: pdzValor('HoraFimDoDia'),
                dataInicio: pdzValor('DataInicio'),
                dataFim: pdzValor('DataFim')
            });

            fetch('@Url.Action("Previsao", "Torneios")?' + consulta.toString(),
                  { headers: { 'Accept': 'application/json' } })
                .then(function (resposta) { return resposta.ok ? resposta.json() : null; })
                .catch(function () { return null; })
                .then(function (dados) {
                    // Chegou resposta mais nova enquanto esta viajava: esta já não vale.
                    if (meuPedido !== pdzPedidoEmVoo) return;
                    pdzUltimaPrevisao = dados;
                    pdzDesenharRitmo(dados);
                    pdzDesenharPrevisao(dados);
                    atualizarResumoRegistro();
                });
        }, 250);
    }

    function pdzDesenharRitmo(dados) {
        var alvo = document.getElementById('pdzUltimoJogo');
        if (!alvo) return;

        alvo.style.color = 'var(--pdz-ink)';

        if (!dados || !dados.temRitmo) { alvo.textContent = ''; return; }

        if (dados.diaSemHoraPraAcabar) {
            alvo.style.color = 'var(--pdz-muted)';
            alvo.textContent = 'Sem hora pra acabar: os jogos seguem emendando até o último.';
            return;
        }

        function frase(rotulo, dia) {
            if (!dia) return rotulo + ': o primeiro jogo já passa do limite do dia.';
            return rotulo + ': último jogo começa <strong>' + dia.ultimoComeca
                + '</strong> (termina ' + dia.ultimoTermina + ') — '
                + dia.rodadas + (dia.rodadas > 1 ? ' rodadas' : ' rodada') + ', '
                + dia.jogos + (dia.jogos > 1 ? ' jogos' : ' jogo') + '.';
        }

        alvo.innerHTML = '<i class="bi bi-clock-history me-1"></i>'
            + frase('1º dia', dados.primeiroDia)
            + (dados.diasSeguintesIguais
                ? ''
                : '<br><i class="bi bi-arrow-return-right me-1"></i>' + frase('Dias seguintes', dados.diasSeguintes))
            + '<br><span class="fw-normal text-muted">Com ' + dados.quadras
            + (dados.quadras > 1 ? ' quadras.' : ' quadra.') + '</span>';
    }

    // ── "Vai caber?" ────────────────────────────────────────────────────────────────────
    //
    // ⚠️ AS CONTAS NÃO MORAM MAIS AQUI, e a razão vale ser lida antes de alguém trazer
    // alguma de volta. Até 08/08/2026 esta tela carregava a PRÓPRIA CÓPIA, em JavaScript,
    // de cinco réguas do servidor: grupos de 3 e mata-mata (PrevisaoDoTorneio), o que fecha
    // no Americano individual (DivisaoDoAmericano), o todos-contra-todos de duplas
    // (RodadasAmericanoDeDuplas) e a grade do dia (GradeDeJogos, em dois pedaços). O
    // comentário que ficava aqui admitia o risco com todas as letras — "se estas contas
    // divergirem dos Services, a tela mente pro organizador" — e a cópia estava FORA DO
    // ALCANCE DOS TESTES: a suíte exercita o C#, e nenhum teste lê JavaScript. A divergência
    // só apareceria no dia do torneio, com a quadra reservada e a gente já chamada.
    //
    // Agora o servidor responde (Torneios/Previsao → Services/PrevisaoDoTorneio.ParaATela) e
    // aqui só se DESENHA. A régua pra manter: aritmética no servidor, formatação no navegador.

    function pdzFormatoAtual() {
        var marcado = document.querySelector('input[name="Formato"]:checked');
        return marcado ? marcado.value : 'Padrao';
    }

    function pdzDataHora(d) {
        var dias = ['domingo', 'segunda', 'terça', 'quarta', 'quinta', 'sexta', 'sábado'];
        var dd = ('0' + d.getDate()).slice(-2), mm = ('0' + (d.getMonth() + 1)).slice(-2);
        var hh = ('0' + d.getHours()).slice(-2), mi = ('0' + d.getMinutes()).slice(-2);
        return dias[d.getDay()] + ' ' + dd + '/' + mm + ' às ' + hh + ':' + mi;
    }

    // Rótulo e mínimo do campo mudam com o formato: no Americano individual não existe
    // "dupla" na inscrição, é gente sorteada a cada rodada — por isso a pergunta certa é
    // "quantas pessoas", com o piso de 4 que DivisaoDoAmericano exige.
    function pdzRotuloEspera() {
        var rotulo = document.getElementById('pdzRotuloEspera');
        var input = document.getElementById('pdzDuplasEsperadas');
        if (!rotulo || !input) return;
        if (pdzFormatoAtual() === 'Americano') {
            rotulo.textContent = 'Você espera quantas pessoas?';
            input.min = '4';
        } else {
            rotulo.textContent = 'Você espera quantas duplas?';
            input.min = '2';
        }
    }

    function pdzDesenharPrevisao(dados) {
        var alvo = document.getElementById('pdzPrevisao');
        if (!alvo) return;

        // Rede que falhou não pode virar número errado na tela: some com a conta e diz o que
        // fazer. Mostrar a conta ANTERIOR seria pior — ela responderia a campos que já mudaram.
        if (!dados) {
            alvo.innerHTML = '<span class="text-muted">Não deu pra calcular agora. '
                + 'Mexa em algum campo pra tentar de novo.</span>';
            return;
        }

        if (!dados.temConta) {
            alvo.innerHTML = '<span class="text-muted">Preencha a data de início, os horários e a duração pra ver a conta.</span>';
            return;
        }

        if (!dados.fecha) {
            alvo.innerHTML = '<div class="alert alert-warning mt-0 mb-0 py-2 px-3">'
                + '<i class="bi bi-exclamation-triangle-fill"></i> ' + dados.porQueNaoFecha + '</div>';
            return;
        }

        // O resumo vem em três pedaços justamente pra o negrito ficar aqui, na camada de
        // apresentação, em vez de o servidor devolver HTML.
        var texto = '<strong>' + dados.resumo.inscritos + '</strong>' + dados.resumo.meio
            + '<strong>' + dados.resumo.jogos + '</strong>.'
            + '<br>Começa ' + pdzDataHora(new Date(dados.comeca))
            + ' e o último jogo termina <strong>' + pdzDataHora(new Date(dados.termina)) + '</strong>'
            + ' — ' + dados.dias + (dados.dias > 1 ? ' dias de quadra.' : ' dia de quadra.');

        if (dados.cabeNoPrazo === false) {
            var pf = (pdzValor('DataFim') || '').split('-');
            texto += '<div class="alert alert-danger mt-2 mb-0 py-2 px-3">'
                + '<i class="bi bi-exclamation-triangle-fill"></i> <strong>Não cabe até ' + pf[2] + '/' + pf[1] + '.</strong> '
                + 'Aumente as quadras, encurte o jogo, comece mais cedo ou estenda o prazo.</div>';
        } else if (dados.cabeNoPrazo === true) {
            texto += '<div class="alert alert-success mt-2 mb-0 py-2 px-3">'
                + '<i class="bi bi-check-circle-fill"></i> Cabe dentro do prazo.</div>';
        }

        alvo.innerHTML = texto;
    }

    document.addEventListener('DOMContentLoaded', function () {
        ['TempoPrevistoPartidaMinutos', 'HoraInicioDoDia', 'HoraInicioDiasSeguintes',
         'HoraFimDoDia', 'quantidadeQuadras', 'pdzDuplasEsperadas', 'DataInicio', 'DataFim']
            .forEach(function (id) {
                var el = document.getElementById(id) || document.querySelector('[name="' + id + '"]');
                if (!el) return;
                ['input', 'change'].forEach(function (evt) {
                    el.addEventListener(evt, pdzPedirPrevisao);
                });
            });
        document.querySelectorAll('[name="Formato"]').forEach(function (r) {
            r.addEventListener('change', function () {
                pdzRotuloEspera(); pdzPedirPrevisao();
                if (typeof pdzAtualizarSimulacao === 'function') pdzAtualizarSimulacao();
            });
        });
        pdzRotuloEspera();
        pdzPedirPrevisao();
    });
</script>
@* Simulação ao vivo: o organizador digita o preço e vê, com o número dele, quanto o
   jogador paga e quanto sobra em cada opção. Números vindos do servidor pra tela e
   cobrança nunca divergirem. *@
<script>
    var pdzComissaoMin = @((asaas.ComissaoMinimaPorTipo.TryGetValue("Torneio", out var pisoTorneio)
        ? pisoTorneio : asaas.ComissaoMinima).ToString(System.Globalization.CultureInfo.InvariantCulture));
    // Uma taxa por forma de recebimento — a escolha é do organizador, então ele sabe o
    // quanto recebe antes de anunciar o preço.
    var pdzTaxaPorForma = {
        OnlinePix: @taxas.ComissaoPercentualSomentePix.ToString(System.Globalization.CultureInfo.InvariantCulture),
        OnlineTodas: @taxas.ComissaoPercentualTodasFormas.ToString(System.Globalization.CultureInfo.InvariantCulture),
        Externo: @taxas.ComissaoPercentualExterno.ToString(System.Globalization.CultureInfo.InvariantCulture)
    };

    function pdzMoeda(v) {
        return 'R$ ' + v.toFixed(2).replace('.', ',');
    }

    function pdzAtualizarConta(paga, comissao, recebe, externo, pct, isento) {
        var def = function (id, txt) {
            var e = document.getElementById(id);
            if (e) e.textContent = txt;
        };
        def('pdzJogadorPaga', paga > 0 ? (externo ? pdzMoeda(paga) + ' direto pra você' : pdzMoeda(paga)) : '—');
        def('pdzComissaoValor', comissao > 0 ? '− ' + pdzMoeda(comissao) : '—');
        def('pdzVoceRecebe', recebe > 0 ? pdzMoeda(recebe) : '—');

        // Isento não tem piso nenhum pra citar — "mín. R$ 4" junto de "0%" mentiria que o
        // piso ainda vale. Por fora ele recebe tudo na hora e paga a taxa depois — "você
        // recebe" também mentiria nesse caso.
        def('pdzComissaoRotulo', isento
            ? '− Taxa do Padelizou (Americano não paga taxa: R$ 0,00)'
            : externo
                ? '− Taxa do Padelizou (' + pct + '%, você paga depois)'
                : '− Taxa do Padelizou (' + pct + '%, mín. ' + pdzMoeda(pdzComissaoMin) + ')');
        def('pdzRecebeRotulo', externo && !isento ? '= Fica com você, por jogador' : '= Você recebe, por jogador');

        // ⚠️ OS SELOS DAS TRÊS FORMAS TAMBÉM PRECISAM SABER DA ISENÇÃO.
        //
        // A conta aqui embaixo já dizia "R$ 0,00" pro Americano sem Ranking, mas os selos
        // ("taxa 10%", "taxa 5%") eram texto fixo — a mesma tela afirmava duas coisas
        // contrárias, e a que o olho pega primeiro é o selo, que fica colado no nome da opção.
        //
        // Pior que feio: no "Por fora" havia ainda o aviso de que **as chaves só saem depois
        // de pagar a taxa**. Pro Americano isento essa trava NÃO existe
        // (TaxaDoTorneioExterno.SeAplica já o dispensa), então o texto prometia um bloqueio
        // que nunca vai acontecer — e assusta na hora de escolher como receber.
        document.querySelectorAll('.pdz-selo-taxa').forEach(function (selo) {
            if (selo.dataset.original === undefined) selo.dataset.original = selo.textContent;
            selo.textContent = isento ? 'sem taxa' : selo.dataset.original;
            selo.classList.toggle('bg-success', isento || selo.dataset.original.indexOf(' a ') < 0);
            selo.classList.toggle('bg-secondary', !isento && selo.dataset.original.indexOf(' a ') >= 0);
        });

        var condicao = document.getElementById('pdzCondicaoExterno');
        if (condicao) condicao.style.display = isento ? 'none' : '';
    }

    function pdzAtualizarSimulacao() {
        var caixa = document.getElementById('pdzSimulacao');
        if (!caixa) return;

        var preco = parseFloat((document.getElementById('precoInscricao') || {}).value) || 0;
        var escolhido = document.querySelector('input[name="FormaPagamento"]:checked');
        var forma = escolhido ? escolhido.value : 'OnlinePix';
        var externo = forma === 'Externo';

        // Antes do desvio do preço zerado: a chave Pix depende só da FORMA, e escondê-la
        // porque o valor ainda não foi digitado seria esconder por motivo errado.
        var blocoPix = document.getElementById('pdzBlocoPix');
        if (blocoPix) blocoPix.style.display = externo ? 'block' : 'none';

        // O Americano NÃO paga percentual, em nenhuma forma — espelha
        // CobrancaDoTorneio.IsentoDeTaxa no servidor. A cobrança dele é outra: R$ 5 por
        // pessoa se comprar o Ranking Americano, acertada por fora. ⚠️ Marcar "valer ponto"
        // NÃO devolve o percentual — isso cobrava as duas coisas, e cobrou num torneio real.
        var isentoAmericano = pdzFormatoAtual() !== 'Padrao';

        if (preco <= 0) {
            caixa.textContent = 'Informe o valor da inscrição pra ver a conta.';
            pdzAtualizarConta(0, 0, 0, false, 0, isentoAmericano);
            return;
        }

        // O jogador paga exatamente o valor anunciado; a taxa sai de dentro dele.
        var pct = isentoAmericano ? 0 : pdzTaxaPorForma[forma];

        // Isenção de verdade zera a taxa; o piso mínimo (R$ 4) só existe pra cobrança
        // pequena não sumir, não pode reaparecer escondido atrás da isenção do Americano
        // (mesma régua de AsaasService.CalcularRateio: percentual 0 explícito ignora o piso).
        var taxa = isentoAmericano ? 0
            : externo
                ? preco * pct / 100
                : Math.max(preco * pct / 100, pdzComissaoMin);
        var recebe = preco - taxa;

        pdzAtualizarConta(preco, taxa, recebe, externo, pct, isentoAmericano);

        // No Americano individual a inscrição é por PESSOA, não por dupla (mesma régua de
        // Torneio.PessoasPorInscricao) — "uma dupla paga" não existe nesse formato.
        var individual = pdzFormatoAtual() === 'Americano';
        var pessoas = individual ? 1 : 2;
        var quem = individual ? 'Uma pessoa' : 'Uma dupla';
        caixa.innerHTML = externo
            ? quem + ' te paga <strong>' + pdzMoeda(preco * pessoas) + '</strong> direto, e você deve ' +
              pdzMoeda(taxa * pessoas) + ' ao Padelizou depois.'
            : quem + ' paga <strong>' + pdzMoeda(preco * pessoas) + '</strong> e entram ' +
              pdzMoeda(recebe * pessoas) + ' pra você.';
    }

    document.addEventListener('DOMContentLoaded', pdzAtualizarSimulacao);
</script>

<script>
    // Prazo e "perde a vaga" só fazem sentido quando dá pra se inscrever sem pagar.
    function pdzPrazoVisivel() {
        var obrigatorio = document.getElementById('pagObrigatorio');
        var bloco = document.getElementById('pdzBlocoPrazo');
        if (obrigatorio && bloco) bloco.style.display = obrigatorio.checked ? 'none' : 'block';
    }
    document.addEventListener('DOMContentLoaded', pdzPrazoVisivel);

    // ── Campos de dinheiro ──────────────────────────────────────────────────────────────
    // Duas coisas: o valor aparece sempre com centavos (R$ 150 vira "150.00", pra ninguém
    // achar que o campo é de inteiro), e ao receber o foco ele se seleciona inteiro — sem
    // isso, quem quer 300 num campo com 150 digita "3" e fica com 1503.
    function pdzCentavos(el) {
        if (!el || el.value === '') return;
        var n = parseFloat(el.value);
        if (!isNaN(n)) el.value = n.toFixed(2);
    }

    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('.pdz-dinheiro').forEach(function (el) {
            pdzCentavos(el);
            el.addEventListener('blur', function () { pdzCentavos(el); });
            el.addEventListener('focus', function () { setTimeout(function () { el.select(); }, 0); });
            // O Chrome desfaz a seleção no mouseup depois do clique; sem isto, selecionar
            // sozinho só funcionaria pra quem chega no campo pelo Tab.
            el.addEventListener('mouseup', function (ev) { ev.preventDefault(); });
        });

        // Recusa nasce no topo, botão fica no pé: sem trazer a tela até ela, publicar
        // parecia não fazer nada.
        var erro = document.getElementById('pdzErroCriacao');
        if (erro) {
            erro.scrollIntoView({ behavior: 'smooth', block: 'center' });
            erro.focus({ preventScroll: true });
        }

        // Publicar leva alguns segundos (capa + torneio + categorias + quadras). O evento
        // submit só dispara depois da validação do navegador, então campo obrigatório em
        // branco não deixa o botão travado em "Publicando…".
        var form = document.getElementById('pdzFormCriacao');
        var botao = document.getElementById('pdzPublicar');
        if (form && botao) {
            form.addEventListener('submit', function () {
                botao.disabled = true;
                document.getElementById('pdzPublicarParado').classList.add('d-none');
                document.getElementById('pdzPublicarIndo').classList.remove('d-none');
            });
        }
    });
</script>
