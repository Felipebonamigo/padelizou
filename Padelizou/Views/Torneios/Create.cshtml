@model Padelizou.Models.Torneio
@inject Microsoft.Extensions.Options.IOptions<Padelizou.Services.TaxasExibicao> TaxasOpcoes
@inject Microsoft.Extensions.Options.IOptions<Padelizou.Services.AsaasSettings> AsaasOpcoes
@{
    ViewData["Title"] = "Criar Novo Torneio";
    var catalogo = ViewBag.CatalogoCategorias as List<padelizou.Models.CategoriaPadrao>;
    var catalogoClubes = ViewBag.CatalogoClubes as List<Padelizou.Models.Clube>;
    var taxas = TaxasOpcoes.Value;
    var asaas = AsaasOpcoes.Value;
    var comissaoOnline = asaas.ComissaoPercentualPorTipo.TryGetValue("Torneio", out var p) ? p : asaas.ComissaoPercentualPadrao;
}

<div class="container mt-4 mb-5">
    <div class="card shadow-sm border-0" style="border-top: 4px solid var(--pdz-navy-fixed);">
        <div class="card-body p-4 p-md-5">
            <h2 class="fw-bold mb-4" style="color: var(--pdz-ink);"><i class="bi bi-trophy-fill"></i> Criar Novo Torneio</h2>

            @if (ViewBag.Erro != null)
            {
                <div class="alert alert-danger">@ViewBag.Erro</div>
            }

            <form asp-action="Create" method="post" enctype="multipart/form-data">

                <!-- DADOS BÁSICOS DO TORNEIO -->
                <h5 class="fw-bold text-muted border-bottom pb-2 mb-3">1. Informações Gerais</h5>

                <div class="row mb-3">
                    <div class="col-12">
                        <label class="form-label fw-bold small">Formato do Torneio</label>
                        <div class="d-flex gap-3">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="Formato" id="formatoPadrao" value="Padrao" checked>
                                <label class="form-check-label" for="formatoPadrao">Torneio Padrão (duplas fixas)</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="Formato" id="formatoAmericano" value="Americano">
                                <label class="form-check-label" for="formatoAmericano">Torneio Americano (parceiros rotativos)</label>
                            </div>
                        </div>
                        <small class="text-muted d-block mt-1">No Americano, cada jogador se inscreve individualmente e joga com um parceiro diferente a cada rodada.</small>

                        @* Só faz sentido no Americano — no formato de duplas o mata-mata já
                           resolve quem é campeão. *@
                        <div id="opcoesAmericano" class="mt-3 p-3 rounded" style="display: none; background-color: var(--pdz-surface-alt);">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" asp-for="DesempateAmericano" id="desempateAmericano" />
                                <label class="form-check-label fw-bold" for="desempateAmericano">
                                    Se der empate em games na liderança, jogar uma partida final
                                </label>
                            </div>
                            <small class="text-muted d-block mt-1">
                                Cada empatado escolhe um parceiro e sai um jogo só, pra decidir o título.
                                Desligado, o critério do empate fica com você.
                            </small>
                        </div>
                    </div>
                </div>
                @* "Local / Clube" saiu daqui: era o mesmo dado do "Clube Responsável" logo
                   abaixo, pedido duas vezes. O local do torneio passa a vir do clube. *@
                <div class="row mb-3">
                    <div class="col-12">
                        <label class="form-label fw-bold small">Nome do Torneio</label>
                        <input type="text" asp-for="Nome" class="form-control bg-light" required placeholder="Ex: Padel Garden Open" />
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-12">
                        <label class="form-label fw-bold small">Imagem de Capa (Opcional)</label>
                        <input type="file" name="capa" class="form-control" accept="image/*" />
                        <small class="text-muted d-block mt-1">Aparece como cartaz do torneio na Home e na listagem de Torneios.</small>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-4">
                        <label class="form-label fw-bold small">Clube Responsável</label>
                        @{ var temClube = catalogoClubes != null && catalogoClubes.Any(); }
                        @* Sem clube nenhum cadastrado, um select obrigatorio e vazio trava a
                           criacao do torneio. Entao aqui tambem da pra escrever o nome. *@
                        <select asp-for="ClubeId" class="form-select bg-light" required="@temClube">
                            <option value="">@(temClube ? "-- Selecione o clube --" : "-- Nenhum cadastrado ainda --")</option>
                            @if (catalogoClubes != null)
                            {
                                foreach (var clube in catalogoClubes)
                                {
                                    <option value="@clube.Id">@clube.Nome</option>
                                }
                            }
                        </select>
                        <input type="text" name="novoClubeNome" class="form-control form-control-sm mt-2"
                               maxlength="80" placeholder="Não achou? Escreva o nome do clube" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold small">Data de Início</label>
                        <input type="date" asp-for="DataInicio" class="form-control bg-light" required />

                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold small">Precisa terminar até <span class="fw-normal">(opcional)</span></label>
                        <input type="date" asp-for="DataFim" class="form-control bg-light" />
                        <small class="text-muted d-block mt-1">Até quando você tem a quadra. Serve pro sistema avisar se os jogos não couberem.</small>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold small">Inscrição <span class="fw-normal">(por pessoa)</span></label>
                        <input type="number" asp-for="PrecoInscricao" id="precoInscricao" step="0.01" class="form-control bg-light" required placeholder="Ex: 75,00" oninput="pdzAtualizarSimulacao()" />
                        <small class="text-muted d-block mt-1">É o valor que cada jogador paga. Uma dupla paga o dobro.</small>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold small">Qtd. de Quadras Disponíveis</label>
                        <input type="number" asp-for="QuantidadeQuadras" id="quantidadeQuadras" min="1" class="form-control bg-light" required placeholder="Ex: 3" oninput="gerarCamposQuadra()" />
                        <small class="text-muted d-block mt-1">Quantos jogos rodam ao mesmo tempo na grade.</small>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold small">Duração de cada jogo</label>
                        <div class="input-group">
                            <input type="number" asp-for="TempoPrevistoPartidaMinutos" min="10" max="180" class="form-control bg-light" required />
                            <span class="input-group-text">min</span>
                        </div>
                    </div>
                    @* Duas aberturas porque o torneio de fim de semana tem duas: sexta à
                       noite (todo mundo trabalha de dia) e sábado/domingo cedo. *@
                    <div class="col-md-8">
                        <label class="form-label fw-bold small">Horários dos jogos</label>
                        <div class="row g-2">
                            <div class="col-6 col-md-4">
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text">1º dia</span>
                                    <input type="time" asp-for="HoraInicioDoDia" class="form-control bg-light" required />
                                </div>
                            </div>
                            <div class="col-6 col-md-4">
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text">demais</span>
                                    <input type="time" asp-for="HoraInicioDiasSeguintes" class="form-control bg-light" required />
                                </div>
                            </div>
                            <div class="col-12 col-md-4">
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text">último jogo até</span>
                                    <input type="time" asp-for="HoraFimDoDia" class="form-control bg-light" required />
                                </div>
                            </div>
                        </div>
                        @* O organizador escolhe a janela sem saber onde ela cai: com jogo de
                           1h a partir das 18h, o teto de 23h50 vira 23h — a cadência não
                           alcança 23h50. Melhor ele ver isso antes de anunciar. *@
                        <small id="pdzUltimoJogo" class="d-block mt-1 fw-bold" style="color: var(--pdz-ink);"></small>
                        <small class="text-muted d-block mt-1">
                            É a hora em que o último jogo <strong>começa</strong> — ele pode virar a madrugada.
                            O que não couber no dia vai pro seguinte.
                        </small>
                    </div>

                    @* "Cabe?" é a pergunta que nenhum campo responde sozinho: depende do número
                       de jogos, que depende de quantas duplas entram. Na criação ninguém sabe
                       ainda, então o organizador estima e o sistema mostra onde isso termina. *@
                    <div class="col-12">
                        <div class="p-3 rounded" style="background-color: var(--pdz-surface-alt); border-left: 4px solid var(--pdz-lime);">
                            <label class="form-label fw-bold small mb-2" style="color: var(--pdz-ink);">
                                <i class="bi bi-calendar-check me-1"></i> Vai caber?
                            </label>
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <span class="small text-muted">Você espera quantas duplas?</span>
                                <input type="number" id="pdzDuplasEsperadas" min="2" max="256" value="16"
                                       class="form-control form-control-sm" style="width: 90px;" />
                                <span class="small text-muted">(só pra simular — não é limite)</span>
                            </div>
                            <div id="pdzPrevisao" class="mt-2 small"></div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold small">Limite total de duplas no torneio (opcional)</label>
                        <input type="number" asp-for="LimiteDuplasTotal" min="1" class="form-control bg-light" placeholder="Sem limite" />
                        <small class="text-muted d-block mt-1">Somando todas as categorias. Quem se inscrever depois de esgotado vai pra lista de espera.</small>
                    </div>
                </div>

                @* ── Como o dinheiro vai correr ────────────────────────────────────────
                   O organizador precisa decidir isso de olhos abertos: o cartão de
                   crédito só cai 32 dias depois, e quadra e premiação vencem antes. *@
                <div class="mb-4 p-3 rounded" style="background-color: var(--pdz-surface-alt); border-left: 4px solid var(--pdz-lime);">
                    <label class="form-label fw-bold" style="color: var(--pdz-ink);">
                        <i class="bi bi-cash-coin me-1"></i> Como você vai receber as inscrições?
                    </label>

                    @* A taxa muda com a escolha do ORGANIZADOR, nunca com a forma que o jogador
                       escolhe no checkout: o split é fixado quando a cobrança nasce, e ele
                       precisa saber quanto recebe antes de anunciar o preço. *@
                    <div class="form-check p-3 rounded mb-2" style="border: 1px solid var(--pdz-border);">
                        <input class="form-check-input" type="radio" asp-for="FormaPagamento" value="OnlinePix"
                               id="pagPix" checked onchange="pdzAtualizarSimulacao()" />
                        <label class="form-check-label w-100" for="pagPix">
                            <span class="fw-bold">Pelo site, só Pix</span>
                            <span class="badge bg-success ms-1">taxa @taxas.ComissaoPercentualSomentePix.ToString("0.#")%</span>
                            <div class="small text-muted mt-1">
                                O jogador paga por Pix na hora de se inscrever e a vaga já nasce confirmada.
                                <strong>O dinheiro cai na sua conta na hora.</strong> É a opção mais barata —
                                e no padel, Pix é como quase todo mundo paga.
                            </div>
                        </label>
                    </div>

                    <div class="form-check p-3 rounded mb-2" style="border: 1px solid var(--pdz-border);">
                        <input class="form-check-input" type="radio" asp-for="FormaPagamento" value="OnlineTodas"
                               id="pagTodas" onchange="pdzAtualizarSimulacao()" />
                        <label class="form-check-label w-100" for="pagTodas">
                            <span class="fw-bold">Pelo site, todas as formas</span>
                            <span class="badge bg-secondary ms-1">taxa @taxas.ComissaoPercentualTodasFormas.ToString("0.#")%</span>
                            <div class="small text-muted mt-1">
                                Pix, boleto, débito e cartão de crédito — inclusive parcelado. Facilita pra quem
                                não tem o valor à vista, mas custa mais e o cartão demora a cair.
                                <button type="button" class="btn btn-link btn-sm p-0 align-baseline"
                                        data-bs-toggle="modal" data-bs-target="#modalComoRecebo">
                                    Ver os prazos
                                </button>
                            </div>
                        </label>
                    </div>

                    <div class="form-check p-3 rounded" style="border: 1px solid var(--pdz-border);">
                        <input class="form-check-input" type="radio" asp-for="FormaPagamento" value="Externo"
                               id="pagExterno" onchange="pdzAtualizarSimulacao()" />
                        <label class="form-check-label w-100" for="pagExterno">
                            <span class="fw-bold">Por fora</span>
                            <span class="badge bg-success ms-1">taxa @taxas.ComissaoPercentualExterno.ToString("0.#")%</span>
                            <div class="small text-muted mt-1">
                                Você combina Pix ou dinheiro direto com o jogador. O Padelizou
                                <strong>não toca no dinheiro</strong>: cuida só da organização — chaves, jogos,
                                placar ao vivo e ranking. Depois você paga a taxa sobre o que foi inscrito.
                            </div>
                            <div class="small text-muted mt-1">
                                <i class="bi bi-info-circle"></i>
                                Em compensação, cobrar é por sua conta: o sistema não tem como saber quem pagou.
                            </div>
                        </label>
                    </div>

                    @* A conta enxuta: quanto o jogador paga, quanto é taxa, quanto sobra.
                       Só isso — o resto (prazos, formas de pagamento) vive no modal. *@
                    <div class="border rounded p-3 mt-3 mb-3" style="background: var(--pdz-surface);">
                        <table class="table table-sm mb-0 align-middle">
                            <tbody>
                                <tr>
                                    <td class="small">Cada jogador paga</td>
                                    <td class="text-end fw-bold" id="pdzJogadorPaga">—</td>
                                </tr>
                                <tr class="text-danger">
                                    <td class="small" id="pdzComissaoRotulo">− Taxa do Padelizou</td>
                                    <td class="text-end fw-bold" id="pdzComissaoValor">—</td>
                                </tr>
                                <tr class="border-top">
                                    <td class="fw-bold" id="pdzRecebeRotulo">= Você recebe, por jogador</td>
                                    <td class="text-end fw-bold fs-5 text-success" id="pdzVoceRecebe">—</td>
                                </tr>
                            </tbody>
                        </table>
                        <div id="pdzSimulacao" class="small text-muted mt-2"></div>
                    </div>

                    <div class="border-top pt-3">
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" asp-for="PagamentoObrigatorioNaInscricao"
                                   id="pagObrigatorio" onchange="pdzPrazoVisivel()" style="transform: scale(1.2); margin-right: 8px;" />
                            <label class="form-check-label fw-bold small" for="pagObrigatorio">
                                Só confirmo a inscrição depois de pago
                            </label>
                            <div class="small text-muted ps-1">
                                Ligado, a vaga só existe com o pagamento — acaba o calote e o "depois eu te acerto".
                                Desligado, o jogador garante a vaga na hora e acerta com você depois.
                            </div>
                        </div>

                        <div id="pdzBlocoPrazo" style="display:none;" class="ps-1">
                            <div class="row g-2 align-items-end">
                                <div class="col-md-5">
                                    <label class="form-label fw-bold small mb-1">Prazo pra pagar (opcional)</label>
                                    <input type="date" asp-for="PrazoPagamento" class="form-control form-control-sm" />
                                </div>
                                <div class="col-md-7">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" asp-for="ExcluirSeNaoPagar" id="excluirSeNaoPagar" />
                                        <label class="form-check-label small" for="excluirSeNaoPagar">
                                            Quem não pagar até o prazo <strong>perde a vaga</strong>
                                        </label>
                                        <div class="small text-muted">
                                            Desmarcado, a inscrição fica só como "não paga" e você resolve na mão.
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-12">
                        <label class="form-label fw-bold small">Nome de cada Quadra (opcional)</label>
                        <div id="camposNomesQuadras" class="row g-2"></div>
                    </div>
                </div>
                <div class="row mb-4">
                    <div class="col-md-12">
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" asp-for="PermiteImpedimentos" id="impSwitch" onchange="toggleImpedimentos()" style="transform: scale(1.3); margin-right: 10px;">
                            <label class="form-check-label fw-bold text-muted" for="impSwitch">Permitir Impedimentos de Horário?</label>
                        </div>
                        <div id="turnosImpedimento" class="ps-4" style="display: none;">
                            <p class="small text-muted mb-2">Quais turnos as duplas podem marcar como impedimento?</p>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" asp-for="PermiteImpedimentoSextaNoite" id="impSexta">
                                <label class="form-check-label" for="impSexta">Sexta à noite</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" asp-for="PermiteImpedimentoSabadoManha" id="impSabManha">
                                <label class="form-check-label" for="impSabManha">Sábado de manhã</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" asp-for="PermiteImpedimentoSabadoTarde" id="impSabTarde">
                                <label class="form-check-label" for="impSabTarde">Sábado à tarde</label>
                            </div>

                            @* Cada impedimento tira uma janela da grade. Cobrar por isso faz
                               quem realmente precisa pagar pela flexibilidade que tirou, e
                               desestimula quem marca "por via das dúvidas". *@
                            <div class="mt-3" style="max-width: 320px;">
                                <label class="form-label fw-bold small mb-1" for="taxaImpedimento">
                                    Cobrar a mais por impedimento?
                                </label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text">R$</span>
                                    <input type="number" asp-for="TaxaPorImpedimento" id="taxaImpedimento"
                                           step="0.01" min="0" class="form-control" placeholder="0,00" />
                                </div>
                                <small class="text-muted d-block mt-1">
                                    Cobrado <strong>por impedimento marcado</strong>, somado à inscrição.
                                    Deixe zerado pra não cobrar nada.
                                </small>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-12">
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" asp-for="Restrito" id="restritoSwitch" onchange="toggleOculto()" style="transform: scale(1.3); margin-right: 10px;">
                            <label class="form-check-label fw-bold text-muted" for="restritoSwitch">
                                <i class="bi bi-key-fill"></i> Torneio Restrito (exige chave de acesso pra se inscrever)
                            </label>
                        </div>
                        <small class="text-muted d-block">Ao publicar, o sistema gera uma chave de 6 caracteres. Só quem tiver essa chave consegue se inscrever — você compartilha com quem quiser convidar.</small>

                        <div id="opcaoOculto" class="ps-4 mt-2" style="display: none;">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" asp-for="Oculto" id="ocultoCheck">
                                <label class="form-check-label" for="ocultoCheck">
                                    <i class="bi bi-eye-slash"></i> Ocultar este torneio da listagem pública (só quem tiver o link direto consegue ver)
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-12">
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" asp-for="PermiteMultiplasCategorias" id="multiCatSwitch" style="transform: scale(1.3); margin-right: 10px;">
                            <label class="form-check-label fw-bold text-muted" for="multiCatSwitch">
                                <i class="bi bi-layers-fill"></i> Permitir o mesmo jogador em mais de uma categoria
                            </label>
                        </div>
                        <small class="text-muted d-block">
                            Ligado (padrão): o jogador pode disputar quantas categorias quiser.
                            Desligado: cada jogador fica preso a uma categoria só — útil pra evitar choque de horário no dia do torneio.
                        </small>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-12">
                        <label class="form-label fw-bold text-muted" for="createRestricaoCat">
                            <i class="bi bi-shield-lock"></i> Restrição de categoria (anti-sandbagging)
                        </label>
                        <select class="form-select" asp-for="RestricaoCategoria" id="createRestricaoCat">
                            <option value="Livre">Tudo liberado (sem restrição)</option>
                            <option value="SaiuChave">Passou da fase de grupos (mata-mata)</option>
                            <option value="Semifinal">Chegou à semifinal</option>
                            <option value="Final">Chegou à final</option>
                        </select>
                        <div class="small text-muted mt-2">
                            Impede que um jogador se inscreva numa categoria <strong>mais fraca</strong> do que outra em que já provou nível.
                            O gatilho define o que conta como prova. Ex.: com "chegou à final", quem foi vice/campeão da 4ª só entra na 4ª ou acima (3ª, 2ª, Open).
                            Vale por jogador; quem nunca jogou torneio entra em qualquer categoria. Dá pra liberar caso a caso na inscrição.
                        </div>
                    </div>
                </div>

                <!-- REGRAS DE SETS E GAMES -->
                <h5 class="fw-bold text-muted border-bottom pb-2 mb-3 mt-5">2. Formato das Partidas</h5>

                <div class="form-check form-switch mb-3 p-3 rounded" style="background-color: var(--pdz-surface-alt);">
                    <input class="form-check-input ms-0 me-2" type="checkbox" asp-for="FormatoUnico" id="formatoUnico" checked onchange="toggleFases()" style="transform: scale(1.3);">
                    <label class="form-check-label fw-bold ms-2" for="formatoUnico" style="color: var(--pdz-ink);">
                        Formato Único (Todas as partidas do torneio terão a mesma regra)
                    </label>
                </div>

                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="card bg-light border-0 p-3 h-100">
                            <h6 class="fw-bold" style="color: var(--pdz-ink);">Fase de Grupos (ou Geral)</h6>
                            <label class="small text-muted mt-2">Quantidade de Sets</label>
                            <input type="number" asp-for="SetsFaseGrupos" class="form-control mb-2" value="1" required />
                            <label class="small text-muted">Games por Set</label>
                            <input type="number" asp-for="GamesFaseGrupos" class="form-control" value="9" required />
                        </div>
                    </div>

                    <!-- Fases Finais (Escondidas por padrão pelo JS) -->
                    <div class="col-md-4 fase-extra" style="display: none;">
                        <div class="card bg-light border-0 p-3 h-100">
                            <h6 class="fw-bold text-secondary">Fases Eliminatórias (Mata-Mata)</h6>
                            <label class="small text-muted mt-2">Quantidade de Sets</label>
                            <input type="number" asp-for="SetsFaseMataMata" class="form-control mb-2" value="1" />
                            <label class="small text-muted">Games por Set</label>
                            <input type="number" asp-for="GamesFaseMataMata" class="form-control" value="9" />
                        </div>
                    </div>

                    <div class="col-md-4 fase-extra" style="display: none;">
                        <div class="card bg-light border-0 p-3 h-100">
                            <h6 class="fw-bold text-danger">A Grande Final</h6>
                            <label class="small text-muted mt-2">Quantidade de Sets</label>
                            <input type="number" asp-for="SetsFaseFinal" class="form-control mb-2" value="3" />
                            <label class="small text-muted">Games por Set</label>
                            <input type="number" asp-for="GamesFaseFinal" class="form-control" value="6" />
                        </div>
                    </div>
                </div>

                <!-- OUTROS ORGANIZADORES -->
                <h5 class="fw-bold text-muted border-bottom pb-2 mb-3 mt-5">3. Outros Organizadores (opcional)</h5>
                <p class="small text-muted mt-n2 mb-3">Além de você, quem mais vai poder gerenciar este torneio? Busque por CPF ou login de quem já tem conta no Padelizou.</p>
                @{ ViewData["BuscaOrgHiddenName"] = "organizadoresSelecionados"; }
                <partial name="_BuscaOrganizador" />
                @{ ViewData["BuscaOrgHiddenName"] = null; }

                <!-- CATEGORIAS (O CATÁLOGO) -->
                <h5 class="fw-bold text-muted border-bottom pb-2 mb-3 mt-5">4. Categorias Disponíveis neste Torneio</h5>

                <div class="row">
                    <!-- Coluna Masculina -->
                    <div class="col-md-4 mb-4">
                        <h6 class="fw-bold mb-3" style="color: var(--pdz-ink);"><i class="bi bi-gender-male"></i> Masculinas</h6>
                        @foreach (var cat in catalogo.Where(c => c.Tipo == "Masculina"))
                        {
                            <div class="form-check mb-2 d-flex align-items-center gap-2">
                                <div class="flex-grow-1">
                                    <input class="form-check-input border-secondary" type="checkbox" name="categoriasSelecionadas" value="@cat.Id" id="cat_@cat.Id">
                                    <label class="form-check-label text-muted" for="cat_@cat.Id">@cat.Nome</label>
                                </div>
                                <input type="number" name="limiteCategoria[@cat.Id]" min="1" class="form-control form-control-sm" placeholder="Vagas" style="width: 90px;" title="Limite de duplas nesta categoria (opcional)" />
                            </div>
                        }
                    </div>

                    <!-- Coluna Feminina -->
                    <div class="col-md-4 mb-4">
                        <h6 class="fw-bold mb-3" style="color: var(--padel-green);"><i class="bi bi-gender-female"></i> Femininas</h6>
                        @foreach (var cat in catalogo.Where(c => c.Tipo == "Feminina"))
                        {
                            <div class="form-check mb-2 d-flex align-items-center gap-2">
                                <div class="flex-grow-1">
                                    <input class="form-check-input border-secondary" type="checkbox" name="categoriasSelecionadas" value="@cat.Id" id="cat_@cat.Id">
                                    <label class="form-check-label text-muted" for="cat_@cat.Id">@cat.Nome</label>
                                </div>
                                <input type="number" name="limiteCategoria[@cat.Id]" min="1" class="form-control form-control-sm" placeholder="Vagas" style="width: 90px;" title="Limite de duplas nesta categoria (opcional)" />
                            </div>
                        }
                    </div>

                    <!-- Coluna Mista -->
                    <div class="col-md-4 mb-4">
                        <h6 class="fw-bold mb-3 text-warning"><i class="bi bi-people-fill"></i> Mistas</h6>
                        @foreach (var cat in catalogo.Where(c => c.Tipo == "Mista"))
                        {
                            <div class="form-check mb-2 d-flex align-items-center gap-2">
                                <div class="flex-grow-1">
                                    <input class="form-check-input border-secondary" type="checkbox" name="categoriasSelecionadas" value="@cat.Id" id="cat_@cat.Id">
                                    <label class="form-check-label text-muted" for="cat_@cat.Id">@cat.Nome</label>
                                </div>
                                <input type="number" name="limiteCategoria[@cat.Id]" min="1" class="form-control form-control-sm" placeholder="Vagas" style="width: 90px;" title="Limite de duplas nesta categoria (opcional)" />
                            </div>
                        }
                    </div>
                </div>

                <hr class="my-4" />
                <button type="submit" class="btn btn-padel btn-lg w-100 rounded-pill shadow-sm">
                    <i class="bi bi-check-circle-fill"></i> Publicar Torneio e Abrir Inscrições
                </button>
            </form>
        </div>
    </div>
</div>

@* Detalhe de prazo fica aqui, atrás de um botão: quem está criando o torneio quer decidir
   o preço, não estudar meio de pagamento. Mas quem precisar do dado, acha. *@
<div class="modal fade" id="modalComoRecebo" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Como e quando você recebe</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <p class="small">
                    O jogador escolhe como quer pagar, e isso <strong>não muda o quanto você recebe</strong> —
                    muda só o prazo. O dinheiro cai direto na sua conta, já com a taxa descontada.
                </p>
                <table class="table table-sm small align-middle">
                    <thead>
                        <tr><th>Se ele pagar com…</th><th class="text-end">Você recebe em</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var forma in taxas.Todas)
                        {
                            <tr class="@(forma.Demora ? "table-warning" : "")">
                                <td>@forma.Nome</td>
                                <td class="text-end @(forma.Demora ? "fw-bold" : "")">@forma.PrazoEscrito</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="small text-danger">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <strong>Cartão de crédito só cai em @taxas.CreditoAVista.PrazoEscrito</strong>, à vista ou
                    parcelado. Se a quadra, a bola e a premiação vencem antes disso, o caixa sai do seu bolso.
                </div>
                <div class="small text-success mt-1">
                    <i class="bi bi-check-circle-fill"></i>
                    <strong>Pix cai na hora.</strong> Se o seu caixa depende das inscrições pra pagar a quadra,
                    é ele que você quer incentivar.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-padel rounded-pill" data-bs-dismiss="modal">Entendi</button>
            </div>
        </div>
    </div>
</div>

<!-- SCRIPT PARA ESCONDER/MOSTRAR AS FASES FINAIS -->
<script>
    function toggleFases() {
        var isUnico = document.getElementById('formatoUnico').checked;
        var fasesExtras = document.querySelectorAll('.fase-extra');

        fasesExtras.forEach(function(el) {
            el.style.display = isUnico ? 'none' : 'block';
        });
    }

    function toggleImpedimentos() {
        var ligado = document.getElementById('impSwitch').checked;
        document.getElementById('turnosImpedimento').style.display = ligado ? 'block' : 'none';
    }

    function toggleOculto() {
        var restrito = document.getElementById('restritoSwitch').checked;
        document.getElementById('opcaoOculto').style.display = restrito ? 'block' : 'none';
        if (!restrito) {
            document.getElementById('ocultoCheck').checked = false;
        }
    }

    function gerarCamposQuadra() {
        var quantidade = Math.max(0, Math.min(26, parseInt(document.getElementById('quantidadeQuadras').value, 10) || 0));
        var container = document.getElementById('camposNomesQuadras');
        var valoresAtuais = Array.from(container.querySelectorAll('input')).map(function (i) { return i.value; });

        container.innerHTML = '';
        for (var i = 0; i < quantidade; i++) {
            var col = document.createElement('div');
            col.className = 'col-md-3 col-6';
            var input = document.createElement('input');
            input.type = 'text';
            input.name = 'nomesQuadras';
            input.className = 'form-control form-control-sm';
            input.placeholder = 'Quadra ' + String.fromCharCode(65 + i);
            input.value = valoresAtuais[i] || '';
            col.appendChild(input);
            container.appendChild(col);
        }
    }

    document.addEventListener('DOMContentLoaded', gerarCamposQuadra);

    // As opções do Americano só aparecem quando o formato é Americano.
    function pdzOpcoesAmericano() {
        var bloco = document.getElementById('opcoesAmericano');
        var americano = document.getElementById('formatoAmericano');
        if (bloco && americano) bloco.style.display = americano.checked ? 'block' : 'none';
    }

    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('[name="Formato"]').forEach(function (r) {
            r.addEventListener('change', pdzOpcoesAmericano);
        });
        pdzOpcoesAmericano();
    });

    // Mesma regra do GradeDeJogos: o limite é a hora em que o último jogo COMEÇA, e ele só
    // começa nos horários que a cadência alcança.
    function pdzEmMinutos(hhmm) {
        var p = /^(\d{1,2}):(\d{2})/.exec(hhmm || '');
        return p ? parseInt(p[1], 10) * 60 + parseInt(p[2], 10) : null;
    }

    function pdzEmRelogio(minutos) {
        var h = Math.floor(minutos / 60) % 24, m = minutos % 60;
        return (h < 10 ? '0' : '') + h + ':' + (m < 10 ? '0' : '') + m;
    }

    // Quantas rodadas cabem e a que horas o último jogo começa, num dia que abre às `abre`.
    function pdzDia(abre, teto, duracao) {
        if (teto <= abre) return null;
        var rodadas = Math.floor((teto - abre) / duracao) + 1;
        return { rodadas: rodadas, ultimo: abre + (rodadas - 1) * duracao };
    }

    function pdzUltimoJogo() {
        var alvo = document.getElementById('pdzUltimoJogo');
        if (!alvo) return;

        var duracao = parseInt((document.getElementById('TempoPrevistoPartidaMinutos') || {}).value, 10) || 0;
        var quadras = Math.max(1, parseInt((document.getElementById('quantidadeQuadras') || {}).value, 10) || 1);
        var primeiro = pdzEmMinutos((document.getElementById('HoraInicioDoDia') || {}).value);
        var seguintes = pdzEmMinutos((document.getElementById('HoraInicioDiasSeguintes') || {}).value);
        var teto = pdzEmMinutos((document.getElementById('HoraFimDoDia') || {}).value);

        alvo.style.color = 'var(--pdz-ink)';

        if (duracao <= 0 || primeiro === null || seguintes === null || teto === null) {
            alvo.textContent = '';
            return;
        }

        if (teto <= seguintes) {
            alvo.style.color = 'var(--pdz-muted)';
            alvo.textContent = 'Sem hora pra acabar: os jogos seguem emendando até o último.';
            return;
        }

        function frase(rotulo, dia) {
            if (dia === null) return rotulo + ': o primeiro jogo já passa do limite do dia.';
            var jogos = dia.rodadas * quadras;
            return rotulo + ': último jogo começa <strong>' + pdzEmRelogio(dia.ultimo)
                + '</strong> (termina ' + pdzEmRelogio(dia.ultimo + duracao) + ') — '
                + dia.rodadas + (dia.rodadas > 1 ? ' rodadas' : ' rodada') + ', '
                + jogos + (jogos > 1 ? ' jogos' : ' jogo') + '.';
        }

        var d1 = pdzDia(primeiro, teto, duracao);
        var d2 = pdzDia(seguintes, teto, duracao);

        alvo.innerHTML = '<i class="bi bi-clock-history me-1"></i>'
            + frase('1º dia', d1)
            + (primeiro === seguintes ? '' : '<br><i class="bi bi-arrow-return-right me-1"></i>' + frase('Dias seguintes', d2))
            + '<br><span class="fw-normal text-muted">Com ' + quadras
            + (quadras > 1 ? ' quadras.' : ' quadra.') + '</span>';
    }

    // ── "Vai caber?" ────────────────────────────────────────────────────────────────────
    // Espelha PrevisaoDoTorneio e GradeDeJogos. Se as duas contas divergirem, a tela mente.

    function pdzFaseDeGrupos(duplas) {
        if (duplas < 2) return { grupos: 0, jogos: 0 };
        if (duplas < 3) return { grupos: 1, jogos: 1 };
        var resto = duplas % 3;
        var gruposDeDois = resto === 1 ? 2 : (resto === 2 ? 1 : 0);
        var gruposDeTres = (duplas - gruposDeDois * 2) / 3;
        return { grupos: gruposDeDois + gruposDeTres, jogos: gruposDeDois + gruposDeTres * 3 };
    }

    function pdzMataMata(grupos) {
        if (grupos <= 0) return 0;
        if (grupos === 1) return 1;
        var quadro = 1;
        while (quadro * 2 <= grupos * 2) quadro *= 2;
        return quadro - 1;
    }

    // Mesma marcha do GradeDeJogos: N quadras em paralelo, vira o dia ao passar do teto.
    function pdzUltimoHorario(inicio, teto, aberturaSeguintes, quadras, duracao, jogos) {
        var aberturaDoDia = new Date(inicio.getTime());
        var horario = new Date(inicio.getTime());
        var naQuadra = 0;
        var viraODia = teto > aberturaSeguintes;

        for (var i = 0; i < jogos; i++) {
            if (naQuadra === quadras) {
                horario = new Date(horario.getTime() + duracao * 60000);
                naQuadra = 0;
                if (viraODia) {
                    var limite = new Date(aberturaDoDia.getFullYear(), aberturaDoDia.getMonth(),
                                          aberturaDoDia.getDate(), 0, teto, 0);
                    if (horario > limite) {
                        aberturaDoDia = new Date(aberturaDoDia.getFullYear(), aberturaDoDia.getMonth(),
                                                 aberturaDoDia.getDate() + 1, 0, aberturaSeguintes, 0);
                        horario = new Date(aberturaDoDia.getTime());
                    }
                }
            }
            naQuadra++;
        }
        return horario;
    }

    function pdzDataHora(d) {
        var dias = ['domingo', 'segunda', 'terça', 'quarta', 'quinta', 'sexta', 'sábado'];
        var dd = ('0' + d.getDate()).slice(-2), mm = ('0' + (d.getMonth() + 1)).slice(-2);
        var hh = ('0' + d.getHours()).slice(-2), mi = ('0' + d.getMinutes()).slice(-2);
        return dias[d.getDay()] + ' ' + dd + '/' + mm + ' às ' + hh + ':' + mi;
    }

    function pdzPrevisao() {
        var alvo = document.getElementById('pdzPrevisao');
        if (!alvo) return;

        var duplas = parseInt((document.getElementById('pdzDuplasEsperadas') || {}).value, 10) || 0;
        var duracao = parseInt((document.getElementById('TempoPrevistoPartidaMinutos') || {}).value, 10) || 0;
        var quadras = Math.max(1, parseInt((document.getElementById('quantidadeQuadras') || {}).value, 10) || 1);
        var abre = pdzEmMinutos((document.getElementById('HoraInicioDoDia') || {}).value);
        var seguintes = pdzEmMinutos((document.getElementById('HoraInicioDiasSeguintes') || {}).value);
        var teto = pdzEmMinutos((document.getElementById('HoraFimDoDia') || {}).value);
        var dataInicio = (document.getElementById('DataInicio') || {}).value;
        var dataFim = (document.getElementById('DataFim') || {}).value;

        if (!duplas || duplas < 2 || !duracao || abre === null || seguintes === null || teto === null || !dataInicio) {
            alvo.innerHTML = '<span class="text-muted">Preencha a data de início, os horários e a duração pra ver a conta.</span>';
            return;
        }

        var g = pdzFaseDeGrupos(duplas);
        var jogosMata = pdzMataMata(g.grupos);
        var total = g.jogos + jogosMata;

        var partes = dataInicio.split('-');
        var inicio = new Date(+partes[0], +partes[1] - 1, +partes[2], 0, abre, 0);
        var ultimo = pdzUltimoHorario(inicio, teto, seguintes, quadras, duracao, total);
        var fimReal = new Date(ultimo.getTime() + duracao * 60000);
        var dias = Math.round((new Date(ultimo.getFullYear(), ultimo.getMonth(), ultimo.getDate())
                             - new Date(inicio.getFullYear(), inicio.getMonth(), inicio.getDate())) / 86400000) + 1;

        var texto = '<strong>' + duplas + ' duplas</strong> = ' + g.grupos + ' grupos, '
            + g.jogos + ' jogos de grupo + ' + jogosMata + ' de mata-mata = <strong>' + total + ' jogos</strong>.'
            + '<br>Começa ' + pdzDataHora(inicio) + ' e o último jogo termina <strong>' + pdzDataHora(fimReal) + '</strong>'
            + ' — ' + dias + (dias > 1 ? ' dias de quadra.' : ' dia de quadra.');

        if (dataFim) {
            var pf = dataFim.split('-');
            var limite = new Date(+pf[0], +pf[1] - 1, +pf[2], 23, 59, 59);
            if (ultimo > limite) {
                texto += '<div class="alert alert-danger mt-2 mb-0 py-2 px-3">'
                    + '<i class="bi bi-exclamation-triangle-fill"></i> <strong>Não cabe até ' + pf[2] + '/' + pf[1] + '.</strong> '
                    + 'Aumente as quadras, encurte o jogo, comece mais cedo ou estenda o prazo.</div>';
            } else {
                texto += '<div class="alert alert-success mt-2 mb-0 py-2 px-3">'
                    + '<i class="bi bi-check-circle-fill"></i> Cabe dentro do prazo.</div>';
            }
        }

        alvo.innerHTML = texto;
    }

    document.addEventListener('DOMContentLoaded', function () {
        ['TempoPrevistoPartidaMinutos', 'HoraInicioDoDia', 'HoraInicioDiasSeguintes',
         'HoraFimDoDia', 'quantidadeQuadras', 'pdzDuplasEsperadas', 'DataInicio', 'DataFim']
            .forEach(function (id) {
                var el = document.getElementById(id);
                if (!el) return;
                ['input', 'change'].forEach(function (evt) {
                    el.addEventListener(evt, function () { pdzUltimoJogo(); pdzPrevisao(); });
                });
            });
        pdzUltimoJogo();
        pdzPrevisao();
    });
</script>
@* Simulação ao vivo: o organizador digita o preço e vê, com o número dele, quanto o
   jogador paga e quanto sobra em cada opção. Números vindos do servidor pra tela e
   cobrança nunca divergirem. *@
<script>
    var pdzComissaoMin = @asaas.ComissaoMinima.ToString(System.Globalization.CultureInfo.InvariantCulture);
    // Uma taxa por forma de recebimento — a escolha é do organizador, então ele sabe o
    // quanto recebe antes de anunciar o preço.
    var pdzTaxaPorForma = {
        OnlinePix: @taxas.ComissaoPercentualSomentePix.ToString(System.Globalization.CultureInfo.InvariantCulture),
        OnlineTodas: @taxas.ComissaoPercentualTodasFormas.ToString(System.Globalization.CultureInfo.InvariantCulture),
        Externo: @taxas.ComissaoPercentualExterno.ToString(System.Globalization.CultureInfo.InvariantCulture)
    };

    function pdzMoeda(v) {
        return 'R$ ' + v.toFixed(2).replace('.', ',');
    }

    function pdzAtualizarConta(paga, comissao, recebe, externo, pct) {
        var def = function (id, txt) {
            var e = document.getElementById(id);
            if (e) e.textContent = txt;
        };
        def('pdzJogadorPaga', paga > 0 ? (externo ? pdzMoeda(paga) + ' direto pra você' : pdzMoeda(paga)) : '—');
        def('pdzComissaoValor', comissao > 0 ? '− ' + pdzMoeda(comissao) : '—');
        def('pdzVoceRecebe', recebe > 0 ? pdzMoeda(recebe) : '—');

        // Por fora ele recebe tudo na hora e paga a taxa depois — "você recebe" mentiria.
        def('pdzComissaoRotulo', externo
            ? '− Taxa do Padelizou (' + pct + '%, você paga depois)'
            : '− Taxa do Padelizou (' + pct + '%, mín. ' + pdzMoeda(pdzComissaoMin) + ')');
        def('pdzRecebeRotulo', externo ? '= Fica com você, por jogador' : '= Você recebe, por jogador');
    }

    function pdzAtualizarSimulacao() {
        var caixa = document.getElementById('pdzSimulacao');
        if (!caixa) return;

        var preco = parseFloat((document.getElementById('precoInscricao') || {}).value) || 0;
        var escolhido = document.querySelector('input[name="FormaPagamento"]:checked');
        var forma = escolhido ? escolhido.value : 'OnlinePix';
        var externo = forma === 'Externo';

        if (preco <= 0) {
            caixa.textContent = 'Informe o valor da inscrição pra ver a conta.';
            pdzAtualizarConta(0, 0, 0, false, 0);
            return;
        }

        // O jogador paga exatamente o valor anunciado; a taxa sai de dentro dele.
        var pct = pdzTaxaPorForma[forma];
        var taxa = externo
            ? preco * pct / 100
            : Math.max(preco * pct / 100, pdzComissaoMin);
        var recebe = preco - taxa;

        pdzAtualizarConta(preco, taxa, recebe, externo, pct);

        // Uma dupla são duas pessoas: quem se inscreve paga as duas de uma vez.
        caixa.innerHTML = externo
            ? 'Uma dupla te paga <strong>' + pdzMoeda(preco * 2) + '</strong> direto, e você deve ' +
              pdzMoeda(taxa * 2) + ' ao Padelizou depois.'
            : 'Uma dupla paga <strong>' + pdzMoeda(preco * 2) + '</strong> e entram ' +
              pdzMoeda(recebe * 2) + ' pra você.';
    }

    document.addEventListener('DOMContentLoaded', pdzAtualizarSimulacao);
</script>

<script>
    // Prazo e "perde a vaga" só fazem sentido quando dá pra se inscrever sem pagar.
    function pdzPrazoVisivel() {
        var obrigatorio = document.getElementById('pagObrigatorio');
        var bloco = document.getElementById('pdzBlocoPrazo');
        if (obrigatorio && bloco) bloco.style.display = obrigatorio.checked ? 'none' : 'block';
    }
    document.addEventListener('DOMContentLoaded', pdzPrazoVisivel);
</script>
