@model Padelizou.Models.Partida
@*
    Uma vaga do chaveamento: o jogo com os dois lados e o placar, ou o buraco à espera de
    quem passar. O horário e a quadra ficam no cabeçalho da vaga porque é a pergunta que o
    jogador leva pro quadro — "que horas eu jogo e onde".
*@
@{
    var jogo = Model;
}

@if (jogo == null)
{
    <div class="pdz-chave-vaga pdz-chave-vaga-vazia">
        <span class="pdz-chave-lado"><span class="pdz-chave-nome text-muted">A definir</span></span>
        <span class="pdz-chave-lado"><span class="pdz-chave-nome text-muted">A definir</span></span>
    </div>
}
else
{
    var venceu1 = jogo.VencedorId == jogo.Dupla1Id;
    var venceu2 = jogo.VencedorId == jogo.Dupla2Id;
    var aoVivo = jogo.Status == "AoVivo";

    // O mesmo chip do grupo (foto, selo do time e nome com sobrenome), e não o primeiro nome:
    // ver _ChaveDoMataMata. 14/10/2026.
    var chipComSelo = new ViewDataDictionary(ViewData) { ["EscudoComoSelo"] = true };

    <div class="pdz-chave-vaga @(aoVivo ? "pdz-chave-vaga-aovivo" : "")">
        <div class="pdz-chave-quando">
            @if (aoVivo)
            {
                <span class="pdz-chave-aovivo">● AO VIVO</span>
            }
            else if (jogo.HorarioPrevisto is DateTime h)
            {
                <span>@h.ToString("dd/MM HH:mm")</span>
            }
            else
            {
                <span>por ordem</span>
            }

            @if (LugarDoJogo.Etiqueta(ViewData.Sedes(), jogo.NomeQuadra, jogo.CategoriaId, jogo.ClubeId) is { } ondeJoga)
            {
                <span class="pdz-chave-quadra">@ondeJoga</span>
            }
        </div>

        <span class="pdz-chave-lado pdz-chave-lado-chips @(venceu1 ? "pdz-chave-venceu" : venceu2 ? "text-muted" : "")">
            <span class="pdz-chave-nome pdz-chave-nome-chips pdz-chip-compacto"><partial name="_LadoDaPartida" model="jogo.Dupla1" view-data="chipComSelo" /></span>
            <span class="pdz-chave-games">@Padelizou.Services.PlacarNaTela.DaChave(jogo.Status, jogo.GamesDupla1)</span>
        </span>
        <span class="pdz-chave-lado pdz-chave-lado-chips @(venceu2 ? "pdz-chave-venceu" : venceu1 ? "text-muted" : "")">
            <span class="pdz-chave-nome pdz-chave-nome-chips pdz-chip-compacto"><partial name="_LadoDaPartida" model="jogo.Dupla2" view-data="chipComSelo" /></span>
            <span class="pdz-chave-games">@Padelizou.Services.PlacarNaTela.DaChave(jogo.Status, jogo.GamesDupla2)</span>
        </span>
    </div>
}
