@model Padelizou.ViewModels.PlanejamentoDeQuadrasVM
@using System.Globalization
@{
    ViewData["Title"] = $"Planejamento de quadras — {Model.Torneio.Nome}";
    var ptBr = CultureInfo.GetCultureInfo("pt-BR");
    var plano = Model.Plano;

    // Horas em HH:mm: `TimeSpan.ToString()` sai "18:00:00", que <input type="time"> recusa.
    string Hora(TimeSpan t) => $"{(int)t.TotalHours % 24:00}:{t.Minutes:00}";

    // "12 horários" vira "10h00" — é assim que o clube cobra quadra alugada, e é o número que
    // o organizador leva pra negociar.
    string EmHoras(int minutos) => minutos < 60
        ? $"{minutos} min"
        : $"{minutos / 60}h{(minutos % 60 == 0 ? "" : (minutos % 60).ToString("00"))}";
}

<div class="container mt-4 mb-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div>
            <h2 class="fw-bold mb-0" style="color: var(--pdz-ink);">
                <i class="bi bi-calendar-range"></i> Planejamento de quadras
            </h2>
            <p class="text-muted small mb-0">@Model.Torneio.Nome</p>
        </div>
        <a asp-action="Details" asp-route-id="@Model.Torneio.Id" class="btn btn-outline-secondary rounded-pill px-3">
            <i class="bi bi-arrow-left"></i> Torneio
        </a>
    </div>

    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success"><i class="bi bi-check-circle-fill"></i> @TempData["Sucesso"]</div>
    }
    @if (TempData["Erro"] != null)
    {
        <div class="alert alert-danger"><i class="bi bi-exclamation-triangle-fill"></i> @TempData["Erro"]</div>
    }

    @* ── NÃO CABE: A PERGUNTA DO SORTEIO (11/11/2026) ─────────────────────────────────────
       🗣️ Felipe: "caso não caiba, avise na hora de gerar as chaves, e pergunte o que fazer com o
       que falta, se vai adicionar mais horários ou vai adicionar mais quadras". O GerarChaves
       manda pra cá — antes de sortear (pela conta) ou depois (pela grade de verdade). As duas
       respostas levam à tabela que resolve; a terceira, só antes, sorteia assim mesmo.
       (GerarChavesPerguntaQuandoNaoCabeTests) *@
    @{
        var naoCabeAntes = TempData["NaoCabe"] as string;
        var naoCabeDepois = TempData["NaoCabeDepoisDoSorteio"] as string;
    }
    @if (naoCabeAntes != null || naoCabeDepois != null)
    {
        var quantos = naoCabeAntes ?? naoCabeDepois;
        <div class="card border-danger shadow-sm mb-3">
            <div class="card-body">
                <h5 class="fw-bold text-danger mb-2">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    @if (naoCabeAntes != null)
                    {
                        <text>Não cabe: faltam @quantos @(quantos == "1" ? "jogo" : "jogos") pra fechar o torneio até @Model.Torneio.DataFim?.ToString("dd/MM")</text>
                    }
                    else
                    {
                        <text>Chaves sorteadas, mas @quantos @(quantos == "1" ? "jogo ficou" : "jogos ficaram") sem horário</text>
                    }
                </h5>
                <p class="mb-3">
                    @if (naoCabeAntes != null)
                    {
                        <text>As chaves <strong>ainda não foram sorteadas</strong>. O que você quer fazer com o que falta?</text>
                    }
                    else
                    {
                        <text>As chaves ainda não estão públicas. O que você quer fazer com o que falta? Depois do ajuste,
                        grave em <strong>Aplicar horários ao torneio</strong>, no fim da página — ele refaz a grade.</text>
                    }
                </p>
                <div class="d-flex flex-wrap gap-2">
                    <a href="#dia-a-dia" class="btn btn-primary rounded-pill px-3">
                        <i class="bi bi-clock-history"></i> Adicionar mais horários
                    </a>
                    <a href="#quadras-do-torneio" class="btn btn-primary rounded-pill px-3">
                        <i class="bi bi-grid-3x3-gap"></i> Adicionar mais quadras
                    </a>
                    @if (naoCabeAntes != null && !Model.SoLeitura)
                    {
                        <form asp-action="GerarChaves" asp-route-id="@Model.Torneio.Id" method="post" class="d-inline"
                              data-confirmar-titulo="Sortear mesmo sem caber?"
                              data-confirmar="Os jogos que não couberem ficam sem horário — nunca depois do último dia. Dá pra ajustar horários e quadras depois e aplicar de novo."
                              data-confirmar-ok="Sortear mesmo assim"
                              data-confirmar-tom="perigo">
                            <input type="hidden" name="sortearMesmoSemCaber" value="true" />
                            <button type="submit" class="btn btn-outline-danger rounded-pill px-3">
                                <i class="bi bi-diagram-3"></i> Sortear mesmo assim
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    }

    @* ⚠️ ESTE AVISO JÁ MENTIU (09/09/2026). Ele nasceu quando a tela inteira era leitura e
       dizia "mexer nos campos não muda nada no torneio" — mas a tabela de quadras grava na
       hora, e o "Aplicar" no rodapé grava os horários. 🗣️ Felipe: "é uma mentira, não? pq se
       coloca lá embaixo para alterar, ele salva essas alterações". Agora o aviso separa as
       duas metades da tela, que é a informação de que ele precisa antes de mexer em qualquer
       campo. *@
    <div class="alert alert-light border small">
        <div class="d-flex align-items-start gap-2 mb-2">
            <i class="bi bi-pencil-square fs-5 text-success"></i>
            <div>
                <strong>As quadras (logo abaixo) gravam na hora.</strong> Nome, local e horário de cada
                quadra são do torneio de verdade — cada linha tem o próprio botão de salvar.
            </div>
        </div>
        <div class="d-flex align-items-start gap-2 mb-0">
            <i class="bi bi-calculator fs-5"></i>
            <div>
                <strong>O resto é simulação</strong>, pra responder <em>“quantas quadras e quantos horários
                eu preciso?”</em> antes de fechar com o clube: gire os campos à vontade que nada muda no
                torneio — só o botão <strong>Aplicar horários</strong>, no fim da página, grava.
                <strong>Nenhum dos dois remarca jogo que já tem horário.</strong>
            </div>
        </div>
    </div>

    @* ── AS QUADRAS DE VERDADE ────────────────────────────────────────────────────────────
       🗣️ Felipe: "crie uma tabela também, para que possa controlar as quadras que estarão
       disponíveis, se são no mesmo clube ou não, e quais horários elas irão receber (de que
       horas até que horas, cada quadra)".

       ⚠️ ESTE BLOCO GRAVA, ao contrário de tudo abaixo dele. Cada linha é um <form> próprio
       (POST por quadra), e o bloco fica FORA do <form method="get"> da simulação de propósito:
       formulário dentro de formulário é HTML inválido, e o navegador fecharia o de fora no
       primeiro <form> de dentro — levando junto os botões da simulação.

       Local: o clube do torneio é a opção padrão (grava nulo — a convenção de sempre); os
       outros vêm do catálogo. Falta um? Ele se cadastra em Pagamentos › Quadras e sedes
       ("Adicionar clube"), e aparece aqui na volta. *@
    <div class="card shadow-sm mb-3" id="quadras-do-torneio">
        <div class="card-header fw-bold d-flex flex-wrap justify-content-between align-items-center gap-2"
             style="background-color: var(--pdz-surface-alt); color: var(--pdz-ink);">
            <span><i class="bi bi-grid-3x3-gap"></i> Quadras deste torneio</span>
            <span class="small fw-normal text-muted">
                @Model.Quadras.Count de @Model.MaximoDeQuadras · este bloco <strong>grava</strong>
            </span>
        </div>
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead>
                    <tr class="small text-muted">
                        <th style="min-width: 160px;">Nome</th>
                        <th style="min-width: 180px;">Local</th>
                        <th style="min-width: 190px;">Disponível de</th>
                        <th style="min-width: 190px;">Último jogo começa até</th>
                        <th style="min-width: 130px;">Rende</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var quadra in Model.Quadras)
                {
                    <tr>
                        @* Uma linha = um formulário. `form` attribute liga cada campo ao seu
                           <form> sem aninhar tags dentro da tabela. *@
                        @{ var formId = $"quadra-{quadra.Id}"; }
                        <td>
                            <form method="post" asp-action="SalvarQuadraDoPlanejamento" asp-route-id="@Model.Torneio.Id" id="@formId" class="d-none"></form>
                            <input type="hidden" name="quadraId" value="@quadra.Id" form="@formId" />
                            <input type="text" name="nome" maxlength="60" required class="form-control form-control-sm"
                                   value="@quadra.Nome" form="@formId" @(Model.SoLeitura ? "disabled" : "") />
                        </td>
                        <td>
                            <select name="clubeId" class="form-select form-select-sm" form="@formId" @(Model.SoLeitura ? "disabled" : "")>
                                <option value="@Model.Torneio.ClubeId" selected="@(quadra.ClubeId == null || quadra.ClubeId == Model.Torneio.ClubeId)">
                                    @Model.NomeDoClubeDoTorneio (aqui)
                                </option>
                                @foreach (var clube in Model.Clubes.Where(c => c.Id != Model.Torneio.ClubeId))
                                {
                                    <option value="@clube.Id" selected="@(quadra.ClubeId == clube.Id)">@clube.Nome</option>
                                }
                            </select>
                        </td>
                        @* ⚠️ CAMPO VAZIO VIRA O EXPEDIENTE DO TORNEIO, e não fica em branco:
                           "ficou bastante dado em branco, preencha" (Felipe). Salvar a linha
                           assim devolve NULO ao banco — SalvarQuadraDoPlanejamento reconhece a
                           janela do torneio inteiro —, então mostrar não vira gravar. *@
                        @{
                            var de = quadra.DisponivelDe ?? Model.AberturaDoTorneio;
                            var ate = quadra.DisponivelAte ?? Model.FechamentoDoTorneio;
                            var rende = Padelizou.Services.SedesDoTorneio.JogosQueCabemNaJanela(
                                1, quadra.DisponivelDe, quadra.DisponivelAte, Model.Duracao);
                        }
                        <td>
                            <input type="datetime-local" name="de" class="form-control form-control-sm" form="@formId"
                                   value="@de.ToString("yyyy-MM-dd\\THH:mm")" @(Model.SoLeitura ? "disabled" : "") />
                        </td>
                        <td>
                            <input type="datetime-local" name="ate" class="form-control form-control-sm" form="@formId"
                                   value="@ate.ToString("yyyy-MM-dd\\THH:mm")" @(Model.SoLeitura ? "disabled" : "") />
                        </td>
                        @* O número com que o organizador raciocina ("vão ser 12 jogos"), e a
                           hora em que a quadra de fato vaga — que é a pergunta seguinte dele. *@
                        <td class="small">
                            @if (rende is int jogosDaQuadra)
                            {
                                <span class="fw-bold">@jogosDaQuadra @(jogosDaQuadra == 1 ? "jogo" : "jogos")</span>
                                <br />
                                <span class="text-muted">vaga @ate.AddMinutes(Model.Duracao).ToString("HH:mm")</span>
                            }
                            else
                            {
                                <span class="text-muted">torneio inteiro</span>
                            }
                        </td>
                        <td class="text-nowrap">
                            @if (!Model.SoLeitura)
                            {
                                <button type="submit" form="@formId" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                    <i class="bi bi-check2"></i> Salvar
                                </button>
                                <form method="post" asp-action="RemoverQuadraDoPlanejamento" asp-route-id="@Model.Torneio.Id" class="d-inline"
                                      onsubmit="return confirm('Remover a quadra @quadra.Nome?');">
                                    <input type="hidden" name="quadraId" value="@quadra.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3" title="Remover">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.SoLeitura && Model.Quadras.Count < Model.MaximoDeQuadras)
                {
                    <tr style="background-color: var(--pdz-surface-alt);">
                        <td>
                            <form method="post" asp-action="SalvarQuadraDoPlanejamento" asp-route-id="@Model.Torneio.Id" id="quadra-nova" class="d-none"></form>
                            @* Tudo já preenchido a partir da ÚLTIMA quadra: nome numerado, mesmo
                               local, mesma janela. É como se cadastra a Radar 2 depois da Radar 1
                               (Services/PlanejamentoDeQuadras.SugerirProximaQuadra). *@
                            <input type="text" name="nome" maxlength="60" required class="form-control form-control-sm"
                                   value="@Model.NovaQuadra.Nome" form="quadra-nova" />
                        </td>
                        <td>
                            <select name="clubeId" class="form-select form-select-sm" form="quadra-nova">
                                <option value="@Model.Torneio.ClubeId" selected="@(Model.NovaQuadra.ClubeId == null)">
                                    @Model.NomeDoClubeDoTorneio (aqui)
                                </option>
                                @foreach (var clube in Model.Clubes.Where(c => c.Id != Model.Torneio.ClubeId))
                                {
                                    <option value="@clube.Id" selected="@(Model.NovaQuadra.ClubeId == clube.Id)">@clube.Nome</option>
                                }
                            </select>
                        </td>
                        <td>
                            <input type="datetime-local" name="de" class="form-control form-control-sm" form="quadra-nova"
                                   value="@((Model.NovaQuadra.De ?? Model.AberturaDoTorneio).ToString("yyyy-MM-dd\\THH:mm"))" />
                        </td>
                        <td>
                            <input type="datetime-local" name="ate" class="form-control form-control-sm" form="quadra-nova"
                                   value="@((Model.NovaQuadra.Ate ?? Model.FechamentoDoTorneio).ToString("yyyy-MM-dd\\THH:mm"))" />
                        </td>
                        <td class="small text-muted">—</td>
                        <td class="text-nowrap">
                            <button type="submit" form="quadra-nova" class="btn btn-sm btn-success rounded-pill px-3">
                                <i class="bi bi-plus-circle"></i> Adicionar
                            </button>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <div class="card-footer small text-muted">
            <strong>“Último jogo começa até”</strong> é a hora do último jogo, e ele entra na conta: das
            <strong>8:00 às 12:10</strong> com jogos de 50 min saem 6 rodadas — 8:00, 8:50, 9:40, 10:30,
            11:20 e 12:10 — que em 2 quadras são <strong>12 jogos</strong>, e a quadra vaga às 13:00.
            <br />
            Deixar a janela igual ao expediente do torneio é o mesmo que <strong>sem limite</strong>: a
            quadra vale o torneio inteiro e acompanha uma eventual mudança de data.
            Mudou quadra depois do sorteio? Use <strong>Refazer grade</strong>, na aba de jogos.
        </div>
    </div>

<form method="get" asp-action="Planejamento" asp-route-id="@Model.Torneio.Id" id="simulacao-do-planejamento">

    @* ── OS BOTÕES ─────────────────────────────────────────────────────────────────────── *@
    <div class="card shadow-sm mb-3">
        <div class="card-header fw-bold" style="background-color: var(--pdz-surface-alt); color: var(--pdz-ink);">
            <i class="bi bi-sliders"></i> O que você tem
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-6 col-md-3">
                    <label class="form-label small fw-bold mb-1">Começa em</label>
                    <input type="date" name="dataInicio" class="form-control"
                           value="@Model.DataInicio.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label small fw-bold mb-1">Abre no 1º dia</label>
                    <input type="time" name="horaInicio" class="form-control" value="@Hora(Model.HoraInicio)" />
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label small fw-bold mb-1">Abre nos demais</label>
                    <input type="time" name="horaSeguintes" class="form-control" value="@Hora(Model.HoraSeguintes)" />
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label small fw-bold mb-1">Último jogo começa até</label>
                    <input type="time" name="horaFim" class="form-control" value="@Hora(Model.HoraFim)" />
                    <div class="form-text small">Hora de <strong>começar</strong>, não de terminar.</div>
                </div>

                <div class="col-6 col-md-3">
                    <label class="form-label small fw-bold mb-1">Duração do jogo</label>
                    <div class="input-group">
                        <input type="number" name="duracao" min="10" max="240" class="form-control" value="@Model.Duracao" />
                        <span class="input-group-text">min</span>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label small fw-bold mb-1">Último dia de quadra</label>
                    <input type="date" name="ate" class="form-control" value="@(Model.Ate?.ToString("yyyy-MM-dd"))" />
                    <div class="form-text small">Vazio = sem prazo.</div>
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label small fw-bold mb-1">Jogos</label>
                    <input type="number" name="jogos" min="0" max="2000" class="form-control" value="@Model.Jogos" />
                    <div class="form-text small">
                        @if (Model.JogosDoTorneio > 0)
                        {
                            <text>Real: <strong>@Model.JogosDoTorneio</strong>@(Model.JogosJaSorteados ? " (sorteados)" : " (pelas inscrições)")</text>
                        }
                        else
                        {
                            <text>Ainda não dá pra contar — digite pra simular.</text>
                        }
                    </div>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2 mt-3">
                <button type="submit" class="btn btn-primary rounded-pill px-4">
                    <i class="bi bi-arrow-repeat"></i> Recalcular
                </button>
                <a asp-action="Planejamento" asp-route-id="@Model.Torneio.Id"
                   class="btn btn-outline-secondary rounded-pill px-3">
                    <i class="bi bi-arrow-counterclockwise"></i> Voltar ao que o torneio tem
                </a>
            </div>

            @if (Model.Simulando)
            {
                <div class="alert alert-warning mt-3 mb-0 py-2 px-3 small">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    Você está simulando <strong>@plano.TotalDeJogos jogos</strong>; este torneio tem
                    <strong>@Model.JogosDoTorneio</strong>. O número da simulação não vale pra mais nada além desta tela.
                </div>
            }
        </div>
    </div>

    @* ── A RESPOSTA ────────────────────────────────────────────────────────────────────── *@
    @if (plano.DiaSemHoraPraAcabar)
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-octagon-fill"></i>
            <strong>Nenhum dia comporta jogo.</strong> A hora limite (@Hora(Model.HoraFim)) não passa da hora
            de abertura — ajuste os horários acima.
        </div>
    }
    else if (plano.TotalDeJogos == 0)
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle-fill"></i>
            Sem jogos pra distribuir ainda. A tabela abaixo já mostra <strong>quanto cabe</strong> em cada dia —
            digite um número em <strong>Jogos</strong> pra ver o que falta.
        </div>
    }
    else if (plano.Faltam > 0)
    {
        <div class="card shadow-sm mb-3 border-danger">
            <div class="card-body">
                <h5 class="fw-bold text-danger mb-2">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    Faltam @plano.Faltam @(plano.Faltam == 1 ? "jogo" : "jogos") pra fechar dentro do prazo
                </h5>
                <p class="mb-2">
                    Nos dias e horários acima cabem <strong>@plano.Vagas @(plano.Vagas == 1 ? "jogo" : "jogos")</strong>
                    (@plano.Quadras @(plano.Quadras == 1 ? "quadra" : "quadras")), e o torneio tem
                    <strong>@plano.TotalDeJogos</strong>.
                </p>
                @* As duas saídas são a MESMA conta vista de dois lados — o organizador escolhe
                   qual delas o clube dele vende. *@
                <div class="row g-2">
                    <div class="col-md-6">
                        <div class="p-3 rounded h-100" style="background-color: var(--pdz-surface-alt);">
                            <div class="fw-bold mb-1"><i class="bi bi-clock-history"></i> Alugando por horário</div>
                            <div class="fs-5 fw-bold">@plano.HorariosExtras @(plano.HorariosExtras == 1 ? "horário" : "horários") de quadra</div>
                            <div class="small text-muted">
                                = @EmHoras(plano.MinutosExtras) de uma quadra só, ou
                                @EmHoras(plano.MinutosExtras / 2) em duas ao mesmo tempo.
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 rounded h-100" style="background-color: var(--pdz-surface-alt);">
                            <div class="fw-bold mb-1"><i class="bi bi-grid-3x3"></i> Alugando quadra o fim de semana todo</div>
                            <div class="fs-5 fw-bold">@plano.QuadrasNecessarias @(plano.QuadrasNecessarias == 1 ? "quadra" : "quadras")</div>
                            <div class="small text-muted">
                                são @(plano.QuadrasNecessarias - plano.Quadras) a mais do que as @plano.Quadras de agora — quadra
                                o fim de semana inteiro, sem janela.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (Model.JogosSemHorario > 0)
    {
        @* A GRADE DE VERDADE MANDA (11/11/2026): a soma de vagas dizia "Cabe" e a grade tinha
           jogo "por ordem". Eliminatória espera a rodada anterior, e dupla presa a um turno
           segura a categoria — a soma não enxerga nenhum dos dois. *@
        <div class="card shadow-sm mb-3 border-danger">
            <div class="card-body">
                <h5 class="fw-bold text-danger mb-2">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    Não cabe: @Model.JogosSemHorario @(Model.JogosSemHorario == 1 ? "jogo ficou" : "jogos ficaram") sem horário na grade
                </h5>
                <p class="mb-2">
                    Somando as vagas parece caber (@plano.Vagas vagas pra @plano.TotalDeJogos jogos), mas as eliminatórias
                    esperam a rodada anterior acabar, e duplas com impedimento ou "Pôr os 2 jogos em" seguram horário
                    — e o sistema nunca marca jogo depois do último dia.
                </p>
                <p class="small text-muted mb-0">
                    Adicione uma quadra, aumente o horário de algum dia na tabela <strong>Dia a dia</strong>, ou alivie um
                    pedido de horário das duplas — e grave em <strong>Aplicar horários ao torneio</strong>.
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm mb-3 border-success">
            <div class="card-body">
                <h5 class="fw-bold text-success mb-2"><i class="bi bi-check-circle-fill"></i> Cabe</h5>
                <p class="mb-1">
                    @plano.TotalDeJogos jogos em @plano.Quadras @(plano.Quadras == 1 ? "quadra" : "quadras")
                    @if (plano.UltimoJogoTermina != null)
                    {
                        <text>
                            — o último termina
                            <strong>@plano.UltimoJogoTermina.Value.ToString("dddd dd/MM 'às' HH:mm", ptBr)</strong>.
                        </text>
                    }
                </p>
                <p class="small text-muted mb-0">
                    Sobram <strong>@plano.Sobram</strong> @(plano.Sobram == 1 ? "vaga" : "vagas") de quadra.
                </p>
            </div>
        </div>
    }

    @* A FOLGA NÃO É ENFEITE: sem vaga sobrando o sorteio não tem pra onde desviar de um
       impedimento, e cai no último recurso (marca dentro da janela que a dupla pagou pra
       evitar). O número vem do motor — GradeDeJogos.MargemDeHorarios. *@
    @if (!plano.DiaSemHoraPraAcabar && plano.TotalDeJogos > 0 && !plano.FolgaSuficiente && plano.Faltam == 0
         && Model.JogosSemHorario == 0)
    {
        <div class="alert alert-warning py-2 px-3 small">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <strong>Cabe, mas no limite.</strong> O sorteio trabalha melhor com pelo menos
            <strong>@plano.Margem vagas</strong> sobrando pra desviar dos impedimentos sem chamar
            ninguém pra dois jogos ao mesmo tempo — aqui sobram @plano.Sobram.
        </div>
    }

    @* ── DIA A DIA ─────────────────────────────────────────────────────────────────────── *@
    <div class="card shadow-sm mb-3" id="dia-a-dia">
        <div class="card-header fw-bold" style="background-color: var(--pdz-surface-alt); color: var(--pdz-ink);">
            <i class="bi bi-calendar-week"></i> Dia a dia
        </div>
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead>
                    <tr class="small text-muted">
                        <th>Dia</th>
                        <th>Abre</th>
                        <th style="min-width: 120px;">Último jogo até</th>
                        <th class="text-center">Rodadas</th>
                        <th class="text-center">Cabem</th>
                        <th class="text-center">Jogos</th>
                        <th class="text-center">Sobra</th>
                        <th>Último jogo</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var dia in plano.Dias)
                {
                    <tr class="@(dia.Rodadas == 0 ? "text-muted" : "")">
                        <td class="fw-bold">@dia.Data.ToString("ddd dd/MM", ptBr)</td>
                        @* HORÁRIO PRÓPRIO POR DIA (11/11/2026). 🗣️ Felipe: "tem que permitir separar por
                           dia, que horas começa e que horas termina". As duas caixinhas GRAVAM pelo
                           "Aplicar horários ao torneio" (Torneio.HorariosPorDia). Vazia = o padrão lá
                           de cima (abertura do 1º dia / dos demais, e o último jogo). *@
                        @{
                            var padraoAbre = dia.Data == Model.DataInicio.Date ? Model.HoraInicio : Model.HoraSeguintes;
                        }
                        <td style="min-width: 110px;">
                            <input type="time" class="form-control form-control-sm"
                                   name="abertura[@dia.Data.ToString("yyyy-MM-dd")]"
                                   value="@(dia.Abre == padraoAbre ? "" : Hora(dia.Abre))"
                                   placeholder="@Hora(padraoAbre)" aria-label="Abre em @dia.Data.ToString("dd/MM")" />
                        </td>
                        <td>
                            <input type="time" class="form-control form-control-sm"
                                   name="limite[@dia.Data.ToString("yyyy-MM-dd")]"
                                   value="@(dia.Limite == Model.HoraFim ? "" : Hora(dia.Limite))"
                                   placeholder="@Hora(Model.HoraFim)" aria-label="Último jogo começa até em @dia.Data.ToString("dd/MM")" />
                        </td>
                        <td class="text-center">@dia.Rodadas</td>
                        <td class="text-center">@dia.Vagas</td>
                        <td class="text-center fw-bold">@dia.Jogos</td>
                        <td class="text-center">@(dia.Vagas - dia.Jogos)</td>
                        <td>
                            @if (dia.UltimoJogoComeca != null)
                            {
                                <text>@Hora(dia.UltimoJogoComeca.Value) → @Hora(dia.UltimoJogoComeca.Value + TimeSpan.FromMinutes(plano.DuracaoMinutos))</text>
                            }
                            else if (dia.Rodadas == 0)
                            {
                                <span class="small">sem jogo</span>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <div class="card-footer small text-muted">
            Mudou o horário de algum dia? <button type="submit" class="btn btn-sm btn-primary rounded-pill px-3">Recalcular</button>
            <span class="ms-2">
                Cada dia pode ter a <strong>própria</strong> hora de abrir e de último jogo — caixinha vazia segue o
                horário geral lá de cima. Confira a conta e grave em <strong>Aplicar horários ao torneio</strong>, abaixo.
            </span>
        </div>
    </div>
</form>

    @* ── O QUE DÁ PRA GRAVAR ───────────────────────────────────────────────────────────── *@
    @if (!Model.SoLeitura)
    {
        <div class="card shadow-sm mb-3 @(Model.MudouAlgo ? "border-primary" : "")">
            <div class="card-header fw-bold" style="background-color: var(--pdz-surface-alt); color: var(--pdz-ink);">
                <i class="bi bi-save"></i> Aplicar ao torneio
            </div>
            <div class="card-body">
                @if (Model.MudouAlgo)
                {
                    <p class="mb-3">
                        Gravar os horários acima no torneio:
                        começa <strong>@Model.DataInicio.ToString("dd/MM", ptBr)</strong> às
                        <strong>@Hora(Model.HoraInicio)</strong>, demais dias às <strong>@Hora(Model.HoraSeguintes)</strong>,
                        último jogo começando até <strong>@Hora(Model.HoraFim)</strong>, partidas de
                        <strong>@Model.Duracao min</strong>@(string.IsNullOrEmpty(Model.Aberturas) && string.IsNullOrEmpty(Model.Limites) ? "" : " — e os dias com horário próprio da tabela Dia a dia").
                    </p>
                }
                else
                {
                    <p class="text-muted mb-3">Os horários acima são exatamente os que o torneio já tem.</p>
                }

                <form method="post" asp-action="AplicarPlanejamento" asp-route-id="@Model.Torneio.Id" class="mb-0" id="aplicar-horarios">
                    <input type="hidden" name="dataInicio" value="@Model.DataInicio.ToString("yyyy-MM-dd")" />
                    <input type="hidden" name="horaInicio" value="@Hora(Model.HoraInicio)" />
                    <input type="hidden" name="horaSeguintes" value="@Hora(Model.HoraSeguintes)" />
                    <input type="hidden" name="horaFim" value="@Hora(Model.HoraFim)" />
                    <input type="hidden" name="duracao" value="@Model.Duracao" />
                    @* A faixa de cada dia, no formato do link. `porDia` diz que a tabela veio — sem
                       nenhum dia próprio, isso LIMPA as faixas gravadas. *@
                    <input type="hidden" name="aberturas" value="@Model.Aberturas" />
                    <input type="hidden" name="limites" value="@Model.Limites" />
                    <input type="hidden" name="porDia" value="true" />
                    @* SEMPRE ACESO (11/11/2026). 🗣️ Felipe: *"não está salvando ali a alteração"* — ele
                       mudava a caixinha e clicava aqui, e o botão gravava (ou nem deixava clicar) o
                       que a tela tinha ao ABRIR. Agora o script abaixo copia os campos da simulação
                       COMO ESTÃO na hora de enviar; os escondidos acima só valem sem JavaScript. *@
                    <button type="submit" class="btn btn-success rounded-pill px-4">
                        <i class="bi bi-check2"></i> Aplicar horários ao torneio
                    </button>
                </form>
                <script>
                    document.getElementById('aplicar-horarios').addEventListener('submit', function () {
                        var aplicar = this;
                        var simulacao = document.getElementById('simulacao-do-planejamento');
                        if (!simulacao) return;
                        ['dataInicio', 'horaInicio', 'horaSeguintes', 'horaFim', 'duracao'].forEach(function (nome) {
                            var campo = simulacao.elements[nome], escondido = aplicar.elements[nome];
                            if (campo && escondido && campo.value) escondido.value = campo.value;
                        });
                        Array.prototype.forEach.call(simulacao.querySelectorAll('input[name^="abertura["], input[name^="limite["]'), function (caixa) {
                            var copia = document.createElement('input');
                            copia.type = 'hidden';
                            copia.name = caixa.name;
                            copia.value = caixa.value;
                            aplicar.appendChild(copia);
                        });
                    });
                </script>

                <hr />
                <p class="small text-muted mb-0">
                    <i class="bi bi-grid-3x3-gap"></i>
                    As <strong>quadras</strong> não passam por este botão: a tabela lá em cima já grava cada
                    uma na hora. Em que clube cada <em>categoria</em> joga e o transbordo pro local alugado
                    continuam em
                    <a asp-action="Details" asp-route-id="@Model.Torneio.Id" asp-fragment="pagamentos">Pagamentos › Quadras e sedes</a>.
                </p>
            </div>
        </div>
    }
</div>
