@model Padelizou.Models.Jogador
@using Padelizou.ViewModels
@{
    // Dupla sem parceiro chega aqui com null. Um chip vazio é um detalhe; derrubar a
    // página inteira do torneio por causa dele não é.
    if (Model == null) { return; }

    // O histórico vem indexado pelo NOME da categoria, e é por ele que se procura: a versão que
    // procurava pelo MATERIAL (TierDaCategoria) achava o título da 6ª Feminina no chip da 6ª
    // Masculina — mesma madeira, campeã de outra categoria.
    var historico = ViewData["Historico"] as Dictionary<int, Dictionary<string, HistoricoCategoriaVM>>;
    var categoriaAtual = ViewData["CategoriaAtual"] as string;
    HistoricoCategoriaVM? h = null;
    if (historico != null && categoriaAtual != null && historico.TryGetValue(Model.Id, out var porCategoria))
    {
        porCategoria.TryGetValue(categoriaAtual, out h);
    }
}
@* Tamanhos por classe (pdz-chip-*): dentro de um `.pdz-chip-compacto` (tabela do
   grupo) o avatar encolhe, o clube some e o nome trunca em vez de quebrar. *@
<a asp-controller="Jogadores" asp-action="Perfil" asp-route-id="@Model.Id" class="d-flex align-items-center gap-2 text-decoration-none text-dark mb-1">
    @* A foto passa pelo parcial único, que veste a moldura da conquista. Tamanho 0 de
       propósito: quem dimensiona o chip é a classe (encolhe no modo compacto). *@
    <partial name="_FotoDoJogador" model='Padelizou.ViewModels.FotoDoJogadorVM.De(Model, 0, "pdz-chip-avatar")' />
    <span class="pdz-chip-texto">
        @* ComoChamar, não Nome: cada um digita como quer (na mesma lista conviviam "ALAN DA
           SILVEIRA MACHADO" e "charls gustavio polese") e nome de três palavras ocupava três
           alturas na tabela do grupo. Aqui vale o apelido, ou primeiro e último nome. O que
           está gravado continua sendo o que a pessoa escreveu. *@
        <span class="fw-bold d-block pdz-chip-nome">@Model.ComoChamar</span>
        @if (Model.Time != null)
        {
            <small class="text-muted d-block pdz-chip-clube">@Model.Time.Nome</small>
        }
    </span>
    <partial name="_SeloHistorico" model="h" />
</a>
