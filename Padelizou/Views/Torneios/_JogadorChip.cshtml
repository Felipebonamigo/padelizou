@model Padelizou.Models.Jogador
@using Padelizou.ViewModels
@{
    // Dupla sem parceiro chega aqui com null. Um chip vazio é um detalhe; derrubar a
    // página inteira do torneio por causa dele não é.
    if (Model == null) { return; }

    // O histórico vem indexado pelo NOME da categoria, e é por ele que se procura: a versão que
    // procurava pelo MATERIAL (TierDaCategoria) achava o título da 6ª Feminina no chip da 6ª
    // Masculina — mesma madeira, campeã de outra categoria.
    var historico = ViewData["Historico"] as Dictionary<int, Dictionary<string, HistoricoCategoriaVM>>;
    var categoriaAtual = ViewData["CategoriaAtual"] as string;
    HistoricoCategoriaVM? h = null;
    if (historico != null && categoriaAtual != null && historico.TryGetValue(Model.Id, out var porCategoria))
    {
        porCategoria.TryGetValue(categoriaAtual, out h);
    }

    // O TIME do jogador, numa variável: o escudo é lido duas vezes (src e alt) e `Model.Time`
    // é anulável — CS8602 é ERRO aqui desde 22/08, e o `!` calaria o compilador sem tirar o
    // risco. Com a variável local a checagem do `@if` vale nos dois usos.
    //
    // ⚠️ Não custa consulta nenhuma: `Jogador.Time` já vem com `ThenInclude` em toda consulta
    // de torneio que desenha este chip (TorneiosController, Details e jogos).
    var timeDoJogador = Model.Time;

    // COMO desenhar o escudo: do lado do nome (o padrão, em toda tela) ou como SELO no canto
    // da foto. 🗣️ Felipe, 11/09/2026: *"e no ao vivo use esse do B"* — e SÓ no ao vivo: este
    // parcial é o mesmo da tabela do grupo, da lista de inscritos e da lista de duplas, que
    // ele não pediu pra mudar. Quem acende é o card ao vivo, por view-data (_JogosDoTorneio).
    //
    // ⚠️ Não é CSS: o selo precisa nascer DENTRO da moldura da foto, que é quem ancora o canto.
    // Posicionado de fora, o canto vira número mágico e desalinha quando o nome quebra em duas
    // linhas no celular.
    var escudoComoSelo = (ViewData["EscudoComoSelo"] as bool?) ?? false;
    var temEscudo = !string.IsNullOrEmpty(timeDoJogador?.Logo);

    // Uma variável porque a foto é desenhada nos dois modos. Tamanho 0 de propósito: quem
    // dimensiona o chip é a classe (encolhe no modo compacto).
    var foto = Padelizou.ViewModels.FotoDoJogadorVM.De(Model, 0, "pdz-chip-avatar");
}
@* Tamanhos por classe (pdz-chip-*): dentro de um `.pdz-chip-compacto` (tabela do
   grupo) o avatar encolhe, o clube some e o nome trunca em vez de quebrar. *@
<a asp-controller="Jogadores" asp-action="Perfil" asp-route-id="@Model.Id" class="d-flex align-items-center gap-2 text-decoration-none text-dark mb-1">
    @* A foto passa pelo parcial único, que veste a moldura da conquista. *@
    @if (escudoComoSelo && temEscudo)
    {
        <span class="pdz-chip-foto-selo">
            <partial name="_FotoDoJogador" model="foto" />
            <partial name="_EscudoDoTime" model="timeDoJogador" />
        </span>
    }
    else
    {
        <partial name="_FotoDoJogador" model="foto" />
    }
    <span class="pdz-chip-texto">
        @* ComoChamar, não Nome: cada um digita como quer (na mesma lista conviviam "ALAN DA
           SILVEIRA MACHADO" e "charls gustavio polese") e nome de três palavras ocupava três
           alturas na tabela do grupo. Aqui vale o apelido, ou primeiro e último nome. O que
           está gravado continua sendo o que a pessoa escreveu. *@
        <span class="fw-bold d-block pdz-chip-nome">@Model.ComoChamar</span>
        @if (timeDoJogador != null)
        {
            <small class="text-muted d-block pdz-chip-clube">@timeDoJogador.Nome</small>
        }
    </span>
    @* O ESCUDO DO TIME, do lado do nome (Felipe, 11/09/2026: "botar as bandeiras dos times
       para exibir nos jogos do torneio, do lado dos nomes").

       ⚠️ FORA da linha do clube de propósito, e é a decisão que importa aqui: lá dentro ele
       sumiria na TABELA DO GRUPO, porque `.pdz-chip-compacto .pdz-chip-clube` é `display:none`
       — e é justamente lá que o escudo é a ÚNICA pista do time, já que o nome não é escrito.

       Quem tem logo e quem não tem, e o <img> em si, é assunto do _EscudoDoTime. *@
    @if (!escudoComoSelo)
    {
        <partial name="_EscudoDoTime" model="timeDoJogador" />
    }
    <partial name="_SeloHistorico" model="h" />
</a>
