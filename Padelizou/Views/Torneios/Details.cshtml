@model Padelizou.Models.Torneio
@using Padelizou.ViewModels
@inject Microsoft.Extensions.Options.IOptions<Padelizou.Services.TaxasExibicao> TaxasOpcoes
@{
    ViewData["Title"] = Model.Nome;

    @* ── O que sai na busca e na prévia do link no WhatsApp ──────────────────────────────
       Esta é a página do site com mais a ganhar numa busca: quem procura "torneio de padel
       em Porto Alegre" está procurando exatamente isto. Sem a frase própria, todo torneio
       herdaria a mesma descrição genérica da seção e concorreria consigo mesmo. *@
    {
        @* O clube vem por ViewBag e não por Model.Clube: aquela navegação não é carregada aqui
           de propósito (ver o Details do controller — Include dela vira INNER JOIN e some com
           a página). *@
        var clubeDoTorneio = ViewBag.ClubeDoTorneio as Padelizou.Models.Clube;
        var localDoTorneio = clubeDoTorneio?.Nome ?? Model.LocalTorneio;
        var quando = Model.DataInicio?.ToString("dd/MM/yyyy");
        var pedacos = new List<string> { "Torneio de padel" };
        if (localDoTorneio != null) pedacos.Add($"em {localDoTorneio}");
        if (quando != null) pedacos.Add($"· {quando}");
        var quantasCategorias = Model.Categorias.Count;
        ViewData["Descricao"] = string.Join(" ", pedacos)
            + (quantasCategorias > 0 ? $" · {quantasCategorias} categoria{(quantasCategorias == 1 ? "" : "s")}" : "")
            + ". Inscrição, chaves, jogos e classificação ao vivo no Padelizou.";

        @* Torneio oculto, ainda não aprovado ou cancelado sai do índice pela MESMA régua que
           o tira da vitrine — senão o link direto continuaria entrando no Google, e o
           organizador veria no buscador o torneio que ele escondeu do site. *@
        ViewData["ForaDoIndice"] =
            !Padelizou.Services.PermissaoDeOrganizador.ApareceNaVitrine(Model)
            || Padelizou.Services.CancelamentoDoTorneio.EstaCancelado(Model.Status);

        @* A capa é gravada como caminho relativo (/uploads/…) e a prévia do link é montada de
           fora, por um servidor que não sabe qual é o nosso domínio: relativo aqui não vira
           imagem nenhuma. *@
        if (!string.IsNullOrEmpty(Model.ImagemCapa))
        {
            ViewData["OgImagem"] = Model.ImagemCapa.StartsWith("http", StringComparison.OrdinalIgnoreCase)
                ? Model.ImagemCapa
                : $"{Context.Request.Scheme}://{Context.Request.Host}{Model.ImagemCapa}";
        }
    }

    var historico = ViewBag.HistoricoJogadores as Dictionary<int, Dictionary<string, HistoricoCategoriaVM>> ?? new Dictionary<int, Dictionary<string, HistoricoCategoriaVM>>();
    ViewData["Historico"] = historico;

    // O ESCUDO DO TIME COMO SELO no canto da foto, na TABELA DO GRUPO. 🗣️ Felipe, 11/09/2026,
    // com um print das duas tabelas: *"nessa parte aqui, dos grupos, faça igual dos jogos ao
    // vivo, com o logo redondinho no canto da foto"*.
    //
    // ⚠️ A coluna da dupla é a mais apertada do site (180px, nome truncado com reticências): do
    // lado do nome o escudo roubava letra de um nome que já estava cortado. No canto da foto
    // não ocupa linha nenhuma.
    //
    // Mesmo mecanismo do card ao vivo (ver _JogosDoTorneio): quem muda é o HTML do chip, não só
    // a posição no CSS — o selo nasce DENTRO da moldura da foto.
    var chipComSelo = new ViewDataDictionary(ViewData) { ["EscudoComoSelo"] = true };
    var pontosTimes = ViewBag.PontosTimes as List<PontosTimeTorneioVM> ?? new List<PontosTimeTorneioVM>();
    // Quem está olhando a página. Usado pra mostrar o botão de desistir só na própria
    // inscrição — nos cards dos outros ele seria um botão de tirar gente do torneio.
    int? meuIdNaPagina = ViewBag.MeuJogadorId as int?;

    // As inscrições em que EU já chamei alguém, pra alternar o botão do mural com o "tirar
    // pedido" (21/08/2026).
    var chamadosQueEuFiz = ViewBag.ChamadosQueEuFiz as HashSet<int> ?? new HashSet<int>();

    // ⚠️ FICA ANULÁVEL DE PROPÓSITO, sem `?? new List<>()` de consolo — e o `@if` do botão exige
    // `!= null`. ViewBag é dynamic: não há vínculo de compilação entre quem grava a chave e quem
    // lê. Um fallback vazio faria a régua "já tem dupla nesta categoria" sumir CALADA se a chave
    // for renomeada; sem ele, o mural inteiro some de uma vez e alguém reclama no mesmo dia.
    var minhasInscricoes = ViewBag.MinhasInscricoesNoTorneio
        as List<Padelizou.Services.InscricaoRepetida.Achado>;

    // Quem já entrou em quadra — a janela de fechar dupla (Services/JanelaDoParceiro) vai até
    // a bola rolar pra AQUELA dupla, e o Razor não consulta banco. Anulável pelo mesmo motivo
    // do `minhasInscricoes` logo acima: sem a chave, o botão some em vez de abrir sozinho.
    var duplasQueJaJogaram = ViewBag.DuplasQueJaJogaram as HashSet<int>;

    // Quem o sorteio vai deixar de fora — desde 09/09/2026, só a lista de espera. O GerarChaves
    // sempre filtrou isso, mas em silêncio — o organizador sorteava sem saber que ia deixar
    // gente na porta. A regra é lida do mesmo lugar que o sorteio usa, senão a tela prometeria
    // uma coisa e o sorteio faria outra.
    var ficamDeFora = Model.Categorias
        .SelectMany(c => Padelizou.Services.ForaDoSorteio.Listar(c.Duplas))
        .ToList();

    // Quem ENTRA com a vaga de parceiro em aberto. É o aviso que substitui o antigo "sem
    // parceiro fica de fora": eles não ficam mais de fora, entram — e cada um é um W.O.
    // provável se o segundo nome não aparecer até o primeiro jogo. O organizador precisa ver
    // quantos são ANTES de apertar o botão, que era exatamente pra isso que o alerta nasceu.
    var comVagaEmAberto = Model.Categorias
        .SelectMany(c => Padelizou.Services.ForaDoSorteio.ComVagaEmAberto(c.Duplas))
        .ToList();

    // Nome curto de dupla. A REGRA mora em `Dupla.NomeCurto` desde 11/09/2026 — ela vivia aqui
    // e o serviço do "o que falta pra classificar" tinha a própria versão, com outra resposta:
    // a mesma dupla ganhava dois nomes na mesma tela. Aqui sobra só o caso que é DA TELA: a
    // vaga do mata-mata que ainda não tem dono.
    Func<Padelizou.Models.Dupla?, string> NomeCurtoDaDupla = d => d?.NomeCurto ?? "A definir";

    // Texto da confirmação de sortear as chaves (o modal em _ModalConfirmar).
    // Quem fica de fora aparece POR NOME: "3 inscritos" não deixa ninguém reconhecer o amigo
    // que vai perder o torneio, que é justamente a informação capaz de mudar a decisão.
    var nomesDeFora = string.Join(", ", ficamDeFora.Take(4)
        .Select(d => d.Jogador1.ComoChamar.Split(' ')[0]
                     + " (" + Padelizou.Services.ForaDoSorteio.Motivo(d) + ")"));
    var detalheDeFora = ficamDeFora.Any()
        ? $"{ficamDeFora.Count} fica{(ficamDeFora.Count == 1 ? "" : "m")} de fora: {nomesDeFora}{(ficamDeFora.Count > 4 ? "…" : "")}"
        : null;

    // A confirmação do sorteio precisa dizer as DUAS coisas, e a segunda é a que mudou de
    // significado: quem está sem parceiro não fica mais na porta — entra, e pode virar W.O.
    var nomesComVaga = string.Join(", ", comVagaEmAberto.Take(4)
        .Select(d => d.Jogador1.ComoChamar.Split(' ')[0]));
    var detalheComVaga = comVagaEmAberto.Any()
        ? $"{comVagaEmAberto.Count} entra{(comVagaEmAberto.Count == 1 ? "" : "m")} sem parceiro: "
          + $"{nomesComVaga}{(comVagaEmAberto.Count > 4 ? "…" : "")} — se não fechar a dupla até o primeiro jogo, é W.O."
        : null;
    var detalheDoSorteio = string.Join(" · ", new[] { detalheDeFora, detalheComVaga }.Where(t => t != null));
    var horarioOuOrdem = Model.SemHorarioPrevisto
        ? "Os jogos ganham horário, mas não quadra: você chama cada um conforme a quadra vaga."
        : "Os jogos ganham horário e quadra na hora.";
}

@* Cancelado é a primeira coisa que a página diz, antes de qualquer aba: quem chegou pelo link
   do grupo do WhatsApp precisa saber que o torneio não vai acontecer sem ter que interpretar
   um selo pequeno no meio da tela. *@
@if (Padelizou.Services.CancelamentoDoTorneio.EstaCancelado(Model.Status))
{
    <div class="alert alert-danger d-flex gap-3 align-items-start shadow-sm">
        <i class="bi bi-x-octagon-fill fs-3"></i>
        <div>
            <h5 class="fw-bold mb-1">Este torneio foi cancelado</h5>
            @if (!string.IsNullOrWhiteSpace(Model.MotivoCancelamento))
            {
                <p class="mb-1">@Model.MotivoCancelamento</p>
            }
            @if (Model.CanceladoEm != null)
            {
                <small class="d-block">Cancelado em @Model.CanceladoEm.Value.ToString("dd/MM/yyyy 'às' HH:mm").</small>
            }
            <small class="d-block mt-1">
                Se você pagou a inscrição, a devolução é combinada direto com o organizador.
            </small>
        </div>
    </div>
}

@* A ficha de EVENTO que o buscador lê: nome, data, local, cidade e valor da inscrição. É o
   que permite este torneio sair na busca com a data e o endereço embaixo do link, em vez de
   três linhas de texto solto. Volta nulo quando o torneio não tem data marcada — ver o porquê
   em Services/DadosEstruturados. *@
@if (ViewData["ForaDoIndice"] as bool? != true)
{
    var fichaDoEvento = Padelizou.Services.DadosEstruturados.Torneio(
        Model,
        ViewBag.ClubeDoTorneio as Padelizou.Models.Clube,
        $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}",
        ViewData["OgImagem"] as string,
        ViewData["Descricao"] as string ?? "");

    @* O caminho até aqui, pro resultado sair "Padelizou › Torneios › NATA PADEL TOUR" em vez
       do endereço cru — que se lê, e por isso recebe mais clique. *@
    var trilhaDoTorneio = Padelizou.Services.DadosEstruturados.Migalhas(
        $"{Context.Request.Scheme}://{Context.Request.Host}",
        ("Padelizou", "/"),
        ("Torneios", "/Torneios"),
        (Model.Nome, null));

    @* Uma seção Head só: Razor não aceita duas com o mesmo nome na mesma view, e os dois
       blocos JSON-LD convivem numa boa — cada <script> é um grafo independente. *@
    @section Head {
        @if (fichaDoEvento != null)
        {
            <script type="application/ld+json">@Html.Raw(fichaDoEvento)</script>
        }
        <script type="application/ld+json">@Html.Raw(trilhaDoTorneio)</script>
    }
}

@* ── TORNEIO OCULTO: A FAIXA QUE AVISA ─────────────────────────────────────────────────
   Quem chega aqui com o torneio oculto já passou pela porta (organizador, admin ou inscrito)
   — o resto do mundo levou 404 no controller. Mas passar pela porta não é saber que ela
   existe: sem esta faixa, o organizador vê uma página normal, manda o link no grupo e
   descobre pelo silêncio que ninguém conseguiu abrir.

   Vem ANTES do nome do torneio de propósito: é a primeira coisa que muda o que ele vai fazer
   na página. E fala duas línguas — pra quem manda no torneio, com o botão de publicar; pra
   quem só está inscrito, explicando por que ele consegue ver uma coisa que os amigos não
   acham. *@
@if (Model.Oculto)
{
    var mandaNoTorneio = ViewBag.PodeGerenciar == true && ViewBag.GestaoSoLeitura != true;
    <div class="alert @(mandaNoTorneio ? "alert-warning border-warning" : "alert-secondary") d-flex flex-wrap gap-3 align-items-center justify-content-between shadow-sm">
        <div>
            <strong><i class="bi bi-eye-slash-fill"></i> Torneio oculto — ninguém de fora está vendo isto</strong>
            <div class="small mt-1">
                @if (mandaNoTorneio)
                {
                    @Padelizou.Services.VisibilidadeDoTorneio.AvisoDeOculto
                    <span class="d-block mt-1">@Padelizou.Services.VisibilidadeDoTorneio.ConviteParaPublicar</span>
                }
                else
                {
                    <text>
                        Este torneio ainda não foi divulgado: ele não aparece na lista nem no Google, e
                        quem receber o link não consegue abrir. Você está vendo porque já está inscrito.
                    </text>
                }
            </div>
        </div>
        @if (mandaNoTorneio)
        {
            <form asp-controller="Torneios" asp-action="AlternarVisibilidade" method="post" class="mb-0">
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="ocultar" value="false" />
                <button type="submit" class="btn btn-success fw-bold shadow-sm">
                    <i class="bi bi-megaphone-fill"></i> Publicar agora
                </button>
            </form>
        }
    </div>
}

<!-- Cabeçalho do Torneio -->
<div class="mb-4">
    <h2 class="fw-bold" style="color: var(--pdz-ink);">@Model.Nome</h2>
    <p class="text-muted">
        @* QUANDO O TORNEIO É — e até 09/08/2026 esta tela não dizia (Felipe, adiando o NATA
           PADEL TOUR: "coloque a data do torneio no cabeçalho"). Ela trazia local, preço, quando
           as inscrições fecham e quando sai a chave; o dia do evento só existia no card da
           listagem, então quem abria o link direto do torneio não tinha como saber.

           Vem PRIMEIRO porque é a pergunta que decide o resto: quem não pode naquele fim de
           semana não precisa saber o preço. Formatação em Services/DataDoTorneioNaTela, a mesma
           que o card lê.

           ⚠️ Só aparece com data marcada: "Data a definir" no cabeçalho é ruído. No CARD é
           informação (lá se comparam torneios), e por isso a regra de mostrar é da tela, não do
           serviço. *@
        @if (Padelizou.Services.DataDoTorneioNaTela.TemData(Model))
        {
            <i class="bi bi-calendar-event text-primary"></i>
            <strong>@Padelizou.Services.DataDoTorneioNaTela.Frase(Model)</strong>
            <text>|</text>
        }
        <i class="bi bi-geo-alt-fill text-danger"></i> @(string.IsNullOrEmpty(Model.LocalTorneio) ? "A definir" : Model.LocalTorneio) |
        <i class="bi bi-cash text-success"></i>
        @{
            decimal? precoTotalTorneio = ViewBag.PrecoTotal;
        }
        @* Só o valor final. Quem se inscreve não precisa fazer conta nem entender
           comissão — ele quer saber quanto vai sair do bolso. A composição é assunto
           do organizador, e aparece pra ele na tela de criar o torneio. *@
        @(precoTotalTorneio.HasValue ? precoTotalTorneio.Value.ToString("C") : Model.PrecoInscricao.ToString("C"))
        @if (!Model.CobraPeloSite && Model.PrecoInscricao > 0)
        {
            <span class="small text-muted">— pagamento combinado com o organizador</span>
        }
    </p>

    @* Quantos já entraram, no torneio INTEIRO. A tela contava por categoria, mas só depois
       de escolher uma no seletor — pro total o organizador somava de cabeça passando por
       todas. E é o total que ele responde no WhatsApp o dia inteiro. *@
    @{
        var contagem = Padelizou.Services.QuantosInscritos.Contar(
            Model, Model.Categorias, ViewBag.InscricoesAmericanas as List<Padelizou.Models.InscricaoAmericana> ?? new());
    }
    <p class="mb-0">
        <span class="badge rounded-pill" style="background-color: var(--pdz-navy-fixed);">
            <i class="bi bi-people-fill"></i> @contagem.Rotulo
        </span>
        @* Fila separada de propósito: quem espera não está inscrito, e somar os dois faria o
           organizador anunciar vaga que ele não tem. *@
        @if (contagem.NaEspera > 0)
        {
            <span class="badge rounded-pill bg-warning-subtle text-warning-emphasis">
                <i class="bi bi-hourglass-split"></i>
                @contagem.NaEspera na lista de espera
            </span>
        }
    </p>
</div>

@* As duas perguntas que o organizador respondia no WhatsApp o torneio inteiro — "quando
   fecha?" e "já saiu a chave?" — agora ficam escritas na página. São PREVISÕES: quem encerra
   e quem sorteia continua sendo o organizador, no botão. *@
@* A frase do prazo saiu daqui e virou Services/PrazoDaInscricaoNaTela quando o card da lista
   passou a mostrar o prazo também — mesma história do DataDoTorneioNaTela: eram duas telas pra
   uma regra só. Ela cala quando a data já passou e o organizador ainda não fechou, caso em que
   a inscrição segue aberta e a frase desanimaria quem ainda pode entrar.
   ⚠️ Por isso a condição do bloco pergunta pela FRASE, e não pelo campo: com `!= null` aqui, o
   torneio de prazo vencido e sem data de chaveamento renderizava um parágrafo vazio com gap. *@
@{
    var prazoDaInscricao = Padelizou.Services.PrazoDaInscricaoNaTela.Frase(Model, DateTime.Today);
}
@if (prazoDaInscricao != null || Model.PrevisaoChaveamento != null)
{
    <p class="text-muted small mb-3 d-flex flex-wrap gap-3">
        @if (prazoDaInscricao != null)
        {
            <span>
                <i class="bi bi-hourglass-split"></i>
                <strong>@prazoDaInscricao</strong>
                <span class="opacity-75">(previsto)</span>
            </span>
        }
        @if (Model.PrevisaoChaveamento != null)
        {
            <span>
                <i class="bi bi-diagram-3"></i>
                Chaveamento em <strong>@Model.PrevisaoChaveamento.Value.ToString("dd/MM")</strong>
                <span class="opacity-75">(previsto)</span>
            </span>
        }
    </p>
}

@* AS FERRAMENTAS DO DIA SÃO A PRIMEIRA COISA DA TELA depois que a chave é publicada (10/09/2026).
   🗣️ Felipe, com o torneio do Er no ar: *"acho que a ferramentas do organizador tem q ser a
   primeira coisa da tela, depois que as chaves foram publicadas"*. Elas eram o ÚLTIMO bloco do
   Painel de Controle, atrás do sorteio, dos organizadores e do formulário de editar o torneio —
   e o painel só abre depois de um clique na aba. No dia do jogo, o caminho mais longo até as
   três telas que só servem naquele dia.

   ⚠️ LOGO ABAIXO DO CABEÇALHO, e não encostado nas abas: entre um e outro moram o cartaz, o
   convite, o grupo do WhatsApp, as fotos, os cards de campeão, o pódio, o MVP, o mural e os
   palpiteiros — tudo que o torneio no ar acumula. Ali embaixo o card ainda seria uma rolagem.
   Acima do cabeçalho, não: a tela ficaria sem dizer de que torneio ela fala.

   ⚠️ MESMA RÉGUA da aba "Chaves e Grupos" (AprovacaoDeChaves.ChavePublicada): antes de publicar
   o trabalho é montar o torneio, e o card fica onde sempre esteve.

   ⚠️ O `<fieldset disabled>` é o do painel, repetido aqui de propósito: fora dele o assistente
   do sistema (ViewBag.GestaoSoLeitura) ganharia o "Avisar todo mundo" LIGADO, e descobriria a
   recusa só depois de escrever a mensagem — o Comunicar exige EhOrganizadorAsync no servidor. *@
@if (ViewBag.PodeGerenciar == true && Padelizou.Services.AprovacaoDeChaves.ChavePublicada(Model))
{
    <fieldset disabled="@(ViewBag.GestaoSoLeitura == true)" class="border-0 p-0 m-0">
        <partial name="_FerramentasDoOrganizador" model="Model" />
    </fieldset>
}


@* Recado do organizador. Fica antes das abas porque é aviso ("levem bola", "confirma no
   grupo") — perdido lá embaixo, não seria lido por quem ele foi escrito. *@
@if (!string.IsNullOrWhiteSpace(Model.RecadoAosInscritos))
{
    <div class="alert alert-info border-0 d-flex align-items-start gap-2">
        <i class="bi bi-megaphone-fill fs-5"></i>
        <div>
            <strong class="d-block">Recado do organizador</strong>
            <span style="white-space: pre-line;">@Model.RecadoAosInscritos</span>
        </div>
    </div>
}

@* ── O CARTAZ DE DIVULGAÇÃO ───────────────────────────────────────────────────────────
   A peça do ANTES, como o card de campeão é a do depois — e, como ele, é PRA TODO MUNDO:
   o organizador é quem mais divulga, mas cada inscrito que chama a turma no grupo é
   divulgação que não custa nada.

   ⚠️ Quem responde "este torneio pode virar cartaz?" é o serviço, e não um teste de status
   escrito aqui: torneio cancelado e torneio já finalizado não divulgam, e essa regra tem
   que ter um dono só — cartaz é a peça que mais sobrevive ao próprio contexto, porque é
   salva na galeria e reencaminhada dias depois. *@
@* ⚠️ AS DUAS RÉGUAS SÃO SEPARADAS DE PROPÓSITO, e não uma dentro da outra. Hoje "pode
   convidar" é subconjunto de "pode divulgar" (inscrição aberta ⊂ nem cancelado nem
   finalizado), então aninhar funcionaria — e sumiria com o convite calado no dia em que
   alguém apertasse a régua do cartaz, que é uma pergunta diferente. Cada botão pergunta
   pelo seu próprio serviço; a linha só existe quando algum dos dois tem o que mostrar. *@
@{
    var podeDivulgar = Padelizou.Services.DivulgacaoDoTorneio.PodeDivulgar(Model.Status);

    // ⚠️ O CARTAZ SAI DAQUI QUANDO A CHAVE É PUBLICADA (11/09/2026). 🗣️ Felipe, na página do Er
    // no dia do torneio: *"tambem oculte esse 'cartaz pra divulgar' ou coloque ele em outro
    // lugar"*. O QR dele leva pra INSCRIÇÃO — com a chave no ar ela fechou, e o botão vira a
    // primeira coisa que 100+ jogadores veem antes dos jogos, sem servir a nenhum deles.
    //
    // Ele não some: passa pro card de ferramentas do organizador, gateado pelo MESMO predicado
    // — dois lugares possíveis, um de cada vez, como o próprio card já faz. Antes da chave fica
    // aqui e pra TODO MUNDO, que é a decisão de sempre: cada inscrito que chama a turma no grupo
    // é divulgação que não custa nada.
    var cartazNoTopo = podeDivulgar && !Padelizou.Services.AprovacaoDeChaves.ChavePublicada(Model);
    var podeConvidar = Padelizou.Services.ConviteProTorneio.PodeConvidar(Model.Status);

    // As FOTOS entram nesta mesma linha, e por isso o link é resolvido aqui em cima. O bloco
    // delas ficava ~130 linhas abaixo (só o modal do convite, invisível, separava os dois na
    // tela), então eram DUAS linhas de um botão cada onde cabe uma de dois.
    //
    // O Padelizou não hospeda a imagem: guarda o endereço de onde o fotógrafo publicou, e quem
    // confere se esse endereço serve é o serviço — a view nunca põe o campo cru num href, ou a
    // conferência deixa de existir.
    //
    // ⚠️ E ESTE COMENTÁRIO NÃO SOLETRA O NOME DO CAMPO DE PROPÓSITO: o
    // `FotosDoTorneioTests` cobra que ele apareça UMA vez só na tela (o formulário da gestão),
    // e o `SemComentarioRazor` dele tira `@* *@` mas não `//`. Escrever o nome aqui derrubava
    // aquele teste — foi o que aconteceu na primeira versão desta linha.
    var linkDasFotos = Padelizou.Services.FotosDoTorneio.LinkPara(Model);
}
@* ⚠️ A EXPLICAÇÃO DE CADA BOTÃO VIVE NO `title`, E NÃO NUMA LINHA FIXA EMBAIXO (Felipe,
   10/09/2026: *"estou achando muito poluído essa tela, muita informação"*). Eram três botões
   empilhados com uma legenda cada — seis linhas antes do primeiro jogo. Legenda permanente
   ensina na PRIMEIRA visita e é ruído em todas as outras; mesma troca já feita hoje no
   "Sugestão ou bug" do rodapé. *@
@if (cartazNoTopo || podeConvidar || linkDasFotos != null)
{
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        @if (cartazNoTopo)
        {
            <a asp-controller="Cartoes" asp-action="Cartaz" asp-route-id="@Model.Id"
               class="btn btn-outline-primary rounded-pill px-3"
               title="Arte pronta pra postar, com o QR que leva direto pra cá.">
                <i class="bi bi-megaphone-fill"></i> Cartaz pra divulgar
            </a>
        }
        @if (podeConvidar)
        {
            <button type="button" class="btn btn-success rounded-pill px-3"
                    data-bs-toggle="modal" data-bs-target="#modalConvidarPraOTorneio"
                    title="Manda o link da inscrição pra quem você quer no torneio.">
                <i class="bi bi-person-plus-fill"></i> Convidar
            </button>
        }
        @* PRA TODO MUNDO, de propósito, ao contrário dos dois de cima: álbum de torneio é
           divulgação — quem não jogou ver a foto é o que puxa gente pro próximo. *@
        @if (linkDasFotos != null)
        {
            <a href="@linkDasFotos" target="_blank" rel="noopener noreferrer"
               class="btn btn-outline-primary rounded-pill px-3"
               title="Publicadas pelo organizador — abre fora do Padelizou.">
                <i class="bi bi-camera-fill"></i> Ver as fotos do torneio
            </a>
        }
    </div>
}

@* ── O CONVITE PRO TORNEIO ────────────────────────────────────────────────────────────
   Pedido do Felipe (04/09/2026), num print com esta área marcada de verde: "crie um botão
   'convidar' e que é um botão que direciona o link para a pessoa se inscrever no torneio".

   Mesma forma do convite da panelinha (Grupos/Detalhes), e pelo mesmo motivo: o WhatsApp
   cobre a maioria, e o link cru cobre quem cola no Instagram, no e-mail ou num grupo que
   não é do zap. Só o botão verde deixaria essas pessoas sem caminho.

   ⚠️ O `#inscricao` NÃO É ENFEITE: sem ele o convidado cai na aba "Inscritos", que é a lista
   de quem JÁ entrou — a única aba da página que não serve pra se inscrever. Quem faz a hash
   virar aba aberta é o script no fim deste arquivo. *@
@if (podeConvidar)
{
    @* Absoluto (protocol:), como o QR do cartaz: o link vai pro WhatsApp de alguém, e um
       caminho relativo colado lá não leva a lugar nenhum.

       ⚠️ SEM `{ }` em volta destas três linhas. Envolvê-las abriria um escopo aninhado e as
       variáveis não existiriam no HTML abaixo — foi assim que `localDoTorneio`, lá no topo
       do arquivo, ficou invisível pro resto da página. *@
    var linkDoConvite = Url.Action("Details", "Torneios", new { id = Model.Id },
                                   protocol: Context.Request.Scheme) + "#inscricao";
    var localDoConvite = (ViewBag.ClubeDoTorneio as Padelizou.Models.Clube)?.Nome ?? Model.LocalTorneio;
    var textoDoConvite = Padelizou.Services.ConviteProTorneio.Texto(Model, localDoConvite, linkDoConvite);

    <div class="modal fade" id="modalConvidarPraOTorneio" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-person-plus"></i> Convidar pro torneio</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <div class="modal-body">
                    <p class="fw-bold small mb-2"><i class="bi bi-whatsapp text-success"></i> Pelo WhatsApp</p>
                    <p class="text-muted small">
                        Serve até pra quem ainda não tem conta — o link abre a página do torneio
                        já na inscrição.
                    </p>
                    <a class="btn btn-success rounded-pill w-100 mb-3"
                       href="https://wa.me/?text=@Uri.EscapeDataString(textoDoConvite)"
                       target="_blank" rel="noopener">
                        <i class="bi bi-whatsapp"></i> Escolher no WhatsApp
                    </a>

                    @* Em celular antigo o clipboard falha calado; o campo selecionável é a
                       saída pra copiar à mão, mesmo padrão do convite de parceiro. *@
                    <p class="fw-bold small mb-2"><i class="bi bi-link-45deg"></i> Ou copie o link</p>
                    <div class="input-group input-group-sm">
                        <input type="text" class="form-control" id="linkDoConviteDoTorneio" readonly
                               value="@linkDoConvite" onclick="this.select();" />
                        <button class="btn btn-outline-secondary" type="button"
                                onclick="copiarConviteDoTorneio(this);">
                            Copiar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script>
        function copiarConviteDoTorneio(botao) {
            var campo = document.getElementById('linkDoConviteDoTorneio');
            campo.select();
            // Sem clipboard (http, navegador antigo) o texto fica selecionado pra copiar à mão.
            if (navigator.clipboard) {
                navigator.clipboard.writeText(campo.value).then(function () {
                    botao.textContent = 'Copiado!';
                });
            }
        }
    </script>
}

@* ── O GRUPO DO TORNEIO NO WHATSAPP ───────────────────────────────────────────────────
   Quem está inscrito (e quem organiza) ganha o botão de entrar; pra todo o resto ele não
   existe — nem escondido, nem no código-fonte. Esta página abre sem login, e convite de
   grupo é chave de porta: quem tem o link entra, e o organizador só descobre depois.

   Quem decide se ESTA pessoa pode ver é o controller (ViewBag.PodeVerOGrupoDoWhats); o link
   só sai pelo serviço, que confere o endereço de novo na hora de mostrar. A view nunca lê
   Model.LinkGrupoWhatsApp num href — se ler, o portão deixa de existir. *@
@if (Padelizou.Services.GrupoDoTorneioNoWhatsApp.LinkPara(Model, ViewBag.PodeVerOGrupoDoWhats == true) is { } linkDoGrupo)
{
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <a href="@linkDoGrupo" target="_blank" rel="noopener noreferrer"
           class="btn btn-success rounded-pill px-3">
            <i class="bi bi-whatsapp"></i> Entrar no grupo do torneio
        </a>
        <small class="text-muted">
            É onde o organizador avisa mudança de horário e chama pra quadra.
        </small>
    </div>
}

@* ── OS CARDS DE CAMPEÃO ──────────────────────────────────────────────────────────────
   Irmão do bloco das fotos, e pelo mesmo motivo: é PRA TODO MUNDO. A arte de cada
   categoria nasce sozinha quando a final é encerrada, e existe pra sair daqui — é o
   campeão postando sobre ele mesmo que leva a marca junto.

   ⚠️ Quem responde "já tem campeão?" é o serviço, e não um `UltimaFase == "Campeao"`
   escrito aqui: seria a segunda cópia da regra que decide campeão, no lugar mais fácil de
   esquecer no dia em que ela mudar. *@
@if (Padelizou.Services.CampeoesDoTorneio.TemCampeao(Model))
{
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <a asp-controller="Cartoes" asp-action="Campeoes" asp-route-id="@Model.Id"
           class="btn btn-outline-primary rounded-pill px-3">
            <i class="bi bi-trophy-fill"></i> Ver os campeões
        </a>
        @* O pódio aparece SÓ quando há campeão e vice, e por isso não é um segundo botão
           sempre presente: no Americano o vice não existe como carimbo (o campeão sai da
           classificação, não de uma final), e um botão que leva a uma página vazia pra sempre
           é pior que botão nenhum. Quem responde é o serviço, pela mesma razão do de cima. *@
        @if (Padelizou.Services.PodioDaCategoria.TemPodio(Model))
        {
            <a asp-controller="Cartoes" asp-action="Podio" asp-route-id="@Model.Id"
               class="btn btn-outline-primary rounded-pill px-3">
                <i class="bi bi-award-fill"></i> Ver o pódio
            </a>
        }
        <small class="text-muted">
            Uma arte por categoria, pronta pra postar.
        </small>
    </div>
}

@* ── O MVP DO TORNEIO ─────────────────────────────────────────────────────────────────
   Quem jogou elege o melhor entre os campeões, na semana seguinte ao fim do torneio. É a
   única coisa que traz de volta o inscrito COMUM — o que perdeu na segunda rodada e não
   tem mais nada pra fazer aqui até o próximo torneio.

   ⚠️ A janela é LIDA DO RELÓGIO (7 dias depois do último jogo), nunca gravada. É o que faz
   isto valer "pros próximos torneios" sem data de corte no código: torneio que acabou mês
   passado já nasce com a votação fechada. Ver Services/MvpDoTorneio. *@
@* ⚠️ Quem responde "já tem votação?" é o CONTROLLER (ViewBag), e não uma conta aqui: a
   view não tem as partidas do torneio em mãos — `Categoria.Partidas` chega vazia porque o
   Include não a traz — e a conta feita aqui esconderia o botão em silêncio, sempre. *@
@* ⚠️ A MESMA TELA serve duas coisas, e o botão diz qual: o MVP (que o Americano NÃO tem —
   ver MvpDoTorneio.ElegeMvp) e a enquete do clube (que vale em qualquer formato). Sem o
   segundo caso, o rodízio de sábado ficaria sem NENHUM caminho até a avaliação. *@
@if (ViewBag.TemVotacaoDeMvp == true)
{
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <a asp-action="Mvp" asp-route-id="@Model.Id" class="btn btn-outline-primary rounded-pill px-3">
            <i class="bi bi-star-fill"></i> MVP do torneio
        </a>
        <small class="text-muted">
            Quem jogou vota no melhor entre os campeões.
        </small>
    </div>
}
else if (ViewBag.TemEnqueteDoTorneio == true)
{
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <a asp-action="Mvp" asp-route-id="@Model.Id" class="btn btn-outline-primary rounded-pill px-3">
            <i class="bi bi-chat-square-heart-fill"></i> Como foi o torneio?
        </a>
        <small class="text-muted">
            Quem jogou dá nota pro clube, pra organização e pro Padelizou — e comenta se quiser.
        </small>
    </div>
}

@* ── O MURAL: O QUE QUEM JOGOU DISSE ──────────────────────────────────────────────────
   Só o que está publicado. Assinado entra aqui na hora (a pessoa escolheu isso ao
   responder); sem identificação, só depois que o organizador ou o clube decidir — e aí
   sem o nome, porque foi o que foi combinado com quem escreveu.

   ⚠️ O `Autor` chega NULO do serviço quando a resposta é anônima. A view não tem escolha a
   fazer aqui, e é de propósito: não dá pra "esquecer" de esconder o que não veio. *@
@{
    var muralDoTorneio = ViewBag.ComentariosPublicos as List<Padelizou.Services.ComentarioDoTorneio>;
}
@if (muralDoTorneio != null && muralDoTorneio.Count > 0)
{
    <div class="card border-0 shadow-sm rounded-4 mb-3">
        <div class="card-body">
            <h6 class="fw-bold mb-3" style="color: var(--pdz-ink);">
                <i class="bi bi-chat-square-quote-fill" style="color: var(--pdz-lima, #A3D827);"></i>
                O que quem jogou disse
            </h6>

            @foreach (var c in muralDoTorneio)
            {
                <div class="d-flex gap-2 mb-3">
                    @if (c.Autor != null)
                    {
                        <img src="@(string.IsNullOrEmpty(c.FotoDoAutor) ? "/img/default-avatar.png" : c.FotoDoAutor)"
                             alt="" class="rounded-circle flex-shrink-0"
                             style="width:40px;height:40px;object-fit:cover;" />
                    }
                    else
                    {
                        <div class="rounded-circle flex-shrink-0 d-flex align-items-center justify-content-center bg-light text-muted"
                             style="width:40px;height:40px;">
                            <i class="bi bi-person"></i>
                        </div>
                    }

                    <div class="flex-grow-1">
                        <div class="small">
                            @if (c.Autor != null)
                            {
                                <a asp-action="Perfil" asp-controller="Jogadores" asp-route-id="@c.AutorId"
                                   class="fw-semibold text-decoration-none" style="color: var(--pdz-ink);">@c.Autor</a>
                            }
                            else
                            {
                                <span class="fw-semibold text-muted">Um jogador do torneio</span>
                            }
                            <span class="text-muted">· @c.Quando.ToString("dd/MM/yyyy")</span>
                        </div>

                        @if (c.SobreOClube != null)
                        {
                            <div class="small">
                                <span class="text-muted">Sobre o clube:</span> @c.SobreOClube
                            </div>
                        }
                        @if (c.SobreAOrganizacao != null)
                        {
                            <div class="small">
                                <span class="text-muted">Sobre a organização:</span> @c.SobreAOrganizacao
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}

@* ── OS PALPITEIROS ───────────────────────────────────────────────────────────────────
   O Palpitrômetro guardava o palpite de todo mundo desde sempre e nunca dizia quem ACERTOU.
   O ranking é derivado do que já estava lá — por isso nasce com histórico.

   🗣️ Felipe, 10/09/2026, olhando a lista de botões do topo: *"palpiteiros me parece
   duplicado, não?"*. Estava: havia um BOTÃO aqui, pra página cheia (/Torneios/Palpiteiros), e
   uma ABA logo abaixo (#palpiteiros) — o mesmo ícone, o mesmo nome, o mesmo portão
   (`TemRankingDePalpiteiros`) e o MESMO parcial desenhado dos dois lados
   (`_RankingDePalpiteiros`). O botão era o mais antigo; a aba nasceu em 07/09 a pedido dele
   ("deixe uma aba no torneio para verificar o ranking do palpitômetro") e o botão ficou —
   tanto que o comentário da aba diz "a mesma checagem barata que já decide o botão lá em
   cima". Duas portas idênticas não são escolha, são hesitação cobrada de quem só queria ver
   o jogo.

   ✅ FICOU A ABA, que é o que ele pediu e mantém a pessoa na tela. O link pra página cheia
   foi pra DENTRO do painel dela: `Details.cshtml` era o ÚNICO lugar do sistema que apontava
   pra /Torneios/Palpiteiros, e tirar o botão sem mais nada deixaria a página alcançável só
   por quem digitasse a URL — ela existe justamente pra ser mandada no grupo. *@

@* ── SEGUIR O TORNEIO ─────────────────────────────────────────────────────────────────
   "Me avise a cada inscrição nova nesta chave." Só aparece pra quem JÁ ESTÁ INSCRITO
   (decisão do Felipe, 10/08/2026): é quem se inscreveu que fica olhando a chave encher
   pra saber contra quem vai jogar. Pra quem só passou na página, o mesmo aviso é ruído —
   e cada seguidor a mais multiplica uma rajada que num torneio grande já é grande.

   ⚠️ A tela esconde, mas quem RECUSA é o servidor (TorneiosController.Seguir): botão
   escondido nunca foi trava. *@
@if (ViewBag.EstouInscritoNesteTorneio == true)
{
    var jaSigo = ViewBag.SigoEsteTorneio == true;

    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <form asp-controller="Torneios"
              asp-action="@(jaSigo ? "DeixarDeSeguirTorneio" : "SeguirTorneio")"
              asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn @(jaSigo ? "btn-outline-secondary" : "btn-outline-primary") rounded-pill px-3">
                <i class="bi @(jaSigo ? "bi-bell-slash" : "bi-bell")"></i>
                @(jaSigo ? "Parar de receber avisos" : "Seguir este torneio")
            </button>
        </form>
        <small class="text-muted">
            @(jaSigo
                ? "Você recebe um aviso a cada dupla que entra."
                : "Receba um aviso no celular a cada inscrição nova.")
        </small>
    </div>
}

@* ── PAGAR AGORA: a MINHA inscrição está sem pagamento ────────────────────────────────
   Só aparece em torneio que cobra pelo site e que não exige pagamento na hora de entrar —
   ali a vaga já é sua e o dinheiro vem depois. Até 08/08/2026 esse arranjo não tinha saída
   nenhuma: o app não gerava cobrança pra quem já estava inscrito, e o torneio "cobrava pelo
   site" sem que ninguém conseguisse pagar por ele.

   A escolha da forma vai junto (ForcarEscolhaDeForma) porque sem ela a cobrança nasce em
   "UNDEFINED" e o organizador paga a taxa CHEIA em vez da de Pix/boleto. *@
@{
    var minhaDuplaNaoPaga = ViewBag.MinhaInscricaoNaoPagaDuplaId as int?;
    var minhaAmericanaNaoPaga = ViewBag.MinhaInscricaoNaoPagaAmericanaId as int?;
    var valorDaMinhaInscricao = ViewBag.MinhaInscricaoNaoPagaValor as decimal?;
    @* Quem está olhando a tela. A lista de inscritos usa isto pra saber o que é recado
       pessoal (o prazo de pagamento) e o que é informação do torneio (o selo). *@
    var meuJogadorId = ViewBag.MeuJogadorId as int?;
}
@if (minhaDuplaNaoPaga != null || minhaAmericanaNaoPaga != null)
{
    <div class="alert alert-warning border-0 shadow-sm">
        <p class="fw-bold mb-1"><i class="bi bi-cash-coin"></i> Sua inscrição está sem pagamento</p>
        <p class="small mb-3">
            A vaga já é sua — o pagamento é o que falta.
            @if (valorDaMinhaInscricao is decimal valor)
            {
                <text>São <strong>@valor.ToString("C")</strong>.</text>
            }
            @if (Padelizou.Services.PrazoParaPagar.Frase(Model) is { } prazoDaMinha)
            {
                <text><strong>@prazoDaMinha.</strong></text>
            }
        </p>

        <form asp-controller="Torneios" asp-action="PagarInscricao" method="post">
            <input type="hidden" name="torneioId" value="@Model.Id" />
            @if (minhaDuplaNaoPaga is int duplaPagar)
            {
                <input type="hidden" name="duplaId" value="@duplaPagar" />
            }
            else
            {
                <input type="hidden" name="inscricaoAmericanaId" value="@minhaAmericanaNaoPaga" />
            }

            @{
                ViewData["ForcarEscolhaDeForma"] = true;
            }
            <partial name="_EscolhaFormaPagamento" model="Model" />
            @{
                ViewData["ForcarEscolhaDeForma"] = null;
            }

            <button type="submit" class="btn btn-padel rounded-pill">
                <i class="bi bi-credit-card me-1"></i> Pagar agora
            </button>
        </form>
    </div>
}

@* A chave Pix só existe no "por fora": nas formas pelo site o jogador paga no checkout, e uma
   chave na tela seria um segundo caminho pro mesmo dinheiro. O Padelizou não confere nada
   disso — por isso o aviso de acertar o comprovante com o organizador. *@
@if (Padelizou.Services.PixDoOrganizador.ApareceParaMim(Model, ViewBag.DevoAlgumaNesteTorneio == true))
{
    @* Quem recebe o comprovante vem do controller (ViewBag.QuemRecebeOPix), guardado pela
       MESMA condição deste @if — as duas saem de PixDoOrganizador de propósito. *@
    var quemRecebe = ViewBag.QuemRecebeOPix as Padelizou.Models.Jogador;
    var zapDoOrganizador = quemRecebe != null
        && Padelizou.Services.WhatsAppLinkHelper.NumeroValido(quemRecebe.Celular)
        ? Padelizou.Services.WhatsAppLinkHelper.GerarLink(
            quemRecebe.Celular,
            Padelizou.Services.PixDoOrganizador.Mensagem(Model.Nome, ViewBag.MeuNome as string))
        : null;

    @* ── RECOLHIDO PRA QUEM JÁ PAGOU ─────────────────────────────────────────────────────
       🗣️ Emerson Pisoni, 10/09/2026: *"Se o cara já pagou, daria pra tirar info do pagamento,
       ocupa muito espaço"* — no celular dele este bloco empurrava as abas do torneio pra fora
       da tela.

       ⚠️ `<details>` E NÃO UM `if` QUE APAGA — **ENQUANTO A CHAVE NÃO SAI**. Quem diz que a
       inscrição está paga é o organizador virando o `Pago` na mão (muita gente paga em
       dinheiro na quadra), e antes de publicar uma marcação errada dele não tira o caminho de
       ninguém: recolhido, a chave continua a um toque.

       ⚠️ DEPOIS DE PUBLICADO A PROMESSA ACIMA NÃO VALE MAIS, e isso é escolha, não descuido
       (Felipe, 10/09/2026: *"remover a parte de Pix do organizador quando o torneio já foi
       publicado"*). O portão de cima é o `ApareceParaMim`: publicada a chave, o card só existe
       pra quem o sistema acha que DEVE. Marcado como pago por engano, o jogador fica sem
       caminho pro Pix nesta tela — o conserto é o organizador desmarcar o `Pago`, e o caminho
       que sobra pra ele é o botão "Cobrar no WhatsApp" da aba Pagamentos. O comentário antigo
       daqui seguia prometendo o contrário; ficava a documentação de um comportamento que a
       tela não tem mais.

       O `open` sai por atributo condicional: nulo faz o Razor não escrever o atributo, e é
       aberto que o card nasce pra quem ainda deve — e pra quem nem se inscreveu ainda. *@
    bool pixRecolhido = ViewBag.JaPagueiNesteTorneio == true;

    <details class="alert alert-success border-0 pdz-pix" open="@(pixRecolhido ? null : "open")">
        <summary class="fw-bold">
            @if (pixRecolhido)
            {
                <text><i class="bi bi-check-circle-fill"></i> Inscrição paga — ver o Pix do organizador</text>
            }
            else
            {
                <text><i class="bi bi-qr-code"></i> Pix do organizador</text>
            }
        </summary>

        @* QUANTO MANDAR. Vem antes da chave de propósito: a ordem em que se paga é decidir o
           valor, copiar a chave, mandar. Sem este número a pessoa subia até o cabeçalho — que
           mostra o preço POR PESSOA — e numa inscrição de dupla pagava metade. *@
        <p class="mb-2">
            <span class="fs-5 fw-bold">
                @Padelizou.Services.PixDoOrganizador.ValorDaInscricao(Model).ToString("C")
            </span>
            @if (Padelizou.Services.PixDoOrganizador.ValePorPessoaEPorInscricao(Model))
            {
                <span class="small">
                    a inscrição da dupla —
                    @Padelizou.Services.PixDoOrganizador.ValorPorPessoa(Model).ToString("C") por pessoa
                </span>
            }
            else
            {
                <span class="small">por pessoa</span>
            }
        </p>
        @if (Padelizou.Services.PixDoOrganizador.OTotalPodeVariar(Model))
        {
            @* O card não sabe quantas categorias esta pessoa vai pegar nem que impedimentos
               vai marcar. Prometer um total exato aqui seria mandar pagar errado num Pix que
               o Padelizou não vê e não conserta. *@
            <p class="small text-muted mb-2">
                Esse é o valor base: impedimento de horário soma, e a segunda categoria pode
                ter outro preço. Na dúvida, confirme com o organizador antes de mandar.
            </p>
        }

        <div class="input-group input-group-sm mb-2" style="max-width: 34rem;">
            <input type="text" class="form-control" id="campoPixTorneio" readonly
                   value="@Model.ChavePixOrganizador" onclick="this.select();" />
            <button class="btn btn-outline-secondary" type="button" onclick="pdzCopiarPix(this);">Copiar</button>
        </div>
        <p class="small mb-2 text-muted">
            O pagamento é combinado direto com o organizador — o Padelizou não recebe nem
            confere. Mande o comprovante pra ele depois de pagar.
        </p>
        @* O botão SÓ existe com número válido. Sem ele o texto acima continua pedindo o
           comprovante — o que é verdade —, mas a tela não promete um caminho que não tem. *@
        @if (zapDoOrganizador != null)
        {
            <a href="@zapDoOrganizador" target="_blank" rel="noopener"
               class="btn btn-success btn-sm rounded-pill fw-bold">
                <i class="bi bi-whatsapp me-1"></i>
                Enviar o comprovante pro @(quemRecebe!.ComoChamar) no WhatsApp
            </a>
            <p class="small text-muted mb-0 mt-2">
                @* O wa.me não anexa arquivo: a conversa abre com o texto pronto e a foto do
                   comprovante vai pelo próprio WhatsApp. Dizer isso aqui evita a pessoa achar
                   que o comprovante foi junto e não mandar nada. *@
                A conversa abre já escrita — é só anexar a foto do comprovante.
            </p>
        }
    </details>

    <script>
        function pdzCopiarPix(botao) {
            var campo = document.getElementById('campoPixTorneio');
            campo.select();
            // O clipboard falha calado em celular antigo; o select() acima garante que dá
            // pra copiar à mão quando isto não funcionar.
            navigator.clipboard?.writeText(campo.value).then(function () {
                var antes = botao.textContent;
                botao.textContent = 'Copiado!';
                setTimeout(function () { botao.textContent = antes; }, 1500);
            }).catch(function () { });
        }
    </script>
}

@if (TempData["Sucesso"] != null)
{
    <div class="alert alert-success">@TempData["Sucesso"]</div>
}
@if (TempData["Erro"] != null)
{
    <div class="alert alert-danger">@TempData["Erro"]</div>
}
@* O "não coube, e foi por isto" do sorteio (Services/PorQueNaoCoube). Amarelo e não vermelho de
   propósito: o sorteio SAIU, a grade existe e o torneio funciona — o que passou foi o prazo que o
   organizador marcou, e a decisão de encurtar ou alugar mais quadra é dele. *@
@if (TempData["Aviso"] != null)
{
    <div class="alert alert-warning">
        <i class="bi bi-exclamation-triangle-fill"></i> @TempData["Aviso"]
    </div>
}

@* O ATALHO DO MARCADOR. Ele não tem o painel do organizador — sem esta faixa, o posto de
   trabalho dele (a Mesa de Controle) não teria porta nenhuma na página do torneio. Cada
   botão confere de novo no servidor (PodeOperarODiaDeJogoAsync). *@
@if (ViewBag.EhMarcador == true)
{
    <div class="alert alert-info d-flex flex-wrap align-items-center gap-2">
        <i class="bi bi-clipboard-check fs-4"></i>
        <div class="me-auto">
            <strong>Você é marcador deste torneio.</strong>
            <span class="d-block small">Placar, largada dos jogos, W.O., check-in e trocas de quadra e horário.</span>
        </div>
        <a asp-action="MesaControle" asp-route-id="@Model.Id" class="btn btn-sm btn-primary rounded-pill">
            <i class="bi bi-display"></i> Mesa de Controle
        </a>
        <a asp-action="Jogos" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary rounded-pill">
            <i class="bi bi-list-ol"></i> Jogos
        </a>
        @if (Model.UsaCheckIn)
        {
            <a asp-action="CheckIn" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary rounded-pill">
                <i class="bi bi-person-check"></i> Check-in
            </a>
        }
    </div>
}

@* Convite de parceiro recém-gerado. O link fica em cartaz numa caixa de texto selecionável
   em vez de só num botão "copiar": em celular antigo o clipboard falha calado, e aí a pessoa
   ainda consegue selecionar e copiar à mão. *@
@if (TempData["ConviteLink"] is string conviteLink && !string.IsNullOrWhiteSpace(conviteLink))
{
    <div class="alert alert-success">
        <p class="fw-bold mb-1"><i class="bi bi-link-45deg"></i> Link do convite criado</p>
        <p class="small mb-2">
            Manda pra quem você quer como parceiro. Quem abrir entra com a conta dele e fecha a
            dupla — <strong>ninguém precisa do CPF de ninguém</strong>. Gerar outro link invalida este.
        </p>
        <div class="input-group input-group-sm mb-2">
            <input type="text" class="form-control" id="campoConvite" value="@conviteLink" readonly
                   onclick="this.select();" />
            <button class="btn btn-outline-secondary" type="button" onclick="copiarConvite(this);">
                Copiar
            </button>
        </div>
        <a class="btn btn-sm btn-success rounded-pill px-3"
           href="https://wa.me/?text=@Uri.EscapeDataString("Bora jogar em dupla? Aceita o convite aqui: " + conviteLink)"
           target="_blank" rel="noopener">
            <i class="bi bi-whatsapp"></i> Mandar no WhatsApp
        </a>
    </div>
    <script>
        function copiarConvite(botao) {
            var campo = document.getElementById('campoConvite');
            campo.select();
            // Sem clipboard (http, navegador antigo) o texto fica selecionado pra copiar à mão.
            if (navigator.clipboard) {
                navigator.clipboard.writeText(campo.value).then(function () {
                    botao.textContent = 'Copiado!';
                });
            }
        }
    </script>
}

@{
    bool torneioComecou = Model.Status != "Inscrições Abertas";
    var aoVivoLista = ViewBag.AoVivo as List<Padelizou.Models.Partida> ?? new();
    bool temJogoAoVivoAgora = aoVivoLista.Count > 0;
}
<!-- Navegação das Abas -->
@* `pdz-abas`: as abas preenchem a linha em vez de ficarem do tamanho do texto.
   Soltas, elas deixavam três linhas irregulares no celular do organizador — 142px,
   178px e 75px de vão — e a tela parecia quebrada. *@
<ul class="nav nav-tabs pdz-abas" id="torneioTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-bold @(torneioComecou ? "" : "active")" id="inscritos-tab" data-bs-toggle="tab" data-bs-target="#inscritos" type="button" role="tab" style="color: var(--pdz-ink);">
            <i class="bi bi-people-fill"></i> Inscritos
        </button>
    </li>

    <!-- Só mostra a aba de Inscrição se o status permitir -->
    @if (Model.Status == "Inscrições Abertas")
    {
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold" id="inscricao-tab" data-bs-toggle="tab" data-bs-target="#inscricao" type="button" role="tab" style="color: var(--padel-green); background-color: var(--pdz-navy-fixed);">
                <i class="bi bi-pencil-square"></i> Inscreva-se
            </button>
        </li>
    }

    <!-- Aba Exclusiva do Organizador -->
    @if (ViewBag.PodeGerenciar == true)
    {
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold text-danger" id="admin-tab" data-bs-toggle="tab" data-bs-target="#admin" type="button" role="tab">
                <i class="bi bi-gear-fill"></i> Gerenciar Torneio
            </button>
        </li>
    }

    @* Aba PAGAMENTOS — pedido do Felipe (07/09/2026): "criar uma aba para gerenciar melhor os
       pagamentos, impedimentos e cobrar jogador". Financeiro continua existindo do jeito que
       está (o resumo em R$ e o por-categoria); esta aba é o lugar novo pra impedimento e
       cobrança em lote, que não existiam em lugar nenhum.

       ⚠️ REVISTO NO MESMO DIA: nasceu gateada por `PodeVerDinheiro`, o que escondia o
       IMPEDIMENTO (que não é dinheiro) de quem ajuda a organizar sem ver o caixa — pedido do
       Felipe: "a parte de impedimentos do torneio tem que aparecer pro organizador". A aba
       agora abre pra qualquer um que ajuda a organizar (`PodeGerenciar`, a MESMA régua da aba
       "Gerenciar Torneio" ali em cima); o valor de cada inscrição e o botão de cobrar
       continuam atrás de `PodeVerDinheiro` — DENTRO do painel, mesma régua redigida que
       Financeiro.cshtml já usa pro ajudante. *@
    @if (ViewBag.PodeGerenciar == true)
    {
    @* ⚠️ RECOLHIDA, E NÃO APAGADA, depois que a chave sai (Felipe, 10/09/2026: "pode mover para
       dentro do Gerenciar torneio, depois que foi publicada as chaves"). O botão CONTINUA no
       DOM porque TREZE redirects do servidor voltam com o fragmento `#pagamentos`
       (TorneiosController.Inscricoes: impedimento, sedes, janela da sede, cobrança) e a tela
       cheia do Planejamento tem um link `asp-fragment="pagamentos"`. O script do fim deste
       arquivo abre a aba procurando `#torneioTabs [data-bs-target="..."]`: apagado o botão, o
       seletor não acha nada, o script sai calado e o organizador cai na aba padrão toda vez
       que mexe num impedimento.

       ⚠️ A classe vai no <li>, e NÃO no <button>: quem é filho do flex é o <li> — o site.css
       dá `flex: 1 1 auto` a ele, e metade da linha até 430px. Escondendo só o botão, sobra um
       <li> VAZIO reivindicando a largura — dois deles, uma faixa em branco no celular. Ela
       REAPARECE quando esta é a aba ativa (o `:has()` do site.css), senão o painel abriria com
       a barra sem nada marcado. *@
        <li class="nav-item @(AprovacaoDeChaves.ChavePublicada(Model) ? "pdz-aba-recolhida" : "")" role="presentation">
            <button class="nav-link fw-bold" id="pagamentos-tab" data-bs-toggle="tab" data-bs-target="#pagamentos" type="button" role="tab" style="color: var(--pdz-ink);">
                <i class="bi bi-cash-coin"></i> Pagamentos e impedimentos
            </button>
        </li>
    }

    @* Aba PLANEJAMENTO DE QUADRAS — pedido do Felipe (09/09/2026), pelo Er: "eles só têm 2
       quadras (…) querem uma aba que possam ver quantos horários teriam que locar de quadra,
       extra, para fechar os jogos da chave".

       ⚠️ MESMA RÉGUA das duas abas acima (`PodeGerenciar`), e ela já é o recorte que ele pediu
       — "apenas o organizador e criador e nós do sistema": `EhOrganizadorAsync` cobre os três,
       então nenhum papel de acesso novo nasceu aqui.

       Aqui fica só o RESUMO; girar os números é na tela cheia (Torneios/Planejamento), porque
       esta página é a mais pesada do site e recarregá-la a cada volta do botão travaria o
       celular do organizador. *@
    @if (ViewBag.PodeGerenciar == true)
    {
        @* Recolhe junto com a de Pagamentos, e pelo mesmo motivo — ver a nota lá em cima. *@
        <li class="nav-item @(AprovacaoDeChaves.ChavePublicada(Model) ? "pdz-aba-recolhida" : "")" role="presentation">
            <button class="nav-link fw-bold" id="planejamento-tab" data-bs-toggle="tab" data-bs-target="#planejamento" type="button" role="tab" style="color: var(--pdz-ink);">
                <i class="bi bi-calendar-range"></i> Planejamento de quadras
            </button>
        </li>
    }
    <!-- Aba única de Jogos (Ao Vivo/Agendadas/Finalizadas) - só depois que as inscrições fecharem.
         Abre direto em Ao Vivo se tiver jogo rolando agora, senão em Agendadas (ver _JogosDoTorneio.cshtml). -->
    @* Chaves pendentes de aprovação (ver Services/AprovacaoDeChaves) escondem estas duas
       abas de quem não pode aprovar — os jogos já existem no banco, mas ainda não são
       públicos. *@
    @{ bool podeVerChavesPendentes = Model.Status != Padelizou.Services.AprovacaoDeChaves.Pendente || ViewBag.PodeAprovarChaves == true; }
    @if (torneioComecou && podeVerChavesPendentes)
    {
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold active" id="jogos-tab" data-bs-toggle="tab" data-bs-target="#jogosDoTorneio" type="button" role="tab" style="color: var(--pdz-ink);">
                <i class="bi @(temJogoAoVivoAgora ? "bi-broadcast text-danger" : "bi-calendar-week")"></i> Jogos
            </button>
        </li>
    }
    @* A MESMA régua que decide o botão "Chaves e Grupos" da lista de jogos (Services/AbaDeChavesEGrupos):
       lá o link só é oferecido quando esta aba existe de verdade aqui. *@
    @if (AbaDeChavesEGrupos.Existe(Model, ViewBag.PodeAprovarChaves == true))
    {
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold" id="grupos-tab" data-bs-toggle="tab" data-bs-target="#grupos" type="button" role="tab" style="color: var(--pdz-ink);">
                <i class="bi bi-layout-split"></i> Chaves e Grupos
            </button>
        </li>
    }
    @* ⚠️ AMERICANO NÃO PONTUA TIME (decisão do Felipe, 08/08/2026), então a aba nem existe
       nele — a regra de verdade está em EstatisticasService.ObterPontosTimesNoTorneioAsync,
       aqui é só não oferecer uma tela que responderia zero. *@
    @if (torneioComecou && !Padelizou.Services.FormatoDoTorneio.EhAmericano(Model.Formato))
    {
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold" id="times-tab" data-bs-toggle="tab" data-bs-target="#timesTorneio" type="button" role="tab" style="color: var(--pdz-ink);">
                <i class="bi bi-shield-fill"></i> Times
            </button>
        </li>
    }

    @* Aba PALPITEIROS — pedido do Felipe (07/09/2026): "deixe uma aba no torneio para
       verificar o ranking do palpitômetro". Mesma checagem barata que já decide o botão
       lá em cima (ViewBag.TemRankingDePalpiteiros); a aba só existe quando esse "sim"
       já veio, então o ranking (ViewBag.RankingDePalpiteiros) já está pronto pra ela. *@
    @if (ViewBag.TemRankingDePalpiteiros == true)
    {
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold" id="palpiteiros-tab" data-bs-toggle="tab" data-bs-target="#palpiteiros" type="button" role="tab" style="color: var(--pdz-ink);">
                <i class="bi bi-graph-up"></i> Palpiteiros
            </button>
        </li>
    }
</ul>

<!-- Conteúdo das Abas -->
<div class="tab-content border border-top-0 p-4 bg-white shadow-sm" id="torneioTabsContent" style="border-bottom-left-radius: 8px; border-bottom-right-radius: 8px;">

    <!-- ABA 1: LISTA DE INSCRITOS -->
    <div class="tab-pane fade @(torneioComecou ? "" : "show active")" id="inscritos" role="tabpanel">
        @* "Duplas INSCRITAS", e não "Confirmadas": num torneio em que o pagamento é aprovado
           depois, a lista tem gente com pagamento pendente — e "confirmada" ao lado de um selo
           "Pagamento pendente" é a tela se contradizendo. *@
        <h4 class="mb-3" style="color: var(--pdz-ink);">@(Model.Formato == "Americano" ? "Inscritos" : "Duplas Inscritas")</h4>
        @{
            var inscricoesAmericanas = ViewBag.InscricoesAmericanas as List<Padelizou.Models.InscricaoAmericana> ?? new();
        }

        @{
            int categoriaSelecionadaId = ViewBag.CategoriaSelecionadaId is int csid ? csid : 0;
            var todosOsInscritos = Padelizou.Services.InscritosDeTodasAsCategorias.Montar(Model, inscricoesAmericanas);
        }
        <div class="mb-3">
            <label class="form-label fw-bold small">Categoria</label>
            @* O número vai no próprio nome da opção: sem isso, saber onde ainda tem vaga
               exigia abrir uma categoria de cada vez e voltar. *@
            @* Ordem e nome curto vêm de Services/CategoriaNaTela: a lista saía na ordem de
               CRIAÇÃO (a 4ª Feminina, acrescentada depois, caía atrás da 7ª), e o rótulo
               repetia "Categoria" dentro de um campo já chamado Categoria — era essa palavra
               que jogava cada opção pra segunda linha no celular. *@
            <select id="seletorCategoriaInscritos" class="form-select" onchange="mostrarCategoriaInscritos(this.value)">
                @* "Todos" VEM PRIMEIRO e é onde a aba abre pra quem não está inscrito
                   (Felipe, 04/09/2026). A primeira categoria da lista não responde pergunta
                   nenhuma — no ER PADEL TOUR ela mostrava 2 duplas de 49, e quem chegava na
                   página concluía que o torneio estava vazio. *@
                <option value="@Padelizou.Services.InscritosDeTodasAsCategorias.Todos"
                        selected="@(categoriaSelecionadaId == Padelizou.Services.InscritosDeTodasAsCategorias.Todos)">
                    Todas as categorias (@todosOsInscritos.Count)
                </option>
                @foreach (var cat in Model.Categorias.OrderBy(c => Padelizou.Services.CategoriaNaTela.Ordem(c.Nome)))
                {
                    var quantos = Padelizou.Services.QuantosInscritos.DaCategoria(Model, cat, inscricoesAmericanas);
                    var limite = cat.LimiteDuplas.HasValue ? $"/{cat.LimiteDuplas}" : "";
                    <option value="@cat.Id" selected="@(cat.Id == categoriaSelecionadaId)">
                        @Padelizou.Services.CategoriaNaTela.Curto(cat.Nome) (@quantos@limite)
                    </option>
                }
            </select>
        </div>

        @* O PAINEL "TODOS": uma lista chapada, do mais recente pro mais antigo, dizendo a dupla
           e a categoria. Ela responde "quem já entrou neste torneio?", que é a pergunta de quem
           abre a página — a lista por categoria responde outra, e continua ali no seletor.
           Usa a mesma classe dos painéis por categoria pra o JS de troca não precisar saber
           que este existe. *@
        <div class="categoria-inscritos-conteudo"
             data-categoria-id="@Padelizou.Services.InscritosDeTodasAsCategorias.Todos"
             style="display: @(categoriaSelecionadaId == Padelizou.Services.InscritosDeTodasAsCategorias.Todos ? "block" : "none");">
            @if (!todosOsInscritos.Any())
            {
                <p class="text-muted mb-0 small"><i class="bi bi-info-circle"></i> Ninguém inscrito ainda.</p>
            }
            else
            {
                <p class="text-muted small mb-2">@todosOsInscritos.Count inscrito(s), do mais recente pro mais antigo</p>
                <div class="list-group shadow-sm">
                    @foreach (var linha in todosOsInscritos)
                    {
                        <div class="list-group-item d-flex flex-wrap align-items-center gap-2">
                            <span class="fw-semibold flex-grow-1">@linha.Dupla</span>
                            @if (linha.EmListaDeEspera)
                            {
                                @* Sem esta marca a espera pareceria vaga confirmada, e a conta
                                   do topo da página não bateria com o que a lista mostra. *@
                                <span class="badge bg-secondary">Lista de espera</span>
                            }
                            <span class="badge bg-primary-subtle text-primary-emphasis">
                                @Padelizou.Services.CategoriaNaTela.Curto(linha.Categoria)
                            </span>
                            @if (linha.Quando is DateTime quandoEntrou)
                            {
                                <small class="text-muted">@quandoEntrou.ToString("dd/MM")</small>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        @foreach (var cat in Model.Categorias)
        {
            var inscritosAmericano = inscricoesAmericanas.Where(i => i.CategoriaId == cat.Id && !i.EmListaDeEspera).ToList();
            var esperaAmericano = inscricoesAmericanas.Where(i => i.CategoriaId == cat.Id && i.EmListaDeEspera).OrderBy(i => i.Id).ToList();
            var duplasConfirmadas = cat.Duplas.Where(d => !d.EmListaDeEspera).ToList();
            var duplasEspera = cat.Duplas.Where(d => d.EmListaDeEspera).OrderBy(d => d.Id).ToList();
            ViewData["CategoriaAtual"] = cat.Nome;
            <div class="categoria-inscritos-conteudo" data-categoria-id="@cat.Id" style="display: @(cat.Id == categoriaSelecionadaId ? "block" : "none");">
                @* ⚠️ POR QUE O BOTÃO DO MURAL SUMIU, dito UMA VEZ por categoria (21/08/2026).
                   Botão que desaparece sem explicação vira pergunta no WhatsApp; a mesma frase
                   repetida em nove cards é o ruído que esta tela já briga pra evitar. *@
                @if (meuIdNaPagina != null && minhasInscricoes != null
                     && MuralDeParceiros.AvisoDeQueJaEstaNestaCategoria(minhasInscricoes, cat.Id, meuIdNaPagina.Value) is { } jaEstouAqui)
                {
                    <p class="text-muted small mb-2"><i class="bi bi-info-circle"></i> @jaEstouAqui</p>
                }
                <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                    <div class="d-flex gap-2 flex-wrap">
                        @* Singular certo: escrevia "1 duplas" desde sempre, e agora ficaria
                           logo abaixo do total do cabeçalho, que acerta. *@
                        @if (cat.DeTimes)
                        {
                            <span class="badge" style="background-color: var(--pdz-navy-fixed);">
                                @Padelizou.Services.QuantosInscritos.Rotulo(cat.Duplas.Count(d => d.NomeTime != null), "time", "times")
                            </span>
                        }
                        else if (Model.Formato == "Americano")
                        {
                            <span class="badge" style="background-color: var(--pdz-navy-fixed);">
                                @Padelizou.Services.QuantosInscritos.Rotulo(inscritosAmericano.Count, "inscrito", "inscritos")
                            </span>
                        }
                        else
                        {
                            <span class="badge" style="background-color: var(--pdz-navy-fixed);">
                                @Padelizou.Services.QuantosInscritos.Rotulo(duplasConfirmadas.Count, "dupla", "duplas")
                            </span>
                        }
                        @{
                            int qtdEspera = Model.Formato == "Americano" ? esperaAmericano.Count : duplasEspera.Count;
                        }
                        @if (cat.LimiteDuplas.HasValue)
                        {
                            <span class="badge bg-secondary">Limite: @cat.LimiteDuplas</span>
                        }
                        @if (qtdEspera > 0)
                        {
                            <span class="badge bg-warning text-dark">@qtdEspera na lista de espera</span>
                        }
                    </div>
                    @if (Model.Formato == "Americano")
                    {
                        <a asp-controller="Torneios" asp-action="ClassificacaoAmericano" asp-route-id="@Model.Id" asp-route-categoriaId="@cat.Id" class="btn btn-sm btn-outline-primary rounded-pill">
                            <i class="bi bi-list-ol"></i> Ver Classificação Individual
                        </a>
                    }
                </div>
                @if (cat.DeTimes)
                {
                    @* Categoria de TIMES: quem aparece aqui são os times cadastrados pelo
                       organizador — jogador não se inscreve nela. *@
                    var timesDaCategoria = cat.Duplas.Where(d => d.NomeTime != null).OrderBy(d => d.NomeTime).ToList();
                    <div class="alert alert-light border small mb-3">
                        <i class="bi bi-people-fill" style="color: var(--padel-green);"></i>
                        <strong>Categoria de times:</strong>
                        @timesDaCategoria.Count de @(cat.QuantidadeTimes ?? timesDaCategoria.Count) times ·
                        @(cat.QuantidadeGrupos ?? 1) grupo(s) · classificam
                        @Padelizou.Services.ClassificacaoDeGrupos.VagasPorGrupo(cat) por grupo.
                        Os times são cadastrados pelo organizador.
                    </div>
                    @if (timesDaCategoria.Any())
                    {
                        <div class="row row-cols-1 row-cols-md-2 g-3">
                            @foreach (var time in timesDaCategoria)
                            {
                                <div class="col">
                                    <div class="border rounded p-3 h-100">
                                        <partial name="_LadoDaPartida" model="time" />
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0 small"><i class="bi bi-info-circle"></i> Nenhum time cadastrado ainda.</p>
                    }
                }
                else if (Model.Formato == "Americano")
                {
                    @if (inscritosAmericano.Any())
                    {
                        <div class="row row-cols-1 row-cols-md-2 g-3">
                            @foreach (var inscricao in inscritosAmericano)
                            {
                                <div class="col">
                                    <div class="border rounded p-3 h-100">
                                        @* Mesmo selo da inscrição em dupla: no Americano a
                                           inscrição é individual, mas o pagamento é a mesma
                                           história. *@
                                        @if (Padelizou.Services.PagamentoDaInscricao.TemOQueMostrar(Model))
                                        {
                                            <span class="badge @Padelizou.Services.PagamentoDaInscricao.Cor(inscricao.Pago) mb-2">
                                                <i class="bi @(inscricao.Pago ? "bi-check-circle" : "bi-hourglass-split")"></i>
                                                @Padelizou.Services.PagamentoDaInscricao.Selo(inscricao.Pago)
                                            </span>
                                            @* O prazo é do dono da inscrição, igual à lista de duplas —
                                               a mesma régua nos dois lugares, senão só um dos dois
                                               receberia a próxima mudança. *@
                                            @if (Padelizou.Services.PrazoParaPagar.FraseParaODono(
                                                    Model, inscricao.JogadorId == meuJogadorId, inscricao.Pago) is { } prazoAmericano)
                                            {
                                                <span class="badge bg-secondary mb-2 ms-1">@prazoAmericano</span>
                                            }
                                        }
                                        <partial name="_JogadorChip" model="inscricao.Jogador" />

                                        @* Sair do Americano. O botão da lista de duplas nunca
                                           chegou aqui: inscrição de Americano é individual e
                                           mora em outra tabela, então quem jogava Americano
                                           voltava a depender de mensagem pro organizador.
                                           Aparece só na SUA inscrição — no card dos outros
                                           seria um botão pra tirar gente do torneio. *@
                                        @if (meuJogadorId != null && Model.Status == "Inscrições Abertas"
                                             && inscricao.JogadorId == meuJogadorId)
                                        {
                                            var avisoDePagoAmericano = inscricao.Pago
                                                ? " Esta inscrição está paga: a devolução é feita pelo organizador, não é automática — ele será avisado."
                                                : "";

                                            <form asp-controller="Torneios" asp-action="DesistirDoAmericano" method="post" class="mt-2"
                                                  data-confirmar-tom="perigo"
                                                  data-confirmar-titulo="Cancelar sua inscrição?"
                                                  data-confirmar="Sua vaga volta pra fila e alguém da lista de espera pode assumir.@avisoDePagoAmericano"
                                                  data-confirmar-ok="Cancelar inscrição">
                                                <input type="hidden" name="inscricaoId" value="@inscricao.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                                    <i class="bi bi-box-arrow-left"></i>
                                                    Cancelar minha inscrição
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0 small"><i class="bi bi-info-circle"></i> Nenhum jogador inscrito nesta categoria ainda.</p>
                    }
                }
                else if (duplasConfirmadas.Any())
                {
                    <div class="row row-cols-1 row-cols-md-2 g-3">
                        @foreach (var dupla in duplasConfirmadas)
                        {
                            <div class="col">
                                <div class="border rounded p-3 h-100">
                                    @* O selo do pagamento (Felipe, 08/08/2026). Neste torneio o
                                       pagamento é aprovado pelo organizador, então a inscrição
                                       existe antes do dinheiro — e a lista não dizia nada sobre
                                       isso. Quem não pagou CONTINUA aparecendo: a vaga é dele,
                                       muda só o selo. Ver Services/PagamentoDaInscricao. *@
                                    @if (Padelizou.Services.PagamentoDaInscricao.TemOQueMostrar(Model))
                                    {
                                        <span class="badge @Padelizou.Services.PagamentoDaInscricao.Cor(dupla.Pago) mb-2">
                                            <i class="bi @(dupla.Pago ? "bi-check-circle" : "bi-hourglass-split")"></i>
                                            @Padelizou.Services.PagamentoDaInscricao.Selo(dupla.Pago)
                                        </span>
                                        @* O prazo ao lado do selo: "pendente" sem data não diz se é
                                           pra hoje ou pro mês que vem. Só aparece quando existe data
                                           combinada — e SÓ PRA QUEM DEVE, porque é recado pessoal e
                                           não placar público (ver PrazoParaPagar.FraseParaODono). *@
                                        @* ⚠️ O `meuJogadorId != null` não é sobra: `Jogador2Id` é
                                           anulável, e sem a guarda a dupla SEM PARCEIRO casaria
                                           com o visitante deslogado (nulo == nulo). *@
                                        @if (Padelizou.Services.PrazoParaPagar.FraseParaODono(Model,
                                                souDaInscricao: meuJogadorId != null
                                                    && (dupla.Jogador1Id == meuJogadorId || dupla.Jogador2Id == meuJogadorId),
                                                pago: dupla.Pago) is { } prazoDupla)
                                        {
                                            <span class="badge bg-secondary mb-2 ms-1">@prazoDupla</span>
                                        }
                                    }
                                    <partial name="_JogadorChip" model="dupla.Jogador1" />
                                    @* Inscrição sem parceiro tem Jogador2 nulo — o chip
                                       espera um jogador de verdade e explodia a tela toda. *@
                                    @if (dupla.Jogador2 != null)
                                    {
                                        <partial name="_JogadorChip" model="dupla.Jogador2" />
                                    }
                                    else
                                    {
                                        <span class="d-flex align-items-center gap-2 text-muted small">
                                            <i class="bi bi-person-plus" style="font-size: 1.4rem;"></i>
                                            Procurando parceiro
                                            @* DE QUE LADO ELE JOGA — é o que separa uma inscrição
                                               da outra numa lista de 9 "procurando parceiro".
                                               ⚠️ Sai do LadoNaQuadra.Efetivo: inscrição sem
                                               escolha (feita antes disto existir) cai no lado do
                                               PERFIL, e "Ambos" não vira selo — repetido em nove
                                               linhas seria ruído empurrando pra baixo o que
                                               distingue. *@
                                            @{
                                                var ladoDele = Padelizou.Services.LadoNaQuadra.Rotulo(
                                                    Padelizou.Services.LadoNaQuadra.Efetivo(
                                                        dupla.LadoJogador1, dupla.Jogador1?.LadoQuadra));
                                            }
                                            @if (ladoDele != null)
                                            {
                                                <span class="badge rounded-pill text-bg-secondary fw-normal">
                                                    <i class="bi bi-arrow-left-right"></i> @ladoDele
                                                </span>
                                            }
                                        </span>

                                        @* O MURAL EM AÇÃO: "quero jogar com você", pra quem está
                                           logado e não é o dono da vaga. Só manda o recado — quem
                                           fecha a dupla é o dono (ver Services/MuralDeParceiros).

                                           ⚠️ A CONDIÇÃO SAIU DAQUI E VIROU CHAMADA AO SERVIÇO
                                           (21/08/2026). Este `@if` era a SEGUNDA CÓPIA da régua,
                                           com `"Inscrições Abertas"` em string crua e o
                                           "dupla já fechou" garantido só pela posição dentro do
                                           `else` — e foi por isso que a regra nova ("quem já tem
                                           dupla nesta categoria não chama") não tinha onde entrar
                                           sem nascer em dois lugares. *@
                                        @* ⚠️ `duplasQueJaJogaram != null` pelo MESMO motivo do
                                           `minhasInscricoes` acima: ViewBag é dynamic, e um
                                           fallback vazio aqui significaria "a bola não rolou" —
                                           o valor PERMISSIVO. Se a chave for renomeada, o botão
                                           some (seguro) em vez de aparecer onde não deve. *@
                                        @if (meuIdNaPagina != null && minhasInscricoes != null && duplasQueJaJogaram != null
                                             && MuralDeParceiros.MotivoParaNaoChamar(dupla, Model, meuIdNaPagina.Value, minhasInscricoes,
                                                    duplasQueJaJogaram.Contains(dupla.Id)) == null
                                             && !chamadosQueEuFiz.Contains(dupla.Id))
                                        {
                                            <form asp-controller="Duplas" asp-action="ChamarParaDupla" method="post" class="mt-1">
                                                <input type="hidden" name="duplaId" value="@dupla.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-success rounded-pill px-3">
                                                    <i class="bi bi-hand-index-thumb"></i> Quero jogar com @(dupla.Jogador1?.ComoChamar ?? "esta dupla")
                                                </button>
                                            </form>
                                        }
                                    }

                                    @* TIRAR O PEDIDO (21/08/2026): "se ele se candidatou e se
                                       arrependeu, ele pode remover essa solicitação".

                                       ⚠️ FICA FORA DO `else` de "a dupla já fechou", de propósito.
                                       Dentro dele, o botão sumiria exatamente quando a dupla
                                       fechasse POR OUTRO CAMINHO (troca de parceiro, que não varre
                                       os chamados) — e a linha viraria zumbi, inalcançável pelos
                                       dois lados: o dono também não a vê, porque a tela dele
                                       filtra inscrição sem parceiro. *@
                                    @if (meuIdNaPagina != null && chamadosQueEuFiz.Contains(dupla.Id))
                                    {
                                        <div class="mt-1 d-flex align-items-center gap-2 flex-wrap">
                                            <span class="badge text-bg-light border fw-normal">
                                                <i class="bi bi-hourglass-split"></i> Você chamou
                                            </span>
                                            <form asp-controller="Duplas" asp-action="TirarChamado" method="post" class="d-inline">
                                                <input type="hidden" name="duplaId" value="@dupla.Id" />
                                                <input type="hidden" name="torneioId" value="@Model.Id" />
                                                <button type="submit" class="btn btn-link btn-sm text-muted p-0 text-decoration-underline">
                                                    tirar pedido
                                                </button>
                                            </form>
                                        </div>
                                    }

                                    @* AS AÇÕES DA PRÓPRIA INSCRIÇÃO. Aparecem só na SUA: no card dos
                                       outros, "desistir" seria um botão pra tirar gente do torneio.

                                       ⚠️ DUAS JANELAS AQUI DENTRO, e misturá-las foi um defeito real
                                       (achado em revisão adversarial, 09/09/2026): DESISTIR e trocar
                                       IMPEDIMENTO seguem presos em "Inscrições Abertas" — depois do
                                       sorteio a dupla está numa chave e sair é assunto do organizador.
                                       Mas DEFINIR o parceiro que falta vale até a dupla entrar em
                                       quadra, e esta cópia tinha ficado com a régua velha: o push que
                                       o encerramento manda ("dá pra fechar pela página do torneio")
                                       chegava numa tela sem botão nenhum — a promessa central da
                                       mudança sem caminho pro Paulo. A cópia do organizador já tinha
                                       sido repontada; esta não. *@
                                    @{
                                        var minhaInscricao = meuIdNaPagina != null
                                            && (dupla.Jogador1Id == meuIdNaPagina || dupla.Jogador2Id == meuIdNaPagina);
                                        var inscricoesAbertas = Model.Status == "Inscrições Abertas";
                                        var podeDefinirNaMinha = duplasQueJaJogaram != null
                                            && Padelizou.Services.JanelaDoParceiro.MotivoParaNaoDefinir(
                                                    dupla, Model, duplasQueJaJogaram.Contains(dupla.Id)) == null;
                                    }
                                    @if (minhaInscricao && (inscricoesAbertas || podeDefinirNaMinha))
                                    {
                                        var sozinho = dupla.Jogador2Id == null;

                                        @* O dinheiro não volta sozinho — estornar é botão do organizador
                                           (ESTORNO.md). Quem pagou precisa saber disso ANTES de confirmar,
                                           senão cancela achando que a devolução vem junto. *@
                                        var avisoDePago = dupla.Pago
                                            ? " Esta inscrição está paga: a devolução é feita pelo organizador, não é automática — ele será avisado."
                                            : "";

                                        @* PÔR OU TROCAR O PARCEIRO NA PRÓPRIA INSCRIÇÃO.
                                           O servidor sempre deixou — TrocarParceiro e GerarConvite
                                           aceitam "qualquer um dos dois integrantes" — mas os botões
                                           só existiam no painel "Gerenciar Inscritos", que é do
                                           organizador. Quem se inscreveu sozinho abria a própria
                                           inscrição, lia "Procurando parceiro" e só tinha o botão de
                                           cancelar: para trocar de parceiro precisava desistir e se
                                           inscrever de novo, perdendo a vaga na fila.

                                           Time não entra: quem monta a lista é o organizador, e o
                                           "parceiro" de um time é a linha do próprio time. *@
                                        @if (!dupla.EhTime && (podeDefinirNaMinha || (inscricoesAbertas && !sozinho)))
                                        {
                                            <div class="d-flex flex-wrap gap-2 mt-2">
                                                @* QUEM ME CHAMOU, na própria inscrição.
                                                   ⚠️ Vem PRIMEIRO e em destaque: é gente esperando
                                                   resposta, e responder fecha a dupla na hora — vale
                                                   mais que gerar link pra mandar por fora.
                                                   Sem este botão a tela de aceitar só era alcançável
                                                   pelo AVISO, e quem apagasse a notificação perdia o
                                                   caminho: a inscrição não dizia que havia alguém
                                                   esperando. *@
                                                @{
                                                    var chamadosPorInscricao = ViewBag.ChamadosPorInscricao
                                                        as Dictionary<int, int> ?? new Dictionary<int, int>();
                                                    chamadosPorInscricao.TryGetValue(dupla.Id, out var quantosMeChamaram);
                                                }
                                                @if (sozinho && quantosMeChamaram > 0)
                                                {
                                                    <a asp-controller="Duplas" asp-action="Chamados" asp-route-duplaId="@dupla.Id"
                                                       class="btn btn-sm btn-padel rounded-pill px-3 fw-bold">
                                                        <i class="bi bi-people-fill"></i>
                                                        @quantosMeChamaram quer@(quantosMeChamaram > 1 ? "em" : "") jogar com você
                                                    </a>
                                                }
                                                @if (sozinho)
                                                {
                                                    @* Vem antes do CPF porque é o caminho que a maioria
                                                       usa: fecha a dupla sem ninguém precisar do documento
                                                       do outro. *@
                                                    <form asp-controller="Duplas" asp-action="GerarConvite" method="post">
                                                        <input type="hidden" name="duplaId" value="@dupla.Id" />
                                                        <button type="submit" class="btn btn-sm btn-outline-success rounded-pill px-3">
                                                            <i class="bi bi-link-45deg"></i> Convidar por link
                                                        </button>
                                                    </form>
                                                }
                                                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3"
                                                        data-bs-toggle="collapse" data-bs-target="#meuParceiro-@dupla.Id">
                                                    <i class="bi bi-arrow-left-right"></i>
                                                    @(sozinho ? "Definir por CPF" : "Trocar parceiro")
                                                </button>
                                            </div>

                                            @* Mesmas classes do formulário do organizador: o script que
                                               faz a caixa "juntar com a inscrição que já existe" aparecer
                                               se liga em .pdz-form-parceiro, então este ganha o
                                               comportamento sem uma linha de JS a mais. Os ids têm prefixo
                                               próprio porque quem organiza vê as DUAS telas na mesma
                                               página, e id repetido faria um botão abrir o outro. *@
                                            <div class="collapse mt-2" id="meuParceiro-@dupla.Id">
                                                <form asp-controller="Duplas" asp-action="TrocarParceiro" method="post"
                                                      class="border rounded p-2 pdz-form-parceiro"
                                                      data-categoria="@dupla.CategoriaId">
                                                    <input type="hidden" name="duplaId" value="@dupla.Id" />

                                                    @* ACHAR PELO NOME. Igual ao da inscrição, e pelo mesmo
                                                       motivo: ninguém sabe o CPF do parceiro de cabeça — o
                                                       organizador, corrigindo a inscrição de outra pessoa,
                                                       menos ainda. Aqui os seletores são CLASSES e não ids
                                                       porque esta caixa se repete uma vez por dupla na
                                                       página; id repetido faria a lista de uma abrir dentro
                                                       da outra. *@
                                                    <div class="position-relative mb-2 pdz-bp-caixa">
                                                        <input type="text" class="form-control form-control-sm pdz-bp-campo"
                                                               placeholder="Procure pelo nome ou apelido"
                                                               autocomplete="off" spellcheck="false" />
                                                        <div class="small text-muted mt-1 pdz-bp-dica">
                                                            Digite 3 letras e escolha na lista. Não achou? Preencha o CPF abaixo.
                                                        </div>
                                                        <input type="hidden" name="novoParceiroId" class="pdz-bp-id" />
                                                        <div class="list-group position-absolute w-100 shadow d-none pdz-busca-lista pdz-bp-lista"></div>
                                                    </div>

                                                    <div class="alert alert-success py-2 px-3 d-none d-flex justify-content-between align-items-center pdz-bp-escolhido">
                                                        <span><i class="bi bi-check-circle-fill"></i> <strong class="pdz-bp-escolhido-nome"></strong></span>
                                                        <button type="button" class="btn btn-sm btn-link text-decoration-none p-0 pdz-bp-trocar">trocar</button>
                                                    </div>

                                                    <div class="row g-2 align-items-center">
                                                        <div class="col-12 pdz-bp-por-cpf">
                                                            <div class="row g-2">
                                                                <div class="col-12">
                                                                    <input type="text" name="cpfNovoParceiro" class="form-control form-control-sm"
                                                                           placeholder="CPF do parceiro" data-mascara="cpf" inputmode="numeric" required />
                                                                </div>
                                                                <div class="col-12">
                                                                    <input type="text" name="nomeNovoParceiro" class="form-control form-control-sm"
                                                                           placeholder="Nome (só se ainda não tiver cadastro)" />
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-12">
                                                            <button type="submit" class="btn btn-sm btn-padel w-100">
                                                                <i class="bi bi-check-lg"></i> Confirmar
                                                            </button>
                                                        </div>
                                                    </div>

                                                    <div class="form-check mt-2 d-none pdz-juntar-caixa">
                                                        <input class="form-check-input" type="checkbox" value="true"
                                                               name="juntarComInscricaoSolo" id="meuJuntar-@dupla.Id" />
                                                        <label class="form-check-label small" for="meuJuntar-@dupla.Id">
                                                            Juntar com a inscrição que já existe
                                                            <span class="text-muted d-block pdz-juntar-quem"></span>
                                                        </label>
                                                    </div>

                                                    <small class="text-muted d-block mt-1">
                                                        @(sozinho
                                                            ? "Seu parceiro é avisado. Se ele já estiver inscrito sozinho, dá pra juntar as duas inscrições."
                                                            : "Quem sai e quem entra são avisados.")
                                                    </small>
                                                </form>
                                            </div>
                                        }

                                        @* ⚠️ DAQUI PRA BAIXO, SÓ COM AS INSCRIÇÕES ABERTAS. O bloco de
                                           fora passou a aceitar também a janela de definir parceiro, e
                                           sem esta cerca o impedimento e o desistir vazariam pra depois
                                           do sorteio — os dois mexem na grade já montada, e é por isso
                                           que os controllers deles recusam ali. *@
                                        @if (inscricoesAbertas)
                                        {
                                        @* TROCAR O IMPEDIMENTO, até o fechamento das inscrições.
                                           🗣️ Felipe, 02/09/2026. O turno era escolhido uma vez, na
                                           inscrição, e não tinha volta — quem descobria o compromisso
                                           depois só resolvia falando com o organizador.
                                           A régua do dinheiro é dele: trocar um turno por outro mantém
                                           o custo (a quantidade continua 1); marcar o primeiro cobra a
                                           taxa, e a tela diz isso ANTES de gravar. *@
                                        // (bloco de codigo: ja estamos dentro de um @if)
                                            var turnoAtual = Padelizou.Services.AlteracaoDeImpedimento.TurnoAtual(dupla);
                                            var turnosOferecidos = new List<(Padelizou.Services.TurnoDoImpedimento Turno, bool Cabe)>
                                            {
                                                (Padelizou.Services.TurnoDoImpedimento.Nenhum, true),
                                                (Padelizou.Services.TurnoDoImpedimento.QuintaNoite, Model.QuintaEhDiaDoTorneio && Model.PermiteImpedimentoQuintaNoite),
                                                (Padelizou.Services.TurnoDoImpedimento.SextaNoite, Model.PermiteImpedimentoSextaNoite),
                                                (Padelizou.Services.TurnoDoImpedimento.SabadoManha, Model.PermiteImpedimentoSabadoManha),
                                                (Padelizou.Services.TurnoDoImpedimento.SabadoTarde, Model.PermiteImpedimentoSabadoTarde),
                                            };
                                        @if (Model.PermiteImpedimentos && turnosOferecidos.Count(t => t.Cabe) > 1)
                                        {
                                            <form asp-controller="Torneios" asp-action="AlterarImpedimento" method="post" class="mt-2">
                                                <input type="hidden" name="duplaId" value="@dupla.Id" />
                                                <label class="form-label small fw-bold mb-1">Impedimento de horário</label>
                                                <div class="input-group input-group-sm" style="max-width: 26rem;">
                                                    <select name="turno" class="form-select">
                                                        @foreach (var opcao in turnosOferecidos.Where(t => t.Cabe))
                                                        {
                                                            <option value="@opcao.Turno" selected="@(opcao.Turno == turnoAtual)">
                                                                @Padelizou.Services.AlteracaoDeImpedimento.Rotulo(opcao.Turno)
                                                            </option>
                                                        }
                                                    </select>
                                                    <button type="submit" class="btn btn-outline-secondary">Trocar</button>
                                                </div>
                                                @* O aviso do dinheiro só aparece quando há dinheiro em jogo:
                                                   quem já tem um impedimento marcado troca de graça. *@
                                                @if (Model.TaxaPorImpedimento > 0
                                                     && turnoAtual == Padelizou.Services.TurnoDoImpedimento.Nenhum)
                                                {
                                                    <small class="text-muted d-block mt-1">
                                                        Marcar um impedimento soma
                                                        <strong>@Model.TaxaPorImpedimento.ToString("C")</strong> à sua inscrição.
                                                        Trocar um turno por outro depois não custa nada.
                                                    </small>
                                                }
                                                else if (Model.TaxaPorImpedimento > 0)
                                                {
                                                    <small class="text-muted d-block mt-1">
                                                        Trocar de turno não muda o valor. Tirar o impedimento devolve
                                                        <strong>@Model.TaxaPorImpedimento.ToString("C")</strong> ao que você deve.
                                                    </small>
                                                }
                                                <small class="text-muted d-block">Seu parceiro é avisado da troca.</small>
                                            </form>
                                        }

                                        @if (sozinho)
                                        {
                                            <form asp-controller="Torneios" asp-action="Desistir" method="post" class="mt-2"
                                                  data-confirmar-tom="perigo"
                                                  data-confirmar-titulo="Cancelar sua inscrição?"
                                                  data-confirmar="Sua vaga volta pra fila e alguém da lista de espera pode assumir.@avisoDePago"
                                                  data-confirmar-ok="Cancelar inscrição">
                                                <input type="hidden" name="duplaId" value="@dupla.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                                    <i class="bi bi-box-arrow-left"></i>
                                                    Cancelar minha inscrição
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            @* Dupla completa tem DUAS saídas, e o sistema não tem como
                                               adivinhar qual. Antes ele escolhia "sai só eu" por você, e a
                                               dupla que desistia junto precisava clicar em duas contas —
                                               a segunda quase nunca clicava, e meia inscrição segurava a
                                               vaga até o encerramento. *@
                                            <div class="d-flex flex-wrap gap-2 mt-2">
                                                <form asp-controller="Torneios" asp-action="Desistir" method="post"
                                                      data-confirmar-tom="perigo"
                                                      data-confirmar-titulo="Sair da dupla?"
                                                      data-confirmar="Seu parceiro continua inscrito e vai precisar achar outro antes do sorteio. A vaga não abre.@avisoDePago"
                                                      data-confirmar-ok="Sair da dupla">
                                                    <input type="hidden" name="duplaId" value="@dupla.Id" />
                                                    <input type="hidden" name="escolha" value="@Padelizou.Services.EscolhaDeQuemSai.SoEu" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                                        <i class="bi bi-box-arrow-left"></i>
                                                        Sair só eu
                                                    </button>
                                                </form>

                                                <form asp-controller="Torneios" asp-action="Desistir" method="post"
                                                      data-confirmar-tom="perigo"
                                                      data-confirmar-titulo="Cancelar a inscrição dos dois?"
                                                      data-confirmar="Seu parceiro também sai do torneio e será avisado. A vaga volta pra fila e alguém da lista de espera pode assumir.@avisoDePago"
                                                      data-confirmar-ok="Cancelar a inscrição">
                                                    <input type="hidden" name="duplaId" value="@dupla.Id" />
                                                    <input type="hidden" name="escolha" value="@Padelizou.Services.EscolhaDeQuemSai.ADuplaInteira" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                                        <i class="bi bi-box-arrow-left"></i>
                                                        Sair os dois
                                                    </button>
                                                </form>
                                            </div>
                                        }
                                        }
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted mb-0 small"><i class="bi bi-info-circle"></i> Nenhuma dupla inscrita nesta categoria ainda.</p>
                }

                @if (qtdEspera > 0)
                {
                    <h6 class="fw-bold text-muted text-uppercase small mt-4 mb-2"><i class="bi bi-hourglass-split"></i> Lista de Espera</h6>
                    @if (Model.Formato == "Americano")
                    {
                        <div class="row row-cols-1 row-cols-md-2 g-3">
                            @for (int i = 0; i < esperaAmericano.Count; i++)
                            {
                                <div class="col">
                                    <div class="border border-warning rounded p-3 h-100 pdz-tinta-ambar">
                                        <span class="badge bg-warning text-dark mb-1">@(i + 1)º na fila</span>
                                        <partial name="_JogadorChip" model="esperaAmericano[i].Jogador" />
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="row row-cols-1 row-cols-md-2 g-3">
                            @for (int i = 0; i < duplasEspera.Count; i++)
                            {
                                <div class="col">
                                    <div class="border border-warning rounded p-3 h-100 pdz-tinta-ambar">
                                        <span class="badge bg-warning text-dark mb-1">@(i + 1)º na fila</span>
                                        <partial name="_JogadorChip" model="duplasEspera[i].Jogador1" />
                                        <partial name="_JogadorChip" model="duplasEspera[i].Jogador2" />
                                    </div>
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        }
    </div>

    <!-- ABA 2: FORMULÁRIO DE INSCRIÇÃO -->
    <div class="tab-pane fade" id="inscricao" role="tabpanel">
        <h4 class="mb-3" style="color: var(--pdz-ink);">Formulário de Inscrição</h4>

        @* Inscrever exige login (ver DuplasController.Create). Mostrar o formulário pra quem
           está deslogado seria uma armadilha: a pessoa preenche CPF, nome, celular e cidade da
           dupla inteira, aperta confirmar e é jogada pro login — perdendo tudo. Melhor pedir a
           entrada ANTES de ela digitar a primeira letra. *@
        @if (User.Identity?.IsAuthenticated != true)
        {
            var voltarPara = $"/Torneios/Details/{Model.Id}";
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center p-4">
                    <i class="bi bi-person-lock display-5" style="color: var(--padel-green);"></i>
                    <h5 class="fw-bold mt-2" style="color: var(--pdz-ink);">Entre pra se inscrever</h5>
                    <p class="text-muted mb-4">
                        A inscrição fica no nome de quem faz — assim você acompanha seus jogos e
                        recebe os avisos do torneio.
                        <span class="d-block mt-1">
                            <strong>Seu parceiro não precisa ter conta</strong>: você informa o CPF dele e
                            pronto. Se ele criar a conta depois, o histórico já vai estar lá esperando.
                        </span>
                    </p>
                    <div class="d-flex gap-2 justify-content-center flex-wrap">
                        <a asp-controller="Auth" asp-action="Login" asp-route-returnUrl="@voltarPara"
                           class="btn btn-padel rounded-pill px-4 fw-bold">Entrar</a>
                        <a asp-controller="Auth" asp-action="Cadastro"
                           class="btn btn-outline-secondary rounded-pill px-4">Criar minha conta</a>
                    </div>
                </div>
            </div>
        }
        else if (Model.Formato == "Americano")
        {
            <form asp-controller="Torneios" asp-action="InscreverIndividual" method="post" class="pdz-form-inscricao">
                <input type="hidden" name="torneioId" value="@Model.Id" />

                <div class="mb-4">
                    <label class="form-label fw-bold">Selecione a Categoria</label>
                    <select name="categoriaId" class="form-select" required>
                        <option value="">-- Escolha uma categoria --</option>
                        @* Times e chave direta ficam fora: nas duas quem monta é o organizador.
                           Ordem e nome curto: ver Services/CategoriaNaTela. *@
                        @foreach (var cat in Model.Categorias.Where(c => !c.DeTimes && !c.ChaveDireta)
                                                             .OrderBy(c => Padelizou.Services.CategoriaNaTela.Ordem(c.Nome)))
                        {
                            <option value="@cat.Id">@Padelizou.Services.CategoriaNaTela.Curto(cat.Nome)</option>
                        }
                    </select>
                </div>

                <p class="text-muted small">No Torneio Americano a inscrição é individual — o sistema sorteia os parceiros a cada rodada.</p>

                <div class="mb-3">
                    <label class="form-label fw-bold small mb-1">CPF do jogador</label>
                    <input type="text" name="cpf" class="form-control mb-1 js-cpf" data-alvo="ind"
                           placeholder="000.000.000-00" data-mascara="cpf" inputmode="numeric" required />
                    <div class="small mb-2 js-cpf-status" data-alvo="ind"></div>
                    <input type="text" name="nome" class="form-control" placeholder="Nome Completo" maxlength="100" required />
                    <small class="text-muted d-block mt-1">Comece pelo CPF: se já houver cadastro, o nome vem sozinho.</small>
                </div>

                @if (Model.Restrito)
                {
                    <div class="alert alert-secondary small mb-3 d-flex gap-2 align-items-start">
                        <i class="bi bi-key-fill"></i>
                        <div>Este torneio é <strong>restrito</strong>: peça a chave de acesso ao organizador.</div>
                    </div>
                    <div class="mb-3">
                        <input type="text" name="chaveAcesso" class="form-control text-uppercase" placeholder="Chave de Acesso" maxlength="6" required style="letter-spacing: 2px;" />
                    </div>
                }

                <partial name="_EscolhaFormaPagamento" model="Model" />
                @* Os dois nunca aparecem juntos: um é do torneio que exige pagamento na
                   inscrição, o outro do que aceita pagar até o fechamento. *@
                <partial name="_QuandoPagar" model="Model" />

                <button type="submit" class="btn btn-padel btn-lg w-100 mt-3 shadow-sm">
                    <i class="bi bi-check2-circle"></i> Confirmar Inscrição Individual
                </button>
            </form>
        }
        else
        {
        <form asp-controller="Duplas" asp-action="Create" method="post" class="pdz-form-inscricao">
            <input type="hidden" name="torneioId" value="@Model.Id" />

            <div class="mb-4">
                <label class="form-label fw-bold">Selecione a Categoria</label>
                <select name="categoriaId" class="form-select" required>
                    <option value="">-- Escolha uma categoria --</option>
                    @* Times e chave direta ficam fora: nas duas quem monta é o organizador.
                       Ordem e nome curto: ver Services/CategoriaNaTela. *@
                    @foreach (var cat in Model.Categorias.Where(c => !c.DeTimes && !c.ChaveDireta)
                                                         .OrderBy(c => Padelizou.Services.CategoriaNaTela.Ordem(c.Nome)))
                    {
                        <option value="@cat.Id">@Padelizou.Services.CategoriaNaTela.Curto(cat.Nome)</option>
                    }
                </select>

                @* Dois avisos, ambos preenchidos pelo script: entrar numa categoria mais fraca
                   do que a declarada no cadastro, e inscrever alguém que não é você. Nenhum
                   dos dois impede nada — são pergunta, não trava. *@
                <div class="alert alert-warning border-0 mt-2 mb-0 py-2 small" id="pdzAvisoCategoria" style="display:none;"></div>
            </div>

            <!-- Dados dos Jogadores -->
            <div class="alert alert-secondary small d-flex gap-2 align-items-start">
                <i class="bi bi-person-vcard"></i>
                <div>
                    Comece pelo <strong>CPF</strong>. Se o jogador já tiver cadastro, nome, celular e
                    cidade vêm do perfil dele e ficam travados. Se for CPF novo, os campos abrem pra
                    você preencher.
                </div>
            </div>
            <div class="row">
                <!-- JOGADOR 1 -->
                <div class="col-md-6">
                    <div class="card mb-3 border-0 bg-light">
                        <div class="card-header fw-bold text-white" style="background-color: var(--pdz-navy-fixed);">Jogador 1</div>
                        <div class="card-body">
                            @* O caso comum é a pessoa se inscrevendo. Digitar o próprio CPF de
                               cabeça, com máscara, num celular, é o degrau mais alto do
                               formulário — e é justamente o dado que o sistema já tem. *@
                            @if (ViewBag.MeuCpf is string meuCpfInscricao && !string.IsNullOrWhiteSpace(meuCpfInscricao))
                            {
                                <button type="button" class="btn btn-sm btn-padel rounded-pill px-3 mb-2 fw-bold"
                                        id="pdzSouEu" data-cpf="@meuCpfInscricao">
                                    <i class="bi bi-person-check-fill"></i> Sou eu
                                </button>
                            }
                            @* ACHAR O JOGADOR 1 PELO NOME — a mesma busca que o parceiro já tinha.
                               Quem inscreve outra pessoa (organizador na secretaria, amigo que
                               junta a dupla) esbarrava aqui: sabe o nome, não sabe o CPF.

                               A lista devolve só Id, nome e foto (Services/BuscaJogador). CPF,
                               celular e cidade de terceiro NÃO saem do servidor — com eles na
                               resposta, três letras varreriam a base. Escolhido o nome, quem
                               completa o cadastro é o servidor, pelo Id. *@
                            <div class="position-relative mb-2" id="pdzBuscaJog1">
                                <input type="text" class="form-control" id="pdzJog1Nome"
                                       placeholder="Procure pelo nome ou apelido"
                                       autocomplete="off" spellcheck="false" />
                                <div class="small text-muted mt-1" id="pdzJog1Dica">
                                    Digite 3 letras e escolha na lista. Não achou? Preencha o CPF abaixo.
                                </div>
                                <input type="hidden" name="jogador1Id" id="pdzJog1Id" />
                                @* `pdz-busca-lista` NÃO é enfeite: ela dá o fundo sólido. Sem a
                                   classe, o tema escuro deixa a lista transparente e o CPF de
                                   baixo aparece através dos nomes (ver site.css). *@
                                <div class="list-group position-absolute w-100 shadow d-none pdz-busca-lista"
                                     id="pdzJog1Lista"></div>
                            </div>

                            @* Escolhido pela lista, o bloco do CPF some: os dados vêm do cadastro
                               de quem foi escolhido, e pedir de novo seria pedir pra digitar errado. *@
                            <div id="pdzJog1Escolhido" class="alert alert-success py-2 px-3 d-none d-flex justify-content-between align-items-center">
                                <span><i class="bi bi-check-circle-fill"></i> <strong id="pdzJog1EscolhidoNome"></strong></span>
                                <button type="button" class="btn btn-sm btn-link text-decoration-none p-0" id="pdzJog1Trocar">trocar</button>
                            </div>

                            <div id="pdzCamposPorCpf1">
                            <input type="text" name="cpf1" class="form-control mb-1 js-cpf" data-alvo="1"
                                   placeholder="000.000.000-00" data-mascara="cpf" inputmode="numeric" required />
                            <div class="small mb-2 js-cpf-status" data-alvo="1"></div>
                            <input type="text" name="nome1" class="form-control mb-2" placeholder="Nome Completo" maxlength="100" required />
                            <input type="text" name="celular1" class="form-control mb-2" data-mascara="celular"
                                   inputmode="numeric" placeholder="Celular (WhatsApp)" required />
                            <div class="row g-2">
                                <div class="col-8"><input type="text" name="cidade1" class="form-control" placeholder="Cidade" required /></div>
                                <div class="col-4"><input type="text" name="estado1" class="form-control" placeholder="UF" required /></div>
                            </div>
                            </div> @* fim do pdzCamposPorCpf1 *@
                        </div>
                    </div>
                </div>

                <!-- JOGADOR 2 -->
                <div class="col-md-6">
                    <div class="card mb-3 border-0 bg-light">
                        <div class="card-header fw-bold text-white d-flex justify-content-between align-items-center" style="background-color: var(--pdz-navy-fixed);">
                            <span>Jogador 2</span>
                            <span class="badge bg-info text-dark" id="pdzBadgeSemParceiro" style="display:none;">a definir</span>
                        </div>
                        <div class="card-body">
                            @* Inscrição solo: some com os campos do parceiro e tira o "required"
                               deles, senão o navegador barra o envio de campo escondido. *@
                            <div class="form-check form-switch mb-3">
                                <input class="form-check-input" type="checkbox" name="semParceiro" value="true"
                                       id="pdzSemParceiro" style="transform: scale(1.2); margin-right: 8px;">
                                <label class="form-check-label fw-bold" for="pdzSemParceiro">
                                    <i class="bi bi-person-plus"></i> Ainda não tenho parceiro
                                </label>
                            </div>

                            @* DE QUE LADO VOCÊ JOGA — só faz sentido pra quem está SOZINHO, e é
                               por isso que só aparece com o check marcado (o JS cuida disso).
                               Numa lista de 9 inscrições procurando parceiro, o lado é o que
                               separa uma da outra: sem ele a escolha é no escuro e a conversa
                               começa por "de que lado tu joga?".

                               ⚠️ Vem PRÉ-SELECIONADO com o lado do perfil (Felipe, 17/08/2026),
                               porque no caso comum a pessoa não vai mexer — e campo que já
                               chega certo é campo que ninguém erra. Continua trocável: o lado
                               pode ser deste torneio, não da vida. *@
                            <div id="pdzLadoSolo" class="mb-3" style="display:none;">
                                <label class="form-label small fw-bold mb-1" for="pdzLadoJogador1">
                                    <i class="bi bi-arrow-left-right"></i> De que lado você joga?
                                </label>
                                <select class="form-select" name="ladoJogador1" id="pdzLadoJogador1">
                                    @{
                                        // Do PERFIL de quem está logado. Sem perfil preenchido, o
                                        // `Normalizar` devolve "Ambos" — o lado seguro: quem não
                                        // disse nada não é descartado por ninguém.
                                        var meuLado = Padelizou.Services.LadoNaQuadra.Normalizar(
                                            ViewBag.MeuLadoQuadra as string);
                                    }
                                    @foreach (var (valor, texto) in Padelizou.Services.LadoNaQuadra.Opcoes)
                                    {
                                        <option value="@valor" selected="@(valor == meuLado)">@texto</option>
                                    }
                                </select>
                                <div class="form-text">Aparece pra quem estiver procurando dupla.</div>
                            </div>

                            <div id="pdzCamposParceiro">
                                @* ACHAR O PARCEIRO PELO NOME. Antes só dava por CPF, e quase
                                   ninguém sabe o CPF do parceiro de cabeça — a inscrição parava
                                   ali, no meio, esperando uma mensagem no WhatsApp.

                                   A lista só devolve Id, nome e foto (Services/BuscaJogador), a
                                   mesma busca do autocomplete de organizador. CPF, celular e
                                   cidade de terceiro NÃO saem do servidor: com eles na resposta,
                                   três letras varreriam a base inteira. Escolhido o nome, quem
                                   completa o cadastro é o servidor, pelo Id. *@
                                <div class="position-relative mb-2" id="pdzBuscaParceiro">
                                    <input type="text" class="form-control" id="pdzParceiroNome"
                                           placeholder="Procure pelo nome ou apelido"
                                           autocomplete="off" spellcheck="false" />
                                    <div class="small text-muted mt-1" id="pdzParceiroDica">
                                        Digite 3 letras e escolha na lista. Não achou? Preencha o CPF abaixo.
                                    </div>
                                    <input type="hidden" name="jogador2Id" id="pdzParceiroId" />
                                    @* Mesma classe do jogador 1 — o fundo transparente valia
                                       pros DOIS lados da dupla, só ninguém tinha reparado aqui. *@
                                    <div class="list-group position-absolute w-100 shadow d-none pdz-busca-lista"
                                         id="pdzParceiroLista"></div>
                                </div>

                                @* Escolhido pela lista, o bloco do CPF some: os dados vêm do
                                   cadastro de quem foi escolhido, e pedir de novo seria pedir
                                   pra digitar errado. *@
                                <div id="pdzParceiroEscolhido" class="alert alert-success py-2 px-3 d-none d-flex justify-content-between align-items-center">
                                    <span><i class="bi bi-check-circle-fill"></i> <strong id="pdzParceiroEscolhidoNome"></strong></span>
                                    <button type="button" class="btn btn-sm btn-link text-decoration-none p-0" id="pdzParceiroTrocar">trocar</button>
                                </div>

                                <div id="pdzCamposPorCpf">
                                <input type="text" name="cpf2" class="form-control mb-1 js-cpf" data-alvo="2"
                                       placeholder="000.000.000-00" data-mascara="cpf" inputmode="numeric" required />
                                <div class="small mb-2 js-cpf-status" data-alvo="2"></div>
                                <input type="text" name="nome2" class="form-control mb-2" placeholder="Nome Completo" maxlength="100" required />
                                <input type="text" name="celular2" class="form-control mb-2" data-mascara="celular"
                                       inputmode="numeric" placeholder="Celular (WhatsApp)" required />
                                <div class="row g-2">
                                    <div class="col-8"><input type="text" name="cidade2" class="form-control" placeholder="Cidade" required /></div>
                                    <div class="col-4"><input type="text" name="estado2" class="form-control" placeholder="UF" required /></div>
                                </div>
                                </div> @* fim do pdzCamposPorCpf *@
                            </div>

                            <p class="small text-muted mb-0" id="pdzAvisoSemParceiro" style="display:none;">
                                Sua vaga fica garantida. Assim que encontrar alguém, você define o parceiro
                                aqui mesmo na página do torneio — antes do sorteio das chaves.
                            </p>

                            @*
                                Ele JÁ está inscrito nesta categoria. Aparece assim que o CPF é
                                digitado, não depois de gravar: era assim que nascia gente
                                inscrita duas vezes (uma como parceiro, outra sozinha
                                procurando parceiro), ocupando duas vagas e virando uma dupla
                                fantasma no sorteio.
                                Sozinho vira oferta de juntar; com dupla fechada, um não que
                                trava o envio. Ver Services/InscricaoRepetida.
                            *@
                            <div class="alert alert-warning border-0 py-2 px-3 mt-3 d-none" id="pdzJaInscrito">
                                <p class="small mb-2" id="pdzJaInscritoTexto"></p>
                                <div class="form-check" id="pdzJuntarBloco">
                                    <input class="form-check-input" type="checkbox" value="true"
                                           name="juntarComInscricaoSolo" id="pdzJuntar">
                                    <label class="form-check-label small fw-bold" for="pdzJuntar">
                                        Sim, juntar com a inscrição que já existe
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Regras de Impedimento Dinâmicas -->
            @if (Model.PermiteImpedimentos)
            {
                <div class="alert alert-warning mt-2 border-warning">
                    <h5 class="alert-heading fw-bold"><i class="bi bi-clock-history"></i> Restrições de Horário (Impedimentos)</h5>
                    <p class="mb-2 text-muted small">Marque abaixo apenas se a dupla for <strong>absolutamente incapaz</strong> de jogar neste turno.</p>
                    @* Um só, e a tela cuida disso sozinha: marcar o segundo solta o primeiro.
                       Dupla que marca os três está dizendo "não podemos jogar em turno nenhum",
                       e isso não é impedimento — é desistência. A trava também existe no
                       servidor (Services/ImpedimentoUnico). *@
                    <p class="mb-3 small fw-bold">
                        <i class="bi bi-1-circle"></i> Dá pra marcar <strong>um</strong> turno só.
                    </p>

                    @if (Model.TaxaPorImpedimento > 0)
                    {
                        <p class="mb-3 fw-bold small">
                            <i class="bi bi-cash-coin"></i>
                            Cada impedimento marcado custa <strong>@Model.TaxaPorImpedimento.ToString("C")</strong> a mais na inscrição.
                            <span id="pdzTotalImpedimentos" class="d-block fw-normal text-muted"></span>
                        </p>
                    }

                    @if (Model.PermiteImpedimentoQuintaNoite)
                    {
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" name="impQuintaNoite" value="true" id="impQuinta">
                            <label class="form-check-label" for="impQuinta">Não podemos jogar na <strong>Quinta à noite</strong></label>
                        </div>
                    }
                    @if (Model.PermiteImpedimentoSextaNoite)
                    {
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" name="impSextaNoite" value="true" id="impSexta">
                            <label class="form-check-label" for="impSexta">Não podemos jogar na <strong>Sexta à noite</strong></label>
                        </div>
                    }
                    @if (Model.PermiteImpedimentoSabadoManha)
                    {
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" name="impSabadoManha" value="true" id="impSabManha">
                            <label class="form-check-label" for="impSabManha">Não podemos jogar no <strong>Sábado de manhã</strong></label>
                        </div>
                    }
                    @if (Model.PermiteImpedimentoSabadoTarde)
                    {
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" name="impSabadoTarde" value="true" id="impSabTarde">
                            <label class="form-check-label" for="impSabTarde">Não podemos jogar no <strong>Sábado à tarde</strong></label>
                        </div>
                    }
                </div>

                @* Um turno só: marcar o segundo solta o primeiro. Fica fora do @if da taxa
                   porque a regra vale mesmo em torneio que não cobra por impedimento. *@
                <script>
                    (function () {
                        var taxa = @Model.TaxaPorImpedimento.ToString(System.Globalization.CultureInfo.InvariantCulture);
                        var caixas = ['impQuinta', 'impSexta', 'impSabManha', 'impSabTarde']
                            .map(function (id) { return document.getElementById(id); })
                            .filter(Boolean);
                        var aviso = document.getElementById('pdzTotalImpedimentos');

                        function atualizar() {
                            if (!aviso || !(taxa > 0)) return;
                            var n = caixas.filter(function (c) { return c.checked; }).length;
                            aviso.textContent = n === 0
                                ? ''
                                : '1 impedimento marcado: + R$ ' + taxa.toFixed(2).replace('.', ',') + ' na inscrição.';
                        }

                        caixas.forEach(function (c) {
                            c.addEventListener('change', function () {
                                // Exclusivo: o que acabou de ser marcado desliga os outros.
                                if (c.checked) {
                                    caixas.forEach(function (outro) {
                                        if (outro !== c) outro.checked = false;
                                    });
                                }
                                atualizar();
                            });
                        });
                        atualizar();
                    })();
                </script>
            }

            @* O aviso e a chave de liberação seguem a validação do Ranking RS, que é a única
               trava de nível em pé (a restrição por histórico daqui saiu em 06/08/2026 — ver
               RANKING.md). A chave `ignorarBloqueio` é lida pelo DuplasController e vale pras
               duas regras, então ela precisa continuar existindo enquanto QUALQUER uma travar:
               sem isso o organizador perde o atalho de inscrever alguém na hora. *@
            @if (Model.ValidarPeloRankingRs)
            {
                <div class="alert alert-secondary mt-3 mb-0 small d-flex gap-2 align-items-start">
                    <i class="bi bi-shield-lock"></i>
                    <div>
                        As inscrições deste torneio são <strong>conferidas no @Padelizou.Services.MarcaDoRanking.Nome</strong>: quem já pontuou numa categoria mais forte não entra numa mais fraca sem o organizador liberar.
                    </div>
                </div>
                @if (ViewBag.PodeGerenciar == true)
                {
                    <div class="form-check form-switch mt-2">
                        <input class="form-check-input" type="checkbox" name="ignorarBloqueio" value="true" id="ignorarBloqueio">
                        <label class="form-check-label" for="ignorarBloqueio">
                            <i class="bi bi-unlock"></i> <strong>Organizador:</strong> inscrever sem conferir o ranking
                        </label>
                    </div>
                }
            }

            @if (Model.Restrito)
            {
                <div class="alert alert-secondary mt-3 mb-2 small d-flex gap-2 align-items-start">
                    <i class="bi bi-key-fill"></i>
                    <div>Este torneio é <strong>restrito</strong>: peça a chave de acesso ao organizador.</div>
                </div>
                <div class="mb-3">
                    <input type="text" name="chaveAcesso" class="form-control text-uppercase" placeholder="Chave de Acesso" maxlength="6" required style="letter-spacing: 2px;" />
                </div>
            }

            <partial name="_EscolhaFormaPagamento" model="Model" />
            @* Os dois nunca aparecem juntos: um é do torneio que exige pagamento na inscrição,
               o outro do que aceita pagar até o fechamento. *@
            <partial name="_QuandoPagar" model="Model" />

            @* O id existe pro aviso de "já inscrito" poder travar o envio quando o parceiro
               escolhido já tem dupla fechada nesta categoria. *@
            <button type="submit" id="btn-inscrever-dupla" class="btn btn-padel btn-lg w-100 mt-3 shadow-sm">
                <i class="bi bi-check2-circle"></i> Confirmar Inscrição da Dupla
            </button>
        </form>
        }
    </div>
    <!-- ABA 3: PAINEL DO ORGANIZADOR -->
    @if (ViewBag.PodeGerenciar == true)
    {
        @* ASSISTENTE DO SISTEMA: enxerga o painel inteiro, não mexe em nada.

           O `<fieldset disabled>` é o que desliga TUDO de uma vez — input, select, textarea e
           botão, em qualquer profundidade. Desligar item a item seria uma lista pra esquecer
           um; e o que faz isso ser seguro de verdade não é o HTML, é o servidor: nenhum POST
           daqui passa por EhOrganizadorAsync pro assistente. Ver PoderesNoSistema. *@
        var gestaoSoLeitura = ViewBag.GestaoSoLeitura == true;
        <div class="tab-pane fade" id="admin" role="tabpanel">
            <h4 class="mb-3 text-danger"><i class="bi bi-gear-fill"></i> Painel de Controle</h4>

            @* ── AS DUAS FERRAMENTAS DO ANTES, RECOLHIDAS PRA CÁ ──────────────────────────
               🗣️ Felipe, 10/09/2026: *"Os menus Pagamentos e impedimentos e Planejamento de
               quadras, também pode mover para dentro do Gerenciar torneio, depois que foi
               publicada as chaves."*

               As duas são ferramentas do ANTES: o impedimento alimenta o sorteio e o
               planejamento decide quantas quadras alugar. Publicada a chave, elas viram duas
               abas entre quem abre a página e o placar — e a barra do organizador tem NOVE.

               ⚠️ SÓ AQUI DEPOIS DE PUBLICAR: antes, as abas continuam na barra, e repetir o
               atalho seria dois caminhos pro mesmo lugar na mesma tela.

               ⚠️ `.click()` NO BOTÃO REAL, e não um `data-bs-toggle` daqui: o Bootstrap
               desativa os irmãos procurando o `nav` ANCESTRAL do elemento clicado. Um botão
               fora do `#torneioTabs` abriria este painel SEM fechar o que estava aberto —
               dois painéis na tela ao mesmo tempo. Clicar no botão de verdade é o caminho
               que o Bootstrap já sabe percorrer. *@
            @if (AprovacaoDeChaves.ChavePublicada(Model))
            {
                <div class="d-flex flex-wrap gap-2 mb-3">
                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill"
                            onclick="document.getElementById('pagamentos-tab').click();">
                        <i class="bi bi-cash-coin"></i> Pagamentos e impedimentos
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill"
                            onclick="document.getElementById('planejamento-tab').click();">
                        <i class="bi bi-calendar-range"></i> Planejamento de quadras
                    </button>
                </div>
            }

            @* A DÍVIDA NÃO SOME DA TELA DE QUEM DEVE (08/09/2026). Depois de "sortear agora,
               pagar depois", o bloco da taxa lá embaixo desaparece — as chaves já saíram, e
               aquele bloco só existe enquanto elas estão travadas. Sem este lembrete, adiar
               apagaria a cobrança da vista justamente do organizador, e o único lugar onde ela
               continuaria existindo seria o financeiro do Padelizou. *@
            @if (ViewBag.TaxaExternoDevendo == true && ViewBag.PodeVerDinheiro == true)
            {
                <div class="alert alert-warning border-warning d-flex flex-wrap gap-2 align-items-center">
                    <div class="flex-grow-1">
                        <i class="bi bi-hourglass-split"></i>
                        <strong>Taxa do Padelizou em aberto.</strong>
                        Você sorteou as chaves em
                        @Model.TaxaExternoAdiadaEm!.Value.ToString("dd/MM/yyyy 'às' HH:mm")
                        e ficou de acertar depois.
                    </div>
                    <a asp-controller="Torneios" asp-action="TaxaPlataforma" asp-route-id="@Model.Id"
                       class="btn btn-warning btn-sm fw-bold">
                        <i class="bi bi-credit-card"></i> Pagar agora
                    </a>
                </div>
            }

            @if (gestaoSoLeitura)
            {
                <div class="alert alert-info border-0 d-flex gap-2 align-items-start">
                    <i class="bi bi-eyeglasses fs-5 lh-1 mt-1"></i>
                    <div class="small">
                        <strong>Você está vendo a gestão deste torneio como assistente.</strong>
                        Dá pra acompanhar tudo — inscritos, chaves, dinheiro e configuração —, mas
                        quem altera é quem organiza.
                    </div>
                </div>
            }

            @* `disabled="@false"` some do HTML (o Razor trata atributo booleano assim), então
               pra quem organiza o fieldset é uma casca sem efeito nenhum. *@
            <fieldset disabled="@gestaoSoLeitura" class="border-0 p-0 m-0">

            <div class="card bg-light border-0 shadow-sm mb-4">
                <div class="card-body">
                    @* O nome que se lê, não o que está gravado: "Chaves em Sorteio" descreve o
                       próximo passo, e a faixa logo abaixo já diz "as inscrições estão
                       fechadas" — eram duas frases sobre o mesmo estado, e esta era a errada.
                       Ver Services/StatusDoTorneioNaTela. *@
                    <h6 class="fw-bold text-muted text-uppercase">Status Atual: <span class="badge bg-dark ms-2">@Padelizou.Services.StatusDoTorneioNaTela.Nome(Model.Status)</span></h6>

                    @if (Model.Restrito)
                    {
                        <div class="alert alert-info d-flex align-items-center gap-2 mt-3 mb-0">
                            <i class="bi bi-key-fill fs-4"></i>
                            <div>
                                <strong>Torneio restrito</strong> — chave de acesso: <span class="fw-bold fs-5 font-monospace">@Model.ChaveAcesso</span>
                                <br /><small class="text-muted">Compartilhe essa chave só com quem você quer que consiga se inscrever.</small>
                                @* O "e também está oculto" saiu daqui em 18/08/2026: ele dizia
                                   "só quem tem o link direto consegue ver", que virou mentira
                                   quando o oculto passou a fechar a página. Quem conta isso
                                   agora é a faixa no topo, que aparece em torneio restrito ou
                                   não — dizer a mesma coisa em dois lugares é como um dos dois
                                   fica pra trás. *@
                            </div>
                        </div>
                    }
                    <hr />

                    @* ── Reabrir as inscrições ──────────────────────────────────────────
                       Fica FORA da corrente de status logo abaixo, e antes dela, de propósito:
                       o torneio fechado cai em três ramos diferentes (taxa pendente, Americano
                       e Oficial), e repetir o botão nos três seria a mesma regra escrita três
                       vezes. Some sozinho depois do sorteio — a régua é PortaDaInscricao.

                       Existe porque encerrar inscrição era de mão única: um clique e nunca
                       mais. Aconteceu com o NATA PADEL TOUR, que ficou parado sem ninguém
                       inscrito e sem caminho de volta. *@
                    @if (ViewBag.PodeReabrirInscricoes == true)
                    {
                        <div class="alert @(ViewBag.InscricoesNuncaAbriram == true ? "alert-warning" : "alert-secondary") d-flex flex-wrap gap-2 align-items-center justify-content-between">
                            <div>
                                @if (ViewBag.InscricoesNuncaAbriram == true)
                                {
                                    @* Zero inscritos e zero jogos: isto não é "encerrada", é
                                       "ainda não abriu". Dizer "encerradas" aqui era a frase
                                       mais confusa possível pra quem está tentando entender
                                       por que ninguém consegue entrar. *@
                                    <strong><i class="bi bi-lock-fill"></i> As inscrições estão fechadas</strong>
                                    <div class="small">Ninguém se inscreveu ainda — enquanto estiver assim, o formulário não aceita gente.</div>
                                }
                                else
                                {
                                    <strong><i class="bi bi-lock-fill"></i> Inscrições encerradas</strong>
                                    <div class="small">Dá pra reabrir enquanto as chaves não forem sorteadas.</div>
                                }
                            </div>
                            <form asp-controller="Torneios" asp-action="ReabrirInscricoes" method="post" class="mb-0">
                                <input type="hidden" name="id" value="@Model.Id" />
                                <button type="submit" class="btn btn-success fw-bold shadow-sm">
                                    <i class="bi bi-unlock-fill"></i> Abrir inscrições
                                </button>
                            </form>
                        </div>
                    }

                    @* ── Desfazer as rodadas do Americano ────────────────────────────────
                       O Americano não tem a tela de "Chaves em Aprovação" do formato Padrão
                       (DesfazerSorteio só existe enquanto pendente, e o Americano nunca fica
                       pendente): GerarRodadasAmericano/GerarRodadasAmericanoDuplas vão direto
                       pra "Fase de Grupos", sem caminho de volta. Até aqui, um sorteio errado
                       só se corrigia apagando o torneio inteiro e recomeçando.

                       Some sozinho depois do primeiro jogo lançado — a régua é a mesma do
                       servidor (DesfazerRodadasAmericano). Depois de desfazer, o botão "Abrir
                       inscrições" logo acima aparece sozinho na próxima vez que a página
                       carregar: `jaSorteou` vira falso assim que as partidas somem. *@
                    @if (ViewBag.PodeDesfazerRodadasAmericano == true)
                    {
                        <div class="alert alert-secondary d-flex flex-wrap gap-2 align-items-center justify-content-between">
                            <div>
                                <strong><i class="bi bi-shuffle"></i> Rodadas sorteadas</strong>
                                <div class="small">Nenhum jogo foi lançado ainda — dá pra desfazer e sortear de novo, ou reabrir as inscrições.</div>
                            </div>
                            <form asp-controller="Torneios" asp-action="DesfazerRodadasAmericano" method="post" class="mb-0"
                                  data-confirmar-titulo="Desfazer as rodadas?"
                                  data-confirmar="Apaga as partidas sorteadas. O torneio volta pra 'Chaves em Sorteio' — dá pra sortear de novo, ou reabrir as inscrições."
                                  data-confirmar-ok="Desfazer"
                                  data-confirmar-tom="perigo">
                                <input type="hidden" name="id" value="@Model.Id" />
                                <button type="submit" class="btn btn-outline-danger fw-bold shadow-sm">
                                    <i class="bi bi-arrow-counterclockwise"></i> Desfazer Rodadas
                                </button>
                            </form>
                        </div>
                    }

                    @if (Padelizou.Services.CancelamentoDoTorneio.EstaCancelado(Model.Status))
                    {
                        @* Cancelado não tem próximo passo — o painel para aqui, e o que sobra é
                           a devolução do dinheiro (bloco logo abaixo). *@
                        <div class="alert alert-secondary mb-0">
                            <i class="bi bi-x-octagon"></i>
                            Torneio cancelado. Ele sai da listagem pública e continua aqui, na sua lista,
                            pra você resolver as devoluções.
                        </div>

                        var devolver = ViewBag.PagosParaDevolver as List<DevolucaoPendenteVM> ?? new List<DevolucaoPendenteVM>();
                        <div class="card border-0 shadow-sm mt-3">
                            <div class="card-body">
                                <h6 class="fw-bold text-uppercase text-muted mb-3">
                                    <i class="bi bi-cash-coin"></i> Devoluções a fazer
                                </h6>
                                @if (devolver.Count == 0)
                                {
                                    <p class="small text-muted mb-0">
                                        Ninguém tinha pagado a inscrição — não há o que devolver.
                                    </p>
                                }
                                else
                                {
                                    <div class="table-responsive">
                                        <table class="table table-sm align-middle mb-2">
                                            <thead>
                                                <tr class="small text-muted">
                                                    <th>Quem</th><th>Categoria</th><th>Contato</th><th class="text-end">Valor</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var d in devolver.OrderByDescending(x => x.Valor))
                                                {
                                                    <tr>
                                                        <td class="fw-semibold">@Padelizou.Services.NomeBonito.Formatar(d.Quem)</td>
                                                        <td class="small text-muted">@d.Categoria</td>
                                                        <td class="small">@(string.IsNullOrWhiteSpace(d.Contato) ? "—" : d.Contato)</td>
                                                        <td class="text-end fw-bold">@d.Valor.ToString("C")</td>
                                                    </tr>
                                                }
                                            </tbody>
                                            <tfoot>
                                                <tr class="border-top">
                                                    <td colspan="3" class="fw-bold text-end">Total</td>
                                                    <td class="text-end fw-bold">@devolver.Sum(x => x.Valor).ToString("C")</td>
                                                </tr>
                                            </tfoot>
                                        </table>
                                    </div>
                                    <small class="text-muted">
                                        O Padelizou não devolve sozinho — a lista está aqui pra você acertar
                                        com cada um. Marque a inscrição como não paga depois de devolver.
                                    </small>
                                }
                            </div>
                        </div>
                    }
                    else if (Model.Status == "Inscrições Abertas")
                    {
                        <div class="alert alert-warning border-warning">
                            <strong>Atenção:</strong> Ao encerrar as inscrições, o formulário será bloqueado para o público e você poderá gerar as chaves e os grupos.
                        </div>
                        <form asp-controller="Torneios" asp-action="EncerrarInscricoes" method="post">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button type="submit" class="btn btn-warning fw-bold shadow-sm">
                                <i class="bi bi-lock-fill"></i> Encerrar Inscrições
                            </button>
                        </form>
                    }
                    else if (Model.Status == "Chaves em Sorteio" && (ViewBag.TaxaExternoPendente == true))
                    {
                        @* A condição do "por fora" chegou na prática: em vez do botão de sortear,
                           o caminho do pagamento. O texto é o mesmo prometido na criação. *@
                        <div class="alert alert-warning border-warning">
                            <i class="bi bi-key-fill"></i>
                            <strong>Falta um passo pra sortear:</strong> neste torneio o pagamento é por fora,
                            e as chaves são liberadas mediante o pagamento da taxa do Padelizou — ou negociação
                            com a gente. Leva um minuto.
                        </div>
                        @* A taxa é conta de quem ficou com o dinheiro das inscrições. Mandar o
                           ajudante pra lá daria um 403 na cara dele; melhor dizer de quem é. *@
                        @if (ViewBag.PodeVerDinheiro == true)
                        {
                            @* 🗣️ Felipe, 09/09/2026: "coloque um aviso, que clicando em sortear
                               agora, nao publica a chave, fica apenas visivel para o organizador
                               e adm".

                               ⚠️ E O AVISO PERGUNTA O FORMATO em vez de afirmar, porque a frase
                               só é verdade no Padrão: o Americano vai DIRETO pra "Fase de Grupos",
                               que já é pública. Um aviso incondicional mentiria justamente no caso
                               mais perigoso — o organizador clicaria achando que é rascunho e o
                               rodízio sairia pros jogadores na hora. Ver
                               Services/PublicacaoDaChave. *@
                            var avisoDaPublicacao = Padelizou.Services.PublicacaoDaChave.Aviso(Model);
                            var saiPublicaNaHora = Padelizou.Services.PublicacaoDaChave.SaiPublicaNaHora(Model);
                            <div class="alert @(saiPublicaNaHora ? "alert-warning" : "alert-info") small py-2 px-3 mb-3">
                                <i class="bi @(saiPublicaNaHora ? "bi-megaphone-fill" : "bi-eye-slash-fill")"></i>
                                @avisoDaPublicacao
                            </div>

                            <div class="d-flex flex-wrap gap-2">
                                <a asp-controller="Torneios" asp-action="TaxaPlataforma" asp-route-id="@Model.Id"
                                   class="btn btn-warning fw-bold shadow-sm">
                                    <i class="bi bi-credit-card"></i> Ver e pagar a taxa
                                </a>

                                @* O FIADO. A taxa não some — ela vira dívida registrada, e o texto
                                   da confirmação diz isso na cara. Esconder a consequência aqui
                                   faria o organizador descobrir a cobrança só quando ela chegasse.

                                   ⚠️ "Destrava o sorteio", e não "as chaves são liberadas": o
                                   texto antigo lia como "a chave vai pro ar", que é justamente a
                                   confusão que o aviso acima veio desfazer. *@
                                <form asp-controller="Torneios" asp-action="AdiarTaxaExterno" method="post"
                                      data-confirmar-titulo="Sortear agora e pagar depois?"
                                      data-confirmar="@("Destrava o sorteio. " + avisoDaPublicacao + " A taxa do Padelizou continua devida e o torneio fica na lista de cobrança até você acertar.")"
                                      data-confirmar-ok="Sortear agora">
                                    <input type="hidden" name="id" value="@Model.Id" />
                                    <button type="submit" class="btn btn-outline-light fw-bold shadow-sm">
                                        <i class="bi bi-hourglass-split"></i> Sortear agora, pagar depois
                                    </button>
                                </form>
                            </div>
                        }
                        else
                        {
                            <p class="small text-muted mb-0">
                                <i class="bi bi-shield-lock"></i>
                                Quem criou o torneio precisa fazer esse passo — a taxa aparece na conta dele.
                            </p>
                        }
                    }
                    else if (Model.Status == "Chaves em Sorteio" && Model.Formato == "Americano")
                    {
                        <div class="alert alert-info border-info">
                            <strong>Inscrições Encerradas!</strong> Agora você pode sortear as rodadas — os parceiros vão trocar a cada rodada.
                        </div>

                        @* A DIVISÃO EM GRUPOS é escolhida AQUI, e não na criação do torneio:
                           é agora que se sabe quantos vieram. As opções e as contas vêm do
                           controller, de Services/DivisaoDoAmericano — a mesma régua que o
                           sorteio obedece. *@
                        @if (ViewBag.PorQueNaoFechaOAmericano is string naoFecha)
                        {
                            <div class="alert alert-warning">
                                <i class="bi bi-exclamation-triangle-fill"></i> @naoFecha
                                <div class="small mt-2">
                                    A regra do Americano é que <strong>cada um jogue com cada um sem repetir
                                    parceiro, e todos joguem a mesma quantidade de jogos</strong> — e isso só
                                    é possível em certos números.
                                </div>
                            </div>
                        }

                        <form asp-controller="Torneios" asp-action="GerarRodadasAmericano" method="post">
                            <input type="hidden" name="torneioId" value="@Model.Id" />

                            @if (ViewBag.DivisoesDoAmericano is IReadOnlyList<Padelizou.Services.DivisaoDoAmericano.Divisao> divisoes && divisoes.Count > 1)
                            {
                                <div class="mb-3 p-3 rounded" style="background-color: var(--pdz-surface-alt);">
                                    <div class="fw-bold mb-2" style="color: var(--pdz-ink);">
                                        Como dividir os @ViewBag.InscritosDoAmericano inscritos?
                                    </div>
                                    @foreach (var d in divisoes)
                                    {
                                        <div class="form-check mb-2">
                                            <input class="form-check-input" type="radio" name="gruposEscolhidos"
                                                   value="@d.Grupos" id="divisao@(d.Grupos)"
                                                   checked="@(d.Grupos == divisoes[0].Grupos)">
                                            <label class="form-check-label small" for="divisao@(d.Grupos)">
                                                @Padelizou.Services.DivisaoDoAmericano.ComoFica(d)
                                                <span class="text-muted">
                                                    Total: @d.RodadasTotais rodadas, @d.PartidasTotais jogos.
                                                </span>
                                            </label>
                                        </div>
                                    }
                                    <div class="small text-muted mt-2">
                                        A primeira opção é a que <strong>mais mistura</strong> — todo mundo joga com
                                        todo mundo. As de baixo dividem em grupos e cabem em menos tempo de quadra.
                                    </div>
                                </div>
                            }
                            else if (ViewBag.DivisoesDoAmericano is IReadOnlyList<Padelizou.Services.DivisaoDoAmericano.Divisao> unica && unica.Count == 1)
                            {
                                <div class="small text-muted mb-2">
                                    @Padelizou.Services.DivisaoDoAmericano.ComoFica(unica[0])
                                </div>
                            }

                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <input type="datetime-local" name="dataHoraInicio" class="form-control form-control-sm" style="width: auto;"
                                       value="@DateTime.Now.AddHours(1).ToString("yyyy-MM-ddTHH:mm")" required />
                                <button type="submit" class="btn btn-primary fw-bold shadow-sm">
                                    <i class="bi bi-shuffle"></i> Sortear Rodadas do Americano
                                </button>
                            </div>
                        </form>
                    }
                    else if (Model.Status == "Chaves em Sorteio" && Model.Formato == "AmericanoDuplas")
                    {
                        <div class="alert alert-info border-info">
                            <strong>Inscrições Encerradas!</strong> Agora você pode sortear as rodadas — as duplas
                            são fixas e cada uma enfrenta todas as outras. Vence a que somar mais games.
                        </div>

                        @* ⚠️ O AVISO DE QUEM ENTRA SEM PARCEIRO VALE AQUI TAMBÉM (09/09/2026). Ele
                           nasceu só no ramo Padrão, e o Americano de Duplas lê a MESMA régua —
                           então lá a meia dupla entrava no rodízio sem uma palavra na tela, e sem
                           a saída de cancelar que o outro formato ganhou. *@
                        <partial name="_EntramSemParceiro" model="comVagaEmAberto" />

                        @* Os números saem da MESMA régua do sorteio (Services/RodadasAmericanoDeDuplas
                           e ForaDoSorteio): o que a tela promete é o que o botão faz. *@
                        @foreach (var cat in Model.Categorias.Where(c => !c.DeTimes))
                        {
                            var prontasDaCategoria = cat.Duplas.Count(d => !Padelizou.Services.ForaDoSorteio.FicaDeFora(d));
                            <div class="small mb-1 @(Padelizou.Services.RodadasAmericanoDeDuplas.Aceita(prontasDaCategoria) ? "text-muted" : "text-danger")">
                                <strong>@cat.Nome:</strong> @Padelizou.Services.RodadasAmericanoDeDuplas.ComoFica(prontasDaCategoria)
                            </div>
                        }

                        <form asp-controller="Torneios" asp-action="GerarRodadasAmericanoDuplas" method="post" class="mt-2">
                            <input type="hidden" name="torneioId" value="@Model.Id" />
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <input type="datetime-local" name="dataHoraInicio" class="form-control form-control-sm" style="width: auto;"
                                       value="@DateTime.Now.AddHours(1).ToString("yyyy-MM-ddTHH:mm")" required />
                                <button type="submit" class="btn btn-primary fw-bold shadow-sm">
                                    <i class="bi bi-shuffle"></i> Sortear Rodadas
                                </button>
                            </div>
                        </form>
                    }
                    else if (Model.Status == "Chaves em Sorteio")
                    {
                        @* Só oferece o sorteio pra quem TEM quem sortear. Com zero inscritos, o
                           "agora você pode sortear os grupos" era um convite pra um botão que
                           não tinha o que fazer — e a faixa acima já explica o que está
                           acontecendo. *@
                        @if (ViewBag.InscricoesNuncaAbriram != true)
                        {
                            <div class="alert alert-info border-info">
                                <strong>Inscrições Encerradas!</strong> Agora você pode sortear os grupos. O sistema usará o Ranking Global para definir os Cabeças de Chave.
                            </div>
                        }

                        @* Antes de apertar o botão, o organizador vê onde essa grade termina.
                           Aqui os números são REAIS — as duplas já estão inscritas —, então
                           não é estimativa como na tela de criação. *@
                        @if (ViewBag.PrevisaoGrade is Padelizou.ViewModels.PrevisaoGradeVM prev && prev.TotalDeJogos > 0)
                        {
                            <div class="p-3 rounded mb-3" style="background-color: var(--pdz-surface-alt); border-left: 4px solid var(--pdz-lime);">
                                <div class="fw-bold mb-1" style="color: var(--pdz-ink);">
                                    <i class="bi bi-calendar-check me-1"></i> Como essa grade vai ficar
                                </div>
                                <div class="small">
                                    <strong>@prev.Duplas duplas</strong> em @prev.Grupos grupos =
                                    @prev.JogosDeGrupo jogos de grupo + @prev.JogosDeMataMata de mata-mata =
                                    <strong>@prev.TotalDeJogos jogos</strong>, em @Model.QuantidadeQuadras
                                    @(Model.QuantidadeQuadras == 1 ? "quadra" : "quadras") de @Model.TempoPrevistoPartidaMinutos min.
                                    <br />
                                    @if (prev.SemHorarioPrevisto)
                                    {
                                        @* 09/09/2026: o por-ordem passou a ter HORA (pedido do
                                           Felipe — "o horário é pré-definido, para as pessoas se
                                           organizarem"). O que ele não tem é QUADRA marcada, e é
                                           isso que o texto precisa dizer agora. *@
                                        <text>
                                            Cada jogo sai <strong>com horário</strong>, pro pessoal se organizar —
                                            mas <strong>sem quadra marcada</strong>: você chama cada um pela Mesa
                                            de Controle conforme a quadra vaga.
                                        </text>
                                    }
                                    else
                                    {
                                        <text>
                                            Começa <strong>@prev.Inicio.ToString("dddd dd/MM 'às' HH:mm")</strong> e o último jogo
                                            termina <strong>@prev.FimPrevisto.ToString("dddd dd/MM 'às' HH:mm")</strong>
                                            — @prev.Dias @(prev.Dias == 1 ? "dia" : "dias") de quadra.
                                        </text>
                                    }
                                </div>
                                @if (prev.EstouraOPrazo)
                                {
                                    <div class="alert alert-danger mt-2 mb-0 py-2 px-3 small">
                                        <i class="bi bi-exclamation-triangle-fill"></i>
                                        <strong>Passa do dia @Model.DataFim!.Value.ToString("dd/MM")</strong>, que você marcou como limite.
                                        Dá pra resolver com mais quadras, jogo mais curto ou começando mais cedo — é só editar o torneio.
                                    </div>
                                }
                            </div>
                        }

                        @if (ficamDeFora.Any())
                        {
                            <div class="alert alert-warning border-0 shadow-sm">
                                <p class="fw-bold mb-2">
                                    <i class="bi bi-exclamation-triangle-fill"></i>
                                    @ficamDeFora.Count inscrito(s) ficam de fora do sorteio
                                </p>
                                <ul class="small mb-2 ps-3">
                                    @foreach (var d in ficamDeFora.Take(12))
                                    {
                                        <li>
                                            <strong>@d.Jogador1.ComoChamar</strong>
                                            @if (d.Jogador2 != null)
                                            {
                                                <text> e <strong>@d.Jogador2.ComoChamar</strong></text>
                                            }
                                            <span class="text-muted">— @Padelizou.Services.ForaDoSorteio.Motivo(d)</span>
                                        </li>
                                    }
                                </ul>
                                @if (ficamDeFora.Count > 12)
                                {
                                    <p class="small text-muted mb-2">…e mais @(ficamDeFora.Count - 12).</p>
                                }
                                <p class="small mb-0">
                                    Quem está <strong>na lista de espera</strong> entra se alguém desistir.
                                    Depois de sortear, não dá mais.
                                </p>
                            </div>
                        }

                        <partial name="_EntramSemParceiro" model="comVagaEmAberto" />

                        @* OS IMPEDIMENTOS, ANTES DE SORTEAR.
                           🗣️ Felipe, 02/09/2026: "para a hora de gerar as chaves, colocar uma lista
                           com todos os impedimentos marcados nas inscrições, por dupla".
                           O sorteio já respeita as janelas (Services/JanelasDeImpedimento), mas o
                           organizador não tinha como saber QUANTAS eram nem de quem antes de
                           apertar — e é a informação que decide se a grade cabe no dia. *@
                        // (bloco de codigo: ja estamos dentro de um @if)
                            var comImpedimento = Model.Categorias
                                .SelectMany(c => c.Duplas.Select(d => new { Categoria = c, Dupla = d }))
                                .Where(x => Padelizou.Services.AlteracaoDeImpedimento.TurnoAtual(x.Dupla)
                                            != Padelizou.Services.TurnoDoImpedimento.Nenhum)
                                .OrderBy(x => x.Categoria.Nome)
                                .ToList();
                        @if (comImpedimento.Any())
                        {
                            <div class="alert alert-info border-0 shadow-sm">
                                <p class="fw-bold mb-2">
                                    <i class="bi bi-clock-history"></i>
                                    @comImpedimento.Count dupla(s) com impedimento de horário
                                </p>
                                <ul class="small mb-2 ps-3">
                                    @foreach (var x in comImpedimento)
                                    {
                                        var turno = Padelizou.Services.AlteracaoDeImpedimento.TurnoAtual(x.Dupla);
                                        <li>
                                            <strong>@x.Dupla.Jogador1.ComoChamar</strong>
                                            @if (x.Dupla.Jogador2 != null)
                                            {
                                                <text> e <strong>@x.Dupla.Jogador2.ComoChamar</strong></text>
                                            }
                                            <span class="text-muted">(@x.Categoria.Nome)</span>
                                            — não joga <strong>@Padelizou.Services.AlteracaoDeImpedimento.Rotulo(turno)</strong>
                                            @* Quem marcou. Nulo = veio da inscrição e nunca foi trocado —
                                               é a resposta certa, não uma informação faltando. *@
                                            @if (x.Dupla.ImpedimentoAlteradoEm is DateTime quando)
                                            {
                                                <span class="text-muted">
                                                    · alterado em @quando.ToString("dd/MM 'às' HH:mm")
                                                </span>
                                            }
                                        </li>
                                    }
                                </ul>
                                <p class="small mb-0">
                                    O sorteio já evita essas janelas sozinho. A lista está aqui pra você ver
                                    <strong>quantas</strong> são antes de apertar: janela demais num torneio curto
                                    aperta a grade.
                                </p>
                            </div>
                        }

                        @* A confirmação diz a CONSEQUÊNCIA, não repete o nome do botão: é o que
                           decide se a pessoa aperta ou vai fechar a dupla de alguém antes.
                           Os textos são montados no topo desta view. *@
                        @* ⚠️ "NINGUÉM MAIS TROCA DE PARCEIRO" DEIXOU DE SER VERDADE em
                           09/09/2026, e metade continua verdade: ninguém mais ENTRA nem
                           SAI, e ninguém TROCA um parceiro que já tem — mas quem está com
                           a vaga aberta ainda DEFINE o segundo nome, até o primeiro jogo
                           dele. Prometer o contrário aqui faria o organizador achar que
                           sortear fecha a porta do Paulo, que é o oposto do que ele pediu.
                           ⚠️ E ESTE COMENTÁRIO FICA FORA DA TAG: dentro de `<form …>`, o Razor
                           apagava todos os atributos depois dele — o Sortear saía sem
                           confirmação nenhuma (ensaio do Er, 10/09/2026; ver
                           ComentarioRazorDentroDeTagTests). *@
                        <form asp-controller="Torneios" asp-action="GerarChaves" method="post"
                              data-confirmar-titulo="Sortear as chaves?"
                              data-confirmar="Os grupos são sorteados agora. @horarioOuOrdem Depois disso ninguém mais entra nem sai, e quem já tem parceiro não troca — só quem está com a vaga aberta ainda pode definir o dele."
                              data-confirmar-ok="Sortear agora"
                              data-confirmar-tom="@(ficamDeFora.Any() || comVagaEmAberto.Any() ? "perigo" : "padrao")"
                              data-confirmar-detalhe="@detalheDoSorteio">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button type="submit" class="btn btn-primary fw-bold shadow-sm">
                                <i class="bi bi-diagram-3-fill"></i> Sortear Grupos e Gerar Chaves
                            </button>
                        </form>
                    }
                    else if (Model.Status == Padelizou.Services.AprovacaoDeChaves.Pendente)
                    {
                        @* Chaves sorteadas, esperando aprovação (ver Services/AprovacaoDeChaves).
                           Ninguém fora de quem organiza/administra vê isto — nem os inscritos. *@
                        <div class="alert alert-info border-info">
                            <i class="bi bi-hourglass-split"></i>
                            <strong>Chaves sorteadas, aguardando sua aprovação.</strong> Elas ainda não
                            aparecem pra ninguém — nem pros inscritos. Dá uma olhada nos jogos e nos
                            horários antes de liberar; se algo não ficou bom, dá pra sortear de novo.
                        </div>

                        <div class="d-flex flex-wrap gap-2 mb-3">
                            <a asp-controller="Torneios" asp-action="Jogos" asp-route-id="@Model.Id"
                               class="btn btn-outline-primary fw-bold shadow-sm">
                                <i class="bi bi-calendar-week"></i> Ver jogos e horários
                            </a>
                            <form asp-controller="Torneios" asp-action="DesfazerSorteio" method="post"
                                  data-confirmar-titulo="Desfazer o sorteio?"
                                  data-confirmar="Apaga os grupos e os jogos sorteados — e com eles toda troca de horário feita na mão e as reservas das eliminatórias previstas. O torneio volta pra 'Chaves em Sorteio' — dá pra sortear de novo quando quiser."
                                  data-confirmar-ok="Desfazer"
                                  data-confirmar-tom="perigo">
                                <input type="hidden" name="id" value="@Model.Id" />
                                <button type="submit" class="btn btn-outline-danger fw-bold shadow-sm">
                                    <i class="bi bi-arrow-counterclockwise"></i> Desfazer e Sortear de Novo
                                </button>
                            </form>
                        </div>

                        // A rajada "as chaves saíram" já saiu uma vez? O carimbo é quem responde
                        // (Torneio.ChavesAvisadasEm) — e é ele que decide se a caixinha nasce
                        // marcada. Torneio que nunca foi aprovado avisa; re-aprovação, não.
                        bool primeiraLiberacao = Model.ChavesAvisadasEm == null;
                        <form asp-controller="Torneios" asp-action="AprovarChaves" method="post"
                              data-confirmar-titulo="Aprovar e liberar as chaves?"
                              data-confirmar="@(primeiraLiberacao
                                  ? "As chaves ficam visíveis pra todo mundo, e os jogadores recebem o aviso de que as chaves saíram."
                                  : "As chaves voltam a ficar visíveis pra todo mundo. Os jogadores JÁ foram avisados uma vez deste torneio — só recebem outro aviso se a caixinha estiver marcada.")"
                              data-confirmar-ok="Aprovar e liberar">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <div class="form-check mb-3">
                                <input class="form-check-input" type="checkbox" value="true"
                                       name="avisarJogadores" id="pdzAvisarJogadores" checked="@primeiraLiberacao" />
                                @* O hidden vem DEPOIS da caixa de propósito: desmarcada, a caixa não
                                   manda nada, e sem ele o servidor leria silêncio em vez de "não avise".
                                   Marcada, chegam os dois valores e o binder fica com o primeiro. *@
                                <input type="hidden" name="avisarJogadores" value="false" />
                                <label class="form-check-label" for="pdzAvisarJogadores">
                                    Avisar os jogadores por push
                                </label>
                                @if (!primeiraLiberacao)
                                {
                                    <div class="form-text">
                                        Eles já foram avisados uma vez deste torneio — marque só se os
                                        horários mudaram e vale a pena avisar de novo.
                                    </div>
                                }
                            </div>
                            <button type="submit" class="btn btn-success fw-bold shadow-sm">
                                <i class="bi bi-check-circle-fill"></i> Aprovar e Liberar as Chaves
                            </button>
                        </form>
                    }
                    else if (Model.Status == "Fase de Grupos"
                             && !Padelizou.Services.PublicacaoDaChave.SaiPublicaNaHora(Model))
                    {
                        @* RECOLHER: o caminho de volta pra "Chaves em Aprovação", com o sorteio
                           inteiro de pé — o desfazer da APROVAÇÃO, e não do sorteio. A recusa (e a
                           frase) moram em Services/AprovacaoDeChaves.PorQueNaoPodeRecolher. *@
                        <form asp-controller="Torneios" asp-action="RecolherChaves" method="post"
                              data-confirmar-titulo="Recolher as chaves?"
                              data-confirmar="Elas voltam a aparecer só pra você e pros outros organizadores. Os grupos, os jogos e os horários continuam exatamente como estão. ⚠️ O aviso que já chegou no celular de quem joga, e o evento que já entrou na agenda, NÃO voltam atrás."
                              data-confirmar-ok="Recolher"
                              data-confirmar-tom="perigo">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button type="submit" class="btn btn-outline-warning fw-bold shadow-sm">
                                <i class="bi bi-eye-slash-fill"></i> Recolher as Chaves
                            </button>
                            <div class="form-text">
                                Só enquanto nenhum jogo começou — depois disso esconderia um torneio
                                em andamento de quem está jogando.
                            </div>
                        </form>
                    }

                    @* ── Recalcular horários ────────────────────────────────────────────────
                       O remendo pro dia em que a realidade não cabe na grade — chuva, jogo que
                       passou de três sets, dupla que não apareceu. Ele redistribui o que FALTA,
                       a partir de agora, sem tocar em quem já jogou nem em quem está em quadra,
                       e sem mexer em confronto nenhum.

                       ⚠️ VEIO DA LISTA DE JOGOS EM 10/09/2026. 🗣️ Felipe, num print da aba
                       Partidas do 2ª Etapa ER PADEL TOUR: *"mude esse botao recalcular horarios,
                       para o lado desse do 'recolher as chaves' se nao alguem pode clicar sem
                       querer ali"*. Lá ele ficava logo acima dos 97 jogos, na tela que se rola o
                       dia inteiro; aqui ele fica com as outras ações que mexem no torneio
                       inteiro. O irmão manso (Ajustar horários) continuou lá, com a mesa.

                       ⚠️ FICA FORA da corrente de status acima de propósito: quem tem horário
                       pra refazer é quem tem jogo agendado, e isso atravessa "Chaves em
                       Aprovação", "Fase de Grupos" e o torneio que sai público na hora — repetir
                       o botão em cada ramo seria a mesma regra escrita três vezes. Zero agendado
                       e ele some: o servidor recusaria o clique com "não há horário pra
                       recalcular", e botão que só serve pra receber "não dá" é pior que botão
                       nenhum.

                       ⚠️ O comentário fica FORA da tag `<form …>`: dentro dela o Razor apaga os
                       atributos seguintes, e foi assim que o build-900 saiu pra produção sem o
                       `data-confirmar` deste mesmo botão (ver ComentarioRazorDentroDeTagTests). *@
                    @{ int agendadasNoTorneio = ViewBag.AgendadasNoTorneio as int? ?? 0; }
                    @if (agendadasNoTorneio > 0)
                    {
                        <hr />
                        <form asp-controller="Torneios" asp-action="RefazerGrade" method="post" class="mb-0"
                              data-confirmar="Gera horários NOVOS pra todos os @agendadasNoTorneio jogos do torneio que ainda não começaram. Toda troca de horário feita na mão será perdida — inclusive as reservas das eliminatórias previstas. Jogos já finalizados e em quadra não mudam, e os confrontos continuam os mesmos."
                              data-confirmar-titulo="Recalcular todos os horários?"
                              data-confirmar-tom="perigo"
                              data-confirmar-ok="Recalcular e perder os ajustes">
                            <input type="hidden" name="id" value="@Model.Id" />
                            @* Depois de recalcular, o que interessa é ver os horários novos — e não
                               voltar pra este painel. "Details" leva pra página do torneio com âncora
                               na aba de jogos (ver TorneiosController.VoltarPara). *@
                            <input type="hidden" name="voltarPara" value="Details" />
                            <button type="submit" class="btn btn-danger fw-bold shadow-sm">
                                <i class="bi bi-exclamation-triangle-fill"></i> Recalcular horários
                            </button>
                            <div class="form-text">
                                Refaz TODOS os horários do zero e desfaz as trocas feitas na mão.
                                Use quando o torneio atrasar.
                            </div>
                        </form>
                    }
                </div>
            </div>

            @* COMO O TORNEIO FOI AVALIADO — a enquete pós-torneio, vista por quem organiza.
               A média só aparece com 3+ respostas (EnqueteDoTorneio.MediaVisivel): "5,0
               estrelas (1 avaliação)" é uma pessoa falando com voz de consenso. *@
            @{ var enquete = ViewBag.ResumoDaEnquete as Padelizou.Services.ResumoDaEnquete; }
            @if (enquete != null && enquete.Respostas > 0)
            {
                <div class="card bg-light border-0 shadow-sm mb-3">
                    <div class="card-body">
                        <h6 class="fw-bold text-muted text-uppercase mb-2">
                            <i class="bi bi-chat-square-heart-fill"></i> Como o torneio foi avaliado
                        </h6>
                        @if (enquete.TemMedia)
                        {
                            <div class="d-flex flex-wrap gap-4">
                                <div>
                                    <div class="small text-muted">O clube</div>
                                    <div class="fs-5 fw-bold"><i class="bi bi-star-fill text-warning"></i> @enquete.MediaClube?.ToString("0.0")</div>
                                </div>
                                <div>
                                    <div class="small text-muted">A organização</div>
                                    <div class="fs-5 fw-bold"><i class="bi bi-star-fill text-warning"></i> @enquete.MediaOrganizacao?.ToString("0.0")</div>
                                </div>
                                @* A do sistema tem contagem própria (quem respondeu antes de a
                                   pergunta existir não deu nota nenhuma ao Padelizou), então
                                   ela pode faltar aqui mesmo com as outras duas na tela. *@
                                @if (enquete.MediaSistema != null)
                                {
                                    <div>
                                        <div class="small text-muted">O Padelizou</div>
                                        <div class="fs-5 fw-bold"><i class="bi bi-star-fill text-warning"></i> @enquete.MediaSistema?.ToString("0.0")</div>
                                    </div>
                                }
                                <div class="align-self-end small text-muted">
                                    @enquete.Respostas @(enquete.Respostas == 1 ? "resposta" : "respostas") de quem jogou
                                </div>
                            </div>
                        }
                        else
                        {
                            <p class="small text-muted mb-0">
                                @enquete.Respostas @(enquete.Respostas == 1 ? "jogador já respondeu" : "jogadores já responderam") —
                                a média aparece a partir de @Padelizou.Services.EnqueteDoTorneio.RespostasParaMostrarMedia respostas.
                            </p>
                        }

                        @* ── O QUE ESCREVERAM ────────────────────────────────────────────
                           Tudo que tem texto, publicado ou não — e é o único lugar do sistema
                           onde o comentário anônimo aparece (sem nome, como foi combinado com
                           quem escreveu). Publicar põe o texto na página do torneio.

                           ⚠️ Os botões só saem pra quem PODE gravar: o assistente do sistema
                           abre esta aba em leitura, e o servidor recusaria o POST dele. *@
                        @{
                            var comentarios = ViewBag.ComentariosParaModerar
                                as List<Padelizou.Services.ComentarioDoTorneio>;
                        }
                        @if (comentarios != null && comentarios.Count > 0)
                        {
                            <hr />
                            <div class="small fw-bold text-muted text-uppercase mb-2">
                                O que escreveram
                                @if (enquete.EsperandoDecisao > 0)
                                {
                                    <span class="badge rounded-pill bg-warning-subtle text-warning-emphasis ms-1">
                                        @enquete.EsperandoDecisao fora do mural
                                    </span>
                                }
                            </div>

                            @foreach (var c in comentarios)
                            {
                                <div class="border rounded-3 p-2 mb-2 bg-white">
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        @if (c.Anonimo)
                                        {
                                            <span class="badge rounded-pill bg-secondary-subtle text-secondary-emphasis">
                                                <i class="bi bi-incognito"></i> Sem identificação
                                            </span>
                                        }
                                        else
                                        {
                                            <a asp-controller="Jogadores" asp-action="Perfil" asp-route-id="@c.AutorId"
                                               class="fw-semibold text-decoration-none small" style="color: var(--pdz-ink);">
                                                @c.Autor
                                            </a>
                                        }
                                        <span class="small text-muted">
                                            <i class="bi bi-star-fill text-warning"></i> @c.NotaClube clube ·
                                            <i class="bi bi-star-fill text-warning"></i> @c.NotaOrganizacao organização
                                        </span>
                                        <span class="small text-muted ms-auto">@c.Quando.ToString("dd/MM")</span>
                                    </div>

                                    @if (c.SobreOClube != null)
                                    {
                                        <div class="small mb-1"><strong>Clube:</strong> @c.SobreOClube</div>
                                    }
                                    @if (c.SobreAOrganizacao != null)
                                    {
                                        <div class="small mb-1"><strong>Organização:</strong> @c.SobreAOrganizacao</div>
                                    }

                                    <div class="d-flex align-items-center gap-2 mt-2">
                                        @if (c.Publicado)
                                        {
                                            <span class="badge rounded-pill bg-success-subtle text-success-emphasis">
                                                <i class="bi bi-eye"></i> No mural do torneio
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill bg-light text-muted border">
                                                <i class="bi bi-eye-slash"></i> Só pra vocês
                                            </span>
                                        }

                                        @if (ViewBag.GestaoSoLeitura != true)
                                        {
                                            <form asp-controller="Torneios" asp-action="PublicarAvaliacao"
                                                  asp-route-id="@Model.Id" method="post" class="m-0">
                                                <input type="hidden" name="avaliacaoId" value="@c.AvaliacaoId" />
                                                <input type="hidden" name="publicar" value="@((!c.Publicado).ToString().ToLowerInvariant())" />
                                                <button type="submit" class="btn btn-sm btn-link p-0 text-decoration-none">
                                                    @(c.Publicado ? "Tirar do mural" : "Publicar no mural")
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            }

                            <p class="small text-muted mb-0">
                                Comentário sem identificação vai pro mural <strong>sem o nome</strong> de quem
                                escreveu — é o que foi combinado com a pessoa na hora de responder.
                            </p>
                        }
                    </div>
                </div>
            }

            @* CRIAR A PRÓXIMA EDIÇÃO — pro organizador que faz o mesmo torneio todo mês.
               A cópia leva a ESTRUTURA (categorias, preços, formato, quadras, equipe) e nada
               do que aconteceu; a edição nova nasce sem datas e com as inscrições fechadas.
               O que copia e o que não copia mora em Services/DuplicacaoDeTorneio. *@
            <div class="card bg-light border-0 shadow-sm mb-3">
                <div class="card-body">
                    <h6 class="fw-bold text-muted text-uppercase mb-2">
                        <i class="bi bi-copy"></i> Próxima edição
                    </h6>
                    <p class="small text-muted mb-3">
                        Cria um torneio novo com a mesma configuração deste — categorias, valores,
                        formato, quadras e equipe. As <strong>datas ficam em branco</strong> e as
                        <strong>inscrições nascem fechadas</strong>: você revisa, marca as datas e
                        abre quando quiser. Inscrições, jogos e resultados desta edição
                        <strong>não</strong> vão junto.
                    </p>
                    <form asp-controller="Torneios" asp-action="Duplicar" method="post"
                          data-confirmar-titulo="Criar a próxima edição?"
                          data-confirmar="Um torneio novo nasce copiando a configuração deste, sem datas e com as inscrições fechadas."
                          data-confirmar-ok="Criar a edição">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn btn-outline-primary fw-bold">
                            <i class="bi bi-copy"></i> Criar a próxima edição
                        </button>
                    </form>
                </div>
            </div>

            @* CANCELAR O TORNEIO — o botão que faltava.
               Fica no fim do painel, separado e discreto, porque é o único daqui que desmancha
               o torneio inteiro. Não aparece pra torneio já cancelado (não há o que cancelar)
               nem pra finalizado (ele aconteceu — ver Services/CancelamentoDoTorneio). *@
            @if (!Padelizou.Services.CancelamentoDoTorneio.EstaCancelado(Model.Status) && Model.Status != "Finalizado")
            {
                @* Sem `@{ }` aqui: dentro do corpo de um @if já se está em código, e o `@{`
                   é erro de compilação (RZ1010). *@
                var quantosInscritos = Model.Categorias.Sum(c => c.Duplas.Count);
                var avisoDeCancelar = quantosInscritos > 0
                    ? $"{quantosInscritos} inscrito(s) recebem o aviso na hora, inclusive por WhatsApp."
                    : "Ninguém está inscrito ainda.";

                <div class="card border-danger-subtle shadow-sm mb-3">
                    <div class="card-body">
                        <h6 class="fw-bold text-danger text-uppercase mb-2">
                            <i class="bi bi-x-octagon"></i> Cancelar torneio
                        </h6>
                        <p class="small text-muted mb-3">
                            O torneio não vai acontecer: choveu, o clube perdeu a quadra, não deu gente.
                            Todo mundo que está inscrito é avisado, o torneio sai da listagem e
                            <strong>quem pagou aparece aqui numa lista</strong>, pra você devolver.
                            O Padelizou não devolve o dinheiro sozinho.
                        </p>
                        <form asp-controller="Torneios" asp-action="CancelarTorneio" method="post"
                              data-confirmar-titulo="Cancelar o torneio?"
                              data-confirmar="O torneio some da listagem e todo mundo é avisado de que ele não vai acontecer."
                              data-confirmar-ok="Cancelar o torneio"
                              data-confirmar-tom="perigo"
                              data-confirmar-detalhe="@avisoDeCancelar">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <div class="mb-2">
                                <label class="form-label small fw-bold mb-1" for="motivoCancelamento">
                                    Por quê? <span class="fw-normal text-muted">(vai no aviso e fica na página)</span>
                                </label>
                                <input type="text" name="motivo" id="motivoCancelamento" maxlength="200"
                                       class="form-control form-control-sm"
                                       placeholder="Ex: chuva, sem quadra disponível, inscrições insuficientes" />
                            </div>
                            <button type="submit" class="btn btn-outline-danger fw-bold">
                                <i class="bi bi-x-octagon"></i> Cancelar torneio
                            </button>
                        </form>
                    </div>
                </div>
            }

            @* BARRADOS PELO RANKING RS — a fila de decisão do organizador.
               A recusa da inscrição não é a palavra final: ela vira linha e espera aqui.
               Sem esta lista, o barrado teria que caçar o organizador no WhatsApp e o
               organizador não saberia que alguém tentou entrar. *@
            @{
                var bloqueiosRanking = (ViewBag.BloqueiosDoRanking as List<Padelizou.Models.BloqueioDoRanking>) ?? new();
                var pendentesRanking = bloqueiosRanking
                    .Where(b => b.Situacao == Padelizou.Models.SituacaoDoBloqueio.Pendente).ToList();
            }
            @if (bloqueiosRanking.Count > 0)
            {
                <div class="card bg-light border-0 shadow-sm mb-3">
                    <div class="card-body">
                        <h6 class="fw-bold text-muted text-uppercase mb-1">
                            <i class="bi bi-graph-up-arrow"></i> Barrados pelo @Padelizou.Services.MarcaDoRanking.Nome
                            @if (pendentesRanking.Count > 0)
                            {
                                <span class="badge bg-warning text-dark ms-1">@pendentesRanking.Count pra decidir</span>
                            }
                        </h6>
                        <p class="small text-muted mb-3">
                            O ranking apontou que estas pessoas já pontuaram numa categoria mais forte.
                            <strong>Você decide.</strong> Lembre que o ranking casa <strong>por nome</strong> —
                            homônimo ou nome escrito diferente pode barrar quem tem direito de jogar.
                        </p>

                        <ul class="list-group list-group-flush">
                            @foreach (var b in bloqueiosRanking)
                            {
                                <li class="list-group-item bg-transparent px-0">
                                    <div class="d-flex justify-content-between align-items-start gap-2 flex-wrap">
                                        <div class="flex-grow-1" style="min-width: 200px;">
                                            <div class="fw-bold">
                                                @Padelizou.Services.NomeBonito.Formatar(b.NomeConsultado)
                                                <span class="badge bg-secondary fw-normal">@(b.Categoria?.Nome ?? "categoria removida")</span>
                                            </div>
                                            <div class="small text-muted">@b.Motivo</div>
                                            @if (b.Situacao != Padelizou.Models.SituacaoDoBloqueio.Pendente)
                                            {
                                                <div class="small mt-1">
                                                    @if (b.Situacao == Padelizou.Models.SituacaoDoBloqueio.Liberado)
                                                    {
                                                        <span class="badge bg-success">liberado por você</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-danger">não liberado por você</span>
                                                    }
                                                    @if (b.DecididoEm is DateTime quando)
                                                    {
                                                        <span class="text-muted">em @quando.ToString("dd/MM 'às' HH:mm")</span>
                                                    }
                                                </div>
                                            }
                                        </div>

                                        @* Os dois botões aparecem SEMPRE, inclusive depois de decidido:
                                           mudar de ideia é normal, e sem isso um clique errado viraria
                                           beco sem saída — que é o defeito que esta tela existe pra evitar. *@
                                        <div class="d-flex gap-1 flex-shrink-0">
                                            @if (b.Situacao != Padelizou.Models.SituacaoDoBloqueio.Liberado)
                                            {
                                                <form asp-controller="Torneios" asp-action="LiberarBloqueioRanking" method="post"
                                                      data-confirmar-titulo="Liberar a inscrição?"
                                                      data-confirmar="@(Padelizou.Services.NomeBonito.Formatar(b.NomeConsultado)) vai poder se inscrever em @(b.Categoria?.Nome) mesmo com os pontos do ranking. Avise a pessoa: ela precisa fazer a inscrição de novo."
                                                      data-confirmar-ok="Liberar">
                                                    <input type="hidden" name="id" value="@b.Id" />
                                                    <button type="submit" class="btn btn-sm btn-success">
                                                        <i class="bi bi-check-lg"></i> Liberar
                                                    </button>
                                                </form>
                                            }
                                            @if (b.Situacao != Padelizou.Models.SituacaoDoBloqueio.Mantido)
                                            {
                                                @* "Não liberar" e não "Manter": o par do botão é "Liberar", e o
                                                   organizador precisa ler o que VAI ACONTECER, não o estado que
                                                   fica. "Manter" só faz sentido pra quem já sabe que existe uma
                                                   recusa em pé — que é justamente quem não precisa do botão. *@
                                                <form asp-controller="Torneios" asp-action="ManterBloqueioRanking" method="post"
                                                      data-confirmar-titulo="Não liberar a inscrição?"
                                                      data-confirmar="@(Padelizou.Services.NomeBonito.Formatar(b.NomeConsultado)) continua sem conseguir se inscrever em @(b.Categoria?.Nome)."
                                                      data-confirmar-ok="Não liberar"
                                                      data-confirmar-tom="perigo">
                                                    <input type="hidden" name="id" value="@b.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                                        <i class="bi bi-x-lg"></i> Não liberar
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </div>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            }

            <!-- ORGANIZADORES DO TORNEIO -->
            <div class="card bg-light border-0 shadow-sm">
                <div class="card-body">
                    <h6 class="fw-bold text-muted text-uppercase mb-3">Organizadores deste Torneio</h6>

                    <ul class="list-group list-group-flush mb-3">
                        @foreach (var org in (ViewBag.Organizadores as List<Padelizou.Models.TorneioOrganizador>) ?? new())
                        {
                            <li class="list-group-item bg-transparent d-flex align-items-center gap-2 px-0">
                                <img src="@(string.IsNullOrEmpty(org.Jogador.FotoPerfil) ? "/img/default-avatar.png" : org.Jogador.FotoPerfil)"
                                     class="rounded-circle" style="width: 32px; height: 32px; object-fit: cover;" />
                                <span class="fw-bold">@org.Jogador.ComoChamar</span>
                                <span class="badge bg-secondary ms-2">@org.NivelAcesso</span>
                            </li>
                        }
                    </ul>

                    <label class="form-label fw-bold small">Adicionar novo organizador</label>

                    @* O aviso fica ONDE se decide, não numa ajuda escondida: é aqui que o
                       criador escolhe dar acesso a alguém, e é aqui que ele precisa saber
                       exatamente o que está dando — e o que NÃO está. *@
                    <div class="alert alert-warning d-flex align-items-start gap-2 py-2 small mb-2">
                        <i class="bi bi-info-circle-fill"></i>
                        <div>@Padelizou.Services.AcessoAoDinheiroDoTorneio.AvisoAoAdicionar</div>
                    </div>

                    @{ ViewData["BuscaOrgTorneioId"] = Model.Id; }
                    <partial name="_BuscaOrganizador" />
                    @{ ViewData["BuscaOrgTorneioId"] = null; }
                </div>
            </div>

            <!-- MARCADORES DO TORNEIO -->
            <div class="card bg-light border-0 shadow-sm mt-4">
                <div class="card-body">
                    <h6 class="fw-bold text-muted text-uppercase mb-3">Marcadores deste Torneio</h6>

                    @* O aviso segue a mesma regra do card de cima: fica onde se decide. A
                       diferença que importa é o que o marcador NÃO ganha. *@
                    <div class="alert alert-info d-flex align-items-start gap-2 py-2 small mb-3">
                        <i class="bi bi-info-circle-fill"></i>
                        <div>
                            O marcador cuida da mesa no dia de jogo: <strong>placar, começar jogos,
                            W.O., check-in e trocas de quadra e horário</strong>. Ele não vê
                            inscrições, dinheiro nem configuração do torneio — e dá pra remover
                            quando o evento acabar.
                        </div>
                    </div>

                    @{ var marcadores = (ViewBag.Marcadores as List<Padelizou.Models.TorneioMarcador>) ?? new(); }
                    @if (marcadores.Count == 0)
                    {
                        <p class="small text-muted mb-3">Nenhum marcador ainda.</p>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush mb-3">
                            @foreach (var marc in marcadores)
                            {
                                <li class="list-group-item bg-transparent d-flex align-items-center gap-2 px-0">
                                    <img src="@(string.IsNullOrEmpty(marc.Jogador.FotoPerfil) ? "/img/default-avatar.png" : marc.Jogador.FotoPerfil)"
                                         class="rounded-circle" style="width: 32px; height: 32px; object-fit: cover;" />
                                    <span class="fw-bold">@marc.Jogador.ComoChamar</span>
                                    <span class="badge bg-info ms-2">Marcador</span>
                                    <form asp-action="RemoverMarcador" method="post" class="ms-auto"
                                          onsubmit="return confirm('Remover este marcador? Ele perde o acesso à mesa na hora.');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="torneioId" value="@Model.Id" />
                                        <input type="hidden" name="jogadorId" value="@marc.JogadorId" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Remover marcador">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </form>
                                </li>
                            }
                        </ul>
                    }

                    <label class="form-label fw-bold small">Adicionar marcador</label>
                    @{
                        ViewData["BuscaOrgActionUrl"] = "/Torneios/AdicionarMarcador";
                        ViewData["BuscaOrgExtraFieldName"] = "torneioId";
                        ViewData["BuscaOrgExtraFieldValue"] = Model.Id;
                    }
                    <partial name="_BuscaOrganizador" />
                    @{
                        ViewData["BuscaOrgActionUrl"] = null;
                        ViewData["BuscaOrgExtraFieldName"] = null;
                        ViewData["BuscaOrgExtraFieldValue"] = null;
                    }
                </div>
            </div>

            @* ── DIVULGAÇÃO: PUBLICAR OU ESCONDER ──────────────────────────────────────
               ⚠️ FICA FORA do formulário de edição, e isso não é arrumação: `<form>` dentro
               de `<form>` some com campos no navegador (o de dentro fecha o de fora), e o que
               sumiria aqui era metade da edição do torneio.

               É também por isso que o interruptor deixou de ser uma caixinha lá dentro: a
               caixa só valia depois de "Salvar Alterações", junto de mais 40 campos, e vivia
               escondida dentro da seção do "torneio restrito" — o torneio ABERTO que ainda não
               foi divulgado, que é o caso comum, não tinha como ficar escondido de jeito
               nenhum. Aqui é um botão, um clique, e vale na hora. *@
            <div class="card bg-light border-0 shadow-sm mt-4">
                <div class="card-body">
                    <h6 class="fw-bold text-uppercase text-muted mb-2">
                        <i class="bi bi-megaphone"></i> Divulgação
                    </h6>
                    @if (Model.Oculto)
                    {
                        <p class="small mb-3">@Padelizou.Services.VisibilidadeDoTorneio.AvisoDeOculto</p>
                        <form asp-controller="Torneios" asp-action="AlternarVisibilidade" method="post" class="mb-0">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <input type="hidden" name="ocultar" value="false" />
                            <button type="submit" class="btn btn-success fw-bold shadow-sm">
                                <i class="bi bi-megaphone-fill"></i> Publicar torneio
                            </button>
                        </form>
                    }
                    else
                    {
                        <p class="small mb-3">
                            Este torneio está <strong>visível</strong>: aparece na lista de torneios, na página
                            inicial e no Google, e quem receber o link consegue abrir e se inscrever.
                            Escondendo, ele some de tudo isso na hora — só você, os outros organizadores e
                            quem já está inscrito continuam vendo. Dá pra publicar de novo quando quiser.
                        </p>
                        <form asp-controller="Torneios" asp-action="AlternarVisibilidade" method="post" class="mb-0">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <input type="hidden" name="ocultar" value="true" />
                            <button type="submit" class="btn btn-outline-secondary fw-bold">
                                <i class="bi bi-eye-slash-fill"></i> Ocultar do público
                            </button>
                        </form>
                    }
                </div>
            </div>

            <!-- EDITAR DADOS DO TORNEIO -->
            <div class="card bg-light border-0 shadow-sm mt-4">
                <div class="card-body">
                    <button class="btn btn-sm btn-outline-secondary rounded-pill mb-3" type="button" data-bs-toggle="collapse" data-bs-target="#editarTorneioForm">
                        <i class="bi bi-pencil-square"></i> Editar Dados do Torneio
                    </button>
                    <div class="collapse" id="editarTorneioForm">
                        <form asp-controller="Torneios" asp-action="Editar" method="post" enctype="multipart/form-data">
                            <input type="hidden" name="id" value="@Model.Id" />

                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold small">Nome do Torneio</label>
                                    <input type="text" name="nome" class="form-control" value="@Model.Nome" maxlength="150" required />
                                </div>
                                @* "Local" e "Clube" eram o MESMO dado pedido duas vezes: o local
                                   do torneio é o clube onde ele acontece. A criação já pedia só
                                   o clube; aqui tinha sobrado o campo de texto, e os dois
                                   podiam divergir — o cabeçalho mostra o Local, então dava pra
                                   anunciar um lugar e ter o torneio marcado em outro. Agora o
                                   nome do clube escolhido vira o local, sozinho. *@
                                <div class="col-md-6">
                                    <label class="form-label fw-bold small">Clube <span class="fw-normal">(é o local do torneio)</span></label>
                                    <select name="clubeId" class="form-select" required>
                                        @foreach (var clube in (ViewBag.CatalogoClubes as List<Padelizou.Models.Clube>) ?? new())
                                        {
                                            <option value="@clube.Id" selected="@(clube.Id == Model.ClubeId)">@clube.Nome</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label fw-bold small">Data de Início</label>
                                    <input type="date" name="dataInicio" id="editDataInicio" class="form-control"
                                           value="@Model.DataInicio?.ToString("yyyy-MM-dd")"
                                           onchange="pdzEditarTurnoDeQuinta()" />
                                    <small class="text-muted d-block mt-1">
                                        É o dia do primeiro jogo — e é ele que decide se a quinta à noite entra
                                        nos impedimentos, ali embaixo.
                                    </small>
                                </div>
                                @* O dia em que ACABA. Só dava pra dizer na criação, e a data que
                                   escorrega ("consegui a quadra até domingo, não sábado") é
                                   exatamente o tipo de coisa que muda depois de publicar. *@
                                <div class="col-md-3">
                                    <label class="form-label fw-bold small">Precisa terminar até <span class="fw-normal">(opcional)</span></label>
                                    <input type="date" name="dataFim" class="form-control" value="@Model.DataFim?.ToString("yyyy-MM-dd")" />
                                    @* Marca que o formulário NOVO mandou o campo. Sem isto, aba
                                       aberta antes deste deploy (que não manda `dataFim`) chegaria
                                       com nulo e APAGARIA o limite calado — e é justamente o nulo
                                       que serve pra limpar o campo de propósito. Ver Editar. *@
                                    <input type="hidden" name="dataFimInformada" value="true" />
                                    <small class="text-muted d-block mt-1">Até quando você tem a quadra. Vazio = sem limite.</small>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label fw-bold small">Preço da Inscrição</label>
                                    @* Invariante, senão o pt-BR escreve "150,00" e o navegador
                                       mostra o campo VAZIO — ver DinheiroNoCampo. *@
                                    <input type="number" step="0.01" name="precoInscricao" class="form-control"
                                           value="@Padelizou.Services.DinheiroNoCampo.Valor(Model.PrecoInscricao)" required />
                                </div>
                                @* A taxa de impedimento passou a ser editável aqui (18/08/2026):
                                   estava presa na tela de criação, e interruptor que só existe
                                   no cadastro vira "não dá pra mudar". *@
                                <div class="col-md-3">
                                    <label class="form-label fw-bold small">Taxa por impedimento</label>
                                    <input type="number" step="0.01" min="0" name="taxaPorImpedimento" class="form-control"
                                           value="@Padelizou.Services.DinheiroNoCampo.Valor(Model.TaxaPorImpedimento)" />
                                    <small class="text-muted d-block mt-1">
                                        Uma vez <strong>por dupla</strong>, não por jogador. Zero = não cobra.
                                    </small>
                                </div>
                                @* ── PARIDADE COM A TELA DE CRIAÇÃO ────────────────────────
                                   Campo que só existe no cadastro vira beco: já aconteceu com a
                                   forma de recebimento, com reabrir inscrições e com "só
                                   confirmo depois de pago". As travas de quando PODE mudar
                                   moram em Services/MudancaDepoisDeAberto. *@
                                <div class="col-md-3">
                                    <label class="form-label fw-bold small">Limite de duplas</label>
                                    <input type="number" min="0" name="limiteDuplasTotal" class="form-control"
                                           value="@(Model.LimiteDuplasTotal?.ToString() ?? "")" placeholder="sem limite" />
                                    <div class="form-check mt-1">
                                        @* Sinal separado porque "vazio" no número já quer dizer
                                           "campo não veio" — sem isto não daria pra TIRAR o
                                           limite depois de posto. *@
                                        <input class="form-check-input" type="checkbox" name="limiteSemTeto" value="true" id="editSemTeto" />
                                        <label class="form-check-label small" for="editSemTeto">Sem limite</label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" name="permiteMultiplasCategorias" value="true"
                                               id="editMultiplasCat" checked="@Model.PermiteMultiplasCategorias" />
                                        <input type="hidden" name="permiteMultiplasCategorias" value="false" />
                                        <label class="form-check-label small" for="editMultiplasCat">
                                            Permitir o mesmo jogador em mais de uma categoria
                                        </label>
                                    </div>
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" name="excluirSeNaoPagar" value="true"
                                               id="editExcluirSeNaoPagar" checked="@Model.ExcluirSeNaoPagar" />
                                        <input type="hidden" name="excluirSeNaoPagar" value="false" />
                                        <label class="form-check-label small" for="editExcluirSeNaoPagar">
                                            Excluir inscrição não paga no prazo
                                        </label>
                                    </div>
                                    @if (Model.Formato == Padelizou.Services.FormatoDoTorneio.Americano
                                      || Model.Formato == Padelizou.Services.FormatoDoTorneio.AmericanoDeDuplas)
                                    {
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" name="pontuaNoRankingAmericano" value="true"
                                                   id="editPontuaAmericano" checked="@Model.PontuaNoRankingAmericano" />
                                            <input type="hidden" name="pontuaNoRankingAmericano" value="false" />
                                            <label class="form-check-label small" for="editPontuaAmericano">
                                                Pontua no ranking de Americano
                                            </label>
                                        </div>
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" name="desempateAmericano" value="true"
                                                   id="editDesempateAmericano" checked="@Model.DesempateAmericano" />
                                            <input type="hidden" name="desempateAmericano" value="false" />
                                            <label class="form-check-label small" for="editDesempateAmericano">
                                                Jogo de desempate no Americano
                                            </label>
                                        </div>
                                    }
                                </div>

                                @* ⚠️ O AVISO QUE O FELIPE PEDIU. Cada inscrição guarda o que ELA
                                   custou (Dupla.ValorInscricao): mudar o valor aqui não reescreve
                                   nenhuma. Sem dizer isso, o organizador faz uma de duas contas
                                   erradas — cobra a diferença de quem já pagou, ou conta com um
                                   dinheiro que não vem. Texto único em AvisoDeMudancaDePreco. *@
                                @if (Padelizou.Services.AvisoDeMudancaDePreco.Texto(
                                        ViewBag.InscricoesJaFeitas as int? ?? 0) is string avisoDePreco)
                                {
                                    <div class="col-12">
                                        <div class="alert alert-warning py-2 px-3 small mb-0 d-flex gap-2 align-items-start">
                                            <i class="bi bi-exclamation-triangle-fill"></i>
                                            <span>@avisoDePreco</span>
                                        </div>
                                    </div>
                                }
                                @* ⚠️ NOME E QUANTIDADE DE QUADRA SAÍRAM DAQUI (09/09/2026). O lugar
                                   único de quadra é o planejador — nome, local e janela de cada
                                   uma, e a quantidade é o número de linhas. Ficou aqui só o
                                   container OCULTO com os nomes atuais, porque a tabela de
                                   preferência de quadra logo abaixo precisa deles pra desenhar as
                                   colunas (montarPreferenciaQuadraEdicao). O POST do Editar não
                                   recebe mais os campos, e sabe disso: sem eles, não toca em quadra. *@
                                <div class="col-12">
                                    <div id="editCamposNomesQuadras" class="d-none"
                                         data-nomes-atuais='@Html.Raw(System.Text.Json.JsonSerializer.Serialize((ViewBag.Quadras as List<Padelizou.Models.Quadra>)?.Select(q => q.Nome) ?? Enumerable.Empty<string>()))'></div>
                                    <div class="alert alert-light border small mb-0 py-2 px-3 d-flex flex-wrap align-items-center gap-2">
                                        <span>
                                            <i class="bi bi-grid-3x3-gap"></i>
                                            <strong>@Model.QuantidadeQuadras @(Model.QuantidadeQuadras == 1 ? "quadra" : "quadras")</strong>
                                            — nome, local e horário de cada uma ficam no planejador.
                                        </span>
                                        <a asp-action="Planejamento" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                            <i class="bi bi-calendar-range"></i> Quadras e planejamento
                                        </a>
                                    </div>
                                </div>

                @* ⚠️ O EDITOR DE SEDES SAIU DAQUI EM 08/09/2026 (pedido do Felipe:
                   "move o editor de sedes pra aba nova"). Em que clube cada quadra fica, em
                   que clube cada categoria joga e a folga pra atravessar a cidade vivem agora
                   na sub-aba "Quadras e sedes", dentro de "Pagamentos e impedimentos" — junto
                   da janela do local alugado e do transbordo, que são o mesmo assunto.

                   Esta tela ficou com o NOME e a QUANTIDADE das quadras, que é identidade e
                   precisa existir também na criação. O `Editar` não escreve mais em
                   `Quadra.ClubeId`/`Categoria.ClubeId`, e por isso a marca `sedesInformadas`
                   foi embora junto — ver TorneiosController.Criacao. *@
                <div class="col-12">
                    <div class="alert alert-light border small mb-0 py-2 px-3">
                        <i class="bi bi-geo-alt"></i>
                        Em que clube cada quadra fica e quais categorias jogam onde ficam em
                        <strong>Pagamentos e impedimentos › Quadras e sedes</strong>.
                    </div>
                </div>

                                @* ── QUADRA PREFERENCIAL POR CATEGORIA ──────────────────
                                   A mesma escolha da criação, editável depois — que é quando
                                   ela costuma aparecer: o clube libera a central só no
                                   domingo, entrou uma categoria nova, a final mudou de lugar.

                                   Recolhida, como lá: a maioria dos torneios não usa isso, e
                                   uma tabela de categorias × quadras aberta no meio do
                                   formulário de gestão atrapalharia todos eles.

                                   As colunas saem dos campos de nome ali de cima, e não do
                                   banco: a quadra marcada aqui pode ser uma que ainda vai
                                   nascer neste mesmo salvamento (subiu de 3 pra 5). Por isso
                                   o valor da caixinha é a POSIÇÃO, traduzida em Id pelo
                                   servidor depois de reconciliar as quadras (ver Editar). *@
                                <div class="col-12">
                                    <details class="p-3 rounded" style="background-color: var(--pdz-surface-alt);"
                                             id="pdzEditPreferenciaQuadra"
                                             data-marcadas='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.QuadrasPreferidas as List<string> ?? new List<string>()))'
                                             data-categorias='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Categorias.OrderBy(c => c.Id).Select(c => new { id = c.Id, nome = c.Nome })))'>
                                        <summary class="fw-bold small" style="color: var(--pdz-ink); cursor: pointer;">
                                            <i class="bi bi-star-fill"></i> Quadra preferencial por categoria
                                            <span class="text-muted fw-normal">— opcional</span>
                                        </summary>
                                        <p class="small text-muted mt-2 mb-2">
                                            Os jogos da categoria vão pra quadra marcada primeiro. As outras
                                            categorias só ocupam essa quadra quando não sobrar nenhuma outra livre
                                            no horário — segurar quadra vazia atrasaria o torneio inteiro.
                                            <strong>Vale a partir do próximo sorteio</strong> (ou do "refazer grade"):
                                            jogo que já tem quadra não muda de lugar sozinho.
                                        </p>
                                        <div id="pdzEditPreferenciaQuadraTabela" class="table-responsive"></div>
                                        @* Caixa desmarcada não vai no POST — então "desmarquei
                                           todas" chega igualzinho a "esta aba é antiga e nem
                                           tem esse campo". Sem esta marca, salvar a gestão numa
                                           aba velha APAGARIA a preferência inteira, calado. É a
                                           mesma armadilha do `dataFimInformada`. *@
                                        <input type="hidden" name="quadrasPreferidasInformadas" value="true" />
                                    </details>
                                </div>
                                @* Os mesmos campos da criação, editáveis depois: chave Pix
                                   trocada, data que escorregou e recado que mudou são coisas
                                   que acontecem com o torneio já publicado. *@
                                <div class="col-md-3">
                                    <label class="form-label fw-bold small">Inscrições fecham em</label>
                                    <input type="date" name="previsaoEncerramentoInscricoes" class="form-control"
                                           value="@Model.PrevisaoEncerramentoInscricoes?.ToString("yyyy-MM-dd")" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label fw-bold small">Chaveamento previsto</label>
                                    <input type="date" name="previsaoChaveamento" class="form-control"
                                           value="@Model.PrevisaoChaveamento?.ToString("yyyy-MM-dd")" />
                                </div>
                                @* ── Como você vai receber ──────────────────────────────────
                                   Trocável enquanto ninguém se inscreveu. Antes de 08/08/2026
                                   a escolha da criação era definitiva, e quem clicou errado só
                                   saía apagando o torneio e criando outro — perdendo o link já
                                   compartilhado. Ver Services/FormaDePagamentoDoTorneio. *@
                                @{
                                    var podeTrocarForma = ViewBag.PodeTrocarFormaPagamento == true;
                                    var recebeConectado = ViewBag.RecebimentoConectado == true;
                                    var taxasTorneio = TaxasOpcoes.Value;
                                }
                                <div class="col-12">
                                    <label class="form-label fw-bold small">
                                        <i class="bi bi-cash-coin"></i> Como você vai receber as inscrições
                                    </label>

                                    @if (!podeTrocarForma)
                                    {
                                        @* Travado: mostra o que está valendo e por quê. Sumir com
                                           o bloco faria a forma de recebimento parecer coisa que
                                           o sistema não tem. *@
                                        <div class="border rounded p-2 small" style="background: var(--pdz-surface);">
                                            <span class="fw-bold">
                                                @(Model.FormaPagamento switch
                                                {
                                                    Padelizou.Services.FormaDePagamentoDoTorneio.SoPix => "Pelo site, só Pix",
                                                    Padelizou.Services.FormaDePagamentoDoTorneio.TodasAsFormas => "Pelo site, todas as formas",
                                                    _ => "Por fora",
                                                })
                                            </span>
                                            <span class="badge bg-secondary ms-1">travado</span>
                                            <div class="text-muted mt-1">@Padelizou.Services.FormaDePagamentoDoTorneio.PorqueTravou</div>
                                        </div>
                                    }
                                    else
                                    {
                                        @if (!recebeConectado)
                                        {
                                            <div class="alert alert-warning border-0 small py-2 mb-2">
                                                <strong>Pra receber pelo site, falta conectar sua conta.</strong>
                                                <a asp-controller="Pagamentos" asp-action="Configurar" target="_blank"
                                                   class="alert-link">Conectar agora</a> — leva um minuto.
                                            </div>
                                        }

                                        <div class="form-check small mb-1 @(recebeConectado ? "" : "opacity-50")">
                                            <input class="form-check-input" type="radio" name="formaPagamento" id="edPagPix"
                                                   value="@Padelizou.Services.FormaDePagamentoDoTorneio.SoPix"
                                                   disabled="@(!recebeConectado)"
                                                   checked="@(Model.FormaPagamento == Padelizou.Services.FormaDePagamentoDoTorneio.SoPix)" />
                                            <label class="form-check-label" for="edPagPix">
                                                <span class="fw-bold">Pelo site, só Pix</span>
                                                <span class="badge bg-success ms-1">taxa @taxasTorneio.ComissaoPercentualSomentePix.ToString("0.#")%</span>
                                                <span class="d-block text-muted">Cai na sua conta na hora, e a vaga já nasce confirmada.</span>
                                            </label>
                                        </div>

                                        <div class="form-check small mb-1 @(recebeConectado ? "" : "opacity-50")">
                                            <input class="form-check-input" type="radio" name="formaPagamento" id="edPagTodas"
                                                   value="@Padelizou.Services.FormaDePagamentoDoTorneio.TodasAsFormas"
                                                   disabled="@(!recebeConectado)"
                                                   checked="@(Model.FormaPagamento == Padelizou.Services.FormaDePagamentoDoTorneio.TodasAsFormas)" />
                                            <label class="form-check-label" for="edPagTodas">
                                                <span class="fw-bold">Pelo site, todas as formas</span>
                                                <span class="badge bg-secondary ms-1">taxa @taxasTorneio.ComissaoPercentualSomentePix.ToString("0.#")% a @taxasTorneio.ComissaoPercentualTodasFormas.ToString("0.#")%</span>
                                                <span class="d-block text-muted">
                                                    Pix, débito e crédito. Você paga a taxa da forma que o jogador
                                                    escolher — Pix custa @taxasTorneio.ComissaoPercentualSomentePix.ToString("0.#")%.
                                                    O cartão só cai em @taxasTorneio.CreditoAVista.DiasParaReceber dias.
                                                </span>
                                            </label>
                                        </div>

                                        <div class="form-check small">
                                            <input class="form-check-input" type="radio" name="formaPagamento" id="edPagExterno"
                                                   value="@Padelizou.Services.FormaDePagamentoDoTorneio.Externo"
                                                   checked="@(!Model.CobraPeloSite)" />
                                            <label class="form-check-label" for="edPagExterno">
                                                <span class="fw-bold">Por fora</span>
                                                <span class="badge bg-success ms-1">taxa @taxasTorneio.ComissaoPercentualExterno.ToString("0.#")%</span>
                                                <span class="d-block text-muted">
                                                    Você combina o Pix direto com o jogador. As chaves saem depois que a
                                                    taxa for paga — ou combinada com o Padelizou.
                                                </span>
                                            </label>
                                        </div>
                                    }
                                </div>

                                @* ── Só confirmo a inscrição depois de pago ──────────────────
                                   Só aparece em torneio que cobra pelo site: no "por fora" o
                                   sistema não gera cobrança nenhuma, então a chave não decide nada.

                                   ⚠️ DESLIGADA, NENHUMA COBRANÇA É GERADA — os dois únicos
                                   caminhos que criam cobrança de torneio passam por ela, e não
                                   existe "pagar depois". Um torneio que virou "pelo site" com ela
                                   desligada cobra pelo site só no nome; foi o que aconteceu no
                                   NATA PADEL TOUR, que nasceu por fora. *@
                                @* Preço da 2ª categoria do mesmo jogador. Editável aqui, e não
                                   só na criação: é o normal do padel e o organizador costuma
                                   decidir isso depois de ver quanta gente quer duas categorias.
                                   Não mexe em quem já entrou — cada inscrição guarda o que
                                   custou (ver Services/PrecoDaInscricao). *@
                                @if (Padelizou.Services.PrecoDaInscricao.CabeSegundoPreco(Model))
                                {
                                    <div class="col-md-6">
                                        <label class="form-label fw-bold small">
                                            Preço da 2ª categoria do mesmo jogador
                                        </label>
                                        <div class="input-group">
                                            <span class="input-group-text">R$</span>
                                            <input type="number" step="0.01" min="0" class="form-control"
                                                   name="precoSegundaInscricao"
                                                   value="@Padelizou.Services.DinheiroNoCampo.Valor(Model.PrecoSegundaInscricao)"
                                                   placeholder="mesmo preço" />
                                        </div>
                                        <div class="form-check mt-1">
                                            @* Campo em branco não chega ao servidor como "apague":
                                               chega como ausente, e ausente significa "não mexi".
                                               Sem esta caixa não haveria como TIRAR o desconto. *@
                                            <input class="form-check-input" type="checkbox" value="true"
                                                   name="limparSegundoPreco" id="limparSegundoPreco" />
                                            <label class="form-check-label small text-muted" for="limparSegundoPreco">
                                                Tirar o desconto (toda inscrição volta a custar o preço cheio)
                                            </label>
                                        </div>
                                        <small class="text-muted">
                                            Vale pra quem se inscrever daqui pra frente; quem já entrou mantém o que pagou.
                                        </small>
                                    </div>
                                }

                                @if (Model.CobraPeloSite && Model.PrecoInscricao > 0)
                                {
                                    <div class="col-12">
                                        <div class="p-3 rounded" style="background-color: var(--pdz-surface-alt); border-left: 4px solid var(--pdz-lime);">
                                            <label class="form-label fw-bold small">Quando o jogador precisa pagar?</label>

                                            @* DUAS OPÇÕES, e não um interruptor (Felipe, 08/08/2026). O
                                               interruptor escondia a segunda escolha atrás de um "desligado",
                                               e "desligado" não conta o que acontece no lugar. *@
                                            <div class="form-check mb-2">
                                                <input class="form-check-input" type="radio" name="pagamentoObrigatorio"
                                                       value="true" id="edPagAgora"
                                                       checked="@Model.PagamentoObrigatorioNaInscricao" />
                                                <label class="form-check-label" for="edPagAgora">
                                                    <span class="fw-bold small">@Padelizou.Services.PrazoParaPagar.SoDepoisDePago</span>
                                                    <span class="d-block small text-muted">
                                                        A vaga só existe com o dinheiro. Acaba o calote — mas
                                                        <strong>quem abandona o checkout não aparece na lista</strong>,
                                                        e some sem deixar rastro.
                                                    </span>
                                                </label>
                                            </div>

                                            <div class="form-check">
                                                <input class="form-check-input" type="radio" name="pagamentoObrigatorio"
                                                       value="false" id="edPagDepois"
                                                       checked="@(!Model.PagamentoObrigatorioNaInscricao)" />
                                                <label class="form-check-label" for="edPagDepois">
                                                    <span class="fw-bold small">@Padelizou.Services.PrazoParaPagar.AteOFechamento</span>
                                                    <span class="d-block small text-muted">
                                                        A vaga nasce na hora, marcada como <strong>Pagamento pendente</strong>,
                                                        e o jogador paga pelo botão <strong>Pagar agora</strong> até o
                                                        fechamento das inscrições.
                                                        @if (Model.PrevisaoEncerramentoInscricoes is DateTime fecha)
                                                        {
                                                            <text>No seu torneio isso dá até <strong>@fecha.ToString("dd/MM")</strong>.</text>
                                                        }
                                                        else
                                                        {
                                                            <text><strong>Preencha "Inscrições fecham em"</strong> acima pra ter uma data —
                                                            sem ela o prazo fica em aberto.</text>
                                                        }
                                                    </span>
                                                </label>
                                            </div>

                                            <div class="small text-muted ps-1 mt-2">
                                                Vale pra quem se inscrever daqui pra frente; quem já está dentro não muda.
                                            </div>
                                        </div>
                                    </div>
                                }

                                @* O campo da chave Pix acompanha quem PODE virar "por fora", e não
                                   só quem já é: sem isso, trocar a forma exigiria salvar, esperar a
                                   tela voltar e editar de novo pra informar a chave. *@
                                @if (!Model.CobraPeloSite || podeTrocarForma)
                                {
                                    <div class="col-md-6">
                                        <label class="form-label fw-bold small">Sua chave Pix</label>
                                        <input type="text" name="chavePixOrganizador" class="form-control" maxlength="140"
                                               value="@Model.ChavePixOrganizador"
                                               placeholder="CPF, celular, e-mail ou chave aleatória" />
                                        <small class="text-muted">Só é usada no "por fora" — aparece pro jogador junto com o valor.</small>
                                    </div>
                                }
                                <div class="col-12">
                                    <label class="form-label fw-bold small">Recado pra quem se inscrever</label>
                                    <textarea name="recadoAosInscritos" class="form-control" rows="2" maxlength="600"
                                              placeholder="Ex: confirme no grupo do WhatsApp depois de pagar.">@Model.RecadoAosInscritos</textarea>
                                </div>

                                @* O convite do grupo. Aparece preenchido só aqui, na gestão —
                                   na página do torneio ele nunca é escrito como texto, só como
                                   destino do botão de quem está inscrito. *@
                                <div class="col-12">
                                    <label class="form-label fw-bold small">Link do grupo no WhatsApp</label>
                                    <input type="text" name="linkGrupoWhatsApp" class="form-control" maxlength="300"
                                           inputmode="url" value="@Model.LinkGrupoWhatsApp"
                                           placeholder="https://chat.whatsapp.com/..." />
                                    <small class="text-muted">
                                        Vira o botão <strong>Entrar no grupo do torneio</strong>, que só
                                        quem está inscrito enxerga. Apague o campo pra tirar o botão —
                                        quem já entrou no grupo continua lá.
                                    </small>
                                </div>

                                @* As fotos do torneio. Só existe aqui, na gestão: torneio que está
                                   sendo criado não tem foto, então o campo não polui o formulário
                                   de criação — ele aparece quando faz sentido preencher. *@
                                <div class="col-12">
                                    <label class="form-label fw-bold small">Link das fotos do torneio</label>
                                    @* type="text" e não type="url": o navegador recusaria o endereço
                                       colado sem o https, que o servidor completa sozinho. *@
                                    <input type="text" name="linkDasFotos" class="form-control" maxlength="300"
                                           inputmode="url" value="@Model.LinkDasFotos"
                                           placeholder="https://photos.app.goo.gl/..." />
                                    <small class="text-muted">
                                        Vira o botão <strong>Ver as fotos do torneio</strong> na página,
                                        pra todo mundo. Pode ser álbum do Google Fotos, pasta do Drive
                                        ou o Instagram do fotógrafo. Apague o campo pra tirar o botão.
                                    </small>
                                </div>

                                <div class="col-12">
                                    <label class="form-label fw-bold small">Trocar Imagem de Capa</label>
                                    <input type="file" name="capa" class="form-control" accept="image/*" />
                                    @if (!string.IsNullOrEmpty(Model.ImagemCapa))
                                    {
                                        <img src="@Model.ImagemCapa" class="mt-2 rounded" style="max-height: 80px;" />
                                    }
                                </div>
                            </div>

                            <div class="form-check form-switch mb-2">
                                @* Lista de chamada do dia. Nem todo torneio quer: num interno
                                   de 8 duplas o organizador conhece todo mundo de vista. *@
                                <input class="form-check-input" type="checkbox" name="usaCheckIn" value="true" id="editCheckInSwitch" @(Model.UsaCheckIn ? "checked" : "")>
                                <label class="form-check-label fw-bold" for="editCheckInSwitch">Usar check-in no dia?</label>
                                <div class="small text-muted mb-2">
                                    Lista pra marcar quem já chegou, na quadra. Desligado, o botão some das ferramentas.
                                </div>
                            </div>
                            <div class="form-check form-switch mb-2">
                                @* O MVP do torneio: quando ele acaba, quem jogou elege o melhor
                                   entre os campeões (ver Services/MvpDoTorneio). Nasce LIGADO,
                                   ao contrário do check-in aí em cima — a votação não dá
                                   trabalho nenhum ao organizador, ela abre sozinha depois do
                                   torneio e quem trabalha são os jogadores.

                                   ⚠️ O <input type="hidden" value="false"> não é enfeite: o
                                   parâmetro do servidor é `bool?`, onde NULO quer dizer "aba
                                   aberta antes do deploy, mantenha o que está gravado". Caixa
                                   desmarcada não vai no POST — então, sem este campo escondido,
                                   DESMARCAR seria indistinguível de "formulário antigo" e o
                                   organizador nunca conseguiria DESLIGAR a votação. É o mesmo
                                   par que o `asp-for` gera sozinho; aqui o formulário é escrito
                                   à mão, então ele vai à mão.

                                   ⚠️⚠️ E O ESCONDIDO VEM DEPOIS DA CAIXA, NÃO ANTES. O binder do
                                   ASP.NET lê o PRIMEIRO valor do campo repetido: com o escondido
                                   na frente, o POST manda ["false","true"] e marcar a caixa
                                   DESLIGARIA a votação. Foi assim que eu escrevi da primeira vez
                                   e o navegador pegou — teste de controller não vê isso, porque
                                   ele chama a ação direto e pula o model binding. Esta é
                                   exatamente a ordem que o `asp-for` gera. *@
                                <input class="form-check-input" type="checkbox" name="usaVotacaoDeMvp" value="true" id="editMvpSwitch" @(Model.UsaVotacaoDeMvp ? "checked" : "")>
                                <input type="hidden" name="usaVotacaoDeMvp" value="false" />
                                <label class="form-check-label fw-bold" for="editMvpSwitch">Eleger o MVP do torneio?</label>
                                <div class="small text-muted mb-2">
                                    Quando o torneio acabar, quem jogou vota no melhor entre os campeões —
                                    fica aberto por uma semana. Desligado, a votação some da página (os
                                    votos que já existirem ficam guardados).
                                </div>
                            </div>

                            @* Quem pode marcar o placar (Services/QuemMarcaOPlacar). Editável a
                               qualquer momento — abrir pros jogadores no meio do dia, quando a
                               mesa aperta, é o caso de uso. Formulário escrito à mão como os
                               vizinhos: rádio sempre manda o marcado, sem pegadinha de hidden. *@
                            <label class="form-label fw-bold small mt-2 mb-1">Quem pode marcar o placar dos jogos?</label>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="quemMarcaPlacar" value="Organizacao" id="editMarcaOrganizacao" @(Model.QuemMarcaPlacar == Padelizou.Services.QuemMarcaOPlacar.Organizacao ? "checked" : "")>
                                <label class="form-check-label" for="editMarcaOrganizacao">Só a organização</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="quemMarcaPlacar" value="JogadoresEmQuadra" id="editMarcaEmQuadra" @(Model.QuemMarcaPlacar == Padelizou.Services.QuemMarcaOPlacar.JogadoresEmQuadra ? "checked" : "")>
                                <label class="form-check-label" for="editMarcaEmQuadra">Organização + jogadores em quadra</label>
                            </div>
                            <div class="form-check mb-3">
                                <input class="form-check-input" type="radio" name="quemMarcaPlacar" value="Inscritos" id="editMarcaInscritos" @(Model.QuemMarcaPlacar == Padelizou.Services.QuemMarcaOPlacar.Inscritos ? "checked" : "")>
                                <label class="form-check-label" for="editMarcaInscritos">Qualquer inscrito do torneio</label>
                                <div class="small text-muted">
                                    Em qualquer escolha, W.O., reabrir jogo e trocar quadra continuam só com a organização.
                                </div>
                            </div>

                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" name="permiteImpedimentos" value="true" id="editImpSwitch" onchange="toggleImpedimentosEdicao()" @(Model.PermiteImpedimentos ? "checked" : "")>
                                <label class="form-check-label fw-bold" for="editImpSwitch">Permitir Impedimentos de Horário?</label>
                            </div>
                            <div id="editTurnosImpedimento" class="ps-4 mb-3" style="display: @(Model.PermiteImpedimentos ? "block" : "none");">
                                @* A quinta só vale em torneio que COMEÇA na quinta — num fim de
                                   semana comum seria oferecer um turno que não existe.

                                   Agora que a DATA DE INÍCIO se edita nesta mesma tela, a linha é
                                   desenhada sempre e quem manda nela é o JavaScript, acompanhando o
                                   campo de data: marcar a quinta e só ver a opção depois de salvar
                                   e recarregar seria pedir fé no formulário.

                                   ⚠️ O JS só ESCONDE, nunca desmarca — e nem esconde o que está
                                   marcado. Escondida e desmarcada ela chega como "false", que é o
                                   que já estava gravado; desmarcar sozinho apagaria em silêncio um
                                   impedimento que alguém já marcou e pagou. *@
                                <div class="form-check" id="editLinhaImpQuinta"
                                     style="display: @(Model.QuintaEhDiaDoTorneio ? "block" : "none");">
                                    @* ⚠️ O hidden vem DEPOIS do checkbox: o binder fica com o
                                       PRIMEIRO valor, e com ele na frente marcar valeria
                                       "false". Mesma pegadinha do "só confirmo depois de pago". *@
                                    <input class="form-check-input" type="checkbox" id="editImpQuinta" name="permiteImpedimentoQuintaNoite" value="true" @(Model.PermiteImpedimentoQuintaNoite ? "checked" : "")>
                                    <input type="hidden" name="permiteImpedimentoQuintaNoite" value="false">
                                    <label class="form-check-label" for="editImpQuinta">Quinta à noite</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="permiteImpedimentoSextaNoite" value="true" @(Model.PermiteImpedimentoSextaNoite ? "checked" : "")>
                                    <label class="form-check-label">Sexta à noite</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="permiteImpedimentoSabadoManha" value="true" @(Model.PermiteImpedimentoSabadoManha ? "checked" : "")>
                                    <label class="form-check-label">Sábado de manhã</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="permiteImpedimentoSabadoTarde" value="true" @(Model.PermiteImpedimentoSabadoTarde ? "checked" : "")>
                                    <label class="form-check-label">Sábado à tarde</label>
                                </div>
                            </div>

                            @* TORNEIO RESTRITO — dava pra escolher só na criação, e "esqueci de
                               marcar" obrigava a refazer o torneio inteiro com os inscritos. *@
                            <div class="mb-3 mt-2 border-top pt-3">
                                <div class="form-check form-switch mb-1">
                                    <input class="form-check-input" type="checkbox" name="restrito" value="true"
                                           id="editRestritoSwitch" @(Model.Restrito ? "checked" : "")
                                           onchange="pdzEditarRestrito()">
                                    <label class="form-check-label fw-bold" for="editRestritoSwitch">
                                        <i class="bi bi-key-fill"></i> Torneio restrito (exige chave de acesso pra se inscrever)
                                    </label>
                                </div>
                                <div class="small text-muted">
                                    Só quem tiver a chave consegue se inscrever — você compartilha com quem quiser convidar.
                                    <strong class="d-block mt-1">Torneio restrito não conta pontos pro ranking:</strong>
                                    ele é evento fechado (interno de clube, grupo de amigos), e os jogos, o título e a
                                    participação continuam aparecendo no perfil de quem jogou.
                                </div>

                                <div id="editCampoChave" class="ps-4 mt-2" style="display: @(Model.Restrito ? "block" : "none");">
                                    <label class="form-label small fw-bold mb-1" for="editChaveAcesso">Chave de acesso</label>
                                    <input type="text" class="form-control" id="editChaveAcesso" name="chaveAcessoEscolhida"
                                           maxlength="20" autocomplete="off"
                                           placeholder="@(string.IsNullOrEmpty(Model.ChaveAcesso) ? "deixe vazio pra gerar uma sozinho" : "deixe vazio pra manter a chave atual")" />
                                    <small class="text-muted d-block mt-1">
                                        @if (!string.IsNullOrEmpty(Model.ChaveAcesso))
                                        {
                                            <span>
                                                Chave de agora: <strong>@Model.ChaveAcesso</strong>.
                                                <strong>Campo vazio mantém essa chave</strong> — trocar aqui invalida a que
                                                você já mandou pro grupo.
                                            </span>
                                        }
                                        else
                                        {
                                            <span>
                                                Escolha uma palavra fácil de passar pro grupo (ex.: <em>virgili10</em>), de 4 a 20
                                                letras ou números, sem espaço. Vazio, o sistema sorteia uma.
                                            </span>
                                        }
                                    </small>

                                    @* A caixa "sumir da listagem" morava AQUI e saiu em
                                       18/08/2026: esconder o torneio virou o botão do bloco
                                       "Divulgação", logo acima deste formulário. Ela não podia
                                       ficar por dois motivos — estava presa ao restrito (e
                                       quem precisa esconder é quase sempre o torneio ABERTO
                                       que ainda não foi anunciado), e salvar esta edição
                                       regravava o campo, então mexer no preço publicava o
                                       torneio sem ninguém pedir. *@
                                </div>
                            </div>

                            @* Quem nivela é o Ranking RS. A restrição pelo histórico daqui
                               (RestricaoCategoria) saiu da tela em 06/08/2026 — ver RANKING.md. *@
                            <div class="mb-3 mt-2 border-top pt-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="validarPeloRankingRs" value="true"
                                           id="editRankingRs" @(Model.ValidarPeloRankingRs ? "checked" : "")>
                                    <label class="form-check-label fw-bold" for="editRankingRs">
                                        <i class="bi bi-graph-up-arrow"></i> Conferir as inscrições no @Padelizou.Services.MarcaDoRanking.Nome
                                    </label>
                                </div>
                                <div class="small text-muted mt-2">
                                    Consulta o ranking oficial (@Padelizou.Services.MarcaDoRanking.Site) na hora da inscrição e barra quem
                                    já pontuou numa categoria <strong>mais forte</strong> do que a escolhida.
                                    Quem for barrado aparece aqui embaixo em <strong>"Barrados pelo @Padelizou.Services.MarcaDoRanking.Nome"</strong>,
                                    e <strong>você decide</strong> se mantém ou libera.
                                    Se o ranking estiver fora do ar, a inscrição passa normalmente — ninguém fica travado por isso.
                                </div>

                                @* O que ele GANHA ligando isto — a mesma partial da tela de criação.
                                   Aqui ela importa até mais: quem está editando é quem criou o torneio
                                   com a caixa desmarcada e nunca soube o que estava deixando na mesa. *@
                                <partial name="_VantagensDoRanking" />

                                @* O casamento é POR CATEGORIA e não dá pra adivinhar: "6ª Categoria"
                                   não diz se é masculina ou feminina, e o ranking tem as duas. O
                                   select já vem no palpite quando o nome deixa claro. *@
                                <div class="mt-3 p-3 rounded" style="background-color: var(--pdz-surface-alt);">
                                    <div class="fw-bold small mb-2">Qual categoria do ranking cada uma é?</div>
                                    @foreach (var cat in Model.Categorias.OrderBy(c => c.Nome))
                                    {
                                        var escolhido = cat.RankingRsCategoriaId
                                            ?? Padelizou.Services.CategoriaDoRankingRs.Adivinhar(cat.Nome);
                                        <div class="row g-2 align-items-center mb-2">
                                            <div class="col-5 small text-truncate" title="@cat.Nome">@cat.Nome</div>
                                            <div class="col-7">
                                                <input type="hidden" name="rankingCategoriaId" value="@cat.Id" />
                                                <select class="form-select form-select-sm" name="rankingRsId">
                                                    <option value="0" selected="@(escolhido == null)">Não conferir esta</option>
                                                    @foreach (var item in Padelizou.Services.CategoriaDoRankingRs.Catalogo)
                                                    {
                                                        <option value="@item.Id" selected="@(escolhido == item.Id)">@item.Nome</option>
                                                    }
                                                </select>
                                            </div>
                                        </div>
                                    }
                                    <div class="small text-muted mt-2">
                                        Categoria deixada em <strong>"Não conferir esta"</strong> não é validada.
                                        O ranking <strong>não confere sexo</strong> — se você apontar a categoria errada,
                                        ele responde que está tudo certo do mesmo jeito. Por isso a escolha é sua.
                                    </div>
                                </div>
                            </div>

                            @* Formato das partidas: existia só na CRIAÇÃO, e ninguém acerta o
                               tamanho do jogo antes de saber quanta gente entrou. Agora dá pra
                               ajustar depois — e o valor daqui é o que a Mesa de Controle
                               obedece de verdade (Services/FormatoDaPartida). *@
                            <div class="mb-3 mt-2 border-top pt-3">
                                <label class="form-label fw-bold">
                                    <i class="bi bi-stopwatch"></i> Formato das partidas
                                </label>

                                @* COMO contar os games — vale pro torneio inteiro, nos três
                                   formatos. Editável depois de criado de propósito: no
                                   Americano é comum descobrir o tamanho certo da rodada só
                                   quando se sabe quanta gente veio. *@
                                @{
                                    var contagemAtual = Padelizou.Services.ContagemDeGamesDoTorneio
                                        .Valido(Model.ContagemDeGames);
                                    var ehSoma = contagemAtual == Padelizou.Services.ContagemDeGamesDoTorneio.Soma;
                                }
                                <div class="p-3 rounded mb-3" style="background-color: var(--pdz-surface-alt);">
                                    <div class="fw-bold small mb-2">Como contar os games</div>
                                    <div class="d-flex gap-3 flex-wrap">
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="contagemDeGames"
                                                   value="@Padelizou.Services.ContagemDeGamesDoTorneio.Ate"
                                                   id="editContagemAte" checked="@(!ehSoma)" />
                                            <label class="form-check-label small" for="editContagemAte">
                                                <strong>Até</strong> X — quem chegar primeiro vence
                                            </label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="contagemDeGames"
                                                   value="@Padelizou.Services.ContagemDeGamesDoTorneio.Soma"
                                                   id="editContagemSoma" checked="@ehSoma" />
                                            <label class="form-check-label small" for="editContagemSoma">
                                                <strong>Soma de</strong> X — jogam-se X games no total
                                            </label>
                                        </div>
                                    </div>
                                    <div class="small text-muted mt-2">
                                        Na <strong>soma</strong>, um jogo de 7 fecha sempre em 7 (4x3, 5x2, 7x0…) e
                                        vence quem fizer mais — todo jogo dura o mesmo, que é o que segura a grade.
                                        Prefira número <strong>ímpar</strong>: em soma par dá empate (8 fecha em 4x4)
                                        e o sistema não finaliza jogo empatado.
                                    </div>
                                </div>

                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <div class="p-3 rounded h-100" style="background-color: var(--pdz-surface-alt);">
                                            <div class="fw-bold small mb-2">Fase de grupos</div>
                                            <label class="small text-muted">Sets</label>
                                            <input type="number" min="1" max="5" name="setsFaseGrupos"
                                                   class="form-control form-control-sm mb-2" value="@Model.SetsFaseGrupos" />
                                            <label class="small text-muted">Games por set</label>
                                            <input type="number" min="1" max="99" name="gamesFaseGrupos"
                                                   class="form-control form-control-sm" value="@Model.GamesFaseGrupos" />
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="p-3 rounded h-100" style="background-color: var(--pdz-surface-alt);">
                                            <div class="fw-bold small mb-2">Mata-mata</div>
                                            <label class="small text-muted">Sets</label>
                                            <input type="number" min="1" max="5" name="setsFaseMataMata"
                                                   class="form-control form-control-sm mb-2" value="@Model.SetsFaseMataMata" />
                                            <label class="small text-muted">Games por set</label>
                                            <input type="number" min="1" max="99" name="gamesFaseMataMata"
                                                   class="form-control form-control-sm" value="@Model.GamesFaseMataMata" />
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="p-3 rounded h-100" style="background-color: var(--pdz-surface-alt);">
                                            <div class="fw-bold small mb-2">Semifinais e final</div>
                                            <label class="small text-muted">Sets</label>
                                            <input type="number" min="1" max="5" name="setsFaseFinal"
                                                   class="form-control form-control-sm mb-2" value="@Model.SetsFaseFinal" />
                                            <label class="small text-muted">Games por set</label>
                                            <input type="number" min="1" max="99" name="gamesFaseFinal"
                                                   class="form-control form-control-sm" value="@Model.GamesFaseFinal" />
                                        </div>
                                    </div>
                                </div>
                                <div class="small text-muted mt-2">
                                    É o limite que a <strong>Mesa de Controle</strong> respeita ao marcar o placar.
                                    Mudar aqui vale pros jogos que ainda vão ser marcados — placar já registrado não muda.
                                    "Mata-mata" cobre a primeira rodada, oitavas e quartas.
                                </div>
                            </div>

                            @* Quanto dura um jogo é o que monta a grade inteira — e até agora
                               só dava pra dizer na criação, antes de saber quanta gente vinha. *@
                            <div class="mb-3 mt-2 border-top pt-3">
                                <label class="form-label fw-bold" for="editTempoPartida">
                                    <i class="bi bi-clock-history"></i> Duração e horários dos jogos
                                </label>
                                <div class="row g-3 align-items-start">
                                    <div class="col-md-5">
                                        <div class="input-group">
                                            <input type="number" min="1" max="240" name="tempoPrevistoPartidaMinutos"
                                                   id="editTempoPartida" class="form-control"
                                                   value="@Model.TempoPrevistoPartidaMinutos" />
                                            <span class="input-group-text">min</span>
                                        </div>
                                        <div class="small text-muted mt-1">
                                            É com esse tempo que a grade calcula os horários e a previsão de término.
                                        </div>
                                    </div>
                                    <div class="col-md-7">
                                        <div class="form-check form-switch p-3 rounded" style="background-color: var(--pdz-surface-alt);">
                                            <input class="form-check-input ms-0 me-2" type="checkbox" role="switch"
                                                   name="semHorarioPrevisto" value="true" id="editSemHorario"
                                                   @(Model.SemHorarioPrevisto ? "checked" : "")
                                                   onchange="pdzEditarHorariosDaGrade()">
                                            <label class="form-check-label fw-bold ms-2" for="editSemHorario">
                                                Sem horário previsto (por ordem de liberação)
                                            </label>
                                            <div class="small text-muted mt-1">
                                                Os jogos ficam <strong>numa ordem</strong>, sem hora marcada, e entram
                                                na quadra conforme ela vaga — você chama pela Mesa de Controle.
                                                É como roda a maioria dos internos: ninguém prevê quanto dura um jogo,
                                                e grade que atrasa cedo passa o dia inteiro mentindo.
                                                Ligado, a duração e os horários abaixo deixam de valer.
                                            </div>
                                        </div>
                                    </div>

                                    @* Os mesmos três campos da criação. Antes só dava pra escolher
                                       a janela ANTES de existir torneio — e o horário da quadra é
                                       das primeiras coisas que o clube remarca. Sem isto, corrigir
                                       "na verdade começa às 19h" era refazer o torneio inteiro.

                                       São DUAS aberturas porque o fim de semana tem duas: o
                                       primeiro dia começa à noite (todo mundo trabalha) e os
                                       demais começam cedo. Ver Services/GradeDeJogos. *@
                                    <div class="col-12" id="editHorariosDaGrade"
                                         style="display: @(Model.SemHorarioPrevisto ? "none" : "block");">
                                        <label class="form-label fw-bold small">Horários dos jogos</label>
                                        <div class="row g-2">
                                            <div class="col-6 col-md-4">
                                                <div class="input-group input-group-sm">
                                                    <span class="input-group-text">1º dia</span>
                                                    <input type="time" name="horaInicioDoDia" class="form-control"
                                                           value="@Model.HoraInicioDoDia.ToString(@"hh\:mm")" />
                                                </div>
                                            </div>
                                            <div class="col-6 col-md-4">
                                                <div class="input-group input-group-sm">
                                                    <span class="input-group-text">demais</span>
                                                    <input type="time" name="horaInicioDiasSeguintes" class="form-control"
                                                           value="@Model.HoraInicioDiasSeguintes.ToString(@"hh\:mm")" />
                                                </div>
                                            </div>
                                            <div class="col-12 col-md-4">
                                                <div class="input-group input-group-sm">
                                                    <span class="input-group-text">último jogo até</span>
                                                    <input type="time" name="horaFimDoDia" class="form-control"
                                                           value="@Model.HoraFimDoDia.ToString(@"hh\:mm")" />
                                                </div>
                                            </div>
                                        </div>
                                        <small class="text-muted d-block mt-1">
                                            É a hora em que o último jogo <strong>começa</strong> — ele pode virar a
                                            madrugada. O que não couber no dia vai pro seguinte.
                                            <strong class="d-block">Mudar aqui vale pros jogos que ainda vão ser
                                            marcados</strong> — quem já tem horário sorteado só muda se você sortear
                                            a chave de novo.
                                        </small>
                                    </div>
                                </div>
                            </div>

                            <button type="submit" class="btn btn-padel fw-bold shadow-sm">
                                <i class="bi bi-check-circle-fill"></i> Salvar Alterações
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            @* Com a chave publicada elas sobem pro TOPO da página (o bloco antes das abas);
               até lá o lugar é aqui, no fim do painel — quem ainda não publicou está montando
               o torneio, não operando o dia dele. Um lugar de cada vez, nunca os dois. *@
            @if (!Padelizou.Services.AprovacaoDeChaves.ChavePublicada(Model))
            {
                <partial name="_FerramentasDoOrganizador" model="Model" />
            }

            <!-- NÓS REGISTRAMOS OS RESULTADOS PRA VOCÊ -->
            @{
                var pedidoRegistro = ViewBag.PedidoRegistro as Padelizou.Models.SolicitacaoRegistroResultados;
                var registroHabilitado = ViewBag.RegistroHabilitado == true;
            }
            @if (pedidoRegistro != null || registroHabilitado)
            {
                <div class="card border-0 shadow-sm mt-4 pdz-tinta-azul">
                    <div class="card-body">
                        <h6 class="fw-bold text-uppercase mb-2" style="color: var(--pdz-ink);">
                            🙋 Nós registramos os resultados
                        </h6>

                        @if (pedidoRegistro == null)
                        {
                            <p class="small text-muted mb-2">
                                Mandamos gente ao seu torneio para lançar os jogos na hora. Você cuida
                                do torneio, a gente cuida do sistema.
                            </p>
                            <p class="mb-2">
                                <strong>mais @(((decimal)(ViewBag.RegistroPercentual ?? 5m)).ToString("0.#"))% do valor das inscrições</strong>
                                (além da taxa da forma de recebimento),
                                mínimo de <strong>@(((decimal)(ViewBag.RegistroValorMinimo ?? 500m)).ToString("C"))</strong>.
                                <span class="d-block small text-muted">
                                    O total sai das inscrições reais. Clube longe pode mudar o valor —
                                    confirmamos antes.
                                </span>
                            </p>
                            <form asp-action="SolicitarRegistroResultados" asp-route-id="@Model.Id" method="post">
                                @Html.AntiForgeryToken()
                                <textarea name="observacoes" class="form-control form-control-sm bg-white mb-2" rows="2"
                                          placeholder="Algo que a gente precise saber? (horários reais, distância, seu telefone)"></textarea>
                                <button type="submit" class="btn btn-sm btn-primary rounded-pill">
                                    Verificar disponibilidade
                                </button>
                                <div class="form-text">É um pedido, não uma compra. Nada é cobrado agora.</div>
                            </form>
                        }
                        else
                        {
                            var cor = Padelizou.Services.RegistroDeResultados.CorDoStatus(pedidoRegistro.Status);
                            <p class="mb-2">
                                <span class="badge bg-@cor">@pedidoRegistro.Status</span>
                                <span class="small text-muted ms-1">
                                    pedido em @pedidoRegistro.SolicitadaEm.ToString("dd/MM/yyyy")
                                </span>
                            </p>

                            <p class="small mb-2">
                                @* A régua que o pedido carrega, nunca a atual: pedido de antes de
                                   20/08/2026 foi cotado por jogo e continua valendo o que leu. *@
                                @if (pedidoRegistro.PercentualCotado != null)
                                {
                                    <text>@pedidoRegistro.PercentualCotado.Value.ToString("0.#")% do valor das inscrições,</text>
                                }
                                else
                                {
                                    <text>@pedidoRegistro.PrecoPorJogoCotado.ToString("C") por jogo,</text>
                                }
                                mínimo @pedidoRegistro.ValorMinimoCotado.ToString("C").
                                @if (pedidoRegistro.JogosPrevistos != null)
                                {
                                    <text>Na data do pedido: @pedidoRegistro.JogosPrevistos jogo(s).</text>
                                }
                                <span class="d-block text-muted">
                                    @pedidoRegistro.PessoasSugeridas pessoa(s) por @pedidoRegistro.DiasNaSolicitacao dia(s),
                                    para @pedidoRegistro.QuadrasNaSolicitacao quadra(s).
                                </span>
                            </p>

                            @if (pedidoRegistro.Status == Padelizou.Models.SolicitacaoRegistroResultados.Solicitada)
                            {
                                <p class="small text-muted mb-2">
                                    <i class="bi bi-hourglass-split"></i>
                                    Estamos verificando a disponibilidade e respondemos por aqui.
                                </p>
                            }

                            @if (pedidoRegistro.Status == Padelizou.Models.SolicitacaoRegistroResultados.Confirmada)
                            {
                                <div class="alert alert-success small py-2 mb-2">
                                    <strong>Confirmado:</strong>
                                    @pedidoRegistro.PessoasConfirmadas pessoa(s) por
                                    <strong>@pedidoRegistro.ValorCombinado?.ToString("C")</strong>.
                                </div>
                            }

                            @if (pedidoRegistro.Status == Padelizou.Models.SolicitacaoRegistroResultados.SemDisponibilidade)
                            {
                                <div class="alert alert-secondary small py-2 mb-2">
                                    Não conseguimos equipe para essa data. Você mesmo (ou alguém da sua
                                    organização) pode lançar os resultados — a Mesa de Controle está pronta.
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(pedidoRegistro.Resposta))
                            {
                                <p class="small mb-2"><em>"@pedidoRegistro.Resposta"</em></p>
                            }

                            @if (pedidoRegistro.Status == Padelizou.Models.SolicitacaoRegistroResultados.Solicitada
                              || pedidoRegistro.Status == Padelizou.Models.SolicitacaoRegistroResultados.Confirmada)
                            {
                                <form asp-action="CancelarRegistroResultados" asp-route-id="@Model.Id" method="post"
                                      data-confirmar-tom="perigo"
                                      data-confirmar-titulo="Cancelar o pedido de equipe?"
                                      data-confirmar="Ninguém do Padelizou vai ao seu torneio lançar os jogos. Dá pra pedir de novo depois."
                                      data-confirmar-ok="Cancelar pedido">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-secondary rounded-pill">
                                        Cancelar pedido
                                    </button>
                                </form>
                            }
                        }
                    </div>
                </div>
            }

            @* ── CATEGORIAS ────────────────────────────────────────────────────────────
               Dava pra escolher as categorias só na criação. Quem esquecia a Mista, ou
               abria mais uma quadra e queria abrir mais uma categoria, tinha que criar
               OUTRO torneio — e dividir os inscritos entre os dois.

               Tirar é mais delicado que pôr: categoria com gente dentro guarda inscrição
               de quem já pagou, então a regra fica no servidor (CategoriasDoTorneio) e a
               tela só explica por que o botão não aparece. *@
            <div class="card bg-light border-0 shadow-sm mt-4">
                <div class="card-body">
                    <h6 class="fw-bold text-muted text-uppercase mb-3">Categorias do torneio</h6>

                    <ul class="list-group list-group-flush mb-3">
                        @* Categoria de times fica FORA desta lista: ela tem cartão próprio, e
                           "limite de vagas" não quer dizer nada num torneio de times. *@
                        @foreach (var cat in Model.Categorias.Where(c => !c.DeTimes).OrderBy(c => c.Nome))
                        {
                            var inscritosNaCat = cat.Duplas.Count;
                            <li class="list-group-item bg-transparent px-0">
                                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                                    <span>
                                        <strong style="color: var(--pdz-ink);">@cat.Nome</strong>
                                        <span class="text-muted small ms-1">
                                            @inscritosNaCat inscrito(s)@(cat.LimiteDuplas != null ? $" · limite {cat.LimiteDuplas}" : " · sem limite")
                                        </span>
                                    </span>

                                    <div class="d-flex gap-2 flex-wrap align-items-center">
                                        <form asp-controller="Torneios" asp-action="AtualizarLimiteCategoria" method="post"
                                              class="d-flex gap-1 align-items-center">
                                            <input type="hidden" name="categoriaId" value="@cat.Id" />
                                            <input type="number" name="limiteDuplas" min="1" value="@cat.LimiteDuplas"
                                                   class="form-control form-control-sm" style="width: 96px;" placeholder="Sem limite" />
                                            <button type="submit" class="btn btn-sm btn-outline-secondary">Salvar limite</button>
                                        </form>

                                        @if (Model.Status == "Inscrições Abertas" && inscritosNaCat == 0 && Model.Categorias.Count > 1)
                                        {
                                            <form asp-controller="Torneios" asp-action="RemoverCategoria" method="post"
                                                  data-confirmar-tom="perigo"
                                                  data-confirmar-titulo="Remover a categoria?"
                                                  data-confirmar="A @cat.Nome sai deste torneio. Ela está vazia, então ninguém perde inscrição."
                                                  data-confirmar-ok="Remover categoria">
                                                <input type="hidden" name="categoriaId" value="@cat.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                    <i class="bi bi-trash"></i> Remover
                                                </button>
                                            </form>
                                        }
                                        else if (inscritosNaCat > 0)
                                        {
                                            <span class="small text-muted" title="Tirar a categoria apagaria a inscrição de quem já entrou">
                                                <i class="bi bi-lock-fill"></i> tem inscrito
                                            </span>
                                        }
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>

                    @{
                        var catalogoCats = ViewBag.CatalogoCategorias as List<padelizou.Models.CategoriaPadrao> ?? new();
                        var jaNoTorneio = Model.Categorias.Select(c => c.Nome).ToHashSet();
                        var disponiveis = catalogoCats.Where(c => !jaNoTorneio.Contains(c.Nome)).ToList();
                    }
                    @if (disponiveis.Any())
                    {
                        <form asp-controller="Torneios" asp-action="AdicionarCategoria" method="post"
                              class="d-flex gap-2 flex-wrap align-items-center">
                            <input type="hidden" name="torneioId" value="@Model.Id" />
                            <select name="categoriaPadraoId" class="form-select form-select-sm" style="max-width: 260px;" required>
                                <option value="">-- Adicionar categoria --</option>
                                @foreach (var c in disponiveis)
                                {
                                    <option value="@c.Id">@c.Nome</option>
                                }
                            </select>
                            <input type="number" name="limiteDuplas" min="1" class="form-control form-control-sm"
                                   style="width: 120px;" placeholder="Vagas" title="Limite de duplas (opcional)" />
                            <button type="submit" class="btn btn-sm btn-padel rounded-pill px-3">
                                <i class="bi bi-plus-lg"></i> Adicionar
                            </button>
                        </form>
                    }
                    else
                    {
                        <p class="small text-muted mb-0">Todas as categorias do catálogo já estão neste torneio.</p>
                    }
                </div>
            </div>

            @* CATEGORIA DE TIMES: a tela deixou de OFERECER (decisão do Felipe, 07/08/2026).
               O formulário de criar, e os avisos "só existe no formato padrão" / "o torneio já
               está em andamento", ocupavam um cartão inteiro da gestão de todo torneio comum
               pra um recurso que quase nenhum usa — e quem só queria conferir os inscritos
               passava por ele toda vez.

               ⚠️ Quem JÁ TEM categoria de times continua vendo o cartão e o botão de
               gerenciar: sumir com ele deixaria os times cadastrados sem porta de entrada,
               que é tirar coisa de quem já está usando em vez de parar de oferecer. *@
            @if (Model.Categorias.Any(c => c.DeTimes))
            {
                <div class="card bg-light border-0 shadow-sm mt-4">
                    <div class="card-body">
                        <h6 class="fw-bold text-muted text-uppercase mb-3"><i class="bi bi-people-fill"></i> Categoria de times</h6>
                        @foreach (var catTimes in Model.Categorias.Where(c => c.DeTimes))
                        {
                            <p class="small mb-2">
                                <strong style="color: var(--pdz-ink);">@catTimes.Nome</strong> —
                                @catTimes.Duplas.Count(d => d.NomeTime != null) de @(catTimes.QuantidadeTimes ?? 0) times ·
                                @(catTimes.QuantidadeGrupos ?? 1) grupo(s) · classificam
                                @Padelizou.Services.ClassificacaoDeGrupos.VagasPorGrupo(catTimes)
                            </p>
                        }
                        <a asp-action="Times" asp-route-id="@Model.Id" class="btn btn-sm btn-padel rounded-pill px-3">
                            <i class="bi bi-pencil-square"></i> Gerenciar times e estrutura
                        </a>
                        <div class="small text-muted mt-2">
                            Lá dá pra cadastrar os times e mudar times/grupos/classificados enquanto as chaves não saem.
                        </div>
                    </div>
                </div>
            }

            <!-- GERENCIAR INSCRITOS -->
            <div class="card bg-light border-0 shadow-sm mt-4">
                <div class="card-body">
                    <h6 class="fw-bold text-muted text-uppercase mb-3">Gerenciar Inscritos</h6>
                    @if (Model.Status == "Inscrições Abertas")
                    {
                        <p class="small text-muted">Pra adicionar um novo inscrito, use a aba <strong>Inscreva-se</strong>.</p>
                    }
                    @foreach (var cat in Model.Categorias)
                    {
                        <p class="fw-bold small mb-2 mt-3">@cat.Nome</p>
                        @if (cat.Duplas.Any())
                        {
                            <ul class="list-group list-group-flush mb-2">
                                @foreach (var dupla in cat.Duplas.OrderBy(d => d.EmListaDeEspera).ThenBy(d => d.Id))
                                {
                                    <li class="list-group-item bg-transparent px-0">
                                    @*
                                        UMA linha só, com DOIS filhos: quem está inscrito à esquerda,
                                        a barra de ações à direita. Já foram três filhos num
                                        `justify-content-between`, e por isso as colunas de botão
                                        nunca alinhavam entre as linhas — cada linha distribuía a
                                        sobra de um jeito. Com `ms-auto` num grupo só, os botões
                                        formam coluna de verdade numa lista de 25 inscritos.
                                    *@
                                    <div class="d-flex flex-column flex-lg-row align-items-start align-items-lg-center gap-2">
                                        @* Os selos ficam FORA do bloco que trunca: é o nome que pode
                                           ser comprido demais, e "Não pago" cortado pela metade seria
                                           pior do que nome cortado. *@
                                        <span class="flex-grow-1 d-flex align-items-center gap-2 pdz-inscrito-esquerda">
                                            <span class="pdz-inscrito-nome">
                                                @if (dupla.EhTime)
                                                {
                                                    <span><i class="bi bi-people-fill"></i> @dupla.NomeTime</span>
                                                }
                                                else
                                                {
                                                    <span class="fw-semibold">@dupla.Jogador1.ComoChamar</span>
                                                    @* A barra só existe quando há dois nomes pra separar.
                                                       Solta no fim ("Jeferson Vier/") ela parecia dado
                                                       cortado pela metade. *@
                                                    @if (dupla.Jogador2 != null)
                                                    {
                                                        <span class="text-muted">/</span>
                                                        <span class="fw-semibold">@dupla.Jogador2.ComoChamar</span>
                                                    }
                                                    else
                                                    {
                                                        <em class="text-muted ms-1">procurando parceiro</em>
                                                    }
                                                }
                                            </span>

                                            @* Selos discretos: numa lista de 25 linhas, três badges
                                               saturadas por linha viram uma parede colorida e nenhuma
                                               chama atenção. "Sem parceiro" saiu — dizia de novo o
                                               que o "procurando parceiro" ao lado já diz. *@
                                            @if (dupla.EmListaDeEspera)
                                            {
                                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle flex-shrink-0">Lista de espera</span>
                                            }
                                            @if (Model.PrecoInscricao > 0)
                                            {
                                                @if (dupla.Pago)
                                                {
                                                    <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle flex-shrink-0"
                                                          title="@(dupla.PagoEm?.ToString("dd/MM/yyyy HH:mm"))">
                                                        <i class="bi bi-check-circle"></i> Pago
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger-subtle text-danger-emphasis border border-danger-subtle flex-shrink-0">Não pago</span>
                                                }
                                            }
                                        </span>

                                        @* `text-nowrap` nos BOTÕES é o que impede o "Marcar como pago"
                                           de quebrar no meio dele mesmo — e é ele que resolve isso,
                                           não o `flex-nowrap` da barra.

                                           ⚠️ A BARRA QUEBRA NO CELULAR (`flex-wrap`), e só no desktop
                                           é que ela fica em linha única. Com `flex-nowrap` em toda
                                           largura, a linha de quem está SEM PARCEIRO ganha quatro
                                           botões — "Marcar como pago", "Convidar por link", "Definir
                                           por CPF" e o de remover — que não cabiam nem podiam descer:
                                           medido no Chromium a 390px, a linha ocupava 468px e o
                                           "Definir por CPF" saía pela borda direita da tela. A linha
                                           da dupla COMPLETA tem três botões e cabia, que é por que o
                                           defeito passou despercebido desde 17/08. *@
                                        @* DEFINIR o parceiro que falta vale até a dupla entrar em quadra
                                           (09/09/2026) — e não até as inscrições encerrarem, como TROCAR.
                                           A régua é a mesma que o servidor aplica (JanelaDoParceiro): sem
                                           isso, a tela esconderia o botão que o controller aceitaria.

                                           ⚠️ `duplasQueJaJogaram != null` porque ViewBag é dynamic: sem a
                                           chave, o botão some (seguro) em vez de aparecer onde o servidor
                                           vai recusar. *@
                                        @{
                                            var podeDefinirParceiro = duplasQueJaJogaram != null
                                                && Padelizou.Services.JanelaDoParceiro.MotivoParaNaoDefinir(
                                                        dupla, Model, duplasQueJaJogaram.Contains(dupla.Id)) == null;
                                            @* TROCAR quem já está: aqui, no painel do organizador, a janela é
                                               a MESMA do definir — vale até a bola rolar pra esta dupla. Este
                                               bloco inteiro está sob `ViewBag.PodeGerenciar`, então quem lê
                                               esta linha é sempre organizador, e é a régua dele que vale.

                                               ⚠️ Era `Model.Status == "Inscrições Abertas"`, e foi isso que
                                               deixou o Felipe sem caminho no card do Paulo com a chave do Er
                                               já sorteada. A régua do JOGADOR não mudou — a cópia dela, no
                                               card da própria inscrição lá em cima, segue presa no status. *@
                                            var podeTrocarParceiro = duplasQueJaJogaram != null
                                                && Padelizou.Services.JanelaDoParceiro.MotivoParaOrganizadorNaoTrocar(
                                                        dupla, Model, duplasQueJaJogaram.Contains(dupla.Id)) == null;
                                        }
                                        <div class="d-flex gap-2 flex-wrap flex-lg-nowrap ms-lg-auto pdz-inscrito-acoes">
                                            @* Marcar pago vale em QUALQUER status: muita gente
                                               acerta o Pix depois das inscrições encerradas, e
                                               antes o botão sumia justo nessa hora. A lista
                                               completa pra cobrar está no Financeiro. *@
                                            @if (Model.PrecoInscricao > 0)
                                            {
                                                <form asp-controller="Torneios" asp-action="AlternarPagamentoDupla" method="post">
                                                    <input type="hidden" name="duplaId" value="@dupla.Id" />
                                                    <button type="submit" class="btn btn-sm text-nowrap @(dupla.Pago ? "btn-outline-secondary" : "btn-outline-success")">
                                                        <i class="bi @(dupla.Pago ? "bi-x-circle" : "bi-cash-coin")"></i>
                                                        @(dupla.Pago ? "Marcar não pago" : "Marcar como pago")
                                                    </button>
                                                </form>
                                            }

                                            @* Time não tem parceiro pra convidar nem pra definir: quem monta a
                                               lista é o organizador, na tela de times. Pior que inútil, era
                                               perigoso — o time é gravado como Dupla com Jogador1Id = organizador
                                               (ver TorneiosController.Times), então "Definir por CPF" num time
                                               NÃO dava erro: pendurava um jogador na linha do time, calado. O
                                               controller também recusa; isto aqui é só não oferecer.
                                               (A régua `podeDefinirParceiro` já recusa time e dupla completa.) *@
                                            @if (podeDefinirParceiro)
                                            {
                                                @* Fecha a dupla sem ninguém precisar do CPF do outro — o caminho
                                                   que a maioria vai usar, por isso vem antes do formulário de CPF.
                                                   Contornado, e não preenchido de verde: com 25 duplas sem parceiro
                                                   eram 25 botões berrantes, e destaque que se repete em toda linha
                                                   deixa de ser destaque. *@
                                                <form asp-controller="Duplas" asp-action="GerarConvite" method="post">
                                                    <input type="hidden" name="duplaId" value="@dupla.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-success text-nowrap">
                                                        <i class="bi bi-link-45deg"></i> Convidar por link
                                                    </button>
                                                </form>
                                            }
                                            @if (podeDefinirParceiro || podeTrocarParceiro)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-primary text-nowrap"
                                                        data-bs-toggle="collapse" data-bs-target="#trocaParceiro-@dupla.Id">
                                                    <i class="bi bi-arrow-left-right"></i>
                                                    @(dupla.Completa ? "Trocar parceiro" : "Definir por CPF")
                                                </button>
                                            }
                                            @if (Model.Status == "Inscrições Abertas")
                                            {
                                                @* Só o ícone: "Remover" é a ação que ninguém procura e
                                                   a única sem volta. Escrita por extenso, ela puxava o
                                                   olho em toda linha e ainda era a que mais empurrava
                                                   a barra pra segunda fileira. *@
                                                <form asp-controller="Torneios" asp-action="RemoverDupla" method="post"
                                                      data-confirmar-tom="perigo"
                                                      data-confirmar-titulo="Remover do torneio?"
                                                      data-confirmar="@(dupla.EhTime ? dupla.NomeTime : dupla.Jogador1.NomeNaTela + (dupla.Jogador2 != null ? " e " + dupla.Jogador2.NomeNaTela : "")) sai do torneio e é avisado. Se houver lista de espera, a vaga é oferecida pra próxima."
                                                      data-confirmar-ok="Remover">
                                                    <input type="hidden" name="duplaId" value="@dupla.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                                            title="Remover do torneio" aria-label="Remover @(dupla.EhTime ? dupla.NomeTime : dupla.Jogador1.NomeNaTela) do torneio">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            }

                                            @* Trocar categoria: pra quem inscreveu na errada, ou trocou de
                                               ideia antes do sorteio. Fica FORA do `!dupla.EhTime` de
                                               propósito — time também troca de categoria (entre categorias
                                               de times), só não escolhe parceiro por CPF nem convite por
                                               link, que são coisa de PESSOA se inscrevendo.

                                               ⚠️ O SELECT LISTA TODAS AS OUTRAS CATEGORIAS, sem filtrar
                                               times/chave-direta/sexo aqui — quem confere isso de verdade é
                                               o servidor (TrocarCategoriaDupla), e a mensagem de erro dele
                                               já explica o motivo. Filtrar aqui seria a segunda cópia da
                                               mesma regra, com risco de as duas discordarem um dia. *@
                                            @if (Model.Categorias.Count > 1)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-secondary text-nowrap"
                                                        data-bs-toggle="collapse" data-bs-target="#trocarCategoria-@dupla.Id">
                                                    <i class="bi bi-shuffle"></i> Trocar categoria
                                                </button>
                                            }
                                        </div>
                                    </div>

                                    @* A MESMA condição do botão que abre este collapse: se elas
                                       divergirem, o botão aparece e não abre nada. *@
                                    @if (podeDefinirParceiro || podeTrocarParceiro)
                                    {
                                        <div class="collapse mt-2" id="trocaParceiro-@dupla.Id">
                                            <form asp-controller="Duplas" asp-action="TrocarParceiro" method="post"
                                                  class="bg-white border rounded p-2 pdz-form-parceiro"
                                                  data-categoria="@dupla.CategoriaId">
                                                <input type="hidden" name="duplaId" value="@dupla.Id" />

                                                @* ACHAR PELO NOME. Igual ao da inscrição, e pelo mesmo
                                                   motivo: ninguém sabe o CPF do parceiro de cabeça — o
                                                   organizador, corrigindo a inscrição de outra pessoa,
                                                   menos ainda. Aqui os seletores são CLASSES e não ids
                                                   porque esta caixa se repete uma vez por dupla na
                                                   página; id repetido faria a lista de uma abrir dentro
                                                   da outra. *@
                                                <div class="position-relative mb-2 pdz-bp-caixa">
                                                    <input type="text" class="form-control form-control-sm pdz-bp-campo"
                                                           placeholder="Procure pelo nome ou apelido"
                                                           autocomplete="off" spellcheck="false" />
                                                    <div class="small text-muted mt-1 pdz-bp-dica">
                                                        Digite 3 letras e escolha na lista. Não achou? Preencha o CPF abaixo.
                                                    </div>
                                                    <input type="hidden" name="novoParceiroId" class="pdz-bp-id" />
                                                    <div class="list-group position-absolute w-100 shadow d-none pdz-busca-lista pdz-bp-lista"></div>
                                                </div>

                                                <div class="alert alert-success py-2 px-3 d-none d-flex justify-content-between align-items-center pdz-bp-escolhido">
                                                    <span><i class="bi bi-check-circle-fill"></i> <strong class="pdz-bp-escolhido-nome"></strong></span>
                                                    <button type="button" class="btn btn-sm btn-link text-decoration-none p-0 pdz-bp-trocar">trocar</button>
                                                </div>

                                                <div class="row g-2 align-items-center">
                                                    <div class="col-md-9 pdz-bp-por-cpf">
                                                        <div class="row g-2">
                                                            <div class="col-md-5">
                                                                <input type="text" name="cpfNovoParceiro" class="form-control form-control-sm"
                                                                       placeholder="CPF do parceiro" data-mascara="cpf" inputmode="numeric" required />
                                                            </div>
                                                            <div class="col-md-7">
                                                                <input type="text" name="nomeNovoParceiro" class="form-control form-control-sm"
                                                                       placeholder="Nome (só se ainda não tiver cadastro)" />
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-3">
                                                        <button type="submit" class="btn btn-sm btn-padel w-100">
                                                            <i class="bi bi-check-lg"></i> Confirmar
                                                        </button>
                                                    </div>
                                                </div>

                                                @* A recusa de "esse já está inscrito sozinho" manda MARCAR isto —
                                                   e até aqui a caixa só existia na aba Inscreva-se. O organizador
                                                   lia a instrução no aviso vermelho e não tinha o que marcar: beco
                                                   sem saída na tela, com o servidor pronto pra juntar o tempo todo.
                                                   Nasce escondida porque no caso comum não há nada a juntar; o
                                                   script mostra quando o CPF digitado for de uma inscrição solo. *@
                                                <div class="form-check mt-2 d-none pdz-juntar-caixa">
                                                    <input class="form-check-input" type="checkbox" value="true"
                                                           name="juntarComInscricaoSolo" id="juntar-@dupla.Id" />
                                                    <label class="form-check-label small" for="juntar-@dupla.Id">
                                                        Juntar com a inscrição que já existe
                                                        <span class="text-muted d-block pdz-juntar-quem"></span>
                                                    </label>
                                                </div>

                                                @* ⚠️ ESTE RODAPÉ JÁ MENTIU. Ele dizia "e só enquanto as inscrições
                                                   estão abertas" — encostado num botão que, desde 10/09/2026,
                                                   funciona com a chave já sorteada. Como este bloco é do
                                                   organizador (`ViewBag.PodeGerenciar`), a frase é escrita do
                                                   ponto de vista DELE, e as duas janelas aparecem separadas:
                                                   a dele vai até a dupla entrar em quadra, a de quem está na
                                                   dupla continua presa nas inscrições abertas. *@
                                                <small class="text-muted d-block mt-1">
                                                    Como organizador, você altera até esta dupla entrar em quadra.
                                                    Quem está na dupla só altera enquanto as inscrições estão abertas.
                                                </small>
                                            </form>
                                        </div>
                                    }

                                    @if (Model.Status == "Inscrições Abertas" && Model.Categorias.Count > 1)
                                    {
                                        <div class="collapse mt-2" id="trocarCategoria-@dupla.Id">
                                            <form asp-controller="Torneios" asp-action="TrocarCategoriaDupla" method="post"
                                                  class="bg-white border rounded p-2 d-flex gap-2 align-items-center flex-wrap">
                                                <input type="hidden" name="duplaId" value="@dupla.Id" />
                                                <select name="novaCategoriaId" class="form-select form-select-sm" style="width: auto;" required>
                                                    <option value="" selected disabled>Pra qual categoria?</option>
                                                    @foreach (var outraCategoria in Model.Categorias.Where(c => c.Id != dupla.CategoriaId))
                                                    {
                                                        <option value="@outraCategoria.Id">@outraCategoria.Nome</option>
                                                    }
                                                </select>
                                                <button type="submit" class="btn btn-sm btn-padel">
                                                    <i class="bi bi-check-lg"></i> Mover
                                                </button>
                                            </form>
                                        </div>
                                    }
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="small text-muted">Nenhuma dupla inscrita ainda.</p>
                        }
                    }
                </div>
            </div>
            </fieldset>
        </div>
    }

    @* ── ABA PAGAMENTOS ──────────────────────────────────────────────────────────────────
       Pedido do Felipe (07/09/2026): "criar uma aba para gerenciar melhor os pagamentos,
       impedimentos e cobrar jogador", com uma opção de "cobrar todos os jogadores que não
       pagaram de uma vez".

       Três coisas por dupla que antes viviam espalhadas (ou não existiam em lugar nenhum):
       quem pagou (já em Financeiro/Gerenciar), o impedimento de horário — ATÉ AQUI SÓ DE
       LEITURA, na lista antes do sorteio — e o botão de cobrar (só em Financeiro).

       ⚠️ NÃO REESCREVE O FINANCEIRO. O resumo em R$ e o por-categoria continuam lá; esta aba
       reusa os MESMOS dados que a aba Gerenciar já carrega (`Model.Categorias`), sem
       ViewModel novo — é a mesma dupla, olhada de outro ângulo.

       🔁 REVISTO NO MESMO DIA: a aba abre pra qualquer um que ajuda a organizar
       (`PodeGerenciar`) — o impedimento não é dinheiro, e o servidor já aceitava edição de
       quem ajuda (`EhOrganizadorAsync`, não `PodeVerDinheiro` — ver
       TorneiosController.Inscricoes.cs). Dentro do painel, `gestaoSoLeitura` desliga os
       formulários pra quem só pode OLHAR a gestão (o assistente do sistema que não é
       organizador DESTE torneio) — mesmo `<fieldset disabled>` da aba "Gerenciar Torneio". *@
    @if (ViewBag.PodeGerenciar == true)
    {
        <div class="tab-pane fade" id="pagamentos" role="tabpanel">
            @{
                var gestaoSoLeitura = ViewBag.GestaoSoLeitura == true;
                var duplasPagamento = Model.Categorias
                    .SelectMany(c => c.Duplas.Select(d => new { Categoria = c, Dupla = d }))
                    .Where(x => !x.Dupla.EhTime)
                    .ToList();
                var naoPagaramComCelular = duplasPagamento
                    .Where(x => Model.PrecoInscricao > 0 && !x.Dupla.Pago
                             && Padelizou.Services.WhatsAppLinkHelper.NumeroValido(x.Dupla.Jogador1?.Celular))
                    .ToList();
            }

            @* ── SUB-ABAS (08/09/2026) ────────────────────────────────────────────────────
               🗣️ Felipe: "cria uma outra aba dentro dessa de pagamentos (mude o nome para
               Pagamentos e impedimentos) — colocar por categoria, se vai ter jogos de
               eliminatórias no sabado a noite ainda ou não".

               Mesmo `nav-pills` que _JogosDoTorneio já usa pras sub-abas de Ao Vivo/Agendadas —
               reusado, não inventado, pra que as duas telas se comportem igual no celular. *@
            <ul class="nav nav-pills pdz-pills mb-3" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="pagamentos-lista-tab" data-bs-toggle="tab"
                            data-bs-target="#pagamentosLista" type="button" role="tab">
                        <i class="bi bi-people"></i> Por dupla
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="pagamentos-eliminatorias-tab" data-bs-toggle="tab"
                            data-bs-target="#pagamentosEliminatorias" type="button" role="tab">
                        <i class="bi bi-moon-stars"></i> Eliminatórias
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="pagamentos-quadras-tab" data-bs-toggle="tab"
                            data-bs-target="#pagamentosQuadras" type="button" role="tab">
                        <i class="bi bi-geo-alt"></i> Quadras e sedes
                    </button>
                </li>
            </ul>

            <div class="tab-content">
            <div class="tab-pane fade show active" id="pagamentosLista" role="tabpanel">

            @if (ViewBag.PodeVerDinheiro != true)
            {
                @* Mesmo aviso que Financeiro.cshtml já dá pro ajudante — sem ele, quem não vê
                   dinheiro acharia que os valores e o "Cobrar" sumiram por engano. *@
                <div class="alert alert-info small">
                    <i class="bi bi-info-circle"></i> @Padelizou.Services.AcessoAoDinheiroDoTorneio.ExplicacaoParaQuemAjuda
                </div>
            }

            @* COBRAR TODOS — fila de WhatsApp, um clique de cada vez. Continua sendo O
               ORGANIZADOR mandando, do PRÓPRIO número: o botão só abre, em sequência, os
               mesmos links "Cobrar" que já existem em cada linha (.pdz-cobrar-link) — nada
               de mensagem automática, nada de servidor envolvido. Ver wwwroot/js/cobrar-todos.js.
               Atrás de `PodeVerDinheiro`: a mensagem de cada "Cobrar" leva o VALOR e a chave
               Pix, mesma régua do link individual e do botão de Financeiro.cshtml. *@
            @if (ViewBag.PodeVerDinheiro == true && naoPagaramComCelular.Count > 0)
            {
                @* ⚠️ O NOME DO BOTÃO É O CONSERTO (08/09/2026). Ele se chamava "Cobrar todos
                   (N)" e o Felipe perguntou se mandava sozinho: *"dá a impressão que sim, mas
                   parece que não está enviando"*. Não mandava, nunca mandou — abre UMA conversa
                   por clique, e quem aperta enviar é o organizador. Um botão que promete
                   disparo em massa transforma o funcionamento correto em suspeita de defeito. *@
                <div class="alert alert-warning d-flex flex-wrap gap-2 align-items-center justify-content-between mb-4">
                    <div>
                        <strong><i class="bi bi-whatsapp"></i> @naoPagaramComCelular.Count sem pagar</strong>
                        <div class="small">
                            Abre a conversa de um por vez no seu WhatsApp, com o texto pronto —
                            <strong>você aperta enviar</strong>. Uma de cada vez de propósito:
                            disparo em massa derruba o seu número.
                        </div>
                        @* Fica escondido até o pop-up ser bloqueado. Antes, clique bloqueado não
                           deixava rastro nenhum — o organizador clicava e nada acontecia. *@
                        <div id="pdzCobrarAviso" class="small fw-bold text-danger mt-1 d-none"></div>
                    </div>
                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        @* O id do torneio vai no atributo porque a memória é POR TORNEIO — uma
                           chave só faria a cobrança de um marcar como cobrado o inscrito de outro. *@
                        <button type="button" id="pdzCobrarTodos" data-pdz-torneio="@Model.Id"
                                class="btn btn-success fw-bold shadow-sm">
                            <i class="bi bi-whatsapp"></i> Abrir cobrança 1 de @naoPagaramComCelular.Count
                        </button>
                        @* ⚠️ SEM ISTO A MEMÓRIA VIRA ARMADILHA: a segunda leva de cobrança
                           encontraria o botão desabilitado e nenhum caminho de volta. *@
                        <button type="button" id="pdzCobrarRecomecar"
                                class="btn btn-sm btn-outline-secondary d-none" title="Esquecer quem já foi cobrado">
                            <i class="bi bi-arrow-counterclockwise"></i> Recomeçar
                        </button>
                    </div>
                </div>
            }

            @* RELATÓRIO EM CSV — pedido do Felipe (07/09/2026): "crie um botão com um
               relatório em excel, com nome completo, telefone, se pagou ou não, se tem
               impedimento e quando". Atrás de PodeVerDinheiro, mesma régua do link "Cobrar"
               acima: é o telefone em texto puro na planilha que pede essa régua, não o
               relatório em si (ver RelatorioDuplasCsvTests). *@
            @if (ViewBag.PodeVerDinheiro == true)
            {
                <div class="mb-4">
                    <a asp-action="RelatorioDuplasCsv" asp-route-id="@Model.Id"
                       class="btn btn-outline-secondary fw-bold">
                        <i class="bi bi-file-earmark-spreadsheet"></i> Baixar relatório (CSV)
                    </a>
                </div>
            }

            @* `<fieldset disabled>` desliga TUDO — marcar pago, editar impedimento — de uma vez
               só pra quem só pode OLHAR a gestão. O servidor é quem recusa de verdade
               (EhOrganizadorAsync); isto é só a tela não prometer o que ele não vai aceitar. *@
            <fieldset disabled="@gestaoSoLeitura" class="border-0 p-0 m-0">
            @if (!duplasPagamento.Any())
            {
                <p class="text-muted"><i class="bi bi-info-circle"></i> Nenhum inscrito ainda.</p>
            }
            else
            {
                foreach (var categoriaComDuplas in duplasPagamento.GroupBy(x => x.Categoria).OrderBy(g => g.Key.Nome))
                {
                    <p class="fw-bold small mb-2 mt-3">@categoriaComDuplas.Key.Nome</p>
                    <ul class="list-group list-group-flush mb-2">
                        @foreach (var x in categoriaComDuplas)
                        {
                            var dupla = x.Dupla;
                            var turnoAtual = Padelizou.Services.AlteracaoDeImpedimento.TurnoAtual(dupla);
                            var autoria = Padelizou.Services.AutoriaDoImpedimentoDaDupla.De(dupla);
                            var concentracao = dupla.ConcentrarJogosEm ?? Padelizou.Services.TurnoDeConcentracao.Nenhuma;
                            var conflito = Padelizou.Services.ConcentracaoDeJogos.Conflita(Model, dupla);

                            <li class="list-group-item bg-transparent px-0 py-3">
                                @* ── LINHA 1: quem é a dupla, e o dinheiro ──────────────── *@
                                <div class="d-flex flex-column flex-lg-row align-items-start align-items-lg-center gap-2">
                                    <span class="flex-grow-1 d-flex align-items-center gap-2 flex-wrap pdz-inscrito-esquerda">
                                        <span class="pdz-inscrito-nome">
                                            <span class="fw-semibold">@dupla.Jogador1.ComoChamar</span>
                                            @if (dupla.Jogador2 != null)
                                            {
                                                <span class="text-muted">/</span>
                                                <span class="fw-semibold">@dupla.Jogador2.ComoChamar</span>
                                            }
                                        </span>
                                        @if (Model.PrecoInscricao > 0)
                                        {
                                            if (dupla.Pago)
                                            {
                                                <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle flex-shrink-0">Pago</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger-subtle text-danger-emphasis border border-danger-subtle flex-shrink-0">Não pago</span>
                                            }
                                        }
                                    </span>

                                    <div class="d-flex gap-2 flex-wrap flex-lg-nowrap ms-lg-auto">
                                        @if (Model.PrecoInscricao > 0 && ViewBag.PodeVerDinheiro == true
                                             && !dupla.Pago && Padelizou.Services.WhatsAppLinkHelper.NumeroValido(dupla.Jogador1?.Celular))
                                        {
                                            var textoCobranca = $"Oi {Padelizou.Services.NomeBonito.Curto(dupla.Jogador1!.Nome)}! "
                                                + $"Sua inscrição em {Model.Nome} ({x.Categoria.Nome}) é "
                                                + (dupla.ValorInscricao ?? Model.PrecoInscricao).ToString("C", new System.Globalization.CultureInfo("pt-BR"))
                                                + "."
                                                + (string.IsNullOrWhiteSpace(Model.ChavePixOrganizador) ? "" : $" Pix: {Model.ChavePixOrganizador}");
                                            <a href="@Padelizou.Services.WhatsAppLinkHelper.GerarLink(dupla.Jogador1!.Celular, textoCobranca)"
                                               target="_blank" rel="noopener"
                                               data-pdz-dupla="@dupla.Id"
                                               class="btn btn-sm btn-outline-success text-nowrap pdz-cobrar-link" title="Cobrar no WhatsApp">
                                                <i class="bi bi-whatsapp"></i> Cobrar
                                            </a>
                                        }
                                        @if (Model.PrecoInscricao > 0)
                                        {
                                            <form asp-controller="Torneios" asp-action="AlternarPagamentoDupla" method="post">
                                                <input type="hidden" name="duplaId" value="@dupla.Id" />
                                                <input type="hidden" name="voltarPara" value="Pagamentos" />
                                                <button type="submit" class="btn btn-sm text-nowrap @(dupla.Pago ? "btn-outline-secondary" : "btn-success")">
                                                    <i class="bi @(dupla.Pago ? "bi-x-circle" : "bi-cash-coin")"></i>
                                                    @(dupla.Pago ? "Marcar não pago" : "Marcar como pago")
                                                </button>
                                            </form>
                                        }
                                        <button type="button" class="btn btn-sm btn-outline-primary text-nowrap"
                                                data-bs-toggle="collapse" data-bs-target="#horario-@dupla.Id">
                                            <i class="bi bi-clock-history"></i> Horário
                                        </button>
                                    </div>
                                </div>

                                @* ── LINHA 2: as DUAS coisas de horário, cada uma com o dono ──
                                   🗣️ Reclamação de 09/09/2026: "não consegue ver qual impedimento
                                   foi solicitado pelo usuário, e qual pelo organizador".

                                   Duas etiquetas de cores diferentes, e o texto diz de quem é —
                                   não é ornamento: enquanto era um selo só, o organizador não
                                   tinha como distinguir o pedido que ele PRECISA respeitar do
                                   ajuste que ele mesmo fez. *@
                                @if (turnoAtual != Padelizou.Services.TurnoDoImpedimento.Nenhum
                                     || concentracao != Padelizou.Services.TurnoDeConcentracao.Nenhuma)
                                {
                                    <div class="d-flex gap-2 flex-wrap mt-2">
                                        @if (turnoAtual != Padelizou.Services.TurnoDoImpedimento.Nenhum)
                                        {
                                            <span class="badge rounded-pill bg-warning-subtle text-warning-emphasis border border-warning-subtle fw-normal">
                                                <i class="bi bi-slash-circle"></i>
                                                <strong>Não pode:</strong> @Padelizou.Services.AlteracaoDeImpedimento.Rotulo(turnoAtual)
                                                <span class="opacity-75">· @Padelizou.Services.AutoriaDoImpedimentoDaDupla.Rotulo(autoria)</span>
                                            </span>
                                        }
                                        @if (concentracao != Padelizou.Services.TurnoDeConcentracao.Nenhuma)
                                        {
                                            <span class="badge rounded-pill bg-primary-subtle text-primary-emphasis border border-primary-subtle fw-normal">
                                                <i class="bi bi-pin-map"></i>
                                                <strong>Jogar em:</strong> @Padelizou.Services.ConcentracaoDeJogos.Rotulo(concentracao)
                                                <span class="opacity-75">· posto pelo organizador</span>
                                            </span>
                                        }
                                    </div>
                                }

                                @* ⚠️ AS DUAS PODEM SE CONTRADIZER e a grade cede CALADA — quem
                                   avisa é aqui. Ver ConcentracaoDeJogos.Conflita. *@
                                @if (conflito)
                                {
                                    <div class="alert alert-danger small py-2 px-3 mt-2 mb-0">
                                        <i class="bi bi-exclamation-triangle-fill"></i>
                                        O impedimento e a concentração se cruzam: não sobra horário
                                        possível, e a grade vai marcar onde der. Ajuste um dos dois.
                                    </div>
                                }

                                @* ── O PAINEL: dois formulários, um pra cada dono ──────────── *@
                                <div class="collapse mt-2" id="horario-@dupla.Id">
                                    <div class="border rounded p-3" style="background-color: var(--pdz-surface-alt);">
                                        <div class="row g-3">
                                            <div class="col-md-6">
                                                <label class="form-label fw-bold small mb-1">
                                                    <i class="bi bi-slash-circle text-warning"></i> Não pode jogar
                                                </label>
                                                <p class="text-muted small mb-2">O que o jogador pediu. Cada um custa @Model.TaxaPorImpedimento.ToString("C").</p>
                                                <form asp-controller="Torneios" asp-action="AlterarImpedimentoOrganizador" method="post"
                                                      class="d-flex gap-2 align-items-center flex-wrap">
                                                    <input type="hidden" name="duplaId" value="@dupla.Id" />
                                                    <select name="turno" class="form-select form-select-sm" style="width: auto;">
                                                        <option value="@Padelizou.Services.TurnoDoImpedimento.Nenhum" selected="@(turnoAtual == Padelizou.Services.TurnoDoImpedimento.Nenhum)">Sem impedimento</option>
                                                        <option value="@Padelizou.Services.TurnoDoImpedimento.QuintaNoite" selected="@(turnoAtual == Padelizou.Services.TurnoDoImpedimento.QuintaNoite)">Quinta à noite</option>
                                                        <option value="@Padelizou.Services.TurnoDoImpedimento.SextaNoite" selected="@(turnoAtual == Padelizou.Services.TurnoDoImpedimento.SextaNoite)">Sexta à noite</option>
                                                        <option value="@Padelizou.Services.TurnoDoImpedimento.SabadoManha" selected="@(turnoAtual == Padelizou.Services.TurnoDoImpedimento.SabadoManha)">Sábado de manhã</option>
                                                        <option value="@Padelizou.Services.TurnoDoImpedimento.SabadoTarde" selected="@(turnoAtual == Padelizou.Services.TurnoDoImpedimento.SabadoTarde)">Sábado à tarde</option>
                                                    </select>
                                                    <button type="submit" class="btn btn-sm btn-outline-primary">
                                                        <i class="bi bi-check-lg"></i> Salvar
                                                    </button>
                                                    @if (dupla.Pago && Model.TaxaPorImpedimento > 0)
                                                    {
                                                        <small class="text-muted d-block w-100">
                                                            Inscrição já paga — trocar muda o valor devido, mas não cobra nem estorna sozinho.
                                                        </small>
                                                    }
                                                </form>
                                            </div>

                                            <div class="col-md-6">
                                                <label class="form-label fw-bold small mb-1">
                                                    <i class="bi bi-pin-map text-primary"></i> Pôr os 2 jogos em
                                                </label>
                                                <p class="text-muted small mb-2">Ajuda sua, não taxa: <strong>não cobra nada</strong> e não mexe no que a dupla deve.</p>
                                                <form asp-controller="Torneios" asp-action="AlterarConcentracaoOrganizador" method="post"
                                                      class="d-flex gap-2 align-items-center flex-wrap">
                                                    <input type="hidden" name="duplaId" value="@dupla.Id" />
                                                    <select name="turno" class="form-select form-select-sm" style="width: auto;">
                                                        <option value="@Padelizou.Services.TurnoDeConcentracao.Nenhuma" selected="@(concentracao == Padelizou.Services.TurnoDeConcentracao.Nenhuma)">Onde couber</option>
                                                        <option value="@Padelizou.Services.TurnoDeConcentracao.SextaNoite" selected="@(concentracao == Padelizou.Services.TurnoDeConcentracao.SextaNoite)">Sexta à noite</option>
                                                        <option value="@Padelizou.Services.TurnoDeConcentracao.SabadoManha" selected="@(concentracao == Padelizou.Services.TurnoDeConcentracao.SabadoManha)">Sábado de manhã</option>
                                                        <option value="@Padelizou.Services.TurnoDeConcentracao.SabadoTarde" selected="@(concentracao == Padelizou.Services.TurnoDeConcentracao.SabadoTarde)">Sábado à tarde</option>
                                                    </select>
                                                    <button type="submit" class="btn btn-sm btn-padel">
                                                        <i class="bi bi-check-lg"></i> Salvar
                                                    </button>
                                                    <small class="text-muted d-block w-100">
                                                        Vale só nos jogos de grupo, e cede se a grade apertar.
                                                    </small>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>
                }
            }
            </fieldset>
            </div>

            @* ── SUB-ABA "ELIMINATÓRIAS" ──────────────────────────────────────────────────
               🗣️ Felipe: "por exemplo, a 5a categoria feminina nao pode ter jogo sabado a
               noite, ai passaria para domingo de manha, coisas assim".

               Uma linha por categoria, com UM interruptor. Não há valor nem telefone aqui, então
               não passa por `PodeVerDinheiro`: quem ajuda a organizar decide horário, que é
               exatamente o que a aba toda já faz com o impedimento.

               ⚠️ O interruptor NÃO REMARCA NADA sozinho — só muda o que a PRÓXIMA montagem de
               grade respeita. O aviso embaixo diz isso, porque um organizador que já sorteou e
               não vir o botão "Refazer grade" vai achar que o clique não funcionou. *@
            <div class="tab-pane fade" id="pagamentosEliminatorias" role="tabpanel">
                <p class="text-muted small mb-3">
                    <i class="bi bi-info-circle"></i>
                    Desligue a categoria que <strong>não pode</strong> ter jogo de eliminatória no
                    sábado à noite (da @Padelizou.Services.JanelasDeImpedimento.CorteSabadoTardeNoite.Hours.ToString("00")h
                    em diante). O que não couber cai no dia seguinte, na abertura da manhã.
                    Os jogos da <strong>fase de grupos</strong> não mudam.
                </p>

                <fieldset disabled="@gestaoSoLeitura" class="border-0 p-0 m-0">
                @if (!Model.Categorias.Any())
                {
                    <p class="text-muted"><i class="bi bi-info-circle"></i> Nenhuma categoria cadastrada ainda.</p>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var categoria in Model.Categorias.OrderBy(c => c.Nome))
                        {
                            <li class="list-group-item bg-transparent px-0 d-flex flex-wrap gap-2 align-items-center justify-content-between">
                                <span class="fw-semibold">@categoria.Nome</span>
                                <span class="d-flex align-items-center gap-2 flex-wrap">
                                    @if (categoria.EliminatoriaNoSabadoANoite)
                                    {
                                        <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle">
                                            Pode jogar sábado à noite
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">
                                            <i class="bi bi-moon-stars"></i> Sem eliminatória sábado à noite
                                        </span>
                                    }
                                    <form asp-controller="Torneios" asp-action="AlterarEliminatoriaNoSabado" method="post">
                                        <input type="hidden" name="categoriaId" value="@categoria.Id" />
                                        <input type="hidden" name="permitir" value="@((!categoria.EliminatoriaNoSabadoANoite).ToString().ToLowerInvariant())" />
                                        <button type="submit" class="btn btn-sm text-nowrap @(categoria.EliminatoriaNoSabadoANoite ? "btn-outline-secondary" : "btn-success")">
                                            @(categoria.EliminatoriaNoSabadoANoite ? "Tirar do sábado à noite" : "Liberar sábado à noite")
                                        </button>
                                    </form>
                                </span>
                            </li>
                        }
                    </ul>

                    @if (torneioComecou)
                    {
                        <div class="alert alert-warning small mt-3 mb-0">
                            <i class="bi bi-exclamation-triangle"></i>
                            As chaves deste torneio já saíram — mudar isto <strong>não remarca</strong>
                            os jogos que já estão na grade. Use <strong>Refazer grade</strong>, na aba
                            de jogos, pra aplicar a mudança.
                        </div>
                    }
                }
                </fieldset>
            </div>

            @* ── SUB-ABA "QUADRAS E SEDES" ────────────────────────────────────────────────
               🗣️ Felipe (08/09/2026): "como colocou muita dupla, ele terá q locar um local
               externo ao dele [...] vai ter q por quantos jogos vão para la, ou quais horarios,
               quais categorias [...] isso só vai ser sabido quando formos gerar as chaves,
               talvez naquela aba 'pagamentos e impedimentos'".

               ⚠️ O QUE **NÃO** MORA AQUI: quais clubes o torneio usa e qual quadra fica em qual
               clube continuam em "Gerenciar Torneio" — é lá que as quadras nascem, e a lista de
               sedes é o DISTINCT delas (Services/SedesDoTorneio). Duas telas cadastrando quadra
               seriam duas verdades sobre onde é o torneio.

               O QUE MORA AQUI é o que só se sabe na hora de gerar as chaves: a JANELA do lugar
               alugado, quem pode transbordar pra lá, e o "só um jogo por dupla lá". *@
            <div class="tab-pane fade" id="pagamentosQuadras" role="tabpanel">
                @{
                    var quadrasDoTorneio = (ViewBag.Quadras as List<Padelizou.Models.Quadra>) ?? new();
                    var catalogoDeClubes = (ViewBag.CatalogoClubes as List<Padelizou.Models.Clube>) ?? new();
                    var sedesExtras = quadrasDoTorneio
                        .Where(q => q.ClubeId != null && q.ClubeId != Model.ClubeId)
                        .GroupBy(q => q.ClubeId!.Value)
                        .ToList();
                }

                @* ── O EDITOR DE SEDES, mudado de casa em 08/09/2026 ──────────────────────
                   🗣️ Felipe: "move o editor de sedes pra aba nova".

                   ⚠️ ENDEREÇADO POR **Id**, e não por posição como era no formulário de gestão.
                   Lá o 3º campo de nome andava em par com o 3º select de clube, e isso só era
                   seguro porque os dois viajavam no MESMO POST; separados, duas abas abertas
                   fariam as posições discordarem e o clube da quadra 3 iria parar na quadra 4.

                   ⚠️ E NÃO HÁ MAIS "quais clubes são sede": a sede é o DISTINCT do clube das
                   quadras — Services/SedesDoTorneio diz isso em letras garrafais ("a fonte da
                   verdade é a quadra"). Uma lista de sedes à parte podia ter clube sem quadra
                   nenhuma, ou seja, uma segunda resposta pra "onde eu jogo?". Aqui o organizador
                   diz onde cada quadra fica, e a lista de sedes cai fora disso sozinha — o que
                   também apagou umas 120 linhas de JS que existiam pra manter as duas em par. *@
                <form asp-controller="Torneios" asp-action="AlterarSedesDoTorneio" method="post"
                      class="card shadow-sm border-0 mb-4" id="pdzSedes"
                      data-categorias='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Categorias.OrderBy(c => c.Nome).Select(c => new { id = c.Id, nome = c.Nome, clube = c.ClubeId?.ToString() ?? "" })))'>
                    <div class="card-body">
                        <input type="hidden" name="id" value="@Model.Id" />
                        @* 09/09/2026: nome, local e JANELA de cada quadra passaram a ser editados
                           no planejador (lugar único de quadra — decisão do Felipe). O bloco abaixo
                           continua funcionando por enquanto; a retirada dele é o próximo passo, com
                           os testes de tela desta sub-aba reescritos junto. *@
                        <div class="alert alert-info small py-2 px-3 mb-3 d-flex flex-wrap align-items-center gap-2">
                            <span><i class="bi bi-info-circle"></i> Quadra (nome, local e de que horas até que horas) agora se edita no planejador.</span>
                            <a asp-action="Planejamento" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                <i class="bi bi-calendar-range"></i> Abrir o planejador
                            </a>
                        </div>
                        <h6 class="fw-bold mb-1"><i class="bi bi-geo-alt-fill"></i> Onde cada quadra fica</h6>
                        <p class="text-muted small mb-3">
                            Escolha o clube de cada quadra. O que ficar no clube do torneio é a sede
                            principal; o resto vira local externo — e aparece aqui em cima pra você
                            dizer de que horas até que horas ele é seu.
                        </p>

                        <fieldset disabled="@gestaoSoLeitura" class="border-0 p-0 m-0">
                        @if (!quadrasDoTorneio.Any())
                        {
                            <p class="text-muted small mb-0">
                                <i class="bi bi-info-circle"></i> Nenhuma quadra cadastrada. O nome e a
                                quantidade ficam em <strong>Gerenciar Torneio</strong>; aqui você diz onde
                                cada uma fica.
                            </p>
                        }
                        else
                        {
                            <div class="row g-2 mb-3">
                                @foreach (var quadra in quadrasDoTorneio.OrderBy(q => q.Id))
                                {
                                    <div class="col-md-4 col-6">
                                        <label class="form-label small fw-bold mb-1">@quadra.Nome</label>
                                        @* Valor "id:clube" — o MESMO formato que a categoria já usava
                                           (Services/SedesDoTorneio.LerClubePorQuadra). *@
                                        <select name="clubesQuadras" class="form-select form-select-sm pdz-sede-da-quadra">
                                            <option value="@(quadra.Id):@(Model.ClubeId)" selected="@(quadra.ClubeId == null || quadra.ClubeId == Model.ClubeId)">
                                                @((ViewBag.ClubeDoTorneio as Padelizou.Models.Clube)?.Nome ?? Model.LocalTorneio ?? "Clube do torneio")
                                            </option>
                                            @foreach (var clube in catalogoDeClubes.Where(c => c.Id != Model.ClubeId).OrderBy(c => c.Nome))
                                            {
                                                <option value="@(quadra.Id):@(clube.Id)" selected="@(quadra.ClubeId == clube.Id)">@clube.Nome</option>
                                            }
                                        </select>
                                    </div>
                                }
                            </div>

                            @* ── "Adicionar clube", 08/09/2026 ────────────────────────────────
                               🗣️ Felipe: "permita aqui alterar para 'adicionar clube' nessa parte".

                               O aviso do rodapé desta aba manda pra "Gerenciar Torneio" quem não
                               achou o lugar na lista — só que lá se cadastra QUADRA, não CLUBE. O
                               clube novo não nascia em canto nenhum do caminho, e o organizador
                               voltava pra cá com a mesma lista de antes. O POST é o MESMO das
                               outras três telas que cadastram local (wwwroot/js/adicionar-local.js);
                               o que muda aqui é só onde a opção é pendurada, porque são N selects.

                               ⚠️ `type="button"`: o botão mora DENTRO do <form> das sedes, e o
                               padrão do HTML pra botão sem type é submit — um clique salvaria e
                               recarregaria a página antes de o clube existir, levando junto o que
                               estivesse escolhido e não salvo. *@
                            @* ⚠️ 720px, e não os 520px da primeira versão: nome + quadra + botão somam
                               uns 540px, e o botão caía sozinho pra linha de baixo, entre os campos —
                               virava um controle solto, sem dizer a que fila pertencia. *@
                            <div class="mb-3" style="max-width: 720px;">
                                <label class="form-label small fw-bold mb-1" for="pdzNovoClubeSede">
                                    Não achou o lugar? Cadastre o clube e diga em qual quadra ele fica
                                </label>
                                <div class="d-flex gap-2 flex-wrap">
                                    <input type="text" id="pdzNovoClubeSede" maxlength="80"
                                           class="form-control form-control-sm" placeholder="Nome do clube"
                                           style="min-width: 180px; flex: 1 1 180px;" />
                                    @* ⚠️ SEM `name`: campo sem nome não viaja no POST, e este não pode
                                       viajar — o AlterarSedesDoTorneio lê `clubesQuadras`, e um valor a
                                       mais aqui seria só ruído chegando no servidor. Ele serve pra dizer
                                       ao JavaScript qual seletor de cima receber o clube. *@
                                    <select id="pdzNovoClubeSedeQuadra" class="form-select form-select-sm"
                                            style="max-width: 200px;">
                                        @foreach (var quadra in quadrasDoTorneio.OrderBy(q => q.Id))
                                        {
                                            <option value="@quadra.Id">@quadra.Nome</option>
                                        }
                                    </select>
                                    <button type="button" class="btn btn-sm btn-outline-primary text-nowrap"
                                            onclick="adicionarClubeNasSedes()">
                                        <i class="bi bi-plus-circle"></i> Adicionar clube
                                    </button>
                                </div>
                                @* Opcionais, mas é pela cidade que o local passa a existir pra
                                   qualquer mira geográfica — ver Services/UfDoTorneio. *@
                                <div class="d-flex gap-2 mt-2">
                                    <input type="text" id="pdzNovoClubeSedeCidade" maxlength="80"
                                           class="form-control form-control-sm" placeholder="Cidade (opcional)" />
                                    <input type="text" id="pdzNovoClubeSedeEstado" maxlength="2"
                                           class="form-control form-control-sm text-uppercase"
                                           placeholder="UF" style="max-width: 80px;" />
                                </div>
                                @* O clube entra na lista SEM ficar escolhido, então sem esta linha
                                   o clique não teria efeito visível nenhum e pareceria não funcionar. *@
                                <small id="pdzNovoClubeSedeAviso" class="text-muted d-block mt-1"></small>
                            </div>

                            <div class="mb-3" style="max-width: 320px;">
                                <label class="form-label small fw-bold mb-1" for="pdzMinutosParaTrocarDeClube">
                                    Tempo pra ir de um clube ao outro (min)
                                </label>
                                <input type="number" min="0" max="240" class="form-control form-control-sm"
                                       id="pdzMinutosParaTrocarDeClube" name="minutosParaTrocarDeClube"
                                       value="@Model.MinutosParaTrocarDeClube" />
                                <small class="text-muted d-block mt-1">
                                    Folga entre os jogos de quem disputa duas categorias em clubes diferentes.
                                    Ela CEDE quando respeitá-la deixaria uma quadra vazia. Zero desliga.
                                </small>
                            </div>

                            @* ⚠️ TRAVA DURA, e é o OPOSTO do transbordo lá embaixo: aqui a categoria
                               INTEIRA fica num clube (o jeito do Dez E Batata), inclusive com o
                               horário lotado. As opções são montadas por JS a partir dos selects de
                               cima, pra que a sede escolhida agora já apareça sem salvar duas vezes. *@
                            <label class="form-label small fw-bold mb-1">Em que clube cada categoria joga</label>
                            <p class="small text-muted mb-2">
                                Trava DURA: os jogos da categoria ficam só nas quadras desse clube.
                                <strong>Vale a partir do próximo sorteio</strong> (ou do "refazer grade") —
                                jogo que já tem quadra não muda de lugar sozinho.
                            </p>
                            <div id="pdzSedeDaCategoria" class="table-responsive mb-3"></div>

                            <button type="submit" class="btn btn-padel fw-bold">
                                <i class="bi bi-check-lg"></i> Salvar sedes
                            </button>
                        }
                        </fieldset>
                    </div>
                </form>

                @if (!sedesExtras.Any())
                {
                    @* Sem segunda sede não há o que configurar aqui — e o caminho de ir criar
                       uma é a aba de gestão, não esta. Dizer isso é melhor que uma tela vazia. *@
                    <div class="alert alert-info small mb-0">
                        <i class="bi bi-info-circle"></i>
                        Este torneio joga só na sede principal. Pra alugar um local externo, ligue
                        <strong>"Este torneio acontece em mais de um clube"</strong> em
                        <strong>Gerenciar Torneio</strong> e cadastre as quadras de lá — depois volte
                        aqui pra dizer <strong>de que horas até que horas</strong> o lugar é seu.
                    </div>
                }
                else
                {
                    <fieldset disabled="@gestaoSoLeitura" class="border-0 p-0 m-0">
                    <p class="text-muted small mb-3">
                        <i class="bi bi-clock"></i> O local alugado costuma vir por hora. Diga a janela,
                        e a grade para de marcar jogo lá fora dela — quantos jogos cabem é conta, não palpite.
                    </p>

                    @foreach (var sede in sedesExtras)
                    {
                        var nomeDaSede = catalogoDeClubes.FirstOrDefault(c => c.Id == sede.Key)?.Nome ?? "Local externo";
                        var primeira = sede.First();
                        var cabem = Padelizou.Services.SedesDoTorneio.JogosQueCabemNaJanela(
                            sede.Count(), primeira.DisponivelDe, primeira.DisponivelAte,
                            Model.TempoPrevistoPartidaMinutos);

                        <div class="card shadow-sm border-0 mb-3">
                            <div class="card-body">
                                <h6 class="fw-bold mb-1"><i class="bi bi-geo-alt-fill"></i> @nomeDaSede</h6>
                                <p class="text-muted small mb-3">
                                    @sede.Count() quadra(s): @string.Join(", ", sede.Select(q => q.Nome))
                                </p>

                                @* A janela vale pras quadras TODAS deste clube: é o lugar que está
                                   alugado das 8h às 12h, não uma quadra dele. *@
                                <form asp-controller="Torneios" asp-action="AlterarJanelaDaSede" method="post"
                                      class="row g-2 align-items-end">
                                    <input type="hidden" name="torneioId" value="@Model.Id" />
                                    <input type="hidden" name="clubeId" value="@sede.Key" />
                                    <div class="col-sm-5">
                                        <label class="form-label fw-bold small mb-1">Disponível de</label>
                                        <input type="datetime-local" name="de" class="form-control form-control-sm"
                                               value="@primeira.DisponivelDe?.ToString("yyyy-MM-ddTHH:mm")" />
                                    </div>
                                    <div class="col-sm-5">
                                        <label class="form-label fw-bold small mb-1">até</label>
                                        <input type="datetime-local" name="ate" class="form-control form-control-sm"
                                               value="@primeira.DisponivelAte?.ToString("yyyy-MM-ddTHH:mm")" />
                                    </div>
                                    <div class="col-sm-2 d-grid">
                                        <button type="submit" class="btn btn-sm btn-padel">
                                            <i class="bi bi-check-lg"></i> Salvar
                                        </button>
                                    </div>
                                </form>

                                @if (cabem is int quantos)
                                {
                                    <div class="alert alert-success small mt-3 mb-0">
                                        <i class="bi bi-calculator"></i>
                                        Nessa janela cabem cerca de <strong>@quantos jogos</strong>
                                        (@sede.Count() quadra(s) × jogos de @Model.TempoPrevistoPartidaMinutos min).
                                    </div>
                                }
                                else
                                {
                                    <p class="text-muted small mt-3 mb-0">
                                        <i class="bi bi-info-circle"></i> Sem janela: por enquanto essas quadras
                                        valem o expediente inteiro do torneio.
                                    </p>
                                }
                            </div>
                        </div>
                    }

                    @* 🗣️ "eles não querem q a dupla jogue os 2 jogos la, que jogue apenas um, para
                       que ele possa jogar no clube dele também". A palavra é EVITA, e não
                       garante: a regra cede se não houver outro jogo pra pôr na vaga — quadra
                       parada no lugar que se está pagando por hora é o que ninguém aceita. *@
                    <form asp-controller="Torneios" asp-action="AlterarEvitarDoisJogosNaSedeExtra"
                          method="post" class="card shadow-sm border-0 mb-3">
                        <div class="card-body d-flex flex-wrap gap-2 align-items-center justify-content-between">
                            <div>
                                <div class="fw-bold small">
                                    @(Model.EvitarDoisJogosNaSedeExtra
                                        ? "A dupla joga no máximo UM jogo no local externo"
                                        : "A dupla pode ter os 2 jogos no local externo")
                                </div>
                                <div class="text-muted small">
                                    Evita, não garante: se não sobrar outro jogo pra pôr na vaga, o segundo entra lá.
                                </div>
                            </div>
                            <input type="hidden" name="id" value="@Model.Id" />
                            <input type="hidden" name="evitar" value="@((!Model.EvitarDoisJogosNaSedeExtra).ToString().ToLowerInvariant())" />
                            <button type="submit" class="btn btn-sm text-nowrap @(Model.EvitarDoisJogosNaSedeExtra ? "btn-outline-secondary" : "btn-success")">
                                @(Model.EvitarDoisJogosNaSedeExtra ? "Deixar os 2 lá" : "Só um jogo por dupla lá")
                            </button>
                        </div>
                    </form>

                    @* Quais categorias transbordam. ⚠️ Não é o clube FIXO da categoria (esse fica
                       em Gerenciar Torneio e PRENDE a categoria inteira num lugar) — é a régua
                       mole: a sede principal enche, e quem está marcado aqui aceita ir pro
                       alugado. Categoria com clube fixo já está presa e não olha pra isto. *@
                    <p class="fw-bold small mb-2">Quem pode ir pro local externo</p>
                    <ul class="list-group list-group-flush">
                        @foreach (var categoria in Model.Categorias.OrderBy(c => c.Nome))
                        {
                            <li class="list-group-item bg-transparent px-0 d-flex flex-wrap gap-2 align-items-center justify-content-between">
                                <span class="fw-semibold">@categoria.Nome</span>
                                @if (categoria.ClubeId != null)
                                {
                                    <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle">
                                        Já tem clube fixo (Gerenciar Torneio)
                                    </span>
                                }
                                else
                                {
                                    <span class="d-flex align-items-center gap-2 flex-wrap">
                                        @if (categoria.PodeJogarNaSedeExtra)
                                        {
                                            <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle">Pode transbordar</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">Só na sede principal</span>
                                        }
                                        <form asp-controller="Torneios" asp-action="AlterarTransbordoDaCategoria" method="post">
                                            <input type="hidden" name="categoriaId" value="@categoria.Id" />
                                            <input type="hidden" name="permitir" value="@((!categoria.PodeJogarNaSedeExtra).ToString().ToLowerInvariant())" />
                                            <button type="submit" class="btn btn-sm text-nowrap @(categoria.PodeJogarNaSedeExtra ? "btn-outline-secondary" : "btn-success")">
                                                @(categoria.PodeJogarNaSedeExtra ? "Tirar do externo" : "Deixar ir")
                                            </button>
                                        </form>
                                    </span>
                                }
                            </li>
                        }
                    </ul>

                    @if (torneioComecou)
                    {
                        <div class="alert alert-warning small mt-3 mb-0">
                            <i class="bi bi-exclamation-triangle"></i>
                            As chaves deste torneio já saíram — nada aqui <strong>remarca</strong> jogo
                            sozinho. Use <strong>Refazer grade</strong>, na aba de jogos, pra aplicar.
                        </div>
                    }
                    </fieldset>
                }
            </div>
            </div>
        </div>
    }
    <!-- ABA: PLANEJAMENTO DE QUADRAS — só o resumo; a conta que se gira está em Torneios/Planejamento -->
    @if (ViewBag.PodeGerenciar == true)
    {
        <div class="tab-pane fade" id="planejamento" role="tabpanel">
            @{ var ptBrPlan = System.Globalization.CultureInfo.GetCultureInfo("pt-BR"); }
            <h4 class="mb-1 fw-bold" style="color: var(--pdz-ink);">
                <i class="bi bi-calendar-range"></i> Planejamento de quadras
            </h4>
            <p class="text-muted small mb-3">
                Quantos jogos cabem em cada dia, e quanta quadra falta pra fechar o fim de semana.
            </p>

            @if (ViewBag.PlanejamentoResumo is Padelizou.Services.PlanejamentoDeQuadras.Plano plano)
            {
                <div class="row g-2 mb-3">
                    <div class="col-6 col-md-3">
                        <div class="p-3 rounded h-100" style="background-color: var(--pdz-surface-alt);">
                            <div class="small text-muted">Jogos</div>
                            <div class="fs-4 fw-bold">@plano.TotalDeJogos</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="p-3 rounded h-100" style="background-color: var(--pdz-surface-alt);">
                            <div class="small text-muted">Quadras</div>
                            <div class="fs-4 fw-bold">@plano.Quadras</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="p-3 rounded h-100" style="background-color: var(--pdz-surface-alt);">
                            <div class="small text-muted">Cabem</div>
                            <div class="fs-4 fw-bold">@plano.Vagas</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="p-3 rounded h-100" style="background-color: var(--pdz-surface-alt);">
                            <div class="small text-muted">@(plano.Faltam > 0 ? "Faltam" : "Sobram")</div>
                            <div class="fs-4 fw-bold @(plano.Faltam > 0 ? "text-danger" : "")">
                                @(plano.Faltam > 0 ? plano.Faltam : plano.Sobram)
                            </div>
                        </div>
                    </div>
                </div>

                @* A pergunta literal do pedido — "quantos jogos na sexta, e no sábado" —
                   respondida já na aba. Sem isto ela seria um link com números soltos. *@
                @foreach (var dia in plano.Dias.Where(d => d.Jogos > 0))
                {
                    <span class="badge rounded-pill me-1 mb-1" style="background-color: var(--pdz-navy-fixed); color: var(--padel-green);">
                        @dia.Data.ToString("ddd dd/MM", ptBrPlan): @dia.Jogos @(dia.Jogos == 1 ? "jogo" : "jogos")
                    </span>
                }

                @if (plano.Faltam > 0)
                {
                    <div class="alert alert-danger py-2 px-3 mt-3">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <strong>@plano.Faltam @(plano.Faltam == 1 ? "jogo não cabe" : "jogos não cabem")</strong>
                        no prazo do torneio. Saídas: alugar <strong>@plano.HorariosExtras @(plano.HorariosExtras == 1 ? "horário" : "horários")</strong>
                        de quadra, ou passar a <strong>@plano.QuadrasNecessarias quadras</strong>.
                    </div>
                }
                else if (plano.UltimoJogoTermina != null)
                {
                    <div class="alert alert-success py-2 px-3 mt-3">
                        <i class="bi bi-check-circle-fill"></i>
                        Cabe — o último jogo termina
                        <strong>@plano.UltimoJogoTermina.Value.ToString("dddd dd/MM 'às' HH:mm", ptBrPlan)</strong>.
                    </div>
                }
            }
            else
            {
                <div class="alert alert-info py-2 px-3">
                    <i class="bi bi-info-circle-fill"></i>
                    Ainda não há jogos pra contar neste torneio — abra o planejador e simule um número
                    pra ver quanta quadra o fim de semana pede.
                </div>
            }

            <a asp-action="Planejamento" asp-route-id="@Model.Id" class="btn btn-primary rounded-pill px-4">
                <i class="bi bi-sliders"></i> Abrir o planejador
            </a>
            <p class="small text-muted mt-2 mb-0">
                Lá dá pra mudar horário de início, hora de fechar de cada dia, número de quadras e
                duração do jogo — e ver o que muda, sem gravar nada.
            </p>
        </div>
    }

    <!-- ABA: JOGOS (Ao Vivo/Agendadas/Finalizadas unificados) -->
    @if (torneioComecou)
    {
        <div class="tab-pane fade show active" id="jogosDoTorneio" role="tabpanel">
            <partial name="_JogosDoTorneio" model='("Details", Model.Id)' />
        </div>

        <!-- ABA: PONTOS POR TIME (neste torneio) — nunca no Americano, ver a aba lá em cima -->
        <div class="tab-pane fade @(Padelizou.Services.FormatoDoTorneio.EhAmericano(Model.Formato) ? "d-none" : "")" id="timesTorneio" role="tabpanel">
            <h4 class="mb-1 fw-bold" style="color: var(--pdz-ink);"><i class="bi bi-shield-fill"></i> Pontos por time</h4>
            <p class="text-muted small mb-3">Quanto cada time somou neste torneio — os pontos das duplas vão para o time que cada jogador representa.</p>
            @if (!pontosTimes.Any())
            {
                <p class="text-muted"><i class="bi bi-info-circle"></i> Nenhum jogador com time pontuou neste torneio ainda.</p>
            }
            else
            {
                <div class="card shadow-sm border-0"><div class="table-responsive"><table class="table table-hover align-middle mb-0">
                    <thead><tr><th class="text-center" style="width:56px;">#</th><th>Time</th><th class="text-center">Jogadores</th><th class="text-end pe-3">Pontos</th></tr></thead>
                    <tbody>
                        @{ var posTt = 1; }
                        @foreach (var pt in pontosTimes)
                        {
                            <tr>
                                <td class="text-center fw-bold text-muted">@(posTt)º</td>
                                <td class="fw-bold" style="color: var(--pdz-ink);">
                                    @if (!string.IsNullOrEmpty(pt.Logo))
                                    {
                                        <img src="@pt.Logo" alt="" class="rounded me-1" style="width:24px;height:24px;object-fit:contain;vertical-align:middle;" />
                                    }
                                    else
                                    {
                                        <i class="bi bi-shield-fill text-secondary me-1"></i>
                                    }
                                    @pt.Time
                                </td>
                                <td class="text-center text-muted">@pt.Jogadores</td>
                                <td class="text-end pe-3 fw-bold" style="color: var(--pdz-ink);">@pt.Pontos</td>
                            </tr>
                            posTt++;
                        }
                    </tbody>
                </table></div></div>
            }
        </div>
    }
    <!-- ABA: PALPITEIROS (ranking do Palpitrômetro) -->
    @if (ViewBag.TemRankingDePalpiteiros == true)
    {
        <div class="tab-pane fade" id="palpiteiros" role="tabpanel">
            <partial name="_RankingDePalpiteiros" model="(Padelizou.Services.PalpiteirosDoTorneio)ViewBag.RankingDePalpiteiros" />

            @* A ÚNICA porta pra página cheia desde que o botão do topo saiu (10/09/2026). Ela
               não é enfeite: é o endereço que se manda no grupo do WhatsApp, e o parcial acima
               foi extraído justamente pra ela poder "ser aberta direto de um link". Aqui
               embaixo ela não custa nada a quem só quer ver o ranking, e está à mão de quem
               quer o link — que é a mesma pessoa. *@
            <div class="text-center mt-3">
                <a asp-action="Palpiteiros" asp-route-id="@Model.Id" class="small text-muted">
                    <i class="bi bi-box-arrow-up-right"></i> Abrir em página própria (pra mandar no grupo)
                </a>
            </div>
        </div>
    }
    <!-- ABA: CHAVES E GRUPOS -->
    <div class="tab-pane fade" id="grupos" role="tabpanel">
      @* Chave pendente de aprovação (ver Services/AprovacaoDeChaves) não pode aparecer aqui
         pra quem não pode aprovar — esconder só o BOTÃO da aba (lá em cima) não bastaria: o
         HTML desta aba sai no mesmo jeito na resposta, só invisível por CSS, e daria pra ver
         com "exibir código-fonte" mesmo sem o botão. *@
      @if (podeVerChavesPendentes)
      {
        // O Americano não tem CHAVE — ele tem GRUPOS e uma classificação por games. Sem
        // isto a aba abria vazia num torneio inteiro em andamento: o motor não cria
        // GrupoTorneio nesse formato, então o laço das categorias lá embaixo não achava
        // nada pra desenhar e a tela não dizia sequer por quê.
        var americanoAqui = ViewBag.ClassificacaoAmericano
            as List<Padelizou.ViewModels.ClassificacaoAmericanaDaCategoriaVM>;

        @if (americanoAqui != null)
        {
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="mb-0 fw-bold" style="color: var(--pdz-ink);">
                    <i class="bi bi-layout-split"></i> Grupos e Classificação
                </h4>
            </div>

            @foreach (var daCategoria in americanoAqui)
            {
                @if (americanoAqui.Count > 1)
                {
                    <h5 class="fw-bold mt-3 mb-2" style="color: var(--pdz-ink);">@daCategoria.Categoria</h5>
                }
                <partial name="_ClassificacaoDoAmericano" model="daCategoria" />
            }
        }
        else
        {
        // (Já estamos dentro do bloco de código do `else`: daqui as declarações vão soltas, sem `@{`.)
        //
        // Categoria aparece nesta seção quando já tem chave pra mostrar: grupos
        // sorteados OU chave direta (que nunca terá grupo, só o mata-mata puro —
        // sem isto ela não ganhava aba nenhuma e a chave dela ficava invisível).
        //
        // ⚠️ UMA RÉGUA SÓ, e é esta: o seletor lá embaixo escolhe entre as categorias desta
        // lista e os painéis são desenhados pelo MESMO predicado. Duas contas de "quem entra
        // na tela" dariam opção sem painel (escolher e não ver nada) ou painel sem opção
        // (chave que existe e ninguém alcança).
        Func<Padelizou.Models.Categoria, bool> temChaveParaMostrar = c =>
            (c.GruposTorneio != null && c.GruposTorneio.Any()) || c.ChaveDireta;

        // ⚠️ NA ORDEM DE TELA DO SITE (`CategoriaNaTela.Ordem`), e não na de criação: 🗣️ Felipe,
        // vendo o seletor no ar, *"esta fora de ordem"*. O `Include` do controller devolve as
        // categorias na ordem do BANCO, e o seletor herdou isso das pills — que já vinham assim.
        // A régua é a de lá, e não uma conta local: duas ordens pra mesma lista fariam esta tela
        // discordar das outras. (Foi esta queixa que virou a ordem daquela régua de cabeça pra
        // baixo no mesmo dia — os níveis agora andam juntos, em vez de agrupados por sexo.)
        var comChave = Model.Categorias.Where(temChaveParaMostrar)
            .OrderBy(c => Padelizou.Services.CategoriaNaTela.Ordem(c.Nome)).ToList();

        // A categoria que a aba ABRE: a do jogador que está olhando, a melhor delas se estiver
        // em duas (🗣️ *"se estiver em duas, vem na melhor delas 1>2>3>4"*). O porquê e os
        // empates moram no Services/CategoriaQueAbre.
        var categoriaQueAbre = Padelizou.Services.CategoriaQueAbre.Escolher(comChave, meuIdNaPagina);

        <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap mb-4">
            @* "Chaves e Grupos", como a aba: o título dizia "Fase de Grupos" em cima
               de uma tela que também mostra a chave — e numa chave direta (sem grupo
               nenhum) virava mentira. *@
            <h4 class="mb-0 fw-bold" style="color: var(--pdz-ink);">
                <i class="bi bi-layout-split"></i> Chaves e Grupos
            </h4>

            @* ── A ESCOLHA DA CATEGORIA (10/09/2026) ───────────────────────────────────
               🗣️ Felipe, no 2ª Etapa ER Padel Tour, 7 categorias: *"visualmente nao ta legal
               isso aqui tambem, acho que um drop com select seria melhor, não?"*.

               Era a barra `.pdz-pills`, e ela está CERTA pro que foi desenhada: 3-4 abas fixas,
               onde `flex: 1 1 auto` (site.css) preenche a linha e não sobra buraco. Numa lista
               de tamanho VARIÁVEL o mesmo acerto vira defeito — a sétima categoria caía sozinha
               na segunda linha e esticava pela largura inteira, virando uma faixa verde que
               parece título, não aba escolhida. Com as 12 categorias que o ER já teve, eram
               quatro linhas de botão antes do primeiro grupo. Por isso quem muda é ESTA lista,
               e não o `.pdz-pills`, que continua servindo as abas fixas.

               `<select>` nativo, degrau 4 da escada do CLAUDE.md: no celular quem abre é o
               seletor do próprio sistema, que rola sozinho — a lista cresce sem tomar a tela,
               e some a conta de "quantas cabem por linha". *@
            @if (comChave.Count > 1)
            {
                <select class="form-select fw-bold w-auto mw-100" id="seletorDeCategoria"
                        data-torneio-id="@Model.Id" aria-label="Escolher a categoria">
                    @foreach (var categoria in comChave)
                    {
                        <option value="cat-@(categoria.Id)" selected="@(categoria.Id == categoriaQueAbre?.Id ? "selected" : null)">@categoria.Nome</option>
                    }
                </select>
            }
            else if (comChave.Count == 1)
            {
                @* Uma categoria só: o select seria um controle que não escolhe nada. O nome
                   fica, porque é ele que diz de quem é a chave desenhada logo abaixo. *@
                <span class="fw-bold" style="color: var(--pdz-ink);">@comChave[0].Nome</span>
            }
        </div>

        <!-- CONTEÚDO DOS GRUPOS POR CATEGORIA -->
        <div class="tab-content" id="painelDasCategorias">
            @foreach (var categoria in Model.Categorias)
            {
                if (temChaveParaMostrar(categoria))
                {
                    ViewData["CategoriaAtual"] = categoria.Nome;
                    @* Aceso é o painel da categoria que ABRE — antes era sempre o primeiro da
                       lista, o que agora nem seria o mesmo que a <option> escolhida lá em cima. *@
                    <div class="tab-pane fade @(categoria.Id == categoriaQueAbre?.Id ? "show active" : "")" id="cat-@(categoria.Id)" role="region" aria-label="@categoria.Nome">
                        <!-- O cruzamento mata-mata é gerado automaticamente (TorneiosController.ProcessarMataMataAutomatico)
                             assim que a última partida da Fase de Grupos dessa categoria é finalizada — sem botão manual. -->
                        @{
                            // Chaveamento REAL desta categoria (ViewBag preenchido no controller).
                            // Calculado AQUI em cima porque a ordem visual depende dele.
                            var mataMataDict = ViewBag.MataMataPorCategoria as Dictionary<int, List<Padelizou.Models.Partida>>;
                            var jogosMata = (mataMataDict != null && mataMataDict.ContainsKey(categoria.Id))
                                ? mataMataDict[categoria.Id] : new List<Padelizou.Models.Partida>();

                            @* "Primeira Rodada" é o quadro de 32 da CHAVE DIRETA (24 duplas com
                               bye, por exemplo). Sem ela aqui, a rodada de abertura existiria no
                               banco e na Mesa, mas sumiria do desenho da chave. *@
                            var ordemFases = new[] { Padelizou.Services.ChaveamentoMataMata.PrimeiraRodada,
                                                     "Oitavas de Final", "Quartas de Final", "Semifinal", "Final" };
                            var fasesPresentes = ordemFases.Where(f => jogosMata.Any(p => p.Fase == f)).ToList();
                            bool chaveJaComecou = fasesPresentes.Any();
                            bool temGrupos = categoria.GruposTorneio.Any();
                        }

                        @* Com o mata-mata em andamento a CHAVE vem primeiro (order do flex,
                           sem duplicar markup): é ela que está em jogo — pra vê-la no celular
                           rolava-se TODOS os grupos, que a essa altura são história. *@
                        <div class="d-flex flex-column">
                        @if (temGrupos)
                        {
                        <div style="order: @(chaveJaComecou ? 2 : 1);" class="@(chaveJaComecou ? "mt-4 pt-3 border-top" : "")">
                        <h4 class="fw-bold mb-3" style="color: var(--pdz-ink);">
                            <i class="bi bi-grid-3x3-gap-fill me-2" style="color: var(--padel-green);"></i> Fase de Grupos
                        </h4>

                        @* TROCAR DUAS DUPLAS DE GRUPO (09/09/2026, pedido do Felipe). Fica AQUI,
                           e não no painel de aprovação lá em cima, porque é olhando os grupos que
                           se decide mover alguém — e aqui os selects saem de `categoria.GruposTorneio`,
                           que já está na mão, sem uma consulta a mais.

                           ⚠️ Só enquanto a chave espera aprovação e só pra quem aprova: é a mesma
                           régua do "Desfazer sorteio", e a ação recusa de novo do lado de lá
                           (esconder botão não é autorização). *@
                        @if (Model.Status == Padelizou.Services.AprovacaoDeChaves.Pendente
                             && ViewBag.PodeAprovarChaves == true)
                        {
                            <div class="card border-0 shadow-sm mb-4" style="background: var(--bs-tertiary-bg, #f8f9fa);">
                                <div class="card-body">
                                    <h6 class="fw-bold text-muted text-uppercase mb-1">
                                        <i class="bi bi-arrow-left-right"></i> Trocar duas duplas de grupo
                                    </h6>
                                    <p class="small text-muted mb-3">
                                        As duas trocam de lugar entre si — os grupos continuam do mesmo tamanho.
                                        Você escolhe o que fazer com os horários.
                                    </p>
                                    @* Refazer os horários virou ESCOLHA (rádio abaixo) — ver o porquê em
                                       TorneiosController.TrocarDuplasDeGrupo. O confirm fala dos DOIS caminhos:
                                       afirmar "recalcula tudo" quando talvez não recalcule seria pior que calar. *@
                                    @* ⚠️ O CHAVEAMENTO À MÃO fica logo abaixo deste bloco (procure por
                                       SalvarCruzamento): as duas coisas se decidem olhando os mesmos grupos. *@
                                    <form asp-controller="Torneios" asp-action="TrocarDuplasDeGrupo" method="post"
                                          class="row g-2 align-items-end"
                                          data-confirmar-titulo="Trocar as duas de grupo?"
                                          data-confirmar="Os confrontos dos dois grupos mudam. Se você escolheu recalcular todos os horários, TODA troca de horário feita na mão e as reservas das eliminatórias previstas se perdem."
                                          data-confirmar-ok="Trocar">
                                        <input type="hidden" name="id" value="@Model.Id" />
                                        <div class="col-12 col-md-5">
                                            <label class="form-label small fw-bold mb-1" for="duplaA-@categoria.Id">Esta dupla…</label>
                                            <select class="form-select" id="duplaA-@categoria.Id" name="duplaA" required>
                                                @foreach (var g in categoria.GruposTorneio.OrderBy(x => x.Nome))
                                                {
                                                    <optgroup label="@g.Nome">
                                                        @foreach (var d in g.Duplas.OrderBy(x => x.NomeDeExibicao))
                                                        {
                                                            <option value="@d.Id">@d.NomeDeExibicao</option>
                                                        }
                                                    </optgroup>
                                                }
                                            </select>
                                        </div>
                                        <div class="col-12 col-md-5">
                                            <label class="form-label small fw-bold mb-1" for="duplaB-@categoria.Id">…troca de lugar com esta</label>
                                            <select class="form-select" id="duplaB-@categoria.Id" name="duplaB" required>
                                                @foreach (var g in categoria.GruposTorneio.OrderBy(x => x.Nome))
                                                {
                                                    <optgroup label="@g.Nome">
                                                        @foreach (var d in g.Duplas.OrderBy(x => x.NomeDeExibicao))
                                                        {
                                                            <option value="@d.Id">@d.NomeDeExibicao</option>
                                                        }
                                                    </optgroup>
                                                }
                                            </select>
                                        </div>
                                        <div class="col-12">
                                            <div class="form-check">
                                                <input class="form-check-input" type="radio" name="refazerHorarios"
                                                       id="manterHorarios-@categoria.Id" value="false" checked />
                                                <label class="form-check-label small" for="manterHorarios-@categoria.Id">
                                                    <strong>Só trocar as duplas</strong> — os horários ficam como estão,
                                                    e nenhuma troca sua se perde.
                                                    <span class="text-muted">Se a troca furar um impedimento, o aviso diz
                                                    qual — e o "Ajustar horários" conserta sem refazer a grade.</span>
                                                </label>
                                            </div>
                                            <div class="form-check">
                                                <input class="form-check-input" type="radio" name="refazerHorarios"
                                                       id="refazerHorarios-@categoria.Id" value="true" />
                                                <label class="form-check-label small" for="refazerHorarios-@categoria.Id">
                                                    <strong>Trocar e recalcular todos os horários</strong> — respeita os
                                                    impedimentos de quem pagou por eles.
                                                    <span class="text-danger">Refaz a grade inteira: as trocas feitas na
                                                    mão e as reservas das eliminatórias previstas se perdem.</span>
                                                </label>
                                            </div>
                                        </div>
                                        <div class="col-12 col-md-3 d-grid">
                                            <button type="submit" class="btn btn-outline-primary fw-bold">
                                                <i class="bi bi-arrow-left-right"></i> Trocar
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        }
                        @* ═══ O CHAVEAMENTO DESENHADO À MÃO (10/09/2026) ═══════════════════════
                           🗣️ "permita alterar na mao o chaveamento, como funciona a chave de cada um,
                           se o primeiro passar quem enfrenta" — e "cuidado para nao mexer nada no que
                           ja tem do ER hoje, isso é para os próximos torneios".

                           ⚠️ O campo abre com o desenho QUE O MOTOR FARIA (CruzamentoDoMataMata.Padrao),
                           e não vazio: abrir a tela e salvar sem mexer produz a MESMA chave de antes.
                           Vazio, o sistema volta a montar sozinho — é o desfazer desta tela.

                           Régua de quem vê: a mesma do bloco acima (organizador ou admin, chave ainda
                           esperando aprovação). A ação recusa de novo do lado de lá. *@
                        @if (Model.Status == Padelizou.Services.AprovacaoDeChaves.Pendente
                             && ViewBag.PodeAprovarChaves == true
                             && categoria.GruposTorneio.Count > 0)
                        {
                            var gruposDaCategoria = categoria.GruposTorneio.OrderBy(g => g.Nome).Select(g => g.Nome).ToList();
                            var duplasPorGrupo = categoria.GruposTorneio.OrderBy(g => g.Nome).Select(g => g.Duplas.Count).ToList();
                            var desenhoAtual = Padelizou.Services.CruzamentoDoMataMata.Ler(categoria.CruzamentoDoMataMata)
                                            ?? Padelizou.Services.CruzamentoDoMataMata.Padrao(
                                                   gruposDaCategoria,
                                                   Padelizou.Services.ClassificacaoDeGrupos.VagasPorGrupo(categoria),
                                                   duplasPorGrupo);

                            if (desenhoAtual != null)
                            {
                                <div class="card border-0 shadow-sm mb-4" style="background: var(--bs-tertiary-bg, #f8f9fa);">
                                    <div class="card-body">
                                        <h6 class="fw-bold text-muted text-uppercase mb-1">
                                            <i class="bi bi-diagram-3"></i> Chaveamento da primeira eliminatória
                                        </h6>
                                        <p class="small text-muted mb-2">
                                            Quem cruza com quem quando os grupos acabarem — e, por consequência, o
                                            caminho de cada um até a final.
                                            @if (categoria.CruzamentoDoMataMata == null)
                                            {
                                                <span>Hoje quem monta é o sistema; o que está aí embaixo é o que ele faria.</span>
                                            }
                                            else
                                            {
                                                <strong>Este chaveamento foi desenhado à mão.</strong>
                                            }
                                        </p>

                                        <form asp-controller="Torneios" asp-action="SalvarCruzamento" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@Model.Id" />
                                            <input type="hidden" name="categoriaId" value="@categoria.Id" />

                                            <div class="mb-2">
                                                @foreach (var confronto in desenhoAtual.Confrontos)
                                                {
                                                    <div class="small">@confronto.Lado1.Rotulo <span class="text-muted">×</span> @confronto.Lado2.Rotulo</div>
                                                }
                                                @foreach (var bye in desenhoAtual.Byes)
                                                {
                                                    <div class="small text-muted">@bye.Rotulo — passa direto (bye)</div>
                                                }
                                            </div>

                                            <label class="form-label small fw-bold mb-1" for="cruzamento-@categoria.Id">
                                                Desenho (formato <code>1A×2C|1B×2D;bye:1E</code>)
                                            </label>
                                            <input type="text" class="form-control font-monospace mb-2"
                                                   id="cruzamento-@categoria.Id" name="texto"
                                                   value="@desenhoAtual.Escrever()" />
                                            <div class="form-text mb-2">
                                                <code>1A</code> é o 1º do Grupo A. Toda vaga que classifica precisa aparecer
                                                uma vez — em jogo ou em bye. <strong>Apague tudo e salve</strong> pra voltar
                                                ao chaveamento do sistema.
                                            </div>
                                            <button type="submit" class="btn btn-outline-primary btn-sm fw-bold">
                                                <i class="bi bi-diagram-3"></i> Salvar chaveamento
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            }
                        }

                        @{
                            // O pop-up "O QUE CADA UM PRECISA PARA PASSAR" de cada grupo (🗣️ Felipe,
                            // 11/09/2026, num print do Grupo B do 2ª Etapa ER Padel Tour: *"que o grupo
                            // de 3, ja tiveram 2 jogos e falta um ... fica a duvida de quantos games
                            // precisa fazer para passar de fase"*).
                            //
                            // A conta NÃO é daqui: vem pronta do controller, do mesmo motor que a tela
                            // de Classificação já usava (Services/OQuePrecisaParaClassificar), que
                            // simula o placar que falta e pergunta à régua oficial quem classifica.
                            //
                            // ⚠️ A chave é o Id DO GRUPO, não o nome: "Grupo A" existe em toda
                            // categoria, e por nome o card da 4ª mostraria o que a 2ª precisa fazer.
                            var oQuePrecisaPorGrupo = ViewBag.OQuePrecisaPorGrupo
                                as Dictionary<int, Padelizou.Services.OQuePrecisaParaClassificar.Quadro>
                                ?? new Dictionary<int, Padelizou.Services.OQuePrecisaParaClassificar.Quadro>();
                        }
                        <div class="row">
                            @foreach (var grupo in categoria.GruposTorneio.OrderBy(g => g.Nome))
                            {
                                <div class="col-md-6 col-lg-4 mb-4">
                                    <div class="card shadow-sm border-0 h-100" style="border-top: 4px solid var(--padel-green);">
                                        <div class="card-header bg-white border-bottom-0 pt-3 pb-0">
                                            <h5 class="fw-bold mb-0 text-center" style="color: var(--pdz-ink);">@grupo.Nome</h5>
                                        </div>
                                        <div class="card-body p-0">
                                            <div class="table-responsive">
                                                <table class="table table-hover table-borderless mb-0 text-center align-middle pdz-grupo-tabela">
                                                    <thead class="table-light text-muted small">
                                                        <tr>
                                                            @* Sem largura declarada de propósito: em `table-layout: fixed` esta é a
                                                               coluna que recebe toda a sobra do card (as de J/V/D/SG pedem os poucos
                                                               pixels de um número no site.css). O `width: 50%` que ficava aqui
                                                               reservava METADE do card pros quatro dígitos. *@
                                                            <th class="text-start ps-3">Dupla</th>
                                                            <th title="Jogos">J</th>
                                                            <th title="Vitórias" class="text-success">V</th>
                                                            <th title="Derrotas" class="text-danger">D</th>
                                                            <th title="Saldo de Games">SG</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <!-- Por enquanto listamos as duplas, a matemática do SG faremos no próximo passo -->
                                                        <!-- Dentro do tbody da tabela da fase de grupos, atualize estas colunas: -->
                                                        @foreach (var dupla in grupo.Duplas)
                                                        {
                                                            <tr style="border-bottom: 1px solid #f0f0f0;">
                                                                @* Compacto: avatar menor, clube escondido e nome truncando —
                                                                   nome quebrando em três linhas fazia cada linha do grupo
                                                                   ocupar três alturas. *@
                                                                <td class="text-start ps-3 py-2 pdz-chip-compacto">
                                                                    <partial name="_LadoDaPartida" model="dupla" view-data="chipComSelo" />
                                                                </td>

                                                                <!-- DADOS REAIS CALCULADOS PELO MOTOR -->
                                                                <td class="fw-bold text-secondary">@dupla.Jogos</td>
                                                                <td class="fw-bold text-success">@dupla.Vitorias</td>
                                                                <td class="fw-bold text-danger">@dupla.Derrotas</td>

                                                                <!-- Saldo de games ganha cor inteligente (Verde se +, Vermelho se -) -->
                                                                @if (dupla.SaldoGames > 0)
                                                                {
                                                                    <td class="fw-bold text-success">+@dupla.SaldoGames</td>
                                                                }
                                                                else if (dupla.SaldoGames < 0)
                                                                {
                                                                    <td class="fw-bold text-danger">@dupla.SaldoGames</td>
                                                                }
                                                                else
                                                                {
                                                                    <td class="fw-bold text-muted">0</td>
                                                                }
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>

                                            @* Os JOGOS deste grupo, logo abaixo da tabela.
                                               Sem eles a classificação mostrava "V 0 · D 0"
                                               sem nenhuma pista de quais jogos faltavam — e o
                                               placar já estava no sistema, só não aparecia
                                               onde a pessoa estava olhando. *@
                                            @{
                                                var todosOsJogosDeGrupo = ViewBag.JogosDeGrupo as List<Padelizou.Models.Partida>
                                                                          ?? new List<Padelizou.Models.Partida>();
                                                var idsDoGrupo = grupo.Duplas.Select(d => d.Id).ToHashSet();
                                                var jogosDesteGrupo = todosOsJogosDeGrupo
                                                    .Where(p => idsDoGrupo.Contains(p.Dupla1Id) && idsDoGrupo.Contains(p.Dupla2Id))
                                                    .ToList();
                                            }
                                            @if (jogosDesteGrupo.Count > 0)
                                            {
                                                <div class="pdz-grupo-jogos">
                                                    @foreach (var jogoDoGrupo in jogosDesteGrupo)
                                                    {
                                                        var acabou = jogoDoGrupo.Status == "Finalizada";
                                                        var noAr = jogoDoGrupo.Status == "AoVivo";
                                                        var ganhou1 = jogoDoGrupo.VencedorId == jogoDoGrupo.Dupla1Id;
                                                        var ganhou2 = jogoDoGrupo.VencedorId == jogoDoGrupo.Dupla2Id;

                                                        @* ⚠️ SEMPRE <a>, COM HREF SÓ NO JOGO EM QUADRA (Felipe, 11/09/2026:
                                                           *"permita clicar no aovivo e ir para a pagina do aovivo aonde
                                                           esta o jogo"*). O card grande mora na MESMA página, na aba
                                                           Jogos — por isso uma hash, e não uma URL: nada recarrega e o
                                                           <iframe> da transmissão não reinicia (é o motivo de
                                                           js/jogos-ao-vivo-atualiza.js existir). Quem leva até lá é o
                                                           pdzIrProJogoDaHash, no fim deste arquivo.

                                                           `href` nulo o Razor NÃO escreve, e <a> sem href é texto comum:
                                                           sem foco, sem cursor de mão e sem destino. É o que mantém um
                                                           elemento só pros três estados do card, em vez de duplicar o
                                                           miolo inteiro num if. *@
                                                        <a class="pdz-grupo-jogo @(noAr ? "pdz-grupo-jogo-aovivo" : "")"
                                                           href="@(noAr ? $"#jogo-{jogoDoGrupo.Id}" : null)">
                                                            <div class="pdz-grupo-jogo-quando">
                                                                @if (noAr)
                                                                {
                                                                    <span class="pdz-chave-aovivo">● AO VIVO</span>
                                                                }
                                                                else if (acabou)
                                                                {
                                                                    @* 🗣️ *"o que estiver finalizado deixe um circulo
                                                                       parecido com o do aovivo, só que outra cor"*. Antes
                                                                       eram DOIS estados na tela — bolinha vermelha ou uma
                                                                       data — e a data é a MESMA do jogo que acabou e do
                                                                       que ainda vai acontecer: "sex 11/09 19:40" não
                                                                       dizia se era história ou agenda.

                                                                       O selo toma o LUGAR da data, e não anda ao lado
                                                                       dela: esta linha é `nowrap; overflow: hidden` SEM
                                                                       reticências e a etiqueta do lugar é a última
                                                                       (`margin-left: auto`) — os dois juntos comeriam o
                                                                       "Er Padel · Arena Nclass" calado, que é o defeito
                                                                       medido na árvore da chave em 11/09. *@
                                                                    <span class="pdz-chave-encerrado">● ENCERRADO</span>
                                                                }
                                                                else if (jogoDoGrupo.HorarioPrevisto is DateTime hg)
                                                                {
                                                                    <span>@DiaDaSemana.Curto(hg) @hg.ToString("dd/MM HH:mm")</span>
                                                                }
                                                                else
                                                                {
                                                                    <span>por ordem</span>
                                                                }
                                                                @if (LugarDoJogo.Etiqueta(ViewData.Sedes(), jogoDoGrupo.NomeQuadra, jogoDoGrupo.CategoriaId, jogoDoGrupo.ClubeId) is { } ondeJoga)
                                                                {
                                                                    <span class="pdz-grupo-jogo-quadra">@ondeJoga</span>
                                                                }
                                                            </div>
                                                            <div class="pdz-grupo-jogo-lado @(ganhou1 ? "pdz-chave-venceu" : ganhou2 ? "text-muted" : "")">
                                                                <span class="pdz-chave-nome">@NomeCurtoDaDupla(jogoDoGrupo.Dupla1)</span>
                                                                <span class="pdz-chave-games">@(acabou || noAr ? (jogoDoGrupo.GamesDupla1?.ToString() ?? "0") : "–")</span>
                                                            </div>
                                                            <div class="pdz-grupo-jogo-lado @(ganhou2 ? "pdz-chave-venceu" : ganhou1 ? "text-muted" : "")">
                                                                <span class="pdz-chave-nome">@NomeCurtoDaDupla(jogoDoGrupo.Dupla2)</span>
                                                                <span class="pdz-chave-games">@(acabou || noAr ? (jogoDoGrupo.GamesDupla2?.ToString() ?? "0") : "–")</span>
                                                            </div>
                                                        </a>
                                                    }
                                                </div>
                                            }
                                        </div>
                                        @* Só no grupo em que falta UM jogo: antes disso não há
                                           resposta pra dar, e depois o grupo já acabou. *@
                                        @if (oQuePrecisaPorGrupo.ContainsKey(grupo.Id))
                                        {
                                            <div class="card-footer">
                                                <button class="btn btn-sm btn-outline-primary w-100 rounded-pill fw-bold"
                                                        type="button" data-bs-toggle="modal"
                                                        data-bs-target="#oQuePrecisa-@grupo.Id">
                                                    <i class="bi bi-question-circle"></i>
                                                    O que cada um precisa para passar
                                                </button>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                        @* ── OS POP-UPS, UM POR GRUPO ──────────────────────────────────────────
                           ⚠️ FORA DOS CARDS, e é por isso que existe este segundo laço em vez de
                           o modal nascer junto do botão: `site.css` dá
                           `transform: translateY(-5px)` no hover de `.card.h-100`, e o card do
                           grupo é exatamente isso. Ancestral com `transform` vira bloco de
                           contenção do `position: fixed` — dentro do card, o pop-up ficaria preso
                           ao card e do tamanho dele no instante em que o dedo encostasse. *@
                        @foreach (var grupo in categoria.GruposTorneio.OrderBy(g => g.Nome))
                        {
                            if (oQuePrecisaPorGrupo.TryGetValue(grupo.Id, out var quadroDoGrupo))
                            {
                                <div class="modal fade" id="oQuePrecisa-@grupo.Id" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h6 class="modal-title fw-bold">
                                                    <i class="bi bi-question-circle"></i>
                                                    @grupo.Nome — o que cada um precisa para passar
                                                </h6>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                                            </div>
                                            <div class="modal-body">
                                                <partial name="_OQuePrecisaParaClassificar" model="quadroDoGrupo" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }

                        </div>
                        }

                        <div style="order: @(chaveJaComecou ? 1 : 2);" class="@(chaveJaComecou ? "" : "mt-5 pt-3 border-top")">
                            <h4 class="fw-bold mb-2" style="color: var(--pdz-ink);">
                                <i class="bi bi-diagram-3-fill text-danger me-2"></i> Fase Final (Mata-Mata)
                            </h4>

                            @if (!fasesPresentes.Any())
                            {
                                @* Prévia por COLOCAÇÃO. "Ainda não começou" é verdade e é
                                   inútil: quem está jogando a última rodada do grupo quer
                                   saber o que ganha terminando em primeiro. O cruzamento sai
                                   do mesmo motor do sorteio de verdade — ver
                                   Services/ChaveProjetada. *@
                                var gruposEmOrdem = categoria.GruposTorneio.OrderBy(g => g.Nome).ToList();
                                var gruposDaCategoria = gruposEmOrdem.Select(g => g.Nome).ToList();
                                @* O tamanho de cada grupo decide quem descansa — é assim que a
                                   prévia dá o bye a quem o robô dá (ChaveProjetada, 10/09/2026). *@
                                @* E com o CRUZAMENTO DESENHADO, quando existe: sem ele o quadro
                                   mostrava a semeadura do motor numa categoria que tem desenho,
                                   prometendo um confronto que o sorteio não faria. *@
                                @* 🗣️ *"o Grupo B já está definido, então já pode mudar, na
                                   semifinal o 1º do B e o 2º do B"* — fechado o grupo, a
                                   colocação vira NOME. Ver Services/ClassificadosJaConhecidos. *@
                                var jogosDeGrupoDaCategoria = (ViewBag.JogosDeGrupo as List<Padelizou.Models.Partida>
                                                               ?? new List<Padelizou.Models.Partida>())
                                    .Where(p => p.CategoriaId == categoria.Id).ToList();
                                @* ⚠️ Os pontos do desempate vêm do CONTROLLER (buscá-los aqui
                                   exigiria await, que a view não tem). Sem eles, um grupo que
                                   terminou empatado em tudo poria nesta vaga um nome diferente
                                   do que o robô vai pôr. *@
                                var pontosDoDesempate =
                                    (ViewBag.PontosDoDesempatePorCategoria
                                        as Dictionary<int, IReadOnlyDictionary<int, int>>)
                                    ?.GetValueOrDefault(categoria.Id)
                                    ?? Padelizou.Services.ClassificacaoDeGrupos.SemPontos;

                                var jaConhecidosNoQuadro = Padelizou.Services.ClassificadosJaConhecidos.De(
                                    gruposEmOrdem, jogosDeGrupoDaCategoria,
                                    Padelizou.Services.ClassificacaoDeGrupos.VagasPorGrupo(categoria),
                                    pontosDoDesempate);

                                var rodadasProjetadas = Padelizou.Services.ChaveProjetada.MontarCompleta(
                                    gruposDaCategoria, Padelizou.Services.ClassificacaoDeGrupos.VagasPorGrupo(categoria),
                                    gruposEmOrdem.Select(g => g.Duplas.Count).ToList(),
                                    categoria.CruzamentoDoMataMata,
                                    jaConhecidosNoQuadro);

                                if (rodadasProjetadas.Count == 0)
                                {
                                    <div class="alert alert-light border text-muted">
                                        <i class="bi bi-hourglass-split"></i> O mata-mata desta categoria ainda não começou —
                                        ele é gerado automaticamente quando o último jogo da fase de grupos é finalizado.
                                    </div>
                                }
                                else
                                {
                                    <div class="alert alert-light border small mb-3">
                                        <i class="bi bi-eye"></i>
                                        <strong>Prévia do caminho até a final</strong> — o quadro se preenche sozinho
                                        quando o último jogo dos grupos acabar.
                                        <span class="d-block text-muted mt-1">
                                            Entre os segundos colocados, quem passa e de que lado da chave cai depende da
                                            campanha de cada dupla — por isso os confrontos ainda podem mudar.
                                        </span>
                                    </div>

                                    @* HORA e QUADRA vêm da MESMA projeção da aba Jogos
                                       (Services/ProximasFasesDaChave). Recalcular aqui daria uma segunda
                                       conta, e duas contas divergem no dia em que a regra mudar — a tela
                                       do quadro diria uma hora e a lista de jogos diria outra.

                                       ⚠️ LÊ `ProjecaoCompleta`, E NÃO `JogosQueVem` (10/09/2026):
                                       `JogosQueVem` é a lista da ABA JOGOS e os filtros dela (clube,
                                       quadra, fase, "meus jogos") a recortam — com uma semifinal fora, o
                                       quadro mostrava confronto que não existe. *@
                                    var projecaoDaCategoria = (ViewBag.ProjecaoCompleta
                                            as List<Padelizou.Services.ProximasFasesDaChave.JogoQueVem>)
                                        ?.Where(j => j.Categoria == categoria.Nome)
                                        .GroupBy(j => j.Fase)
                                        .ToDictionary(g => g.Key, g => g.ToList());

                                    @* O casamento é por (fase, NÚMERO do jogo DENTRO DA FASE) — nunca por
                                       posição na lista. `ProximasFasesDaChave.Agendar` numera por fase
                                       (`Numero = i + 1`), e é por isso que a busca compara com `i + 1`.

                                       ⚠️ POR POSIÇÃO ESTAVA ERRADO, e o comentário que ficou aqui até
                                       10/09/2026 dizia por quê sem perceber: "os dois saem do mesmo motor
                                       de chaveamento, na mesma ordem". Saem do mesmo motor; NÃO chegam na
                                       mesma ordem. `ProjetarProximasFasesAsync` termina com
                                       `OrderBy(j => j.Horario)`, e uma RESERVA do organizador
                                       (Models/ReservaDeHorario, o "trocar horário" de uma prévia) grava a
                                       hora escolhida sem mover o cursor da grade — de propósito.
                                       Reservando a Semifinal 1 pra depois da 2, a lista chega com a 2 na
                                       frente e a vaga da 1 mostrava a hora e a quadra da 2. Travado em
                                       QuadroDaChaveCasaPorNumeroTests.

                                       ⚠️ E A ÁRVORE REORDENA DE NOVO: no quadro, a primeira rodada sai
                                       1, 4, 2, 3 (ver Services/ArvoreDaChave), então o mapa é montado
                                       AQUI, na ordem da projeção, e entregue ao partial por número GLOBAL
                                       do jogo. Casar lá dentro, na ordem da árvore, pegaria o jogo errado. *@
                                    var previstosDoQuadro = new Dictionary<int, Padelizou.Services.ProximasFasesDaChave.JogoQueVem>();
                                    foreach (var rodada in rodadasProjetadas)
                                    {
                                        List<Padelizou.Services.ProximasFasesDaChave.JogoQueVem>? daFase = null;
                                        projecaoDaCategoria?.TryGetValue(rodada.Fase, out daFase);

                                        for (int i = 0; i < rodada.Jogos.Count; i++)
                                        {
                                            var previsto = daFase?.FirstOrDefault(j => j.Numero == i + 1);
                                            if (previsto != null)
                                            {
                                                previstosDoQuadro[rodada.Jogos[i].Numero] = previsto;
                                            }
                                        }
                                    }

                                    @* O quadro com as linhas: no computador de cima pra baixo, no celular
                                       deitado e arrastável. A geometria dos dois é a mesma conta —
                                       ver Services/ArvoreDaChave e Views/Torneios/_ChaveProjetadaArvore. *@
                                    <partial name="_ChaveProjetadaArvore"
                                             model="(Padelizou.Services.ArvoreDaChave.Montar(rodadasProjetadas), (IReadOnlyDictionary<int, Padelizou.Services.ProximasFasesDaChave.JogoQueVem>)previstosDoQuadro)" />
                                }
                            }
                            else
                            {
                                @* Chaveamento completo, de cima pra baixo, com as duplas de
                                   BYE nomeadas na fase em que entram — sem isso elas somem
                                   do quadro. O jogador logado vai junto pro quadro pintar o
                                   caminho dele. Ver Views/Torneios/_ChaveDoMataMata. *@
                                var byesDict = ViewBag.ByesPorCategoria as Dictionary<int, List<Padelizou.Models.Dupla>>;
                                var byesDaCategoria = (byesDict != null && byesDict.ContainsKey(categoria.Id))
                                    ? byesDict[categoria.Id] : new List<Padelizou.Models.Dupla>();
                                int? meuJogadorIdNoQuadro = ViewBag.MeuJogadorId as int?;
                                <partial name="_ChaveDoMataMata" model="(jogosMata, byesDaCategoria, meuJogadorIdNoQuadro)" />
                            }
                        </div>
                        </div> @* fim do d-flex flex-column que ordena chave/grupos *@
                    </div>
                }
            }
        </div>

        @* Troca o painel visível e LEMBRA a escolha (o porquê está no arquivo). *@
        <script src="~/js/seletor-de-categoria.js" asp-append-version="true"></script>
        } @* fim do else: torneio de CHAVE. O Americano sai lá em cima, pela classificação. *@
      }
      else
      {
        <div class="alert alert-info border-0 shadow-sm">
            <i class="bi bi-hourglass-split"></i>
            As chaves deste torneio foram sorteadas e estão aguardando aprovação de quem
            organiza. Assim que aprovarem, elas aparecem aqui pra todo mundo.
        </div>
      }
    </div>
    @* Implementação ÚNICA do "cadastre um local novo" — ver wwwroot/js/adicionar-local.js.
       Aqui ele serve o "Adicionar clube" do editor de sedes. Fica FORA do @if de baixo: o
       editor de sedes existe antes de o torneio começar, que é justamente quando o organizador
       ainda está acertando onde cada quadra fica. *@
    <script src="~/js/adicionar-local.js" asp-append-version="true"></script>
    <!-- SCRIPT (Coloque no final do arquivo Details.cshtml) -->
    <script>
            function mostrarCategoriaInscritos(categoriaId) {
                document.querySelectorAll('.categoria-inscritos-conteudo').forEach(function (el) {
                    el.style.display = (el.getAttribute('data-categoria-id') === String(categoriaId)) ? 'block' : 'none';
                });
            }

            function toggleImpedimentosEdicao() {
                var ligado = document.getElementById('editImpSwitch').checked;
                document.getElementById('editTurnosImpedimento').style.display = ligado ? 'block' : 'none';
            }

            // O turno de QUINTA acompanha a data de início ali de cima: só faz sentido no
            // torneio que COMEÇA na quinta. Como a data virou campo editável nesta mesma tela,
            // esperar salvar pra ver a opção aparecer seria pedir fé no formulário.
            //
            // ⚠️ Só esconde, e nunca o que está MARCADO: a data pode ter mudado depois de
            // alguém marcar (e pagar) o impedimento, e sumir com ele aqui apagaria a restrição
            // em silêncio no próximo "Salvar". Ver Torneio.QuintaEhDiaDoTorneio.
            function pdzEditarTurnoDeQuinta() {
                var data = document.getElementById('editDataInicio');
                var linha = document.getElementById('editLinhaImpQuinta');
                var caixa = document.getElementById('editImpQuinta');
                if (!data || !linha || !caixa) return;

                // 'T12:00' de propósito: só a data, o navegador leria como UTC e o fuso de
                // Brasília jogaria o dia pra trás.
                var ehQuinta = data.value && new Date(data.value + 'T12:00').getDay() === 4;
                linha.style.display = (ehQuinta || caixa.checked) ? 'block' : 'none';
            }

            // "Sem horário previsto" desliga a grade inteira — mostrar a janela de horários
            // ao lado seria oferecer um ajuste que não vale pra nada.
            function pdzEditarHorariosDaGrade() {
                var semHora = document.getElementById('editSemHorario');
                var campos = document.getElementById('editHorariosDaGrade');
                if (!semHora || !campos) return;

                campos.style.display = semHora.checked ? 'none' : 'block';
            }

            // Chave de acesso e "sumir da listagem" só fazem sentido com o restrito ligado.
            function pdzEditarRestrito() {
                var ligado = document.getElementById('editRestritoSwitch').checked;
                document.getElementById('editCampoChave').style.display = ligado ? 'block' : 'none';
            }

            function gerarCamposQuadraEdicao() {
                var container = document.getElementById('editCamposNomesQuadras');
                var campoQuantidade = document.getElementById('editQuantidadeQuadras');

                // Os dois só existem na aba de gestão, que é do organizador. A função é
                // chamada no carregamento da página — sem esta saída, quem abre o torneio
                // sem ser organizador leva um erro de JavaScript no console. Erro solto ali
                // não quebra a tela, mas esconde os que quebram.
                if (!container || !campoQuantidade) return;

                var quantidade = Math.max(0, Math.min(26, parseInt(campoQuantidade.value, 10) || 0));
                var nomesAtuais = JSON.parse(container.getAttribute('data-nomes-atuais') || '[]');
                var valoresAtuais = Array.from(container.querySelectorAll('input')).map(function (i) { return i.value; });
                var valores = valoresAtuais.length > 0 ? valoresAtuais : nomesAtuais;

                container.innerHTML = '';
                for (var i = 0; i < quantidade; i++) {
                    var col = document.createElement('div');
                    col.className = 'col-md-3 col-6';
                    var input = document.createElement('input');
                    input.type = 'text';
                    input.name = 'nomesQuadras';
                    input.className = 'form-control form-control-sm';
                    input.placeholder = 'Quadra ' + String.fromCharCode(65 + i);
                    input.value = valores[i] || '';
                    // Renomeou a quadra? A tabela de preferência tem que dizer o nome novo.
                    input.addEventListener('input', montarPreferenciaQuadraEdicao);
                    col.appendChild(input);

                    container.appendChild(col);
                }

                montarPreferenciaQuadraEdicao();
            }

            // `pdzEditEscapar` continua aqui porque a tabela de preferência de quadra usa —
            // o resto do JS de sedes foi embora com o editor (ver a sub-aba "Quadras e sedes").
            function pdzEditEscapar(texto) {
                var caixa = document.createElement('span');
                caixa.textContent = texto;
                return caixa.innerHTML;
            }

            // A tabela categorias × quadras da gestão. As categorias já existem (vêm com Id no
            // data-categorias); as quadras saem dos campos de nome, pela POSIÇÃO — quem sobe a
            // quantidade marca a preferência da quadra nova antes de ela existir.
            function montarPreferenciaQuadraEdicao() {
                var secao = document.getElementById('pdzEditPreferenciaQuadra');
                var alvo = document.getElementById('pdzEditPreferenciaQuadraTabela');
                if (!secao || !alvo) return;

                // O que já está marcado: primeiro o que o organizador acabou de mexer na tela,
                // e só na primeira montagem o que veio do banco.
                var marcadas = {};
                var naTela = alvo.querySelectorAll('input');
                if (naTela.length > 0) {
                    naTela.forEach(function (c) { if (c.checked) marcadas[c.value] = true; });
                } else {
                    JSON.parse(secao.getAttribute('data-marcadas') || '[]')
                        .forEach(function (par) { marcadas[par] = true; });
                }

                // Os campos de nome saíram da tela (09/09/2026: quadra se edita no planejador),
                // então os nomes vêm do container oculto. O caminho pelos inputs fica pra tela
                // de criação, que ainda desenha os campos.
                var container = document.getElementById('editCamposNomesQuadras');
                var quadras = Array.from(document.querySelectorAll('#editCamposNomesQuadras input'))
                    .map(function (i, pos) { return (i.value || '').trim() || i.placeholder || ('Quadra ' + (pos + 1)); });
                if (quadras.length === 0 && container) {
                    quadras = JSON.parse(container.getAttribute('data-nomes-atuais') || '[]');
                }
                var categorias = JSON.parse(secao.getAttribute('data-categorias') || '[]');

                if (quadras.length === 0 || categorias.length === 0) {
                    alvo.innerHTML = '<div class="small text-muted">Cadastre quadras e categorias pra escolher aqui.</div>';
                    return;
                }

                function escapar(texto) {
                    var caixa = document.createElement('span');
                    caixa.textContent = texto;
                    return caixa.innerHTML;
                }

                var html = '<table class="table table-sm align-middle mb-0"><thead><tr><th class="small">Categoria</th>';
                quadras.forEach(function (nome) { html += '<th class="small text-center">' + escapar(nome) + '</th>'; });
                html += '</tr></thead><tbody>';

                categorias.forEach(function (cat) {
                    html += '<tr><td class="small">' + escapar(cat.nome) + '</td>';
                    quadras.forEach(function (nome, pos) {
                        var valor = cat.id + ':' + pos;
                        html += '<td class="text-center"><input class="form-check-input" type="checkbox" '
                             + 'name="quadrasPreferidas" value="' + valor + '"'
                             + (marcadas[valor] ? ' checked' : '') + ' title="' + escapar(nome) + '"></td>';
                    });
                    html += '</tr>';
                });

                alvo.innerHTML = html + '</tbody></table>';
            }

            gerarCamposQuadraEdicao();
            // Sem o campo de quantidade a função acima sai antes de chegar na tabela de
            // preferência — que continua existindo e precisa ser desenhada no carregamento.
            montarPreferenciaQuadraEdicao();

            // ── SEDES: a tabela "em que clube cada categoria joga" (sub-aba Quadras e sedes) ──
            //
            // ⚠️ ESTE É O ÚNICO JS QUE SOBROU DO EDITOR DE SEDES, e ele existe por um motivo só:
            // as opções de clube da categoria saem dos selects de QUADRA logo acima, no mesmo
            // formulário. Sem ele o organizador teria que salvar duas vezes — uma pra criar a
            // sede, outra pra dividir as categorias.
            //
            // O que sumiu junto com o editor antigo: a caixa "mais de um clube", a lista de
            // clubes do torneio, o par posicional nome↔clube e o init que reabria tudo. A sede
            // agora é o DISTINCT do clube das quadras, então não há duas listas pra manter em pé.
            function pdzMontarSedeDaCategoria() {
                var form = document.getElementById('pdzSedes');
                var alvo = document.getElementById('pdzSedeDaCategoria');
                if (!form || !alvo) return;

                // Os clubes que as quadras estão usando AGORA, na ordem em que aparecem, sem
                // repetir. O texto do <option> é o nome do clube — vem do próprio select.
                var sedes = [];
                Array.from(form.querySelectorAll('.pdz-sede-da-quadra')).forEach(function (select) {
                    var clube = String(select.value).split(':')[1];
                    if (!clube) return;
                    if (sedes.some(function (s) { return s.id === clube; })) return;
                    sedes.push({ id: clube, nome: select.options[select.selectedIndex].text.trim() });
                });

                // O que está na tela manda; só na primeira montagem vale o que veio do banco —
                // mesma régua da tabela de preferência de quadra.
                var escolhidas = {};
                var naTela = alvo.querySelectorAll('select');
                if (naTela.length > 0) {
                    naTela.forEach(function (s) {
                        if (s.value) escolhidas[s.value.split(':')[0]] = s.value.split(':')[1];
                    });
                } else {
                    JSON.parse(form.getAttribute('data-categorias') || '[]')
                        .forEach(function (c) { if (c.clube) escolhidas[c.id] = c.clube; });
                }

                var categorias = JSON.parse(form.getAttribute('data-categorias') || '[]');

                // Uma sede só? Então não há o que dividir, e uma tabela com uma coluna só seria
                // um campo pedindo pra ser preenchido à toa.
                if (sedes.length < 2 || categorias.length === 0) {
                    alvo.innerHTML = '<div class="small text-muted">'
                        + 'Ponha ao menos uma quadra em outro clube aqui em cima pra dividir as categorias.</div>';
                    return;
                }

                var html = '<table class="table table-sm align-middle mb-0"><tbody>';
                categorias.forEach(function (cat) {
                    html += '<tr><td class="small">' + pdzEditEscapar(cat.nome) + '</td><td style="width: 240px;">'
                         + '<select name="clubesCategorias" class="form-select form-select-sm">'
                         + '<option value="">Qualquer quadra do torneio</option>'
                         + sedes.map(function (s) {
                               return '<option value="' + cat.id + ':' + s.id + '"'
                                    + (String(escolhidas[cat.id]) === String(s.id) ? ' selected' : '') + '>'
                                    + pdzEditEscapar(s.nome) + '</option>';
                           }).join('')
                         + '</select></td></tr>';
                });

                alvo.innerHTML = html + '</tbody></table>';
            }

            (function () {
                var form = document.getElementById('pdzSedes');
                if (!form) return;   // não é organizador: a sub-aba nem existe na página

                Array.from(form.querySelectorAll('.pdz-sede-da-quadra'))
                    .forEach(function (s) { s.addEventListener('change', pdzMontarSedeDaCategoria); });

                pdzMontarSedeDaCategoria();
            })();
    </script>
</div>

