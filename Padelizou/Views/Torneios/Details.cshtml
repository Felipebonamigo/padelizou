<script>
    // Inscrição: ao completar o CPF, puxa os dados de quem já é cadastrado e avisa quando é
    // gente nova (que entra como pré-cadastro ao confirmar a inscrição).
    (function () {
        var urlBusca = '@Url.Action("BuscarJogadorPorCpf", "Torneios")';

        function campo(nome, alvo) {
            return document.querySelector('[name="' + nome + (alvo === 'ind' ? '' : alvo) + '"]');
        }

        document.querySelectorAll('.js-cpf').forEach(function (inputCpf) {
            var alvo = inputCpf.dataset.alvo;
            var status = document.querySelector('.js-cpf-status[data-alvo="' + alvo + '"]');

            // A formatação é do mascaras.js (data-mascara="cpf"), que também limpa o valor no
            // submit — aqui só se limpa o aviso enquanto o CPF ainda está incompleto.
            inputCpf.addEventListener('input', function () {
                if (inputCpf.value.replace(/\D/g, '').length < 11) status.innerHTML = '';
            });

            inputCpf.addEventListener('blur', function () {
                var cpf = inputCpf.value.replace(/\D/g, '');
                if (cpf.length !== 11) return;

                status.innerHTML = '<span class="text-muted">Consultando…</span>';

                fetch(urlBusca + '?cpf=' + cpf)
                    .then(function (r) { return r.json(); })
                    .then(function (dados) {
                        var nome = campo('nome', alvo);
                        if (dados.encontrado) {
                            status.innerHTML = '<span class="text-success fw-semibold">'
                                + '<i class="bi bi-check-circle-fill"></i> ' + dados.nome + ' — já cadastrado</span>';
                            if (nome) nome.value = dados.nome;

                            // Individual (americano) só tem nome; a dupla tem o resto.
                            var celular = campo('celular', alvo);
                            var cidade = campo('cidade', alvo);
                            var estado = campo('estado', alvo);
                            if (celular && dados.celular) {
                                celular.value = dados.celular;
                                // O celular vem cru do banco e atribuir .value não dispara
                                // 'input', então a máscara não formataria sozinha.
                                celular.dispatchEvent(new Event('input', { bubbles: true }));
                            }
                            if (cidade && dados.cidade) cidade.value = dados.cidade;
                            if (estado && dados.estado) estado.value = dados.estado;
                        } else {
                            status.innerHTML = '<span class="text-warning-emphasis">'
                                + '<i class="bi bi-person-plus-fill"></i> Jogador ainda não cadastrado — '
                                + 'preencha os dados e ele entra como pré-cadastro.</span>';
                            if (nome) nome.value = '';
                        }
                    })
                    .catch(function () { status.innerHTML = ''; });
            });
        });
    })();

    // "Ainda não tenho parceiro": esconde os campos do jogador 2. O required precisa sair
    // junto, senão o navegador recusa o envio apontando pra um campo invisível.
    (function () {
        var check = document.getElementById('pdzSemParceiro');
        if (!check) return;

        var campos = document.getElementById('pdzCamposParceiro');
        var aviso = document.getElementById('pdzAvisoSemParceiro');
        var badge = document.getElementById('pdzBadgeSemParceiro');

        function aplicar() {
            var solo = check.checked;
            campos.style.display = solo ? 'none' : '';
            aviso.style.display = solo ? '' : 'none';
            badge.style.display = solo ? '' : 'none';

            campos.querySelectorAll('input').forEach(function (input) {
                if (solo) {
                    if (input.hasAttribute('required')) {
                        input.dataset.eraRequired = '1';
                        input.removeAttribute('required');
                    }
                    input.value = '';
                } else if (input.dataset.eraRequired === '1') {
                    input.setAttribute('required', 'required');
                }
            });
        }

        check.addEventListener('change', aplicar);
        aplicar(); // respeita o estado se o navegador restaurar o formulário
    })();
</script>