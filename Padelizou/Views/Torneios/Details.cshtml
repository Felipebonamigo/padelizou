<script>
    // Inscrição: ao completar o CPF, puxa os dados de quem já é cadastrado e avisa quando é
    // gente nova (que entra como pré-cadastro ao confirmar a inscrição).
    //
    // Os campos nascem TRAVADOS e o CPF manda neles: quem já é cadastrado tem os dados vindos
    // do próprio perfil, e quem inscreve a dupla não reescreve o nome nem o telefone do
    // parceiro por engano. Só um CPF novo destrava a digitação.
    //
    // Travar é 'readonly', nunca 'disabled': campo disabled não vai no POST, e o servidor
    // receberia nome e cidade vazios.
    (function () {
        var urlBusca = '@Url.Action("BuscarJogadorPorCpf", "Torneios")';

        // O último jogador achado por alvo ("1", "2", "ind"). Os avisos de categoria e de
        // "não é você" leem daqui em vez de consultar o servidor de novo.
        window.pdzJogadores = window.pdzJogadores || {};

        function campo(nome, alvo) {
            return document.querySelector('[name="' + nome + (alvo === 'ind' ? '' : alvo) + '"]');
        }

        function camposDe(alvo) {
            // Individual (americano) só tem nome; a dupla tem o resto.
            return ['nome', 'celular', 'cidade', 'estado']
                .map(function (n) { return campo(n, alvo); })
                .filter(Boolean);
        }

        // Campo travado é campo que VEM DO CADASTRO de quem o CPF achou. Ele também sai da
        // validação do navegador, e isso passou a importar em 10/08/2026: desde a varredura
        // de conformidade o servidor não devolve mais celular e cidade de TERCEIRO (ver
        // BuscarJogadorPorCpf), então o campo do parceiro fica travado e VAZIO. Com o
        // `required` valendo, o envio morreria num campo que a pessoa nem pode preencher.
        function trancar(el, travado) {
            if (el.dataset.placeholderOriginal === undefined) el.dataset.placeholderOriginal = el.placeholder || '';
            el.readOnly = travado;
            el.required = !travado;
            el.placeholder = travado && !el.value ? 'Já está no cadastro dele' : el.dataset.placeholderOriginal;
            el.style.backgroundColor = travado ? 'var(--pdz-surface-alt)' : '';
            el.title = travado ? 'Vem do cadastro do jogador. Para mudar, é no perfil dele.' : '';
        }

        function travar(alvo, travado) {
            camposDe(alvo).forEach(function (el) { trancar(el, travado); });
        }

        // Um campo depois de o CPF achar alguém: ou já veio preenchido (é o SEU CPF, e o
        // servidor devolve o seu contato), ou o servidor disse que o cadastro dele já tem
        // aquilo. Nos dois casos tranca. O que falta no cadastro segue editável — cadastro
        // antigo pode não ter celular, e a inscrição não pode empacar por causa disso.
        function ajustar(alvo, nome, jaNoCadastro) {
            var el = campo(nome, alvo);
            if (el) trancar(el, !!el.value || jaNoCadastro === true);
        }

        // "Esse CPF já está inscrito nesta categoria." Só olha o campo do PARCEIRO (alvo 2):
        // no campo 1 quem se inscreve é você mesmo, e o servidor já absorve a sua inscrição
        // sozinha sem precisar perguntar nada.
        //
        // Duas respostas bem diferentes (ver Services/InscricaoRepetida):
        //   sozinho      → oferta de juntar, com a caixa de confirmação;
        //   com parceiro → um não, e o botão de enviar trava.
        function pdzAvisarSeJaInscrito(alvo, dados) {
            if (alvo !== '2') return;

            var caixa = document.getElementById('pdzJaInscrito');
            var texto = document.getElementById('pdzJaInscritoTexto');
            var bloco = document.getElementById('pdzJuntarBloco');
            var juntar = document.getElementById('pdzJuntar');
            var enviar = document.getElementById('btn-inscrever-dupla');
            if (!caixa) return;

            // Toda consulta nova começa limpando: senão o aviso do CPF anterior fica na tela
            // depois de a pessoa corrigir o número.
            juntar.checked = false;
            caixa.classList.add('d-none');
            if (enviar) enviar.disabled = false;

            if (!dados.encontrado) return;

            if (dados.jaInscritoComParceiro) {
                texto.innerHTML = '<strong>' + dados.nome + '</strong> já está inscrito nesta categoria, '
                    + 'em dupla com <strong>' + dados.parceiroAtual + '</strong>. '
                    + 'Ninguém joga duas vezes na mesma categoria — escolha outro parceiro.';
                bloco.classList.add('d-none');
                caixa.classList.remove('d-none');
                if (enviar) enviar.disabled = true;
                return;
            }

            if (dados.jaInscritoSozinho) {
                texto.innerHTML = '<strong>' + dados.nome + '</strong> já está inscrito nesta categoria, '
                    + 'sozinho, procurando parceiro. Quer juntar? A inscrição sozinha dele sai e fica '
                    + 'só a dupla — a vaga é a mesma, ninguém perde lugar.';
                bloco.classList.remove('d-none');
                caixa.classList.remove('d-none');
            }
        }

        document.querySelectorAll('.js-cpf').forEach(function (inputCpf) {
            var alvo = inputCpf.dataset.alvo;
            var status = document.querySelector('.js-cpf-status[data-alvo="' + alvo + '"]');

            travar(alvo, true);

            function consultar() {
                var cpf = inputCpf.value.replace(/\D/g, '');
                // A trava de repetição vive no próprio elemento (e não numa variável desta
                // closure) pra quem está fora conseguir zerá-la: trocar de CATEGORIA muda a
                // resposta de "já está inscrito?" pro MESMO CPF, e sem isso o aviso ficaria
                // congelado na resposta da categoria anterior.
                if (cpf.length !== 11 || cpf === inputCpf.dataset.ultimoConsultado) return;
                inputCpf.dataset.ultimoConsultado = cpf;

                status.innerHTML = '<span class="text-muted">Consultando…</span>';

                // A categoria vai junto: é ela que decide se este CPF já está inscrito. Sem
                // ela o servidor não tem como responder, e o aviso só apareceria depois de
                // gravar — que é tarde.
                var categoriaEscolhida = document.querySelector('#inscricao select[name="categoriaId"]');
                var qsCategoria = categoriaEscolhida && categoriaEscolhida.value
                    ? '&categoriaId=' + encodeURIComponent(categoriaEscolhida.value) : '';

                // POST, e não mais GET com o CPF na barra de endereço: em 10/08/2026 a
                // varredura de conformidade mostrou o documento indo parar no log de acesso
                // do servidor, no histórico do navegador e no `Referer`. No corpo, não vai.
                fetch(urlBusca, {
                    method: 'POST',
                    headers: cabecalhoAntifalsificacao({ 'Content-Type': 'application/x-www-form-urlencoded' }),
                    body: 'cpf=' + cpf + qsCategoria
                })
                    .then(function (r) { return r.json(); })
                    .then(function (dados) {
                        var nome = campo('nome', alvo);
                        pdzAvisarSeJaInscrito(alvo, dados);
                        if (dados.encontrado) {
                            status.innerHTML = '<span class="text-success fw-semibold">'
                                + '<i class="bi bi-check-circle-fill"></i> ' + dados.nome + ' — já cadastrado</span>';
                            if (nome) nome.value = dados.nome;

                            // Celular, cidade e estado só voltam preenchidos quando o CPF é o
                            // de quem está logado ("Sou eu"). Pro CPF de terceiro vem só o
                            // `tem*`, dizendo que o cadastro dele já tem aquilo — e quem
                            // completa é o servidor, na gravação.
                            var celular = campo('celular', alvo);
                            if (celular && dados.celular) {
                                celular.value = dados.celular;
                                // O celular vem cru do banco e atribuir .value não dispara
                                // 'input', então a máscara não formataria sozinha.
                                celular.dispatchEvent(new Event('input', { bubbles: true }));
                            }
                            var cidade = campo('cidade', alvo);
                            var estado = campo('estado', alvo);
                            if (cidade && dados.cidade) cidade.value = dados.cidade;
                            if (estado && dados.estado) estado.value = dados.estado;

                            ajustar(alvo, 'nome', true);
                            ajustar(alvo, 'celular', dados.temCelular);
                            ajustar(alvo, 'cidade', dados.temCidade);
                            ajustar(alvo, 'estado', dados.temEstado);

                            window.pdzJogadores[alvo] = dados;
                            if (window.pdzAvaliarCategoria) window.pdzAvaliarCategoria();
                        } else if (dados.cpfInvalido) {
                            // Tem 11 números mas o dígito verificador não fecha. Dizer
                            // "não cadastrado" aqui convidaria a pessoa a cadastrar alguém
                            // com CPF inventado — que foi como nasceu o jogador ".".
                            delete window.pdzJogadores[alvo];
                            if (window.pdzAvaliarCategoria) window.pdzAvaliarCategoria();
                            status.innerHTML = '<span class="text-danger fw-semibold">'
                                + '<i class="bi bi-x-circle-fill"></i> Esse CPF não existe — confira os números.</span>';
                            camposDe(alvo).forEach(function (el) { el.value = ''; });
                            travar(alvo, true);
                        } else {
                            delete window.pdzJogadores[alvo];
                            if (window.pdzAvaliarCategoria) window.pdzAvaliarCategoria();
                            status.innerHTML = '<span class="text-warning-emphasis">'
                                + '<i class="bi bi-person-plus-fill"></i> CPF ainda não cadastrado — '
                                + 'preencha os dados abaixo e ele entra como pré-cadastro.</span>';
                            camposDe(alvo).forEach(function (el) { el.value = ''; });
                            travar(alvo, false);
                            if (nome) nome.focus();
                        }
                    })
                    .catch(function () {
                        // Sem resposta do servidor, deixar tudo trancado impediria a inscrição.
                        inputCpf.dataset.ultimoConsultado = '';
                        status.innerHTML = '<span class="text-danger">Não deu pra consultar o CPF agora — '
                            + 'confira os dados e siga.</span>';
                        travar(alvo, false);
                    });
            }

            // A formatação é do mascaras.js (data-mascara="cpf"), que também limpa o valor no
            // submit — aqui só se limpa o aviso enquanto o CPF ainda está incompleto.
            inputCpf.addEventListener('input', function () {
                if (inputCpf.value.replace(/\D/g, '').length < 11) {
                    status.innerHTML = '';
                    inputCpf.dataset.ultimoConsultado = '';
                    camposDe(alvo).forEach(function (el) { el.value = ''; });
                    travar(alvo, true);
                    delete window.pdzJogadores[alvo];
                    if (window.pdzAvaliarCategoria) window.pdzAvaliarCategoria();
                } else {
                    // No celular o blur às vezes não chega antes do envio.
                    consultar();
                }
            });

            inputCpf.addEventListener('blur', consultar);

            // Trocar de categoria muda a resposta de "já está inscrito?" pro MESMO CPF —
            // sem refazer a consulta, o aviso ficaria falando da categoria anterior.
            var selectCategoria = document.querySelector('#inscricao select[name="categoriaId"]');
            if (selectCategoria) {
                selectCategoria.addEventListener('change', function () {
                    inputCpf.dataset.ultimoConsultado = '';
                    consultar();
                });
            }
        });
    })();

    // ── Um clique é um clique ───────────────────────────────────────────────────────────
    //
    // ⚠️ Relato do evento de teste (07/08/2026): "cliquei pra me inscrever, não aconteceu
    // nada, cliquei 3 vezes — e a mesma dupla entrou 3 vezes". A causa da demora era o
    // servidor (aviso por SMTP dentro da requisição, já corrigido), mas o efeito só existiu
    // porque o botão ficava do mesmo jeito depois de tocado: sem retorno nenhum, tocar de
    // novo é o que qualquer pessoa faz.
    //
    // O `submit` só dispara DEPOIS da validação do navegador, então campo obrigatório em
    // branco não deixa o botão travado. E travar aqui não substitui a guarda do servidor —
    // ela é que segura o POST repetido de aba velha ou conexão que caiu no meio.
    (function () {
        document.querySelectorAll('form.pdz-form-inscricao').forEach(function (form) {
            form.addEventListener('submit', function () {
                var botao = form.querySelector('button[type="submit"]');
                if (!botao) return;

                botao.disabled = true;
                botao.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Inscrevendo…';
            });
        });
    })();

    // ── "Definir por CPF" também sabe juntar inscrições ─────────────────────────────────
    //
    // O servidor sempre soube (TrocarParceiro aceita juntarComInscricaoSolo) e a recusa
    // mandava MARCAR a caixa — que só existia na aba Inscreva-se. O organizador lia
    // "marque juntar com a inscrição que já existe" no aviso vermelho e não tinha o que
    // marcar: instrução apontando pra um controle inexistente.
    //
    // Aqui a caixa aparece sozinha assim que o CPF digitado for de alguém já inscrito
    // sozinho naquela categoria — ele não precisa nem saber que ela existe antes disso.
    (function () {
        var urlBusca = '@Url.Action("BuscarJogadorPorCpf", "Torneios")';

        document.querySelectorAll('.pdz-form-parceiro').forEach(function (form) {
            var inputCpf = form.querySelector('input[name="cpfNovoParceiro"]');
            var inputNome = form.querySelector('input[name="nomeNovoParceiro"]');
            var caixa = form.querySelector('.pdz-juntar-caixa');
            var quem = form.querySelector('.pdz-juntar-quem');
            var check = caixa ? caixa.querySelector('input[type="checkbox"]') : null;
            if (!inputCpf || !caixa || !check) return;

            function esconder() {
                caixa.classList.add('d-none');
                check.checked = false;
                quem.textContent = '';
            }

            function consultar() {
                var cpf = (inputCpf.value || '').replace(/\D/g, '');
                if (cpf.length !== 11) { esconder(); return; }
                if (inputCpf.dataset.ultimo === cpf) return;
                inputCpf.dataset.ultimo = cpf;

                // POST pelo mesmo motivo do bloco de inscrição: CPF não anda na barra de
                // endereço (ver o comentário lá em cima e BuscarJogadorPorCpf).
                fetch(urlBusca, {
                    method: 'POST',
                    headers: cabecalhoAntifalsificacao({ 'Content-Type': 'application/x-www-form-urlencoded' }),
                    body: 'cpf=' + cpf + '&categoriaId=' + form.dataset.categoria
                })
                    .then(function (r) { return r.json(); })
                    .then(function (d) {
                        // Nome preenchido sozinho pra quem já tem cadastro: o campo de nome
                        // ali do lado é só pra quem ainda NÃO tem, e deixá-lo em branco
                        // fazia o organizador achar que precisava digitar.
                        if (d && d.nome && inputNome && !inputNome.value) inputNome.value = d.nome;

                        if (d && d.jaInscritoSozinho) {
                            quem.textContent = 'A inscrição sozinha de ' + (d.nome || 'quem você digitou')
                                + ' sai e a dupla fica valendo — a vaga é a mesma, ninguém perde lugar.';
                            caixa.classList.remove('d-none');
                            // Já marcada: quem digitou o CPF de alguém inscrito sozinho está
                            // justamente tentando juntar os dois. Deixar desmarcada devolveria
                            // a mesma recusa que trouxe ele até aqui.
                            check.checked = true;
                        } else {
                            esconder();
                        }
                    })
                    .catch(function () { /* sem rede o servidor ainda recusa e explica */ });
            }

            inputCpf.addEventListener('blur', consultar);
            inputCpf.addEventListener('input', function () {
                if ((inputCpf.value || '').replace(/\D/g, '').length < 11) { esconder(); inputCpf.dataset.ultimo = ''; }
                else consultar();
            });
        });
    })();

    // ── Categoria mais fraca que a do cadastro ──────────────────────────────────────────
    // Quem marcou "sou 4ª" nas Preferências e se inscreve na 5ª ouve a pergunta antes de
    // confirmar. Não é trava: pode ser que o jogador tenha caído de nível, que o parceiro
    // seja mais fraco, ou que a 4ª nem exista neste torneio. A trava dura é outra e depende
    // do histórico (RestricaoCategoria, no servidor).
    (function () {
        var select = document.querySelector('select[name="categoriaId"]');
        var aviso = document.getElementById('pdzAvisoCategoria');
        if (!select || !aviso) return;

        // Mesma régua do servidor (EstatisticasService.OrdemCategoria). Duas cópias porque
        // uma é conta de tela e a outra é regra de negócio — se divergirem, o pior que
        // acontece é o aviso não aparecer.
        function forca(nome) {
            var n = nome || '';
            if (n.indexOf('Open') >= 0) return 8;
            if (n.indexOf('1ª') >= 0) return 7;
            if (n.indexOf('2ª') >= 0) return 6;
            if (n.indexOf('3ª') >= 0) return 5;
            if (n.indexOf('4ª') >= 0) return 4;
            if (n.indexOf('5ª') >= 0) return 3;
            if (n.indexOf('6ª') >= 0) return 2;
            if (n.indexOf('7ª') >= 0 || n.indexOf('Iniciantes') >= 0) return 1;
            return 0;
        }

        function avaliar() {
            var escolhida = select.options[select.selectedIndex]
                ? select.options[select.selectedIndex].text : '';
            var forcaEscolhida = forca(escolhida);

            var frases = Object.keys(window.pdzJogadores || {})
                .map(function (alvo) { return window.pdzJogadores[alvo]; })
                .filter(function (j) { return j && j.forcaDeclarada > 0 && forcaEscolhida > 0; })
                .filter(function (j) { return j.forcaDeclarada > forcaEscolhida; })
                .map(function (j) {
                    return 'No cadastro, <strong>' + j.nome + '</strong> colocou que é '
                        + j.categoriaDeclarada + '. Por que quer se inscrever na ' + escolhida + '?';
                });

            aviso.innerHTML = frases.length
                ? '<i class="bi bi-question-circle-fill me-1"></i>' + frases.join('<br>')
                : '';
            aviso.style.display = frases.length ? '' : 'none';
        }

        window.pdzAvaliarCategoria = avaliar;
        select.addEventListener('change', avaliar);
    })();

    // ── "Sou eu" e o aviso de inscrever outra pessoa ────────────────────────────────────
    (function () {
        var botao = document.getElementById('pdzSouEu');
        var meuCpf = botao ? botao.dataset.cpf : '';
        var cpf1 = document.querySelector('.js-cpf[data-alvo="1"]');
        if (!cpf1) return;

        if (botao) {
            botao.addEventListener('click', function () {
                // Desfaz uma escolha por nome antes: os dois caminhos gravam a mesma pessoa,
                // e o Id vence o CPF no servidor — o CPF preenchido aqui seria ignorado em
                // silêncio, com a tela mostrando "Sou eu" e o nome de outra pessoa ao lado.
                if (window.pdzBuscaJog1) window.pdzBuscaJog1.limpar();

                cpf1.value = meuCpf;
                // 'input' formata a máscara E dispara a consulta que preenche o resto.
                cpf1.dispatchEvent(new Event('input', { bubbles: true }));
            });
        }

        // Só pergunta quem tem com o que comparar: visitante sem cadastro completo não.
        if (!meuCpf) return;

        var form = cpf1.closest('form');
        if (!form) return;

        // A pergunta depende do CPF digitado, então os atributos são escritos AGORA, no
        // submit. Este ouvinte está no <form> e o do modal está no document: o de dentro
        // corre primeiro, escreve o data-confirmar, e o de fora encontra tudo pronto.
        // Ver wwwroot/js/confirmar.js.
        form.addEventListener('submit', function () {
            var digitado = (cpf1.value || '').replace(/\D/g, '');

            if (!digitado || digitado === meuCpf) {
                delete form.dataset.confirmar;   // é você mesmo: não pergunta nada
                return;
            }

            var quem = (window.pdzJogadores && window.pdzJogadores['1'] && window.pdzJogadores['1'].nome)
                ? window.pdzJogadores['1'].nome : 'outra pessoa';

            form.dataset.confirmarTitulo = 'Inscrever ' + quem + '?';
            form.dataset.confirmar = 'O CPF não é o seu. Se essa pessoa tiver cadastro no Padelizou, ela recebe um aviso de que foi inscrita.';
            form.dataset.confirmarOk = 'Inscrever';
        });
    })();

    // ── Achar o jogador pelo NOME ───────────────────────────────────────────────────────
    //
    // Quase ninguém sabe o CPF do outro de cabeça, e a inscrição parava no meio esperando uma
    // mensagem no WhatsApp. Três letras e a lista aparece; escolhido o nome, o servidor
    // completa o resto pelo Id (DuplasController.Create).
    //
    // A busca devolve só Id, nome e foto — CPF e celular de terceiro não saem do servidor.
    //
    // ⚠️ UMA função pros DOIS lados da dupla (o Felipe pediu o mesmo pro jogador 1 em
    // 14/08/2026). Copiar o bloco e trocar os ids seria a segunda cópia da mesma regra: o
    // dia em que a busca mudasse — outro endpoint, outro mínimo de letras, outro jeito de
    // esconder o CPF — um dos dois lados ficaria pra trás, e ninguém repara logo.
    // Cada campo pode vir como id (quando é único na página) ou já como elemento — os
    // formulários de parceiro se repetem uma vez por dupla, e ali não há id que preste.
    function pdzEl(x) { return typeof x === 'string' ? document.getElementById(x) : (x || null); }

    function pdzLigarBuscaPorNome(ids) {
        var campo = pdzEl(ids.campo);
        if (!campo) return;

        var lista = pdzEl(ids.lista);
        var idOculto = pdzEl(ids.idOculto);
        var escolhido = pdzEl(ids.escolhido);
        var escolhidoNome = pdzEl(ids.escolhidoNome);
        var trocar = pdzEl(ids.trocar);
        var porCpf = pdzEl(ids.porCpf);
        var dica = pdzEl(ids.dica);
        var caixa = pdzEl(ids.caixa);
        var url = '@Url.Action("BuscarJogadorParaOrganizador", "Torneios")';
        var timer = null;

        // Com o parceiro escolhido, os campos de CPF somem E perdem o required — senão o
        // navegador barra o envio reclamando de um campo que a pessoa nem vê.
        function mostrarCamposDeCpf(mostrar) {
            porCpf.style.display = mostrar ? '' : 'none';
            porCpf.querySelectorAll('input').forEach(function (input) {
                if (!mostrar) {
                    if (input.hasAttribute('required')) {
                        input.dataset.eraRequiredCpf = '1';
                        input.removeAttribute('required');
                    }
                    input.value = '';
                } else if (input.dataset.eraRequiredCpf === '1') {
                    input.setAttribute('required', 'required');
                }
            });
        }

        function fecharLista() {
            lista.classList.add('d-none');
            lista.innerHTML = '';
        }

        function escolher(jogador) {
            idOculto.value = jogador.id;
            escolhidoNome.textContent = jogador.exibicao || jogador.nome;
            escolhido.classList.remove('d-none');
            campo.classList.add('d-none');
            dica.classList.add('d-none');
            mostrarCamposDeCpf(false);
            fecharLista();
            if (ids.aoEscolher) ids.aoEscolher(jogador);
        }

        trocar.addEventListener('click', function () {
            idOculto.value = '';
            escolhido.classList.add('d-none');
            campo.classList.remove('d-none');
            dica.classList.remove('d-none');
            campo.value = '';
            mostrarCamposDeCpf(true);
            campo.focus();
            if (ids.aoLimpar) ids.aoLimpar();
        });

        campo.addEventListener('input', function () {
            var termo = campo.value.trim();
            clearTimeout(timer);

            if (termo.length < 3) { fecharLista(); return; }

            // Espera a digitação parar: sem isso são cinco consultas pra escrever "Felipe".
            timer = setTimeout(function () {
                fetch(url + '?termo=' + encodeURIComponent(termo) + (ids.extra || ''))
                    .then(function (r) { return r.ok ? r.json() : []; })
                    .then(function (achados) {
                        lista.innerHTML = '';
                        if (!achados.length) {
                            lista.innerHTML = '<div class="list-group-item small text-muted">'
                                + 'Ninguém com esse nome. Preencha o CPF abaixo pra cadastrar.</div>';
                            lista.classList.remove('d-none');
                            return;
                        }
                        achados.forEach(function (j) {
                            var item = document.createElement('button');
                            item.type = 'button';
                            item.className = 'list-group-item list-group-item-action d-flex align-items-center gap-2';
                            var foto = j.fotoPerfil || '/img/default-avatar.png';
                            item.innerHTML = '<img src="' + foto + '" class="rounded-circle" '
                                + 'style="width:28px;height:28px;object-fit:cover;" alt="">'
                                + '<span>' + (j.exibicao || j.nome) + '</span>';
                            item.addEventListener('click', function () { escolher(j); });
                            lista.appendChild(item);
                        });
                        lista.classList.remove('d-none');
                    })
                    .catch(fecharLista);
            }, 250);
        });

        // Clique fora fecha — a lista flutua sobre o formulário.
        document.addEventListener('click', function (e) {
            if (caixa && !caixa.contains(e.target)) fecharLista();
        });

        // O "Sou eu" precisa desfazer uma escolha por nome antes de preencher o CPF: os dois
        // caminhos gravam a MESMA pessoa, e deixar os dois marcados ao mesmo tempo deixaria
        // na tela um nome escolhido que o servidor ia ignorar (o Id vence o CPF).
        return { limpar: function () { if (!escolhido.classList.contains('d-none')) trocar.click(); } };
    }

    // Em window porque quem precisa dela é o "Sou eu", que vive noutro bloco acima.
    window.pdzBuscaJog1 = pdzLigarBuscaPorNome({
        caixa: 'pdzBuscaJog1', campo: 'pdzJog1Nome', lista: 'pdzJog1Lista', idOculto: 'pdzJog1Id',
        escolhido: 'pdzJog1Escolhido', escolhidoNome: 'pdzJog1EscolhidoNome',
        trocar: 'pdzJog1Trocar', porCpf: 'pdzCamposPorCpf1', dica: 'pdzJog1Dica',
    });

    pdzLigarBuscaPorNome({
        caixa: 'pdzBuscaParceiro', campo: 'pdzParceiroNome', lista: 'pdzParceiroLista', idOculto: 'pdzParceiroId',
        escolhido: 'pdzParceiroEscolhido', escolhidoNome: 'pdzParceiroEscolhidoNome',
        trocar: 'pdzParceiroTrocar', porCpf: 'pdzCamposPorCpf', dica: 'pdzParceiroDica',
    });

    // ── Definir/trocar parceiro pelo NOME, e não só por CPF ─────────────────────────────
    //
    // Pedido do Felipe (20/08/2026), olhando o painel do organizador: o campo de nome que
    // existia ali era só pra CADASTRAR quem ainda não tem conta — digitar "andre" nele não
    // sugeria ninguém. Agora sugere, com a MESMA função da aba Inscreva-se: um formulário
    // por dupla, todos ligados por classe.
    //
    // ⚠️ A CAIXA "JUNTAR" PRECISA VIR JUNTO. Quem a fazia aparecer era o CPF digitado; sem
    // isto, escolher pelo nome alguém já inscrito sozinho levava à recusa do servidor
    // mandando marcar uma caixa que nunca apareceu na tela — exatamente o beco sem saída que
    // o bloco "Definir por CPF também sabe juntar inscrições" existiu pra fechar. Por isso a
    // busca leva a categoria e a resposta traz `jaInscritoSozinho`.
    document.querySelectorAll('.pdz-form-parceiro').forEach(function (form) {
        var campo = form.querySelector('.pdz-bp-campo');
        if (!campo) return;

        var duplaId = form.querySelector('input[name="duplaId"]');
        var juntarCaixa = form.querySelector('.pdz-juntar-caixa');
        var juntarQuem = form.querySelector('.pdz-juntar-quem');
        var juntarCheck = juntarCaixa ? juntarCaixa.querySelector('input[type="checkbox"]') : null;

        function esconderJuntar() {
            if (!juntarCaixa || !juntarCheck) return;
            juntarCaixa.classList.add('d-none');
            juntarCheck.checked = false;
            if (juntarQuem) juntarQuem.textContent = '';
        }

        pdzLigarBuscaPorNome({
            caixa: form.querySelector('.pdz-bp-caixa'),
            campo: campo,
            lista: form.querySelector('.pdz-bp-lista'),
            idOculto: form.querySelector('.pdz-bp-id'),
            escolhido: form.querySelector('.pdz-bp-escolhido'),
            escolhidoNome: form.querySelector('.pdz-bp-escolhido-nome'),
            trocar: form.querySelector('.pdz-bp-trocar'),
            porCpf: form.querySelector('.pdz-bp-por-cpf'),
            dica: form.querySelector('.pdz-bp-dica'),
            extra: '&categoriaId=' + (form.dataset.categoria || '')
                 + (duplaId ? '&ignorarDuplaId=' + duplaId.value : ''),
            aoEscolher: function (j) {
                if (!juntarCaixa || !juntarCheck) return;
                if (!j.jaInscritoSozinho) { esconderJuntar(); return; }

                if (juntarQuem) {
                    juntarQuem.textContent = 'A inscrição sozinha de ' + (j.exibicao || j.nome)
                        + ' sai e a dupla fica valendo — a vaga é a mesma, ninguém perde lugar.';
                }
                juntarCaixa.classList.remove('d-none');
                // Já marcada, pelo mesmo motivo do caminho por CPF: quem escolheu alguém
                // inscrito sozinho está justamente tentando juntar os dois.
                juntarCheck.checked = true;
            },
            aoLimpar: esconderJuntar,
        });
    });

    // "Ainda não tenho parceiro": esconde os campos do jogador 2. O required precisa sair
    // junto, senão o navegador recusa o envio apontando pra um campo invisível.
    (function () {
        var check = document.getElementById('pdzSemParceiro');
        if (!check) return;

        var campos = document.getElementById('pdzCamposParceiro');
        var aviso = document.getElementById('pdzAvisoSemParceiro');
        var badge = document.getElementById('pdzBadgeSemParceiro');
        // "De que lado você joga?" é pergunta de quem está SOZINHO: com o parceiro definido,
        // a dupla se organiza por fora e o campo vira ruído no formulário.
        var lado = document.getElementById('pdzLadoSolo');

        function aplicar() {
            var solo = check.checked;
            campos.style.display = solo ? 'none' : '';
            aviso.style.display = solo ? '' : 'none';
            badge.style.display = solo ? '' : 'none';
            if (lado) lado.style.display = solo ? '' : 'none';

            campos.querySelectorAll('input').forEach(function (input) {
                if (solo) {
                    if (input.hasAttribute('required')) {
                        input.dataset.eraRequired = '1';
                        input.removeAttribute('required');
                    }
                    input.value = '';
                } else if (input.dataset.eraRequired === '1') {
                    input.setAttribute('required', 'required');
                }
            });
        }

        check.addEventListener('change', aplicar);
        aplicar(); // respeita o estado se o navegador restaurar o formulário
    })();

    /*
        Clique repetido no botão de inscrever. Em 03/08/2026 o Lucas entrou TRÊS vezes na
        6ª Masculina — inscrições criadas com 1,7s e 2,2s de diferença. Não foi má-fé nem
        confusão: a pessoa clicou, a página demorou pra responder, e ela clicou de novo.

        A regra do servidor (Services/InscricaoRepetida) já barra o 2º e o 3º envio, mas
        barrar é a segunda melhor resposta — a pessoa levaria um erro vermelho por ter feito
        a coisa mais natural do mundo. Aqui o botão simplesmente para de aceitar clique e
        diz que está enviando.

        O `setTimeout(0)` é o cuidado que faz isso funcionar: esta tela tem outro handler de
        submit que pode CANCELAR o envio (o "você está inscrevendo outra pessoa, tem
        certeza?"). Desligar o botão na hora deixaria ele morto pra sempre quando a pessoa
        respondesse "não". Esperando um tique, todos os handlers já rodaram e dá pra checar
        se o envio foi mesmo em frente.
    */
    document.querySelectorAll('form[action*="/Duplas/Create"], form[action*="/InscreverIndividual"]').forEach(function (form) {
        form.addEventListener('submit', function (ev) {
            if (ev.defaultPrevented) return;

            setTimeout(function () {
                if (ev.defaultPrevented) return;

                form.querySelectorAll('button[type="submit"]').forEach(function (botao) {
                    botao.disabled = true;
                    botao.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Enviando…';
                });
            }, 0);
        });
    });
</script>
@*
    Gerenciar Inscritos: a lista que o organizador olha com 25 linhas na tela. O _Layout só
    tem seção "Scripts", então o CSS fica no corpo mesmo — em vez de mexer no site.css, que
    todas as telas carregam, por causa de uma.
*@
<style>
    /* A barra de ações não encolhe: sem isto o flex espremia os botões pra caber o nome
       comprido, e "Marcar como pago" quebrava no meio de si mesmo.

       ⚠️ SÓ NO DESKTOP. Abaixo de 992px a linha vira coluna (`flex-column`), a barra já ocupa
       a largura inteira e não há nome nenhum disputando espaço com ela — o `flex-shrink: 0`
       ali não protegia de nada e ainda ajudava a empurrar o quarto botão pra fora da tela. */
    @@media (min-width: 992px) {
        .pdz-inscrito-acoes { flex-shrink: 0; }
    }

    /* `min-width: 0` libera o truncamento: sem ele um nome longo EMPURRA a barra de ações
       pra fora, e a linha inteira estica. Com ele, o nome corta com reticências e a coluna
       de botões fica no lugar em todas as linhas. Precisa estar nos DOIS níveis — o item
       flex de fora e o de dentro —, senão o de fora continua crescendo. */
    .pdz-inscrito-esquerda, .pdz-inscrito-nome { min-width: 0; }

    /* Só cortar onde a linha é lado a lado. No celular a barra de ações desce pra baixo do
       nome, sobra largura inteira, e cortar ali seria esconder à toa. */
    @@media (min-width: 992px) {
        .pdz-inscrito-nome {
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
    }
</style>

@*
    A HASH DA URL ABRE A ABA CORRESPONDENTE.

    O botão "Convidar" manda `...\Details\7#inscricao`; o formulário de impedimento da aba
    Pagamentos volta em `...\Details\7#pagamentos`. Sem este script a hash não faz nada — o
    Bootstrap 5 não lê a URL — e quem chega cai na aba padrão. Um convite pra se inscrever caía
    em "Inscritos" (a lista de quem JÁ entrou); um redirect de volta da aba Pagamentos caía em
    "Inscritos" também, perdendo o lugar de onde a pessoa tinha saído.

    ⚠️ GENÉRICO DE PROPÓSITO, e não um `if` por aba: a hash já É o seletor
    (`data-bs-target="#pagamentos"` existe pra CSS/Bootstrap não por acaso — é o mesmo texto
    que a URL carrega). Uma aba nova que precise disto não pede uma linha a mais aqui.

    ⚠️ DOMContentLoaded, e não código solto: o corpo da view é renderizado ANTES do
    bootstrap.bundle.js do _Layout, então `window.bootstrap` ainda não existe quando esta
    linha é lida. Mesmo motivo e mesma forma do script de abas do Ranking.

    Quando a aba da hash não existe nesta página (por status, por formato, por quem está
    olhando), o seletor não acha nada e o script sai calado, deixando a página na aba padrão.
*@
<script>
    document.addEventListener('DOMContentLoaded', function () {
        if (!location.hash || !window.bootstrap) return;

        var aba = document.querySelector('#torneioTabs [data-bs-target="' + location.hash + '"]');
        if (aba) bootstrap.Tab.getOrCreateInstance(aba).show();
    });
</script>

@*
    A HASH `#jogo-123` LEVA AO CARD GRANDE DAQUELE JOGO.

    🗣️ Felipe, 11/09/2026, com o print do Grupo C: *"permita clicar no aovivo e ir para a
    pagina do aovivo aonde esta o jogo"*. O card pequeno do grupo e o card grande com placar,
    cronômetro e palpitrômetro moram na MESMA página, em abas diferentes — daí uma hash, e não
    uma URL nova: nada recarrega, o <iframe> da transmissão não reinicia (é o motivo de
    js/jogos-ao-vivo-atualiza.js existir) e o botão de voltar devolve a pessoa ao grupo.

    ⚠️ DUAS ABAS, E SÓ DEPOIS O ROLAR: o card está dentro da sub-aba de uma aba. Elemento em
    `display: none` não tem posição na tela, e `scrollIntoView` nele não rola nada.

    ⚠️ `hashchange` ALÉM do DOMContentLoaded: clicar numa hash com a página já aberta não
    dispara carregamento nenhum. Sem ele o primeiro clique funcionaria (a hash muda com a
    página nascendo) e o segundo — voltar e clicar noutro jogo — não faria nada.

    ⚠️ ESTE SCRIPT RODA DEPOIS do js/jogos-abas.js, que restaura a sub-aba lembrada da sessão:
    `DOMContentLoaded` só dispara quando todo <script src> do corpo já executou. É essa ordem
    que faz o clique vencer a memória — quem pediu ESTE jogo não quer a aba de ontem.
*@
<script>
    // ⚠️ `depois` NÃO É ENFEITE: `Tab.show()` do Bootstrap 5 é ASSÍNCRONO quando há animação.
    // Ele tira o `active` da aba velha, espera os 150ms do fade DELA e só então acende a nova —
    // então, na linha seguinte ao `show()`, o painel de destino ainda é `display: none`, o card
    // dentro dele mede 0x0 e `scrollIntoView` num elemento sem posição não rola nada. Quem
    // desliga animação no sistema (`prefers-reduced-motion`) não veria o defeito, e é
    // exatamente o tipo de coisa que passa no teste de quem desenvolveu e falha no celular de
    // quem usa. `shown.bs.tab` é o aviso de que o painel existe na tela.
    function pdzMostrarAba(lista, alvo, depois) {
        var botao = document.querySelector(lista + ' [data-bs-target="' + alvo + '"]');
        if (!botao) return;

        // Já é a aba aberta: nenhum evento vai nascer, e esperar por ele seria esperar pra
        // sempre.
        if (botao.classList.contains('active')) {
            if (depois) depois();
            return;
        }

        if (depois) botao.addEventListener('shown.bs.tab', depois, { once: true });
        bootstrap.Tab.getOrCreateInstance(botao).show();
    }

    function pdzIrProJogoDaHash() {
        // O formato é conferido antes de virar seletor: a hash é texto que qualquer um põe na
        // URL, e `querySelector` com lixo dentro estoura.
        if (!/^#jogo-\d+$/.test(location.hash) || !window.bootstrap) return;

        var alvo = location.hash;

        pdzMostrarAba('#torneioTabs', '#jogosDoTorneio', function () {
            pdzMostrarAba('#jogosTabs', '#aovivo', function () {
                // O card pode não estar na página: os filtros da aba Jogos (clube, quadra,
                // fase, "meus jogos") recortam a lista do ao vivo. Abrir a aba certa já é o
                // destino possível — o silêncio aqui é o comportamento, não um erro engolido.
                var card = document.querySelector(alvo);
                if (card) card.scrollIntoView({ behavior: 'smooth', block: 'center' });
            });
        });
    }

    document.addEventListener('DOMContentLoaded', pdzIrProJogoDaHash);
    window.addEventListener('hashchange', pdzIrProJogoDaHash);
</script>
