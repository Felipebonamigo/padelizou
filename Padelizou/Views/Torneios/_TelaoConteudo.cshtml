@model Padelizou.Services.TelaoDoTorneio.Quadro
@using Padelizou.Services
@*
    O MIOLO DO TELÃO (18/11/2026) — é o pedaço que wwwroot/js/telao.js busca a cada 20 s e troca,
    sem recarregar a página. Só leitura: nenhum botão, nenhum formulário (a TV não tem dedo).
    Regras dos três blocos: Services/TelaoDoTorneio.

    O DESENHO É O DO FELIPE (18/11/2026, com um modelo pronto: *"algo assim fica mais bonito
    visualmente"*): as quadras ao vivo LADO A LADO no alto, e embaixo dois painéis — próximos em
    lista e finalizados. A TV não rola, então cada bloco mostra o que cabe e corta o resto:
    até 4 quadras, 3 próximos e 2 finalizados (o que o modelo mostra).
*@
@{
    var sedes = ViewBag.Sedes as SedesDoTorneio;
    var numeroNaFase = ViewBag.NumeroNaFase as Dictionary<int, int> ?? new Dictionary<int, int>();
    var palpites = ViewBag.Palpites as Dictionary<int, Padelizou.ViewModels.PalpiteResumoVM>
                   ?? new Dictionary<int, Padelizou.ViewModels.PalpiteResumoVM>();

    string Fase(Padelizou.Models.Partida p) =>
        FaseNaTela.Rotulo(p.Fase, numeroNaFase.TryGetValue(p.Id, out var n) ? n : null);
    // O título do card é a QUADRA; com mais de um clube, o clube vai junto (senão "Quadra 1"
    // de dois clubes seriam o mesmo nome na TV).
    string Quadra(Padelizou.Models.Partida p) =>
        (sedes?.MaisDeUmClube == true ? LugarDoJogo.Etiqueta(sedes, p.NomeQuadra, p.CategoriaId, p.ClubeId) : null)
        ?? (string.IsNullOrWhiteSpace(p.NomeQuadra) ? "Quadra" : p.NomeQuadra!);
    string Nome(Padelizou.Models.Dupla? d) => d?.NomeDeExibicao ?? "A definir";
    // "Fulano & Ciclano" quebra depois do "&": duas linhas curtas leem melhor de longe.
    Microsoft.AspNetCore.Html.IHtmlContent NomeEmDuasLinhas(Padelizou.Models.Dupla? d)
    {
        var nome = Nome(d);
        var i = nome.IndexOf(" & ", StringComparison.Ordinal);
        return i < 0
            ? new Microsoft.AspNetCore.Html.HtmlString(System.Net.WebUtility.HtmlEncode(nome))
            : new Microsoft.AspNetCore.Html.HtmlString(
                System.Net.WebUtility.HtmlEncode(nome.Substring(0, i + 2)) + "<br>"
                + System.Net.WebUtility.HtmlEncode(nome.Substring(i + 3)));
    }

    var aoVivo = Model.AoVivo.Take(4).ToList();
    var colunas = Math.Max(1, Math.Min(aoVivo.Count, 4));
}

<div class="tl-faixa">
    <h2><span class="tl-ponto"></span> JOGOS AO VIVO</h2>
    <span class="tl-contagem">@(Model.AoVivo.Count == 1 ? "1 QUADRA" : Model.AoVivo.Count + " QUADRAS")</span>
</div>

<section class="tl-quadras" style="grid-template-columns: repeat(@colunas, 1fr);">
    @if (aoVivo.Count == 0)
    {
        <div class="tl-card-vivo tl-vazio-vivo">Nenhum jogo em quadra agora.</div>
    }
    @foreach (var p in aoVivo)
    {
        bool emTieBreak = TieBreakDoJogo.Houve(p.PontosTieBreak1, p.PontosTieBreak2);
        <article class="tl-card-vivo">
            <div class="tl-card-topo">
                <span class="tl-quadra"><span class="tl-icone-quadra"></span>@Quadra(p).ToUpperInvariant()</span>
                <span class="tl-pilula"><span class="tl-pilula-ponto"></span>AO VIVO</span>
            </div>
            <div class="tl-sub">@(p.Categoria?.Nome) · @Fase(p)</div>
            <div class="tl-linha">
                <span class="tl-dupla">@NomeEmDuasLinhas(p.Dupla1)</span>
                <span class="tl-placar">@(p.GamesDupla1 ?? 0)</span>
            </div>
            <div class="tl-linha tl-linha-2">
                <span class="tl-dupla">@NomeEmDuasLinhas(p.Dupla2)</span>
                <span class="tl-placar">@(p.GamesDupla2 ?? 0)</span>
            </div>
            @if (emTieBreak)
            {
                <div class="tl-tiebreak">Tie-break @(p.PontosTieBreak1 ?? 0) – @(p.PontosTieBreak2 ?? 0)</div>
            }
            @if (palpites.TryGetValue(p.Id, out var palpite) && palpite.TotalVotos > 0)
            {
                <div class="tl-palpite">
                    <div class="tl-palpite-barra">
                        <span style="width:@(palpite.PercentualDupla1.ToString(System.Globalization.CultureInfo.InvariantCulture))%"></span>
                    </div>
                    <div class="tl-palpite-numeros">
                        <span>@palpite.PercentualDupla1.ToString("0")%</span>
                        <span>Palpitômetro · @palpite.TotalVotos voto(s)</span>
                        <span>@palpite.PercentualDupla2.ToString("0")%</span>
                    </div>
                </div>
            }
        </article>
    }
</section>

<div class="tl-paineis">
    <section class="tl-painel tl-painel-proximos">
        <h3><span class="tl-icone">⏭</span> PRÓXIMOS JOGOS</h3>
        @if (Model.Proximos.Count == 0)
        {
            <p class="tl-vazio">Nenhum jogo agendado.</p>
        }
        @foreach (var p in Model.Proximos.Take(3))
        {
            var hora = p.HorarioPrevisto!.Value;
            <div class="tl-proximo">
                <span class="tl-hora">@hora.ToString("HH:mm")@(hora.Date != DateTime.Today ? " " + hora.ToString("dd/MM") : "")</span>
                <span class="tl-proximo-texto">
                    <span class="tl-sub">@Quadra(p) · @(p.Categoria?.Nome) · @Fase(p)</span>
                    <span class="tl-confronto"><b>@Nome(p.Dupla1)</b> <i>vs</i> <b>@Nome(p.Dupla2)</b></span>
                </span>
            </div>
        }
    </section>

    <section class="tl-painel tl-painel-finalizados">
        <h3><span class="tl-icone tl-icone-ok">✓</span> FINALIZADOS</h3>
        @if (Model.Resultados.Count == 0)
        {
            <p class="tl-vazio">Nenhum jogo terminou ainda.</p>
        }
        @foreach (var p in Model.Resultados.Take(2))
        {
            bool venceu1 = p.VencedorId != null && p.VencedorId == p.Dupla1Id;
            bool venceu2 = p.VencedorId != null && p.VencedorId == p.Dupla2Id;
            <div class="tl-finalizado">
                <div class="tl-sub">@(p.Categoria?.Nome) · @Fase(p)@(TieBreakDoJogo.Houve(p.PontosTieBreak1, p.PontosTieBreak2) ? " · " + TieBreakDoJogo.Etiqueta(p.PontosTieBreak1, p.PontosTieBreak2) : "")</div>
                <div class="tl-res @(venceu1 ? "tl-venceu" : "")"><span>@Nome(p.Dupla1)</span><b>@(p.GamesDupla1 ?? 0)</b></div>
                <div class="tl-res @(venceu2 ? "tl-venceu" : "")"><span>@Nome(p.Dupla2)</span><b>@(p.GamesDupla2 ?? 0)</b></div>
            </div>
        }
    </section>
</div>
