@using Padelizou.ViewModels
@{
    ViewData["Title"] = "Jogos do Torneio";
    var torneio = ViewBag.Torneio as Torneio;
}

@if (torneio == null)
{
    @* `as` devolve nulo se a ação esquecer de preencher a ViewBag — e aí a página inteira caía
       em erro 500. Vazio com explicação é ruim; erro 500 é pior, e some o menu junto. *@
    <partial name="_Vazio" model='@(new EstadoVazio("Não consegui carregar este torneio.", "Ver todos os torneios", "Torneios", "Index"))' />
    return;
}

<div class="mb-3">
    <h2 class="mb-0">🏆 @torneio.Nome - Partidas</h2>
</div>

@* ── A SAÍDA DESTA TELA ───────────────────────────────────────────────────────────────────
   🗣️ Deivid Santos, 10/09/2026, com o print desta página: *"Eu to nessa tela"* … *"Ta ruim de
   achar o chaveamento"*.

   Esta página é o destino de QUATRO avisos diferentes (ver Torneio.ChavesAvisadasEm e
   QuadraAtrasadaBackgroundService): quem toca no push cai direto aqui, sem passar pelo
   /Torneios/Details — e as abas mãe (Inscritos, Chaves e Grupos, Times) só existem lá. Sem
   estes dois botões, o caminho pro chaveamento era voltar pro torneio adivinhando que ele
   existe.

   A hash `#grupos` é o que abre a aba certa do outro lado (o script no fim do Details.cshtml
   lê a URL — o Bootstrap 5 não faz isso sozinho). *@
@{
    // Chave ainda em aprovação nesta tela só acontece pra quem organiza: a ação Jogos manda
    // todo mundo mais de volta pro Details antes de renderizar (ver TorneiosController.Jogos).
    bool chaveAberta = AbaDeChavesEGrupos.Existe(torneio, podeAprovarChaves: true);
}
<div class="d-flex flex-wrap gap-2 mb-4">
    <a asp-action="Details" asp-route-id="@torneio.Id" class="btn btn-sm btn-outline-secondary rounded-pill">
        <i class="bi bi-arrow-left"></i> Torneio
    </a>
    @if (chaveAberta)
    {
        <a asp-action="Details" asp-route-id="@torneio.Id" asp-fragment="grupos"
           class="btn btn-sm btn-outline-primary rounded-pill fw-bold">
            <i class="bi bi-layout-split"></i> Chaves e Grupos
        </a>
    }
</div>

<partial name="_JogosDoTorneio" model='("Jogos", torneio.Id)' />

<partial name="_ModalVerVotos" />
@section Scripts {
    <script src="~/js/cronometro-jogos.js" asp-append-version="true"></script>
    <script src="~/js/palpitrometro.js" asp-append-version="true"></script>
    @* asp-append-version obrigatório: o Service Worker guarda script em cache e sem a versão
       o organizador fica preso no JS velho indefinidamente. *@
    <script src="~/js/placar-ao-vivo.js" asp-append-version="true"></script>
    <script src="~/js/jogos-ao-vivo-atualiza.js" asp-append-version="true"></script>
    <script src="~/js/saque-ao-vivo.js" asp-append-version="true"></script>
    <script src="~/js/seguir-partida-ao-vivo.js" asp-append-version="true"></script>
    <script src="~/js/jogos-abas.js" asp-append-version="true"></script>
    <script src="~/js/manter-posicao-na-lista.js" asp-append-version="true"></script>
}
