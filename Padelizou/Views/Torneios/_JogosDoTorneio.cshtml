@using Padelizou.ViewModels
@using JogoQueVem = Padelizou.Services.ProximasFasesDaChave.JogoQueVem
@model (string TargetAction, int TorneioId)
@functions {
    // Converte os formatos comuns de link do YouTube (watch?v=, youtu.be/, /live/, /embed/) pro
    // ID do vídeo, pra dar pra embutir com <iframe>. Retorna null se não reconhecer o link (nesse
    // caso a transmissão vira só um botão "assistir" abrindo em outra aba).
    private static string? ExtrairYoutubeId(string? url)
    {
        if (string.IsNullOrWhiteSpace(url)) return null;
        var padroes = new[]
        {
            @"youtu\.be/([\w-]{6,})",
            @"youtube\.com/watch\?v=([\w-]{6,})",
            @"youtube\.com/live/([\w-]{6,})",
            @"youtube\.com/embed/([\w-]{6,})",
        };
        foreach (var padrao in padroes)
        {
            var m = System.Text.RegularExpressions.Regex.Match(url, padrao);
            if (m.Success) return m.Groups[1].Value;
        }
        return null;
    }
}
@{
    var aoVivoList = ViewBag.AoVivo as List<Partida> ?? new();
    // Placar ao vivo na tela de bloqueio — quais destes jogos EU já sigo (server, não JS: ver
    // TorneiosController.CarregarViewBagJogosAsync pro porquê).
    var partidasQueSigo = ViewBag.PartidasQueSigo as HashSet<int> ?? new HashSet<int>();
    var agendadasList = ViewBag.Agendadas as List<Partida> ?? new();
    var finalizadasList = ViewBag.Finalizadas as List<Partida> ?? new();
    // As fases do mata-mata que ainda não existem no banco (Semifinal, Final): o motor só
    // cria a rodada quando a anterior fecha, e sem isto elas não apareciam pra ninguém.
    var jogosQueVem = ViewBag.JogosQueVem as List<JogoQueVem> ?? new();
    // Só existe no Americano — nos outros formatos a aba nem aparece. O individual conta por
    // JOGADOR; o de duplas conta por DUPLA (a dupla lá é fixa).
    var classificacaoAmericano = ViewBag.ClassificacaoAmericano
        as List<Padelizou.ViewModels.ClassificacaoAmericanaDaCategoriaVM>;
    var classificacaoAmericanoDuplas = ViewBag.ClassificacaoAmericanoDuplas
        as Dictionary<string, List<Padelizou.Services.TabelaDoAmericanoDeDuplas.Linha>>;
    bool desempatePrevisto = ViewBag.DesempateAmericano == true;
    bool ehOrganizador = ViewBag.EhOrganizador == true;

    // O organizador abriu a marcação de placar (Services/QuemMarcaOPlacar)? Quem entra por
    // aqui ganha SÓ o lápis (e o play, na linha) — o salvar em lote, o finalizar e o
    // desfazer continuam da organização, e o servidor confere tudo de novo em cada POST.
    var modoQuemMarca = ViewBag.QuemMarcaPlacar as string;
    bool ehInscritoDoTorneio = ViewBag.EhInscritoDoTorneio == true;
    bool defaultAoVivo = aoVivoList.Count > 0;
    var palpites = ViewBag.Palpites as Dictionary<int, PalpiteResumoVM> ?? new Dictionary<int, PalpiteResumoVM>();
    int? meuId = ViewBag.MeuId as int?;
    var categoriasDoTorneio = ViewBag.CategoriasDoTorneio as List<Padelizou.Models.Categoria> ?? new();
    var categoriaFiltroAtual = (ViewBag.CategoriaFiltroAtual as int[]) ?? Array.Empty<int>();
    // As quadras que o torneio usa — a lista do "mudar de quadra".
    var quadrasDoTorneio = ViewBag.QuadrasDoTorneio as List<string> ?? new List<string>();
    // Os horários que ESTE torneio usa — a lista do "definir horário" (Services/HorariosDaGrade).
    var slotsDaGrade = ViewBag.SlotsDaGrade as List<Padelizou.Services.HorariosDaGrade.Slot>
        ?? new List<Padelizou.Services.HorariosDaGrade.Slot>();

    // De qual tela esta lista está sendo mostrada. As partials filhas (_JogoEmLinha) leem
    // daqui pra devolver o organizador pra ESTA página depois de uma ação — a página do
    // torneio tem as abas mãe, e /Torneios/Jogos é só a lista.
    ViewData["TargetAction"] = Model.TargetAction;
    // A prévia (_JogoQueVem) não recebe o torneio pelo modelo dela — o JogoQueVem é do motor da
    // projeção e não conhece Id de torneio. As setas ↑↓ precisam dele no POST.
    ViewData["TorneioDaLista"] = Model.TorneioId;
}

@* A QUADRA VAGOU: o próximo jogo dela já vem com o botão de começar.
   Numa noite de 5 quadras e jogo curto, achar "o próximo daquela quadra" era uma busca
   visual numa lista de 80 linhas, a cada 11 minutos, cinco vezes — e a quadra fica parada
   justamente enquanto o organizador procura. Quem decide qual é o próximo é o mesmo motor
   do push "seu jogo é o próximo" (Services/AvisosDoDiaDeJogo). *@
@if (ehOrganizador && TempData["ProximoJogoId"] is int proximoJogoId)
{
    <div class="alert alert-success d-flex align-items-center gap-3 flex-wrap" role="alert">
        <i class="bi bi-arrow-right-circle-fill fs-4"></i>
        <div class="flex-grow-1">
            <strong class="d-block">@TempData["ProximoJogoOnde"] — próximo jogo</strong>
            <span class="d-block">@TempData["ProximoJogoQuem"]</span>
            <small class="opacity-75">@TempData["ProximoJogoQuando"]</small>
        </div>
        <form asp-controller="Partidas" asp-action="ColocarNoAr" asp-route-id="@proximoJogoId" asp-route-voltarPara="@Model.TargetAction" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-padel fw-bold">
                <i class="bi bi-play-fill"></i> Começar agora
            </button>
        </form>
    </div>
}

@if (TempData["Sucesso"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill"></i> @TempData["Sucesso"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Erro"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill"></i> @TempData["Erro"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Filtro de Times e Categorias — aplica sozinho ao escolher, sem botão "Filtrar":
     o botão era mais uma coisa pra entender e mais um toque, e esquecer de apertá-lo
     deixava a tela mentindo sobre o filtro escolhido. -->
@{
    // Só oferece o filtro de time quando algum time joga o torneio — a lista vinha
    // com TODOS os times do sistema, em qualquer torneio.
    var timesFiltro = ViewBag.Times as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    bool temFiltroDeTime = timesFiltro != null && timesFiltro.Any();
    bool temFiltroDeCategoria = categoriasDoTorneio.Count > 1;

    // "Meus jogos" só aparece pra quem TEM jogo aqui: um botão que não faz nada é pior que
    // botão nenhum, e o torcedor é a maioria de quem abre esta tela.
    bool tenhoJogoAqui = ViewBag.TenhoJogoAqui == true;
    bool soMeusJogos = ViewBag.SoMeusJogos == true;

    // A SEQUÊNCIA POR CLUBE, QUADRA E FASE (Services/FiltroDeJogos, 10/09/2026). Cada select só
    // aparece quando tem o que separar: um clube só, uma quadra só ou uma fase só é um select
    // que não filtra nada.
    var filtroSequencia = ViewBag.FiltroDeJogos as FiltroDeJogos ?? FiltroDeJogos.Nenhum;
    var clubesFiltro = ViewBag.ClubesDoTorneio as IReadOnlyList<(int Id, string Nome)>
        ?? Array.Empty<(int Id, string Nome)>();
    var fasesFiltro = ViewBag.FasesDoTorneio as IReadOnlyList<(string Valor, string Rotulo)>
        ?? Array.Empty<(string Valor, string Rotulo)>();
    // ⚠️ As quadras do FILTRO não são as do "mudar de quadra". Aquela lista completa pelo
    // CADASTRO quando os jogos não têm quadra, e no torneio por ordem de liberação NENHUM tem —
    // o select aparecia cheio e qualquer escolha esvaziava a tela. Esta só traz quadra que
    // algum jogo de fato usa (ver TorneiosController.CarregarViewBagJogosAsync).
    var quadrasParaFiltrar = ViewBag.QuadrasParaFiltrar as IReadOnlyList<string> ?? Array.Empty<string>();
    bool temFiltroDeClube = clubesFiltro.Count > 1;
    bool temFiltroDeQuadra = quadrasParaFiltrar.Count > 1;
    bool temFiltroDeFase = fasesFiltro.Count > 1;
}
@if (temFiltroDeTime || temFiltroDeCategoria || tenhoJogoAqui || temFiltroDeClube || temFiltroDeQuadra || temFiltroDeFase)
{
    <form asp-action="@Model.TargetAction" method="get" id="filtroJogos" class="d-flex align-items-center gap-2 flex-wrap mb-3">
        <input type="hidden" name="id" value="@Model.TorneioId" />
        @* Escolher uma categoria não pode desligar o "meus jogos" sem ninguém pedir. *@
        <input type="hidden" name="soMeusJogos" value="@soMeusJogos.ToString().ToLowerInvariant()" />

        @if (tenhoJogoAqui)
        {
            @* Um link, não um checkbox: é liga/desliga, e um toque resolve. Os outros
               filtros vão junto na URL pra não se perderem quando ele alterna. *@
            <a asp-action="@Model.TargetAction"
               asp-route-id="@Model.TorneioId"
               asp-route-timeFiltroId="@(ViewBag.TimeAtual as int?)"
               asp-route-clubeFiltroId="@filtroSequencia.ClubeId"
               asp-route-quadraFiltro="@filtroSequencia.Quadra"
               asp-route-faseFiltro="@filtroSequencia.Fase"
               asp-route-soMeusJogos="@(soMeusJogos ? "false" : "true")"
               class="btn @(soMeusJogos ? "btn-padel" : "btn-outline-secondary") rounded-pill px-3">
                <i class="bi @(soMeusJogos ? "bi-person-check-fill" : "bi-person")"></i>
                Meus jogos
            </a>
        }

        @if (temFiltroDeTime)
        {
            <select name="timeFiltroId" class="form-select" asp-items="ViewBag.Times" style="width: auto;" onchange="this.form.submit()">
                <option value="">Todos os Times</option>
            </select>
        }

        @* A sequência por clube, por quadra e por fase — aplica sozinha ao escolher, como o
           time. A opção da quadra leva o clube junto ("Er Padel · Arena 1"), a mesma etiqueta
           da linha, porque num torneio de dois clubes "Quadra 1" sozinha não diz de onde. *@
        @if (temFiltroDeClube)
        {
            <select name="clubeFiltroId" class="form-select" style="width: auto;" onchange="this.form.submit()" aria-label="Clube">
                <option value="">Todos os clubes</option>
                @foreach (var clube in clubesFiltro)
                {
                    <option value="@clube.Id" selected="@(filtroSequencia.ClubeId == clube.Id)">@clube.Nome</option>
                }
            </select>
        }

        @if (temFiltroDeQuadra)
        {
            <select name="quadraFiltro" class="form-select" style="width: auto;" onchange="this.form.submit()" aria-label="Quadra">
                <option value="">Todas as quadras</option>
                @foreach (var nomeDaQuadra in quadrasParaFiltrar)
                {
                    <option value="@nomeDaQuadra"
                            selected="@string.Equals(nomeDaQuadra, filtroSequencia.Quadra?.Trim(), StringComparison.OrdinalIgnoreCase)">
                        @(LugarDoJogo.Etiqueta(ViewData.Sedes(), nomeDaQuadra) ?? nomeDaQuadra)
                    </option>
                }
            </select>
        }

        @if (temFiltroDeFase)
        {
            <select name="faseFiltro" class="form-select" style="width: auto;" onchange="this.form.submit()" aria-label="Fase">
                <option value="">Todas as fases</option>
                @foreach (var fase in fasesFiltro)
                {
                    <option value="@fase.Valor" selected="@(fase.Valor == filtroSequencia.Fase?.Trim())">@fase.Rotulo</option>
                }
            </select>
        }

        @if (filtroSequencia.Ativo)
        {
            @* Volta pra lista inteira — todos os filtros, não só estes três: é o que "limpar" diz. *@
            <a asp-action="@Model.TargetAction" asp-route-id="@Model.TorneioId"
               class="btn btn-link btn-sm text-decoration-none px-1">
                <i class="bi bi-x-circle"></i> Limpar filtros
            </a>
        }

        @if (temFiltroDeCategoria)
        {
            <div class="dropdown">
                <button class="btn pdz-categoria-toggle dropdown-toggle" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside">
                    Categorias @(categoriaFiltroAtual.Length > 0 ? $"({categoriaFiltroAtual.Length})" : "")
                </button>
                <ul class="dropdown-menu p-2" style="min-width: 220px;">
                    @foreach (var cat in categoriasDoTorneio)
                    {
                        <li class="form-check ms-1">
                            <input class="form-check-input" type="checkbox" name="categoriaFiltroIds" value="@cat.Id" id="catFiltro@(cat.Id)" @(categoriaFiltroAtual.Contains(cat.Id) ? "checked" : "")>
                            <label class="form-check-label" for="catFiltro@(cat.Id)">@cat.Nome</label>
                        </li>
                    }
                </ul>
            </div>
        }
    </form>

    <script>
        // Categorias: aplica quando o dropdown FECHA (marcar várias e disparar a cada
        // clique recarregaria a página no meio da escolha). O evento do Bootstrap
        // borbulha até o form.
        document.addEventListener('DOMContentLoaded', function () {
            var form = document.getElementById('filtroJogos');
            if (!form) return;
            var estadoInicial = new URLSearchParams(new FormData(form)).toString();
            form.addEventListener('hidden.bs.dropdown', function () {
                if (new URLSearchParams(new FormData(form)).toString() !== estadoInicial) {
                    form.submit();
                }
            });
        });

    </script>
}

<!-- Navegação das Sub-Abas. Ícones do site (não emoji, que rende diferente em cada
     aparelho) e o vermelho do Ao Vivo mora na bolinha pulsante — texto vermelho
     sobre a pill ativa era ilegível. -->
@* `data-torneio-id`: a aba escolhida é lembrada POR TORNEIO (ver js/jogos-abas.js) — quem
   opera dois torneios no mesmo dia não herda a aba de um no outro. *@
<ul class="nav nav-pills pdz-pills mb-3" id="jogosTabs" role="tablist" data-torneio-id="@Model.TorneioId">
    <li class="nav-item" role="presentation">
        <button class="nav-link @(defaultAoVivo ? "active" : "")" id="aovivo-tab" data-bs-toggle="tab" data-bs-target="#aovivo" type="button" role="tab">
            <span class="pdz-tab-dot"></span> Ao Vivo (@aoVivoList.Count)
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link @(defaultAoVivo ? "" : "active")" id="agendadas-tab" data-bs-toggle="tab" data-bs-target="#agendadas" type="button" role="tab">
            @* Conta as duas coisas: pra quem olha, uma semifinal marcada pras 21h é um jogo
               que vai acontecer, tenha ou não linha no banco. *@
            <i class="bi bi-calendar-event"></i> Agendadas (@(agendadasList.Count + jogosQueVem.Count))
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="finalizadas-tab" data-bs-toggle="tab" data-bs-target="#finalizadas" type="button" role="tab">
            <i class="bi bi-check2-circle"></i> Finalizadas (@finalizadasList.Count)
        </button>
    </li>
    @* No Americano a classificação é o placar do torneio. Vivia numa página separada, sem
       botão de voltar — aba aqui é onde o pessoal já está olhando. *@
    @if (classificacaoAmericano != null || classificacaoAmericanoDuplas != null)
    {
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="classificacao-tab" data-bs-toggle="tab" data-bs-target="#classificacao" type="button" role="tab">
                <i class="bi bi-award"></i> Classificação
            </button>
        </li>
    }
</ul>

<!-- Conteúdo das Sub-Abas -->
<div class="tab-content" id="jogosTabsContent">

    <!-- SUB-ABA: AO VIVO -->
    <div class="tab-pane fade @(defaultAoVivo ? "show active" : "")" id="aovivo" role="tabpanel">
        @if (aoVivoList.Count == 0)
        {
            <p class="text-muted">Nenhum jogo rolando no momento.</p>
        }

        @* PLACAR DE TODAS AS QUADRAS DE UMA VEZ.
           Com 5 quadras rodando, marcar um game era: abrir o Controle de Placar, mexer,
           salvar, voltar, achar o próximo card. Cinco vezes, a cada game, a noite inteira.
           Aqui os números são editados na própria lista e vão juntos num POST.

           O formulário fica VAZIO de propósito: os campos moram dentro dos cards e se ligam
           a ele por `form="pdzPlacaresAoVivo"`. Embrulhar os cards não daria — o
           palpitrômetro já tem formulário lá dentro, e formulário aninhado é HTML inválido.

           A tela cheia continua existindo e não é redundante: é lá que se marca SET, quem
           saca, quadra, link e o FINALIZAR. *@
        @if (ehOrganizador && aoVivoList.Count > 0)
        {
            <form asp-controller="Torneios" asp-action="SalvarPlacaresAoVivo" method="post" id="pdzPlacaresAoVivo">
                <input type="hidden" name="id" value="@Model.TorneioId" />
                <input type="hidden" name="voltarPara" value="@Model.TargetAction" />
            </form>

            <div class="pdz-live-salvar-barra">
                <button type="submit" form="pdzPlacaresAoVivo" class="btn btn-padel fw-bold">
                    <i class="bi bi-check2-all"></i> Salvar placares
                </button>
                <span class="form-text ms-2">
                    Edite os números direto nos cards e salve os @aoVivoList.Count jogo(s) de uma vez.
                </span>
            </div>
        }

        @*
            Convite pra se cadastrar: a tela ao vivo é a porta de entrada mais visitada
            por quem ainda não tem conta (o torcedor abre o link que o organizador manda).
            Só aparece pra quem NÃO está logado.
        *@
        @if (User.Identity?.IsAuthenticated != true)
        {
            <div class="card border-0 shadow-sm mb-3 p-3" style="background-color: var(--pdz-navy-fixed); color: white;">
                <div class="d-flex align-items-center gap-3 flex-wrap">
                    <i class="bi bi-lightning-charge-fill fs-2" style="color: var(--padel-green);"></i>
                    <div class="flex-grow-1">
                        <strong class="d-block">Acompanhando de fora?</strong>
                        <small class="text-light opacity-75">
                            Crie sua conta grátis pra seguir jogadores, receber o resultado no celular e se inscrever nos próximos torneios.
                        </small>
                    </div>
                    <a asp-controller="Auth" asp-action="Cadastro"
                       class="btn btn-padel rounded-pill px-4 fw-bold flex-shrink-0">Criar conta grátis</a>
                </div>
            </div>
        }

        <div class="row">
            @foreach (var jogo in aoVivoList)
            {
                var youtubeId = ExtrairYoutubeId(jogo.LinkTransmissao);
                var temTransmissao = !string.IsNullOrEmpty(jogo.LinkTransmissao);

                @* `data-partida-id` no CARD: é por ele que a atualização automática acha o
                   cartão correspondente pra trocar só o cabeçalho (placar, cronômetro,
                   botões) e não encostar no <iframe> da transmissão. Ver
                   js/jogos-ao-vivo-atualiza.js. *@
                <div class="col-md-6 mb-3">
                    <div class="pdz-live-card shadow-sm" data-partida-id="@jogo.Id">
                        <div class="pdz-live-header">
                            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                                <span class="pdz-live-badge"><span class="pdz-live-dot"></span> AO VIVO</span>
                                @* Onde o card diz se o placar foi gravado. Fica AQUI, no
                                   próprio card, e não na barra lá em cima: quem marca um game
                                   está olhando pro número que acabou de mexer, e um aviso fora
                                   da vista não avisa ninguém. Vazio até alguém editar. *@
                                <span class="pdz-live-salvo" role="status" aria-live="polite"></span>
                                @* "Seguir este jogo": placar chegando no celular sem precisar
                                   manter o site aberto (Felipe, 16/08/2026 — "algo parecido com
                                   o placar que o Google mostra na tela de bloqueio"). Só pra
                                   quem tem conta: o aviso é push, e push é sempre de um
                                   jogador logado (Models/SeguidorDePartida). *@
                                @if (User.Identity?.IsAuthenticated == true)
                                {
                                    bool sigoEste = partidasQueSigo.Contains(jogo.Id);
                                    <button type="button" class="pdz-live-seguir @(sigoEste ? "pdz-live-seguindo" : "")"
                                            data-partida-id="@jogo.Id" data-seguindo="@sigoEste.ToString().ToLower()"
                                            aria-pressed="@sigoEste.ToString().ToLower()">
                                        <i class="bi @(sigoEste ? "bi-bell-fill" : "bi-bell")"></i>
                                        <span class="pdz-live-seguir-texto">@(sigoEste ? "Seguindo" : "Seguir este jogo")</span>
                                    </button>
                                }
                                @if (temTransmissao)
                                {
                                    <a href="@jogo.LinkTransmissao" target="_blank" rel="noopener" class="pdz-live-transmissao-btn">
                                        <i class="bi bi-play-circle-fill"></i> Assistir transmissão
                                    </a>
                                }
                            </div>

                            <div class="d-flex justify-content-between align-items-center small opacity-75 mb-3">
                                @* O LUGAR, quando dá pra dizer algum (Services/LugarDoJogo).
                                   Continua sem escrever "Quadra não definida" — isso era ruído
                                   em todo torneio que roda por ordem de chegada —, mas o CLUBE
                                   aparece mesmo sem quadra: ali a resposta é o prédio, e é ela
                                   que faz alguém sair andando pro lado certo. *@
                                <span>
                                    @if (LugarDoJogo.Etiqueta(ViewData.Sedes(), jogo.NomeQuadra, jogo.CategoriaId, jogo.ClubeId) is { } ondeJoga)
                                    {
                                        <i class="bi bi-geo-alt-fill"></i> @ondeJoga <text>· </text>
                                    }
                                    @jogo.Categoria.Nome · @jogo.Fase
                                </span>
                                <span class="pdz-live-cronometro">
                                    <i class="bi bi-stopwatch-fill"></i>
                                    <span class="cronometro" data-inicio="@jogo.HorarioInicioReal?.ToString("O")">@jogo.MinutosDecorridos min</span>
                                </span>
                            </div>

                            @{
                                bool ganhando1 = (jogo.GamesDupla1 ?? 0) > (jogo.GamesDupla2 ?? 0);
                                bool ganhando2 = (jogo.GamesDupla2 ?? 0) > (jogo.GamesDupla1 ?? 0);
                                // Quase todo jogo é 1 set até 9 games, então o games é o placar em
                                // destaque. O set só aparece quando o jogo de fato virou 2 sets.
                                bool mostrarSets = (jogo.SetsDupla1 ?? 0) > 0 || (jogo.SetsDupla2 ?? 0) > 0;

                                // O teto de games DESTE jogo, calculado pelo servidor (ver
                                // CarregarViewBagJogosAsync). O 99 de reserva só entra em cena
                                // se o torneio sumiu do ViewBag — nunca é o limite de verdade.
                                var tetosDoJogo = (ViewBag.TetoDeGames as Dictionary<int, (int Lado1, int Lado2)>)
                                    ?.GetValueOrDefault(jogo.Id) ?? (Lado1: 99, Lado2: 99);
                            }
                            @* A bolinha do saque: no padel, saber de quem é o saque é metade
                               da leitura do jogo pra quem chega no meio de um game. Quem
                               marca é o organizador, no Controle de Placar. *@
                            <div class="d-flex justify-content-between align-items-center pdz-live-linha">
                                <div class="flex-grow-1 pdz-live-jogadores">
                                    <partial name="_LadoDaPartida" model="jogo.Dupla1" />
                                </div>
                                @if (jogo.DuplaSacandoId == jogo.Dupla1Id)
                                {
                                    <span class="pdz-bolinha" title="Sacando"></span>
                                }
                                <div class="pdz-live-placar @(ganhando1 ? "pdz-live-placar-ganhando" : "")">
                                    @if (mostrarSets)
                                    {
                                        <span class="pdz-live-sets" title="Sets">@(jogo.SetsDupla1 ?? 0)</span>
                                    }
                                    @if (ehOrganizador)
                                    {
                                        @* `form="..."` em vez de embrulhar os cards: o palpitrômetro
                                           já tem formulário dentro do card, e formulário aninhado é
                                           HTML inválido — o navegador desmonta e o POST sai capenga.

                                           −/+ ao lado do número: digitar exige mirar num campo de
                                           2 caracteres, com o celular numa mão e a quadra rolando.
                                           Cada toque JÁ SALVA (ver js/placar-ao-vivo.js) — "editei e
                                           não marcou" é o pior jeito de falhar num placar. *@
                                        <input type="hidden" name="partidaId" value="@jogo.Id" form="pdzPlacaresAoVivo" />
                                        <span class="pdz-live-contador">
                                            <button type="button" class="pdz-live-passo" data-passo="-1"
                                                    aria-label="Menos um game">−</button>
                                            <input type="number" class="pdz-live-games pdz-live-input" inputmode="numeric"
                                                   name="games1" value="@(jogo.GamesDupla1 ?? 0)" min="0" max="@tetosDoJogo.Lado1"
                                                   form="pdzPlacaresAoVivo" aria-label="Games de @jogo.Dupla1.NomeDeExibicao" />
                                            <button type="button" class="pdz-live-passo" data-passo="1"
                                                    aria-label="Mais um game">+</button>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="pdz-live-games">@(jogo.GamesDupla1 ?? 0)</span>
                                    }
                                </div>
                            </div>
                            @* O "×" entre as duas duplas. Quatro rostos empilhados sem nada no
                               meio não se leem como 2 contra 2 (Felipe, 08/08/2026: "no ao vivo
                               não parece que é 2x2") — quem chega no card precisa achar o
                               confronto antes de achar os nomes. Cada dupla vira um bloco e o
                               × é a fronteira entre eles. *@
                            <div class="pdz-live-versus"><span>×</span></div>

                            <div class="d-flex justify-content-between align-items-center pdz-live-linha">
                                <div class="flex-grow-1 pdz-live-jogadores">
                                    <partial name="_LadoDaPartida" model="jogo.Dupla2" />
                                </div>
                                @if (jogo.DuplaSacandoId == jogo.Dupla2Id)
                                {
                                    <span class="pdz-bolinha" title="Sacando"></span>
                                }
                                <div class="pdz-live-placar @(ganhando2 ? "pdz-live-placar-ganhando" : "")">
                                    @if (mostrarSets)
                                    {
                                        <span class="pdz-live-sets" title="Sets">@(jogo.SetsDupla2 ?? 0)</span>
                                    }
                                    @if (ehOrganizador)
                                    {
                                        <span class="pdz-live-contador">
                                            <button type="button" class="pdz-live-passo" data-passo="-1"
                                                    aria-label="Menos um game">−</button>
                                            <input type="number" class="pdz-live-games pdz-live-input" inputmode="numeric"
                                                   name="games2" value="@(jogo.GamesDupla2 ?? 0)" min="0" max="@tetosDoJogo.Lado2"
                                                   form="pdzPlacaresAoVivo" aria-label="Games de @jogo.Dupla2.NomeDeExibicao" />
                                            <button type="button" class="pdz-live-passo" data-passo="1"
                                                    aria-label="Mais um game">+</button>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="pdz-live-games">@(jogo.GamesDupla2 ?? 0)</span>
                                    }
                                </div>
                            </div>

                            @* Só organizador: o torcedor via um "Editar jogo" que não era
                               dele (a rota recusa, mas o convite já passava desleixo). *@
                            @if (ehOrganizador)
                            {
                                @* Botão de verdade, largura cheia: no jogo AO VIVO marcar o
                                   placar é A ação da tela, e ela vivia como um link cinza de
                                   11px no canto — pequeno pra achar com a quadra rolando e
                                   sem parecer clicável. *@
                                <div class="mt-3 d-flex gap-2">
                                    @* FINALIZAR daqui mesmo: abrir a tela cheia só pra apertar
                                       "finalizar" era uma ida e volta por jogo.

                                       ⚠️ O placar vai JUNTO, nos hidden abaixo. Os números
                                       editáveis do card pertencem ao formulário de salvar em
                                       LOTE (form="pdzPlacaresAoVivo"), então não viriam neste
                                       submit: quem digitava 6 x 1 e apertava Finalizar direto
                                       encerrava com o que estava gravado, e o aviso repetia o
                                       número velho. O script no fim do arquivo copia o que
                                       está na tela pra cá e reescreve o aviso. *@
                                    <form asp-controller="Torneios" asp-action="FinalizarPartida" method="post" class="flex-grow-1 pdz-form-finalizar"
                                          data-confirmar="Encerra o jogo com o placar @(jogo.GamesDupla1 ?? 0) x @(jogo.GamesDupla2 ?? 0). Isso move o Padelímetro dos 4 jogadores, avisa todo mundo e, se for o último da fase, gera a fase seguinte."
                                          data-confirmar-titulo="Finalizar @(jogo.Dupla1.NomeDeExibicao) × @(jogo.Dupla2.NomeDeExibicao)?"
                                          data-confirmar-ok="Finalizar">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="partidaId" value="@jogo.Id" />
                                        <input type="hidden" name="voltarPara" value="@Model.TargetAction" />
                                        <input type="hidden" name="games1" value="@(jogo.GamesDupla1 ?? 0)" />
                                        <input type="hidden" name="games2" value="@(jogo.GamesDupla2 ?? 0)" />
                                        <button type="submit" class="btn btn-padel w-100 fw-bold">
                                            <i class="bi bi-flag-fill"></i> Finalizar
                                        </button>
                                    </form>
                                    <a asp-controller="Partidas" asp-action="ControlePlacar" asp-route-id="@jogo.Id" asp-route-voltarPara="@Model.TargetAction"
                                       class="btn btn-outline-secondary fw-bold"
                                       title="Marcar placar, sets, saque e quadra" aria-label="Marcar placar">
                                        <i class="bi bi-pencil-fill"></i>
                                    </a>
                                    @* DESFAZER o play aqui também. O botão existia só na LINHA
                                       (Agendadas/Finalizadas) e o card do Ao Vivo é outro markup —
                                       resultado: era impossível tirar da quadra o jogo chamado por
                                       engano, que é exatamente onde o erro acontece. *@
                                    <form asp-controller="Partidas" asp-action="VoltarParaAgendado" asp-route-id="@jogo.Id" method="post"
                                          data-confirmar="O jogo volta pra lista de agendados, com a mesma hora e a mesma quadra. O placar em tela é zerado."
                                          data-confirmar-titulo="Tirar da quadra?"
                                          data-confirmar-ok="Voltar pra agendado">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-secondary fw-bold"
                                                title="Voltar pra agendado" aria-label="Voltar pra agendado">
                                            <i class="bi bi-arrow-counterclockwise"></i>
                                        </button>
                                    </form>
                                </div>
                            }
                            else if (Padelizou.Services.QuemMarcaOPlacar.Liberado(modoQuemMarca, meuId, jogo, ehInscritoDoTorneio))
                            {
                                @* Jogador liberado pelo torneio: só o lápis. Finalizar, salvar
                                   em lote e desfazer continuam da organização. *@
                                <div class="mt-3">
                                    <a asp-controller="Partidas" asp-action="ControlePlacar" asp-route-id="@jogo.Id" asp-route-voltarPara="@Model.TargetAction"
                                       class="btn btn-outline-secondary fw-bold w-100"
                                       title="Marcar placar e saque" aria-label="Marcar placar">
                                        <i class="bi bi-pencil-fill"></i> Marcar placar
                                    </a>
                                </div>
                            }
                        </div>

                        @if (youtubeId != null)
                        {
                            <div class="pdz-live-video">
                                <div class="pdz-live-video-label"><i class="bi bi-broadcast"></i> Transmissão</div>
                                <div class="ratio ratio-16x9">
                                    <iframe src="https://www.youtube.com/embed/@youtubeId" title="Transmissão ao vivo"
                                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                            allowfullscreen></iframe>
                                </div>
                            </div>
                        }

                        @* Só quando alguém palpitou: em jogo ao vivo não se vota mais, e o
                           bloco com barra vazia + "0%" + "0 voto(s)" parecia defeito. É a
                           mesma regra que a versão em linha já segue. *@
                        @if (palpites.GetValueOrDefault(jogo.Id) is { TotalVotos: > 0 } resumoPalpite)
                        {
                            <div class="card-body pt-2">
                                <partial name="_Palpitrometro" model="(jogo, resumoPalpite, meuId)" />
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- SUB-ABA: AGENDADAS -->
    <div class="tab-pane fade @(defaultAoVivo ? "" : "show active")" id="agendadas" role="tabpanel">
        @if (ViewBag.ChaveAindaNaoPublicada == true)
        {
            @* 🗣️ "nao exiba nada até publicar a chave (desse menu de jogos)" — Felipe, 09/09/2026.
               A lista chega vazia do controller (o portão mora em CarregarViewBagJogosAsync);
               aqui só se explica o vazio, pra não parecer que o sorteio ainda não aconteceu. *@
            <p class="text-muted">As chaves ainda não foram publicadas pelo organizador.</p>
        }
        else if (agendadasList.Count == 0 && jogosQueVem.Count == 0)
        {
            <p class="text-muted">Nenhum jogo agendado no momento.</p>
        }

        @* ⚠️ O "RECALCULAR HORÁRIOS" NÃO MORA MAIS AQUI (10/09/2026). 🗣️ Felipe, num print
           desta tela no 2ª Etapa ER PADEL TOUR: *"mude esse botao recalcular horarios, para o
           lado desse do 'recolher as chaves' se nao alguem pode clicar sem querer ali"*. Esta é
           a tela onde se passa o dia — rola-se ela pra achar quem joga agora e pra apertar o
           play —, e o botão que apaga uma noite de trocas na mão estava no caminho do polegar.
           Ele foi pro Painel de Controle (Details.cshtml, aba Gerenciar Torneio), junto do
           Recolher as chaves e do Desfazer o sorteio. O que fica aqui são os dois que não jogam
           trabalho fora: o Conferir a grade e o Ajustar horários. *@
        @* 🗣️ "faz esse botão" (Felipe, 09/09/2026): a conferência da grade, ao lado de quem a
           refaz. Fica FORA do `if` das agendadas de propósito — a grade também merece conferência
           depois que os jogos começaram, e é justamente aí que o furo dói. *@
        @if (ehOrganizador)
        {
            <a asp-controller="Torneios" asp-action="ConferirGrade" asp-route-id="@Model.TorneioId"
               class="btn btn-sm btn-outline-secondary mb-2">
                <i class="bi bi-clipboard-check"></i> Conferir a grade
            </a>
        }
        @if (ehOrganizador && agendadasList.Count > 0)
        {
            @* O irmão manso do recalcular, e o único dos dois que sobrou aqui: ele não desmarca
               nada — só troca jogos de lugar enquanto isso derrubar pontos do Conferir grade.
               Ver Services/ReparoDaGrade. *@
            <form asp-controller="Torneios" asp-action="AjustarHorarios" method="post" class="mb-3">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.TorneioId" />
                <input type="hidden" name="voltarPara" value="@Model.TargetAction" />
                <button type="submit" class="btn btn-outline-success btn-sm">
                    <i class="bi bi-magic"></i> Ajustar horários
                </button>
                <span class="form-text ms-2">
                    Mantém a grade e as suas trocas: só corrige o que o Conferir grade aponta.
                </span>
            </form>

            @* Onde o vermelho foi parar. Sem esta linha, um botão que esteve aqui o tempo todo
               simplesmente some — e quem o procura no meio de um torneio atrasado não tem onde
               olhar. *@
            <div class="form-text mb-3">
                <i class="bi bi-info-circle"></i>
                O <strong>Recalcular horários</strong> saiu daqui — agora ele fica em
                <strong>Gerenciar Torneio</strong>, com quem organiza.
            </div>
        }

        @* Lista, não parede de cartões: com 48 agendados o cartão grande ocupava meia tela
           cada um. O cartão cheio (placar gigante + palpitrômetro aberto) fica só no AO VIVO,
           que é onde a tela tem um assunto só. *@
        @* As fases que ainda vão ser montadas entram AQUI, na ordem do horário, junto com os
           jogos marcados — não num bloco à parte. O horário delas sai da duração configurada
           no torneio, igual ao dos outros: é slot de grade, não palpite. O que está "a
           definir" é QUEM joga, e é só isso que a linha diz. *@
        @{
            @* ⚠️ A FILA SAI DE Services/OrdemNoHorario, e não de um OrderBy solto aqui (10/09/2026).
               Ordenar só pela hora deixava dois jogos do mesmo minuto na ordem que o banco
               devolvesse — e ela muda sozinha depois de um UPDATE. É a MESMA régua que as setas
               ↑↓ usam pra achar o vizinho: duas contas de "quem vem antes" fariam a seta mover o
               jogo pra um lugar diferente do que esta lista mostrou. *@
            var linhasAgendadas = Padelizou.Services.OrdemNoHorario.Ordenar(agendadasList, jogosQueVem);
        }

        <div class="pdz-jogos-lista">
            @foreach (var linha in linhasAgendadas)
            {
                if (linha.Jogo is Partida jogo)
                {
                    <partial name="_JogoEmLinha" model="(jogo, ehOrganizador, false, palpites.GetValueOrDefault(jogo.Id), meuId)" />
                }
                else if (linha.Previsto is JogoQueVem porvir)
                {
                    <partial name="_JogoQueVem" model="porvir" />
                }
            }
        </div>
    </div>

    <!-- SUB-ABA: FINALIZADAS -->
    <div class="tab-pane fade" id="finalizadas" role="tabpanel">
        @if (finalizadasList.Count == 0)
        {
            <p class="text-muted">Nenhum jogo finalizado ainda.</p>
        }

        @* Jogo que acabou é histórico: o que se procura aqui é o PLACAR e quem ganhou. *@
        <div class="pdz-jogos-lista">
            @foreach (var jogo in finalizadasList)
            {
                <partial name="_JogoEmLinha" model="(jogo, ehOrganizador, true, palpites.GetValueOrDefault(jogo.Id), meuId)" />
            }
        </div>
    </div>

    @* MODAL: trocar horário entre dois jogos (só organizador). Um modal pro torneio
       inteiro: o botão do card diz quem é o jogo A, e aqui se escolhe o jogo B — os dois
       trocam o slot inteiro (hora + quadra), então a grade não ganha buraco nem quadra
       em dobro. Só jogo AGENDADO entra: jogo em quadra ou finalizado é história.

       As eliminatórias PREVISTAS entram na lista desde 10/09/2026 ("permita também trocar de
       horário as eliminatórias, não apenas as de chave"): o slot que a prévia recebe vira uma
       reserva (Models/ReservaDeHorario), e o robô cria o jogo nele quando a fase anterior
       terminar. A referência delas não é Id — ver Services/ReferenciaDoJogo. *@
    @if (ehOrganizador)
    {
        <div class="modal fade" id="modalTrocarHorario" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog">
                <form asp-controller="Torneios" asp-action="TrocarHorario" method="post" class="modal-content">
                    <input type="hidden" name="id" value="@Model.TorneioId" />
                    <input type="hidden" name="voltarPara" value="@Model.TargetAction" />
                    <input type="hidden" name="jogoA" id="trocaJogoA" value="" />
                    <div class="modal-header">
                        <h5 class="modal-title"><i class="bi bi-arrow-left-right"></i> Trocar horário</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                    </div>
                    <div class="modal-body">
                        <p class="small text-muted mb-2">
                            Jogo escolhido: <strong id="trocaJogoARotulo">—</strong>
                        </p>
                        <label class="form-label fw-bold" for="trocaJogoB">Trocar com qual jogo?</label>
                        @* A lista sai da MESMA lista da aba, então o filtro de cima recorta as opções
                           daqui também. Dizer isso é o mínimo: sem o aviso, o jogo que o organizador
                           procura simplesmente não está lá, e nada na tela explica por quê. *@
                        @if (filtroSequencia.Ativo || soMeusJogos || categoriaFiltroAtual.Length > 0)
                        {
                            <div class="form-text text-warning-emphasis mb-1">
                                <i class="bi bi-funnel-fill"></i>
                                A lista abaixo segue os filtros da tela. Limpe os filtros pra trocar com um jogo que não aparece.
                            </div>
                        }
                        @* 🗣️ "aqui quando eu for selecionar outro jogo, ta muito poluido" (Felipe,
                           10/09/2026). Eram 97 linhas de ~120 caracteres, todas repetindo a data e
                           o nome completo dos quatro jogadores. Três cortes, nenhum deles perde
                           informação que o organizador use pra escolher:
                             • o DIA sobe pro <optgroup> — aparece uma vez, não 97;
                             • o nome vira o compacto de sempre (NomeDaDupla.CompactoNa, o mesmo dos
                               cards) em vez do nome civil inteiro;
                             • a categoria vira a curta (CategoriaNaTela.Curto): "4ª Masculina" no
                               lugar de "4ª Categoria Masculina".
                           Reuso, não invenção: as duas réguas já existiam e já são o que a aba mostra. *@
                        <select name="jogoB" id="trocaJogoB" class="form-select" required
                                data-impacto-url="@Url.Action("ImpactoDaTroca", "Torneios", new { id = Model.TorneioId })">
                            <option value="">Escolha o outro jogo...</option>
                            @foreach (var doDia in linhasAgendadas
                                        .Where(l => l.Horario != null)
                                        .GroupBy(l => l.Horario!.Value.Date))
                            {
                                <optgroup label="@doDia.Key.ToString("dddd, dd/MM", new System.Globalization.CultureInfo("pt-BR"))">
                                    @foreach (var linha in doDia)
                                    {
                                        if (linha.Jogo is Partida candidato)
                                        {
                                            <option value="@candidato.Id" data-jogo-id="@candidato.Id">
                                                @candidato.HorarioPrevisto!.Value.ToString("HH:mm")
                                                @(LugarDoJogo.Etiqueta(ViewData.Sedes(), candidato.NomeQuadra, candidato.CategoriaId, candidato.ClubeId) is { } ondeReal ? $"· {ondeReal}" : "")
                                                · @CategoriaNaTela.Curto(candidato.Categoria.Nome)
                                                · @NomeDaDupla.CompactoNa(candidato.Dupla1) × @NomeDaDupla.CompactoNa(candidato.Dupla2)
                                            </option>
                                        }
                                        else if (linha.Previsto is JogoQueVem previsto
                                                 && previsto.Horario is DateTime quandoPrevisto
                                                 && previsto.CategoriaId is int categoriaPrevista)
                                        {
                                            var referencia = Padelizou.Services.ReferenciaDoJogo.Prevista(categoriaPrevista, previsto.Fase, previsto.Numero).ToString();
                                            <option value="@referencia" data-jogo-id="@referencia">
                                                @quandoPrevisto.ToString("HH:mm")
                                                @(LugarDoJogo.Etiqueta(ViewData.Sedes(), previsto.Quadra, previsto.CategoriaId) is { } ondePrevisto ? $"· {ondePrevisto}" : "")
                                                · @CategoriaNaTela.Curto(previsto.Categoria) · @previsto.FaseNumerada (prévia)
                                            </option>
                                        }
                                    }
                                </optgroup>
                            }
                        </select>

                        @* O AVISO DE IMPACTO: preenchido por wwwroot/js/impacto-da-troca.js quando a
                           pessoa escolhe, com a resposta de /Torneios/ImpactoDaTroca. Nasce escondido
                           porque sem escolha não há o que dizer. *@
                        <div id="trocaImpacto" class="alert py-2 px-3 mt-2 mb-0 small d-none" role="status"></div>

                        <div class="form-text">
                            Os dois jogos trocam horário e quadra entre si. Jogo previsto (prévia) nasce no
                            horário que receber, assim que a fase anterior terminar.
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-padel fw-bold">Trocar</button>
                    </div>
                </form>
            </div>
        </div>

        @* FINALIZAR ENCERRA COM O QUE ESTÁ NA TELA (Felipe, 08/08/2026).

           Ele marcou 6 x 1 no card, apertou Finalizar e o aviso ofereceu encerrar "0 x 1" —
           o placar GRAVADO. Os números editáveis do card pertencem ao formulário de salvar em
           LOTE (form="pdzPlacaresAoVivo"), então não iam neste submit, e o texto do aviso é
           renderizado pelo servidor com o valor do banco. Duas cópias do mesmo número, e a que
           o organizador estava OLHANDO era justamente a que não valia.

           Fica sob `ehOrganizador` porque só ele vê o botão de finalizar — e o servidor não
           depende disto: ele recebe games1/games2 e aplica o mesmo PlacarValido do salvar em
           lote, então tela velha em cache não encerra com número inventado. *@
        <script>
            document.addEventListener('submit', function (e) {
                var form = e.target.closest ? e.target.closest('form.pdz-form-finalizar') : null;
                if (!form) return;

                var card = form.closest('.pdz-live-card');
                if (!card) return;

                var naTela = function (nome) {
                    var campo = card.querySelector('input.pdz-live-games[name="' + nome + '"]');
                    if (!campo) return null;
                    var n = parseInt(campo.value, 10);
                    return isNaN(n) ? null : Math.max(0, n);
                };

                var g1 = naTela('games1'), g2 = naTela('games2');
                if (g1 === null || g2 === null) return;   // sem os campos, vale o de sempre

                form.querySelector('input[name="games1"]').value = g1;
                form.querySelector('input[name="games2"]').value = g2;

                // O aviso passa a falar o mesmo número que o card. Só o trecho do placar é
                // trocado: o resto da frase (Padelímetro, avisos, fase seguinte) continua
                // valendo e é o que faz a confirmação ser informada em vez de um "tem certeza?".
                form.dataset.confirmar = form.dataset.confirmar
                    .replace(/placar \d+ x \d+/, 'placar ' + g1 + ' x ' + g2);
            // CAPTURA (true): o confirmar.js escuta o submit na borbulha e lê o data-confirmar.
            // Na borbulha, o modal já teria aberto com o texto velho.
            }, true);
        </script>

        <script>
            // O botão do card carrega o jogo A; o select não pode oferecer o próprio A.
            document.addEventListener('DOMContentLoaded', function () {
                var modal = document.getElementById('modalTrocarHorario');
                if (!modal) return;
                modal.addEventListener('show.bs.modal', function (evento) {
                    var botao = evento.relatedTarget;
                    if (!botao) return;
                    var jogoA = botao.getAttribute('data-jogo-id');
                    document.getElementById('trocaJogoA').value = jogoA;
                    document.getElementById('trocaJogoARotulo').textContent = botao.getAttribute('data-jogo-rotulo');
                    var select = document.getElementById('trocaJogoB');
                    select.value = '';
                    Array.from(select.options).forEach(function (opcao) {
                        opcao.hidden = opcao.getAttribute('data-jogo-id') === jogoA;
                    });
                });
            });
        </script>

        @* MODAL: definir o horário NA MÃO (só organizador, 10/09/2026). 🗣️ "permita tambem,
           trocar o horario na mão, na lista de jogos, para nós organizadores". A troca ⇄ exige
           outro jogo pra trocar de lugar; aqui o organizador digita a hora que quiser, num jogo
           só. O clube acompanha a hora (Services/HorarioNaMao): se o clube atual não tem quadra
           aberta na hora nova, o jogo volta pro clube principal. Prévia vira reserva, como na
           troca. Comentário FORA da tag de propósito (ComentarioRazorDentroDeTagTests). *@
        <div class="modal fade" id="modalDefinirHorario" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog">
                <form asp-controller="Torneios" asp-action="DefinirHorario" method="post" class="modal-content">
                    <input type="hidden" name="id" value="@Model.TorneioId" />
                    <input type="hidden" name="voltarPara" value="@Model.TargetAction" />
                    <input type="hidden" name="jogo" id="definirJogo" value="" />
                    <div class="modal-header">
                        <h5 class="modal-title"><i class="bi bi-clock"></i> Definir horário</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                    </div>
                    <div class="modal-body">
                        <p class="small text-muted mb-2">
                            Jogo escolhido: <strong id="definirJogoRotulo">—</strong>
                        </p>
                        <label class="form-label fw-bold" for="definirHorario">Novo horário</label>
                        @* 🗣️ "ao alterar o horario, deixe para que fique mais facil seguindo a ordem
                           padrão do jogo (nesse torneio é de 50 em 50 min)" (Felipe, 10/09/2026). Era
                           um relógio em branco: pra ir das 19:40 pras 20:30 o organizador rolava a
                           roda de minuto em minuto e tinha que saber o passo de cabeça — e errar por
                           um minuto não dá erro, dá um jogo desalinhado que só aparece no Conferir
                           grade. A lista é a do próprio torneio (Services/HorariosDaGrade). *@
                        <select name="horario" id="definirHorario" class="form-select" required>
                            @* ⚠️ VAZIA E PRIMEIRA. Sem ela o seletor já nasce com o primeiro horário
                               do torneio marcado, e abrir o modal num jogo sem hora e apertar Salvar
                               mandaria o jogo pras 08:00 do primeiro dia sem ninguém ter escolhido —
                               o campo livre de antes, vazio, não fazia isso. *@
                            <option value="">Escolha o horário…</option>
                            @foreach (var dia in slotsDaGrade.GroupBy(s => s.Horario.Date))
                            {
                                <optgroup label="@dia.Key.ToString("dddd, dd/MM")">
                                    @foreach (var slot in dia)
                                    {
                                        @* Quantas quadras sobram: é o que evita escolher o horário que
                                           o servidor vai recusar por a quadra do jogo já ter dono. *@
                                        var quantas = slot.Quadras <= 0 ? ""
                                            : slot.Lotado ? " · sem quadra livre"
                                            : slot.Livres == 1 ? " · 1 quadra livre"
                                            : $" · {slot.Livres} quadras livres";
                                        <option value="@slot.Horario.ToString("yyyy-MM-dd'T'HH:mm")">@slot.Horario.ToString("HH:mm")@quantas</option>
                                    }
                                </optgroup>
                            }
                        </select>
                        @* A SAÍDA PRA HORA QUEBRADA. A grade é o caminho normal, mas o dia de jogo
                           tem 20:13: o campo livre continua ali, atrás de uma caixinha, e é ele que
                           abre sozinho quando o jogo está numa hora que não é da grade. *@
                        <div class="form-check mt-2">
                            <input class="form-check-input" type="checkbox" id="definirForaDaGrade"
                                   onchange="pdzDefinirHorarioModo()" />
                            <label class="form-check-label" for="definirForaDaGrade">
                                Outro horário, fora da grade
                            </label>
                        </div>
                        <input type="datetime-local" class="form-control mt-2" name="horario"
                               id="definirHorarioLivre" required disabled hidden />
                        <div class="form-text">
                            Só este jogo muda; a grade não é recalculada. Se a hora nova for num horário em que o
                            clube atual está fechado, o jogo vai pro clube principal. O Conferir grade aponta se
                            alguém ficou em dois jogos no mesmo horário.
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Salvar horário</button>
                    </div>
                </form>
            </div>
        </div>

        <script>
            // Lista OU campo livre — nunca os dois. Campo `disabled` não é enviado, e é assim que
            // os dois podem ter o mesmo `name` sem o servidor receber dois valores.
            function pdzDefinirHorarioModo() {
                var fora = document.getElementById('definirForaDaGrade').checked;
                var lista = document.getElementById('definirHorario');
                var livre = document.getElementById('definirHorarioLivre');
                if (!lista || !livre) return;

                lista.disabled = fora; lista.hidden = fora;
                livre.disabled = !fora; livre.hidden = !fora;
            }

            // O botão do card carrega o jogo e a hora atual dele no campo.
            document.addEventListener('DOMContentLoaded', function () {
                var modal = document.getElementById('modalDefinirHorario');
                if (!modal) return;
                modal.addEventListener('show.bs.modal', function (evento) {
                    var botao = evento.relatedTarget;
                    if (!botao) return;
                    document.getElementById('definirJogo').value = botao.getAttribute('data-jogo-id');
                    document.getElementById('definirJogoRotulo').textContent = botao.getAttribute('data-jogo-rotulo');

                    var atual = botao.getAttribute('data-jogo-horario') || '';
                    var lista = document.getElementById('definirHorario');
                    var livre = document.getElementById('definirHorarioLivre');
                    lista.value = atual;
                    livre.value = atual;

                    // Hora que a lista não tem (jogo numa hora quebrada, ou a grade mudou depois
                    // que a página abriu): abre já no campo livre, com o valor que o jogo tem — um
                    // seletor em branco faria pensar que o jogo não tem hora. Lista sem horário
                    // nenhum (torneio sem grade) também cai aqui, senão não haveria como salvar.
                    document.getElementById('definirForaDaGrade').checked =
                        lista.options.length <= 1 || (atual !== '' && lista.value !== atual);
                    pdzDefinirHorarioModo();
                });
            });
        </script>

        @* MODAL: mudar SÓ a quadra, sem mexer na hora. A troca de horário arrasta o slot
           inteiro e quase nunca é o que se quer quando a quadra molha ou a final merece a
           do meio. Quadra ocupada naquele horário não é recusada: as duas trocam de lugar
           (Services/TrocaDeQuadra) — recusar deixaria o organizador no mesmo beco. *@
        <div class="modal fade" id="modalTrocarQuadra" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog">
                <form asp-controller="Torneios" asp-action="TrocarQuadra" method="post" class="modal-content">
                    <input type="hidden" name="id" value="@Model.TorneioId" />
                    <input type="hidden" name="voltarPara" value="@Model.TargetAction" />
                    <input type="hidden" name="jogoId" id="quadraJogoId" value="" />
                    <div class="modal-header">
                        <h5 class="modal-title"><i class="bi bi-geo-alt"></i> Mudar de quadra</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                    </div>
                    <div class="modal-body">
                        <p class="small text-muted mb-2">
                            Jogo escolhido: <strong id="quadraJogoRotulo">—</strong>
                        </p>
                        @if (quadrasDoTorneio.Count == 0)
                        {
                            <p class="mb-0">
                                Este torneio não tem quadras cadastradas — cadastre as quadras na edição
                                do torneio pra poder escolher aqui.
                            </p>
                        }
                        else
                        {
                            <label class="form-label fw-bold" for="quadraDestino">Pra qual quadra?</label>
                            <select name="quadra" id="quadraDestino" class="form-select" required>
                                <option value="">Escolha a quadra...</option>
                                @foreach (var nome in quadrasDoTorneio)
                                {
                                    <option value="@nome" data-quadra="@nome">@nome</option>
                                }
                            </select>
                            <div class="form-text">
                                O horário não muda. Se a quadra já tiver jogo nesse horário, os dois trocam de quadra.
                            </div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-padel fw-bold" @(quadrasDoTorneio.Count == 0 ? "disabled" : "")>
                            Mudar
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <script>
            // O botão da linha diz qual é o jogo; a quadra atual dele sai da lista, porque
            // "mudar pra onde já está" não é uma escolha.
            document.addEventListener('DOMContentLoaded', function () {
                var modal = document.getElementById('modalTrocarQuadra');
                if (!modal) return;
                modal.addEventListener('show.bs.modal', function (evento) {
                    var botao = evento.relatedTarget;
                    if (!botao) return;
                    document.getElementById('quadraJogoId').value = botao.getAttribute('data-jogo-id');
                    document.getElementById('quadraJogoRotulo').textContent = botao.getAttribute('data-jogo-rotulo');
                    var select = document.getElementById('quadraDestino');
                    if (!select) return;
                    var atual = botao.getAttribute('data-jogo-quadra') || '';
                    select.value = '';
                    Array.from(select.options).forEach(function (opcao) {
                        opcao.hidden = opcao.getAttribute('data-quadra') === atual && atual !== '';
                    });
                });
            });
        </script>
    }

    @* SUB-ABA: CLASSIFICAÇÃO (só Americano) *@
    @if (classificacaoAmericano != null)
    {
        <div class="tab-pane fade" id="classificacao" role="tabpanel">
            <p class="text-muted small">
                No Americano vence quem somar mais <strong>games</strong> ao longo do torneio —
                o parceiro muda a cada rodada, então a conta é individual.
            </p>

            @foreach (var daCategoria in classificacaoAmericano)
            {
                <h6 class="fw-bold mt-3" style="color: var(--pdz-ink);">@daCategoria.Categoria</h6>

                @* Mesma partial da aba "Chaves e Grupos" e da página avulsa. *@
                <partial name="_ClassificacaoDoAmericano" model="daCategoria" />

                @* ⚠️ O empate que interessa é o da tabela que DECIDE o título. Empate no topo
                   do grupo A não vira desempate: ali os dois passam do mesmo jeito, e oferecer
                   "montar o desempate" no meio da fase de grupos criaria uma final antes de o
                   grupo final existir. *@
                @if (daCategoria.EmpateNoTitulo)
                {
                    <div class="alert alert-warning small mt-3">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <strong>Empate na liderança.</strong>
                        @if (desempatePrevisto && ehOrganizador)
                        {
                            <span>Os empatados escolhem um parceiro e sai uma partida final.</span>
                            <a asp-action="DesempateAmericano" asp-route-id="@Model.TorneioId"
                               asp-route-categoriaId="@daCategoria.CategoriaId"
                               class="btn btn-sm btn-padel rounded-pill ms-2">
                                <i class="bi bi-trophy"></i> Montar o desempate
                            </a>
                        }
                        else if (desempatePrevisto)
                        {
                            <span>O organizador vai montar a partida final entre os empatados.</span>
                        }
                        else
                        {
                            <span>Este torneio não previu partida de desempate — o critério é do organizador.</span>
                        }
                    </div>
                }
            }
        </div>
    }

    @* SUB-ABA: CLASSIFICAÇÃO (Americano de DUPLAS — a conta é por dupla, que aqui é fixa) *@
    @if (classificacaoAmericanoDuplas != null)
    {
        <div class="tab-pane fade" id="classificacao" role="tabpanel">
            <p class="text-muted small">
                No Americano de Duplas vence a dupla que somar mais <strong>games</strong> ao longo
                do torneio — a dupla é fixa, então a conta é dela.
            </p>

            @foreach (var (categoria, linhas) in classificacaoAmericanoDuplas)
            {
                <h6 class="fw-bold mt-3" style="color: var(--pdz-ink);">@categoria</h6>

                @if (linhas.Count == 0)
                {
                    @* Com a grade sorteada a tabela já nasce cheia e zerada — aqui só sobra o
                       torneio que ainda não tem jogos. *@
                    <p class="text-muted small">A tabela aparece quando os jogos forem sorteados.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle">
                            <thead>
                                <tr class="small text-muted">
                                    <th style="width: 3rem;">#</th>
                                    <th>Dupla</th>
                                    <th class="text-center">Jogos</th>
                                    <th class="text-end">Games</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (var i = 0; i < linhas.Count; i++)
                                {
                                    var l = linhas[i];
                                    <tr class="@(l.Empatada ? "table-warning" : "")">
                                        <td class="fw-bold">@(i + 1)º</td>
                                        <td>
                                            @* A medalha é de quem está LIDERANDO, e liderança
                                               exige jogo jogado: com a tabela nascendo zerada,
                                               sem esta condição a primeira linha da lista
                                               ganharia medalha antes da bola rolar. *@
                                            @if (i == 0 && !l.Empatada && l.Jogos > 0) { <span>🏅 </span> }
                                            @l.Dupla.NomeDeExibicao
                                            @if (l.Empatada)
                                            {
                                                <span class="badge bg-warning text-dark ms-1">empatada</span>
                                            }
                                        </td>
                                        <td class="text-center text-muted">@l.Jogos</td>
                                        <td class="text-end fw-bold">@l.TotalGames</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (linhas.Any(l => l.Empatada))
                    {
                        <div class="alert alert-warning small">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            <strong>Empate na liderança.</strong>
                            @if (desempatePrevisto && linhas.Count(l => l.Empatada) == 2)
                            {
                                <span>
                                    As duas duplas empatadas jogam uma partida final — ela entra na
                                    grade sozinha assim que a última rodada terminar.
                                </span>
                            }
                            else if (desempatePrevisto)
                            {
                                <span>
                                    Mais de duas duplas empatadas — uma partida só não decide, então o
                                    critério fica com o organizador.
                                </span>
                            }
                            else
                            {
                                <span>Este torneio não previu partida de desempate — o critério é do organizador.</span>
                            }
                        </div>
                    }
                }
            }
        </div>
    }
</div>
