@model (List<Padelizou.Models.Partida> Jogos, List<Padelizou.Models.Dupla> Byes, int? MeuJogadorId)
@*
    O mata-mata em FASES EMPILHADAS: cada fase é uma seção, de cima pra baixo, com os jogos
    em cartões numa grade que se adapta à largura — 3-4 por linha no desktop, 1-2 no celular.

    A ÁRVORE com linhas de ligação foi tentada e abandonada de propósito (05/08/2026): num
    quadro de 32 ela tem 16 jogos de largura, e não existe tela em que isso caiba legível —
    no celular virava rolagem infinita com cartões de 90px. O caminho até a final quem conta
    é a PROCEDÊNCIA escrita em cada vaga ("Quem ganhar o jogo 3"), com os jogos numerados: dá
    pra seguir o próprio trajeto sem precisar de geometria nenhuma.

    Vale pra TODO mata-mata — o pós-grupos e o que é só mata-mata usam este mesmo
    componente, então os dois têm exatamente a mesma cara.

    A MONTAGEM (numeração, pareamento, nome das fases, byes nomeados na fase em que entram
    e o caminho do jogador logado) mora em Services/QuadroDoMataMata — aqui é só o desenho.
*@
@{
    var byes = Model.Byes ?? new List<Padelizou.Models.Dupla>();
    var fases = Padelizou.Services.QuadroDoMataMata.Montar(
        Model.Jogos ?? new List<Padelizou.Models.Partida>(), byes, Model.MeuJogadorId);

    string NomeDaDupla(Padelizou.Models.Dupla? d)
    {
        if (d == null) return "A definir";
        if (d.EhTime) return d.NomeTime ?? "Time";
        var n1 = d.Jogador1?.ComoChamar.Split(' ')[0] ?? "?";
        var n2 = d.Jogador2?.ComoChamar.Split(' ')[0] ?? "?";
        return $"{n1} / {n2}";
    }

    // "Quem ganhar o jogo 3", não "Vencedor do jogo 3": é como a pessoa fala e pergunta
    // ("quem ganhar aquele jogo pega quem?"), e não parece um campo de formulário.
    string RotuloDoLado(Padelizou.Services.QuadroDoMataMata.Lado? lado)
    {
        if (lado == null) return "A definir";
        if (lado.ComNome is { } dona) return NomeDaDupla(dona);
        return $"Quem ganhar o jogo {lado.VemDoJogo}";
    }

    // A explicação do quadro, com os números DESTA chave. Sem ela, quem abre a tela vê
    // "folgou a 1ª rodada" ao lado de um nome e não tem como saber por que aquela dupla
    // ganhou a folga — nem que isso é normal em qualquer chaveamento.
    int duplasNaChave = 0, folgaram = 0;
    string faseDaFolga = "";
    if (fases.Count > 0)
    {
        var abertura = fases[0];
        folgaram = byes.Count;
        duplasNaChave = abertura.Vagas.Count(v => v.Jogo != null) * 2 + folgaram;
        faseDaFolga = fases.Count > 1 ? fases[1].Nome : "";
    }

    var jogoFinal = fases.Count > 0 && fases[^1].Nome == "Final"
        ? fases[^1].Vagas.FirstOrDefault()?.Jogo : null;
    var campea = jogoFinal is { Status: "Finalizada", VencedorId: not null }
        ? (jogoFinal.VencedorId == jogoFinal.Dupla1Id ? jogoFinal.Dupla1 : jogoFinal.Dupla2)
        : null;

    // A legenda do caminho pintado só aparece pra quem tem caminho — pra todo mundo que
    // abre o quadro deslogado (ou torcendo), ela seria uma frase sobre nada.
    bool temCaminho = fases.Any(f => f.Vagas.Any(v => v.EhMinha));
}

@if (fases.Count == 0)
{
    return;
}

<div class="pdz-mm">
    <div class="pdz-mm-ajuda">
        <i class="bi bi-info-circle"></i>
        <span>
            Quem perde está fora. Cada jogo é numerado — nas fases que ainda não aconteceram
            está escrito de qual jogo sai cada vaga.
            @if (folgaram > 0)
            {
                <text>
                    São <strong>@duplasNaChave duplas</strong> e a chave tem
                    <strong>@(duplasNaChave + folgaram) lugares</strong>, então
                    <strong>@folgaram</strong> @(folgaram == 1 ? "dupla folga" : "duplas folgam")
                    a primeira rodada e @(folgaram == 1 ? "entra" : "entram")
                    direto @(string.IsNullOrEmpty(faseDaFolga) ? "na fase seguinte" : $"n{(faseDaFolga == "Final" ? "a" : "as")} {faseDaFolga.ToLowerInvariant()}").
                </text>
            }
            @if (temCaminho)
            {
                <text>
                    Em <strong style="color: var(--padel-green);">verde</strong>, o seu caminho:
                    os seus jogos e os que ainda podem ser seus.
                </text>
            }
        </span>
    </div>

    @foreach (var fase in fases)
    {
        <div class="pdz-mm-fase">
            <div class="pdz-mm-titulo">
                @fase.Nome
                <span class="pdz-mm-conta">@fase.Vagas.Count @(fase.Vagas.Count == 1 ? "jogo" : "jogos")</span>
            </div>

            <div class="pdz-mm-grade">
                @foreach (var vaga in fase.Vagas)
                {
                    var jogo = vaga.Jogo;
                    if (jogo != null)
                    {
                        var venceu1 = jogo.VencedorId == jogo.Dupla1Id;
                        var venceu2 = jogo.VencedorId == jogo.Dupla2Id;
                        var aoVivo = jogo.Status == "AoVivo";

                        <div class="pdz-chave-vaga @(vaga.EhMinha ? "pdz-chave-vaga-minha" : "") @(aoVivo ? "pdz-chave-vaga-aovivo" : "")">
                            <div class="pdz-chave-quando">
                                <span class="pdz-chave-num">@vaga.Numero</span>
                                @if (vaga.EhMinha)
                                {
                                    <span class="pdz-chave-selomeu">seu jogo</span>
                                }
                                @if (aoVivo)
                                {
                                    <span class="pdz-chave-aovivo">● AO VIVO</span>
                                }
                                else if (jogo.HorarioPrevisto is DateTime h)
                                {
                                    <span>@h.ToString("dd/MM HH:mm")</span>
                                }
                                else
                                {
                                    <span>por ordem</span>
                                }
                                @if (!string.IsNullOrEmpty(jogo.NomeQuadra))
                                {
                                    <span class="pdz-chave-quadra">@LugarDoJogo.Etiqueta(ViewData.Sedes(), jogo.NomeQuadra)</span>
                                }
                            </div>
                            <span class="pdz-chave-lado @(venceu1 ? "pdz-chave-venceu" : venceu2 ? "text-muted" : "")">
                                <span class="pdz-chave-nome">@NomeDaDupla(jogo.Dupla1)</span>
                                <span class="pdz-chave-games">@(jogo.GamesDupla1?.ToString() ?? "–")</span>
                            </span>
                            <span class="pdz-chave-lado @(venceu2 ? "pdz-chave-venceu" : venceu1 ? "text-muted" : "")">
                                <span class="pdz-chave-nome">@NomeDaDupla(jogo.Dupla2)</span>
                                <span class="pdz-chave-games">@(jogo.GamesDupla2?.ToString() ?? "–")</span>
                            </span>
                        </div>
                    }
                    else
                    {
                        <div class="pdz-chave-vaga pdz-chave-vaga-vazia @(vaga.EhMinha ? "pdz-chave-vaga-minha" : "")">
                            <div class="pdz-chave-quando">
                                <span class="pdz-chave-num">@vaga.Numero</span>
                                @if (vaga.EhMinha)
                                {
                                    <span class="pdz-chave-selomeu">pode ser seu</span>
                                }
                                <span>a definir</span>
                            </div>
                            @foreach (var lado in new[] { vaga.Lado1, vaga.Lado2 })
                            {
                                @* O selo conta POR QUE aquele nome já está numa fase que ainda
                                   não aconteceu — a pergunta é a mesma nos dois casos, muda só
                                   a resposta. "Bye" é jargão de tabela de torneio: quem não é
                                   do meio não faz ideia do que significa, e era a única palavra
                                   da tela que precisava ser explicada. *@
                                <span class="pdz-chave-lado @(lado?.ComNome != null ? "" : "text-muted")">
                                    <span class="pdz-chave-nome">@RotuloDoLado(lado)</span>
                                    @if (lado?.EhBye == true)
                                    {
                                        <span class="pdz-chave-selobye">folgou a 1ª rodada</span>
                                    }
                                    else if (lado?.JaVenceu != null)
                                    {
                                        <span class="pdz-chave-selovem">venceu o jogo @lado.VemDoJogo</span>
                                    }
                                </span>
                            }
                        </div>
                    }
                }
            </div>
        </div>
    }

    <div class="pdz-chave-trofeu">
        @if (campea != null)
        {
            <img src="~/image/pnatinha-feliz-recorte.webp" asp-append-version="true" alt=""
                 width="110" height="114" class="rounded-3" />
            <div class="fw-bold mt-2" style="color: var(--pdz-ink);">Campeão</div>
            <div class="fw-bold" style="color: var(--padel-green);">@NomeDaDupla(campea)</div>
        }
        else
        {
            <i class="bi bi-trophy-fill" style="font-size: 3rem; color: #e0a800;"></i>
            <div class="fw-bold mt-2" style="color: var(--pdz-ink);">Campeão</div>
            <div class="text-muted small">Aguardando...</div>
        }
    </div>
</div>
