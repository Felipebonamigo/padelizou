@model (List<Padelizou.Models.Partida> Jogos, List<Padelizou.Models.Dupla> Byes)
@*
    O mata-mata em FASES EMPILHADAS: cada fase é uma seção, de cima pra baixo, com os jogos
    em cartões numa grade que se adapta à largura — 3-4 por linha no desktop, 1-2 no celular.

    A ÁRVORE com linhas de ligação foi tentada e abandonada de propósito (05/08/2026): num
    quadro de 32 ela tem 16 jogos de largura, e não existe tela em que isso caiba legível —
    no celular virava rolagem infinita com cartões de 90px. O caminho até a final quem conta
    é a PROCEDÊNCIA escrita em cada vaga ("Vencedor do jogo 3"), com os jogos numerados: dá
    pra seguir o próprio trajeto sem precisar de geometria nenhuma.

    Vale pra TODO mata-mata — o pós-grupos e o que é só mata-mata usam este mesmo
    componente, então os dois têm exatamente a mesma cara.

    Quem pegou BYE aparece NOMEADO dentro do jogo futuro em que vai entrar (o pareamento é o
    do robô: vencedores na ordem dos jogos + byes do melhor pro pior, primeiro x último —
    Services/AvancoDaChave + ParearVencedores). Sem isso a dupla que descansou sumia do
    quadro: 24 na chave, 16 visíveis.
*@
@{
    var jogos = Model.Jogos ?? new List<Padelizou.Models.Partida>();
    var byes = Model.Byes ?? new List<Padelizou.Models.Dupla>();

    var ordemDasFases = new[]
    {
        Padelizou.Services.ChaveamentoMataMata.PrimeiraRodada,
        "Oitavas de Final", "Quartas de Final", "Semifinal", "Final"
    };

    string NomeDaDupla(Padelizou.Models.Dupla? d)
    {
        if (d == null) return "A definir";
        if (d.EhTime) return d.NomeTime ?? "Time";
        var n1 = d.Jogador1?.ComoChamar.Split(' ')[0] ?? "?";
        var n2 = d.Jogador2?.ComoChamar.Split(' ')[0] ?? "?";
        return $"{n1} / {n2}";
    }

    // Cada fase vira uma lista de vagas: jogo real, ou jogo futuro com a procedência de
    // cada lado. Numeração GLOBAL na ordem de criação — a mesma que o robô lê, então
    // "Vencedor do jogo 3" aqui e na chave de verdade são o mesmo jogo.
    var fases = new List<(string Nome, List<VagaVM> Vagas)>();
    int numero = 1;

    int primeira = Array.FindIndex(ordemDasFases, f => jogos.Any(j => j.Fase == f));
    if (primeira >= 0)
    {
        // Quem entra na fase seguinte, na ordem do pareamento do robô.
        var entrantes = new List<LadoVM>();

        for (int i = primeira; i < ordemDasFases.Length; i++)
        {
            var faseAtual = ordemDasFases[i];
            var reais = jogos.Where(j => j.Fase == faseAtual).OrderBy(j => j.Id).ToList();
            var vagas = new List<VagaVM>();

            if (reais.Count > 0)
            {
                foreach (var jogo in reais)
                    vagas.Add(new VagaVM { Numero = numero++, Jogo = jogo });

                entrantes = vagas.Select(v => LadoVM.VencedorDe(v.Numero)).ToList();
                entrantes.AddRange(byes.Select(b => LadoVM.Bye(NomeDaDupla(b))));
            }
            else
            {
                int quantos = entrantes.Count / 2;
                if (quantos == 0) break;

                var proximos = new List<LadoVM>();
                for (int k = 0; k < quantos; k++)
                {
                    var vaga = new VagaVM
                    {
                        Numero = numero++,
                        Lado1 = entrantes[k],
                        Lado2 = entrantes[entrantes.Count - 1 - k],
                    };
                    vagas.Add(vaga);
                    proximos.Add(LadoVM.VencedorDe(vaga.Numero));
                }
                entrantes = proximos;
            }

            // Fase REAL fica com o nome dos próprios jogos — com bye ela tem MENOS jogos que
            // o quadro promete, e batizá-la pela contagem rebaixaria uma Primeira Rodada de
            // 2 jogos a "Semifinal". Fase FUTURA não tem jogos ainda: o nome sai do tamanho
            // (vagas × 2 lados), senão uma chave curta termina com a final rotulada "Quartas".
            fases.Add((reais.Count > 0
                ? faseAtual
                : Padelizou.Services.ChaveamentoMataMata.NomeFase(vagas.Count * 2), vagas));

            if (vagas.Count == 1 && reais.Count > 0 && faseAtual == "Final") break;
            if (entrantes.Count < 2) break;
        }
    }

    var jogoFinal = fases.Count > 0 && fases[^1].Nome == "Final"
        ? fases[^1].Vagas.FirstOrDefault()?.Jogo : null;
    var campea = jogoFinal is { Status: "Finalizada", VencedorId: not null }
        ? (jogoFinal.VencedorId == jogoFinal.Dupla1Id ? jogoFinal.Dupla1 : jogoFinal.Dupla2)
        : null;
}

@functions {
    public class LadoVM
    {
        public string Rotulo { get; set; } = "";
        public bool EhBye { get; set; }
        public static LadoVM VencedorDe(int numero) => new() { Rotulo = $"Vencedor do jogo {numero}" };
        public static LadoVM Bye(string nome) => new() { Rotulo = nome, EhBye = true };
    }

    public class VagaVM
    {
        public int Numero { get; set; }
        public Padelizou.Models.Partida? Jogo { get; set; }
        public LadoVM? Lado1 { get; set; }
        public LadoVM? Lado2 { get; set; }
    }
}

@if (fases.Count == 0)
{
    return;
}

<div class="pdz-mm">
    @foreach (var (nome, vagas) in fases)
    {
        <div class="pdz-mm-fase">
            <div class="pdz-mm-titulo">
                @nome
                <span class="pdz-mm-conta">@vagas.Count @(vagas.Count == 1 ? "jogo" : "jogos")</span>
            </div>

            <div class="pdz-mm-grade">
                @foreach (var vaga in vagas)
                {
                    var jogo = vaga.Jogo;
                    if (jogo != null)
                    {
                        var venceu1 = jogo.VencedorId == jogo.Dupla1Id;
                        var venceu2 = jogo.VencedorId == jogo.Dupla2Id;
                        var aoVivo = jogo.Status == "AoVivo";

                        <div class="pdz-chave-vaga @(aoVivo ? "pdz-chave-vaga-aovivo" : "")">
                            <div class="pdz-chave-quando">
                                <span class="pdz-chave-num">@vaga.Numero</span>
                                @if (aoVivo)
                                {
                                    <span class="pdz-chave-aovivo">● AO VIVO</span>
                                }
                                else if (jogo.HorarioPrevisto is DateTime h)
                                {
                                    <span>@h.ToString("dd/MM HH:mm")</span>
                                }
                                else
                                {
                                    <span>por ordem</span>
                                }
                                @if (!string.IsNullOrEmpty(jogo.NomeQuadra))
                                {
                                    <span class="pdz-chave-quadra">@jogo.NomeQuadra</span>
                                }
                            </div>
                            <span class="pdz-chave-lado @(venceu1 ? "pdz-chave-venceu" : venceu2 ? "text-muted" : "")">
                                <span class="pdz-chave-nome">@NomeDaDupla(jogo.Dupla1)</span>
                                <span class="pdz-chave-games">@(jogo.GamesDupla1?.ToString() ?? "–")</span>
                            </span>
                            <span class="pdz-chave-lado @(venceu2 ? "pdz-chave-venceu" : venceu1 ? "text-muted" : "")">
                                <span class="pdz-chave-nome">@NomeDaDupla(jogo.Dupla2)</span>
                                <span class="pdz-chave-games">@(jogo.GamesDupla2?.ToString() ?? "–")</span>
                            </span>
                        </div>
                    }
                    else
                    {
                        <div class="pdz-chave-vaga pdz-chave-vaga-vazia">
                            <div class="pdz-chave-quando">
                                <span class="pdz-chave-num">@vaga.Numero</span>
                                <span>a definir</span>
                            </div>
                            @foreach (var lado in new[] { vaga.Lado1, vaga.Lado2 })
                            {
                                <span class="pdz-chave-lado @(lado?.EhBye == true ? "" : "text-muted")">
                                    <span class="pdz-chave-nome">@(lado?.Rotulo ?? "A definir")</span>
                                    @if (lado?.EhBye == true)
                                    {
                                        <span class="pdz-chave-selobye" title="Passou direto — descansou a rodada anterior">bye</span>
                                    }
                                </span>
                            }
                        </div>
                    }
                }
            </div>
        </div>
    }

    <div class="pdz-chave-trofeu">
        @if (campea != null)
        {
            <img src="~/image/pnatinha-feliz-recorte.webp" asp-append-version="true" alt=""
                 width="110" height="114" class="rounded-3" />
            <div class="fw-bold mt-2" style="color: var(--pdz-ink);">Campeão</div>
            <div class="fw-bold" style="color: var(--padel-green);">@NomeDaDupla(campea)</div>
        }
        else
        {
            <i class="bi bi-trophy-fill" style="font-size: 3rem; color: #e0a800;"></i>
            <div class="fw-bold mt-2" style="color: var(--pdz-ink);">Campeão</div>
            <div class="text-muted small">Aguardando...</div>
        }
    </div>
</div>
