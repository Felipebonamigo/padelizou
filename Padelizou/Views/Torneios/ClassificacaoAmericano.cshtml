@model Padelizou.ViewModels.ClassificacaoAmericanaDaCategoriaVM
@{
    var torneio = ViewBag.Torneio as Padelizou.Models.Torneio;
    ViewData["Title"] = "Classificação - " + torneio?.Nome;
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-1">
        <h3 class="fw-bold mb-0" style="color: var(--pdz-ink);">
            <i class="bi bi-list-ol"></i> Classificação Individual — @torneio?.Nome
        </h3>
        @if (torneio != null)
        {
            <a asp-action="Details" asp-route-id="@torneio.Id" class="btn btn-outline-secondary rounded-pill">
                <i class="bi bi-arrow-left"></i> Voltar ao torneio
            </a>
        }
    </div>
    <p class="text-muted small mb-4">
        @Model.Categoria — no Americano o parceiro muda a cada rodada, então a conta é por jogador:
        cada um leva os games que a dupla dele fez. <strong>Vence quem somar mais.</strong>
    </p>

    @* O desenho mora na partial: esta página, a aba "Chaves e Grupos" e a sub-aba
       "Classificação" dentro de Jogos mostram exatamente a mesma tabela. *@
    <partial name="_ClassificacaoDoAmericano" model="Model" />
</div>
