@model Padelizou.Models.Torneio
@{
    ViewData["Title"] = $"Check-in — {Model.Nome}";

    // A CONTA É EM VAGAS DE CHECK-IN — uma por jogador POR JOGO — desde 12/09/2026. Ela já foi
    // em duplas ("0 de 64"), depois em pessoas (🗣️ *"Mude para um check por jogador"*), e agora
    // em vagas, porque o check passou a ser do JOGO (🗣️ *"tem q ser separado jogo a jogo"*): quem
    // joga duas categorias tem DOIS checks a dar, e contá-lo uma vez faria a barra fechar com
    // gente ainda por marcar.
    //
    // ⚠️ Os números vêm do CONTROLLER, e não de uma conta aqui — refazê-los na view seria a
    // segunda régua. E o denominador ignora jogo FINALIZADO: a pergunta do check-in daquele jogo
    // já foi respondida em quadra.
    var chegadas = ViewBag.Chegadas as IReadOnlyDictionary<(int PartidaId, int JogadorId), DateTime>
                   ?? new Dictionary<(int, int), DateTime>();
    int total = ViewBag.TotalDeJogadores as int? ?? 0;
    int presentes = ViewBag.JogadoresPresentes as int? ?? 0;
    int faltam = total - presentes;
    int pct = total == 0 ? 0 : (int)Math.Round(presentes * 100.0 / total);

    @* A fila já vem ordenada do controller (Services/OrdemNoHorario, a mesma da aba Jogos).
       Reordenar aqui seria a segunda conta de "quem vem antes" — e é assim que duas telas
       passam a discordar sobre a mesma grade. *@
    var jogos = ViewBag.JogosQueVem as List<Padelizou.Models.Partida> ?? new List<Padelizou.Models.Partida>();
    var jaRolaram = ViewBag.JogosQueJaRolaram as List<Padelizou.Models.Partida> ?? new List<Padelizou.Models.Partida>();
}

<div class="container mt-4 mb-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div>
            <h2 class="fw-bold mb-0" style="color: var(--pdz-ink);"><i class="bi bi-clipboard-check"></i> Check-in</h2>
            <p class="text-muted small mb-0">@Model.Nome — marque quem já chegou.</p>
        </div>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary rounded-pill px-3">
            <i class="bi bi-arrow-left"></i> Torneio
        </a>
    </div>

    @* A barra conta o TORNEIO INTEIRO, e não os jogos mostrados: é a resposta de "falta muita
       gente?", que não muda porque a tela agora começa pelos jogos. *@
    <div class="card border-0 shadow-sm mb-4 p-3">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="fw-bold" style="color: var(--pdz-ink);">@presentes de @total presenças confirmadas</span>
            <span class="badge rounded-pill @(faltam == 0 ? "bg-success" : "bg-warning text-dark")">
                @(faltam == 0 ? "todos chegaram" : $"{faltam} faltando")
            </span>
        </div>
        <div class="progress" style="height: 10px;">
            <div class="progress-bar" style="width: @pct%; background: var(--padel-green);"></div>
        </div>
    </div>

    @* ── OS JOGOS QUE VÊM ──────────────────────────────────────────────────────────────
       🗣️ Felipe, 10/09/2026, com o Er em "0 de 64 presentes": *"acho que aqui teria q mudar,
       por próximos jogos, e ver se as pessoas chegaram, e nao todos"*. A lista por categoria
       responde "quem está inscrito"; no dia, a pergunta é "quem joga agora já chegou?".

       ⚠️ O `GroupBy` NÃO reordena: em LINQ to Objects os grupos saem na ordem em que
       aparecem, e a fila já chegou ordenada. Um `OrderBy` aqui seria a régua duplicada. *@
    @if (jogos.Any())
    {
        foreach (var doHorario in jogos.GroupBy(j => j.HorarioPrevisto))
        {
            <h6 class="fw-bold mt-4 mb-2" style="color: var(--pdz-ink);">
                <i class="bi bi-clock"></i>
                @if (doHorario.Key is DateTime quando)
                {
                    <text>@Padelizou.Services.DiaDaSemana.Curto(quando) @quando.ToString("dd/MM 'às' HH:mm")</text>
                }
                else
                {
                    @* Torneio "por ordem de liberação" pode ter jogo sem hora: ele vai pro fim
                       da fila (OrdemNoHorario) e ganha o rótulo em vez de um cabeçalho vazio. *@
                    <text>Sem horário definido</text>
                }
                <span class="text-muted small fw-normal">
                    (@doHorario.Count() @(doHorario.Count() == 1 ? "jogo" : "jogos"))
                </span>
            </h6>

            foreach (var jogo in doHorario)
            {
                <partial name="_JogoNoCheckIn" model="(jogo, chegadas)" />
            }
        }
    }
    else
    {
        <div class="text-center text-muted py-4">
            <i class="bi bi-calendar-x fs-1 d-block mb-2 opacity-50"></i>
            <p class="mb-0">Nenhum jogo agendado — enquanto a chave não sai, a chamada é a lista de baixo.</p>
        </div>
    }

    @* ── AQUI VIVIA O "RESTO DO TORNEIO — TODAS AS DUPLAS" ─────────────────────────────
       Uma lista por categoria, dupla a dupla, fechada num collapse. Ela existia porque a
       presença era do TORNEIO: marcar ali respondia por todos os jogos da pessoa.

       🗣️ Felipe, 12/09/2026: *"o checkin ... nao deveria [herdar], tem q ser separado jogo a
       jogo"*, e a tela deveria virar lista de JOGOS. Ela JÁ É: o bloco de cima traz todos os
       agendados e o de baixo todos os que estão em quadra ou acabaram — juntos, o torneio
       inteiro, jogo a jogo. Manter o "resto" como terceira lista seria desenhar os mesmos jogos
       uma segunda vez, com um contador que conta gente numa tela onde o que se conta é vaga.

       ⚠️ NADA SE PERDE PRA QUEM CHEGA CEDO: o jogo dela está no bloco de cima desde que a grade
       existe, por mais tarde que seja o horário. O que sumiu foi a régua velha, não o caminho. *@

    @* ── O QUE JÁ COMEÇOU OU JÁ ACABOU ─────────────────────────────────────────────────
       🗣️ Felipe, 11/09/2026: *"deixe apenas dos jogos que ainda não começaram, se os jogos ja
       começaram, pode ocultar, coloca la no final da tela minimazado como ja jogaram ou estão
       em jogo"*.

       ⚠️ FECHADO, MAS PRESENTE. Na primeira versão estes jogos sumiam da tela inteira, e quem
       pusesse o jogo no ar antes de marcar a chegada perdia o caminho pro check-in daquela
       dupla — só voltava pela lista de 64. O botão continua aqui dentro, igual ao de cima. *@
    @if (jaRolaram.Any())
    {
        <div class="mt-3">
            <button class="btn btn-outline-secondary btn-sm rounded-pill px-3" type="button"
                    data-bs-toggle="collapse" data-bs-target="#jaJogaram"
                    aria-expanded="false" aria-controls="jaJogaram">
                <i class="bi bi-check2-square"></i> Já jogaram ou estão em jogo (@jaRolaram.Count)
            </button>

            <div class="collapse mt-3" id="jaJogaram">
                @foreach (var jogo in jaRolaram)
                {
                    <partial name="_JogoNoCheckIn" model="(jogo, chegadas)" />
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    @* asp-append-version obrigatório: o Service Worker guarda script em cache e sem a versão
       o organizador fica preso no JS velho indefinidamente. *@
    <script src="~/js/manter-posicao-na-lista.js" asp-append-version="true"></script>
}
