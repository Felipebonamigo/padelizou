@model Padelizou.Models.Dupla
@*
    Um lado de uma partida: os dois chips de jogador — ou o chip do TIME, quando a dupla
    é um time (categoria de times). Sem isto, o card do jogo mostraria o ORGANIZADOR que
    cadastrou o time (é o Jogador1Id da linha) como se fosse ele quem joga.
*@
@if (Model == null) { return; }

@if (Model.EhTime)
{
    <span class="d-flex align-items-center gap-2 mb-1">
        @if (!string.IsNullOrEmpty(Model.Time?.Logo))
        {
            <img src="@Model.Time.Logo" alt="" class="rounded-circle flex-shrink-0 pdz-chip-avatar" />
        }
        else
        {
            <span class="rounded-circle flex-shrink-0 d-inline-flex align-items-center justify-content-center pdz-chip-avatar"
                  style="background: rgba(163,216,39,.18);">
                <i class="bi bi-people-fill" style="color: var(--padel-green);"></i>
            </span>
        }
        <span class="fw-bold pdz-chip-nome">@Model.NomeTime</span>
    </span>
}
else
{
    <partial name="_JogadorChip" model="Model.Jogador1" />
    @if (Model.Jogador2 != null)
    {
        <partial name="_JogadorChip" model="Model.Jogador2" />
    }
    else
    {
        @* VAGA EM ABERTO (09/09/2026). O chip nulo simplesmente não desenhava, e a dupla
           incompleta ficava idêntica a uma partida de SIMPLES na tabela do grupo e no card do
           jogo — quem olhava não tinha como saber que faltava alguém. Sem link: não há perfil
           pra abrir. *@
        <span class="d-flex align-items-center gap-2 mb-1 text-muted pdz-chip-vaga">
            <i class="bi bi-person-plus" aria-hidden="true"></i>
            <span class="pdz-chip-texto">
                <span class="fst-italic d-block pdz-chip-nome">parceiro a definir</span>
            </span>
        </span>
    }
}
