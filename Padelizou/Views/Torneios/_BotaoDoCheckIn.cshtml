@model Padelizou.ViewModels.BotaoDeCheckInVM

@* O BOTÃO QUE GRAVA PRESENÇA — um só, em duas roupas.

   Ele é desenhado em dois lugares: a linha da tela de Check-in (pílula escrita,
   "Chegou"/"Desfazer") e a bolinha na aba Jogos, do lado do nome de cada jogador. O que muda
   entre os dois é a APARÊNCIA; o que é gravado é o mesmo POST.

   ⚠️ POR ISSO ELE VIVE AQUI, e não copiado nos dois. Duas cópias do formulário que ESCREVE no
   banco divergiriam na primeira mudança — e a primeira mudança veio três horas depois de ele
   nascer, quando a presença deixou de ser da dupla e virou da PESSOA. A segunda veio no mesmo
   dia, quando ela deixou de ser do torneio e virou do JOGO: o campo escondido daqui passou de
   `torneioId` pra `partidaId`, e foi a única linha que precisou mudar nas duas telas.

   ⚠️ `voltarPara` diz de qual tela o clique saiu, pra ele voltar pra lá em vez de cair sempre na
   tela de Check-in. O servidor trata isso como LISTA FECHADA (TorneiosController.MarcarCheckIn):
   campo de formulário não vira redirecionamento pra qualquer lugar.

   ⚠️ Sem `[Authorize]`/checagem aqui, de propósito: quem decide quem enxerga isto é a tela, e o
   `MarcarCheckIn` confere de novo no servidor a cada clique (PodeOperarODiaDeJogoAsync). *@

@{
    bool chegou = Model.ChegouEm != null;
    string rotulo = chegou
        ? $"{Model.Nome} chegou {Model.ChegouEm!.Value:HH:mm} — toque pra desfazer"
        : $"Marcar que {Model.Nome} chegou";
}

@* ⚠️ `data-manter-posicao`: marcar presença é um POST que redesenha a página do começo, e numa
   lista de 97 jogos (ou de 128 jogadores) isso custa uma rolagem a cada clique.
   Ver wwwroot/js/manter-posicao-na-lista.js. *@
<form asp-controller="Torneios" asp-action="MarcarCheckIn" method="post" class="flex-shrink-0" data-manter-posicao>
    <input type="hidden" name="jogadorId" value="@Model.JogadorId" />
    <input type="hidden" name="partidaId" value="@Model.PartidaId" />
    <input type="hidden" name="presente" value="@((!chegou).ToString().ToLower())" />
    @if (!string.IsNullOrEmpty(Model.VoltarPara))
    {
        <input type="hidden" name="voltarPara" value="@Model.VoltarPara" />
        @* ⚠️ O RECORTE DA TELA VIAJA JUNTO. Sem isto, marcar uma chegada com a lista filtrada
           numa categoria devolvia a grade inteira do torneio por cima dela — 🗣️ *"ele sai da
           tela, ele tem q sempre se manter na tela da alteracao"*. O servidor só reaproveita as
           chaves que ele mesmo conhece (Services/FiltrosDaListaDeJogos). *@
        <input type="hidden" name="filtros" value="@Padelizou.Services.FiltrosDaListaDeJogos.Atual(Context.Request)" />
    }

    @if (Model.Bolinha)
    {
        <button type="submit" class="pdz-jl-checkin @(chegou ? "pdz-jl-checkin-chegou" : "")"
                title="@rotulo" aria-label="@rotulo">
            <i class="bi @(chegou ? "bi-check-circle-fill" : "bi-circle")"></i>
        </button>
    }
    else
    {
        <button type="submit" class="btn btn-sm @(chegou ? "btn-outline-secondary" : "btn-padel") rounded-pill px-3"
                aria-label="@rotulo">
            @(chegou ? "Desfazer" : "Chegou")
        </button>
    }
</form>
