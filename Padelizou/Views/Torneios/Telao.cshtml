@model Padelizou.Services.TelaoDoTorneio.Quadro
@inject Microsoft.Extensions.Options.IOptions<Padelizou.Services.PatrocinadoresSettings> PatrocinadoresOpcoes
@*
    O TELÃO DO TORNEIO — a tela pra TV do clube (18/11/2026). Ver Services/TelaoDoTorneio.

    ⚠️ SEM O LAYOUT DO SITE: menu, rodapé e "entrar" numa TV são ruído — a página inteira é a tela.
    ⚠️ CSS E JS À MÃO E SIMPLES, porque navegador de Smart TV é velho: nada de módulo, nada de
       sintaxe nova (ver wwwroot/js/telao.js). O `meta refresh` de 10 min é a rede: se o JS nem
       rodar, a TV ainda se atualiza sozinha.
    ⚠️ O VISUAL É O DO MODELO DO FELIPE (18/11/2026): faixa de quadras ao vivo lado a lado, painéis
       de próximos e finalizados embaixo, título em itálico grosso. Fonte do Google com fallback
       pra Arial — sem internet na TV, a tela continua legível.
    ⚠️ OS PATROCINADORES SÃO OS DA PLATAFORMA (PatrocinadoresSettings, os mesmos do rodapé do
       site): não existe patrocinador por torneio. Decisão do Felipe ao pedir a faixa.
*@
@{
    Layout = null;
    var torneio = (Padelizou.Models.Torneio)ViewBag.Torneio;
    var nomeDoClube = ViewBag.NomeDoClube as string;
    var patrocinadores = PatrocinadoresOpcoes.Value.ParaExibir();
    var clube = ViewBag.Clube as int?;
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content="600" />
    <meta name="robots" content="noindex" />
    <title>Telão · @torneio.Nome</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:ital,wght@0,600;0,700;1,700;1,800&display=swap" rel="stylesheet">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        html, body { height: 100%; }
        body { background: radial-gradient(ellipse at 70% -10%, #16304f 0%, #0c1a33 45%, #08132a 100%);
               color: #f1f5f9; font-family: Inter, Arial, Helvetica, sans-serif;
               font-size: 1.4vw; overflow: hidden; display: flex; flex-direction: column; }
        .tl-titulo-fonte, h1, h2, h3, .tl-quadra, .tl-placar, .tl-relogio, .tl-hora { font-family: Poppins, Arial, sans-serif; }
        /* topo */
        .tl-topo { display: flex; align-items: center; gap: 2vw; padding: .9vw 2.4vw .8vw;
                   border-bottom: 0.1vw solid rgba(148,163,184,.25); position: relative; overflow: hidden; }
        .tl-bola { position: absolute; right: 18vw; top: -6vw; width: 16vw; height: 16vw; border-radius: 50%;
                   background: radial-gradient(circle at 35% 35%, #d9f99d 0%, #a3e635 35%, #65a30d 75%, transparent 76%);
                   opacity: .35; filter: blur(.3vw); }
        .tl-logo { height: 4.2vw; width: auto; position: relative; }
        /* VOLTAR (21/11/2026): a página não usa o layout do site, então não herda a seta do topo —
           aberta no celular, era beco sem saída. Discreto pra TV, mas com tamanho mínimo de dedo. */
        .tl-voltar { position: relative; display: inline-flex; align-items: center; justify-content: center;
                     width: 2.6vw; height: 2.6vw; min-width: 34px; min-height: 34px; border-radius: 50%;
                     color: #cbd5e1; text-decoration: none; font-size: max(1.4vw, 18px); line-height: 1;
                     border: .1vw solid rgba(148,163,184,.35); opacity: .6; }
        .tl-voltar:hover, .tl-voltar:focus { opacity: 1; color: #a3e635; }
        .tl-sep { width: .15vw; height: 4.5vw; background: #a3e635; border-radius: .1vw; position: relative; }
        .tl-sep-fina { width: .08vw; height: 4vw; background: rgba(148,163,184,.35); position: relative; }
        .tl-topo h1 { font-size: 2.6vw; line-height: 1; font-style: italic; font-weight: 800; text-transform: uppercase;
                      max-width: 26vw; position: relative; }
        .tl-placar-oficial { color: #cbd5e1; font-size: .95vw; letter-spacing: .35vw; line-height: 1.9; position: relative; }
        .tl-relogio { margin-left: auto; font-size: 3.6vw; font-weight: 700; color: #a3e635; position: relative; }
        .tl-qr { display: flex; align-items: center; gap: .8vw; position: relative; }
        .tl-qr img { width: 6.2vw; height: 6.2vw; background: #fff; padding: .3vw; border-radius: .5vw; display: block; }
        .tl-qr span { color: #cbd5e1; font-size: .78vw; letter-spacing: .12vw; line-height: 1.5; text-transform: uppercase; max-width: 7vw; }
        /* miolo */
        #telao-conteudo { flex: 1; display: flex; flex-direction: column; padding: .6vw 2.4vw 0; min-height: 0; gap: .8vw; }
        .tl-faixa { display: flex; justify-content: space-between; align-items: center; }
        .tl-faixa h2 { font-size: 1.9vw; font-style: italic; font-weight: 800; letter-spacing: .15vw; }
        .tl-contagem { color: #cbd5e1; font-size: 1vw; letter-spacing: .25vw; font-weight: 600; }
        .tl-ponto { display: inline-block; width: 1.1vw; height: 1.1vw; border-radius: 50%; background: #84cc16;
                    vertical-align: middle; margin-right: .6vw; animation: tlpisca 1.4s infinite; }
        @@keyframes tlpisca { 50% { opacity: .3; } }
        .tl-quadras { display: grid; gap: 1.4vw; }
        .tl-card-vivo { background: linear-gradient(180deg, #13284a 0%, #0e1f3d 100%); border: .2vw solid #a3e635;
                        border-radius: 1.1vw; padding: .9vw 1.5vw 1vw; box-shadow: 0 0 1.2vw rgba(163,230,53,.15); min-width: 0; }
        .tl-vazio-vivo { color: #94a3b8; font-size: 1.4vw; text-align: center; padding: 3vw; }
        .tl-card-topo { display: flex; justify-content: space-between; align-items: center; gap: 1vw; }
        .tl-quadra { font-size: 1.7vw; font-style: italic; font-weight: 800; letter-spacing: .1vw;
                     white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .tl-icone-quadra { display: inline-block; width: 2.3vw; height: 1.3vw; border: .15vw solid #e2e8f0; border-radius: .15vw;
                           margin-right: .7vw; vertical-align: -.1vw; background:
                           linear-gradient(90deg, transparent 48%, #e2e8f0 48%, #e2e8f0 52%, transparent 52%); }
        .tl-pilula { background: #a3e635; color: #0b1220; border-radius: 2vw; padding: .25vw .9vw; font-size: .95vw;
                     font-weight: 800; white-space: nowrap; }
        .tl-pilula-ponto { display: inline-block; width: .55vw; height: .55vw; border-radius: 50%; background: #0b1220;
                           margin-right: .4vw; vertical-align: .1vw; }
        .tl-sub { color: #b6c2d4; font-size: 1vw; }
        .tl-card-vivo .tl-sub { margin: .2vw 0 .4vw; }
        .tl-linha { display: flex; justify-content: space-between; align-items: center; gap: 1vw; padding: .35vw 0; }
        .tl-linha-2 { border-top: .1vw solid rgba(148,163,184,.3); }
        .tl-dupla { flex: 1 1 auto; min-width: 0; font-size: 1.45vw; font-weight: 700; line-height: 1.15; overflow: hidden; }
        /* A bolinha do saque (21/11/2026, TelaoDoTorneio.Saca): uma bola de padel ao lado do placar de
           quem saca. Fica entre o nome e o número pra não empurrar nenhum dos dois. */
        .tl-saque { flex: 0 0 auto; width: 1.3vw; height: 1.3vw; min-width: 12px; min-height: 12px; border-radius: 50%;
                    background: radial-gradient(circle at 35% 35%, #ecfccb 0%, #bef264 40%, #84cc16 100%);
                    box-shadow: 0 0 .6vw rgba(163,230,53,.8); }
        .tl-placar { font-size: 3.6vw; font-weight: 800; color: #a3e635; line-height: 1; min-width: 4.4vw; text-align: right; }
        .tl-tiebreak { color: #facc15; font-weight: 700; font-size: 1.2vw; margin-top: .3vw; }
        .tl-palpite { margin-top: .5vw; }
        .tl-palpite-barra { height: .45vw; background: #334155; border-radius: .3vw; overflow: hidden; }
        .tl-palpite-barra span { display: block; height: 100%; background: #84cc16; }
        .tl-palpite-numeros { display: flex; justify-content: space-between; color: #cbd5e1; font-size: .85vw; margin-top: .25vw; }
        .tl-paineis { flex: 1; display: grid; grid-template-columns: 1.3fr 1fr; gap: 1.4vw; min-height: 0; padding-bottom: 1vw; }
        .tl-painel { border: .12vw solid rgba(148,163,184,.35); border-radius: 1.1vw; padding: 1vw 1.6vw;
                     background: rgba(15,30,58,.55); overflow: hidden; }
        .tl-painel h3 { font-size: 1.6vw; font-weight: 700; letter-spacing: .12vw; padding-bottom: .6vw;
                        border-bottom: .1vw solid rgba(148,163,184,.25); }
        .tl-icone { color: #cbd5e1; margin-right: .5vw; }
        .tl-icone-ok { color: #84cc16; }
        .tl-proximo { display: flex; align-items: center; gap: 1.4vw; padding: .55vw 0;
                      border-bottom: .1vw solid rgba(148,163,184,.2); }
        .tl-hora { flex: none; border: .14vw solid #84cc16; color: #a3e635; border-radius: .7vw;
                   padding: .25vw .9vw; font-size: 1.4vw; font-weight: 700; min-width: 7vw; text-align: center; }
        .tl-proximo-texto { border-left: .1vw solid rgba(148,163,184,.4); padding-left: 1.4vw; min-width: 0;
                            display: flex; flex-direction: column; gap: .15vw; }
        .tl-confronto { font-size: 1.2vw; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .tl-confronto i { color: #94a3b8; font-style: normal; margin: 0 .3vw; }
        .tl-finalizado { padding: .5vw 0; border-bottom: .1vw solid rgba(148,163,184,.2); }
        .tl-res { display: flex; justify-content: space-between; gap: 1vw; font-size: 1.3vw; line-height: 1.35; }
        .tl-res span { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .tl-res b { font-family: Poppins, Arial, sans-serif; }
        .tl-venceu { color: #a3e635; font-weight: 700; }
        .tl-vazio { color: #94a3b8; font-size: 1.2vw; padding-top: .8vw; }
        /* rodapé */
        .tl-rodape { display: flex; align-items: center; justify-content: center; gap: 3vw; padding: .8vw 2.4vw;
                     border-top: .1vw solid rgba(148,163,184,.25); position: relative; overflow: hidden; }
        .tl-rodape::before, .tl-rodape::after { content: ""; position: absolute; bottom: -2vw; width: 6vw; height: 8vw;
                     background: linear-gradient(135deg, transparent 40%, #84cc16 40%, #84cc16 55%, transparent 55%); opacity: .6; }
        .tl-rodape::before { left: -1vw; transform: scaleX(-1); }
        .tl-rodape::after { right: -1vw; }
        .tl-rodape .tl-rotulo { color: #cbd5e1; font-size: .9vw; letter-spacing: .2vw; }
        .tl-rodape img { height: 3.2vw; max-width: 14vw; object-fit: contain; }
        .tl-rodape .tl-claro { background: #fff; padding: .35vw .8vw; border-radius: .5vw; }
        .tl-rodape .tl-div { width: .1vw; height: 3vw; background: rgba(148,163,184,.4); }
        .tl-atualizado { position: absolute; right: 8vw; color: #64748b; font-size: .8vw; }
        .tl-atualizado.tl-velho { color: #facc15; }
        /* Os sets já fechados no card da quadra (TelaoDoTorneio.SetsFechados): pequenos, antes do
           número grande do set em jogo; o set que a dupla venceu fica aceso. */
        /* O bloco dos números (sets + placar), sempre à direita e do mesmo tamanho nas duas linhas. */
        .tl-numeros { flex: 0 0 auto; display: flex; align-items: center; gap: .8vw; }
        .tl-set { font-size: 2vw; font-weight: 700; opacity: .45; width: 2.4vw; text-align: center; }
        .tl-set-ganho { opacity: 1; color: #ffd54f; }
        /* O SORTEIO DE BRINDES em destaque (Services/SorteioDeBrindes): os nomes entram um a um. */
        .tl-sorteio { text-align: center; padding: 1.2rem; margin-bottom: 1rem; border-radius: 1rem;
                      background: linear-gradient(135deg, #ffd54f, #ff8f00); color: #1a1a1a; }
        .tl-sorteio h2 { margin: 0 0 .4rem; font-size: 2.2rem; }
        .tl-sorteio ol { list-style: none; padding: 0; margin: 0; font-size: 2.6rem; font-weight: 800; }
        .tl-sorteio li { opacity: 0; animation: tl-sorteio-entra .6s ease-out forwards; }
        @@keyframes tl-sorteio-entra { from { opacity: 0; transform: scale(.6); } to { opacity: 1; transform: scale(1); } }
    </style>
</head>
<body>
    <header class="tl-topo">
        <div class="tl-bola"></div>
        <a class="tl-voltar" asp-action="Details" asp-route-id="@torneio.Id" title="Voltar pro torneio" aria-label="Voltar pro torneio">&#8592;</a>
        <img class="tl-logo" src="~/image/logo-raquetes.webp" asp-append-version="true" alt="Padelizou" />
        <div class="tl-sep"></div>
        <h1>@torneio.Nome</h1>
        <div class="tl-sep-fina"></div>
        <div class="tl-placar-oficial">PLACAR OFICIAL@(nomeDoClube != null ? " · " + nomeDoClube.ToUpperInvariant() : "")<br>ACOMPANHE PELO PADELIZOU</div>
        <div class="tl-relogio" id="telao-relogio">@DateTime.Now.ToString("HH:mm")</div>
        <div class="tl-qr">
            <img src="@ViewBag.QrDoTorneio" alt="QR code do torneio" />
            <span>Aponte a câmera e acompanhe online</span>
        </div>
    </header>

    <main id="telao-conteudo">
        <partial name="_TelaoConteudo" model="Model" />
    </main>

    <footer class="tl-rodape">
        <span class="tl-rotulo">PATROCÍNIO</span>
        @for (int i = 0; i < patrocinadores.Count; i++)
        {
            var p = patrocinadores[i];
            var imagem = !string.IsNullOrWhiteSpace(p.ImagemEscura) ? p.ImagemEscura : p.Imagem;
            if (i > 0) { <span class="tl-div"></span> }
            <img src="@imagem" alt="@p.Nome" class="@(p.LogoEscuro && string.IsNullOrWhiteSpace(p.ImagemEscura) ? "tl-claro" : "")" />
        }
        <span class="tl-atualizado" id="telao-atualizado">atualizado agora</span>
    </footer>

    <script src="~/js/telao.js" asp-append-version="true"
            data-parcial="@Url.Action("Telao", "Torneios", new { id = torneio.Id, clube, parcial = true })"></script>
</body>
</html>
