@model GrupoPrivado
@{
    ViewData["Title"] = $"{Model.Nome} - Padelizou";
    var ranking = (List<JogadorGrupo>)ViewBag.Ranking;
    var rankingMes = (List<padelizou.Controllers.RankingMesItem>)ViewBag.RankingMes;
    int mesConsulta = ViewBag.MesConsulta;
    int anoConsulta = ViewBag.AnoConsulta;
    var jogosRecentes = (List<JogoSemanal>)ViewBag.JogosRecentes;
    var podeMexer = (HashSet<int>)ViewBag.JogosQuePodeMexer;
    bool ehAdmin = ViewBag.EhAdmin == true;
    string[] nomesMeses = { "", "Janeiro", "Fevereiro", "Março", "Abril", "Maio", "Junho", "Julho", "Agosto", "Setembro", "Outubro", "Novembro", "Dezembro" };
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold" style="color: var(--pdz-ink);"><i class="bi bi-shield-lock-fill text-success"></i> @Model.Nome</h2>
            @* O local de sempre fica à vista: é o que vira ranking por clube lá na frente, e
               escondido nas configurações ninguém lembrava de preencher. *@
            <p class="text-muted mb-0">
                <i class="bi bi-geo-alt"></i>
                @if (Model.Clube != null)
                {
                    <text>@Model.Clube.Nome</text>
                }
                else if (ehAdmin)
                {
                    <a asp-controller="Grupos" asp-action="Configuracoes" asp-route-id="@Model.Id" class="text-decoration-none">Escolher o clube onde o grupo joga</a>
                }
                else
                {
                    <text>Sem clube definido</text>
                }
            </p>
            @if (ehAdmin)
            {
                <p class="text-muted mb-0">Código de convite: <code>@Model.CodigoConvite</code></p>
            }
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-controller="Grupos" asp-action="Semana" asp-route-grupoId="@Model.Id" class="btn btn-outline-primary rounded-pill">
                <i class="bi bi-calendar-week"></i> Jogo da Semana
            </a>
            <a asp-controller="Grupos" asp-action="RegistrarJogo" asp-route-grupoId="@Model.Id" class="btn btn-padel rounded-pill">
                <i class="bi bi-plus-circle"></i> Registrar Jogo
            </a>
            <button type="button" class="btn btn-outline-success rounded-pill"
                    data-bs-toggle="modal" data-bs-target="#modalConvidarPanelinha">
                <i class="bi bi-person-plus"></i> Convidar
            </button>
            <a asp-controller="Grupos" asp-action="Index" class="btn btn-outline-secondary rounded-pill">Voltar</a>
        </div>
    </div>

    @* CONVIDAR PRA PANELINHA — dois caminhos, porque são duas situações diferentes:
       o WhatsApp serve pra quem AINDA NÃO TEM CONTA (a maioria de quem a gente quer trazer),
       e o convite pelo sistema serve pra quem já está aqui, caindo direto nas notificações
       dele. Um só dos dois deixaria metade das pessoas de fora. *@
    <div class="modal fade" id="modalConvidarPanelinha" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-person-plus"></i> Convidar pra @Model.Nome</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <div class="modal-body">
                    @{
                        var linkConvite = Url.Action("Entrar", "Grupos",
                            new { codigo = Model.CodigoConvite }, protocol: Context.Request.Scheme);
                        var textoZap = $"Bora jogar? Te convidei pra panelinha \"{Model.Nome}\" no Padelizou. É só entrar por aqui: {linkConvite}";
                    }

                    <p class="fw-bold small mb-2"><i class="bi bi-whatsapp text-success"></i> Pelo WhatsApp</p>
                    <p class="text-muted small">
                        Serve até pra quem ainda não tem conta — o link leva direto pra entrar na panelinha.
                    </p>
                    <a class="btn btn-success rounded-pill w-100 mb-2"
                       href="https://wa.me/?text=@Uri.EscapeDataString(textoZap)"
                       target="_blank" rel="noopener">
                        <i class="bi bi-whatsapp"></i> Escolher no WhatsApp
                    </a>
                    @* Nem todo mundo compartilha pelo zap: quem prefere colar no grupo, num
                       e-mail ou num Instagram precisa do link cru. *@
                    <div class="input-group input-group-sm mb-4">
                        <input type="text" class="form-control" id="linkDoConvite" readonly value="@linkConvite" />
                        <button class="btn btn-outline-secondary" type="button"
                                onclick="navigator.clipboard.writeText(document.getElementById('linkDoConvite').value); this.innerText='Copiado!';">
                            Copiar
                        </button>
                    </div>

                    <p class="fw-bold small mb-2"><i class="bi bi-bell"></i> Pelo sistema</p>
                    <p class="text-muted small">
                        Pra quem já usa o Padelizou. O convite aparece nas notificações da pessoa.
                    </p>
                    <form asp-controller="Grupos" asp-action="ConvidarParaGrupo" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="grupoId" value="@Model.Id" />
                        <div class="input-group">
                            <input type="text" name="identificador" class="form-control"
                                   placeholder="CPF ou login da pessoa" maxlength="60" />
                            <button type="submit" class="btn btn-padel">Convidar</button>
                        </div>
                    </form>

                    @* CHAMAR PRA UM JOGO ≠ CONVIDAR PRA PANELINHA, e a diferença importa: um
                       entra pro ranking e vê tudo pra sempre, o outro é o quarto pra fechar a
                       quadra de quinta. O caminho avulso já existia (ConfirmacaoSessao.Avulso),
                       mas só aparecia lá dentro da tela da semana — quem procurava "convidar"
                       caía aqui e só encontrava o convite definitivo.
                       Só o administrador vê: a ação de convidar avulso é dele, e um link que
                       devolve a pessoa pra lista seria um botão que mente. *@
                    @if (ehAdmin)
                    {
                        @* O convite avulso pendura a pessoa numa SESSÃO (o jogo daquela data), e
                           sessão só existe se o grupo tiver clube, categoria, dia e horário. Sem
                           isso o Convidar devolve pras Configurações — então a falta é dita AQUI,
                           antes do clique, em vez de virar um botão que joga a pessoa pra outra
                           tela sem ela ter pedido. *@
                        var faltaConfigurar = Model.ClubeId == null || Model.CategoriaPadraoId == null
                            || Model.DiaSemanaFixo == null || Model.HorarioFixo == null;

                        <hr class="my-4" />
                        <p class="fw-bold small mb-2"><i class="bi bi-person-check text-primary"></i> Só pro jogo desta semana</p>
                        <p class="text-muted small">
                            A pessoa é chamada pra <strong>um jogo só</strong>, sem entrar na panelinha:
                            ela não entra no ranking do grupo nem enxerga o resto. É o caminho pra
                            completar a quadra quando falta gente.
                        </p>
                        @if (faltaConfigurar)
                        {
                            <div class="alert alert-warning small mb-2 py-2">
                                Pra chamar alguém pra um jogo só, o grupo precisa ter
                                <strong>local, categoria, dia e horário</strong> definidos — é o que
                                diz à pessoa pra onde e a que horas ela está sendo chamada.
                            </div>
                            <a asp-controller="Grupos" asp-action="Configuracoes" asp-route-id="@Model.Id"
                               class="btn btn-outline-secondary rounded-pill w-100">
                                <i class="bi bi-gear"></i> Completar as configurações
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Grupos" asp-action="Convidar" asp-route-grupoId="@Model.Id"
                               class="btn btn-outline-primary rounded-pill w-100">
                                <i class="bi bi-person-plus"></i> Chamar alguém só pra esse jogo
                            </a>
                        }
                    }
                </div>
            </div>
        </div>
    </div>

    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success">@TempData["Sucesso"]</div>
    }

    <div class="row">
        <div class="col-lg-6 mb-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h5 class="fw-bold mb-3" style="color: var(--pdz-ink);">Ranking Geral</h5>
                    @if (ranking.Any())
                    {
                        <ol class="list-group list-group-numbered">
                            @foreach (var item in ranking)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <a asp-controller="Jogadores" asp-action="Perfil" asp-route-id="@item.JogadorId" class="text-decoration-none text-dark">@item.Jogador.SoOApelido</a>
                                    <span class="badge bg-primary rounded-pill">@item.PontuacaoInterna pts</span>
                                </li>
                            }
                        </ol>
                    }
                    else
                    {
                        <partial name="_Vazio" model='@(new EstadoVazio("Nenhum membro ainda."))' />
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-6 mb-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                        <h5 class="fw-bold mb-0" style="color: var(--pdz-ink);">Ranking do Mês</h5>
                        <form asp-controller="Grupos" asp-action="Detalhes" method="get" class="d-flex gap-2">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <select name="mes" class="form-select form-select-sm" onchange="this.form.submit()">
                                @for (int m = 1; m <= 12; m++)
                                {
                                    <option value="@m" selected="@(m == mesConsulta)">@nomesMeses[m]</option>
                                }
                            </select>
                            <select name="ano" class="form-select form-select-sm" onchange="this.form.submit()">
                                @for (int a = DateTime.Today.Year - 1; a <= DateTime.Today.Year + 1; a++)
                                {
                                    <option value="@a" selected="@(a == anoConsulta)">@a</option>
                                }
                            </select>
                        </form>
                    </div>
                    @if (rankingMes.Any(r => r.Pontos > 0))
                    {
                        <ol class="list-group list-group-numbered">
                            @foreach (var item in rankingMes.Where(r => r.Pontos > 0))
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <a asp-controller="Jogadores" asp-action="Perfil" asp-route-id="@item.Jogador.Id" class="text-decoration-none text-dark">@item.Jogador.SoOApelido</a>
                                    <span class="badge bg-success rounded-pill">@item.Pontos pts</span>
                                </li>
                            }
                        </ol>
                    }
                    else
                    {
                        <p class="text-muted">Nenhum jogo registrado em @nomesMeses[mesConsulta]/@anoConsulta.</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <h5 class="fw-bold text-muted mb-3">Jogos recentes</h5>
    @if (jogosRecentes.Any())
    {
        <div class="table-responsive">
            <table class="table table-sm align-middle bg-white shadow-sm rounded text-nowrap">
                <thead>
                    <tr>
                        <th>Data</th>
                        <th>Local</th>
                        <th>Dupla 1</th>
                        <th class="text-center">Placar</th>
                        <th>Dupla 2</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var jogo in jogosRecentes)
                    {
                        <tr>
                            <td>@jogo.DataJogo.ToString("dd/MM/yyyy")</td>
                            <td class="text-muted small">@(jogo.Clube?.Nome ?? "—")</td>
                            @* Só o APELIDO desde 26/08/2026 (nome curto pra quem não tem) — e a
                               vaga do convidado sem nome (id nulo) continua "Convidado", sem
                               link. As duas regras moram em Views/Shared/_NomeNoJogoDaPanelinha,
                               que esta tela divide com a lista da Semana: são a mesma listagem,
                               e divergirem seria o próximo "por que aqui está diferente?". *@
                            <td class="@(jogo.VencedorLado == 1 ? "fw-bold text-success" : "")">
                                <partial name="_NomeNoJogoDaPanelinha" model='@(new Padelizou.ViewModels.NomeNoJogoDaPanelinha(jogo.Dupla1Jogador1Id, jogo.Dupla1Jogador1))' /> /
                                <partial name="_NomeNoJogoDaPanelinha" model='@(new Padelizou.ViewModels.NomeNoJogoDaPanelinha(jogo.Dupla1Jogador2Id, jogo.Dupla1Jogador2))' />
                            </td>
                            @* Placar virou opcional (18/08/2026): jogo lançado só com o
                               vencedor mostra um traço, e NÃO "0 x 0" — que leria como um
                               atropelo pra quem passa o olho na lista. *@
                            <td class="text-center fw-bold">
                                @(Padelizou.Services.ResultadoDoJogoSemanal.Placar(jogo) ?? "—")
                            </td>
                            <td class="@(jogo.VencedorLado == 2 ? "fw-bold text-success" : "")">
                                <partial name="_NomeNoJogoDaPanelinha" model='@(new Padelizou.ViewModels.NomeNoJogoDaPanelinha(jogo.Dupla2Jogador1Id, jogo.Dupla2Jogador1))' /> /
                                <partial name="_NomeNoJogoDaPanelinha" model='@(new Padelizou.ViewModels.NomeNoJogoDaPanelinha(jogo.Dupla2Jogador2Id, jogo.Dupla2Jogador2))' />
                            </td>
                            @* Quem pode corrigir vem PRONTO do controller (`PodeMexerNoJogo`), pra
                               não existir uma segunda cópia da regra aqui dentro.

                               ⚠️ BOTÃO COM PALAVRA, não ícone solto. A primeira versão usava
                               `btn-link text-muted`: um lápis cinza de 13px numa coluna sem
                               cabeçalho, que só acendia no `:hover`. Ninguém achava — a
                               reclamação foi literalmente "estou buscando no escuro com o
                               mouse". E a borda não salva: no tema escuro a casa desenha
                               `btn-outline-*` com `--pdz-border`, que é 10% de opacidade
                               (site.css, "Botão de opção não escolhido"). Quem torna o botão
                               achável aqui é o texto — que é como o resto do app faz. *@
                            <td class="text-end text-nowrap">
                                @if (podeMexer.Contains(jogo.Id))
                                {
                                    <a asp-controller="Grupos" asp-action="EditarJogo" asp-route-id="@jogo.Id"
                                       class="btn btn-sm btn-outline-secondary py-0 px-2" title="Corrigir este jogo">
                                        <i class="bi bi-pencil"></i> Corrigir
                                    </a>
                                    @* A confirmação sai de `data-confirmar` (wwwroot/js/confirmar.js) e nunca de
                                       um onsubmit escrito na view: o Razor trata `@` colado num caractere como
                                       e-mail e cospe o nome da variável literal na tela. *@
                                    <form asp-controller="Grupos" asp-action="ApagarJogo" method="post" class="d-inline ms-1"
                                          data-confirmar="Apagar este jogo? Os pontos dele saem do ranking do grupo.">
                                        <input type="hidden" name="id" value="@jogo.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2"
                                                title="Apagar este jogo">
                                            <i class="bi bi-trash"></i> Apagar
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="col-12">
            <partial name="_Vazio" model='@(new EstadoVazio("Nenhum jogo registrado ainda. Registre o primeiro e o grupo começa a ter ranking."))' />
        </div>
    }
</div>
