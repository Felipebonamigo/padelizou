@{
    ViewData["Title"] = "Registrar Jogo - Padelizou";
    var membros = (List<Jogador>)ViewBag.Membros;
    int grupoId = ViewBag.GrupoId;
    var catalogoClubes = (List<Clube>)ViewBag.CatalogoClubes;
    int? clubeDoGrupoId = ViewBag.ClubeDoGrupoId;

    // Convidado aparece no placar mesmo sem ter aceitado o convite — o lançamento é DEPOIS
    // do jogo, e a essa altura o "aceitar" não muda mais nada: a pessoa jogou.
    //
    // São QUATRO selects com a mesma lista, e é por isso que o rótulo mora numa função só:
    // quatro cópias da mesma linha é como uma delas fica pra trás.
    var convidados = ViewBag.Convidados as HashSet<int> ?? new HashSet<int>();
    Func<Jogador, string> rotulo = j => convidados.Contains(j.Id) ? $"{j.Nome} (convidado)" : j.Nome;

    // Vindo da tela da Semana, a data já é a daquele jogo; vindo do Ranking geral, é hoje.
    var dataSugerida = ViewBag.DataSugerida as DateTime? ?? DateTime.Today;
    var voltarParaSemana = ViewBag.VoltarParaSemana as DateTime?;
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card shadow-sm border-0" style="border-top: 4px solid var(--padel-green);">
                <div class="card-body p-4 p-md-5">
                    <div class="text-center mb-4">
                        <i class="bi bi-clipboard-data display-4" style="color: var(--padel-green);"></i>
                        <h3 class="fw-bold mt-2" style="color: var(--pdz-ink);">Registrar Jogo</h3>
                        <p class="text-muted">Lança o placar e atualiza o ranking do grupo na hora.</p>
                    </div>

                    @if (membros.Count < 4)
                    {
                        <div class="alert alert-warning">
                            Precisa de pelo menos 4 pessoas pra registrar um jogo (2x2) — valem os membros
                            <strong>e quem foi convidado</strong> pro jogo da semana. Chame mais gente pelo
                            código do grupo ou pelo botão <strong>Convidar</strong> na tela da semana.
                        </div>
                    }
                    else
                    {
                        <form asp-controller="Grupos" asp-action="RegistrarJogo" method="post">
                            <input type="hidden" name="grupoId" value="@grupoId" />
                            @if (voltarParaSemana != null)
                            {
                                <input type="hidden" name="voltarParaSemana" value="@voltarParaSemana.Value.ToString("s")" />
                            }

                            <div class="mb-3">
                                <label class="form-label fw-bold text-muted small">Data do jogo</label>
                                <input type="date" name="dataJogo" class="form-control bg-light" required value="@dataSugerida.ToString("yyyy-MM-dd")" />
                                @* ⚠️ A data pré-preenchida pode ser FUTURA: é a do jogo marcado
                                   naquela semana. Lançar um placar com data que ainda não chegou
                                   joga a partida pra semana seguinte no ranking, e ela some do
                                   quadro sem erro nenhum. O aviso só aparece quando é o caso. *@
                                @if (dataSugerida.Date > DateTime.Today)
                                {
                                    <div class="form-text text-warning">
                                        <i class="bi bi-exclamation-triangle"></i>
                                        Esse é o jogo marcado pra @dataSugerida.ToString("dd/MM"), que ainda não chegou.
                                        Se o placar que você vai lançar é de um jogo que já aconteceu, corrija a data.
                                    </div>
                                }
                            </div>

                            @* Local já vem no clube do grupo; trocar aqui vale só pra ESTE jogo. *@
                            <div class="mb-3">
                                <label class="form-label fw-bold text-muted small">Onde jogaram</label>
                                <select name="clubeId" id="selectClube" class="form-select bg-light">
                                    <option value="">-- Não informar --</option>
                                    @* Agrupado por cidade — ver Services/CatalogoLocais. *@
                                    @foreach (var grupo in Padelizou.Services.CatalogoLocais.AgrupadosPorCidade(catalogoClubes))
                                    {
                                        <optgroup label="@grupo.Key">
                                            @foreach (var clube in grupo)
                                            {
                                                <option value="@clube.Id" selected="@(clubeDoGrupoId == clube.Id)">@clube.Nome</option>
                                            }
                                        </optgroup>
                                    }
                                </select>
                                <div class="mt-2 d-flex gap-2">
                                    <input type="text" id="novoClubeNome" maxlength="80" class="form-control form-control-sm" placeholder="Jogaram em outro lugar? Cadastre aqui" />
                                    <button type="button" class="btn btn-sm btn-outline-primary text-nowrap" onclick="adicionarClubeSelect()">
                                        <i class="bi bi-plus-circle"></i> Adicionar
                                    </button>
                                </div>
                                @* Opcional, mas é por ela que o local passa a existir no mapa —
                                   ver Services/UfDoTorneio. *@
                                <div class="mt-2 d-flex gap-2">
                                    <input type="text" id="novoClubeCidade" maxlength="80" class="form-control form-control-sm" placeholder="Cidade do local (opcional)" />
                                    <input type="text" id="novoClubeEstado" maxlength="2" class="form-control form-control-sm text-uppercase" placeholder="UF" style="max-width: 80px;" />
                                </div>
                                @if (clubeDoGrupoId == null)
                                {
                                    <div class="form-text">O grupo ainda não tem local fixo — dá pra definir nas configurações.</div>
                                }
                            </div>

                            <div class="row mb-3">
                                <div class="col-6">
                                    <label class="form-label fw-bold text-muted small">Dupla 1 - Jogador 1</label>
                                    <select name="dupla1Jogador1Id" class="form-select bg-light" required>
                                        @foreach (var m in membros)
                                        {
                                            <option value="@m.Id">@rotulo(m)</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-6">
                                    <label class="form-label fw-bold text-muted small">Dupla 1 - Jogador 2</label>
                                    <select name="dupla1Jogador2Id" class="form-select bg-light" required>
                                        @foreach (var m in membros)
                                        {
                                            <option value="@m.Id">@rotulo(m)</option>
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="row mb-4">
                                <div class="col-6">
                                    <label class="form-label fw-bold text-muted small">Dupla 2 - Jogador 1</label>
                                    <select name="dupla2Jogador1Id" class="form-select bg-light" required>
                                        @foreach (var m in membros)
                                        {
                                            <option value="@m.Id">@rotulo(m)</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-6">
                                    <label class="form-label fw-bold text-muted small">Dupla 2 - Jogador 2</label>
                                    <select name="dupla2Jogador2Id" class="form-select bg-light" required>
                                        @foreach (var m in membros)
                                        {
                                            <option value="@m.Id">@rotulo(m)</option>
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="row mb-4 align-items-center">
                                <div class="col-5">
                                    <label class="form-label fw-bold text-muted small">Games Dupla 1</label>
                                    <input type="number" name="gamesDupla1" class="form-control bg-light" required min="0" />
                                </div>
                                <div class="col-2 text-center fw-bold text-muted mt-3">x</div>
                                <div class="col-5">
                                    <label class="form-label fw-bold text-muted small">Games Dupla 2</label>
                                    <input type="number" name="gamesDupla2" class="form-control bg-light" required min="0" />
                                </div>
                            </div>

                            <button type="submit" class="btn btn-padel btn-lg w-100 rounded-pill">Salvar Resultado</button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @* Implementação ÚNICA — ver wwwroot/js/adicionar-local.js (mesma de Criar Aviso,
       Configurações do grupo e Corrigir Jogo). *@
    <script src="~/js/adicionar-local.js" asp-append-version="true"></script>
}
