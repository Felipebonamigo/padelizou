@{
    ViewData["Title"] = "Registrar Jogo - Padelizou";
    var membros = (List<Jogador>)ViewBag.Membros;
    int grupoId = ViewBag.GrupoId;
    var catalogoClubes = (List<Clube>)ViewBag.CatalogoClubes;
    int? clubeDoGrupoId = ViewBag.ClubeDoGrupoId;

    var convidados = ViewBag.Convidados as HashSet<int> ?? new HashSet<int>();
    var confirmados = ViewBag.Confirmados as HashSet<int> ?? new HashSet<int>();

    var dataSugerida = ViewBag.DataSugerida as DateTime? ?? DateTime.Today;
    var voltarParaSemana = ViewBag.VoltarParaSemana as DateTime?;

    // QUEM CONFIRMOU VEM PRIMEIRO — e é só isso que a confirmação faz.
    //
    // ⚠️ Ordenar, e não filtrar. Foi o pedido de um usuário e está certo: quem jogou e
    // esqueceu de tocar em "vou" no app precisa aparecer aqui igual, senão o resultado não
    // consegue ser lançado por causa de um RSVP. Confirmar só empurra pra cima.
    var ordenados = membros
        .OrderByDescending(m => confirmados.Contains(m.Id))
        .ThenBy(m => m.Nome)
        .ToList();
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">

            @* ══ 1. DATA E CLUBE, COMPACTOS ═════════════════════════════════════════════
               Quem chega aqui veio do jogo da semana, então o sistema JÁ SABE o dia e o
               lugar. Mostrar isso como dois campos de formulário é pedir que a pessoa
               reconfirme o que ela não escolheu — a linha resume, e "Alterar" abre o resto
               só pra quem precisa. *@
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="fw-bold mb-0">Registrar jogo</h4>
                <a asp-action="Detalhes" asp-route-id="@grupoId" class="btn btn-sm btn-outline-secondary">Cancelar</a>
            </div>

            @if (membros.Count < 4)
            {
                <div class="alert alert-warning">
                    Precisa de pelo menos 4 pessoas pra registrar um jogo (2x2) — valem os membros
                    <strong>e quem foi convidado</strong> pro jogo da semana. Chame mais gente pelo
                    código do grupo ou pelo botão <strong>Convidar</strong> na tela da semana.
                </div>
            }
            else
            {
                <form asp-controller="Grupos" asp-action="RegistrarJogo" method="post" id="pdzFormJogo">
                    <input type="hidden" name="grupoId" value="@grupoId" />
                    @if (voltarParaSemana != null)
                    {
                        <input type="hidden" name="voltarParaSemana" value="@voltarParaSemana.Value.ToString("s")" />
                    }

                    @* ⚠️ UMA DATA NA TELA, E ELA É SEMPRE A DO CAMPO.

                       Até 20/08/2026 esta linha de resumo e o aviso amarelo eram desenhados pelo
                       servidor a partir de `dataSugerida` e ficavam CONGELADOS ali. Quem fazia
                       exatamente o que o aviso mandava — tocar em "Alterar" e corrigir a data —
                       terminava com a tela se contradizendo: em cima "26 ago." e o aviso do jogo
                       de 26/08, embaixo o campo já em 19/08. Duas datas ao mesmo tempo e nenhuma
                       pista de qual seria gravada (relato de usuário, com print).

                       Agora o campo `dataJogo` é a única fonte: o resumo é a versão FECHADA do
                       painel (os dois nunca aparecem juntos) e o aviso se recalcula a cada
                       mudança. Quem desenha os dois é o JS, a partir do campo — ver
                       wwwroot/js/registrar-jogo-da-panelinha.js. Texto de data nenhum é
                       escrito aqui, senão volta a existir uma segunda data pra discordar. *@
                    <div class="card border-0 shadow-sm mb-3 d-none" id="pdzResumoDataLocal">
                        <div class="card-body py-2 px-3 d-flex justify-content-between align-items-center gap-2">
                            <span class="fw-bold"><span id="pdzResumoData"></span><span class="text-body-secondary fw-normal" id="pdzResumoLocal"></span></span>
                            <button type="button" class="btn btn-sm btn-link text-decoration-none p-0" id="pdzBtnAlterar">Alterar</button>
                        </div>
                    </div>

                    @* ⚠️ O AVISO DE DATA FUTURA FICA FORA DO BLOCO ESCONDIDO, de propósito.
                       Ele existe porque a pessoa está lançando o resultado de um jogo que
                       ainda não aconteceu — e a data errada joga a partida pra semana
                       seguinte no ranking, onde ela some sem erro nenhum. Aviso que só
                       aparece depois de clicar em "Alterar" não avisa ninguém. *@
                    <div class="alert alert-warning py-2 px-3 small d-none" id="pdzAvisoDataFutura">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <span id="pdzAvisoDataFuturaTexto"></span>
                    </div>

                    <div id="pdzOndeEQuando" class="card border-0 shadow-sm mb-3 d-none">
                        <div class="card-body">
                            <label class="form-label fw-bold text-body-secondary small" for="pdzDataJogo">Data do jogo</label>
                            <input type="date" name="dataJogo" id="pdzDataJogo" class="form-control mb-3" required value="@dataSugerida.ToString("yyyy-MM-dd")" />

                            <label class="form-label fw-bold text-body-secondary small">Onde jogaram</label>
                            <select name="clubeId" id="selectClube" class="form-select">
                                <option value="">-- Não informar --</option>
                                @foreach (var cidade in Padelizou.Services.CatalogoLocais.AgrupadosPorCidade(catalogoClubes))
                                {
                                    <optgroup label="@cidade.Key">
                                        @foreach (var clube in cidade)
                                        {
                                            <option value="@clube.Id" selected="@(clubeDoGrupoId == clube.Id)">@clube.Nome</option>
                                        }
                                    </optgroup>
                                }
                            </select>
                            <div class="mt-2 d-flex gap-2">
                                <input type="text" id="novoClubeNome" maxlength="80" class="form-control form-control-sm" placeholder="Jogaram em outro lugar? Cadastre aqui" />
                                <button type="button" class="btn btn-sm btn-outline-primary text-nowrap" onclick="adicionarClubeSelect()">
                                    <i class="bi bi-plus-circle"></i> Adicionar
                                </button>
                            </div>
                            <div class="mt-2 d-flex gap-2">
                                <input type="text" id="novoClubeCidade" maxlength="80" class="form-control form-control-sm" placeholder="Cidade do local (opcional)" />
                                <input type="text" id="novoClubeEstado" maxlength="2" class="form-control form-control-sm text-uppercase" placeholder="UF" style="max-width: 80px;" />
                            </div>

                            @* Com o painel aberto o resumo some, e com ele o "Alterar" — sem esta
                               saída a pessoa fica sem como fechar o que abriu. *@
                            <div class="mt-3 text-end">
                                <button type="button" class="btn btn-sm btn-outline-secondary" id="pdzFecharOndeEQuando">Pronto</button>
                            </div>
                        </div>
                    </div>

                    @* ══ 2. OS JOGOS DO DIA ═════════════════════════════════════════════

                       ⚠️ TODO BLOCO SAI DO MESMO <template>, INCLUSIVE O PRIMEIRO. A tentação
                       era deixar o jogo 1 escrito aqui e clonar só os seguintes — e aí bastava
                       alguém arrumar um rótulo num lugar pro jogo 2 ficar diferente do jogo 1.
                       Como a tela inteira já é montada pelo JS (os quatro <select> viraram toque
                       no nome em 18/08/2026), nada se perde em desenhar o primeiro por lá também.

                       Os ids reais viajam em hidden inputs; o NOME de cada um é dado pelo JS na
                       hora de numerar os blocos — jogo 1 usa os nomes soltos de sempre
                       (dupla1Jogador1Id, vencedorLado...) e os seguintes vão em
                       maisResultados[i]. Ver o porquê da assimetria em GruposController. *@
                    <div id="pdzJogos"></div>

                    <div class="text-center mb-3">
                        @* Um dia de panelinha tem vários jogos, e não necessariamente com as
                           mesmas duplas — cada bloco escolhe os seus quatro. Data e local são do
                           DIA e ficam lá em cima, uma vez só. *@
                        <button type="button" class="btn btn-sm btn-outline-primary rounded-pill" id="pdzMaisUmJogo">
                            <i class="bi bi-plus-lg"></i> Adicionar outro jogo deste dia
                        </button>
                        <div class="small text-body-secondary mt-2 d-none" id="pdzTetoDeJogos"></div>
                    </div>

                    @* AS DUAS PORTAS PRA QUEM É DE FORA — e elas NÃO são redundantes.

                       O botão "+ Convidado" (desenhado pelo JS junto dos nomes, desde 20/08/2026)
                       resolve A NOITE: o primo do Rafael tapou o buraco, não tem conta, e sem essa
                       vaga o resultado da partida simplesmente não é lançado. Ele é anônimo — não
                       pontua e não vira histórico de ninguém.

                       O convite abaixo resolve A PESSOA: serve pra quem JÁ usa o Padelizou, e é só
                       por ele que o jogo entra no perfil e no ranking de quem jogou.

                       ⚠️ POR ISSO O AVISO AO LADO DO BOTÃO NÃO É ENFEITE: "+ Convidado" custa um
                       toque e o convite custa dois minutos. Sem dizer no ponto do clique o que se
                       perde, todo mundo aperta o botão — inclusive pra gente que TEM conta — e o
                       histórico da panelinha vira uma fileira de anônimos. O texto mora no JS,
                       junto do botão, porque é lá que ele é lido. *@
                    <div class="text-center mb-3">
                        <a asp-action="Convidar" asp-route-grupoId="@grupoId" asp-route-data="@dataSugerida.ToString("s")"
                           class="btn btn-sm btn-link text-body-secondary text-decoration-none">
                            + Jogou alguém de fora que já usa o Padelizou? Convide pra este jogo
                        </a>
                    </div>

                    @* ══ O MOLDE DE UM JOGO ══════════════════════════════════════════════ *@
                    <template id="pdzModeloJogo">
                        <div class="pdz-jogo">
                            @* Só aparece quando há mais de um jogo na tela: com um só, "Jogo 1"
                               é ruído — a tela inteira já é sobre ele. *@
                            <div class="d-flex justify-content-between align-items-center mb-2 d-none pdz-jogo-cabecalho">
                                <h6 class="fw-bold mb-0 pdz-jogo-titulo"></h6>
                                <button type="button" class="btn btn-sm btn-link text-danger text-decoration-none p-0 pdz-jogo-remover">
                                    remover
                                </button>
                            </div>

                            <input type="hidden" class="pdz-c-d1j1" />
                            <input type="hidden" class="pdz-c-d1j2" />
                            <input type="hidden" class="pdz-c-d2j1" />
                            <input type="hidden" class="pdz-c-d2j2" />
                            <input type="hidden" class="pdz-c-venc" value="" />

                            <div class="card border-0 shadow-sm mb-3">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <h6 class="fw-bold mb-0">Dupla 1</h6>
                                        <span class="small text-body-secondary pdz-dica1">Escolha 2 jogadores</span>
                                    </div>
                                    <div class="pdz-times1 d-flex flex-wrap gap-2"></div>
                                </div>
                            </div>

                            <div class="card border-0 shadow-sm mb-3">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <h6 class="fw-bold mb-0">Dupla 2</h6>
                                        <span class="small text-body-secondary pdz-dica2">Escolha 2 jogadores</span>
                                    </div>
                                    <div class="pdz-times2 d-flex flex-wrap gap-2"></div>
                                </div>
                            </div>

                            @* ── QUEM GANHOU ── *@
                            <div class="card border-0 shadow-sm mb-3 d-none pdz-card-vencedor">
                                <div class="card-body">
                                    <h6 class="fw-bold mb-3">Quem ganhou?</h6>
                                    <div class="d-grid gap-2">
                                        <button type="button" class="btn btn-outline-success text-start pdz-btn-vencedor pdz-btn-venc1" data-lado="1"></button>
                                        <div class="text-center small text-body-secondary">×</div>
                                        <button type="button" class="btn btn-outline-success text-start pdz-btn-vencedor pdz-btn-venc2" data-lado="2"></button>
                                    </div>
                                    @* Empate existe na pontuação da panelinha (2 pontos pra cada) e
                                       sumiria numa tela de dois botões. Fica discreto: é raro, mas
                                       quem empatou não pode ficar sem caminho. *@
                                    <div class="text-center mt-2">
                                        <button type="button" class="btn btn-sm btn-link text-body-secondary text-decoration-none pdz-btn-vencedor" data-lado="0">
                                            Empatou
                                        </button>
                                    </div>
                                </div>
                            </div>

                            @* ── PLACAR OPCIONAL ── *@
                            <div class="card border-0 shadow-sm mb-3 d-none pdz-card-placar">
                                <div class="card-body">
                                    <button type="button" class="btn btn-sm btn-link text-decoration-none p-0 pdz-abrir-placar">
                                        + Adicionar placar <span class="text-body-secondary">(opcional)</span>
                                    </button>
                                    <div class="d-none row align-items-center g-2 pdz-placar">
                                        <div class="col-5">
                                            <label class="form-label small text-body-secondary mb-1 pdz-rotulo-games1">Games Dupla 1</label>
                                            <input type="number" class="form-control pdz-c-g1" min="0" inputmode="numeric" />
                                        </div>
                                        <div class="col-2 text-center fw-bold text-body-secondary">x</div>
                                        <div class="col-5">
                                            <label class="form-label small text-body-secondary mb-1 pdz-rotulo-games2">Games Dupla 2</label>
                                            <input type="number" class="form-control pdz-c-g2" min="0" inputmode="numeric" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </template>

                    <button type="submit" class="btn btn-padel btn-lg w-100 rounded-pill" id="pdzSalvar" disabled>
                        Salvar resultado
                    </button>
                </form>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/adicionar-local.js" asp-append-version="true"></script>
    <script src="~/js/registrar-jogo-da-panelinha.js" asp-append-version="true"></script>
    <script>
        @* ⚠️ O SENTINELA E O TETO VÊM DO SERVIDOR, não escritos à mão no JS. São a MESMA régua
           que os dois POSTs conferem (Services/ConvidadoNoJogo): um número digitado aqui seria a
           segunda cópia, e a segunda cópia é sempre a que fica pra trás. *@
        pdzMontarRegistroDeJogo(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            ordenados.Select(m => new {
                id = m.Id,
                nome = Padelizou.Services.NomeBonito.Curto(m.Nome),
                confirmado = confirmados.Contains(m.Id),
                convidado = convidados.Contains(m.Id),
            }))), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
                noFio = Padelizou.Services.ConvidadoNoJogo.NoFio,
                maximo = Padelizou.Services.ConvidadoNoJogo.MaximoPorJogo,
                rotulo = Padelizou.Services.ConvidadoNoJogo.Rotulo,
            })), @Padelizou.Services.ResultadoDoJogoSemanal.MaximoPorLancamento);

        @* A data e o local se desenham a partir do CAMPO, não do servidor — ver o porquê no
           topo da seção em registrar-jogo-da-panelinha.js. *@
        pdzMontarDataDoJogo();
    </script>
}
