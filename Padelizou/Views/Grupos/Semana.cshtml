@model SessaoGrupo
@using System.Security.Claims
@{
    ViewData["Title"] = "Jogo da Semana - Padelizou";
    var grupo = (GrupoPrivado)ViewBag.Grupo;
    bool ehAdmin = ViewBag.EhAdmin == true;
    bool souMembro = ViewBag.SouMembro == true;
    // ⚠️ OS NOMES MUDARAM em 21/08/2026, e a troca é intencional: um `confirmados` cheio de
    // gente que não confirmou nada seria a próxima divergência calada. Ver PresencaNaSessao.
    var naLista = (List<ConfirmacaoSessao>)ViewBag.NaLista;              // Confirmado + Presumido
    int confirmaram = (int)ViewBag.Confirmaram;                          // só quem apertou o botão
    var naoVao = (List<ConfirmacaoSessao>)ViewBag.NaoVao;
    var faltaResponder = (List<ConfirmacaoSessao>)ViewBag.FaltaResponder;
    var minhaConfirmacao = (ConfirmacaoSessao?)ViewBag.MinhaConfirmacao;
    var mensalidades = (List<MensalidadeGrupo>)ViewBag.Mensalidades;
    var ranking = (List<JogadorGrupo>)ViewBag.Ranking;
    var rankingSemana = (List<padelizou.Controllers.RankingMesItem>)ViewBag.RankingSemana;
    DateTime semanaAnterior = ViewBag.SemanaAnterior;
    DateTime proximaSemana = ViewBag.ProximaSemana;
    bool estouNaSemanaAtual = ViewBag.EstouNaSemanaAtual == true;

    // Quantos ainda cabem (ver Services/VagasDaSessao). A conta sai de `naLista`, o mesmo
    // número que a linha acima já mostra — não é consulta nova, é a subtração que a pessoa
    // fazia de cabeça.
    var fraseDasVagas = VagasDaSessao.Frase(naLista.Count, grupo.VagasMaximas);
    bool faltaGente = VagasDaSessao.FaltaGente(naLista.Count, grupo.VagasMaximas);

    // O sorteio de duplas vem por TempData (ver GruposController.SortearDuplas): ele não é
    // dado gravado, é o resultado de um clique que precisa sobreviver ao redirect.
    Padelizou.Services.SorteioDeDuplas.Resultado? sorteio = null;
    if (TempData["SorteioDeDuplas"] is string sorteioJson)
    {
        sorteio = System.Text.Json.JsonSerializer
            .Deserialize<Padelizou.Services.SorteioDeDuplas.Resultado>(sorteioJson);
    }
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold" style="color: var(--pdz-ink);"><i class="bi bi-calendar-week"></i> @grupo.Nome</h2>
            <p class="text-muted mb-0">
                @Model.DataHora.ToString("dddd, dd/MM 'às' HH:mm")
                @if (grupo.Clube != null)
                {
                    <text> — @grupo.Clube.Nome</text>
                }
                — <strong>@naLista.Count na lista</strong>, @confirmaram confirmaram@(naoVao.Any() ? $" · {naoVao.Count} fora" : "")
                @* ⚠️ EM DESTAQUE SÓ QUANDO FALTA. "lista completa" e "3 a mais que as vagas"
                   são informação, não chamado — pintá-las de laranja ensinaria a ignorar a cor
                   justamente na semana em que ela quer dizer "chame alguém". *@
                @if (fraseDasVagas != null)
                {
                    <text> · </text>
                    @if (faltaGente)
                    {
                        <strong class="text-warning">@fraseDasVagas</strong>
                    }
                    else
                    {
                        <span class="text-body-secondary">@fraseDasVagas</span>
                    }
                }
            </p>
            @* ⚠️ A FRASE QUE EXPLICA O NÚMERO. Desde 21/08/2026 silêncio conta como presença, e
               é este número que alguém olha pra reservar quadra — sem esta linha ele parece
               "9 pessoas se comprometeram", que é exatamente o que ele NÃO é. *@
            <p class="small text-body-secondary mb-0">
                Todo mundo da panelinha já entra na lista — <strong>confirmaram</strong> é quem apertou "Vou jogar".
            </p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            @* Convidar é de QUALQUER MEMBRO desde 13/08 — quem está sem o quarto às 19h de
               terça é quem vai jogar, não quem administra. Configurações continua do dono. *@
            @if (souMembro)
            {
                @* O placar morava só no Ranking geral, e quem estava OLHANDO o jogo da semana
                   tinha que sair da tela pra lançar o resultado dele. Aqui a data já é
                   conhecida, então o formulário abre nela — e depois de salvar a pessoa volta
                   pra cá, onde o ranking da semana muda na frente dela. *@
                <a asp-controller="Grupos" asp-action="RegistrarJogo" asp-route-grupoId="@grupo.Id" asp-route-data="@Model.DataHora.ToString("s")" class="btn btn-padel rounded-pill">
                    <i class="bi bi-plus-circle"></i> Registrar Jogo
                </a>
                @* O card da noite fecha o ciclo que o "Registrar Jogo" abre: quem lançou o
                   resultado sai daqui com a arte pronta, em vez de digitar o ranking na mão no
                   grupo do WhatsApp. Fica ao lado dele de propósito — é o passo seguinte. *@
                <a asp-controller="Cartoes" asp-action="Panelinha" asp-route-id="@grupo.Id" asp-route-data="@Model.DataHora.ToString("s")" class="btn btn-outline-primary rounded-pill">
                    <i class="bi bi-images"></i> Card da noite
                </a>
                @* Sólido só quando falta gente — é o único momento em que convidar é a ação
                   principal da tela. Com a lista fechada ele continua ali, apagado: convidar
                   um quinto pra revezar é legítimo, só não é o que a semana está pedindo. *@
                <a asp-controller="Grupos" asp-action="Convidar" asp-route-grupoId="@grupo.Id" asp-route-data="@Model.DataHora.ToString("s")" class="btn rounded-pill @(faltaGente ? "btn-success fw-bold" : "btn-outline-success")">
                    <i class="bi bi-person-plus"></i> Convidar@(faltaGente ? $" ({VagasDaSessao.Faltam(naLista.Count, grupo.VagasMaximas)})" : "")
                </a>
            }
            @if (ehAdmin)
            {
                <a asp-controller="Grupos" asp-action="Configuracoes" asp-route-id="@grupo.Id" class="btn btn-outline-secondary rounded-pill">
                    <i class="bi bi-gear"></i> Configurações
                </a>
            }
            <a asp-controller="Grupos" asp-action="Detalhes" asp-route-id="@grupo.Id" class="btn btn-outline-primary rounded-pill">Ranking geral</a>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center gap-2 mb-4">
        <a asp-controller="Grupos" asp-action="Semana" asp-route-grupoId="@grupo.Id" asp-route-data="@semanaAnterior.ToString("s")" class="btn btn-sm btn-link">
            <i class="bi bi-chevron-left"></i> Semana anterior
        </a>

        @* ⚠️ SEM `asp-route-data` DE PROPÓSITO. Quem decide qual é a semana corrente é o
           controller, e mandar uma data daqui criaria uma segunda resposta pra mesma
           pergunta — que passaria a divergir sozinha na virada do dia do jogo.

           Três cliques pra voltar de uma semana longe é o que fazia a pessoa apagar a URL
           na mão; e clicar em "atual" já estando nela não leva a lugar nenhum, então ali
           o botão vira texto. *@
        @if (estouNaSemanaAtual)
        {
            <span class="small text-muted text-center">
                <i class="bi bi-calendar-check"></i> Esta é a semana atual
            </span>
        }
        else
        {
            <a asp-controller="Grupos" asp-action="Semana" asp-route-grupoId="@grupo.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                <i class="bi bi-calendar-check"></i> Semana atual
            </a>
        }

        <a asp-controller="Grupos" asp-action="Semana" asp-route-grupoId="@grupo.Id" asp-route-data="@proximaSemana.ToString("s")" class="btn btn-sm btn-link">
            Próxima semana <i class="bi bi-chevron-right"></i>
        </a>
    </div>

    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success">@TempData["Sucesso"]</div>
    }
    @if (TempData["Erro"] != null)
    {
        <div class="alert alert-warning">@TempData["Erro"]</div>
    }

    @* Membro do grupo SEMPRE vê os botões, mesmo sem linha de confirmação — o POST cria a dele
       na hora. Amarrar a existência do bloco à confirmação já deixou membro sem como responder. *@
    @if (minhaConfirmacao != null || souMembro)
    {
        var meuStatus = minhaConfirmacao?.Status ?? PresencaNaSessao.Presumido;
        var meuLado = minhaConfirmacao?.Lado;
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body">
                <h6 class="fw-bold mb-3">Sua presença</h6>
                @* ⚠️ A FRASE NUNCA SOME, e cada estado tem a sua. Antes ela só aparecia pra quem
                   não tinha respondido; com a presunção, a maioria das pessoas NUNCA vai
                   responder — e ficaria olhando dois botões sem saber em qual dos dois ela já
                   está. A tela também não pode dizer que você respondeu quando quem respondeu
                   por você foi quem administra (ver PresencaNaSessao.TiradoPeloAdmin). *@
                <p class="small text-muted">
                    @if (meuStatus == PresencaNaSessao.Presumido)
                    {
                        <text>Você já está na lista deste jogo — não precisa confirmar. Se não puder ir, avise agora.</text>
                    }
                    else if (meuStatus == PresencaNaSessao.Confirmado)
                    {
                        <text>Você confirmou presença. Dá pra mudar até a hora do jogo.</text>
                    }
                    else if (meuStatus == PresencaNaSessao.NaoVai && minhaConfirmacao != null && PresencaNaSessao.TiradoPeloAdmin(minhaConfirmacao))
                    {
                        <text>Quem administra te tirou da lista desta semana. Se você vai, aperte "Vou jogar".</text>
                    }
                    else if (meuStatus == PresencaNaSessao.NaoVai)
                    {
                        <text>Você avisou que não vai. Se mudar de ideia, é só apertar "Vou jogar" — você não volta pra lista sozinho.</text>
                    }
                    else if (minhaConfirmacao?.Avulso == true)
                    {
                        <text>Você foi convidado pra esse jogo — confirma se vai?</text>
                    }
                    else
                    {
                        <text>Você ainda não respondeu esse jogo.</text>
                    }
                </p>
                <form asp-controller="Grupos" asp-action="ConfirmarPresenca" method="post" class="d-flex gap-2 align-items-center flex-wrap">
                    <input type="hidden" name="sessaoId" value="@Model.Id" />
                    <select name="lado" class="form-select form-select-sm w-auto">
                        <option value="Esquerda" selected="@(meuLado == "Esquerda")">Esquerda</option>
                        <option value="Direita" selected="@(meuLado == "Direita")">Direita</option>
                    </select>
                    @* Sólido só pra quem APERTOU o botão: quem está presumido não confirmou nada,
                       e pintar o verde cheio pra ele apagaria a diferença que o resto da tela
                       inteira existe pra mostrar. Presumido deixa os dois em outline, e o peso
                       visual sobra pro "Não vou" — a única ação que ele precisa achar. *@
                    <button type="submit" name="vou" value="true" class="btn btn-sm rounded-pill @(meuStatus == PresencaNaSessao.Confirmado ? "btn-success" : "btn-outline-success")">
                        <i class="bi bi-check-circle"></i> Vou jogar
                    </button>
                    <button type="submit" name="vou" value="false" class="btn btn-sm rounded-pill @(meuStatus == PresencaNaSessao.NaoVai ? "btn-danger" : "btn-outline-danger")">
                        Não vou dessa vez
                    </button>
                </form>
            </div>
        </div>
    }

    @if (grupo.ValorMensalidade != null || grupo.ValorAvulso != null)
    {
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body d-flex gap-4 flex-wrap">
                @if (grupo.ValorMensalidade != null)
                {
                    <div><span class="text-muted small">Mensalidade</span><br /><strong>R$ @grupo.ValorMensalidade.Value.ToString("0.00")</strong></div>
                }
                @if (grupo.ValorAvulso != null)
                {
                    <div><span class="text-muted small">Avulso (convidado)</span><br /><strong>R$ @grupo.ValorAvulso.Value.ToString("0.00")</strong></div>
                }
            </div>
        </div>
    }

    @* ══ SORTEADOR DE DUPLAS ═══════════════════════════════════════════════════════════════
       Fica ACIMA das listas e ocupando a largura toda porque é a ação do dia do jogo: as
       listas respondem "quem vem", isto responde "quem joga com quem". *@
    @if (ehAdmin || sorteio != null)
    {
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                    <h6 class="fw-bold mb-0"><i class="bi bi-shuffle"></i> Sorteio das duplas</h6>
                    @if (ehAdmin)
                    {
                        <form asp-controller="Grupos" asp-action="SortearDuplas" method="post" class="d-flex align-items-center gap-3 flex-wrap">
                            <input type="hidden" name="sessaoId" value="@Model.Id" />
                            @* O checkbox manda "false" pelo hidden e "true" pelo checked — sem o
                               hidden, desmarcar não envia campo nenhum e o servidor cai no
                               padrão (true), ou seja, o desmarcar não teria efeito. *@
                            <input type="hidden" name="respeitarLado" value="false" />
                            <div class="form-check mb-0">
                                <input class="form-check-input" type="checkbox" name="respeitarLado"
                                       value="true" id="pdzRespeitarLado" checked />
                                <label class="form-check-label small" for="pdzRespeitarLado">
                                    Respeitar o lado de cada um <span class="text-body-secondary">(direita / esquerda)</span>
                                </label>
                            </div>
                            <button type="submit" class="btn btn-primary fw-bold">
                                <i class="bi bi-shuffle"></i> Sortear duplas
                            </button>
                        </form>
                    }
                </div>

                @if (ehAdmin && sorteio == null)
                {
                    <p class="small text-body-secondary mb-0 mt-2">
                        Sorteia entre os <strong>@naLista.Count da lista</strong>
                        (@(naLista.Count - confirmaram) ainda não responderam), evitando repetir
                        as parcerias das últimas 8 semanas. Pode clicar quantas vezes quiser — nada é gravado.
                    </p>
                }

                @if (sorteio != null)
                {
                    @foreach (var aviso in sorteio.Avisos)
                    {
                        <div class="alert alert-warning py-2 px-3 small mt-3 mb-0 d-flex gap-2 align-items-start">
                            <i class="bi bi-exclamation-triangle-fill"></i> <span>@aviso</span>
                        </div>
                    }

                    @if (sorteio.Duplas.Any())
                    {
                        <div class="row g-2 mt-2">
                            @{ int numeroDaDupla = 1; }
                            @foreach (var dupla in sorteio.Duplas)
                            {
                                <div class="col-12 col-sm-6 col-lg-4">
                                    <div class="border rounded-3 p-2 h-100">
                                        <div class="small text-body-secondary fw-bold mb-1">Dupla @numeroDaDupla</div>
                                        @foreach (var (jogador, ladoDaVez) in new[] { (dupla.Direita, "Direita"), (dupla.Esquerda, "Esquerda") })
                                        {
                                            <div class="d-flex justify-content-between align-items-center gap-2">
                                                <span>@jogador.Nome</span>
                                                @* Quem foi deslocado leva marca própria: sem isso a
                                                   pessoa só descobre na quadra que vai jogar do
                                                   lado que não é o dela. *@
                                                <span class="badge @(jogador.ForaDoLadoDele ? "bg-warning text-dark" : "bg-light text-dark border")"
                                                      title="@(jogador.ForaDoLadoDele ? "Está fora do lado de preferência dele" : "")">
                                                    @ladoDaVez@(jogador.ForaDoLadoDele ? " ⚠" : "")
                                                </span>
                                            </div>
                                        }
                                        @if (dupla.VezesQueJaJogaramJuntos > 0)
                                        {
                                            <div class="small text-body-secondary mt-1">
                                                já jogaram juntos @dupla.VezesQueJaJogaramJuntos× nas últimas 8 semanas
                                            </div>
                                        }
                                    </div>
                                </div>
                                numeroDaDupla++;
                            }
                        </div>
                        <p class="small text-body-secondary mt-3 mb-0">
                            Nada foi gravado — registre os jogos normalmente em <strong>Registrar jogo</strong>.
                        </p>
                    }
                }
            </div>
        </div>
    }

    <div class="row">
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="fw-bold text-success mb-3"><i class="bi bi-check-circle"></i> Na lista (@naLista.Count)</h6>
                    @if (naLista.Any())
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var c in naLista)
                            {
                                <li class="list-group-item px-0">
                                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-1">
                                        <span>
                                            @c.Jogador.ComoChamar
                                            @if (!string.IsNullOrEmpty(c.Lado))
                                            {
                                                <span class="badge bg-light text-dark border">@c.Lado</span>
                                            }
                                            @if (c.Avulso)
                                            {
                                                <span class="badge bg-info-subtle text-dark">convidado</span>
                                            }
                                            @* ⚠️ UM SELO POR PESSOA, e ele é o que sobrou da diferença
                                               entre "disse que vai" e "não disse nada". Sem ele, em um
                                               mês a lista inteira é presumida e ninguém mais sabe. *@
                                            @if (c.Status == PresencaNaSessao.Confirmado)
                                            {
                                                <span class="badge bg-success-subtle text-success-emphasis" title="Apertou 'Vou jogar'">confirmou</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-muted border" title="Está na lista por ser da panelinha — não respondeu">no automático</span>
                                            }
                                        </span>
                                        @* Sem este botão o admin não tem o que fazer com quem está na
                                           lista no automático e ele SABE que não vai: o sorteio das
                                           19h05 montaria dupla pra quem está em casa. *@
                                        @if (ehAdmin)
                                        {
                                            <form asp-controller="Grupos" asp-action="TirarDoJogo" method="post" class="d-inline">
                                                <input type="hidden" name="sessaoId" value="@Model.Id" />
                                                <input type="hidden" name="jogadorId" value="@c.JogadorId" />
                                                <button type="submit" class="btn btn-sm btn-link text-muted p-0"
                                                        title="Tirar da lista desta semana">
                                                    <i class="bi bi-x-lg"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted small mb-0">Ninguém na lista — a panelinha inteira avisou que não vai.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="fw-bold text-warning mb-3"><i class="bi bi-hourglass-split"></i> Falta responder (@faltaResponder.Count)</h6>
                    <small class="text-body-secondary d-block mb-2">
                        Convidados de fora e quem entrou na panelinha depois do jogo começar.
                    </small>
                    @if (faltaResponder.Any())
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var c in faltaResponder)
                            {
                                <li class="list-group-item px-0">
                                    @c.Jogador.ComoChamar
                                    @if (c.Avulso)
                                    {
                                        <span class="badge bg-info-subtle text-dark">convidado</span>
                                    }
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        @* ⚠️ "Todo mundo já respondeu" seria a mentira mais direta da tela agora:
                           ela apareceria justamente quando NINGUÉM respondeu — a panelinha inteira
                           está na lista no automático. *@
                        <p class="text-muted small mb-0">Nenhum convite em aberto.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="fw-bold text-muted mb-3"><i class="bi bi-x-circle"></i> Não vão (@naoVao.Count)</h6>
                    @if (naoVao.Any())
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var c in naoVao)
                            {
                                <li class="list-group-item px-0 text-muted">
                                    @c.Jogador.ComoChamar
                                    @if (c.Avulso)
                                    {
                                        <span class="badge bg-info-subtle text-dark">convidado</span>
                                    }
                                    @* Quem foi tirado pelo admin não "avisou" nada — ver
                                       PresencaNaSessao.TiradoPeloAdmin. *@
                                    @if (PresencaNaSessao.TiradoPeloAdmin(c))
                                    {
                                        <span class="badge bg-light text-muted border">tirado da lista</span>
                                    }
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted small mb-0">Ninguém avisou ausência.</p>
                    }
                </div>
            </div>
        </div>
    </div>

    @* ══ MENSALIDADES ══════════════════════════════════════════════════════════════════════
       ⚠️ SAIU DE DENTRO DO BALDE DE PRESENÇA em 21/08/2026, e não foi arrumação: enquanto o
       botão morava lá, ele listava só quem tinha CONFIRMADO — ou seja, o mensalista que nunca
       aperta o botão NUNCA PODIA SER MARCADO COMO PAGO. Isso era um bug real antes mesmo da
       presunção. E com ela seria pior no outro sentido: a panelinha inteira apareceria na tela
       de dinheiro toda semana. Presença e mensalidade são perguntas diferentes; a lista aqui é
       o roster do grupo (ViewBag.Ranking, já carregado), não quem vai jogar. *@
    @if (ehAdmin && grupo.ValorMensalidade != null)
    {
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body">
                <h6 class="fw-bold mb-3" style="color: var(--pdz-ink);">
                    <i class="bi bi-cash-coin"></i> Mensalidades de @Model.DataHora.ToString("MM/yyyy")
                </h6>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var membro in ranking.OrderBy(r => r.Jogador.Nome))
                    {
                        var pago = mensalidades.Any(m => m.JogadorId == membro.JogadorId && m.Pago);
                        <form asp-controller="Grupos" asp-action="MarcarPagamento" method="post">
                            <input type="hidden" name="grupoId" value="@grupo.Id" />
                            <input type="hidden" name="jogadorId" value="@membro.JogadorId" />
                            <input type="hidden" name="ano" value="@Model.DataHora.Year" />
                            <input type="hidden" name="mes" value="@Model.DataHora.Month" />
                            <input type="hidden" name="data" value="@Model.DataHora.ToString("s")" />
                            <input type="hidden" name="pago" value="@(!pago).ToString().ToLower()" />
                            <button type="submit" class="btn btn-sm rounded-pill @(pago ? "btn-success" : "btn-outline-secondary")">
                                @membro.Jogador.ComoChamar @(pago ? "✓" : "")
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    }

    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="fw-bold mb-3" style="color: var(--pdz-ink);">Ranking da semana</h6>
                    @if (rankingSemana.Any())
                    {
                        <ol class="list-group list-group-numbered">
                            @foreach (var item in rankingSemana.Take(5))
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    @item.Jogador.ComoChamar
                                    <span class="badge bg-primary rounded-pill">@item.Pontos pts</span>
                                </li>
                            }
                        </ol>
                    }
                    else
                    {
                        <p class="text-muted small mb-0">Ainda sem jogo registrado essa semana.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="fw-bold mb-3" style="color: var(--pdz-ink);">Ranking do grupo</h6>
                    @if (ranking.Any(r => r.PontuacaoInterna > 0))
                    {
                        <ol class="list-group list-group-numbered">
                            @foreach (var item in ranking.Where(r => r.PontuacaoInterna > 0).Take(5))
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    @item.Jogador.ComoChamar
                                    <span class="badge bg-primary rounded-pill">@item.PontuacaoInterna pts</span>
                                </li>
                            }
                        </ol>
                    }
                    else
                    {
                        <p class="text-muted small mb-0">Ainda sem resultado registrado.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
