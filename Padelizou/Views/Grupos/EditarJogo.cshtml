@model JogoSemanal
@{
    ViewData["Title"] = "Corrigir Jogo - Padelizou";
    var membros = (List<Jogador>)ViewBag.Membros;
    var catalogoClubes = (List<Clube>)ViewBag.CatalogoClubes;
    string nomeDoGrupo = ViewBag.NomeDoGrupo;

    // Mesmo rótulo do Registrar Jogo: convidado é marcado como tal nos quatro selects, senão
    // quem corrige um placar antigo não entende por que há um nome ali que não é do grupo.
    var convidados = ViewBag.Convidados as HashSet<int> ?? new HashSet<int>();
    Func<Jogador, string> rotulo = j => convidados.Contains(j.Id) ? $"{j.Nome} (convidado)" : j.Nome;
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card shadow-sm border-0" style="border-top: 4px solid var(--padel-green);">
                <div class="card-body p-4 p-md-5">
                    <div class="text-center mb-4">
                        <i class="bi bi-pencil-square display-4" style="color: var(--padel-green);"></i>
                        <h3 class="fw-bold mt-2" style="color: var(--pdz-ink);">Corrigir Jogo</h3>
                        <p class="text-muted">@nomeDoGrupo · o ranking é refeito quando você salvar.</p>
                    </div>

                    <form asp-controller="Grupos" asp-action="EditarJogo" method="post">
                        <input type="hidden" name="id" value="@Model.Id" />

                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted small">Data do jogo</label>
                            <input type="date" name="dataJogo" class="form-control bg-light" required value="@Model.DataJogo.ToString("yyyy-MM-dd")" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted small">Onde jogaram</label>
                            <select name="clubeId" id="selectClube" class="form-select bg-light">
                                <option value="">-- Não informar --</option>
                                @* Agrupado por cidade — ver Services/CatalogoLocais. *@
                                @foreach (var cidade in Padelizou.Services.CatalogoLocais.AgrupadosPorCidade(catalogoClubes))
                                {
                                    <optgroup label="@cidade.Key">
                                        @foreach (var clube in cidade)
                                        {
                                            <option value="@clube.Id" selected="@(Model.ClubeId == clube.Id)">@clube.Nome</option>
                                        }
                                    </optgroup>
                                }
                            </select>
                            <div class="mt-2 d-flex gap-2">
                                <input type="text" id="novoClubeNome" maxlength="80" class="form-control form-control-sm" placeholder="Jogaram em outro lugar? Cadastre aqui" />
                                <button type="button" class="btn btn-sm btn-outline-primary text-nowrap" onclick="adicionarClubeSelect()">
                                    <i class="bi bi-plus-circle"></i> Adicionar
                                </button>
                            </div>
                            @* Opcional, mas é por ela que o local passa a existir no mapa —
                               ver Services/UfDoTorneio. Os mesmos campos da tela de registrar:
                               local cadastrado por uma porta e não pela outra nasceria com
                               cidade só às vezes, sem ninguém perceber. *@
                            <div class="mt-2 d-flex gap-2">
                                <input type="text" id="novoClubeCidade" maxlength="80" class="form-control form-control-sm" placeholder="Cidade do local (opcional)" />
                                <input type="text" id="novoClubeEstado" maxlength="2" class="form-control form-control-sm text-uppercase" placeholder="UF" style="max-width: 80px;" />
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-6">
                                <label class="form-label fw-bold text-muted small">Dupla 1 - Jogador 1</label>
                                <select name="dupla1Jogador1Id" class="form-select bg-light" required>
                                    @foreach (var m in membros)
                                    {
                                        <option value="@m.Id" selected="@(Model.Dupla1Jogador1Id == m.Id)">@rotulo(m)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-6">
                                <label class="form-label fw-bold text-muted small">Dupla 1 - Jogador 2</label>
                                <select name="dupla1Jogador2Id" class="form-select bg-light" required>
                                    @foreach (var m in membros)
                                    {
                                        <option value="@m.Id" selected="@(Model.Dupla1Jogador2Id == m.Id)">@rotulo(m)</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-6">
                                <label class="form-label fw-bold text-muted small">Dupla 2 - Jogador 1</label>
                                <select name="dupla2Jogador1Id" class="form-select bg-light" required>
                                    @foreach (var m in membros)
                                    {
                                        <option value="@m.Id" selected="@(Model.Dupla2Jogador1Id == m.Id)">@rotulo(m)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-6">
                                <label class="form-label fw-bold text-muted small">Dupla 2 - Jogador 2</label>
                                <select name="dupla2Jogador2Id" class="form-select bg-light" required>
                                    @foreach (var m in membros)
                                    {
                                        <option value="@m.Id" selected="@(Model.Dupla2Jogador2Id == m.Id)">@rotulo(m)</option>
                                    }
                                </select>
                            </div>
                        </div>

                        @* ⚠️ QUEM VENCEU VIROU CAMPO, e por isso ele PRECISA estar nesta tela.
                           Enquanto o vencedor era deduzido do placar, corrigir os games
                           acertava o vencedor de graça. Agora não: um editar sem este campo
                           salvaria 6x3 mantendo a outra dupla como vencedora gravada, e o
                           ranking seguiria o vencedor. Ver Services/ResultadoDoJogoSemanal. *@
                        <div class="mb-4">
                            <label class="form-label fw-bold text-muted small">Quem venceu</label>
                            <select name="vencedorLado" class="form-select bg-light" required>
                                <option value="1" selected="@(Model.VencedorLado == 1)">Dupla 1</option>
                                <option value="2" selected="@(Model.VencedorLado == 2)">Dupla 2</option>
                                <option value="0" selected="@(Model.VencedorLado == 0)">Empate</option>
                            </select>
                        </div>

                        <div class="row mb-4 align-items-center">
                            <div class="col-12 mb-1">
                                <span class="form-label fw-bold text-muted small">Placar (opcional)</span>
                            </div>
                            <div class="col-5">
                                <label class="form-label text-muted small">Games Dupla 1</label>
                                <input type="number" name="gamesDupla1" class="form-control bg-light" min="0" value="@Model.GamesDupla1" />
                            </div>
                            <div class="col-2 text-center fw-bold text-muted mt-3">x</div>
                            <div class="col-5">
                                <label class="form-label text-muted small">Games Dupla 2</label>
                                <input type="number" name="gamesDupla2" class="form-control bg-light" min="0" value="@Model.GamesDupla2" />
                            </div>
                            <div class="col-12">
                                <div class="form-text">Deixe os dois em branco se não quiser guardar o placar.</div>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-padel btn-lg w-100 rounded-pill">Salvar Correção</button>
                        <a asp-controller="Grupos" asp-action="Detalhes" asp-route-id="@Model.GrupoId" class="btn btn-link w-100 text-muted mt-2">Cancelar</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @* Implementação ÚNICA — ver wwwroot/js/adicionar-local.js. *@
    <script src="~/js/adicionar-local.js" asp-append-version="true"></script>
}
