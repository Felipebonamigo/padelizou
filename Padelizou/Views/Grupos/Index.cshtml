@model IEnumerable<GrupoPrivado>
@using System.Security.Claims
@{
    ViewData["Title"] = "Meus Grupos - Padelizou";
    var userId = User.Identity!.IsAuthenticated ? int.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier)!) : 0;
    var convites = (List<ConfirmacaoSessao>)ViewBag.ConvitesDeJogo;
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold" style="color: var(--pdz-ink);">Meus Grupos</h2>
            <p class="text-muted mb-0">Ranking interno dos seus jogos semanais, fora de torneio.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Grupos" asp-action="Entrar" class="btn btn-outline-primary rounded-pill">
                <i class="bi bi-box-arrow-in-right"></i> Entrar com código
            </a>
            <a asp-controller="Grupos" asp-action="Criar" class="btn btn-padel rounded-pill">
                <i class="bi bi-plus-circle"></i> Criar Grupo
            </a>
        </div>
    </div>

    @* Jogo de panelinha em que fui chamado de fora. Continua aqui DEPOIS de eu responder: o
       grupo não é meu, então ele nunca entra na lista de baixo, e sem este bloco o jogo sumia
       da tela no segundo em que eu clicava "eu vou". *@
    @if (convites.Any())
    {
        <div class="card shadow-sm border-0 mb-4" style="border-left: 4px solid var(--padel-green);">
            <div class="card-body">
                <h6 class="fw-bold mb-3"><i class="bi bi-person-plus text-success"></i> Jogos em que você foi convidado</h6>
                @foreach (var convite in convites)
                {
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                        <span>
                            <strong>@convite.Sessao.Grupo.Nome</strong> · @convite.Sessao.DataHora.ToString("dd/MM 'às' HH:mm")
                            @* Esta lista é só de CONVITE avulso (ver GruposController.Index), então
                               "Presumido" quase não aparece aqui — mas a régua é a mesma e mora em
                               PresencaNaSessao, pra esta não virar a cópia que discorda das outras. *@
                            @if (convite.Status == PresencaNaSessao.Confirmado)
                            {
                                <span class="badge rounded-pill bg-success">Você vai</span>
                            }
                            else if (convite.Status == PresencaNaSessao.NaoVai)
                            {
                                <span class="badge rounded-pill bg-secondary">Você não vai</span>
                            }
                            else if (convite.Status == PresencaNaSessao.Presumido)
                            {
                                <span class="badge rounded-pill bg-success-subtle text-success-emphasis">Na lista</span>
                            }
                            else
                            {
                                <span class="badge rounded-pill bg-warning text-dark">Falta responder</span>
                            }
                        </span>
                        <a asp-controller="Grupos" asp-action="Semana" asp-route-grupoId="@convite.Sessao.GrupoId" asp-route-data="@convite.Sessao.DataHora.ToString("s")" class="btn btn-sm btn-padel rounded-pill">
                            @(convite.Status == PresencaNaSessao.Pendente ? "Ver e responder" : "Ver o jogo")
                        </a>
                    </div>
                }
            </div>
        </div>
    }

    <div class="row">
        @if (Model != null && Model.Any())
        {
            @foreach (var grupo in Model)
            {
                <div class="col-md-6 col-lg-4 mb-3">
                    @* O CARD INTEIRO abre o grupo. Antes só os dois botões levavam a algum lugar, e
                       clicar no nome da panelinha — que é o gesto óbvio — não fazia nada.
                       ⚠️ `stretched-link` cobre o card com um ::after: tudo que precisa continuar
                       clicável (os botões, o link de configurações) tem que ficar ACIMA dele, daí o
                       position-relative + z-index nos dois blocos de baixo. *@
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body">
                            <h5 class="fw-bold mb-1">
                                <a asp-controller="Grupos" asp-action="Detalhes" asp-route-id="@grupo.Id"
                                   class="stretched-link text-decoration-none" style="color: var(--pdz-ink);">
                                    <i class="bi bi-shield-lock-fill text-success"></i> @grupo.Nome
                                </a>
                            </h5>
                            <p class="text-muted small mb-3">Código de convite: <code>@grupo.CodigoConvite</code></p>
                            <div class="d-flex gap-2 position-relative" style="z-index: 2;">
                                <a asp-controller="Grupos" asp-action="Semana" asp-route-grupoId="@grupo.Id" class="btn btn-sm btn-padel w-100 rounded-pill">Jogo da Semana</a>
                                <a asp-controller="Grupos" asp-action="Detalhes" asp-route-id="@grupo.Id" class="btn btn-sm btn-outline-primary rounded-pill">Ranking</a>
                            </div>
                            @if (grupo.AdministradorId == userId)
                            {
                                <a asp-controller="Grupos" asp-action="Configuracoes" asp-route-id="@grupo.Id" class="btn btn-sm btn-link text-muted mt-1 px-0 position-relative" style="z-index: 2;">
                                    <i class="bi bi-gear"></i> Configurações
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5 rounded-3 bg-light" style="border: 2px dashed var(--pdz-border);">
                <i class="bi bi-people display-4 text-muted mb-3"></i>
                <h4 class="fw-bold text-secondary">Você ainda não está em nenhum grupo</h4>
                @if (convites.Any())
                {
                    @* Ser chamado pra um jogo não é entrar na panelinha — o convite acima vale
                       só pra aquele dia. Sem esta linha, quem já respondeu "eu vou" lê o vazio
                       daqui como se a resposta dele tivesse se perdido. *@
                    <p class="text-muted">O convite lá em cima vale só pro jogo daquele dia. Pra entrar de vez na panelinha, peça o código de convite pra quem organiza.</p>
                }
                else
                {
                    <p class="text-muted">Crie um grupo com seus amigos ou entre em um com um código de convite.</p>
                }
            </div>
        }
    </div>
</div>
