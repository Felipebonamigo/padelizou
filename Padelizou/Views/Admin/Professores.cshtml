@using Padelizou.Services
@using Padelizou.ViewModels
@model List<ProfessorNoAdmin>
@{
    ViewData["Title"] = "Professores - Padelizou";

    var resumo = (ResumoDeProfessores)ViewBag.Resumo;
    var meses = (List<MesDeAssinatura>)ViewBag.Meses;
    var cfg = (PlanoProfessorSettings)ViewBag.Cfg;

    string[] nomeDoMes = { "", "jan", "fev", "mar", "abr", "mai", "jun",
                           "jul", "ago", "set", "out", "nov", "dez" };

    // O selo acompanha o que a situação significa PRA NÓS: verde é quem paga, vermelho é quem
    // parou de pagar, cinza é quem escolheu não pagar — não são todos "avisos".
    Func<string, string> corDoSelo = s => s switch
    {
        "Assinante em dia" => "bg-success",
        "Assinante em atraso" => "bg-danger",
        "Em teste" => "bg-info text-dark",
        "Avulso" => "bg-secondary",
        ProfessoresNoAdmin.NuncaAbriuOPlano => "bg-light text-dark border",
        _ => "bg-warning text-dark",
    };
}

<div class="container mt-4 mb-5">
    @* As telas irmãs deste assunto. A lista mora em Services/PainelAdminAgrupado. *@
    <partial name="_AbasDoPainel" />

    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-0" style="color: var(--pdz-ink);">
                <i class="bi bi-mortarboard"></i> Professores
            </h2>
            <div class="text-muted">Quem dá aula pelo Padelizou, em que plano está e quanto já pagou.</div>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill">
            <i class="bi bi-arrow-left"></i> Voltar ao painel
        </a>
    </div>

    @* ── Os números de cima ──────────────────────────────────────────────────────────── *@
    <div class="row g-2 mb-3">
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body py-3">
                    <div class="text-muted small">Cadastrados</div>
                    <div class="fs-3 fw-bold" style="color: var(--pdz-ink);">@resumo.Cadastrados</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body py-3">
                    <div class="text-muted small">Ativos</div>
                    <div class="fs-3 fw-bold" style="color: var(--padel-green);">@resumo.Ativos</div>
                    <div class="text-muted" style="font-size: .75rem;">
                        com aula nos @ProfessoresNoAdmin.JanelaDeAtividadeEmDias dias pra trás ou pra frente
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body py-3">
                    <div class="text-muted small">Já pagaram alguma vez</div>
                    <div class="fs-3 fw-bold" style="color: var(--pdz-ink);">@resumo.JaPagaramAlgumaVez</div>
                    <div class="text-muted" style="font-size: .75rem;">
                        inclui quem pagou e parou
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body py-3">
                    <div class="text-muted small">Assinatura recebida</div>
                    <div class="fs-3 fw-bold" style="color: var(--padel-green);">@resumo.ReceitaTotal.ToString("C")</div>
                    <div class="text-muted" style="font-size: .75rem;">
                        @resumo.ReceitaNoMes.ToString("C") neste mês
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* Onde cada um está HOJE. Separado dos números de cima porque responde outra pergunta:
       lá é tamanho, aqui é saúde da carteira. *@
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body py-3 d-flex flex-wrap gap-3 align-items-center">
            <span class="fw-bold small text-muted">Situação de hoje:</span>
            <span><span class="badge bg-success">@resumo.AssinantesEmDia</span> assinantes em dia</span>
            <span><span class="badge bg-danger">@resumo.AssinantesEmAtraso</span> em atraso</span>
            <span><span class="badge bg-info text-dark">@resumo.EmTeste</span> em teste</span>
            <span><span class="badge bg-secondary">@resumo.Avulsos</span> avulsos</span>
            <span><span class="badge bg-warning text-dark">@resumo.SemEscolha</span> teste vencido sem escolher</span>
            @* Separado do de cima: um desistiu depois de ver o plano, o outro nunca chegou na
               tela. Só o segundo se resolve mostrando o plano pra ele. *@
            <span><span class="badge bg-light text-dark border">@resumo.NuncaAbriramOPlano</span> nunca abriram o plano</span>
        </div>
    </div>

    @* ── Quanto entrou por mês ───────────────────────────────────────────────────────── *@
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body">
            <h5 class="fw-bold mb-1"><i class="bi bi-calendar3"></i> Assinatura por mês</h5>
            <p class="text-muted small mb-3">
                Pelo mês em que o dinheiro <strong>entrou</strong>, como no caixa.
                @* Sem este aviso, o mês de uma anuidade parece um mês excepcional. *@
                O plano anual (@cfg.AnuidadeAssinante.ToString("C")) aparece <strong>inteiro</strong>
                no mês em que foi pago, não dividido por doze.
            </p>

            @if (!meses.Any())
            {
                <div class="text-muted small">Nenhuma assinatura recebida ainda.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr class="text-muted small">
                                <th>Mês</th>
                                <th class="text-end">Professores</th>
                                <th class="text-end">Cobranças</th>
                                <th class="text-end">Valor</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var m in meses)
                            {
                                <tr>
                                    <td class="fw-bold">@nomeDoMes[m.Mes]/@m.Ano</td>
                                    <td class="text-end">@m.Professores</td>
                                    <td class="text-end">@m.Cobrancas</td>
                                    <td class="text-end fw-bold">@m.Valor.ToString("C")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    @* ── Um por um ───────────────────────────────────────────────────────────────────── *@
    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <h5 class="fw-bold mb-1"><i class="bi bi-people"></i> Cada professor</h5>
            <p class="text-muted small mb-3">
                Começa ordenado por quanto já pagou, depois por movimento de aulas — quem
                sustenta a conta aparece primeiro. Clique em qualquer coluna pra reordenar.
            </p>

            @if (!Model.Any())
            {
                <div class="text-muted small">Ninguém marcado como professor ainda.</div>
            }
            else
            {
                @* ── Filtros ──────────────────────────────────────────────────────────── *@
                <div class="row g-2 mb-3" id="pdz-filtros-professores">
                    <div class="col-sm-5">
                        <label class="form-label small fw-bold" for="filtro-nome">Procurar</label>
                        <input type="search" id="filtro-nome" class="form-control form-control-sm"
                               placeholder="Nome ou e-mail" autocomplete="off" />
                    </div>
                    <div class="col-sm-4">
                        <label class="form-label small fw-bold" for="filtro-situacao">Situação</label>
                        <select id="filtro-situacao" class="form-select form-select-sm">
                            <option value="">Todas</option>
                            @foreach (var s in Model.Select(p => p.Situacao).Distinct().OrderBy(s => s))
                            {
                                <option value="@s">@s</option>
                            }
                        </select>
                    </div>
                    <div class="col-sm-3 d-flex align-items-end">
                        <div class="form-check mb-1">
                            <input class="form-check-input" type="checkbox" id="filtro-pagantes">
                            <label class="form-check-label small" for="filtro-pagantes">Só quem já pagou</label>
                        </div>
                    </div>
                </div>

                @* ⚠️ Cada `th` carrega o ÍNDICE da coluna e cada célula ordenável carrega
                   `data-ordem` com o valor CRU — número invariante e data em `yyyy-MM-dd`.
                   Deixar o JS ordenar o texto da tela colocaria "R$ 1.000,00" antes de
                   "R$ 90,00" e 07/09/2027 antes de 15/08/2026. *@
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0" id="tabela-professores">
                        <thead>
                            <tr class="text-muted small">
                                <th role="button" data-coluna="0" data-tipo="texto">Professor <span class="pdz-seta"></span></th>
                                <th role="button" data-coluna="1" data-tipo="texto">Situação <span class="pdz-seta"></span></th>
                                <th role="button" data-coluna="2" data-tipo="numero" class="text-end">Pago até <span class="pdz-seta"></span></th>
                                <th role="button" data-coluna="3" data-tipo="numero" class="text-end">Já pagou <span class="pdz-seta"></span></th>
                                <th role="button" data-coluna="4" data-tipo="numero" class="text-end">Aulas <span class="pdz-seta"></span></th>
                                <th role="button" data-coluna="5" data-tipo="numero" class="text-end">Última aula <span class="pdz-seta"></span></th>
                                <th role="button" data-coluna="6" data-tipo="numero" class="text-end">Desde <span class="pdz-seta"></span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model)
                            {
                                <tr data-procurar="@($"{p.Nome} {p.Email}".ToLowerInvariant())"
                                    data-situacao="@p.Situacao"
                                    data-pagante="@(p.QuantidadeDePagamentos > 0 ? "1" : "0")">
                                    <td data-ordem="@p.Nome.ToLowerInvariant()">
                                        <a asp-controller="Jogadores" asp-action="Perfil" asp-route-id="@p.Id"
                                           class="fw-bold text-decoration-none">@p.Nome</a>
                                        @if (!string.IsNullOrWhiteSpace(p.Email))
                                        {
                                            <div class="text-muted" style="font-size: .75rem;">@p.Email</div>
                                        }
                                    </td>
                                    <td data-ordem="@p.Situacao">
                                        <span class="badge @corDoSelo(p.Situacao)">@p.Situacao</span>
                                        @if (p.Situacao == "Em teste" && p.FimDoTeste != null)
                                        {
                                            <div class="text-muted" style="font-size: .75rem;">
                                                até @p.FimDoTeste.Value.ToString("dd/MM")
                                            </div>
                                        }
                                    </td>
                                    <td class="text-end" data-ordem="@(p.AssinaturaPagaAte?.ToString("yyyyMMdd") ?? "")">
                                        @(p.AssinaturaPagaAte?.ToString("dd/MM/yyyy") ?? "—")
                                    </td>
                                    <td class="text-end" data-ordem="@(p.QuantidadeDePagamentos > 0 ? p.TotalPago.ToString(System.Globalization.CultureInfo.InvariantCulture) : "")">
                                        @if (p.QuantidadeDePagamentos > 0)
                                        {
                                            <span class="fw-bold">@p.TotalPago.ToString("C")</span>
                                            <div class="text-muted" style="font-size: .75rem;">
                                                @p.QuantidadeDePagamentos @(p.QuantidadeDePagamentos == 1 ? "pagamento" : "pagamentos"),
                                                último em @p.UltimoPagamentoEm!.Value.ToString("dd/MM/yy")
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td class="text-end" data-ordem="@p.AulasNoTotal">
                                        @p.AulasNoTotal
                                        @if (p.AulasNosUltimos30Dias > 0)
                                        {
                                            <div class="text-success" style="font-size: .75rem;">
                                                @p.AulasNosUltimos30Dias por perto
                                            </div>
                                        }
                                    </td>
                                    <td class="text-end" data-ordem="@(p.UltimaAulaEm?.ToString("yyyyMMdd") ?? "")">
                                        @(p.UltimaAulaEm?.ToString("dd/MM/yy") ?? "—")
                                    </td>
                                    <td class="text-end text-muted" data-ordem="@(p.Desde?.ToString("yyyyMMdd") ?? "")">
                                        @(p.Desde?.ToString("dd/MM/yy") ?? "—")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @* Sem esta linha, filtrar até sobrar zero deixa a tela parecendo quebrada —
                   e filtrar até sobrar 3 esconde que existem 11. *@
                <div class="text-muted small mt-2" id="conta-professores"></div>
                <div class="text-muted small mt-2 d-none" id="nada-encontrado">
                    Nenhum professor com esses filtros.
                </div>
            }
        </div>
    </div>

    <div class="text-muted small mt-3">
        <i class="bi bi-info-circle"></i>
        <strong>Situação</strong> é calculada na hora pela mesma régua que cobra a aula
        (<code>PlanoDoProfessor</code>): assinante com mensalidade vencida há mais de
        @cfg.DiasDeCarencia dias já está pagando a taxa cheia de @cfg.PercentualAvulso.ToString("0.#")%.
        <strong>Já pagou</strong> soma assinaturas confirmadas em qualquer forma de recebimento.
    </div>
</div>

@section Scripts {
    <script asp-append-version="true" src="~/js/admin-professores.js"></script>
}
