@{
    ViewData["Title"] = "Painel Admin - Padelizou";
    var ehRaiz = (bool)ViewBag.EhRaiz;
}

<div class="container mt-4 mb-5">
    <div class="mb-4">
        <h2 class="fw-bold" style="color: var(--pdz-ink);">Painel Admin</h2>
        <p class="text-muted mb-0">Administração do sistema.</p>
    </div>

    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success">@TempData["Sucesso"]</div>
    }

    <div class="row g-3">
        <div class="col-md-6">
            <a asp-controller="Admin" asp-action="Metricas" class="text-decoration-none">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <h5 class="fw-bold mb-1" style="color: var(--pdz-ink);"><i class="bi bi-graph-up"></i> Métricas de uso</h5>
                        <p class="text-muted small mb-0">Cadastros, inscrições, pagamentos e o medidor do teto do MEI.</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-6">
            <a asp-controller="Admin" asp-action="Feedbacks" class="text-decoration-none">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <h5 class="fw-bold mb-1" style="color: var(--pdz-ink);"><i class="bi bi-chat-heart"></i> Opiniões dos jogadores</h5>
                        <p class="text-muted small mb-0">O que escreveram sobre o site, a nota de 0 a 10, e o que publicar.</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-6">
            <a asp-controller="Admin" asp-action="RegistroResultados" class="text-decoration-none">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <h5 class="fw-bold mb-1" style="color: var(--pdz-ink);"><i class="bi bi-person-raised-hand"></i> Registro de resultados</h5>
                        <p class="text-muted small mb-0">Organizadores pedindo nossa equipe pra lançar os jogos. Confirmar disponibilidade e valor.</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-6">
            <a asp-controller="Admin" asp-action="Clubes" class="text-decoration-none">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <h5 class="fw-bold mb-1" style="color: var(--pdz-ink);"><i class="bi bi-shop"></i> Clubes</h5>
                        <p class="text-muted small mb-0">Atribuir ou trocar o dono de cada clube.</p>
                    </div>
                </div>
            </a>
        </div>
        @if (ehRaiz)
        {
            <div class="col-md-6">
                <a asp-controller="Admin" asp-action="Administradores" class="text-decoration-none">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body">
                            <h5 class="fw-bold mb-1" style="color: var(--pdz-ink);"><i class="bi bi-person-badge"></i> Administradores</h5>
                            <p class="text-muted small mb-0">Nomear ou remover administradores do sistema.</p>
                        </div>
                    </div>
                </a>
            </div>
        }
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h5 class="fw-bold mb-1" style="color: var(--pdz-ink);"><i class="bi bi-bell"></i> Notificação de teste (push)</h5>
                    <p class="text-muted small mb-3">Manda um push de teste pra todo mundo que instalou o app e ativou notificações.</p>
                    <form asp-controller="Admin" asp-action="EnviarNotificacaoTeste" method="post">
                        <button type="submit" class="btn btn-sm btn-padel rounded-pill px-3">Enviar teste</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
