@* Singleton do DI: a contagem é do PROCESSO, não da requisição. Injetado aqui em vez de vir
   pelo ViewBag porque o painel é a única tela que lê isto. *@
@inject Padelizou.Services.VolumeDoWhatsApp Volume

@{
    ViewData["Title"] = "Painel Admin - Padelizou";
    var ehRaiz = (bool)ViewBag.EhRaiz;
    var portaoLigado = (bool)ViewBag.PortaoLigado;
    var portaoDecididoAqui = (bool)ViewBag.PortaoDecididoAqui;

    // O texto da confirmação sai daqui, e não de um `@(...)` dentro do atributo onsubmit:
    // condicional com aspas dentro de atributo é o tipo de linha que quebra na primeira
    // mexida e só dá sinal no navegador.
    var avisoDoPortao = portaoLigado
        ? "Desligar o portão? O site fica ABERTO: qualquer pessoa entra e se cadastra sem senha."
        : "Ligar o portão? Quem não tem conta volta a precisar da senha compartilhada.";
}

<div class="container mt-4 mb-5">
    <div class="mb-4">
        <h2 class="fw-bold" style="color: var(--pdz-ink);">Painel Admin</h2>
        <p class="text-muted mb-0">Administração do sistema.</p>
    </div>

    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success">@TempData["Sucesso"]</div>
    }

    @* O selo do canal de WhatsApp. Só aparece quando é PROBLEMA: no dev ele vive desligado de
       propósito, e um alarme sempre aceso é um alarme que ninguém mais olha. O estado vem da
       última passada do vigia (memória), não de uma consulta na hora — o painel não pode
       depender de uma chamada de rede pra abrir. *@
    @{
        var estadoWhats = Padelizou.Services.VigiaDoWhatsAppBackgroundService.UltimoEstado;
        var checadoEm = Padelizou.Services.VigiaDoWhatsAppBackgroundService.UltimaChecagem;
    }
    @if (Padelizou.Services.DiagnosticoDoCanal.EhProblema(estadoWhats))
    {
        <div class="alert alert-danger border-0 shadow-sm">
            <h5 class="fw-bold mb-1"><i class="bi bi-whatsapp"></i> O WhatsApp não está enviando</h5>
            <p class="mb-1">@Padelizou.Services.DiagnosticoDoCanal.Frase(estadoWhats)</p>
            <p class="small mb-0">
                A grande maioria das contas só é alcançável por WhatsApp — enquanto isso durar,
                o aviso não chega em quase ninguém, e o que falha <strong>não é reenviado</strong>.
                @if (checadoEm != null)
                {
                    <text>Conferido às @checadoEm.Value.ToString("HH:mm").</text>
                }
            </p>
        </div>
    }

    @* O MEDIDOR DO CANAL. Discreto e SEMPRE visível, ao contrário do alarme acima — são coisas
       diferentes: alarme vermelho é pra problema, isto aqui é dado.

       ⚠️ Ele existe por duas cegueiras que custaram caro. (1) O canal ficou DESLIGADO em
       produção de 04/08 a 07/08 e ninguém notou: o vigia trata `Desligado` como "dev, tudo
       certo" e não alerta, e o painel não mostrava nada. Prod e dev rodam os dois como
       `Production`, então não dá pra separar por ambiente — o jeito honesto é mostrar o estado
       sempre e deixar quem lê decidir se aquele "desligado" é o esperado. (2) Nunca soubemos
       QUANTO sai: nem nós nem a Evolution guardam a saída, e foi às cegas que o número queimou. *@
    @{
        var agoraWhats = DateTime.Now;
        var naHora = Volume.NaUltimaHora(agoraWhats);
        var noDia = Volume.NoDia(agoraWhats);
        var tetoDoDia = Volume.TetoDoDia(agoraWhats);
    }
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body py-2 px-3">
            <div class="d-flex flex-wrap align-items-center gap-2 small">
                <span class="fw-bold" style="color: var(--pdz-ink);"><i class="bi bi-whatsapp"></i> Canal</span>
                <span class="text-muted">@Padelizou.Services.DiagnosticoDoCanal.Frase(estadoWhats)</span>

                <span class="ms-auto text-muted">
                    <strong>@naHora</strong>/@Padelizou.Services.TetoDoWhatsApp.PorHora na hora
                    · <strong>@noDia</strong>/@tetoDoDia hoje
                </span>

                @if (Volume.AindaAquecendo(agoraWhats))
                {
                    <span class="badge rounded-pill text-bg-warning">aquecendo</span>
                }
                @if (Volume.BloqueadasPeloTeto > 0)
                {
                    <span class="badge rounded-pill text-bg-danger"
                          title="Mensagens que o teto barrou desde que o app subiu. Elas NÃO são reenviadas.">
                        @Volume.BloqueadasPeloTeto barrada(s) pelo teto
                    </span>
                }
            </div>
        </div>
    </div>

    @* O ACERTO DE CONSENTIMENTO. Só aparece enquanto houver gente no canal por herança —
       feito o acerto, some sozinho. Admin RAIZ: mexe na preferência de dezenas de pessoas
       e manda mensagem pra todas. Ver Services/ConsentimentoDoWhatsApp. *@
    @if (ehRaiz && (int)ViewBag.NoWhatsAppSemTerPedido > 0)
    {
        <div class="alert alert-warning border-0 shadow-sm">
            <h5 class="fw-bold mb-1"><i class="bi bi-person-check"></i> @ViewBag.NoWhatsAppSemTerPedido pessoa(s) no WhatsApp sem terem pedido</h5>
            <p class="small mb-2">
                São contas anteriores a 04/08/2026, quando a caixinha ainda nascia marcada.
                <strong>É esta a régua que a Meta usa</strong> — mandar pra quem não pediu —, e foi
                por isso que o número foi restringido. Desmarcar tira o risco pela raiz; quem quiser
                o canal volta num toque, e das contas novas <strong>3 em cada 4 pedem</strong>.
            </p>
            <form asp-controller="Admin" asp-action="DesfazerOptInDoWhatsApp" method="post"
                  data-confirmar="Desmarcar o WhatsApp de @ViewBag.NoWhatsAppSemTerPedido pessoa(s) e convidar cada uma a voltar, pelo app e por e-mail?">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm btn-outline-dark rounded-pill px-3 fw-bold">
                    Desmarcar e convidar de volta
                </button>
            </form>
        </div>
    }

    <div class="row g-3">
        <div class="col-md-6">
            <a asp-controller="Admin" asp-action="Metricas" class="text-decoration-none">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <h5 class="fw-bold mb-1" style="color: var(--pdz-ink);"><i class="bi bi-graph-up"></i> Métricas de uso</h5>
                        <p class="text-muted small mb-0">Cadastros, inscrições, pagamentos e o medidor do teto do MEI.</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-6">
            <a asp-controller="Admin" asp-action="Feedbacks" class="text-decoration-none">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <h5 class="fw-bold mb-1" style="color: var(--pdz-ink);"><i class="bi bi-chat-heart"></i> Opiniões dos jogadores</h5>
                        <p class="text-muted small mb-0">O que escreveram sobre o site, a nota de 0 a 10, e o que publicar.</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-6">
            <a asp-controller="Admin" asp-action="Erros" class="text-decoration-none">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <h5 class="fw-bold mb-1" style="color: var(--pdz-ink);"><i class="bi bi-bug"></i> Erros de produção</h5>
                        <p class="text-muted small mb-0">Todo 500 registrado na hora, com aviso por push e e-mail no primeiro de cada tipo.</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-6">
            <a asp-controller="Admin" asp-action="Denuncias" class="text-decoration-none">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <h5 class="fw-bold mb-1" style="color: var(--pdz-ink);"><i class="bi bi-flag"></i> Comentários denunciados</h5>
                        <p class="text-muted small mb-0">O que os jogadores sinalizaram nos perfis. Apagar ou manter, um a um.</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-6">
            <a asp-controller="Admin" asp-action="RegistroResultados" class="text-decoration-none">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <h5 class="fw-bold mb-1" style="color: var(--pdz-ink);"><i class="bi bi-person-raised-hand"></i> Registro de resultados</h5>
                        <p class="text-muted small mb-0">Organizadores pedindo nossa equipe pra lançar os jogos. Confirmar disponibilidade e valor.</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-6">
            <a asp-controller="Admin" asp-action="Clubes" class="text-decoration-none">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <h5 class="fw-bold mb-1" style="color: var(--pdz-ink);"><i class="bi bi-shop"></i> Clubes</h5>
                        <p class="text-muted small mb-0">Atribuir ou trocar o dono de cada clube.</p>
                    </div>
                </div>
            </a>
        </div>
        @if (ehRaiz)
        {
            <div class="col-md-6">
                <a asp-controller="Admin" asp-action="Administradores" class="text-decoration-none">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body">
                            <h5 class="fw-bold mb-1" style="color: var(--pdz-ink);"><i class="bi bi-person-badge"></i> Administradores</h5>
                            <p class="text-muted small mb-0">Nomear ou remover administradores do sistema.</p>
                        </div>
                    </div>
                </a>
            </div>
        }
        @if (ehRaiz)
        {
            @* Os dois cards de dinheiro do dono ficam juntos, e só o raiz os vê — dar baixa
               e fechar o caixa exigem o extrato do banco, que é dele. *@
            <div class="col-md-6">
                <a asp-controller="Admin" asp-action="PixDireto" class="text-decoration-none">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body">
                            <h5 class="fw-bold mb-1" style="color: var(--pdz-ink);"><i class="bi bi-qr-code"></i> Pix direto</h5>
                            <p class="text-muted small mb-0">Mensalidades e taxas na nossa conta, sem gateway — a chave e a fila de conferência do extrato.</p>
                        </div>
                    </div>
                </a>
            </div>
            <div class="col-md-6">
                <a asp-controller="Admin" asp-action="Financeiro" class="text-decoration-none">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body">
                            <h5 class="fw-bold mb-1" style="color: var(--pdz-ink);"><i class="bi bi-wallet2"></i> Financeiro do Padelizou</h5>
                            <p class="text-muted small mb-0">O caixa: por fora × pelo gateway × despesas — e o registro do que foi pago por fora.</p>
                        </div>
                    </div>
                </a>
            </div>
            <div class="col-md-6">
                <a asp-controller="Admin" asp-action="RankingRs" class="text-decoration-none">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body">
                            <h5 class="fw-bold mb-1" style="color: var(--pdz-ink);"><i class="bi bi-trophy"></i> Ranking RS</h5>
                            <p class="text-muted small mb-0">O que devemos a eles: R$ 1 por inscrito, torneio a torneio, com quem foi cobrado.</p>
                        </div>
                    </div>
                </a>
            </div>
        }
        <div class="col-md-6">
            <a asp-controller="Admin" asp-action="NotificacaoTeste" class="text-decoration-none">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <h5 class="fw-bold mb-1" style="color: var(--pdz-ink);"><i class="bi bi-send-check"></i> Teste de aviso (WhatsApp e push)</h5>
                        <p class="text-muted small mb-0">Manda pra <strong>uma pessoa só</strong>, pelo login dela, e diz por que não chegou quando não chega.</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h5 class="fw-bold mb-1" style="color: var(--pdz-ink);"><i class="bi bi-bell"></i> Notificação de teste (push)</h5>
                    @* Este manda pra TODO MUNDO com o app, e só push — nunca WhatsApp. Teste
                       chegando no celular de todo mundo é o jeito mais rápido de fazer a
                       pessoa desligar o canal. Pra testar de verdade, use o card ao lado. *@
                    <p class="text-muted small mb-3">Manda um push de teste pra todo mundo que instalou o app e ativou notificações.</p>
                    <form asp-controller="Admin" asp-action="EnviarNotificacaoTeste" method="post">
                        <button type="submit" class="btn btn-sm btn-outline-secondary rounded-pill px-3">Enviar pra todos</button>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h5 class="fw-bold mb-1" style="color: var(--pdz-ink);"><i class="bi bi-images"></i> Otimizar imagens</h5>
                    <p class="text-muted small mb-3">
                        Refaz fotos, logos e capas antigas no tamanho novo. Toda imagem enviada de agora
                        em diante já entra pronta — isto é só pro que ficou pra trás. Pode rodar de novo
                        à vontade: o que já está certo é pulado.
                    </p>
                    <form asp-controller="Admin" asp-action="OtimizarImagens" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-padel rounded-pill px-3">Otimizar agora</button>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h5 class="fw-bold mb-1" style="color: var(--pdz-ink);"><i class="bi bi-speedometer2"></i> Recalcular Padelímetro</h5>
                    <p class="text-muted small mb-3">
                        Zera e reconstrói o nível de todo mundo a partir das partidas finalizadas, em
                        ordem cronológica. É o botão de "mudou a regra" — determinístico, rodar de
                        novo dá no mesmo lugar.
                    </p>
                    <form asp-controller="Admin" asp-action="RecalcularPadelimetro" method="post"
                          onsubmit="return confirm('Recalcular o Padelímetro de todos os jogadores do zero?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-padel rounded-pill px-3">Recalcular agora</button>
                    </form>
                </div>
            </div>
        </div>
        @if (ehRaiz)
        {
            @* O PORTÃO. Fica por último e ocupa a largura inteira de propósito: é o único
               botão deste painel que muda quem consegue ENTRAR no site, e um card de meia
               largura no meio da grade não carrega esse peso. O estado atual vem escrito em
               letra grande porque a pergunta que se faz aqui é "está aberto ou fechado?",
               não "onde clico". *@
            <div class="col-12">
                <div class="card shadow-sm border-0 h-100 @(portaoLigado ? "" : "border-warning border-2")">
                    <div class="card-body">
                        <h5 class="fw-bold mb-1" style="color: var(--pdz-ink);">
                            <i class="bi @(portaoLigado ? "bi-lock-fill" : "bi-unlock-fill")"></i>
                            Portão de acesso antecipado
                        </h5>

                        @if (portaoLigado)
                        {
                            <p class="mb-1">
                                <span class="badge text-bg-secondary">FECHADO</span>
                                O site pede a senha compartilhada a quem <strong>não tem conta</strong>.
                            </p>
                            <p class="text-muted small mb-3">
                                Quem já tem conta entra pelo próprio login — o portão não tranca usuário de
                                verdade fora do próprio cadastro. Desligar abre o <strong>cadastro</strong>
                                pra qualquer pessoa: é o botão do lançamento.
                            </p>
                        }
                        else
                        {
                            <p class="mb-1">
                                <span class="badge text-bg-success">ABERTO</span>
                                Qualquer pessoa entra e se cadastra, sem senha nenhuma.
                            </p>
                            <p class="text-muted small mb-3">
                                É o estado de site público. Ligar de volta volta a pedir a senha
                                compartilhada a quem ainda não tem conta.
                            </p>
                        }

                        <form asp-controller="Admin" asp-action="AlternarPortao" method="post"
                              onsubmit="return confirm('@avisoDoPortao');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="habilitar" value="@((!portaoLigado).ToString().ToLowerInvariant())" />
                            <button type="submit" class="btn btn-sm rounded-pill px-3 @(portaoLigado ? "btn-padel" : "btn-outline-secondary")">
                                @(portaoLigado ? "Desligar o portão (abrir o site)" : "Ligar o portão de volta")
                            </button>
                        </form>

                        @if (!portaoDecididoAqui)
                        {
                            @* Enquanto ninguém mexeu por aqui, quem manda é a configuração do
                               servidor. Dizer isso evita a confusão de "eu não desliguei" numa
                               tela que também é lida por quem não fez o deploy. *@
                            <p class="text-muted small mb-0 mt-2">
                                <i class="bi bi-info-circle"></i>
                                Estado vindo da configuração do servidor — ninguém mexeu nisto pelo painel ainda.
                            </p>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>
