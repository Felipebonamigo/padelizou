@model List<Padelizou.Models.ErroDoSistema>
@{
    ViewData["Title"] = "Erros de produção - Admin";
    var nomes = ViewBag.NomesDosJogadores as Dictionary<int, string> ?? new();
    var ultimas24h = (int)ViewBag.Ultimas24h;
    var tipos = ViewBag.TiposDoRegistro as List<string> ?? new();
    var caminhos = ViewBag.CaminhosDoRegistro as List<string> ?? new();
    string? filtroTipo = ViewBag.FiltroTipo;
    string? filtroCaminho = ViewBag.FiltroCaminho;
    bool filtrando = filtroTipo != null || filtroCaminho != null;
    var totalDoRecorte = (int)ViewBag.TotalDoRecorte;
}

<div class="container mt-4 mb-5">
    <a asp-controller="Admin" asp-action="Index" class="small text-decoration-none">&larr; Painel Admin</a>

    <div class="mb-4 mt-2">
        <h2 class="fw-bold" style="color: var(--pdz-ink);">Erros de produção</h2>
        <p class="text-muted mb-0">
            Todo erro não tratado cai aqui na hora. O aviso por push e e-mail sai no primeiro
            de cada tipo; as repetições ficam só nesta lista, e o mesmo erro só reavisa
            depois de @((int)Padelizou.Services.VigiaDeErros.JanelaDeSilencio.TotalHours) horas.
        </p>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="display-6 fw-bold" style="color: var(--pdz-ink);">@ultimas24h</div>
                    <div class="small text-muted">nas últimas 24h</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="display-6 fw-bold" style="color: var(--pdz-ink);">@totalDoRecorte</div>
                    @* ⚠️ O total do RECORTE, não o tamanho da lista: com mais de 100 a tela
                       mostra 100, e um "100" fixo esconderia justamente que passou de 100. *@
                    <div class="small text-muted">
                        @(filtrando ? "com este filtro" : "no registro")
                        @if (totalDoRecorte > Model.Count)
                        {
                            <text>(mostrando @Model.Count)</text>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* ── O FILTRO ───────────────────────────────────────────────────────────────────────
       (Tipo, Caminho) é a MESMA identidade que o vigia usa pra decidir se reavisa — então
       filtrar pelos dois é perguntar pelo erro de que o push falou, e não por um parecido.

       As opções saem da tabela inteira (ver AdminController.Erros) e são um <select>, não um
       campo de texto: no celular, digitar "/Partidas/Votar" sem errar uma barra é o caminho
       mais curto pra concluir que "não tem nada" quando tem. *@
    <form asp-controller="Admin" asp-action="Erros" method="get" class="row g-2 align-items-end mb-4">
        <div class="col-12 col-md-4">
            <label class="form-label small text-muted mb-1" for="filtroTipo">Tipo do erro</label>
            <select class="form-select" id="filtroTipo" name="tipo" onchange="this.form.submit()">
                <option value="">Todos os tipos</option>
                @foreach (var t in tipos)
                {
                    <option value="@t" selected="@(filtroTipo == t)">@t</option>
                }
            </select>
        </div>
        <div class="col-12 col-md-5">
            <label class="form-label small text-muted mb-1" for="filtroCaminho">Caminho</label>
            <select class="form-select" id="filtroCaminho" name="caminho" onchange="this.form.submit()">
                <option value="">Todos os caminhos</option>
                @foreach (var c in caminhos)
                {
                    <option value="@c" selected="@(filtroCaminho == c)">@c</option>
                }
            </select>
        </div>
        @if (filtrando)
        {
            <div class="col-12 col-md-3">
                <a asp-controller="Admin" asp-action="Erros" class="btn btn-outline-secondary w-100">
                    <i class="bi bi-x-lg"></i> Limpar filtro
                </a>
            </div>
        }
    </form>

    <form asp-controller="Admin" asp-action="TestarVigiaDeErros" method="post" class="mb-4"
          data-confirmar="Isto estoura um erro DE VERDADE: você vai cair na tela de erro, e um aviso sai pros administradores. É o teste do alarme. Pode ir?">
        <button type="submit" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-clipboard-pulse"></i> Testar o vigia
        </button>
        <span class="small text-muted ms-2">Dispara um erro de mentira pra provar que o alarme está ligado.</span>
    </form>

    @if (Model.Count == 0)
    {
        @* ⚠️ "Nada aqui" com filtro ligado e "nada aqui" de verdade são notícias diferentes:
           a primeira é a resposta a uma pergunta, a segunda é o registro vazio. Uma frase só
           pras duas faria a tela parecer dizer que não há erro nenhum no sistema. *@
        @if (filtrando)
        {
            <div class="alert alert-success">
                <i class="bi bi-check-circle"></i>
                Nenhum erro <strong>@(filtroTipo ?? "de qualquer tipo")</strong>
                em <strong>@(filtroCaminho ?? "qualquer caminho")</strong> no registro
                (que guarda os últimos @((int)Padelizou.Services.VigiaDeErros.Retencao.TotalDays) dias).
            </div>
        }
        else
        {
            <div class="alert alert-success">
                <i class="bi bi-check-circle"></i> Nenhum erro registrado. É assim que a gente gosta.
            </div>
        }
    }
    else
    {
        <div class="d-flex flex-column gap-2">
            @foreach (var erro in Model)
            {
                <div class="card border-0 shadow-sm">
                    <div class="card-body py-2">
                        <div class="d-flex flex-wrap align-items-baseline gap-2">
                            <span class="badge text-bg-danger">@erro.Tipo</span>
                            <code class="small">@erro.Metodo @erro.Caminho</code>
                            <span class="small text-muted ms-auto text-nowrap">
                                @erro.QuandoEm.ToString("dd/MM HH:mm")
                                @if (erro.AvisoEnviado)
                                {
                                    <i class="bi bi-bell-fill" title="Este gerou aviso pros admins"></i>
                                }
                            </span>
                        </div>
                        <div class="small mt-1">@erro.Mensagem</div>
                        @if (erro.JogadorId is int jogadorId)
                        {
                            <div class="small text-muted">
                                Logado: @(nomes.TryGetValue(jogadorId, out var nome) ? nome : $"jogador #{jogadorId} (conta apagada)")
                            </div>
                        }
                        <details class="mt-1">
                            <summary class="small text-muted" style="cursor: pointer;">Detalhe completo</summary>
                            <pre class="small mt-2 mb-0 p-2 rounded" style="background: var(--pdz-superficie, #f6f7f9); white-space: pre-wrap; word-break: break-word;">@erro.Detalhe</pre>
                        </details>
                    </div>
                </div>
            }
        </div>
    }
</div>
