@model Padelizou.ViewModels.TesteDeNotificacaoVM
@using Padelizou.Services
@using Padelizou.ViewModels
@{
    ViewData["Title"] = "Teste de aviso - Painel Admin - Padelizou";
}

<div class="container mt-4 mb-5" style="max-width: 760px;">
    <a asp-controller="Admin" asp-action="Index" class="small text-decoration-none">&larr; Painel Admin</a>

    <div class="mb-4 mt-2">
        <h2 class="fw-bold" style="color: var(--pdz-ink);">Teste de aviso</h2>
        <p class="text-muted mb-0">
            Manda um aviso de mentira pra <strong>uma pessoa só</strong>. Primeiro você acha
            quem vai receber, confere, e só então manda.
        </p>
    </div>

    @if (Model.Erro != null)
    {
        <div class="alert alert-warning border-0 shadow-sm">
            <i class="bi bi-exclamation-triangle"></i> @Model.Erro
        </div>
    }

    @* ===== O AVISO DO ENVIO ==========================================================
       Vem antes de tudo e grita: "mandei" sem dizer se chegou é a informação que menos
       serve numa tela de teste. Verde só quando algum canal ENTREGOU de verdade. *@
    @if (Model.Resultado != null && Model.Alvo != null)
    {
        var r = Model.Resultado;
        var ok = Model.AlgumCanalDeuCerto;

        <div class="alert @(ok ? "alert-success" : "alert-warning") border-0 shadow-sm">
            <h5 class="fw-bold mb-1">
                <i class="bi @(ok ? "bi-check-circle-fill" : "bi-exclamation-octagon-fill")"></i>
                @(ok ? $"Enviado para {Model.Alvo.Nome}!" : "Não chegou em nenhum canal")
            </h5>
            <p class="mb-3 small">
                @(ok
                    ? "Confere o celular de quem recebeu — deve ter chegado agora."
                    : "Ninguém recebeu nada. O motivo de cada canal está abaixo.")
            </p>

            <div class="d-flex align-items-start gap-2 mb-2">
                <i class="bi @(TextoDoTeste.DeuCerto(r.Push) ? "bi-check-circle-fill text-success" : "bi-dash-circle text-muted") mt-1"></i>
                <div>
                    <strong>Notificação (app):</strong>
                    @TextoDoTeste.Frase(r.Push, r.Aparelhos)
                </div>
            </div>

            <div class="d-flex align-items-start gap-2">
                <i class="bi @(TextoDoTeste.DeuCerto(r.WhatsApp) ? "bi-check-circle-fill text-success" : "bi-dash-circle text-muted") mt-1"></i>
                <div>
                    <strong>WhatsApp:</strong>
                    @TextoDoTeste.Frase(r.WhatsApp, numero: r.Numero)
                </div>
            </div>
        </div>
    }

    @* ===== PASSO 1: achar ============================================================ *@
    <form method="post" class="card border-0 shadow-sm p-3 mb-4">
        @Html.AntiForgeryToken()

        <label class="form-label fw-bold" for="identificador">1. Quem vai receber</label>
        <div class="d-flex gap-2">
            <input type="text" class="form-control" id="identificador" name="identificador"
                   value="@Model.Identificador" placeholder="nome, apelido, login, e-mail ou CPF"
                   autocomplete="off" required />
            <button type="submit" class="btn btn-outline-secondary rounded-pill px-4 flex-shrink-0">
                <i class="bi bi-search"></i> Procurar
            </button>
        </div>
        <div class="form-text">
            Nome e apelido podem achar mais de uma pessoa — aí você escolhe. CPF só com os 11 dígitos.
        </div>
    </form>

    @* Mais de um resultado: escolher é obrigatório. Chutar mandaria pro homônimo errado, e o
       admin concluiria que testou o que não testou. *@
    @if (Model.Candidatos.Any())
    {
        <div class="card border-0 shadow-sm mb-4 p-3">
            <h6 class="fw-bold mb-1"><i class="bi bi-people"></i> Achei @Model.Candidatos.Count pessoas</h6>
            <p class="text-muted small mb-3">Escolha quem vai receber.</p>

            <div class="list-group">
                @foreach (var c in Model.Candidatos)
                {
                    <form method="post" class="list-group-item d-flex justify-content-between align-items-center gap-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="jogadorId" value="@c.Id" />
                        <input type="hidden" name="identificador" value="@Model.Identificador" />
                        <input type="hidden" name="mensagem" value="@Model.Mensagem" />

                        <div class="text-truncate">
                            <div class="fw-bold">@c.Nome</div>
                            <div class="text-muted small text-truncate">@LinhaDoCandidato.Detalhe(c)</div>
                        </div>
                        <button type="submit" class="btn btn-sm btn-outline-secondary rounded-pill px-3 flex-shrink-0">
                            Escolher
                        </button>
                    </form>
                }
            </div>
        </div>
    }

    @* ===== PASSO 2: conferir e mandar ================================================
       O botão de enviar só EXISTE depois que tem alguém escolhido na tela. *@
    @if (Model.Selecionado is { } alvo)
    {
        <form method="post" class="card border-0 shadow-sm p-3" style="border-left: 4px solid var(--padel-green) !important;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="acao" value="enviar" />
            <input type="hidden" name="jogadorId" value="@alvo.Id" />
            <input type="hidden" name="identificador" value="@Model.Identificador" />

            <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
                <div class="text-truncate">
                    <small class="text-muted text-uppercase fw-bold d-block" style="font-size: 0.7rem;">
                        2. Vai receber
                    </small>
                    <div class="fw-bold fs-5 text-truncate">@alvo.Nome</div>
                    <div class="text-muted small text-truncate">@LinhaDoCandidato.Detalhe(alvo)</div>
                    <div class="small text-truncate">
                        <i class="bi bi-whatsapp text-success"></i> @LinhaDoCandidato.Alcance(alvo)
                    </div>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold d-block">Por onde mandar</label>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="porPush" value="true"
                           id="porPush" @(Model.PorPush ? "checked" : "") />
                    <label class="form-check-label" for="porPush">
                        Notificação do app <span class="text-muted small">— só chega em quem instalou</span>
                    </label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="porWhatsApp" value="true"
                           id="porWhatsApp" @(Model.PorWhatsApp ? "checked" : "") />
                    <label class="form-check-label" for="porWhatsApp">
                        WhatsApp <span class="text-muted small">— chega em quem tem número e aceitou</span>
                    </label>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold" for="mensagem">Mensagem <span class="fw-normal text-muted">(opcional)</span></label>
                <input type="text" class="form-control" id="mensagem" name="mensagem"
                       value="@Model.Mensagem" maxlength="300" placeholder="deixe vazio pro texto padrão de teste" />
            </div>

            <button type="submit" class="btn btn-padel rounded-pill px-4 fw-bold">
                <i class="bi bi-send"></i> Enviar teste para @alvo.Nome
            </button>
        </form>
    }

    <p class="text-muted small mt-3 mb-0">
        <i class="bi bi-info-circle"></i>
        O WhatsApp fica desligado no ambiente de teste de propósito — lá, um teste viraria
        mensagem no celular de gente de verdade.
    </p>

    @* ===== VARREDURA DE FANTASMAS =====================================================
       Fica nesta tela porque é a mesma pergunta ("o aviso chega?"), vista do outro lado:
       ali é uma pessoa que a gente escolhe, aqui é a tabela inteira mentindo sobre o
       tamanho do canal. *@
    <hr class="my-4" />

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <h5 class="fw-bold mb-1"><i class="bi bi-eraser"></i> Varredura de fantasmas</h5>
            <p class="text-muted small">
                Um <strong>fantasma</strong> é um registro que o servidor de push continua
                aceitando e que não entrega nada — acontece quando o app sai da tela de início
                e o token demora a expirar. Um deles respondeu <strong>2xx por onze dias</strong>
                sem entregar nada. Enquanto isso durar, ele conta como alcance e não é.
            </p>

            @if (Model.Varredura is { } v)
            {
                <div class="alert @(v.Apagados > 0 ? "alert-success" : "alert-secondary") border-0 small">
                    <strong>@v.Suspeitos suspeito(s) sondado(s)</strong>, de @v.TotalDeRegistros registros no total.<br />
                    <i class="bi bi-trash"></i> <strong>@v.Apagados</strong> apagado(s) — o servidor de push confirmou que morreram.<br />
                    <i class="bi bi-question-circle"></i> <strong>@v.Inconclusivos</strong> ainda respondem 2xx: <em>não</em> quer dizer que estão vivos, quer dizer que o servidor de push ainda não admitiu.<br />
                    @if (v.ComErro > 0)
                    {
                        <text><i class="bi bi-exclamation-triangle"></i> <strong>@v.ComErro</strong> com erro de envio — nada foi apagado por causa deles.</text>
                    }
                </div>
            }

            <div class="alert alert-warning border-0 small">
                <i class="bi bi-exclamation-triangle"></i>
                <strong>Ela só sonda suspeito</strong> — quem tem outro registro mais novo no
                mesmo servidor de push. Varrer a tabela inteira faria cada aparelho vivo receber
                uma notificação do nada, e é desse clique de "desligar" que ninguém volta.
                Apagar só acontece com 410/404 na mão; suspeita sozinha nunca apaga.
            </div>

            <form asp-action="VarrerFantasmas" method="post">
                <button type="submit" class="btn btn-outline-danger rounded-pill px-4 fw-bold"
                        data-confirmar="Sondar os registros suspeitos? Quem o servidor de push confirmar que morreu vai ser apagado.">
                    <i class="bi bi-eraser"></i> Rodar varredura
                </button>
            </form>
        </div>
    </div>
</div>
