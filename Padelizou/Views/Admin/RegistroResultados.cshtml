@using Padelizou.Services
@model List<Padelizou.Models.SolicitacaoRegistroResultados>
@{
    ViewData["Title"] = "Registro de resultados - Admin";
    var solicitantes = ViewBag.Solicitantes as Dictionary<int, string> ?? new();
    var cfg = ViewBag.Config as RegistroResultadosSettings ?? new();
    var abertos = Model.Count(p => p.Status == Padelizou.Models.SolicitacaoRegistroResultados.Solicitada);
    @* Este host serve só /Admin e /Auth (AdminHostMiddleware): link relativo pro site
       público morre em 404 aqui mesmo, e o clique não abre nada. Fora do painel vem nulo, e
       aí o link sai relativo como sempre. *@
    var (hostDoSite, protocoloDoSite) = AdminHostMiddleware.SaidaPraSitePublico(ViewContext.HttpContext, Ambiente.IsDevelopment());
}

<div class="container mt-4 mb-5">
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill mb-3">
        <i class="bi bi-arrow-left"></i> Voltar ao painel
    </a>

    <h2 class="fw-bold mb-1" style="color: var(--pdz-ink);">Nós registramos os resultados</h2>
    <p class="text-muted">
        Pedidos de organizadores que querem a nossa equipe lançando os jogos.
        @if (abertos > 0)
        {
            <strong class="text-warning">@abertos esperando resposta.</strong>
        }
    </p>

    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success">@TempData["Sucesso"]</div>
    }
    @if (TempData["Erro"] != null)
    {
        <div class="alert alert-warning">@TempData["Erro"]</div>
    }

    @if (!Model.Any())
    {
        <div class="text-center py-5 rounded-3 bg-light" style="border: 2px dashed var(--pdz-border);">
            <i class="bi bi-inbox display-4 text-muted mb-3"></i>
            <h5 class="fw-bold text-secondary">Nenhum pedido ainda</h5>
            <p class="text-muted mb-0">
                O organizador pede na criação do torneio, ou depois, na página do torneio.
            </p>
        </div>
    }

    @{
        var jogosPraSairDoMinimo = RegistroDeResultados.JogosParaSairDoMinimo(cfg.PrecoPorJogo, cfg.ValorMinimo);
    }
    <div class="alert alert-light border small">
        Regra publicada: <strong>@cfg.PrecoPorJogo.ToString("C") por jogo</strong>,
        mínimo <strong>@cfg.ValorMinimo.ToString("C")</strong> — nosso custo é
        @cfg.CustoPorJogo.ToString("C") por jogo.
        <strong>Abaixo de @jogosPraSairDoMinimo jogos todo torneio paga o mínimo</strong>, então é
        ali que a margem é maior. Clube longe: ajuste o valor na mão.
    </div>

    @foreach (var p in Model)
    {
        var jogos = p.JogosPrevistos ?? 0;
        var custo = RegistroDeResultados.CustoEstimado(jogos, cfg.CustoPorJogo);
        var sugerido = RegistroDeResultados.PrecoSugerido(
            jogos, p.PrecoPorJogoCotado > 0 ? p.PrecoPorJogoCotado : cfg.PrecoPorJogo,
            p.ValorMinimoCotado > 0 ? p.ValorMinimoCotado : cfg.ValorMinimo);
        var aberto = p.Status == Padelizou.Models.SolicitacaoRegistroResultados.Solicitada;

        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
                    <div>
                        <h5 class="fw-bold mb-1" style="color: var(--pdz-ink);">
                            <a asp-controller="Torneios" asp-action="Details" asp-route-id="@p.TorneioId" asp-host="@hostDoSite" asp-protocol="@protocoloDoSite"
                               class="text-decoration-none" style="color: inherit;">@p.Torneio.Nome</a>
                        </h5>
                        <div class="small text-muted">
                            @(p.Torneio.DataInicio?.ToString("dd/MM/yyyy") ?? "sem data")
                            · @p.Torneio.LocalTorneio
                            · pedido por @(solicitantes.GetValueOrDefault(p.SolicitadoPorId) ?? "—")
                            em @p.SolicitadaEm.ToString("dd/MM HH:mm")
                        </div>
                    </div>
                    <span class="badge bg-@RegistroDeResultados.CorDoStatus(p.Status) fs-6">@p.Status</span>
                </div>

                <div class="row g-3 mb-2">
                    <div class="col-md-4">
                        <div class="border rounded p-2 h-100">
                            <div class="small text-muted text-uppercase fw-bold mb-1">Tamanho</div>
                            @if (p.JogosPrevistos != null)
                            {
                                <div><strong>@p.JogosPrevistos</strong> jogo(s)</div>
                            }
                            else
                            {
                                <div class="text-muted">sem inscrito ainda</div>
                            }
                            <div class="small text-muted">
                                @p.PessoasSugeridas pessoa(s) × @p.DiasNaSolicitacao dia(s),
                                @p.QuadrasNaSolicitacao quadra(s)
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="border rounded p-2 h-100 pdz-tinta-ambar">
                            <div class="small text-muted text-uppercase fw-bold mb-1">Nosso custo</div>
                            <div class="fs-5 fw-bold">@custo.ToString("C")</div>
                            <div class="small text-muted">
                                @cfg.CustoPorJogo.ToString("C") por jogo — é o piso, abaixo disso
                                a gente paga pra trabalhar
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="border rounded p-2 h-100 pdz-tinta-verde">
                            <div class="small text-muted text-uppercase fw-bold mb-1">Preço pela regra</div>
                            <div class="fs-5 fw-bold">@sugerido.ToString("C")</div>
                            <div class="small text-muted">
                                sobra @((sugerido - custo).ToString("C"))
                                @if (jogos > 0 && jogos < jogosPraSairDoMinimo)
                                {
                                    <text> · no mínimo</text>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(p.Observacoes))
                {
                    <div class="alert alert-light border small mb-2">
                        <strong>Recado do organizador:</strong> @p.Observacoes
                    </div>
                }

                @if (aberto)
                {
                    <form asp-action="ResponderRegistroResultados" method="post" class="border-top pt-3">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@p.Id" />

                        <div class="row g-2 align-items-end">
                            <div class="col-md-3">
                                <label class="form-label small fw-bold mb-1">Pessoas</label>
                                <input type="number" name="pessoas" class="form-control form-control-sm"
                                       value="@p.PessoasSugeridas" min="1" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small fw-bold mb-1">Valor ao organizador (R$)</label>
                                <input type="number" name="valor" class="form-control form-control-sm"
                                       step="0.01" min="0" value="@sugerido.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" />
                                <div class="form-text">Já vem pela regra. Ajuste se o clube for longe.</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold mb-1">Recado (vai pro organizador)</label>
                                <input type="text" name="resposta" class="form-control form-control-sm"
                                       placeholder="Quem vai, ou por que não dá" />
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-3 flex-wrap">
                            <button type="submit" name="temDisponibilidade" value="true" class="btn btn-sm btn-success fw-bold">
                                <i class="bi bi-check2"></i> Temos equipe — confirmar
                            </button>
                            <button type="submit" name="temDisponibilidade" value="false" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-x"></i> Sem disponibilidade
                            </button>
                        </div>
                    </form>
                }
                else
                {
                    <div class="border-top pt-2 small">
                        @if (p.ValorCombinado != null)
                        {
                            <div>
                                Combinado: <strong>@p.PessoasConfirmadas pessoa(s)</strong> por
                                <strong>@p.ValorCombinado.Value.ToString("C")</strong>
                                @{
                                    var margem = p.ValorCombinado.Value - custo;
                                }
                                <span class="@(margem >= 0 ? "text-success" : "text-danger")">
                                    (sobra @margem.ToString("C"))
                                </span>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(p.Resposta))
                        {
                            <div class="text-muted"><em>"@p.Resposta"</em></div>
                        }
                        @if (p.RespondidaEm != null)
                        {
                            <div class="text-muted">respondido em @p.RespondidaEm.Value.ToString("dd/MM/yyyy HH:mm")</div>
                        }

                        @if (p.Status == Padelizou.Models.SolicitacaoRegistroResultados.Confirmada)
                        {
                            <form asp-action="ConcluirRegistroResultados" method="post" class="mt-2">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@p.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-primary rounded-pill">
                                    Marcar como concluído
                                </button>
                            </form>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>
