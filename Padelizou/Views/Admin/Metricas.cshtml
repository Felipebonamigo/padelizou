@using Padelizou.Services
@model Padelizou.ViewModels.MetricasAdminVM
@{
    ViewData["Title"] = "Métricas de uso - Padelizou";

    var pct = Model.PercentualMei;
    var corMei = pct >= 90 ? "danger" : pct >= 70 ? "warning" : "success";
}

@* BACKUP FORA DO SERVIDOR — primeiro item da página, antes de qualquer métrica.
   O aviso por e-mail sai uma vez por semana e depende de um canal que pode estar fora do ar
   (em 07/08/2026 a cota do Gmail estourou). Aqui o estado não depende de entrega nenhuma:
   quem abre o painel vê. *@
@if (Model.VigiaDeBackupLigado)
{
    <div class="container mt-4">
        <div class="alert @(Model.BackupAtrasado ? "alert-danger" : "alert-success") d-flex gap-3 align-items-start shadow-sm mb-0">
            <i class="bi @(Model.BackupAtrasado ? "bi-shield-exclamation" : "bi-shield-check") fs-3"></i>
            <div>
                <strong>Backup fora do servidor:</strong> @Model.BackupComoTexto.
                @if (Model.UltimoBackupFora != null)
                {
                    <span class="text-muted">(@Model.UltimoBackupFora.Value.ToString("dd/MM/yyyy 'às' HH:mm"))</span>
                }
                @if (Model.BackupAtrasado)
                {
                    <div class="small mt-2">
                        O backup <strong>dentro</strong> do servidor provavelmente continua rodando — o que
                        parou é a cópia <strong>fora</strong> dele, que é justamente a que serve se o VPS morrer.
                        A causa mais comum é a autorização do Google ter expirado. O conserto é interativo
                        (pede login no navegador):
                        <code class="d-block mt-1">rclone config reconnect padelizou-drive:</code>
                    </div>
                }
            </div>
        </div>
    </div>
}

<div class="container mt-4 mb-5">
    @* As telas irmãs deste assunto. A lista mora em Services/PainelAdminAgrupado. *@
    <partial name="_AbasDoPainel" />

    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h2 class="fw-bold mb-0" style="color: var(--pdz-ink);">Métricas de uso</h2>
            <p class="text-muted mb-0">@FaixasDeMetricas.Subtitulo(Model.Agrupamento)</p>
        </div>
        <div class="d-flex gap-2">
            @* A mesma série, recortada por lugar. Fica aqui porque a pergunta nasce olhando
               esta tela: "os 12 cadastros da semana vieram de onde?". *@
            <a asp-controller="Admin" asp-action="Regioes" asp-route-agrupar="@Model.Agrupamento"
               class="btn btn-sm btn-outline-primary rounded-pill px-3">
                <i class="bi bi-geo-alt"></i> Por região
            </a>
            <a asp-controller="Admin" asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3">Voltar</a>
        </div>
    </div>

    @* ---- Medidor do MEI ---- *@
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="fw-bold mb-0"><i class="bi bi-speedometer2"></i> Faturamento do MEI em @DateTime.Now.Year</h6>
                <span class="badge bg-@corMei">@pct% do teto</span>
            </div>
            <div class="progress mb-2" style="height: 10px;">
                <div class="progress-bar bg-@corMei" role="progressbar" style="width: @Math.Min(pct, 100)%"></div>
            </div>
            <div class="small text-muted">
                Comissão da plataforma no ano: <strong>@Model.ComissaoAno.ToString("C")</strong>
                de um teto de <strong>@Model.TetoMei.ToString("C")</strong>.
                @if (pct >= 90)
                {
                    <span class="text-danger fw-bold">Atenção: acima de 90% — hora de planejar a migração de MEI pra ME.</span>
                }
                else if (pct >= 70)
                {
                    <span class="text-warning fw-bold">Acima de 70% — vale acompanhar de perto.</span>
                }
            </div>
        </div>
    </div>

    @* ---- Cards-resumo ---- *@
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card shadow-sm border-0 h-100 text-center">
                <div class="card-body py-3">
                    <div class="fs-3 fw-bold" style="color: var(--pdz-ink);">@Model.TotalJogadores</div>
                    <div class="small text-muted">jogadores no total</div>
                    <div class="small text-success">+@Model.JogadoresNovos7 em 7 dias · +@Model.JogadoresNovos30 em 30</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card shadow-sm border-0 h-100 text-center">
                <div class="card-body py-3">
                    <div class="fs-3 fw-bold" style="color: var(--pdz-ink);">@Model.InscricoesNovas30</div>
                    <div class="small text-muted">inscrições em 30 dias</div>
                    <div class="small text-success">+@Model.InscricoesNovas7 em 7 dias</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card shadow-sm border-0 h-100 text-center">
                <div class="card-body py-3">
                    <div class="fs-3 fw-bold" style="color: var(--pdz-ink);">@Model.ValorConfirmado30.ToString("C0")</div>
                    <div class="small text-muted">pagos em 30 dias</div>
                    <div class="small text-success">@Model.PagamentosConfirmados30 pagamento(s)</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card shadow-sm border-0 h-100 text-center">
                <div class="card-body py-3">
                    <div class="fs-3 fw-bold" style="color: var(--pdz-ink);">@Model.JogadoresComApp</div>
                    <div class="small text-muted">com o app instalado</div>
                    <div class="small text-muted">@Model.TorneiosAtivos torneio(s) ativo(s) de @Model.TorneiosTotal</div>
                </div>
            </div>
        </div>
    </div>

    @* ---- Série (dia / semana / mês) ---- *@
    <div class="card shadow-sm border-0">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                <h6 class="fw-bold mb-0">
                    <i class="bi bi-calendar-week"></i> @FaixasDeMetricas.Titulo(Model.Agrupamento)
                </h6>

                @* Três perguntas diferentes, e a semana só respondia uma. Dia é pra "o que
                   aconteceu depois que mandei o link no grupo?"; mês é pra "como está o ano?"
                   — a mesma conta do medidor do MEI logo acima. *@
                <div class="btn-group btn-group-sm" role="group" aria-label="Agrupar por">
                    @foreach (var (valor, rotulo) in new[]
                    {
                        (FaixasDeMetricas.Dia, "Dia"),
                        (FaixasDeMetricas.Semana, "Semana"),
                        (FaixasDeMetricas.Mes, "Mês"),
                    })
                    {
                        <a class="btn @(Model.Agrupamento == valor ? "btn-primary" : "btn-outline-primary")"
                           asp-controller="Admin" asp-action="Metricas" asp-route-agrupar="@valor"
                           aria-current="@(Model.Agrupamento == valor ? "page" : null)">@rotulo</a>
                    }
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-sm align-middle mb-1">
                    <thead>
                        @* No celular sai a contagem de pagamentos: o valor arrecadado já conta
                           a mesma história e é o que se olha. Com as cinco, a tabela pedia
                           359px numa tela de 294. *@
                        <tr class="text-muted small">
                            <th>Período</th>
                            <th class="text-end">Cadastros</th>
                            <th class="text-end d-none d-sm-table-cell">Inscrições</th>
                            <th class="text-end d-none d-sm-table-cell">Pagamentos</th>
                            <th class="text-end">Valor</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var f in Enumerable.Reverse(Model.Faixas))
                        {
                            <tr>
                                <td class="text-capitalize">@f.Rotulo</td>
                                <td class="text-end">@(f.Cadastros > 0 ? f.Cadastros.ToString() : "—")</td>
                                <td class="text-end d-none d-sm-table-cell">@(f.Inscricoes > 0 ? f.Inscricoes.ToString() : "—")</td>
                                <td class="text-end d-none d-sm-table-cell">@(f.Pagamentos > 0 ? f.Pagamentos.ToString() : "—")</td>
                                <td class="text-end">@(f.Valor > 0 ? f.Valor.ToString("C0") : "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="small text-muted">
                Cadastros e inscrições anteriores a 25/07/2026 não têm data registrada — entram nos totais, mas não na série.
            </div>
        </div>
    </div>
</div>
