@model Padelizou.Models.Torneio
@using Padelizou.Services
@{
    ViewData["Title"] = $"{MarcaDoRanking.Nome} — {Model.Nome} - Padelizou";

    var cobradas = (List<AcertoComORankingRs.PessoaCobrada>)ViewBag.Cobradas;
    decimal custo = ViewBag.CustoPorInscrito;
    decimal valor = ViewBag.Valor;
    var acerto = ViewBag.Acerto as Padelizou.Models.AcertoRankingRs;

    // Quem entrou em mais de uma categoria é o caso que a regra existe pra tratar — vale
    // destacar, porque é onde a conferência com eles costuma divergir.
    int emMaisDeUma = cobradas.Count(p => p.Categorias.Count > 1);
    int inscricoes = cobradas.Sum(p => p.Categorias.Count);
    @* Este host serve só /Admin e /Auth (AdminHostMiddleware): link relativo pro site
       público morre em 404 aqui mesmo, e o clique não abre nada. Fora do painel vem nulo, e
       aí o link sai relativo como sempre. *@
    var (hostDoSite, protocoloDoSite) = AdminHostMiddleware.SaidaPraSitePublico(ViewContext.HttpContext, Ambiente.IsDevelopment());
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-0" style="color: var(--pdz-ink);">@Model.Nome</h2>
            <p class="text-muted mb-0">
                Quem conta pro @MarcaDoRanking.Nome · @Model.Codigo@(Model.DataInicio != null ? $" · {Model.DataInicio.Value:dd/MM/yyyy}" : "")
            </p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="RankingRsRelatorio" class="btn btn-outline-secondary rounded-pill">
                <i class="bi bi-shield-check"></i> Relatório
            </a>
            <a asp-action="RankingRs" class="btn btn-outline-secondary rounded-pill">
                <i class="bi bi-arrow-left"></i> Voltar
            </a>
        </div>
    </div>

    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success">@TempData["Sucesso"]</div>
    }
    @if (TempData["Erro"] != null)
    {
        <div class="alert alert-danger">@TempData["Erro"]</div>
    }

    @* ── CONFERIR AGORA NO RANKING ────────────────────────────────────────────────────
       Fica AQUI e não no relatório de propósito: aquela tela é a que o parceiro abre, e a
       trava dele é o verbo HTTP — ela não tem um formulário sequer, e tem teste guardando
       isso. Aqui é a nossa página, só do raiz. *@
    @if (Model.ValidarPeloRankingRs && cobradas.Count > 0)
    {
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div>
                    <h6 class="fw-bold mb-1" style="color: var(--pdz-ink);">
                        <i class="bi bi-arrow-repeat"></i> Conferir estas pessoas no @MarcaDoRanking.Nome agora
                    </h6>
                    <p class="text-muted small mb-0">
                        Pergunta de novo, pessoa por pessoa, e guarda a resposta — é o que preenche
                        quem se inscreveu antes de existir registro de consulta. Serve pra saber se
                        alguém passou <em>conferido</em> ou se apenas <strong>não está no ranking</strong>.
                        <br />
                        <strong>Ninguém é desinscrito por isso.</strong> Se aparecer alguém com pontos
                        em categoria mais forte, a decisão continua sendo do organizador.
                    </p>
                </div>
                <form asp-action="ReconferirNoRanking" method="post"
                      onsubmit="return confirm('Consultar o @MarcaDoRanking.Nome sobre as @cobradas.Count pessoas inscritas? Ninguém sai do torneio — só grava a resposta.');">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-primary rounded-pill">
                        Conferir @cobradas.Count pessoa@(cobradas.Count == 1 ? "" : "s")
                    </button>
                </form>
            </div>
        </div>
    }

    @if (acerto != null)
    {
        <div class="alert alert-success d-flex align-items-center gap-2">
            <i class="bi bi-check-circle-fill fs-4"></i>
            <div>
                <strong>Já acertado em @acerto.AcertadoEm.ToString("dd/MM/yyyy")</strong> —
                @acerto.PessoasCobradas pessoa@(acerto.PessoasCobradas == 1 ? "" : "s"),
                @acerto.Valor.ToString("C").
                @if (acerto.PessoasCobradas != cobradas.Count)
                {
                    @* O número de hoje mudou depois do acerto (gente desistiu, ou entrou
                       alguém atrasado). Dizer isso evita a leitura de que um dos dois é erro. *@
                    <br />
                    <span class="small">
                        Hoje a lista tem @cobradas.Count — o acerto guarda o número do dia em que foi fechado.
                    </span>
                }
            </div>
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small"><i class="bi bi-people"></i> Pessoas</div>
                    <div class="fs-3 fw-bold" style="color: var(--pdz-ink);">@cobradas.Count</div>
                    <div class="small text-muted">é isto que se paga</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small"><i class="bi bi-list-ol"></i> Inscrições</div>
                    <div class="fs-3 fw-bold text-muted">@inscricoes</div>
                    <div class="small text-muted">somando as categorias</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small"><i class="bi bi-arrow-left-right"></i> Em 2+ categorias</div>
                    <div class="fs-3 fw-bold text-muted">@emMaisDeUma</div>
                    <div class="small text-muted">
                        @if (emMaisDeUma > 0)
                        {
                            <text>economia de @(((inscricoes - cobradas.Count) * custo).ToString("C"))</text>
                        }
                        else
                        {
                            <text>ninguém repetiu</text>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small"><i class="bi bi-cash"></i> Total</div>
                    <div class="fs-3 fw-bold" style="color: var(--padel-green);">@valor.ToString("C")</div>
                    <div class="small text-muted">@cobradas.Count × @custo.ToString("C")</div>
                </div>
            </div>
        </div>
    </div>

    @if (!cobradas.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center text-muted py-5">
                <i class="bi bi-person-x fs-1 d-block mb-2"></i>
                Ninguém inscrito neste torneio — nada a pagar.
            </div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr class="text-muted small">
                        <th style="width: 3rem;">#</th>
                        <th>Jogador</th>
                        <th>Categorias que jogou</th>
                        <th class="text-end">Custo</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int n = 0; }
                    @foreach (var p in cobradas)
                    {
                        n++;
                        <tr>
                            <td class="text-muted small">@n</td>
                            <td>
                                <a asp-controller="Jogadores" asp-action="Perfil" asp-route-id="@p.JogadorId" asp-host="@hostDoSite" asp-protocol="@protocoloDoSite"
                                   class="fw-semibold text-decoration-none" style="color: var(--pdz-ink);">
                                    @p.Nome
                                </a>
                            </td>
                            <td>
                                @foreach (var categoria in p.Categorias)
                                {
                                    <span class="badge text-bg-light border me-1">@categoria</span>
                                }
                                @if (p.Categorias.Count > 1)
                                {
                                    <span class="badge text-bg-success">@p.Categorias.Count categorias, 1 cobrança</span>
                                }
                            </td>
                            <td class="text-end fw-semibold">@custo.ToString("C")</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="fw-bold">
                        <td colspan="3" class="text-end">Total</td>
                        <td class="text-end" style="color: var(--padel-green);">@valor.ToString("C")</td>
                    </tr>
                </tfoot>
            </table>
        </div>

        @if (acerto == null)
        {
            <form asp-action="RegistrarAcertoRankingRs" method="post" class="mt-3"
                  onsubmit="return confirm('Registrar que você já pagou @valor.ToString("C") ao @MarcaDoRanking.Nome por este torneio? Isso lança a despesa no caixa.');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn btn-padel rounded-pill px-4 fw-bold">
                    <i class="bi bi-check2"></i> Já paguei @valor.ToString("C")
                </button>
            </form>
        }
    }
</div>
