@model List<Jogador>
@{
    ViewData["Title"] = "Administradores - Painel Admin - Padelizou";
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold" style="color: var(--pdz-ink);">Administradores do Sistema</h2>
            <p class="text-muted mb-0">Quem está aqui pode gerenciar donos de clube (e o que mais vier a ser adicionado no painel admin).</p>
        </div>
        <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary rounded-pill">Voltar</a>
    </div>

    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success">@TempData["Sucesso"]</div>
    }

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <h6 class="fw-bold text-muted mb-3">Adicionar administrador</h6>
            @{
                ViewData["BuscaOrgActionUrl"] = Url.Action("AdicionarAdministrador", "Admin");
            }
            <partial name="_BuscaOrganizador" />
            @{
                ViewData["BuscaOrgActionUrl"] = null;
            }
        </div>
    </div>

    <div class="list-group shadow-sm">
        @if (Model.Any())
        {
            @foreach (var admin in Model)
            {
                <div class="list-group-item d-flex justify-content-between align-items-center">
                    <span class="fw-bold">@admin.Nome</span>
                    <form asp-controller="Admin" asp-action="RemoverAdministrador" method="post"
                          onsubmit="return confirm('Remover @admin.Nome como administrador?');">
                        <input type="hidden" name="jogadorId" value="@admin.Id" />
                        <button type="submit" class="btn btn-sm btn-outline-danger">Remover</button>
                    </form>
                </div>
            }
        }
        else
        {
            <div class="list-group-item text-muted">Nenhum administrador nomeado ainda.</div>
        }
    </div>

    @* ── ASSISTENTES DO SISTEMA ──────────────────────────────────────────────────────
       Bloco separado, e não uma coluna na tabela de cima, porque não é "um administrador
       mais fraco": o assistente NÃO edita nada. Misturar os dois faria alguém conceder um
       achando que concede o outro. *@
    @{
        var assistentes = ViewBag.Assistentes as List<Jogador> ?? new List<Jogador>();
    }
    <div class="mt-5">
        <h4 class="fw-bold" style="color: var(--pdz-ink);">Assistentes do sistema</h4>
        <p class="text-muted">
            Enxergam <strong>tudo</strong> — o painel inteiro e a gestão de qualquer torneio —
            e <strong>não alteram nada</strong>. Nos torneios que a própria pessoa organiza,
            os botões dela continuam funcionando normalmente.
        </p>
        <p class="text-muted small">
            <i class="bi bi-info-circle"></i>
            O crachá é reescrito no login: quem já está logado só passa a ver o painel depois
            de sair e entrar de novo.
        </p>

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body">
                <h6 class="fw-bold text-muted mb-3">Adicionar assistente</h6>
                @{
                    ViewData["BuscaOrgActionUrl"] = Url.Action("AdicionarAssistente", "Admin");
                }
                <partial name="_BuscaOrganizador" />
                @{
                    ViewData["BuscaOrgActionUrl"] = null;
                }
            </div>
        </div>

        <div class="list-group shadow-sm">
            @if (assistentes.Any())
            {
                @foreach (var assistente in assistentes)
                {
                    <div class="list-group-item d-flex justify-content-between align-items-center">
                        <span class="fw-bold">@assistente.NomeComApelido</span>
                        <form asp-controller="Admin" asp-action="RemoverAssistente" method="post"
                              onsubmit="return confirm('Remover @assistente.Nome como assistente do sistema?');">
                            <input type="hidden" name="jogadorId" value="@assistente.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Remover</button>
                        </form>
                    </div>
                }
            }
            else
            {
                <div class="list-group-item text-muted">Nenhum assistente ainda.</div>
            }
        </div>
    </div>

    @* ── PARCEIROS DO RANKING ─────────────────────────────────────────────────────────
       Terceiro bloco, e o único que dá acesso a alguém de FORA da empresa. Separado dos
       outros dois de propósito: as duas listas acima são pessoas de dentro olhando o
       sistema inteiro, esta é uma empresa parceira olhando uma prateleira. *@
    @{
        var parceiros = ViewBag.ParceirosDoRanking as List<Jogador> ?? new List<Jogador>();
    }
    <div class="mt-5">
        <h4 class="fw-bold" style="color: var(--pdz-ink);">
            Parceiros do @Padelizou.Services.MarcaDoRanking.Nome
        </h4>
        <p class="text-muted">
            Enxergam <strong>uma única tela</strong> — o relatório da nossa parceria com eles —
            e mais nada do painel. Não editam nada, não veem o financeiro, não veem torneio que
            não aderiu à validação.
        </p>
        <div class="alert alert-warning small">
            <i class="bi bi-person-badge"></i>
            <strong>Este é o único acesso do sistema dado a gente de fora da empresa.</strong>
            A pessoa precisa ter conta no Padelizou, e entra com o login dela.
        </div>
        <p class="text-muted small">
            <i class="bi bi-info-circle"></i>
            O crachá é reescrito no login: quem já está logado só passa a ver o relatório depois
            de sair e entrar de novo.
        </p>

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body">
                <h6 class="fw-bold text-muted mb-3">Liberar o relatório para alguém</h6>
                @{
                    ViewData["BuscaOrgActionUrl"] = Url.Action("AdicionarParceiroDoRanking", "Admin");
                }
                <partial name="_BuscaOrganizador" />
                @{
                    ViewData["BuscaOrgActionUrl"] = null;
                }
            </div>
        </div>

        <div class="list-group shadow-sm">
            @if (parceiros.Any())
            {
                @foreach (var parceiro in parceiros)
                {
                    <div class="list-group-item d-flex justify-content-between align-items-center">
                        <span class="fw-bold">@parceiro.NomeComApelido</span>
                        <form asp-controller="Admin" asp-action="RemoverParceiroDoRanking" method="post"
                              onsubmit="return confirm('Tirar o acesso de @parceiro.Nome ao relatório?');">
                            <input type="hidden" name="jogadorId" value="@parceiro.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Remover</button>
                        </form>
                    </div>
                }
            }
            else
            {
                <div class="list-group-item text-muted">Ninguém de fora tem acesso.</div>
            }
        </div>
    </div>
</div>
