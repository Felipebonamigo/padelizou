@model Padelizou.ViewModels.TimeDetalheVM
@{
    ViewData["Title"] = Model.Time.Nome;
}

<div class="container mt-4">
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill mb-3">
        <i class="bi bi-arrow-left"></i> Todos os times
    </a>

    <!-- Cabeçalho do time -->
    <div class="card border-0 shadow-sm mb-4 p-4" style="background-color: var(--pdz-navy-fixed); color: white;">
        <div class="d-flex align-items-center gap-3 flex-wrap">
            @if (!string.IsNullOrWhiteSpace(Model.Time.Logo))
            {
                <img src="@Model.Time.Logo" alt="" class="rounded flex-shrink-0"
                     style="width: 84px; height: 84px; object-fit: cover;" />
            }
            else
            {
                <div class="rounded d-flex align-items-center justify-content-center flex-shrink-0"
                     style="width: 84px; height: 84px; background: rgba(255,255,255,.10);">
                    <i class="bi bi-shield-fill display-6" style="color: var(--padel-green);"></i>
                </div>
            }
            <div class="flex-grow-1">
                <h2 class="fw-bold mb-1">@Model.Time.Nome</h2>
                <p class="mb-0 text-light opacity-75">
                    <i class="bi bi-people-fill"></i> @Model.Membros.Count @(Model.Membros.Count == 1 ? "jogador" : "jogadores")
                    @if (Model.TotalPontos > 0)
                    {
                        <span class="ms-2"><i class="bi bi-star-fill"></i> @Model.TotalPontos pts somados</span>
                    }
                </p>
                @if (Model.Time.Clube != null)
                {
                    <p class="mb-0 text-light opacity-75 small"><i class="bi bi-geo-alt"></i> @Model.Time.Clube.Nome</p>
                }
            </div>
        </div>
    </div>

    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill"></i> @TempData["Sucesso"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Erro"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i> @TempData["Erro"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Administradores -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <h5 class="fw-bold mb-1" style="color: var(--pdz-ink);">
                <i class="bi bi-shield-check"></i> Quem administra
            </h5>
            <p class="small text-muted mb-3">
                Um time pode ter mais de um administrador, e todos têm o mesmo poder.
                Quem administra pode incluir outro.
            </p>

            @if (!Model.Administradores.Any())
            {
                <p class="small text-muted mb-0">
                    <i class="bi bi-info-circle"></i>
                    Este time ainda não tem administrador.
                    @if (Model.SouAdminDoSistema)
                    {
                        <text>Escolha abaixo quem vai comandar.</text>
                    }
                    else
                    {
                        <text>Só um administrador do Padelizou pode designar o primeiro.</text>
                    }
                </p>
            }
            else
            {
                <ul class="list-group list-group-flush mb-0">
                    @foreach (var a in Model.Administradores)
                    {
                        <li class="list-group-item bg-transparent px-0 d-flex align-items-center gap-2 flex-wrap">
                            <a asp-controller="Jogadores" asp-action="Perfil" asp-route-id="@a.Jogador.Id"
                               class="fw-semibold text-decoration-none" style="color: var(--pdz-ink);">
                                @a.Jogador.ComoChamar
                            </a>
                            @if (!string.IsNullOrWhiteSpace(a.ConcedidoPor))
                            {
                                <small class="text-muted">incluído por @a.ConcedidoPor</small>
                            }
                            @if (Model.PossoGerenciar)
                            {
                                <form asp-action="RemoverAdministrador" method="post" class="ms-auto"
                                      onsubmit="return confirm('Tirar @a.Jogador.ComoChamar da administração do time? Ele continua no time.');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="timeId" value="@Model.Time.Id" />
                                    <input type="hidden" name="jogadorId" value="@a.Jogador.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill">
                                        <i class="bi bi-x-lg"></i> remover
                                    </button>
                                </form>
                            }
                        </li>
                    }
                </ul>
            }

            @if (Model.PossoGerenciar)
            {
                <form asp-action="IncluirAdministrador" method="post" class="mt-3 d-flex gap-2 flex-wrap align-items-end">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="timeId" value="@Model.Time.Id" />
                    <div class="flex-grow-1" style="min-width: 220px;">
                        <label class="form-label small fw-semibold mb-1">Incluir administrador</label>
                        <select name="jogadorId" class="form-select" required>
                            <option value="">Escolha o jogador...</option>
                            @foreach (var j in Model.CandidatosAAdministrador)
                            {
                                <option value="@j.Id">@j.Nome</option>
                            }
                        </select>
                    </div>
                    <button type="submit" class="btn btn-success rounded-pill">
                        <i class="bi bi-plus-lg"></i> Incluir
                    </button>
                </form>
                <p class="small text-muted mt-2 mb-0">
                    Quem passa a administrar entra automaticamente no time.
                </p>
            }
        </div>
    </div>

    <!-- Membros -->
    <h5 class="fw-bold mb-3" style="color: var(--pdz-ink);">Quem veste a camisa</h5>

    @if (!Model.Membros.Any())
    {
        @* Os 44 times entraram pelo ranking do "Quanto Tá", então quase todos começam sem
           ninguém — este é o estado que mais gente vai ver no site esta semana. *@
        <partial name="_Vazio" model='@(new EstadoVazio("Nenhum jogador escolheu este time ainda. Quem veste essa camisa pode marcar o time no próprio perfil.", "Ver jogadores", "Jogadores", "Buscar"))' />
    }
    else
    {
        <div class="list-group shadow-sm">
            @foreach (var m in Model.Membros)
            {
                <a asp-controller="Jogadores" asp-action="Perfil" asp-route-id="@m.Jogador.Id"
                   class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-3">
                    @if (!string.IsNullOrWhiteSpace(m.Jogador.FotoPerfil))
                    {
                        <img src="@m.Jogador.FotoPerfil" alt="" class="rounded-circle flex-shrink-0"
                             style="width: 44px; height: 44px; object-fit: cover;" />
                    }
                    else
                    {
                        <i class="bi bi-person-circle fs-2 flex-shrink-0" style="color: var(--pdz-ink); opacity:.5;"></i>
                    }
                    <div class="flex-grow-1 overflow-hidden">
                        <strong class="d-block text-truncate" style="color: var(--pdz-ink);">
                            @m.Jogador.ComoChamar
                            @if (m.EhAdministrador)
                            {
                                <span class="badge rounded-pill ms-1" style="background:#fff6df;color:#8a6d00;">
                                    <i class="bi bi-shield-fill"></i> administra
                                </span>
                            }
                        </strong>
                        <small class="text-muted">
                            @if (!string.IsNullOrWhiteSpace(m.Jogador.Cidade))
                            {
                                <span><i class="bi bi-geo-alt"></i> @m.Jogador.Cidade@(m.Jogador.Estado != null ? $" - {m.Jogador.Estado}" : "")</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(m.Jogador.LadoQuadra))
                            {
                                <span class="ms-2"><i class="bi bi-arrow-left-right"></i> @m.Jogador.LadoQuadra</span>
                            }
                        </small>
                    </div>
                    <span class="badge rounded-pill bg-light text-dark flex-shrink-0">@m.Pontos pts</span>
                </a>
            }
        </div>
    }
</div>
