@model List<Padelizou.ViewModels.TimeResumoVM>
@{
    ViewData["Title"] = "Buscar times";
    var q = ViewBag.Query as string;
}

<div class="container mt-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div>
            <h2 class="fw-bold mb-0" style="color: var(--pdz-ink);"><i class="bi bi-search"></i> Buscar</h2>
            <p class="text-muted small mb-0">As bandeiras da comunidade e quem veste cada uma.</p>
        </div>
        <a asp-controller="Auth" asp-action="EditarPerfil" class="btn btn-outline-primary rounded-pill px-3">
            <i class="bi bi-flag me-1"></i> Meu time
        </a>
    </div>

    @* "Buscar jogadores" era um botão aqui do lado; virou aba, junto com esta tela. *@
    <partial name="_AbasBusca" />

    @* Busca no servidor: a lista de times tende a crescer bastante menos que a de jogadores. *@
    <form method="get" class="mb-4">
        <div class="input-group">
            <span class="input-group-text bg-white border-end-0"><i class="bi bi-search"></i></span>
            <input type="text" name="q" value="@q" class="form-control border-start-0"
                   placeholder="Buscar time pelo nome..." />
            @if (!string.IsNullOrWhiteSpace(q))
            {
                <a asp-action="Index" class="btn btn-outline-secondary">Limpar</a>
            }
            <button type="submit" class="btn btn-padel px-4">Buscar</button>
        </div>
    </form>

    @if (!Model.Any())
    {
        <div class="text-center text-muted py-5">
            <i class="bi bi-shield fs-1 d-block mb-2 opacity-50"></i>
            <p class="mb-1">@(string.IsNullOrWhiteSpace(q) ? "Nenhum time cadastrado ainda." : $"Nenhum time encontrado para \"{q}\".")</p>
            @if (string.IsNullOrWhiteSpace(q))
            {
                <p class="small mb-0">Crie o seu em <a asp-controller="Auth" asp-action="EditarPerfil">Editar Perfil</a>.</p>
            }
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-3">
            @foreach (var t in Model)
            {
                <div class="col">
                    <a asp-action="Detalhes" asp-route-id="@t.Id" class="text-decoration-none">
                        <div class="card border-0 shadow-sm h-100 p-3 pdz-porta d-flex flex-row align-items-center gap-3">
                            @if (!string.IsNullOrWhiteSpace(t.Logo))
                            {
                                <img src="@t.Logo" alt="" class="rounded flex-shrink-0"
                                     style="width: 56px; height: 56px; object-fit: cover;" />
                            }
                            else
                            {
                                <div class="rounded d-flex align-items-center justify-content-center flex-shrink-0"
                                     style="width: 56px; height: 56px; background: var(--pdz-navy-fixed);">
                                    <i class="bi bi-shield-fill fs-4" style="color: var(--padel-green);"></i>
                                </div>
                            }
                            <div class="flex-grow-1 overflow-hidden">
                                <strong class="d-block text-truncate" style="color: var(--pdz-ink);">@t.Nome</strong>
                                <small class="text-muted d-block">
                                    <i class="bi bi-people-fill"></i> @t.Membros @(t.Membros == 1 ? "jogador" : "jogadores")
                                    @if (t.Pontos > 0)
                                    {
                                        <span>· @t.Pontos pts</span>
                                    }
                                </small>
                                @if (!string.IsNullOrWhiteSpace(t.Clube))
                                {
                                    <small class="text-muted d-block text-truncate"><i class="bi bi-geo-alt"></i> @t.Clube</small>
                                }
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    }
</div>

<style>
    .pdz-porta { transition: transform .15s ease, box-shadow .15s ease; }
    .pdz-porta:hover { transform: translateY(-3px); box-shadow: 0 .5rem 1rem rgba(0, 0, 0, .12) !important; }
</style>
