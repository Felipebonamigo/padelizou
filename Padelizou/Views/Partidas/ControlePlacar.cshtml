@model Padelizou.Models.Partida
@{
    ViewData["Title"] = "Controle de Partida";
    var quadras = ViewBag.Quadras as List<Padelizou.Models.Quadra> ?? new List<Padelizou.Models.Quadra>();

    // Até quantos games vai ESTE jogo — quem manda é a fase dele (grupos, mata-mata,
    // semifinal/final), como o organizador configurou. Ver Services/FormatoDaPartida.
    var formato = ViewBag.Formato as Padelizou.Services.FormatoDaPartida.Formato
                  ?? new Padelizou.Services.FormatoDaPartida.Formato(
                         Padelizou.Services.FormatoDaPartida.SetsPadrao,
                         Padelizou.Services.FormatoDaPartida.GamesPadrao);

    // O link da CÂMERA de cada quadra (ver Services/TransmissaoDaQuadra). A câmera fica
    // pendurada na quadra e transmite o dia todo, então escolher a quadra já traz o link:
    // sem isto, todo jogo criado depois do "usar este link em todos os próximos jogos desta
    // quadra" chegava aqui sem transmissão, e o organizador colava o link de novo, um a um.
    var linksDasQuadras = ViewBag.LinksDasQuadras as Dictionary<string, string>
                          ?? new Dictionary<string, string>();
    var linkDaQuadraAtual = Model.NomeQuadra != null
        ? linksDasQuadras.GetValueOrDefault(Model.NomeQuadra)
        : null;

    // O que estiver gravado no jogo manda — o herdado da quadra só preenche o vazio.
    var linkNaTela = string.IsNullOrWhiteSpace(Model.LinkTransmissao)
        ? linkDaQuadraAtual
        : Model.LinkTransmissao;
    var linkVeioDaQuadra = string.IsNullOrWhiteSpace(Model.LinkTransmissao)
                           && !string.IsNullOrWhiteSpace(linkDaQuadraAtual);
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">⚙️ Controle da Partida</h5>
                    <span class="badge bg-secondary">@Model.Categoria.Nome - @Model.Fase</span>
                </div>

                <div class="card-body">
                    <form asp-action="ControlePlacar" method="post">
                        <input type="hidden" name="id" value="@Model.Id" />
                        @* Volta pra tela de onde a pessoa veio. Sem isto, salvar aqui sempre
                           despejava o organizador em /Torneios/Jogos — e quem estava na
                           página do torneio via as abas mãe sumirem. *@
                        <input type="hidden" name="voltarPara" value="@(Context.Request.Query["voltarPara"])" />

                        <!-- Linha 1: Status e Quadra -->
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Status do Jogo</label>
                                <select name="status" class="form-select border-primary">
                                    <option value="Agendada" selected="@(Model.Status == "Agendada")">📅 Agendada</option>
                                    <option value="AoVivo" selected="@(Model.Status == "AoVivo")">🔴 Ao Vivo (Inicia Cronômetro)</option>
                                    <option value="Finalizada" selected="@(Model.Status == "Finalizada")">✅ Finalizada (Para Cronômetro)</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Quadra</label>
                                @if (quadras.Count > 0)
                                {
                                    @* `data-link`: o link da câmera daquela quadra viaja na
                                       própria opção, e trocar de quadra troca o link junto
                                       (o script no fim do arquivo). *@
                                    <select name="nomeQuadra" class="form-select" id="pdzQuadra">
                                        <option value="" data-link="">-- Escolha a quadra --</option>
                                        @foreach (var quadra in quadras)
                                        {
                                            <option value="@quadra.Nome" data-link="@(linksDasQuadras.GetValueOrDefault(quadra.Nome) ?? "")"
                                                    selected="@(quadra.Nome == Model.NomeQuadra)">@quadra.Nome</option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    <input type="text" name="nomeQuadra" value="@Model.NomeQuadra" class="form-control" placeholder="Ex: Quadra Central" />
                                    <small class="text-muted">Esse torneio não tem quadras cadastradas — texto livre por enquanto.</small>
                                }
                            </div>
                        </div>

                        <hr class="text-muted" />

                        <!-- Linha 2: O Placar (Bem grande para facilitar o toque no celular) -->
                        <div class="row text-center mb-4 align-items-center">
                            <div class="col-5">
                                @if (Model.Dupla1.EhTime)
                                {
                                    <h6 class="text-truncate"><i class="bi bi-people-fill"></i> @Model.Dupla1.NomeTime</h6>
                                }
                                else
                                {
                                    <h6 class="text-truncate"><a asp-controller="Jogadores" asp-action="Perfil" asp-route-id="@Model.Dupla1.Jogador1Id" class="text-decoration-none">@Model.Dupla1.Jogador1.ComoChamar</a></h6>
                                    <h6 class="text-truncate"><a asp-controller="Jogadores" asp-action="Perfil" asp-route-id="@Model.Dupla1.Jogador2Id" class="text-decoration-none">@(Model.Dupla1.Jogador2?.ComoChamar ?? "A definir")</a></h6>
                                }
                                <input type="number" name="gamesDupla1" value="@Model.GamesDupla1" class="form-control form-control-lg text-center fs-2 mt-2 js-games" placeholder="0" min="0" max="@formato.Games" />
                            </div>

                            <div class="col-2">
                                <h3 class="text-muted mt-4">X</h3>
                            </div>

                            <div class="col-5">
                                @if (Model.Dupla2.EhTime)
                                {
                                    <h6 class="text-truncate"><i class="bi bi-people-fill"></i> @Model.Dupla2.NomeTime</h6>
                                }
                                else
                                {
                                    <h6 class="text-truncate"><a asp-controller="Jogadores" asp-action="Perfil" asp-route-id="@Model.Dupla2.Jogador1Id" class="text-decoration-none">@Model.Dupla2.Jogador1.ComoChamar</a></h6>
                                    <h6 class="text-truncate"><a asp-controller="Jogadores" asp-action="Perfil" asp-route-id="@Model.Dupla2.Jogador2Id" class="text-decoration-none">@(Model.Dupla2.Jogador2?.ComoChamar ?? "A definir")</a></h6>
                                }
                                <input type="number" name="gamesDupla2" value="@Model.GamesDupla2" class="form-control form-control-lg text-center fs-2 mt-2 js-games" placeholder="0" min="0" max="@formato.Games" />
                            </div>
                        </div>

                        @* Quem está SACANDO. No padel é metade da leitura do jogo: quem chega
                           no meio de um game precisa disso pra entender o que está rolando.
                           Fica junto do placar porque quem sabe é quem está olhando a quadra. *@
                        <div class="pdz-saque-escolha">
                            <span class="pdz-saque-titulo"><span class="pdz-bolinha"></span> Quem está sacando</span>
                            <div class="pdz-saque-opcoes">
                                <label class="pdz-saque-opcao @(Model.DuplaSacandoId == Model.Dupla1Id ? "ativa" : "")">
                                    <input type="radio" name="duplaSacandoId" value="@Model.Dupla1Id"
                                           @(Model.DuplaSacandoId == Model.Dupla1Id ? "checked" : "") />
                                    <span>@(Model.Dupla1.EhTime ? Model.Dupla1.NomeTime : $"{Model.Dupla1.Jogador1.ComoChamar.Split(' ')[0]} / {Model.Dupla1.Jogador2?.ComoChamar.Split(' ')[0] ?? "?"}")</span>
                                </label>
                                <label class="pdz-saque-opcao @(Model.DuplaSacandoId == Model.Dupla2Id ? "ativa" : "")">
                                    <input type="radio" name="duplaSacandoId" value="@Model.Dupla2Id"
                                           @(Model.DuplaSacandoId == Model.Dupla2Id ? "checked" : "") />
                                    <span>@(Model.Dupla2.EhTime ? Model.Dupla2.NomeTime : $"{Model.Dupla2.Jogador1.ComoChamar.Split(' ')[0]} / {Model.Dupla2.Jogador2?.ComoChamar.Split(' ')[0] ?? "?"}")</span>
                                </label>
                                <label class="pdz-saque-opcao pdz-saque-limpar @(Model.DuplaSacandoId == null ? "ativa" : "")">
                                    <input type="radio" name="duplaSacandoId" value=""
                                           @(Model.DuplaSacandoId == null ? "checked" : "") />
                                    <span>Não mostrar</span>
                                </label>
                            </div>
                        </div>

                        @* A regra da fase, escrita: sem isso o organizador não tem como saber
                           por que o campo para em 4 — e "para em 4" era justamente o que a tela
                           NÃO fazia, com max="9" cravado independente do que ele configurou. *@
                        <p class="text-center small text-muted mb-3">
                            <i class="bi bi-info-circle"></i>
                            @Model.Fase — este jogo vai até <strong>@formato.Games games</strong>@(formato.Sets > 1 ? $", melhor de {formato.Sets} sets" : "").
                            @if (formato.Games % 2 == 0 && formato.Games > 1)
                            {
                                <text>
                                    Empatando em @(formato.Games - 1)x@(formato.Games - 1), vai até @(formato.Games + 1).
                                </text>
                            }
                        </p>

                        @* Chegou no limite? O caminho de terminar o jogo tem que estar À MÃO.
                           Antes, "finalizar" morava escondido num <select> lá em cima, e quem
                           acabou de digitar 4 x 0 estava olhando pro placar, não pro topo. *@
                        <div id="pdzFinalizarAqui" class="alert alert-success d-none align-items-center justify-content-between gap-2 flex-wrap">
                            <span>
                                <i class="bi bi-flag-fill"></i>
                                Chegou aos <strong>@formato.Games games</strong>. Pode encerrar o jogo.
                            </span>
                            <button type="button" id="pdzBotaoFinalizar" class="btn btn-success fw-bold">
                                <i class="bi bi-check-circle-fill"></i> Finalizar jogo
                            </button>
                        </div>

                        <hr class="text-muted" />

                        <!-- Linha 3: Link de Transmissão -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">🎥 Link de Transmissão (YouTube/Twitch)</label>
                            <input type="url" name="linkTransmissao" id="pdzLinkTransmissao" value="@linkNaTela" class="form-control" placeholder="https://..." />
                            <small class="text-muted">Se preenchido, o botão "Ver Ao Vivo" aparecerá na tela do público.</small>
                            @* Avisar de onde veio: link que aparece sozinho no campo, sem
                               explicação, parece dado errado — e o organizador apaga. *@
                            <small class="text-info d-block @(linkVeioDaQuadra ? "" : "d-none")" id="pdzAvisoLinkDaQuadra">
                                <i class="bi bi-broadcast"></i> Este é o link da câmera desta quadra. Salve pra usar neste jogo.
                            </small>
                        </div>

                        <!-- Aplicar o mesmo link a todos os próximos jogos da quadra (a câmera
                             costuma transmitir a quadra o dia todo). Só afeta jogos NÃO finalizados. -->
                        <div class="form-check mb-4 p-3 rounded-3 bg-light border">
                            <input class="form-check-input" type="checkbox" name="aplicarLinkNaQuadra" value="true" id="aplicarLinkNaQuadra" />
                            <label class="form-check-label" for="aplicarLinkNaQuadra">
                                <strong>Usar este link em todos os próximos jogos desta quadra</strong>
                                <span class="d-block small text-muted">
                                    Aplica o link (e a quadra) aos jogos ainda não realizados desta mesma quadra.
                                    Os jogos que já terminaram não são alterados.
                                </span>
                            </label>
                        </div>

                        <!-- Botões -->
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-controller="Torneios" asp-action="Jogos" asp-route-id="@Model.TorneioId" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-success fw-bold px-5">💾 Salvar Alterações</button>
                        </div>
                    </form>

                    @* ══ W.O.: ALGUÉM NÃO APARECEU ══════════════════════════════════════
                       ⚠️ FORA do <form> de cima, e isso NÃO é preferência: form dentro de
                       form é inválido em HTML e o navegador fecha o de fora no primeiro
                       </form> — os campos do de baixo somem do envio, sem erro nenhum. Já
                       aconteceu neste projeto (a criação de torneio perdia campos assim).

                       Fica no fim da tela, e não junto do placar, porque é o caminho
                       excepcional: quem abre esta tela quase sempre veio marcar games. *@
                    <hr class="my-4" />
                    @if (Padelizou.Services.EncerramentoPorWo.Foi(Model))
                    {
                        <div class="alert alert-warning d-flex align-items-start gap-2 mb-0">
                            <i class="bi bi-person-x-fill fs-5"></i>
                            <div>
                                <strong>Este jogo terminou em W.O.</strong>
                                <span class="d-block small">
                                    O placar acima é o convencional da fase — ele existe pra valer na
                                    classificação e na chave. <strong>Ninguém teve o Padelímetro alterado.</strong>
                                    Se na verdade o jogo aconteceu, corrija o placar e salve: a marca de
                                    W.O. sai sozinha.
                                </span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <details>
                            <summary class="fw-bold text-body-secondary" style="cursor:pointer">
                                <i class="bi bi-person-x"></i> Alguém não compareceu? Registrar W.O.
                            </summary>
                            <div class="mt-3 p-3 rounded-3 border">
                                <p class="small text-body-secondary">
                                    O W.O. encerra o jogo com o placar convencional desta fase, dá a vitória
                                    a quem apareceu e segue a chave normalmente — mas
                                    <strong>não mexe no Padelímetro de ninguém</strong>, porque não se jogou.
                                </p>
                                <form asp-action="RegistrarWo" method="post" class="d-grid gap-2">
                                    <input type="hidden" name="id" value="@Model.Id" />
                                    <input type="hidden" name="voltarPara" value="@(Context.Request.Query["voltarPara"])" />

                                    <label class="form-label fw-bold mb-1" for="pdzDuplaQueFaltou">Quem NÃO compareceu?</label>
                                    <select name="duplaQueNaoCompareceuId" id="pdzDuplaQueFaltou" class="form-select" required>
                                        <option value="">Escolha a dupla que faltou...</option>
                                        <option value="@Model.Dupla1Id">@Model.Dupla1.NomeDeExibicao</option>
                                        <option value="@Model.Dupla2Id">@Model.Dupla2.NomeDeExibicao</option>
                                    </select>

                                    <button type="submit" class="btn btn-outline-warning fw-bold"
                                            data-confirmar="O jogo é encerrado agora com o placar convencional da fase, e a dupla que compareceu segue na chave. O Padelímetro dos quatro NÃO se mexe."
                                            data-confirmar-titulo="Registrar W.O.?"
                                            data-confirmar-ok="Registrar W.O.">
                                        Registrar W.O.
                                    </button>
                                </form>
                            </div>
                        </details>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // O atalho de finalizar aparece quando o placar bate o limite da FASE. É só um
        // atalho: o <select> de status continua lá e manda igual — quem quiser encerrar
        // antes (WO, desistência, chuva) segue podendo, e é por isso que este botão não
        // some nem trava nada, só facilita o caminho de sempre.
        (function () {
            var limite = @formato.Games;
            var aviso = document.getElementById('pdzFinalizarAqui');
            var botao = document.getElementById('pdzBotaoFinalizar');
            var campos = Array.from(document.querySelectorAll('.js-games'));
            var status = document.querySelector('select[name="status"]');
            if (!aviso || !botao || campos.length === 0 || !status) return;

            // O limite não é teto seco: jogo até 4 que empata em 3x3 vai até 5 (o "vencer
            // por dois"); até 9 não estende, porque 8x8 se resolve no tie-break e o 9º game
            // é ele. Mesma conta de Services/FormatoDaPartida.
            function teto(g1, g2) {
                if (limite <= 1 || limite % 2 !== 0) return limite;
                return (g1 >= limite - 1 && g2 >= limite - 1) ? limite + 1 : limite;
            }

            function conferir() {
                var g1 = parseInt(campos[0].value || '0', 10);
                var g2 = parseInt(campos[1] ? campos[1].value || '0' : '0', 10);
                var alvo = teto(g1, g2);

                // O campo acompanha o teto do momento: em 3x3 ele libera o 5º game.
                campos.forEach(function (c) { c.setAttribute('max', alvo); });

                // Encerrar só quando ALGUÉM venceu — em 3x3 (jogo até 4) ninguém venceu
                // ainda, apesar de o 3 estar a um game do fim.
                var bateu = (g1 >= alvo || g2 >= alvo)
                         || (g1 >= limite && g1 > g2) || (g2 >= limite && g2 > g1);

                // d-none e d-flex brigam: o alert precisa dos dois estados explícitos.
                aviso.classList.toggle('d-none', !bateu || status.value === 'Finalizada');
                aviso.classList.toggle('d-flex', bateu && status.value !== 'Finalizada');
            }

            campos.forEach(function (c) { c.addEventListener('input', conferir); });
            status.addEventListener('change', conferir);

            botao.addEventListener('click', function () {
                status.value = 'Finalizada';
                botao.closest('form').requestSubmit();
            });

            conferir();
        })();

        // TROCOU DE QUADRA, TROCOU DE CÂMERA (Felipe, 08/08/2026).
        //
        // A câmera é da quadra e transmite o dia inteiro, então o link acompanha a escolha da
        // quadra. Cada <option> carrega o link da sua (data-link), montado no servidor a
        // partir dos jogos daquela quadra — ver Services/TransmissaoDaQuadra.
        //
        // ⚠️ O que a pessoa DIGITOU não pode ser apagado por uma troca de quadra. Só é
        // substituído o campo vazio ou o que veio de uma quadra (ou seja, o que este script
        // mesmo escreveu). Link colado à mão fica onde está, e o aviso some — ele explica um
        // valor que não é mais herdado.
        (function () {
            var quadra = document.getElementById('pdzQuadra');
            var campo = document.getElementById('pdzLinkTransmissao');
            var aviso = document.getElementById('pdzAvisoLinkDaQuadra');
            if (!quadra || !campo) return;

            var conhecidos = Array.prototype.map.call(quadra.options, function (o) {
                return o.getAttribute('data-link') || '';
            }).filter(function (l) { return l !== ''; });

            quadra.addEventListener('change', function () {
                var atual = campo.value.trim();
                var meu = conhecidos.indexOf(atual) !== -1;
                if (atual !== '' && !meu) return;              // digitado à mão: não se toca

                var novo = quadra.options[quadra.selectedIndex].getAttribute('data-link') || '';
                campo.value = novo;
                if (aviso) aviso.classList.toggle('d-none', novo === '');
            });
        })();
    </script>
}