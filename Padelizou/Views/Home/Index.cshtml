@model Padelizou.ViewModels.HomeVM
@using System.Globalization
@{
    // Título vazio de propósito: a aba mostra só "Padelizou" (o sistema não é só torneio).
    ViewData["Title"] = null;
    bool logado = Model.PrimeiroNome != null;
    var ptBr = CultureInfo.GetCultureInfo("pt-BR");

    // "hoje 14:00" / "amanhã 09:30" / "sáb 05/08 10:00" — curto, do jeito que se fala.
    string QuandoFala(DateTime d)
    {
        if (d.Date == DateTime.Today) return $"hoje às {d:HH\\:mm}";
        if (d.Date == DateTime.Today.AddDays(1)) return $"amanhã às {d:HH\\:mm}";
        return $"{ptBr.DateTimeFormat.GetAbbreviatedDayName(d.DayOfWeek)} {d:dd/MM} às {d:HH\\:mm}";
    }
}

@if (!logado)
{
    <!-- ============ VISITANTE: o mapa da plataforma ============ -->
    <div class="pdz-hero text-center mb-5">
        <span class="pdz-eyebrow"><i class="bi bi-lightning-charge-fill"></i> Jogos · Aulas · Torneios · Ranking</span>
        <h1 class="display-4 fw-bold mb-2">Seu padel num lugar só.</h1>
        <p class="lead mb-4">Encontre parceiros, marque quadra e aula, dispute torneios e acompanhe sua evolução.</p>
        <div class="d-flex flex-wrap gap-2 justify-content-center">
            <a asp-controller="Auth" asp-action="Cadastro" class="btn btn-padel btn-lg rounded-pill px-4">
                <i class="bi bi-person-plus me-1"></i> Criar Conta Grátis
            </a>
            <a asp-controller="Auth" asp-action="Login" class="btn btn-lg pdz-btn-ghost rounded-pill px-4">
                <i class="bi bi-box-arrow-in-right me-1"></i> Já tenho conta
            </a>
        </div>
    </div>
}
else
{
    <!-- ============ LOGADO: hoje no seu padel ============ -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h2 class="fw-bold mb-0" style="color: var(--pdz-ink);">Olá, @Model.PrimeiroNome!</h2>
            <p class="text-muted small mb-0 text-capitalize">@DateTime.Now.ToString("dddd, dd 'de' MMMM", ptBr)</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Avisos" asp-action="Index" class="btn btn-padel rounded-pill px-3">
                <i class="bi bi-megaphone me-1"></i> Buscar Jogo
            </a>
            <a asp-controller="Agenda" asp-action="Index" class="btn btn-outline-primary rounded-pill px-3">
                <i class="bi bi-calendar3 me-1"></i> Agenda
            </a>
        </div>
    </div>
}

<div class="container px-0">

    @if (logado)
    {
        @* Jogador novo é guiado antes de qualquer outra coisa. Some quando completa. *@
        @if (Model.Onboarding != null)
        {
            @await Html.PartialAsync("_Onboarding", Model.Onboarding)
        }

        @*
            Painéis de quem trabalha com padel. Vêm antes do conteúdo de jogador porque
            quem é professor/organizador/dono abre o app pra TRABALHAR — e quem acumula
            papéis vê os três empilhados, sem caçar no menu.
        *@
        @if (Model.Professor != null)
        {
            @await Html.PartialAsync("_PainelProfessor", Model.Professor)
        }
        @if (Model.Organizador != null)
        {
            @await Html.PartialAsync("_PainelOrganizador", Model.Organizador)
        }
        @if (Model.Clube != null)
        {
            @await Html.PartialAsync("_PainelClube", Model.Clube)
        }

        @* A informação mais valiosa que a home pode dar: seu jogo, hora e quadra. *@
        @if (Model.ProximoJogo != null)
        {
            var j = Model.ProximoJogo;
            <div class="card border-0 shadow-sm mb-4 p-4" style="background-color: var(--pdz-navy-fixed); color: white; border-left: 4px solid var(--padel-green) !important;">
                <p class="mb-1 small text-uppercase" style="letter-spacing: 1px; color: var(--padel-green);">
                    <i class="bi bi-alarm"></i> Seu próximo jogo
                </p>
                <div class="d-flex flex-wrap justify-content-between align-items-end gap-3">
                    <div>
                        <h3 class="fw-bold mb-1">@QuandoFala(j.Horario)@(j.Quadra != null ? $" · {j.Quadra}" : "")</h3>
                        <p class="mb-0 text-light opacity-75">
                            contra <strong class="text-light opacity-100">@j.Adversarios</strong><br />
                            <small>@j.Fase · @j.Categoria · @j.Torneio</small>
                        </p>
                    </div>
                    <a asp-controller="Torneios" asp-action="Details" asp-route-id="@j.TorneioId"
                       class="btn btn-padel rounded-pill px-4 fw-bold">Ver torneio</a>
                </div>
            </div>
        }

        @* Próximos compromissos (aula, quadra reservada) *@
        @if (Model.Compromissos.Any())
        {
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="fw-bold mb-0" style="color: var(--pdz-ink);"><i class="bi bi-calendar-event"></i> Próximos compromissos</h6>
                        <a asp-controller="Agenda" asp-action="Index" class="small text-decoration-none fw-bold">Minha agenda →</a>
                    </div>
                    @foreach (var c in Model.Compromissos)
                    {
                        <a asp-controller="@c.Controller" asp-action="@c.Action" asp-route-id="@c.RotaId"
                           class="d-flex align-items-center gap-3 py-2 text-decoration-none border-top">
                            <i class="bi @c.Icone fs-5" style="color: var(--padel-green);"></i>
                            <div class="flex-grow-1 overflow-hidden">
                                <span class="d-block text-truncate fw-bold" style="color: var(--pdz-ink);">@c.Titulo</span>
                                <small class="text-muted">@c.Subtitulo</small>
                            </div>
                            <small class="text-muted text-nowrap">@QuandoFala(c.Data)</small>
                        </a>
                    }
                </div>
            </div>
        }

        @* Torneios em que estou dentro *@
        @if (Model.MeusTorneios.Any())
        {
            <h3 class="pdz-section-title mb-4">Seus torneios</h3>
            <div class="row g-3 mb-5">
                @foreach (var m in Model.MeusTorneios)
                {
                    bool rolando = m.Torneio.Status != "Inscrições Abertas";
                    @* O selo fica ABAIXO do título, na linha dos detalhes: ao lado dele (como
                       era), no celular o título sobrava truncado em "Torneio d..." — o selo e
                       o botão comiam a largura de quem a tela existe pra mostrar. *@
                    <div class="col-12 col-md-6">
                        <div class="card border-0 shadow-sm p-3 h-100 pdz-cartao-linha">
                            <div class="flex-grow-1 pdz-cartao-linha-texto">
                                <strong class="pdz-cartao-linha-titulo">@m.Torneio.Nome</strong>
                                <div class="d-flex align-items-center flex-wrap gap-2 mt-1">
                                    <span class="badge rounded-pill @(rolando ? "bg-danger" : "bg-success")">
                                        @(rolando ? Padelizou.Services.StatusDoTorneioNaTela.Nome(m.Torneio.Status) : "Inscrito")
                                    </span>
                                    <small class="text-muted">@m.Categoria</small>
                                    @if (m.ListaDeEspera)
                                    {
                                        <span class="badge text-bg-warning">lista de espera</span>
                                    }
                                </div>
                            </div>
                            <a asp-controller="Torneios" asp-action="Details" asp-route-id="@m.Torneio.Id"
                               class="btn btn-sm btn-padel rounded-pill px-3 pdz-cartao-linha-acao">@(rolando ? "Acompanhar" : "Ver")</a>
                        </div>
                    </div>
                }
            </div>
        }
    }

    @* Torneio rolando agora (dos outros — os meus já apareceram acima). *@
    @if (Model.EmAndamento.Any())
    {
        <h3 class="pdz-section-title mb-4"><i class="bi bi-broadcast text-danger me-1"></i> Acontecendo agora</h3>
        <div class="row g-3 mb-5">
            @foreach (var t in Model.EmAndamento)
            {
                <div class="col-12 col-md-6">
                    <div class="card border-0 shadow-sm p-3 h-100 pdz-cartao-linha">
                        <div class="flex-grow-1 pdz-cartao-linha-texto">
                            <strong class="pdz-cartao-linha-titulo">@t.Nome</strong>
                            <div class="d-flex align-items-center flex-wrap gap-2 mt-1">
                                <span class="badge rounded-pill bg-danger"><i class="bi bi-record-circle"></i> @Padelizou.Services.StatusDoTorneioNaTela.Nome(t.Status)</span>
                                @if (!string.IsNullOrEmpty(t.LocalTorneio))
                                {
                                    <small class="text-muted"><i class="bi bi-geo-alt"></i> @t.LocalTorneio</small>
                                }
                            </div>
                        </div>
                        <a asp-controller="Torneios" asp-action="Details" asp-route-id="@t.Id"
                           class="btn btn-sm btn-padel rounded-pill px-3 pdz-cartao-linha-acao">Acompanhar</a>
                    </div>
                </div>
            }
        </div>
    }

    <!-- O mapa da plataforma: as 6 portas de entrada -->
    <h3 class="pdz-section-title mb-4">@(logado ? "O que você quer fazer hoje?" : "O que dá pra fazer aqui")</h3>
    <div class="row row-cols-2 row-cols-md-3 g-3 mb-5">
        @{
            var portas = new[]
            {
                (Icone: "bi-megaphone-fill", Titulo: "Buscar um jogo", Texto: "Ache parceiros do seu nível pra jogar hoje.", Controller: "Avisos", Action: "Index"),
                (Icone: "bi-trophy-fill", Titulo: "Torneios", Texto: "Inscreva sua dupla e dispute de verdade.", Controller: "Torneios", Action: "Index"),
                (Icone: "bi-mortarboard-fill", Titulo: "Aulas", Texto: "Marque aula com professor e evolua mais rápido.", Controller: "Aulas", Action: "Solicitar"),
                (Icone: "bi-graph-up-arrow", Titulo: "Ranking", Texto: "Pontos, títulos, vitórias e sua evolução.", Controller: "Jogadores", Action: "Ranking"),
                (Icone: "bi-people-fill", Titulo: "Buscar jogadores", Texto: "Ache parceiro pelo nível, cidade ou clube.", Controller: "Jogadores", Action: "Buscar"),
                (Icone: "bi-shield-lock-fill", Titulo: "Grupos", Texto: "Organize o jogo fixo da semana com a galera.", Controller: "Grupos", Action: "Index"),
                (Icone: "bi-calendar2-week-fill", Titulo: "Marcar quadra", Texto: "Reserve horário nos clubes parceiros.", Controller: "MarcarJogo", Action: "Index"),
            };
        }
        @foreach (var p in portas)
        {
            <div class="col">
                <a asp-controller="@p.Controller" asp-action="@p.Action" class="text-decoration-none">
                    <div class="card border-0 shadow-sm h-100 p-3 pdz-porta">
                        <i class="bi @p.Icone fs-3 mb-2" style="color: var(--padel-green);"></i>
                        <h6 class="fw-bold mb-1" style="color: var(--pdz-ink);">@p.Titulo</h6>
                        <p class="small text-muted mb-0">@p.Texto</p>
                    </div>
                </a>
            </div>
        }
    </div>

    <!-- Torneios com inscrições abertas -->
    @if (Model.Abertos.Any())
    {
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="pdz-section-title mb-0">Inscrições abertas</h3>
            <a asp-controller="Torneios" asp-action="Index" class="small text-decoration-none fw-bold">Ver todos →</a>
        </div>
        <div class="row row-cols-1 row-cols-md-3 g-4 mb-5">
            @foreach (var torneio in Model.Abertos)
            {
                <partial name="_TorneioCard" model="torneio" />
            }
        </div>
    }

    <!-- Números da comunidade: prova social, faz sentido pra quem ainda está de fora -->
    @if (!logado)
    {
        var numeros = new[]
        {
            (Valor: Model.TotalJogadores, Rotulo: "jogadores"),
            (Valor: Model.JogosDisputados, Rotulo: "jogos disputados"),
            (Valor: Model.TorneiosRealizados, Rotulo: "torneios realizados"),
        }.Where(n => n.Valor > 0).ToList();

        @if (numeros.Any())
        {
            <div class="card border-0 shadow-sm mb-5 p-4" style="background-color: var(--pdz-navy-fixed); color: white;">
                <div class="row text-center g-3">
                    @foreach (var n in numeros)
                    {
                        <div class="col-@(12 / numeros.Count)">
                            <h2 class="fw-bold mb-0" style="color: var(--padel-green);">@n.Valor.ToString("N0")</h2>
                            <small class="text-light opacity-75">@n.Rotulo</small>
                        </div>
                    }
                </div>
            </div>
        }
    }

    @* Depoimentos: só o que um admin liberou, um a um. O que o jogador escreve no rodapé
       chega invisível e continua invisível até alguém do Padelizou ler e publicar. *@
    @if (Model.Depoimentos.Any())
    {
        <h3 class="pdz-section-title mb-4">O que dizem do Padelizou</h3>
        <div class="row g-3 mb-5">
            @foreach (var d in Model.Depoimentos)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card border-0 shadow-sm h-100 p-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fw-bold" style="color: var(--pdz-ink);">
                                @d.PrimeiroNome@(string.IsNullOrWhiteSpace(d.Cidade) ? "" : $" · {d.Cidade}")
                            </span>
                            @if (d.Nota.HasValue)
                            {
                                <span class="badge" style="background-color: var(--padel-green);">@d.Nota/10</span>
                            }
                        </div>
                        <p class="small text-muted mb-0" style="white-space: pre-wrap;">@d.Texto</p>
                    </div>
                </div>
            }
        </div>
    }

    @* Quem JÁ exerce algum desses papéis não precisa da propaganda — ele já tem o painel. *@
    @if (!logado || !Model.TemAlgumPapel)
    {
    <!-- Faixa pra quem toca o padel da cidade -->
    <h3 class="pdz-section-title mb-4">Você organiza, ensina ou tem um clube?</h3>
    <div class="row g-3 mb-5">
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm h-100 p-3">
                <h6 class="fw-bold mb-1" style="color: var(--pdz-ink);"><i class="bi bi-clipboard-check me-1"></i> Organizador</h6>
                <p class="small text-muted mb-2">Crie torneios com chaves automáticas, mesa de controle, transmissão ao vivo e cobrança online.</p>
                <a asp-controller="Torneios" asp-action="Index" class="small fw-bold text-decoration-none mt-auto">Criar meu torneio →</a>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm h-100 p-3">
                <h6 class="fw-bold mb-1" style="color: var(--pdz-ink);"><i class="bi bi-mortarboard me-1"></i> Professor</h6>
                <p class="small text-muted mb-2">Agenda de aulas, pacotes, recorrência e recebimento — tudo organizado num painel só.</p>
                <a asp-controller="Aulas" asp-action="Dashboard" class="small fw-bold text-decoration-none mt-auto">Painel do professor →</a>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm h-100 p-3">
                <h6 class="fw-bold mb-1" style="color: var(--pdz-ink);"><i class="bi bi-shop me-1"></i> Clube</h6>
                <p class="small text-muted mb-2">Agenda de quadras online, com marcação pelos jogadores e cobrança na reserva.</p>
                <a asp-controller="MarcarJogo" asp-action="Index" class="small fw-bold text-decoration-none mt-auto">Ver como funciona →</a>
            </div>
        </div>
    </div>
    }
</div>

<style>
    /* Card-porta: levanta no hover pra deixar claro que é clicável. */
    .pdz-porta { transition: transform .15s ease, box-shadow .15s ease; }
    .pdz-porta:hover { transform: translateY(-3px); box-shadow: 0 .5rem 1rem rgba(0, 0, 0, .12) !important; }
</style>
