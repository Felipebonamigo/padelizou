@model Padelizou.ViewModels.BuscaJogadoresVM
@{
    ViewData["Title"] = "Buscar Jogadores";

    // Refaz a URL da busca mudando só um filtro — usado pelos "x" dos chips.
    string UrlSem(string campo)
    {
        var p = new Dictionary<string, string?>
        {
            ["q"] = Model.Termo,
            ["categoriaId"] = Model.CategoriaId?.ToString(),
            ["estado"] = Model.Estado,
            ["cidade"] = Model.Cidade,
            ["clubeId"] = Model.ClubeId?.ToString(),
        };
        p[campo] = null;

        // Tirar o estado sem tirar a cidade deixaria um filtro órfão.
        if (campo == "estado") p["cidade"] = null;

        var qs = string.Join("&", p.Where(x => !string.IsNullOrWhiteSpace(x.Value))
                                   .Select(x => $"{x.Key}={Uri.EscapeDataString(x.Value!)}"));
        return Url.Action("Buscar")! + (qs == "" ? "" : "?" + qs);
    }

    var nomeCategoria = Model.Categorias.FirstOrDefault(c => c.Id == Model.CategoriaId)?.Nome;
    var nomeClube = Model.Clubes.FirstOrDefault(c => c.Id == Model.ClubeId)?.Nome;

    // Depois de seguir, a pessoa volta pra ESTA lista — com os mesmos filtros e na mesma
    // página. Sem isso o clique a jogaria no perfil de quem ela acabou de seguir e o
    // resultado que ela montou (categoria + cidade + clube) se perderia a cada botão.
    var urlDeVolta = $"{Context.Request.Path}{Context.Request.QueryString}";
}

<div class="container mt-4 mb-5">
    <div class="mb-3">
        <h2 class="fw-bold mb-0" style="color: var(--pdz-ink);"><i class="bi bi-search"></i> Buscar</h2>
        <p class="text-muted small mb-0">Ache parceiro pelo nível, pela cidade ou pelo clube onde ele joga.</p>
    </div>

    @* O botão "Ver times" que ficava aqui virou aba — o caminho de volta some se você trocar de
       lado, e aba mostra as duas opções o tempo todo. *@
    <partial name="_AbasBusca" />

    <!-- FILTROS -->
    <form method="get" asp-action="Buscar" class="card border-0 shadow-sm p-3 mb-4">
        <div class="row g-2">
            <div class="col-12 col-lg-4">
                <label class="form-label small fw-bold text-muted mb-1">Nome, apelido ou CPF</label>
                <input type="text" name="q" value="@Model.Termo" class="form-control"
                       placeholder="Ex: Zeca, José Carlos ou 111.444.777-35" />
            </div>

            <div class="col-6 col-lg-2">
                <label class="form-label small fw-bold text-muted mb-1">Categoria</label>
                <select name="categoriaId" class="form-select">
                    <option value="">Todas</option>
                    @foreach (var c in Model.Categorias)
                    {
                        <option value="@c.Id" selected="@(Model.CategoriaId == c.Id)">@c.Nome</option>
                    }
                </select>
            </div>

            @* Mudar o estado recarrega a lista de cidades, por isso ele envia sozinho. *@
            <div class="col-6 col-lg-2">
                <label class="form-label small fw-bold text-muted mb-1">Estado</label>
                <select name="estado" class="form-select" id="pdzEstado">
                    <option value="">Todos</option>
                    @foreach (var uf in Model.Estados)
                    {
                        <option value="@uf" selected="@(Model.Estado == uf)">@uf</option>
                    }
                </select>
            </div>

            <div class="col-6 col-lg-2">
                <label class="form-label small fw-bold text-muted mb-1">Cidade</label>
                <select name="cidade" class="form-select">
                    <option value="">Todas</option>
                    @foreach (var cid in Model.Cidades)
                    {
                        <option value="@cid" selected="@(Model.Cidade == cid)">@cid</option>
                    }
                </select>
            </div>

            <div class="col-6 col-lg-2">
                <label class="form-label small fw-bold text-muted mb-1">Clube</label>
                <select name="clubeId" class="form-select">
                    <option value="">Todos</option>
                    @foreach (var cl in Model.Clubes)
                    {
                        <option value="@cl.Id" selected="@(Model.ClubeId == cl.Id)">@cl.Nome</option>
                    }
                </select>
            </div>
        </div>

        <div class="d-flex gap-2 mt-3">
            <button type="submit" class="btn btn-padel rounded-pill px-4 fw-bold">
                <i class="bi bi-search me-1"></i> Buscar
            </button>
            @if (Model.TemFiltro)
            {
                <a asp-action="Buscar" class="btn btn-outline-secondary rounded-pill px-3">Limpar tudo</a>
            }
        </div>
    </form>

    <!-- CHIPS DO QUE ESTÁ FILTRADO -->
    @if (Model.TemFiltro)
    {
        <div class="d-flex flex-wrap gap-2 mb-3 align-items-center">
            <span class="small text-muted">Filtrando por:</span>

            @if (!string.IsNullOrWhiteSpace(Model.Termo))
            {
                <a href="@UrlSem("q")" class="badge rounded-pill text-decoration-none d-inline-flex align-items-center gap-1"
                   style="background: var(--padel-green); color: #14261a;">
                    <i class="bi bi-person"></i> @Model.Termo <i class="bi bi-x-lg"></i>
                </a>
            }
            @if (nomeCategoria != null)
            {
                <a href="@UrlSem("categoriaId")" class="badge rounded-pill text-decoration-none d-inline-flex align-items-center gap-1"
                   style="background: var(--padel-green); color: #14261a;">
                    <i class="bi bi-bar-chart-steps"></i> @nomeCategoria <i class="bi bi-x-lg"></i>
                </a>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Cidade))
            {
                <a href="@UrlSem("cidade")" class="badge rounded-pill text-decoration-none d-inline-flex align-items-center gap-1"
                   style="background: var(--padel-green); color: #14261a;">
                    <i class="bi bi-geo-alt"></i> @Model.Cidade <i class="bi bi-x-lg"></i>
                </a>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Estado))
            {
                <a href="@UrlSem("estado")" class="badge rounded-pill text-decoration-none d-inline-flex align-items-center gap-1"
                   style="background: var(--padel-green); color: #14261a;">
                    <i class="bi bi-map"></i> @Model.Estado <i class="bi bi-x-lg"></i>
                </a>
            }
            @if (nomeClube != null)
            {
                <a href="@UrlSem("clubeId")" class="badge rounded-pill text-decoration-none d-inline-flex align-items-center gap-1"
                   style="background: var(--padel-green); color: #14261a;">
                    <i class="bi bi-shop"></i> @nomeClube <i class="bi bi-x-lg"></i>
                </a>
            }
        </div>
    }

    <!-- RESULTADO -->
    @* Sem filtro a tela lista todo mundo (paginado) — quem abre querendo "ver quem tem por
       aqui" não precisa adivinhar um nome primeiro. *@
    @if (!Model.Resultados.Any())
    {
        @if (Model.TemFiltro)
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-emoji-neutral fs-1 d-block mb-2 opacity-50"></i>
                <p class="mb-1">Nenhum jogador encontrado com esses filtros.</p>
                <p class="small mb-0">Tente tirar um dos filtros — o botão "x" em cada etiqueta acima remove um de cada vez.</p>
            </div>
        }
        else
        {
            <partial name="_Vazio" model='@(new EstadoVazio("Nenhum jogador cadastrado ainda."))' />
        }
    }
    else
    {
        <p class="small text-muted mb-2">
            @Model.TotalEncontrado jogador(es) encontrado(s)@(Model.TotalPaginas > 1 ? $" — página {Model.Pagina} de {Model.TotalPaginas}" : "")
        </p>

        @if (Model.FiltraPreferencia)
        {
            <div class="alert alert-light border small py-2 mb-3">
                @if (Model.QtdDeclarou > 0)
                {
                    <span>
                        <i class="bi bi-check-circle-fill" style="color: var(--padel-green);"></i>
                        <strong>@Model.QtdDeclarou</strong> declararam exatamente isso no perfil e aparecem primeiro.
                        Os demais entram porque não informaram preferência — o que significa "aceito qualquer uma".
                    </span>
                }
                else
                {
                    <span>
                        <i class="bi bi-info-circle"></i>
                        Ninguém declarou essa preferência ainda no perfil, então a lista traz todos que batem
                        nos outros filtros. Quanto mais jogadores preencherem categoria e clube em
                        <a asp-controller="Auth" asp-action="Preferencias">Minhas Preferências</a>, mais preciso isso fica.
                    </span>
                }
            </div>
        }

        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
            @foreach (var r in Model.Resultados)
            {
                // O card inteiro continua sendo a porta do perfil, mas quem carrega o link
                // agora é o NOME, com stretched-link: o botão de seguir é um <form>, e
                // formulário dentro de <a> não existe em HTML — o clique no botão viraria
                // navegação pro perfil.
                var podeSeguir = Model.MeuId != null && Model.MeuId != r.Jogador.Id;

                <div class="col">
                    <div class="card border-0 shadow-sm h-100 p-3 pdz-porta position-relative">
                        <div class="d-flex align-items-center gap-3 mb-2">
                            @if (!string.IsNullOrWhiteSpace(r.Jogador.FotoPerfil))
                            {
                                <img src="@r.Jogador.FotoPerfil" alt="" class="rounded-circle flex-shrink-0"
                                     style="width: 48px; height: 48px; object-fit: cover;" />
                            }
                            else
                            {
                                <i class="bi bi-person-circle fs-1 flex-shrink-0" style="color: var(--pdz-ink); opacity:.45;"></i>
                            }
                            <div class="flex-grow-1 overflow-hidden">
                                <a asp-action="Perfil" asp-route-id="@r.Jogador.Id" class="stretched-link text-decoration-none d-block">
                                    <strong class="d-block text-truncate" style="color: var(--pdz-ink);">
                                        @r.Jogador.ComoChamar
                                        @if (!string.IsNullOrWhiteSpace(r.Jogador.Apelido))
                                        {
                                            @* Achou pelo apelido? O nome completo confirma que é a pessoa certa. *@
                                            <span class="d-block fw-normal text-muted" style="font-size:.78rem;">@r.Jogador.Nome</span>
                                        }
                                        @if (r.Declarou)
                                        {
                                            <span class="badge rounded-pill ms-1" style="background: var(--padel-green); color: #14261a;"
                                                  title="Declarou essa preferência no perfil">
                                                <i class="bi bi-check-lg"></i> combina
                                            </span>
                                        }
                                    </strong>
                                </a>
                                <small class="text-muted">
                                    @r.Pontos pts
                                    @if (r.Time != null)
                                    {
                                        <span>· <i class="bi bi-shield-fill"></i> @r.Time</span>
                                    }
                                </small>
                            </div>

                            @* Seguir sem sair da busca. Deslogado não vê botão (a ação exige
                               login) e ninguém segue a si mesmo. z-index passa por cima do
                               stretched-link, senão o clique cairia no link do card. *@
                            @if (podeSeguir)
                            {
                                <form asp-action="@(r.EuSigo ? "DeixarDeSeguir" : "Seguir")" method="post"
                                      class="flex-shrink-0 position-relative" style="z-index: 2;">
                                    <input type="hidden" name="id" value="@r.Jogador.Id" />
                                    <input type="hidden" name="voltarPara" value="@urlDeVolta" />
                                    <button type="submit"
                                            class="btn btn-sm @(r.EuSigo ? "btn-outline-secondary" : "btn-padel") rounded-pill px-2 py-1"
                                            style="font-size: .78rem;"
                                            title="@(r.EuSigo ? $"Deixar de seguir {r.Jogador.ComoChamar}" : $"Seguir {r.Jogador.ComoChamar}")">
                                        <i class="bi @(r.EuSigo ? "bi-person-check-fill" : "bi-person-plus")"></i>
                                        @(r.EuSigo ? "Seguindo" : "Seguir")
                                    </button>
                                </form>
                            }
                        </div>

                        <div class="small text-muted">
                            @if (!string.IsNullOrWhiteSpace(r.Jogador.Cidade))
                            {
                                <div class="text-truncate">
                                    <i class="bi bi-geo-alt"></i> @r.Jogador.Cidade@(r.Jogador.Estado != null ? $" - {r.Jogador.Estado}" : "")
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(r.Jogador.LadoQuadra))
                            {
                                <div><i class="bi bi-arrow-left-right"></i> Joga do lado @r.Jogador.LadoQuadra.ToLower()</div>
                            }
                            @if (r.Categorias.Any())
                            {
                                <div class="text-truncate"><i class="bi bi-bar-chart-steps"></i> @string.Join(", ", r.Categorias)</div>
                            }
                            @if (r.Clubes.Any())
                            {
                                <div class="text-truncate"><i class="bi bi-shop"></i> @string.Join(", ", r.Clubes)</div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (Model.TotalPaginas > 1)
        {
            @* Janela de páginas: primeira, vizinhas da atual e última — 40 páginas numeradas
               numa linha não ajudam ninguém. As reticências marcam o que foi pulado. *@
            string UrlPagina(int p) => Url.Action("Buscar", new
            {
                q = Model.Termo, categoriaId = Model.CategoriaId, estado = Model.Estado,
                cidade = Model.Cidade, clubeId = Model.ClubeId, pagina = p
            })!;

            var vizinhas = Enumerable.Range(1, Model.TotalPaginas)
                .Where(p => p == 1 || p == Model.TotalPaginas || Math.Abs(p - Model.Pagina) <= 2)
                .ToList();

            <nav aria-label="Páginas do resultado" class="mt-4">
                <ul class="pagination justify-content-center flex-wrap">
                    <li class="page-item @(Model.Pagina == 1 ? "disabled" : "")">
                        <a class="page-link" href="@UrlPagina(Model.Pagina - 1)">Anterior</a>
                    </li>
                    @{ int anterior = 0; }
                    @foreach (var p in vizinhas)
                    {
                        @if (p - anterior > 1)
                        {
                            <li class="page-item disabled"><span class="page-link">…</span></li>
                        }
                        <li class="page-item @(p == Model.Pagina ? "active" : "")">
                            <a class="page-link" href="@UrlPagina(p)">@p</a>
                        </li>
                        anterior = p;
                    }
                    <li class="page-item @(Model.Pagina == Model.TotalPaginas ? "disabled" : "")">
                        <a class="page-link" href="@UrlPagina(Model.Pagina + 1)">Próxima</a>
                    </li>
                </ul>
            </nav>
        }
    }
</div>

<style>
    .pdz-porta { transition: transform .15s ease, box-shadow .15s ease; }
    .pdz-porta:hover { transform: translateY(-3px); box-shadow: 0 .5rem 1rem rgba(0, 0, 0, .12) !important; }
</style>

@section Scripts {
    <script>
        // Trocar o estado recarrega a página pra lista de cidades acompanhar.
        (function () {
            var uf = document.getElementById('pdzEstado');
            if (!uf) return;
            uf.addEventListener('change', function () {
                var form = uf.closest('form');
                // A cidade escolhida antes provavelmente não existe no novo estado.
                var cidade = form.querySelector('select[name="cidade"]');
                if (cidade) cidade.value = '';
                form.submit();
            });
        })();
    </script>
}
