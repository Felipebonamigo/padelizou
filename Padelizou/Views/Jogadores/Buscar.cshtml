@model Padelizou.ViewModels.BuscaJogadoresVM
@{
    ViewData["Title"] = "Buscar Jogadores";

    // Refaz a URL da busca mudando só um filtro — usado pelos "x" dos chips.
    string UrlSem(string campo)
    {
        var p = new Dictionary<string, string?>
        {
            ["q"] = Model.Nome,
            ["categoriaId"] = Model.CategoriaId?.ToString(),
            ["estado"] = Model.Estado,
            ["cidade"] = Model.Cidade,
            ["clubeId"] = Model.ClubeId?.ToString(),
        };
        p[campo] = null;

        // Tirar o estado sem tirar a cidade deixaria um filtro órfão.
        if (campo == "estado") p["cidade"] = null;

        var qs = string.Join("&", p.Where(x => !string.IsNullOrWhiteSpace(x.Value))
                                   .Select(x => $"{x.Key}={Uri.EscapeDataString(x.Value!)}"));
        return Url.Action("Buscar")! + (qs == "" ? "" : "?" + qs);
    }

    var nomeCategoria = Model.Categorias.FirstOrDefault(c => c.Id == Model.CategoriaId)?.Nome;
    var nomeClube = Model.Clubes.FirstOrDefault(c => c.Id == Model.ClubeId)?.Nome;
}

<div class="container mt-4 mb-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h2 class="fw-bold mb-0" style="color: var(--pdz-ink);"><i class="bi bi-search"></i> Buscar jogadores</h2>
            <p class="text-muted small mb-0">Ache parceiro pelo nível, pela cidade ou pelo clube onde ele joga.</p>
        </div>
        <a asp-controller="Times" asp-action="Index" class="btn btn-outline-primary rounded-pill px-3">
            <i class="bi bi-shield-fill me-1"></i> Ver times
        </a>
    </div>

    <!-- FILTROS -->
    <form method="get" asp-action="Buscar" class="card border-0 shadow-sm p-3 mb-4">
        <div class="row g-2">
            <div class="col-12 col-lg-4">
                <label class="form-label small fw-bold text-muted mb-1">Nome</label>
                <input type="text" name="q" value="@Model.Nome" class="form-control"
                       placeholder="Nome do jogador..." />
            </div>

            <div class="col-6 col-lg-2">
                <label class="form-label small fw-bold text-muted mb-1">Categoria</label>
                <select name="categoriaId" class="form-select">
                    <option value="">Todas</option>
                    @foreach (var c in Model.Categorias)
                    {
                        <option value="@c.Id" selected="@(Model.CategoriaId == c.Id)">@c.Nome</option>
                    }
                </select>
            </div>

            @* Mudar o estado recarrega a lista de cidades, por isso ele envia sozinho. *@
            <div class="col-6 col-lg-2">
                <label class="form-label small fw-bold text-muted mb-1">Estado</label>
                <select name="estado" class="form-select" id="pdzEstado">
                    <option value="">Todos</option>
                    @foreach (var uf in Model.Estados)
                    {
                        <option value="@uf" selected="@(Model.Estado == uf)">@uf</option>
                    }
                </select>
            </div>

            <div class="col-6 col-lg-2">
                <label class="form-label small fw-bold text-muted mb-1">Cidade</label>
                <select name="cidade" class="form-select">
                    <option value="">Todas</option>
                    @foreach (var cid in Model.Cidades)
                    {
                        <option value="@cid" selected="@(Model.Cidade == cid)">@cid</option>
                    }
                </select>
            </div>

            <div class="col-6 col-lg-2">
                <label class="form-label small fw-bold text-muted mb-1">Clube</label>
                <select name="clubeId" class="form-select">
                    <option value="">Todos</option>
                    @foreach (var cl in Model.Clubes)
                    {
                        <option value="@cl.Id" selected="@(Model.ClubeId == cl.Id)">@cl.Nome</option>
                    }
                </select>
            </div>
        </div>

        <div class="d-flex gap-2 mt-3">
            <button type="submit" class="btn btn-padel rounded-pill px-4 fw-bold">
                <i class="bi bi-search me-1"></i> Buscar
            </button>
            @if (Model.TemFiltro)
            {
                <a asp-action="Buscar" class="btn btn-outline-secondary rounded-pill px-3">Limpar tudo</a>
            }
        </div>
    </form>

    <!-- CHIPS DO QUE ESTÁ FILTRADO -->
    @if (Model.TemFiltro)
    {
        <div class="d-flex flex-wrap gap-2 mb-3 align-items-center">
            <span class="small text-muted">Filtrando por:</span>

            @if (!string.IsNullOrWhiteSpace(Model.Nome))
            {
                <a href="@UrlSem("q")" class="badge rounded-pill text-decoration-none d-inline-flex align-items-center gap-1"
                   style="background: var(--padel-green); color: #14261a;">
                    <i class="bi bi-person"></i> @Model.Nome <i class="bi bi-x-lg"></i>
                </a>
            }
            @if (nomeCategoria != null)
            {
                <a href="@UrlSem("categoriaId")" class="badge rounded-pill text-decoration-none d-inline-flex align-items-center gap-1"
                   style="background: var(--padel-green); color: #14261a;">
                    <i class="bi bi-bar-chart-steps"></i> @nomeCategoria <i class="bi bi-x-lg"></i>
                </a>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Cidade))
            {
                <a href="@UrlSem("cidade")" class="badge rounded-pill text-decoration-none d-inline-flex align-items-center gap-1"
                   style="background: var(--padel-green); color: #14261a;">
                    <i class="bi bi-geo-alt"></i> @Model.Cidade <i class="bi bi-x-lg"></i>
                </a>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Estado))
            {
                <a href="@UrlSem("estado")" class="badge rounded-pill text-decoration-none d-inline-flex align-items-center gap-1"
                   style="background: var(--padel-green); color: #14261a;">
                    <i class="bi bi-map"></i> @Model.Estado <i class="bi bi-x-lg"></i>
                </a>
            }
            @if (nomeClube != null)
            {
                <a href="@UrlSem("clubeId")" class="badge rounded-pill text-decoration-none d-inline-flex align-items-center gap-1"
                   style="background: var(--padel-green); color: #14261a;">
                    <i class="bi bi-shop"></i> @nomeClube <i class="bi bi-x-lg"></i>
                </a>
            }
        </div>
    }

    <!-- RESULTADO -->
    @if (!Model.TemFiltro)
    {
        <div class="text-center text-muted py-5">
            <i class="bi bi-people fs-1 d-block mb-2 opacity-50"></i>
            <p class="mb-1">Escolha um filtro acima pra começar.</p>
            <p class="small mb-0">Dá pra combinar: categoria + cidade + clube ao mesmo tempo.</p>
        </div>
    }
    else if (!Model.Resultados.Any())
    {
        <div class="text-center text-muted py-5">
            <i class="bi bi-emoji-neutral fs-1 d-block mb-2 opacity-50"></i>
            <p class="mb-1">Nenhum jogador encontrado com esses filtros.</p>
            <p class="small mb-0">Tente tirar um dos filtros — o botão "x" em cada etiqueta acima remove um de cada vez.</p>
        </div>
    }
    else
    {
        <p class="small text-muted mb-2">
            @Model.TotalEncontrado jogador(es) encontrado(s)@(Model.Truncado ? $" — mostrando os {Model.Resultados.Count} primeiros, refine os filtros pra ver os demais" : "")
        </p>

        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
            @foreach (var r in Model.Resultados)
            {
                <div class="col">
                    <a asp-action="Perfil" asp-route-id="@r.Jogador.Id" class="text-decoration-none">
                        <div class="card border-0 shadow-sm h-100 p-3 pdz-porta">
                            <div class="d-flex align-items-center gap-3 mb-2">
                                @if (!string.IsNullOrWhiteSpace(r.Jogador.FotoPerfil))
                                {
                                    <img src="@r.Jogador.FotoPerfil" alt="" class="rounded-circle flex-shrink-0"
                                         style="width: 48px; height: 48px; object-fit: cover;" />
                                }
                                else
                                {
                                    <i class="bi bi-person-circle fs-1 flex-shrink-0" style="color: var(--pdz-ink); opacity:.45;"></i>
                                }
                                <div class="flex-grow-1 overflow-hidden">
                                    <strong class="d-block text-truncate" style="color: var(--pdz-ink);">@r.Jogador.Nome</strong>
                                    <small class="text-muted">
                                        @r.Pontos pts
                                        @if (r.Time != null)
                                        {
                                            <span>· <i class="bi bi-shield-fill"></i> @r.Time</span>
                                        }
                                    </small>
                                </div>
                            </div>

                            <div class="small text-muted">
                                @if (!string.IsNullOrWhiteSpace(r.Jogador.Cidade))
                                {
                                    <div class="text-truncate">
                                        <i class="bi bi-geo-alt"></i> @r.Jogador.Cidade@(r.Jogador.Estado != null ? $" - {r.Jogador.Estado}" : "")
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(r.Jogador.LadoQuadra))
                                {
                                    <div><i class="bi bi-arrow-left-right"></i> Joga do lado @r.Jogador.LadoQuadra.ToLower()</div>
                                }
                                @if (r.Categorias.Any())
                                {
                                    <div class="text-truncate"><i class="bi bi-bar-chart-steps"></i> @string.Join(", ", r.Categorias)</div>
                                }
                                @if (r.Clubes.Any())
                                {
                                    <div class="text-truncate"><i class="bi bi-shop"></i> @string.Join(", ", r.Clubes)</div>
                                }
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    }
</div>

<style>
    .pdz-porta { transition: transform .15s ease, box-shadow .15s ease; }
    .pdz-porta:hover { transform: translateY(-3px); box-shadow: 0 .5rem 1rem rgba(0, 0, 0, .12) !important; }
</style>

@section Scripts {
    <script>
        // Trocar o estado recarrega a página pra lista de cidades acompanhar.
        (function () {
            var uf = document.getElementById('pdzEstado');
            if (!uf) return;
            uf.addEventListener('change', function () {
                var form = uf.closest('form');
                // A cidade escolhida antes provavelmente não existe no novo estado.
                var cidade = form.querySelector('select[name="cidade"]');
                if (cidade) cidade.value = '';
                form.submit();
            });
        })();
    </script>
}
