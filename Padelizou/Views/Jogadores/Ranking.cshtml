                </table></div></div>

                <h5 class="fw-bold mb-2"><i class="bi bi-diagram-3-fill text-secondary"></i> Por categoria</h5>
                <ul class="nav nav-pills flex-nowrap overflow-auto pb-2 mb-3" role="tablist" style="white-space: nowrap;">
                    @for (var i = 0; i < Model.VitoriasDuplasPorCategoria.Count; i++)
                    {
                        <li class="nav-item me-2"><button class="nav-link rounded-pill @(i == 0 ? "active" : "")" data-bs-toggle="pill" data-bs-target="#vdc-@i" type="button">@Model.VitoriasDuplasPorCategoria[i].Categoria</button></li>
                    }
                </ul>
                <div class="tab-content">
                    @for (var i = 0; i < Model.VitoriasDuplasPorCategoria.Count; i++)
                    {
                        var cat = Model.VitoriasDuplasPorCategoria[i];
                        <div class="tab-pane fade @(i == 0 ? "show active" : "")" id="vdc-@i" role="tabpanel">
                            <div class="card shadow-sm border-0"><div class="table-responsive"><table class="table table-hover align-middle mb-0">
                                <thead><tr><th class="text-center" style="width:60px;">#</th><th>Dupla</th><th>Torneio</th><th class="text-center">Vitórias</th><th class="text-center">Jogos</th></tr></thead>
                                <tbody>
                                    @{ var pos = 1; }
                                    @foreach (var d in cat.Duplas)
                                    {
                                        <tr>
                                            <td class="text-center fw-bold">@Html.Raw(PosBadge(pos))</td>
                                            <td>@Html.Raw(NomesDaDupla(d.Jogador1, d.Jogador2))</td>
                                            <td class="small text-muted">@d.Torneio</td>
                                            <td class="text-center fw-bold text-success">@d.Vitorias</td>
                                            <td class="text-center text-muted">@d.Jogos</td>
                                        </tr>
                                        pos++;
                                    }
                                </tbody>
                            </table></div></div>
                        </div>
                    }
                </div>
            }
        </div>

        @* ============================ 5+8. INVENCIBILIDADE ============================ *@
        <div class="tab-pane fade" id="tab-invicto" role="tabpanel">
            @Html.Raw(SeletorPeriodo(Model, "#tab-invicto"))
            <p class="text-muted small mb-3">Maior sequência de partidas de torneio consecutivas <strong>sem perder</strong>.</p>
            <div class="row g-4">
                <div class="col-lg-6">
                    <h5 class="fw-bold mb-2"><i class="bi bi-person-fill text-danger"></i> Jogadores mais invictos</h5>
                    @if (!Model.InvictosJogadores.Any())
                    {
                        <div class="text-muted small">Sem dados ainda.</div>
                    }
                    else
                    {
                        <div class="card shadow-sm border-0"><div class="table-responsive"><table class="table table-hover align-middle mb-0">
                            <thead><tr><th class="text-center" style="width:60px;">#</th><th>Jogador</th><th class="text-center">Sequência</th><th class="text-end pe-3">Período</th></tr></thead>
                            <tbody>
                                @{ var pos = 1; }
                                @foreach (var j in Model.InvictosJogadores)
                                {
                                    <tr>
                                        <td class="text-center fw-bold">@Html.Raw(PosBadge(pos))</td>
                                        <td><a asp-action="Perfil" asp-route-id="@j.Jogador.Id" class="fw-bold text-decoration-none" style="color: var(--pdz-ink);">@j.Jogador.ComoChamar</a></td>
                                        <td class="text-center"><span class="badge bg-danger-subtle text-danger fw-bold">@j.Sequencia <i class="bi bi-fire"></i></span></td>
                                        <td class="text-end pe-3 small text-muted">@Periodo(j.De, j.Ate)</td>
                                    </tr>
                                    pos++;
                                }
                            </tbody>
                        </table></div></div>
                    }
                </div>
                <div class="col-lg-6">
                    <h5 class="fw-bold mb-2"><i class="bi bi-people-fill text-danger"></i> Duplas mais invictas</h5>
                    @if (!Model.InvictasDuplas.Any())
                    {
                        <div class="text-muted small">Sem dados ainda.</div>
                    }
                    else
                    {
                        <div class="card shadow-sm border-0"><div class="table-responsive"><table class="table table-hover align-middle mb-0">
                            <thead><tr><th class="text-center" style="width:60px;">#</th><th>Dupla</th><th class="text-center">Seq.</th><th class="text-end pe-3">Torneio</th></tr></thead>
                            <tbody>
                                @{ var posd = 1; }
                                @foreach (var d in Model.InvictasDuplas)
                                {
                                    <tr>
                                        <td class="text-center fw-bold">@Html.Raw(PosBadge(posd))</td>
                                        <td>
                                            @Html.Raw(NomesDaDupla(d.Jogador1, d.Jogador2))
                                            <div class="small text-muted">@d.Categoria</div>
                                        </td>
                                        <td class="text-center"><span class="badge bg-danger-subtle text-danger fw-bold">@d.SequenciaInvicta <i class="bi bi-fire"></i></span></td>
                                        <td class="text-end pe-3 small text-muted">@d.Torneio</td>
                                    </tr>
                                    posd++;
                                }
                            </tbody>
                        </table></div></div>
                    }
                </div>
            </div>
        </div>

        @* ============================ 10. RANKING DE TIMES ============================ *@
        <div class="tab-pane fade" id="tab-times" role="tabpanel">
            <p class="text-muted small mb-3">Cada ponto que um jogador conquista em torneio soma para o time dele. Mesma pontuação por fase do ranking individual.</p>
            @if (!Model.Times.Any())
            {
                <div class="text-center py-5 rounded-3 bg-light" style="border: 2px dashed var(--pdz-border);">
                    <i class="bi bi-shield display-4 text-muted mb-3"></i>
                    <h4 class="fw-bold text-secondary">Ainda não há times pontuando</h4>
                    <p class="text-muted mb-0">Quando jogadores com time tiverem resultados em torneios, o ranking aparece aqui.</p>
                </div>
            }
            else
            {
                <div class="card shadow-sm border-0"><div class="table-responsive"><table class="table table-hover align-middle mb-0">
                    <thead><tr><th class="text-center" style="width:60px;">#</th><th>Time</th><th class="text-center">Jogadores</th><th class="text-center">Títulos</th><th class="text-center">Vitórias</th><th class="text-end">Pontos</th><th class="text-center" style="width:64px;" title="Movimento no último mês">Mês</th></tr></thead>
                    <tbody>
                        @{ var posT = 1; }
                        @foreach (var t in Model.Times)
                        {
                            <tr>
                                <td class="text-center fw-bold">@Html.Raw(PosBadge(posT))</td>
                                <td class="fw-bold" style="color: var(--pdz-ink);">
                                    @if (!string.IsNullOrEmpty(t.Logo))
                                    {
                                        <img src="@t.Logo" alt="" class="rounded me-1" style="width:24px;height:24px;object-fit:contain;vertical-align:middle;" />
                                    }
                                    else
                                    {
                                        <i class="bi bi-shield-fill text-secondary me-1"></i>
                                    }
                                    @t.Time
                                </td>
                                <td class="text-center text-muted">@t.Jogadores</td>
                                <td class="text-center">@(t.Titulos > 0 ? Html.Raw($"<span class='text-warning fw-bold'><i class='bi bi-trophy-fill'></i> {t.Titulos}</span>") : Html.Raw("<span class='text-muted'>—</span>"))</td>
                                <td class="text-center fw-bold text-success">@t.Vitorias</td>
                                <td class="text-end fw-bold" style="color: var(--pdz-ink);">@t.Pontos</td>
                                <td class="text-center">@Html.Raw(MovBadge(t.Movimento))</td>
                            </tr>
                            posT++;
                        }
                    </tbody>
                </table></div></div>
            }
        </div>

    </div>
</div>

<script>
    // Reabre a aba indicada na hash da URL (usado pelos botões de período, que recarregam a página).
    document.addEventListener('DOMContentLoaded', function () {
        var h = location.hash;
        if (h && h.length > 1) {
            var btn = document.querySelector('.nav-pills [data-bs-target="' + h + '"]');
            if (btn && window.bootstrap) { new bootstrap.Tab(btn).show(); }
        }
    });

    // Buscar jogador dentro do ranking (filtra as linhas visíveis por nome, em todas as tabelas).
    (function () {
        var input = document.getElementById('pdzBuscaRanking');
        var limpar = document.getElementById('pdzBuscaLimpar');
        if (!input) return;
        function aplicar() {
            var termo = (input.value || '').trim().toLowerCase();
            document.querySelectorAll('#pdzRankConteudo table tbody tr').forEach(function (tr) {
                var nome = tr.textContent.toLowerCase();
                tr.style.display = (!termo || nome.indexOf(termo) !== -1) ? '' : 'none';
            });
        }
        input.addEventListener('input', aplicar);
        if (limpar) limpar.addEventListener('click', function () { input.value = ''; aplicar(); input.focus(); });
    })();

    // Dropdown de categorias na aba "Por categoria": escolher vira chip e some do dropdown.
    (function () {
        var sel = document.getElementById('pdzCatSelect');
        if (!sel) return;
        var chipWrap = document.getElementById('pdzCatChipWrap');
        var vazio = document.getElementById('pdzCatVazio');
        var vazioNome = document.getElementById('pdzCatVazioNome');
        var inicial = document.getElementById('pdzCatInicial');

        function painelDe(cat) {
            var found = null;
            document.querySelectorAll('.pdz-cat-panel').forEach(function (p) { if (p.dataset.cat === cat) found = p; });
            return found;
        }
        function limpar() {
            document.querySelectorAll('.pdz-cat-panel').forEach(function (p) { p.hidden = true; });
            if (vazio) vazio.hidden = true;
            if (inicial) inicial.hidden = false;
            chipWrap.innerHTML = '';
            for (var i = 0; i < sel.options.length; i++) { sel.options[i].hidden = false; }
            sel.value = '';
        }
        function aplicar(cat) {
            if (!cat) { limpar(); return; }
            if (inicial) inicial.hidden = true;
            document.querySelectorAll('.pdz-cat-panel').forEach(function (p) { p.hidden = (p.dataset.cat !== cat); });
            var painel = painelDe(cat);
            if (vazio) { vazio.hidden = !!painel; if (!painel && vazioNome) vazioNome.textContent = cat; }
            // chip ao lado
            chipWrap.innerHTML = '';
            var chip = document.createElement('span');
            chip.className = 'badge rounded-pill bg-primary d-inline-flex align-items-center gap-1 py-2 px-3';
            var txt = document.createElement('span');
            txt.innerHTML = '<i class="bi bi-funnel-fill"></i> ';
            txt.appendChild(document.createTextNode(cat));
            var x = document.createElement('button');
            x.type = 'button';
            x.className = 'btn-close btn-close-white';
            x.style.fontSize = '.6rem';
            x.setAttribute('aria-label', 'Remover filtro de categoria');
            x.addEventListener('click', limpar);
            chip.appendChild(txt);
            chip.appendChild(x);
            chipWrap.appendChild(chip);
            // some do dropdown a categoria escolhida
            for (var i = 0; i < sel.options.length; i++) {
                if (sel.options[i].value) sel.options[i].hidden = (sel.options[i].value === cat);
            }
            sel.value = '';
        }
        sel.addEventListener('change', function () { if (this.value) aplicar(this.value); });

        // Início: mostra a primeira categoria que tem dados (se houver).
        var primeiro = document.querySelector('.pdz-cat-panel');
        if (primeiro) aplicar(primeiro.dataset.cat);
    })();
</script>
