@model Padelizou.ViewModels.RankingHubVM
@using Padelizou.ViewModels
@{
    ViewData["Title"] = "Ranking";
    var torneiosList = ViewBag.TorneiosList as List<Padelizou.Models.Torneio> ?? new List<Padelizou.Models.Torneio>();
    bool temTorneioSelecionado = Model.TorneioSelecionadoId != null;
}

@functions {
    // Selo de posição (1º/2º/3º com medalha, restante em cinza).
    static string PosBadge(int pos) => pos switch
    {
        1 => "<span class=\"badge bg-warning text-dark\">1º</span>",
        2 => "<span class=\"badge bg-secondary\">2º</span>",
        3 => "<span class=\"badge\" style=\"background:#cd7f32;color:#fff;\">3º</span>",
        _ => $"<span class=\"text-muted\">{pos}º</span>"
    };

    // Os dois nomes da dupla, com link pro perfil de cada um.
    //
    // O parceiro pode ser NULO: desde build-17 dá pra se inscrever sozinho e definir o
    // parceiro depois. Hoje uma dupla incompleta não chega a acumular vitória (o sorteio
    // só aceita dupla completa), então isto aqui é cinto e suspensório — mas foi
    // exatamente um Jogador2 nulo que derrubou a página do torneio em produção no dia
    // 27/07, e nesta view a mesma desatenção estava repetida em três lugares.
    static string NomesDaDupla(Jogador jogador1, Jogador? jogador2)
    {
        // ComoChamar, não Nome: é a regra única de exibição — primeiro nome + último
        // sobrenome (apelido). Ver Services/NomeBonito.
        static string Link(Jogador j) =>
            $"<a href=\"/Jogadores/Perfil/{j.Id}\" class=\"text-decoration-none fw-semibold\" " +
            $"style=\"color: var(--pdz-ink);\">{System.Net.WebUtility.HtmlEncode(j.ComoChamar)}</a>";

        return jogador2 == null
            ? Link(jogador1) + " <span class=\"text-muted small\">(sem parceiro)</span>"
            : Link(jogador1) + " <span class=\"text-muted\">/</span> " + Link(jogador2);
    }

    static string Periodo(DateTime? de, DateTime? ate)
    {
        if (de == null) return "—";
        var d = de.Value.ToString("dd/MM/yy");
        var a = (ate ?? de).Value.ToString("dd/MM/yy");
        return d == a ? d : $"{d} – {a}";
    }

    // Selo de movimento no último mês (estilo HLTV): subiu (verde), desceu (vermelho),
    // igual (–) ou novo no ranking.
    static string MovBadge(int? mov)
    {
        if (mov == null) return "<span class=\"badge bg-primary-subtle text-primary\" title=\"Novo no ranking\">novo</span>";
        if (mov == 0) return "<span class=\"text-muted\" title=\"Sem mudança\">–</span>";
        if (mov > 0) return $"<span class=\"text-success fw-bold\" title=\"Subiu {mov}\"><i class=\"bi bi-caret-up-fill\"></i>{mov}</span>";
        return $"<span class=\"text-danger fw-bold\" title=\"Desceu {-mov}\"><i class=\"bi bi-caret-down-fill\"></i>{-mov}</span>";
    }

    // Monta a URL do ranking com um estado + lista de cidades (e preserva torneio/período atuais).
    // Usado pelos filtros de local (multi-cidade) e reaproveitado pelo seletor de período.
    static string UrlLocal(RankingHubVM m, string? estado, IEnumerable<string> cidades, string? periodo, int? torneioId, string hash = "")
    {
        var qs = new List<string>();
        if (!string.IsNullOrWhiteSpace(estado)) qs.Add("estado=" + System.Uri.EscapeDataString(estado));
        foreach (var c in cidades.Where(c => !string.IsNullOrWhiteSpace(c)).Distinct())
            qs.Add("cidade=" + System.Uri.EscapeDataString(c));
        if (torneioId != null) qs.Add("torneioId=" + torneioId);
        if (!string.IsNullOrEmpty(periodo) && periodo != "sempre") qs.Add("periodo=" + periodo);
        return "/Jogadores/Ranking" + (qs.Count > 0 ? "?" + string.Join("&", qs) : "") + hash;
    }

    // Botões de período (Este mês / Este ano / Sempre) para as abas de vitórias/invencibilidade/troféus.
    // Preserva os filtros atuais (local, torneio) e leva a hash da aba pra reabri-la após o reload.
    static string SeletorPeriodo(RankingHubVM m, string hash)
    {
        var sb = new System.Text.StringBuilder();
        sb.Append("<div class=\"d-flex align-items-center gap-2 mb-3 flex-wrap\">");
        sb.Append("<span class=\"text-muted small fw-semibold\"><i class=\"bi bi-calendar3\"></i> Período:</span>");
        sb.Append("<div class=\"btn-group btn-group-sm\" role=\"group\">");
        foreach (var (v, l) in new[] { ("mes", "Este mês"), ("ano", "Este ano"), ("sempre", "Sempre") })
            sb.Append($"<a href=\"{UrlLocal(m, m.Estado, m.Cidades, v, m.TorneioSelecionadoId, hash)}\" class=\"btn {(m.Periodo == v ? "btn-primary" : "btn-outline-secondary")}\">{l}</a>");
        sb.Append("</div></div>");
        return sb.ToString();
    }
}

<div class="container mt-3 mb-5">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
        <div>
            <h2 class="pdz-section-title mb-1"><i class="bi bi-award-fill text-warning"></i> Ranking</h2>
            <p class="text-muted mb-0">
                <i class="bi bi-shield-lock"></i>
                Tudo abaixo é calculado <strong>só a partir de resultados de torneios</strong>.
                Aulas, jogos semanais e ajustes manuais não entram.
            </p>
        </div>
        @if (torneiosList.Any())
        {
            <div class="d-flex gap-2 flex-wrap align-items-center">
                <select class="form-select form-select-sm rounded-pill" style="max-width: 240px;"
                        onchange="if(this.value) window.location.href='/Jogadores/Ranking?torneioId=' + this.value; else window.location.href='/Jogadores/Ranking';">
                    <option value="">Ver ranking de um torneio…</option>
                    @foreach (var t in torneiosList)
                    {
                        <option value="@t.Id" selected="@(Model.TorneioSelecionadoId == t.Id)">@t.Nome</option>
                    }
                </select>
            </div>
        }
    </div>

    <!-- Filtro regional (padrão: país todo). Um estado + VÁRIAS cidades ao mesmo tempo. -->
    @{
        var cidadesRestantes = Model.CidadesDisponiveis.Where(c => !Model.Cidades.Contains(c)).ToList();
    }
    <div class="d-flex align-items-center gap-2 flex-wrap mt-3 mb-1">
        <span class="text-muted small fw-semibold"><i class="bi bi-geo-alt-fill"></i> Local:</span>

        <!-- Estado: trocar o estado zera as cidades (elas são de outro estado) -->
        <select id="filtroEstado" class="form-select form-select-sm" style="max-width: 160px;"
                onchange="if(this.value !== undefined) window.location.href = this.value">
            <option value="@UrlLocal(Model, null, new string[0], Model.Periodo, Model.TorneioSelecionadoId)" selected="@(Model.Estado == null)">Brasil todo</option>
            @foreach (var uf in Model.EstadosDisponiveis)
            {
                <option value="@UrlLocal(Model, uf, new string[0], Model.Periodo, Model.TorneioSelecionadoId)" selected="@(Model.Estado == uf)">@uf</option>
            }
        </select>

        <!-- Cidades já escolhidas viram chips (cada uma com ✕ pra remover) -->
        @foreach (var c in Model.Cidades)
        {
            <span class="badge rounded-pill bg-primary d-inline-flex align-items-center gap-1 py-2 px-3">
                <i class="bi bi-geo-alt-fill"></i> @c
                <a href="@UrlLocal(Model, Model.Estado, Model.Cidades.Where(x => x != c), Model.Periodo, Model.TorneioSelecionadoId)"
                   class="text-white text-decoration-none ms-1" title="Remover @c" style="font-size:.85rem;">&times;</a>
            </span>
        }

        <!-- Adicionar mais uma cidade (some as já escolhidas) -->
        @if (cidadesRestantes.Any())
        {
            <select class="form-select form-select-sm" style="max-width: 220px;"
                    onchange="if(this.value) window.location.href = this.value">
                <option value="">@(Model.Cidades.Any() ? "+ Adicionar cidade" : "Todas as cidades")</option>
                @foreach (var c in cidadesRestantes)
                {
                    <option value="@UrlLocal(Model, Model.Estado, Model.Cidades.Append(c), Model.Periodo, Model.TorneioSelecionadoId)">@c</option>
                }
            </select>
        }

        @if (Model.TemFiltro)
        {
            <a href="/Jogadores/Ranking" class="btn btn-sm btn-outline-secondary rounded-pill">Limpar</a>
        }
    </div>
    <p class="text-muted small mb-3">
        @if (Model.TemFiltro)
        {
            <text>Considerando apenas jogadores de:
            <strong>@(Model.Cidades.Any() ? string.Join(", ", Model.Cidades) : "todas as cidades")@(Model.Estado != null ? " · " + Model.Estado : "")</strong>.</text>
        }
        else
        {
            <text>Mostrando o ranking do Brasil todo.</text>
        }
    </p>

    @* ============ RANKING DE UM TORNEIO (embutido na mesma página) ============ *@
    @if (temTorneioSelecionado)
    {
        <div class="card shadow-sm border-0 mb-4" id="tab-torneio">
            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h5 class="mb-0"><i class="bi bi-trophy-fill text-warning"></i> Ranking do torneio: @Model.TorneioSelecionadoNome</h5>
                <a href="/Jogadores/Ranking" class="btn btn-sm btn-outline-light rounded-pill"><i class="bi bi-arrow-left"></i> Ranking geral</a>
            </div>
            @if (!Model.RankingTorneio.Any())
            {
                <div class="card-body text-muted"><i class="bi bi-info-circle"></i> Esse torneio ainda não tem jogadores pontuando.</div>
            }
            else
            {
                <div class="table-responsive"><table class="table table-hover align-middle mb-0">
                    <thead><tr>
                        <th class="text-center" style="width:60px;">#</th><th>Jogador</th>
                        <th class="text-center">Jogos</th><th class="text-center">Títulos</th>
                        <th class="text-center">Vitórias</th><th class="text-end">Pontos</th>
                    </tr></thead>
                    <tbody>
                        @{ var posTor = 1; }
                        @foreach (var l in Model.RankingTorneio)
                        {
                            <tr>
                                <td class="text-center fw-bold">@Html.Raw(PosBadge(posTor))</td>
                                <td><a asp-action="Perfil" asp-route-id="@l.Jogador.Id" class="fw-bold text-decoration-none" style="color: var(--pdz-ink);">@l.Jogador.ComoChamar</a></td>
                                <td class="text-center text-muted">@l.Jogos</td>
                                <td class="text-center">@(l.Titulos > 0 ? Html.Raw($"<span class='text-warning fw-bold'><i class='bi bi-trophy-fill'></i> {l.Titulos}</span>") : Html.Raw("<span class='text-muted'>—</span>"))</td>
                                <td class="text-center fw-bold text-success">@l.Vitorias</td>
                                <td class="text-end fw-bold" style="color: var(--pdz-ink);">@l.Pontos</td>
                            </tr>
                            posTor++;
                        }
                    </tbody>
                </table></div>
            }
        </div>
    }

    <!-- Navegação principal -->
    <ul class="nav nav-pills flex-nowrap overflow-auto pb-2 mb-3 mt-2" role="tablist" style="white-space: nowrap;">
        <li class="nav-item me-2"><button class="nav-link rounded-pill fw-semibold active" data-bs-toggle="pill" data-bs-target="#tab-pontos" type="button"><i class="bi bi-list-ol"></i> Por categoria</button></li>
        <li class="nav-item me-2"><button class="nav-link rounded-pill fw-semibold" data-bs-toggle="pill" data-bs-target="#tab-padelimetro" type="button"><i class="bi bi-speedometer2"></i> Padelímetro</button></li>
        <li class="nav-item me-2"><button class="nav-link rounded-pill fw-semibold" data-bs-toggle="pill" data-bs-target="#tab-americano" type="button"><i class="bi bi-arrow-repeat"></i> Americano</button></li>
        <li class="nav-item me-2"><button class="nav-link rounded-pill fw-semibold" data-bs-toggle="pill" data-bs-target="#tab-trofeus" type="button"><i class="bi bi-trophy-fill"></i> Troféus</button></li>
        <li class="nav-item me-2"><button class="nav-link rounded-pill fw-semibold" data-bs-toggle="pill" data-bs-target="#tab-vjog" type="button"><i class="bi bi-person-check-fill"></i> Vitórias (jogadores)</button></li>
        <li class="nav-item me-2"><button class="nav-link rounded-pill fw-semibold" data-bs-toggle="pill" data-bs-target="#tab-vdup" type="button"><i class="bi bi-people-fill"></i> Vitórias (duplas)</button></li>
        <li class="nav-item me-2"><button class="nav-link rounded-pill fw-semibold" data-bs-toggle="pill" data-bs-target="#tab-invicto" type="button"><i class="bi bi-fire"></i> Invencibilidade</button></li>
        <li class="nav-item me-2"><button class="nav-link rounded-pill fw-semibold" data-bs-toggle="pill" data-bs-target="#tab-times" type="button"><i class="bi bi-shield-fill"></i> Times</button></li>
    </ul>

    <!-- Buscar jogador DENTRO do ranking selecionado (filtro client-side por nome) -->
    <div class="input-group input-group-sm mb-3" style="max-width: 360px;">
        <span class="input-group-text"><i class="bi bi-search"></i></span>
        <input type="text" id="pdzBuscaRanking" class="form-control" placeholder="Buscar jogador neste ranking…" autocomplete="off" />
        <button type="button" class="btn btn-outline-secondary" id="pdzBuscaLimpar" title="Limpar"><i class="bi bi-x-lg"></i></button>
    </div>

    <div class="tab-content" id="pdzRankConteudo">

        @* ============================ 1. POR CATEGORIA (PONTOS) — DROPDOWN ============================ *@
        <div class="tab-pane fade show active" id="tab-pontos" role="tabpanel">
            @* ⚠️ A guarda olha `PorCategoria` (quem PONTUOU) e não `TodasCategorias` (as que
               existem no banco). Com a régua de esconder quem tem zero, o segundo passou a
               mentir: havia 12 categorias cadastradas e ninguém pontuando, então a aba abria
               com um dropdown de categorias todas vazias e um "escolha uma categoria acima"
               que só levava a "sem resultados". As seis abas irmãs dizem, de cara, "Ainda não
               há resultados de torneio" — esta agora diz o mesmo. *@
            @if (!Model.PorCategoria.Any())
            {
                <partial name="_RankingVazio" />
            }
            else
            {
                @* ⚠️ Esta explicação é a régua de PontosDoTorneio escrita pra gente. Mudou lá,
                   muda aqui — até 10/08/2026 este parágrafo anunciava a tabela fixa antiga, e
                   uma tela que explica errado a conta do próprio ranking é pior que uma tela
                   calada. Espec em RANKING.md (Trilha B). *@
                <details class="small mb-3 rounded-3 p-2" style="background: var(--pdz-surface, #f8f9fa);">
                    <summary class="text-muted" style="cursor: pointer;">
                        <i class="bi bi-info-circle"></i> Como os pontos são calculados
                    </summary>
                    <div class="mt-2">
                        <p class="mb-2">
                            Os pontos da fase que você alcançou são
                            <strong>multiplicados pelo tamanho da categoria</strong> — chegar à semifinal
                            enfrentando 20 duplas é mais difícil do que enfrentando 5, e
                            <strong>até ser eliminado num campo grande vale mais</strong> do que num
                            pequeno.
                        </p>
                        <p class="mb-2">
                            <strong>Pontos por fase:</strong> Campeão 100 · Vice 60 · Semifinal 35 ·
                            Quartas 20 · Oitavas 15 · 16-avos 12 · Fase de grupos 10.
                        </p>
                        <p class="mb-2">
                            <strong>Multiplicador:</strong> 1,0× com 5 duplas na categoria, e
                            <strong>+0,1× a cada dupla a mais</strong> — 10 duplas = 1,5×, 20 duplas = 2,5×,
                            30 duplas = 3,5×, sem limite. Categoria com menos de 3 duplas paga todo mundo
                            igual (não dá pra fabricar título com 2 duplas).
                        </p>
                        <p class="mb-2">
                            <strong>O ponto só nasce quando o torneio começa.</strong> Estar inscrito num
                            torneio que ainda vai acontecer não vale ponto, e quem ficou na lista de espera
                            ou sem parceiro não entrou na chave — então também não pontua.
                        </p>
                        <p class="text-muted mb-0">
                            Exemplo: campeão numa categoria de 16 duplas faz 100 × 2,1 = <strong>210</strong>.
                            Numa de 5 duplas, faz <strong>100</strong>. E cair na fase de grupos entre
                            20 duplas vale <strong>25</strong>, contra 10 numa de 5.
                        </p>
                    </div>
                </details>

                <!-- Dropdown de categorias: escolher uma vira chip ao lado e some do dropdown -->
                <div class="d-flex align-items-center gap-2 flex-wrap mb-3">
                    <select id="pdzCatSelect" class="form-select form-select-sm" style="max-width: 280px;">
                        <option value="">— filtrar por categoria —</option>
                        @foreach (var nome in Model.TodasCategorias)
                        {
                            <option value="@nome">@nome</option>
                        }
                    </select>
                    <span id="pdzCatChipWrap" class="d-inline-flex gap-2 flex-wrap"></span>
                </div>

                <div id="pdzCatInicial" class="text-muted small mb-3"><i class="bi bi-arrow-up"></i> Escolha uma categoria acima para ver o ranking.</div>
                <div id="pdzCatVazio" class="text-center py-4 rounded-3 bg-light" style="border: 2px dashed var(--pdz-border);" hidden>
                    <i class="bi bi-inbox display-6 text-muted"></i>
                    <p class="text-muted mb-0">Sem resultados em <strong id="pdzCatVazioNome"></strong> ainda.</p>
                </div>

                @foreach (var cat in Model.PorCategoria)
                {
                    <div class="pdz-cat-panel" data-cat="@cat.Categoria" hidden>
                        <div class="card shadow-sm border-0"><div class="table-responsive"><table class="table table-hover align-middle mb-0">
                            @* No celular ficam só as colunas que respondem "quem está na frente":
                               posição, nome e pontos. Torneios e Mês somem abaixo de 576px —
                               com as sete, a tabela pedia 456px numa tela de 328 e a pessoa
                               tinha que arrastar de lado justo pra ver a coluna de pontos. *@
                            <thead><tr><th class="text-center" style="width:60px;">#</th><th>Jogador</th><th class="text-center">Títulos</th><th class="text-center d-none d-sm-table-cell">Vitórias</th><th class="text-center d-none d-sm-table-cell">Torneios</th><th class="text-end">Pontos</th><th class="text-center d-none d-sm-table-cell" style="width:64px;" title="Movimento no último mês">Mês</th></tr></thead>
                            <tbody>
                                @{ var pos = 1; }
                                @foreach (var l in cat.Linhas)
                                {
                                    <tr>
                                        <td class="text-center fw-bold">@Html.Raw(PosBadge(pos))</td>
                                        <td><a asp-action="Perfil" asp-route-id="@l.Jogador.Id" class="fw-bold text-decoration-none" style="color: var(--pdz-ink);">@l.Jogador.ComoChamar</a></td>
                                        <td class="text-center">@(l.Titulos > 0 ? Html.Raw($"<span class='text-warning fw-bold'><i class='bi bi-trophy-fill'></i> {l.Titulos}</span>") : Html.Raw("<span class='text-muted'>—</span>"))</td>
                                        <td class="text-center fw-bold text-success d-none d-sm-table-cell">@l.Vitorias</td>
                                        <td class="text-center text-muted d-none d-sm-table-cell">@l.Torneios</td>
                                        <td class="text-end fw-bold" style="color: var(--pdz-ink);">@l.Pontos</td>
                                        <td class="text-center d-none d-sm-table-cell">@Html.Raw(MovBadge(l.Movimento))</td>
                                    </tr>
                                    pos++;
                                }
                            </tbody>
                        </table></div></div>
                    </div>
                }
            }
        </div>

        @* ============================ 1b. PADELÍMETRO (a unidade é PDZ) ============================ *@
        <div class="tab-pane fade" id="tab-padelimetro" role="tabpanel">
            <p class="text-muted small mb-2">
                O <strong>Padelímetro</strong> é o nível do jogador, de 0 a 1000 <strong>PDZ</strong> — muda a cada jogo de torneio:
                sobe quando vence, desce quando perde, e vencer favorito vale mais. Ele nasce no primeiro jogo,
                e os 10 primeiros são de calibração (o número anda mais rápido até se encontrar).
            </p>
            @if (!Model.Padelimetro.Any())
            {
                <div class="text-center py-4 rounded-3 bg-light" style="border: 2px dashed var(--pdz-border);">
                    <i class="bi bi-speedometer2 display-6 text-muted"></i>
                    <p class="text-muted mb-0">Ninguém tem Padelímetro ainda — ele nasce no primeiro jogo de torneio.</p>
                </div>
            }
            else
            {
                <div class="card shadow-sm border-0"><div class="table-responsive"><table class="table table-hover align-middle mb-0">
                    @* No celular ficam as colunas que respondem "quem está na frente": posição, nome e PDZ. *@
                    <thead><tr>
                        <th class="text-center" style="width:60px;">#</th><th>Jogador</th>
                        <th class="text-center d-none d-sm-table-cell">Faixa</th>
                        <th class="text-center d-none d-sm-table-cell">Jogos</th>
                        <th class="text-end">PDZ</th>
                    </tr></thead>
                    <tbody>
                        @{ var posPdz = 1; }
                        @foreach (var l in Model.Padelimetro)
                        {
                            <tr>
                                <td class="text-center fw-bold">@Html.Raw(PosBadge(posPdz))</td>
                                <td>
                                    <a asp-action="Perfil" asp-route-id="@l.Jogador.Id" class="fw-bold text-decoration-none" style="color: var(--pdz-ink);">@l.Jogador.ComoChamar</a>
                                    @if (l.EmCalibracao)
                                    {
                                        <span class="badge bg-secondary ms-1" title="Primeiros 10 jogos: o número anda mais rápido até se encontrar (@l.Jogos de 10).">em calibração</span>
                                    }
                                </td>
                                <td class="text-center d-none d-sm-table-cell">
                                    @if (l.FaixaRotulo != null)
                                    {
                                        <span class="badge rounded-pill bg-light text-dark border"
                                              title="Faixa da @l.FaixaRotulo na escada @l.FaixaEscada">@l.FaixaRotulo@(l.FaixaEscada == "feminina" ? " fem" : "")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="text-center text-muted d-none d-sm-table-cell">@l.Jogos</td>
                                <td class="text-end fw-bold" style="color: var(--pdz-ink);">@l.Pdz <span class="text-muted small fw-normal">PDZ</span></td>
                            </tr>
                            posPdz++;
                        }
                    </tbody>
                </table></div></div>
            }
        </div>

        @* ============================ 1c. RANKING AMERICANO ============================
           Ranking PRÓPRIO, e a tela precisa dizer isso na primeira linha: quem chega aqui
           vindo do ranking oficial vai perguntar por que os números não batem. *@
        <div class="tab-pane fade" id="tab-americano" role="tabpanel">
            <p class="text-muted small mb-2">
                Ranking <strong>só de Americano</strong> — separado do oficial, que é de torneio de chave.
                Pontua por <strong>colocação</strong>, e vale mais quanto mais gente em quadra:
                ganhar um Americano de 16 vale o dobro de ganhar um de 8.
                Só entram os Americanos que o organizador inscreveu no ranking, a partir de
                @Padelizou.Services.PontosDoAmericano.MinimoParaPontuar participantes.
            </p>
            @* ⚠️ DOIS rankings, não um. No Americano individual o parceiro troca a cada rodada
               e o que sobra é o seu jogo; no de duplas a dupla é fixa, e metade do resultado é
               do parceiro que você escolheu. Numa lista só, os dois números pareceriam a mesma
               medida — e o de duplas premiaria quem escolheu bem, não quem jogou melhor. *@
            <ul class="nav nav-pills nav-sm mb-3" role="tablist">
                <li class="nav-item">
                    <button class="nav-link active" data-bs-toggle="pill" data-bs-target="#sub-am-individual" type="button">
                        <i class="bi bi-person me-1"></i> Individual
                        <span class="badge bg-light text-dark ms-1">@Model.AmericanoIndividual.Count</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link" data-bs-toggle="pill" data-bs-target="#sub-am-duplas" type="button">
                        <i class="bi bi-people me-1"></i> Em duplas
                        <span class="badge bg-light text-dark ms-1">@Model.AmericanoDuplas.Count</span>
                    </button>
                </li>
            </ul>

            <div class="tab-content">
                <div class="tab-pane fade show active" id="sub-am-individual" role="tabpanel">
                    <p class="text-muted small mb-2">
                        <i class="bi bi-person"></i> Parceiro trocando a cada rodada — o resultado é
                        <strong>seu</strong>.
                    </p>
                    <partial name="_TabelaRankingAmericano" model="Model.AmericanoIndividual" />
                </div>
                <div class="tab-pane fade" id="sub-am-duplas" role="tabpanel">
                    <p class="text-muted small mb-2">
                        <i class="bi bi-people"></i> Dupla fixa do começo ao fim — a colocação é
                        <strong>da dupla</strong>, e os dois levam os mesmos pontos.
                    </p>
                    <partial name="_TabelaRankingAmericano" model="Model.AmericanoDuplas" />
                </div>
            </div>
        </div>

        @* ============================ 2. TROFÉUS POR CATEGORIA ============================ *@
        <div class="tab-pane fade" id="tab-trofeus" role="tabpanel">
            @Html.Raw(SeletorPeriodo(Model, "#tab-trofeus"))
            @if (!Model.TrofeusPorCategoria.Any())
            {
                <partial name="_RankingVazio" />
            }
            else
            {
                <ul class="nav nav-pills flex-nowrap overflow-auto pb-2 mb-3" role="tablist" style="white-space: nowrap;">
                    @for (var i = 0; i < Model.TrofeusPorCategoria.Count; i++)
                    {
                        <li class="nav-item me-2"><button class="nav-link rounded-pill @(i == 0 ? "active" : "")" data-bs-toggle="pill" data-bs-target="#trf-@i" type="button">@Model.TrofeusPorCategoria[i].Categoria</button></li>
                    }
                </ul>
                <div class="tab-content">
                    @for (var i = 0; i < Model.TrofeusPorCategoria.Count; i++)
                    {
                        var cat = Model.TrofeusPorCategoria[i];
                        <div class="tab-pane fade @(i == 0 ? "show active" : "")" id="trf-@i" role="tabpanel">
                            <div class="card shadow-sm border-0"><div class="table-responsive"><table class="table table-hover align-middle mb-0">
                                <thead><tr><th class="text-center" style="width:60px;">#</th><th>Jogador</th><th class="text-center">Títulos</th><th class="text-center">Finais</th></tr></thead>
                                <tbody>
                                    @{ var pos = 1; }
                                    @foreach (var l in cat.Linhas)
                                    {
                                        <tr>
                                            <td class="text-center fw-bold">@Html.Raw(PosBadge(pos))</td>
                                            <td><a asp-action="Perfil" asp-route-id="@l.Jogador.Id" class="fw-bold text-decoration-none" style="color: var(--pdz-ink);">@l.Jogador.ComoChamar</a></td>
                                            <td class="text-center"><span class="text-warning fw-bold"><i class="bi bi-trophy-fill"></i> @l.Titulos</span></td>
                                            <td class="text-center text-muted">@l.Finais</td>
                                        </tr>
                                        pos++;
                                    }
                                </tbody>
                            </table></div></div>
                        </div>
                    }
                </div>
            }
        </div>

        @* ============================ 3+4. VITÓRIAS — JOGADORES ============================ *@
        <div class="tab-pane fade" id="tab-vjog" role="tabpanel">
            @Html.Raw(SeletorPeriodo(Model, "#tab-vjog"))
            @if (!Model.VitoriasJogadores.Any())
            {
                <partial name="_RankingVazio" />
            }
            else
            {
                <h5 class="fw-bold mb-2"><i class="bi bi-globe2 text-secondary"></i> Geral (todas as categorias)</h5>
                <div class="card shadow-sm border-0 mb-4"><div class="table-responsive"><table class="table table-hover align-middle mb-0">
                    <thead><tr><th class="text-center" style="width:60px;">#</th><th>Jogador</th><th class="text-center">Vitórias</th><th class="text-center">Jogos</th><th class="text-end pe-3">Aproveit.</th></tr></thead>
                    <tbody>
                        @{ var posG = 1; }
                        @foreach (var j in Model.VitoriasJogadores)
                        {
                            <tr>
                                <td class="text-center fw-bold">@Html.Raw(PosBadge(posG))</td>
                                <td><a asp-action="Perfil" asp-route-id="@j.Jogador.Id" class="fw-bold text-decoration-none" style="color: var(--pdz-ink);">@j.Jogador.ComoChamar</a></td>
                                <td class="text-center fw-bold text-success">@j.Vitorias</td>
                                <td class="text-center text-muted">@j.Jogos</td>
                                <td class="text-end pe-3">@(j.Jogos > 0 ? $"{(100.0 * j.Vitorias / j.Jogos):0}%" : "—")</td>
                            </tr>
                            posG++;
                        }
                    </tbody>
                </table></div></div>

                <h5 class="fw-bold mb-2"><i class="bi bi-diagram-3-fill text-secondary"></i> Por categoria</h5>
                <ul class="nav nav-pills flex-nowrap overflow-auto pb-2 mb-3" role="tablist" style="white-space: nowrap;">
                    @for (var i = 0; i < Model.VitoriasJogadoresPorCategoria.Count; i++)
                    {
                        <li class="nav-item me-2"><button class="nav-link rounded-pill @(i == 0 ? "active" : "")" data-bs-toggle="pill" data-bs-target="#vjc-@i" type="button">@Model.VitoriasJogadoresPorCategoria[i].Categoria</button></li>
                    }
                </ul>
                <div class="tab-content">
                    @for (var i = 0; i < Model.VitoriasJogadoresPorCategoria.Count; i++)
                    {
                        var cat = Model.VitoriasJogadoresPorCategoria[i];
                        <div class="tab-pane fade @(i == 0 ? "show active" : "")" id="vjc-@i" role="tabpanel">
                            <div class="card shadow-sm border-0"><div class="table-responsive"><table class="table table-hover align-middle mb-0">
                                <thead><tr><th class="text-center" style="width:60px;">#</th><th>Jogador</th><th class="text-center">Vitórias</th><th class="text-center">Jogos</th></tr></thead>
                                <tbody>
                                    @{ var pos = 1; }
                                    @foreach (var j in cat.Jogadores)
                                    {
                                        <tr>
                                            <td class="text-center fw-bold">@Html.Raw(PosBadge(pos))</td>
                                            <td><a asp-action="Perfil" asp-route-id="@j.Jogador.Id" class="fw-bold text-decoration-none" style="color: var(--pdz-ink);">@j.Jogador.ComoChamar</a></td>
                                            <td class="text-center fw-bold text-success">@j.Vitorias</td>
                                            <td class="text-center text-muted">@j.Jogos</td>
                                        </tr>
                                        pos++;
                                    }
                                </tbody>
                            </table></div></div>
                        </div>
                    }
                </div>
            }
        </div>

        @* ============================ 6+7. VITÓRIAS — DUPLAS ============================ *@
        <div class="tab-pane fade" id="tab-vdup" role="tabpanel">
            @Html.Raw(SeletorPeriodo(Model, "#tab-vdup"))
            @if (!Model.VitoriasDuplas.Any())
            {
                <partial name="_RankingVazio" />
            }
            else
            {
                <p class="text-muted small mb-2">Cada dupla é uma inscrição em um torneio/categoria (a mesma parceria em torneios diferentes conta separado).</p>
                <h5 class="fw-bold mb-2"><i class="bi bi-globe2 text-secondary"></i> Geral</h5>
                <div class="card shadow-sm border-0 mb-4"><div class="table-responsive"><table class="table table-hover align-middle mb-0">
                    <thead><tr><th class="text-center" style="width:60px;">#</th><th>Dupla</th><th>Categoria / Torneio</th><th class="text-center">Vitórias</th><th class="text-center">Jogos</th></tr></thead>
                    <tbody>
                        @{ var posG = 1; }
                        @foreach (var d in Model.VitoriasDuplas)
                        {
                            <tr>
                                <td class="text-center fw-bold">@Html.Raw(PosBadge(posG))</td>
                                <td>@Html.Raw(NomesDaDupla(d.Jogador1, d.Jogador2))</td>
                                <td class="small text-muted">@d.Categoria<br><span class="text-secondary">@d.Torneio</span></td>
                                <td class="text-center fw-bold text-success">@d.Vitorias</td>
                                <td class="text-center text-muted">@d.Jogos</td>
                            </tr>
                            posG++;
                        }
