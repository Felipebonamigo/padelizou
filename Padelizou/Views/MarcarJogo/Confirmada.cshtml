@model MarcacaoJogo
@{
    ViewData["Title"] = "Horário Marcado - Padelizou";
}

<div class="container mt-4 mb-5" style="max-width: 560px;">
    <div class="card shadow-sm border-0 text-center">
        <div class="card-body py-5">
            <i class="bi bi-check-circle-fill text-success display-3 mb-3"></i>
            <h3 class="fw-bold" style="color: var(--pdz-ink);">Horário marcado!</h3>
            <p class="text-muted mb-0">
                @Model.Clube.Nome — @Model.QuadraClube.Nome<br />
                @Model.DataHora.ToString("dddd, dd/MM 'às' HH:mm")
            </p>

            <hr class="my-4" />

            <h5 class="fw-bold mb-3">Quer convidar alguém da lista de jogadores?</h5>
            <div class="d-flex justify-content-center gap-3 flex-wrap">
                <a asp-controller="MarcarJogo" asp-action="Convidar" asp-route-marcacaoId="@Model.Id" class="btn btn-padel rounded-pill px-4">
                    Sim, quero convidar
                </a>
                <a asp-controller="MarcarJogo" asp-action="MinhasMarcacoes" class="btn btn-outline-secondary rounded-pill px-4">
                    Não, já tenho minha galera
                </a>
            </div>
        </div>
    </div>
</div>
