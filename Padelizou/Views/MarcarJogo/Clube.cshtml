@using Padelizou.Services
@{
    ViewData["Title"] = "Marcar Jogo - Padelizou";
    var clube = (Clube)ViewBag.Clube;
    var data = (DateTime)ViewBag.Data;
    var slots = (List<SlotMarcacao>)ViewBag.Slots;
    string[] diasSemana = { "Domingo", "Segunda", "Terça", "Quarta", "Quinta", "Sexta", "Sábado" };
    var grupos = slots
        .GroupBy(s => new { s.QuadraClubeId, s.QuadraNome })
        .OrderBy(g => g.Key.QuadraClubeId)
        .ToList();
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold" style="color: var(--pdz-ink);">@clube.Nome</h2>
            <p class="text-muted mb-0">Escolha a quadra e o horário pra marcar.</p>
        </div>
        <a asp-controller="MarcarJogo" asp-action="Index" class="btn btn-outline-secondary rounded-pill">Voltar</a>
    </div>

    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success">@TempData["Sucesso"]</div>
    }
    @if (TempData["Erro"] != null)
    {
        <div class="alert alert-danger">@TempData["Erro"]</div>
    }

    <div class="pdz-day-nav d-flex justify-content-between align-items-center mb-4">
        <a asp-controller="MarcarJogo" asp-action="Clube" asp-route-clubeId="@clube.Id" asp-route-data="@data.AddDays(-1).ToString("yyyy-MM-dd")"
           class="btn btn-sm btn-outline-secondary rounded-pill @(data.Date <= DateTime.Today ? "disabled" : "")">
            <i class="bi bi-chevron-left"></i> Dia anterior
        </a>
        <h5 class="fw-bold mb-0" style="color: var(--pdz-ink);">@diasSemana[(int)data.DayOfWeek], @data.ToString("dd/MM/yyyy")</h5>
        <a asp-controller="MarcarJogo" asp-action="Clube" asp-route-clubeId="@clube.Id" asp-route-data="@data.AddDays(1).ToString("yyyy-MM-dd")"
           class="btn btn-sm btn-outline-secondary rounded-pill">
            Próximo dia <i class="bi bi-chevron-right"></i>
        </a>
    </div>

    @if (grupos.Any())
    {
        var i = 0;
        foreach (var grupo in grupos)
        {
            <div class="card border-0 shadow-sm rounded-4 mb-3 pdz-quadra-card">
                <div class="card-body">
                    <h5 class="fw-bold mb-3 d-flex align-items-center gap-2" style="color: var(--pdz-ink);">
                        <i class="bi bi-grid-3x3-gap-fill" style="color: var(--pdz-lime-600);"></i>
                        @grupo.Key.QuadraNome
                        <span class="badge rounded-pill text-bg-light fw-normal small ms-1">@grupo.Count() horário@(grupo.Count() > 1 ? "s" : "")</span>
                    </h5>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var slot in grupo.OrderBy(s => s.Inicio))
                        {
                            i++;
                            var formId = $"form-slot-{i}";
                            // Mostra sempre o valor final: o jogador não pode ver R$ 80 no chip
                            // e ser cobrado R$ 88 no checkout.
                            var valorFinal = slot.PrecoTotal ?? slot.Preco;
                            var precoTexto = valorFinal > 0 ? valorFinal.Value.ToString("C") : "";
                            var quadraTexto = slot.Preco > 0 ? slot.Preco.Value.ToString("C") : "";
                            var taxaTexto = slot.TaxaServico > 0 ? slot.TaxaServico.Value.ToString("C") : "";
                            <button type="button" class="btn btn-outline-primary rounded-pill pdz-slot-chip"
                                    data-bs-toggle="modal" data-bs-target="#modalConfirmarMarcacao"
                                    data-form-id="@formId"
                                    data-quadra="@grupo.Key.QuadraNome"
                                    data-hora="@slot.Inicio.ToString("HH:mm")"
                                    data-preco="@precoTexto"
                                    data-preco-quadra="@quadraTexto"
                                    data-taxa="@taxaTexto">
                                <span class="fw-semibold">@slot.Inicio.ToString("HH:mm")</span>
                                @if (valorFinal > 0)
                                {
                                    <span class="pdz-slot-chip-preco">@precoTexto</span>
                                }
                            </button>
                            <form id="@formId" asp-controller="MarcarJogo" asp-action="Marcar" method="post" class="d-none">
                                <input type="hidden" name="clubeId" value="@clube.Id" />
                                <input type="hidden" name="quadraClubeId" value="@slot.QuadraClubeId" />
                                <input type="hidden" name="dataHora" value="@slot.Inicio.ToString("yyyy-MM-ddTHH:mm:ss")" />
                                <input type="hidden" name="duracaoMinutos" value="@((slot.Fim - slot.Inicio).TotalMinutes)" />
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="text-center py-5 rounded-3 bg-light" style="border: 2px dashed #ccc;">
            <i class="bi bi-calendar-x display-4 text-muted mb-3"></i>
            <h5 class="fw-bold text-secondary">Nenhum horário livre nesse dia</h5>
        </div>
    }
</div>

<div class="modal fade" id="modalConfirmarMarcacao" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="bi bi-calendar-check"></i> Confirmar marcação</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex justify-content-between py-2 border-bottom">
                    <span class="text-muted">Quadra</span>
                    <strong id="mcmQuadra"></strong>
                </div>
                <div class="d-flex justify-content-between py-2 border-bottom">
                    <span class="text-muted">Horário</span>
                    <strong id="mcmHora"></strong>
                </div>
                <div class="d-flex justify-content-between py-2 border-bottom" id="mcmQuadraValorLinha">
                    <span class="text-muted">Quadra</span>
                    <span id="mcmPrecoQuadra"></span>
                </div>
                <div class="d-flex justify-content-between py-2 border-bottom" id="mcmTaxaLinha">
                    <span class="text-muted">Taxa de serviço</span>
                    <span id="mcmTaxa"></span>
                </div>
                <div class="d-flex justify-content-between py-2" id="mcmPrecoLinha">
                    <span class="fw-semibold">Total a pagar</span>
                    <strong id="mcmPreco" class="fs-5"></strong>
                </div>
                <p class="small text-muted mt-3 mb-0" id="mcmAvisoPagamento">
                    <i class="bi bi-credit-card"></i> Depois de confirmar você vai pra tela de pagamento —
                    o valor cobrado é exatamente esse.
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary rounded-pill" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-padel rounded-pill" id="mcmConfirmarBtn">Confirmar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var modalEl = document.getElementById('modalConfirmarMarcacao');
            var formIdAtual = null;

            modalEl.addEventListener('show.bs.modal', function (ev) {
                var btn = ev.relatedTarget;
                formIdAtual = btn.dataset.formId;
                document.getElementById('mcmQuadra').textContent = btn.dataset.quadra;
                document.getElementById('mcmHora').textContent = btn.dataset.hora;

                var preco = btn.dataset.preco;
                var taxa = btn.dataset.taxa;
                var temPreco = !!preco;

                document.getElementById('mcmPreco').textContent = preco;
                document.getElementById('mcmPrecoQuadra').textContent = btn.dataset.precoQuadra;
                document.getElementById('mcmTaxa').textContent = taxa;

                document.getElementById('mcmPrecoLinha').classList.toggle('d-none', !temPreco);
                document.getElementById('mcmAvisoPagamento').classList.toggle('d-none', !temPreco);

                // A composição só faz sentido quando existe taxa; sem ela o total já é o
                // preço da quadra e repetir a linha só confunde.
                var temTaxa = !!taxa;
                document.getElementById('mcmQuadraValorLinha').classList.toggle('d-none', !temTaxa);
                document.getElementById('mcmTaxaLinha').classList.toggle('d-none', !temTaxa);
            });

            document.getElementById('mcmConfirmarBtn').addEventListener('click', function () {
                if (formIdAtual) {
                    document.getElementById(formIdAtual).submit();
                }
            });
        })();
    </script>
}
