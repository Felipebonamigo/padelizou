@model List<MarcacaoJogo>
@{
    ViewData["Title"] = "Minhas Marcações - Padelizou";
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold" style="color: var(--pdz-ink);">Minhas Marcações</h2>
            <p class="text-muted mb-0">Horários de quadra que você marcou.</p>
        </div>
        <a asp-controller="MarcarJogo" asp-action="Index" class="btn btn-outline-secondary rounded-pill">Voltar</a>
    </div>

    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success">@TempData["Sucesso"]</div>
    }

    @if (Model.Any())
    {
        <div class="list-group shadow-sm">
            @foreach (var m in Model)
            {
                <div class="list-group-item d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <h6 class="mb-0 fw-bold" style="color: var(--pdz-ink);">@m.Clube.Nome — @m.QuadraClube.Nome</h6>
                        <span class="text-muted small">@m.DataHora.ToString("dd/MM/yyyy 'às' HH:mm") (@m.DuracaoMinutos min)</span>
                    </div>
                    @if (m.DataHora > DateTime.Now)
                    {
                        <form asp-controller="MarcarJogo" asp-action="Cancelar" method="post"
                              onsubmit="return confirm('Cancelar essa marcação?');">
                            <input type="hidden" name="id" value="@m.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Cancelar</button>
                        </form>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <div class="col-12">
            <partial name="_Vazio" model='@(new EstadoVazio("Nenhuma marcação ainda.", "Ver clubes disponíveis", "MarcarJogo", "Index"))' />
        </div>
    }
</div>
