@model Padelizou.ViewModels.PainelProfessorViewModel
@{
    ViewData["Title"] = "Painel do Professor - Padelizou";
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold" style="color: var(--pdz-ink);">Painel do Professor</h2>
            <p class="text-muted mb-0">Sua visão geral: alunos, locais, agenda e financeiro.</p>
        </div>
        <a asp-controller="Auth" asp-action="Perfil" class="btn btn-outline-secondary rounded-pill">Voltar ao Perfil</a>
    </div>

    @*
        Sem cidade OU sem local, o professor NÃO APARECE na tela de marcar aula — o aluno abre a
        página, o primeiro seletor vem vazio e não há como seguir. Isso já valia pra 7 professores
        de 7 nos três ambientes: ninguém tinha cidade, e portanto ninguém no site inteiro
        conseguia marcar uma aula.

        Já existia um "você ainda não cadastrou cidades" no meio da página. Não bastou, e dá pra
        entender: informava o fato e não a consequência. Quem lê "não cadastrei cidades" pensa
        "depois eu vejo"; quem lê "nenhum aluno consegue te achar" vai lá agora.
    *@
    @{
        var semCidade = !Model.MinhasCidades.Any();
        var semLocal = !Model.Locais.Any();
    }
    @if (semCidade || semLocal)
    {
        <div class="alert alert-warning border-0 shadow-sm d-flex flex-wrap gap-3 align-items-center mb-4">
            <div class="flex-grow-1">
                <div class="fw-bold mb-1">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i>
                    Nenhum aluno consegue te achar ainda
                </div>
                @{
                    // Montado como texto, não como blocos soltos no meio da frase: com @if inline
                    // o Razor deixa a quebra de linha virar espaço, e saía "cidade e local ,".
                    var oQueFalta = semCidade && semLocal ? "cidade e local"
                                  : semCidade ? "a cidade"
                                  : "o local";
                }
                <div class="small mb-0">
                    A tela de marcar aula pergunta primeiro a cidade, depois o professor, depois o local.
                    Faltando <strong>@oQueFalta</strong>, você não entra nessa lista — e o aluno nem
                    chega a ver seu nome.
                </div>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                @if (semCidade)
                {
                    <a asp-controller="Aulas" asp-action="MinhasCidades" class="btn btn-sm btn-padel rounded-pill px-3 fw-bold">
                        <i class="bi bi-pin-map me-1"></i> Definir cidade
                    </a>
                }
                @if (semLocal)
                {
                    <a asp-controller="Aulas" asp-action="MeusLocais" class="btn btn-sm btn-padel rounded-pill px-3 fw-bold">
                        <i class="bi bi-geo-alt me-1"></i> Cadastrar local
                    </a>
                }
            </div>
        </div>
    }

    @* O plano só grita quando pede decisão: em teste (o relógio corre) ou em atraso (a taxa
       subiu). Em dia/avulso, vira só um link discreto no fim da página. *@
    @if (ViewBag.SituacaoPlano is Padelizou.Services.PlanoDoProfessor.Situacao situacaoPlano)
    {
        if (situacaoPlano == Padelizou.Services.PlanoDoProfessor.Situacao.EmTeste
            && ViewBag.FimDoTestePlano is DateTime fimTeste)
        {
            var diasTeste = Math.Max(0, (int)Math.Ceiling((fimTeste - DateTime.Now).TotalDays));
            <div class="alert alert-info border-0 shadow-sm d-flex flex-wrap gap-3 align-items-center mb-4">
                <div class="flex-grow-1">
                    <div class="fw-bold mb-1"><i class="bi bi-stars me-1"></i> Você está no período de teste do plano</div>
                    <div class="small mb-0">
                        Condições de Assinante sem mensalidade por mais
                        <strong>@diasTeste @(diasTeste == 1 ? "dia" : "dias")</strong> — depois disso,
                        escolha entre Assinante e Avulso.
                    </div>
                </div>
                <a asp-controller="PlanoProfessor" asp-action="Index" class="btn btn-sm btn-padel rounded-pill px-3 fw-bold">
                    Ver os planos
                </a>
            </div>
        }
        else if (situacaoPlano == Padelizou.Services.PlanoDoProfessor.Situacao.AssinanteEmAtraso)
        {
            <div class="alert alert-warning border-0 shadow-sm d-flex flex-wrap gap-3 align-items-center mb-4">
                <div class="flex-grow-1">
                    <div class="fw-bold mb-1"><i class="bi bi-exclamation-triangle-fill me-1"></i> Sua mensalidade está em aberto</div>
                    <div class="small mb-0">Enquanto ela não entra, suas aulas voltam pra taxa cheia.</div>
                </div>
                <a asp-controller="PlanoProfessor" asp-action="Index" class="btn btn-sm btn-warning rounded-pill px-3 fw-bold">
                    Regularizar
                </a>
            </div>
        }
    }

    <div class="row mb-4">
        <div class="col-sm-6 col-lg-3 mb-3">
            <div class="card border-0 bg-light p-3 text-center h-100">
                <div class="fs-3 fw-bold" style="color: var(--pdz-ink);">@Model.TotalAlunosAtivos</div>
                <div class="small text-muted">Alunos</div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3 mb-3">
            <div class="card border-0 bg-light p-3 text-center h-100">
                <div class="fs-3 fw-bold" style="color: var(--pdz-ink);">@Model.AulasEstaSemana</div>
                <div class="small text-muted">Aulas essa semana</div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3 mb-3">
            <div class="card border-0 p-3 text-center h-100 pdz-tinta-ambar">
                <div class="fs-3 fw-bold text-warning">@Model.AulasPendentes</div>
                <div class="small text-muted">Aguardando aceite</div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3 mb-3">
            <div class="card border-0 p-3 text-center h-100 pdz-tinta-verde">
                <div class="fs-3 fw-bold text-success">@Model.FinanceiroMesAtual.TotalRecebido.ToString("C")</div>
                <div class="small text-muted">
                    Ganho no mês
                    @if (Model.FinanceiroMesAtual.TotalGasto.HasValue)
                    {
                        <span class="text-danger d-block">Gasto: @Model.FinanceiroMesAtual.TotalGasto.Value.ToString("C")</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2 flex-wrap mb-4">
        <a asp-controller="Aulas" asp-action="AdicionarManual" class="btn btn-padel rounded-pill btn-sm">
            <i class="bi bi-plus-lg"></i> Adicionar Aula
        </a>
        <a asp-controller="Aulas" asp-action="MinhaAgenda" class="btn btn-outline-primary rounded-pill btn-sm">
            <i class="bi bi-calendar3"></i> Minha Agenda
        </a>
        @* A lista de alunos existia só dentro do autocompletar de "Adicionar aula", onde some
           assim que o professor escolhe um nome. Aqui ela vira lugar de olhar: quem já voltou,
           quem tem conta, quem dá pra chamar no WhatsApp. *@
        <a asp-controller="Aulas" asp-action="MeusAlunos" class="btn btn-outline-primary rounded-pill btn-sm">
            <i class="bi bi-people"></i> Meus alunos
        </a>
        <a asp-controller="Aulas" asp-action="Financeiro" class="btn btn-padel rounded-pill btn-sm fw-bold">
            <i class="bi bi-cash-coin"></i> Meu financeiro
        </a>
        @* Quem cobra por mês fecha aqui. Fica ao lado do financeiro de propósito: um responde
           "quanto entrou", o outro "quanto eu vou cobrar de quem". *@
        <a asp-controller="Aulas" asp-action="Faturamento" class="btn btn-outline-primary rounded-pill btn-sm">
            <i class="bi bi-receipt"></i> Fechar o mês
        </a>
        <a asp-controller="Professores" asp-action="Perfil" asp-route-id="@ViewBag.ProfessorId" class="btn btn-outline-primary rounded-pill btn-sm">
            <i class="bi bi-person-badge"></i> Minha página pública
        </a>
        <a asp-controller="Aulas" asp-action="Avaliacoes" class="btn btn-outline-primary rounded-pill btn-sm">
            <i class="bi bi-clipboard-check"></i> Avaliação dos alunos
        </a>
        <a asp-controller="Aulas" asp-action="MeusLocais" class="btn btn-outline-primary rounded-pill btn-sm">
            <i class="bi bi-geo-alt"></i> Meus Locais
        </a>
        <a asp-controller="Aulas" asp-action="MeusHorarios" class="btn btn-outline-primary rounded-pill btn-sm">
            <i class="bi bi-clock"></i> Meus Horários
        </a>
        <a asp-controller="Aulas" asp-action="MinhasCidades" class="btn btn-outline-primary rounded-pill btn-sm">
            <i class="bi bi-pin-map"></i> Minhas Cidades
        </a>
        <a asp-controller="Aulas" asp-action="Relatorio" class="btn btn-outline-primary rounded-pill btn-sm">
            <i class="bi bi-graph-up"></i> Relatório completo
        </a>
        <a asp-controller="JogoAula" asp-action="Publicar" class="btn btn-outline-primary rounded-pill btn-sm">
            <i class="bi bi-megaphone"></i> Publicar Jogo Aula
        </a>
        <a asp-controller="PlanoProfessor" asp-action="Index" class="btn btn-outline-primary rounded-pill btn-sm">
            <i class="bi bi-award"></i> Meu Plano
        </a>
    </div>

@{
    var professorLogado = ViewBag.Professor as Padelizou.Models.Jogador;
}
@if (professorLogado != null)
{
    <!-- POLÍTICA DE CANCELAMENTO -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center" data-bs-toggle="collapse" data-bs-target="#politicaBox" style="cursor:pointer;">
                <h6 class="fw-bold mb-0" style="color: var(--pdz-ink);">
                    <i class="bi bi-shield-check"></i> Política de cancelamento
                </h6>
                <i class="bi bi-chevron-down"></i>
            </div>
            <p class="small text-muted mb-0 mt-2">
                @Padelizou.Services.PoliticaAula.DescreverPolitica(professorLogado)
            </p>

            <div class="collapse mt-3" id="politicaBox">
                <form asp-action="SalvarPolitica" method="post">
                    <div class="row g-2 align-items-end">
                        <div class="col-6 col-md-3">
                            <label class="form-label small fw-bold text-muted mb-1">Avisar com quantas horas?</label>
                            <input type="number" name="horasMinimas" min="0" max="168" class="form-control"
                                   value="@professorLogado.HorasMinimasCancelamento" />
                        </div>
                        <div class="col-6 col-md-4">
                            <div class="form-check form-switch mt-3">
                                <input class="form-check-input" type="checkbox" name="cobraFaltaSemAviso" value="true"
                                       id="cobraFalta" @(professorLogado.CobraFaltaSemAviso ? "checked" : "")>
                                <label class="form-check-label small" for="cobraFalta">Cobro falta sem aviso</label>
                            </div>
                        </div>
                        <div class="col-12 col-md-5">
                            <label class="form-label small fw-bold text-muted mb-1">Texto pro aluno (opcional)</label>
                            <input type="text" name="textoPolitica" class="form-control"
                                   placeholder="Escreva do seu jeito..." value="@professorLogado.PoliticaCancelamentoTexto" />
                        </div>
                    </div>
                    <button type="submit" class="btn btn-sm btn-padel rounded-pill px-4 mt-2">Salvar política</button>
                    <small class="d-block text-muted mt-2">
                        0 horas = pode desmarcar até a última hora. O aluno vê essa regra na sua página pública.
                    </small>
                </form>
            </div>
        </div>
    </div>
}

    <div class="row">
        <div class="col-lg-6 mb-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h5 class="fw-bold text-muted mb-3"><i class="bi bi-people"></i> Alunos</h5>

                    @if (TempData["SucessoPrecoAluno"] != null)
                    {
                        <div class="alert alert-success border-0 py-2 small">
                            <i class="bi bi-check-circle-fill me-1"></i> @TempData["SucessoPrecoAluno"]
                        </div>
                    }
                    @if (TempData["ErroPrecoAluno"] != null)
                    {
                        <div class="alert alert-warning border-0 py-2 small">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i> @TempData["ErroPrecoAluno"]
                        </div>
                    }

                    @if (Model.Alunos.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle">
                                <thead>
                                    @* No celular a data da ÚLTIMA aula sai da coluna e vira uma
                                       linha embaixo do nome: o que o professor procura aqui é
                                       quando é a PRÓXIMA. *@
                                    <tr>
                                        <th>Nome</th>
                                        <th class="text-center">Aulas</th>
                                        <th class="d-none d-sm-table-cell">Última aula</th>
                                        <th>Próxima</th>
                                        <th class="d-none d-md-table-cell">Quem paga</th>
                                        <th class="text-end">Preço</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @* A posição na lista, e não o nome nem o id do aluno, é o que
                                       dá o id do formulário: aluno avulso não tem id, e hash de
                                       nome pode repetir — dois alunos diferentes abririam e
                                       fechariam o mesmo campo de preço. *@
                                    @for (var i = 0; i < Model.Alunos.Count; i++)
                                    {
                                        var aluno = Model.Alunos[i];
                                        var idFormulario = $"preco-aluno-{i}";
                                        var idCadastro = $"cadastro-aluno-{i}";
                                        <tr>
                                            <td>
                                                @aluno.Nome
                                                @* Quem foi marcado só pelo nome não vê nada no
                                                   próprio app. Quando cria conta, é aqui que o
                                                   professor junta o histórico à conta dela. *@
                                                @if (aluno.AlunoId == null && !string.IsNullOrWhiteSpace(aluno.NomeAvulso))
                                                {
                                                    <button type="button"
                                                            class="btn btn-sm btn-link p-0 ms-1 text-decoration-none small pdz-vincular"
                                                            data-nome="@aluno.NomeAvulso"
                                                            data-bs-toggle="collapse" data-bs-target="#vincular-@i"
                                                            title="Ligar as aulas dele a uma conta do Padelizou">
                                                        <i class="bi bi-link-45deg"></i> ligar a uma conta
                                                    </button>
                                                }
                                                @* O encontro entre o cadastro rápido e a campanha
                                                   de "se cadastrem certinho": a pessoa criou conta
                                                   com o mesmo celular que o professor anotou. Sem
                                                   isto ele nunca saberia, e a mesma pessoa ficaria
                                                   em dois lugares pra sempre. *@
                                                @if (aluno.ContaSugeridaId.HasValue)
                                                {
                                                    <div class="small mt-1">
                                                        <span class="badge text-bg-success-subtle text-success-emphasis">
                                                            <i class="bi bi-person-check"></i>
                                                            @aluno.ContaSugeridaNome criou conta com esse celular
                                                        </span>
                                                        <button type="button" class="btn btn-sm btn-link p-0 ms-1 text-decoration-none small"
                                                                data-bs-toggle="collapse" data-bs-target="#vincular-@i">
                                                            juntar o histórico
                                                        </button>
                                                    </div>
                                                }
                                                <div class="d-sm-none small text-muted">última: @aluno.UltimaAula.ToString("dd/MM/yy")</div>
                                            </td>
                                            <td class="text-center">@aluno.TotalAulas</td>
                                            <td class="small text-muted d-none d-sm-table-cell">@aluno.UltimaAula.ToString("dd/MM/yyyy")</td>
                                            <td class="small text-muted">@(aluno.ProximaAula.HasValue ? aluno.ProximaAula.Value.ToString("dd/MM/yy HH:mm") : "—")</td>

                                            @* Quem recebe a cobrança do mês. Vazio = ele mesmo,
                                               que é o caso normal — o responsável existe pra
                                               criança e pra quem tem a conta paga por outro. *@
                                            <td class="d-none d-md-table-cell">
                                                <button type="button" class="btn btn-sm btn-link p-0 text-decoration-none @(!string.IsNullOrWhiteSpace(aluno.ResponsavelNome) ? "fw-bold" : "text-muted")"
                                                        data-bs-toggle="collapse" data-bs-target="#@idCadastro">
                                                    @(!string.IsNullOrWhiteSpace(aluno.ResponsavelNome) ? aluno.ResponsavelNome : "ele mesmo")
                                                </button>
                                            </td>

                                            @*
                                                O acordo particular com este aluno. Existe porque
                                                é a regra e não a exceção: o aluno antigo que
                                                nunca teve reajuste, o filho do amigo, quem
                                                fechou o mês. Sem um lugar pra guardar, o
                                                professor corrigia o valor na mão em toda aula —
                                                e esquecia numa.
                                            *@
                                            <td class="text-end">
                                                <button type="button" class="btn btn-sm btn-link p-0 text-decoration-none @(aluno.PrecoCombinado.HasValue ? "fw-bold text-success" : "text-muted")"
                                                        data-bs-toggle="collapse" data-bs-target="#@idFormulario">
                                                    @(aluno.PrecoCombinado.HasValue ? aluno.PrecoCombinado.Value.ToString("C") : "tabela")
                                                </button>
                                            </td>
                                        </tr>
                                        <tr class="collapse" id="@idFormulario">
                                            <td colspan="6" class="bg-light">
                                                <form asp-controller="Aulas" asp-action="SalvarPrecoDeAluno" method="post"
                                                      class="row g-2 align-items-end py-2">
                                                    <input type="hidden" name="alunoId" value="@aluno.AlunoId" />
                                                    <input type="hidden" name="nomeAvulso" value="@aluno.NomeAvulso" />
                                                    <div class="col-6 col-md-3">
                                                        <label class="form-label small text-muted mb-0">Preço combinado</label>
                                                        <input type="number" step="0.01" min="0" name="preco" required
                                                               value="@aluno.PrecoCombinado" class="form-control form-control-sm" placeholder="R$" />
                                                    </div>
                                                    <div class="col-6 col-md-5">
                                                        <label class="form-label small text-muted mb-0">Por quê (opcional)</label>
                                                        <input type="text" name="observacao" maxlength="200"
                                                               class="form-control form-control-sm" placeholder="aluno desde 2019" />
                                                    </div>
                                                    <div class="col-md-4 d-flex gap-1">
                                                        <button type="submit" class="btn btn-sm btn-padel flex-grow-1">Salvar</button>
                                                    </div>
                                                    <div class="col-12">
                                                        <small class="text-muted">
                                                            Vale na aula individual dele. Em dupla ou trio, manda o preço do local pro tamanho.
                                                        </small>
                                                    </div>
                                                </form>
                                                @if (aluno.PrecoCombinadoId.HasValue)
                                                {
                                                    <form asp-controller="Aulas" asp-action="RemoverPrecoDeAluno" method="post" class="pb-2"
                                                          onsubmit="return confirm('Tirar o acordo? Esse aluno volta a pagar o preço do local.');">
                                                        <input type="hidden" name="id" value="@aluno.PrecoCombinadoId" />
                                                        <button type="submit" class="btn btn-sm btn-link text-danger p-0 text-decoration-none">
                                                            <i class="bi bi-x-circle"></i> Tirar o acordo
                                                        </button>
                                                    </form>
                                                }
                                            </td>
                                        </tr>

                                        @* O cadastro do aluno: o celular que fica guardado (o de
                                           cima sai da última aula lançada) e QUEM PAGA por ele.
                                           O responsável é o que destrava cobrar criança — a
                                           fatura do mês sai no nome de quem paga, e o aluno
                                           continua sendo o aluno na agenda. *@
                                        <tr class="collapse" id="@idCadastro">
                                            <td colspan="6" class="bg-light">
                                                <form asp-controller="Aulas" asp-action="SalvarCadastroDoAluno" method="post"
                                                      class="row g-2 align-items-end py-2">
                                                    <input type="hidden" name="alunoId" value="@aluno.AlunoId" />
                                                    <input type="hidden" name="nomeAvulso" value="@aluno.NomeAvulso" />

                                                    <div class="col-6 col-md-3">
                                                        <label class="form-label small text-muted mb-0">Celular do aluno</label>
                                                        <input type="tel" name="celular" maxlength="20" value="@aluno.CelularCadastrado"
                                                               class="form-control form-control-sm" placeholder="51 99999-0000" />
                                                    </div>
                                                    <div class="col-12 col-md-9">
                                                        <small class="text-muted d-block">
                                                            Deixe o responsável em branco quando o próprio aluno paga.
                                                        </small>
                                                    </div>

                                                    <div class="col-12 col-md-4">
                                                        <label class="form-label small text-muted mb-0">Responsável pela cobrança</label>
                                                        <input type="text" name="responsavelNome" maxlength="120" value="@aluno.ResponsavelNome"
                                                               class="form-control form-control-sm" placeholder="mãe, pai, empresa…" />
                                                    </div>
                                                    <div class="col-6 col-md-3">
                                                        <label class="form-label small text-muted mb-0">Celular dele</label>
                                                        <input type="tel" name="responsavelCelular" maxlength="20" value="@aluno.ResponsavelCelular"
                                                               class="form-control form-control-sm" placeholder="51 99999-0000" />
                                                    </div>
                                                    <div class="col-6 col-md-3">
                                                        <label class="form-label small text-muted mb-0">CPF dele</label>
                                                        <input type="text" name="responsavelCpf" maxlength="14" value="@aluno.ResponsavelCpf"
                                                               class="form-control form-control-sm" placeholder="só números" />
                                                    </div>
                                                    <div class="col-12 col-md-2">
                                                        <button type="submit" class="btn btn-sm btn-padel w-100">Salvar</button>
                                                    </div>

                                                    <div class="col-12">
                                                        <label class="form-label small text-muted mb-0">Anotações (opcional)</label>
                                                        <input type="text" name="observacao" maxlength="500" value="@aluno.Observacao"
                                                               class="form-control form-control-sm" placeholder="horário que não pode, o que combinaram…" />
                                                    </div>
                                                    <div class="col-12">
                                                        <small class="text-muted">
                                                            O CPF é do <strong>pagador</strong> e só é preciso pra cobrar pelo app —
                                                            do aluno o Padelizou nunca pede.
                                                        </small>
                                                    </div>
                                                </form>
                                            </td>
                                        </tr>

                                        @* Ligar as aulas de um aluno sem conta à conta que ele
                                           acabou de criar. Reaproveita a mesma busca da tela de
                                           marcar aula — um jeito só de procurar gente. *@
                                        @if (aluno.AlunoId == null && !string.IsNullOrWhiteSpace(aluno.NomeAvulso))
                                        {
                                            <tr class="collapse" id="vincular-@i">
                                                <td colspan="6" class="bg-light">
                                                    <form asp-controller="Aulas" asp-action="VincularAlunoAConta" method="post"
                                                          class="row g-2 align-items-end py-2 pdz-form-vincular">
                                                        <input type="hidden" name="nomeAvulso" value="@aluno.NomeAvulso" />
                                                        <input type="hidden" name="alunoId" class="pdz-vinc-id" value="" />
                                                        <div class="col-12">
                                                            <label class="form-label small text-muted mb-0">
                                                                Ligar as @aluno.TotalAulas aula(s) de <strong>@aluno.Nome</strong> a qual conta?
                                                            </label>
                                                            <div class="input-group input-group-sm">
                                                                <input type="text" class="form-control pdz-vinc-termo"
                                                                       placeholder="Nome de quem criou a conta" autocomplete="off" />
                                                                <button type="button" class="btn btn-outline-secondary pdz-vinc-buscar">
                                                                    <i class="bi bi-search"></i> Procurar
                                                                </button>
                                                            </div>
                                                            <div class="list-group mt-1 d-none pdz-vinc-lista"
                                                                 style="max-height: 200px; overflow-y: auto;"></div>
                                                        </div>
                                                        <div class="col-12">
                                                            <button type="submit" class="btn btn-sm btn-padel d-none pdz-vinc-salvar">
                                                                Ligar à conta escolhida
                                                            </button>
                                                            <small class="text-muted d-block mt-1">
                                                                O histórico passa a aparecer no app dele. Não desfaz sozinho —
                                                                confira que é a pessoa certa.
                                                            </small>
                                                        </div>
                                                    </form>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <partial name="_Vazio" model='@(new Padelizou.ViewModels.EstadoVazio("Nenhum aluno ainda. Quando alguém marcar aula com você, aparece aqui."))' />
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-6 mb-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h5 class="fw-bold text-muted mb-3"><i class="bi bi-calendar-check"></i> Próximas aulas</h5>
                    @if (Model.ProximasAulas.Any())
                    {
                        <ul class="list-unstyled mb-0">
                            @foreach (var aula in Model.ProximasAulas)
                            {
                                // O nome dado na solicitação vem primeiro (ver MinhaAgenda).
                                var nomeAluno = aula.NomeCompletoAluno ?? aula.Aluno?.Nome ?? aula.NomeAlunoAvulso ?? "Aluno avulso";
                                var badgeClass = aula.Status == "Pendente" ? "bg-warning text-dark" : "bg-primary";
                                <li class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                    <div>
                                        <div class="fw-bold small">@nomeAluno</div>
                                        <div class="text-muted small">@aula.LocalAula.Nome — @aula.DataHora.ToString("dd/MM/yyyy HH:mm")</div>
                                    </div>
                                    <span class="badge @badgeClass">@aula.Status</span>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <partial name="_Vazio" model='@(new Padelizou.ViewModels.EstadoVazio("Nenhuma aula marcada nos próximos dias."))' />
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-6 mb-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h5 class="fw-bold text-muted mb-3"><i class="bi bi-geo-alt"></i> Meus locais</h5>
                    @if (Model.Locais.Any())
                    {
                        <ul class="list-unstyled mb-0">
                            @foreach (var local in Model.Locais)
                            {
                                <li class="d-flex justify-content-between align-items-center py-2 border-bottom @(local.Ativo ? "" : "opacity-50")">
                                    <div>
                                        <div class="fw-bold small">@local.Nome</div>
                                        @if (!string.IsNullOrWhiteSpace(local.Endereco))
                                        {
                                            <div class="text-muted small">@local.Endereco</div>
                                        }
                                    </div>
                                    <span class="small text-success fw-bold">@local.PrecoPadrao.ToString("C")</span>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <partial name="_Vazio" model='@(new Padelizou.ViewModels.EstadoVazio("Nenhum local cadastrado ainda. Sem local, o aluno não consegue marcar.", "Cadastrar local", "Aulas", "MeusLocais"))' />
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-6 mb-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h5 class="fw-bold text-muted mb-3"><i class="bi bi-pin-map"></i> Minhas cidades</h5>
                    @if (Model.MinhasCidades.Any())
                    {
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var cidade in Model.MinhasCidades)
                            {
                                <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle rounded-pill px-3 py-2">
                                    @cidade.Nome@(string.IsNullOrEmpty(cidade.Estado) ? "" : $" - {cidade.Estado}")
                                </span>
                            }
                        </div>
                    }
                    else
                    {
                        <partial name="_Vazio" model='@(new Padelizou.ViewModels.EstadoVazio("Nenhuma cidade cadastrada. É por ela que o aluno começa a busca.", "Definir cidade", "Aulas", "MinhasCidades"))' />
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Ligar um aluno sem conta à conta que ele criou. A busca é sob demanda (botão), nunca
        // por tecla: é chamada de rede, e o professor costuma estar na quadra.
        document.querySelectorAll('.pdz-form-vincular').forEach(function (form) {
            var termo = form.querySelector('.pdz-vinc-termo');
            var lista = form.querySelector('.pdz-vinc-lista');
            var campoId = form.querySelector('.pdz-vinc-id');
            var salvar = form.querySelector('.pdz-vinc-salvar');

            function escapar(t) { var d = document.createElement('div'); d.textContent = t; return d.innerHTML; }

            form.querySelector('.pdz-vinc-buscar').addEventListener('click', function () {
                var q = (termo.value || '').trim();
                if (q.length < 3) { alert('Digite pelo menos 3 letras do nome.'); return; }

                fetch('@Url.Action("BuscarAlunoNoSistema", "Aulas")?termo=' + encodeURIComponent(q))
                    .then(function (r) { return r.json(); })
                    .then(function (r) {
                        lista.innerHTML = '';
                        lista.classList.remove('d-none');

                        if (r.erro) { lista.innerHTML = '<div class="list-group-item small text-muted">' + escapar(r.erro) + '</div>'; return; }
                        if (!r.encontrados || !r.encontrados.length) {
                            lista.innerHTML = '<div class="list-group-item small text-muted">'
                                + 'Ninguém com esse nome. Ele já criou a conta no Padelizou?</div>';
                            return;
                        }

                        r.encontrados.forEach(function (p) {
                            var b = document.createElement('button');
                            b.type = 'button';
                            b.className = 'list-group-item list-group-item-action py-2 small';
                            b.innerHTML = '<span class="fw-semibold">' + escapar(p.nome) + '</span>'
                                + (p.apelido ? ' <span class="text-muted">(' + escapar(p.apelido) + ')</span>' : '')
                                + (p.jaFezAulaComigo ? '<span class="badge bg-warning-subtle text-warning-emphasis ms-1">já é seu aluno</span>' : '');
                            b.addEventListener('click', function () {
                                campoId.value = p.alunoId;
                                termo.value = p.nome;
                                lista.classList.add('d-none');
                                salvar.classList.remove('d-none');
                            });
                            lista.appendChild(b);
                        });
                    })
                    .catch(function () { alert('Não deu pra procurar agora. Tente de novo.'); });
            });

            // Mudou o texto depois de escolher: some o botão de salvar, senão ligaria à
            // conta anterior enquanto a tela mostra outro nome.
            termo.addEventListener('input', function () {
                campoId.value = '';
                salvar.classList.add('d-none');
            });

            form.addEventListener('submit', function (ev) {
                if (!campoId.value) { ev.preventDefault(); alert('Escolha a conta na lista antes de ligar.'); }
            });
        });
    </script>
}
