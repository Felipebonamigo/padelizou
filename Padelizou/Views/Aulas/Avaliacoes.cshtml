@using Padelizou.Models
@using Padelizou.Services
@{
    ViewData["Title"] = "Fichas dos alunos";
    var fichas = ViewBag.Fichas as List<AvaliacaoDeAluno> ?? new();
    var alunos = ViewBag.Alunos as List<AlunoDoProfessor> ?? new();
    var modulos = ViewBag.Modulos as List<string> ?? new();
    int? alunoFiltro = ViewBag.AlunoFiltro;
}

<div class="container mt-4 mb-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h2 class="fw-bold mb-0" style="color: var(--pdz-ink);">
                <i class="bi bi-clipboard-check"></i> Fichas dos alunos
            </h2>
            <p class="text-muted small mb-0">Avaliação técnica por aluno — você decide quem vê.</p>
        </div>
        <a asp-action="MinhaRegua" class="btn btn-outline-secondary rounded-pill px-3">
            <i class="bi bi-list-check"></i> Minha régua
        </a>
    </div>

    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success py-2 small">@TempData["Sucesso"]</div>
    }
    @if (TempData["Erro"] != null)
    {
        <div class="alert alert-danger py-2 small">@TempData["Erro"]</div>
    }

    @if (alunos.Count == 0)
    {
        @* Sem aluno com conta não há a quem liberar ficha — e o professor precisa saber POR
           QUE a tela está vazia, senão conclui que a feature não funciona. *@
        <div class="alert alert-light border">
            <i class="bi bi-info-circle"></i>
            Você ainda não tem aluno <strong>com conta no Padelizou</strong>. A ficha precisa de uma
            conta pra ter pra quem mostrar — quando o aluno se cadastrar, ligue a conta dele no
            painel e ele aparece aqui.
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <h6 class="fw-bold mb-3" style="color: var(--pdz-ink);">
                    <i class="bi bi-plus-circle"></i> Nova ficha
                </h6>
                <form asp-action="NovaAvaliacao" method="post" class="row g-2">
                    <div class="col-md-5">
                        <select name="alunoId" class="form-select" required aria-label="Aluno">
                            <option value="">Escolha o aluno...</option>
                            @foreach (var a in alunos.OrderBy(a => a.Nome))
                            {
                                <option value="@a.AlunoId">@a.Nome@(a.Recorrente ? " (aluno recorrente)" : "")</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <select name="modulo" class="form-select" required aria-label="Módulo">
                            @foreach (var m in modulos)
                            {
                                <option value="@m">@m</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3 d-grid">
                        <button type="submit" class="btn btn-padel rounded-pill fw-bold">Criar ficha</button>
                    </div>
                </form>
            </div>
        </div>
    }

    @if (alunos.Count > 0)
    {
        <div class="mb-3 d-flex flex-wrap gap-1">
            <a class="btn btn-sm rounded-pill @(alunoFiltro == null ? "btn-padel" : "btn-outline-secondary")"
               asp-action="Avaliacoes">Todos</a>
            @foreach (var a in alunos.OrderBy(a => a.Nome))
            {
                <a class="btn btn-sm rounded-pill @(alunoFiltro == a.AlunoId ? "btn-padel" : "btn-outline-secondary")"
                   asp-action="Avaliacoes" asp-route-alunoId="@a.AlunoId">@a.Nome.Split(' ')[0]</a>
            }
        </div>
    }

    @if (fichas.Count == 0)
    {
        <p class="text-muted">Nenhuma ficha ainda.</p>
    }
    else
    {
        <div class="d-flex flex-column gap-2">
            @foreach (var f in fichas)
            {
                <a asp-action="Avaliacao" asp-route-id="@f.Id"
                   class="card border-0 shadow-sm text-decoration-none">
                    <div class="card-body d-flex align-items-center gap-3 py-3">
                        <div class="flex-grow-1 overflow-hidden">
                            <span class="d-block fw-bold text-truncate" style="color: var(--pdz-ink);">
                                @f.Aluno.NomeNaTela
                            </span>
                            <small class="text-muted">
                                @f.Modulo · @f.CriadoEm.ToString("dd/MM/yyyy")
                                · @f.Notas.Count fundamento(s) avaliado(s)
                            </small>
                        </div>
                        @* O estado que importa nesta lista é "o aluno já vê?" — é a decisão
                           que o professor toma e a que ele precisa conferir de relance. *@
                        @if (f.VisivelParaAluno)
                        {
                            <span class="badge rounded-pill bg-success flex-shrink-0">
                                <i class="bi bi-eye"></i> o aluno vê
                            </span>
                        }
                        else
                        {
                            <span class="badge rounded-pill bg-secondary flex-shrink-0">
                                <i class="bi bi-eye-slash"></i> só sua
                            </span>
                        }
                    </div>
                </a>
            }
        </div>
    }
</div>
