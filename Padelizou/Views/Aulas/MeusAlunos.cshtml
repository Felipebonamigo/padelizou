@model List<Padelizou.Services.AlunoDoProfessor>
@{
    ViewData["Title"] = "Meus alunos";
    var busca = ViewBag.Busca as string;
    var recorrentes = Model.Count(a => a.Recorrente);
    var comConta = Model.Count(a => a.TemConta);
}

<div class="container py-4">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <h1 class="h4 fw-bold mb-0"><i class="bi bi-people"></i> Meus alunos</h1>
        <a asp-action="Dashboard" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
            <i class="bi bi-arrow-left"></i> Voltar ao painel
        </a>
    </div>

    @* Três números que respondem o que a lista sozinha não responde: quantos voltaram, e
       quantos dão pra alcançar pelo app. *@
    <p class="text-muted small mb-3">
        <strong>@Model.Count</strong> aluno(s) ·
        <strong>@recorrentes</strong> que já voltaram ·
        <strong>@comConta</strong> com conta no Padelizou
    </p>

    <form method="get" class="input-group input-group-sm mb-4" style="max-width: 26rem;">
        <input type="text" name="busca" value="@busca" class="form-control"
               placeholder="Procurar pelo nome…" />
        <button type="submit" class="btn btn-outline-secondary">Procurar</button>
        @if (!string.IsNullOrWhiteSpace(busca))
        {
            <a asp-action="MeusAlunos" class="btn btn-outline-secondary">Limpar</a>
        }
    </form>

    @if (!Model.Any())
    {
        <div class="alert alert-info border-0">
            @if (!string.IsNullOrWhiteSpace(busca))
            {
                <text>Nenhum aluno com esse nome.</text>
            }
            else
            {
                @* Lista vazia aqui não é erro: é professor que ainda não deu a primeira aula.
                   Dizer o que fazer vale mais do que dizer que está vazio. *@
                <text>
                    Você ainda não tem aluno nenhum. Quem entra aqui é quem já fez aula com
                    você — marque a primeira em <a asp-action="AdicionarManual">Adicionar aula</a>.
                </text>
            }
        </div>
    }
    else
    {
        <div class="list-group shadow-sm">
            @foreach (var aluno in Model)
            {
                <div class="list-group-item d-flex flex-wrap align-items-center gap-2">
                    <div class="flex-grow-1">
                        <div class="fw-bold">
                            @aluno.Nome
                            @if (aluno.Recorrente)
                            {
                                <span class="badge bg-success ms-1">Recorrente</span>
                            }
                            @* "Sem conta" é informação de ALCANCE, não de cadastro incompleto:
                               quem não tem conta não vê a aula no próprio app nem recebe aviso
                               por lá — só pelo WhatsApp, se o professor tiver o número. *@
                            @if (!aluno.TemConta)
                            {
                                <span class="badge bg-secondary ms-1">Sem conta</span>
                            }
                        </div>
                        <small class="text-muted">
                            @aluno.TotalDeAulas aula(s) · última em @aluno.UltimaAula.ToString("dd/MM/yyyy")
                        </small>
                    </div>

                    @* O botão do WhatsApp só existe com número válido — a mesma régua do resto
                       do sistema (WhatsAppLinkHelper). Sem ele, oferecer o botão seria prometer
                       um caminho que não existe. *@
                    @if (Padelizou.Services.WhatsAppLinkHelper.NumeroValido(aluno.Celular))
                    {
                        <a href="@Padelizou.Services.WhatsAppLinkHelper.GerarLink(aluno.Celular!, "")"
                           target="_blank" rel="noopener"
                           class="btn btn-sm btn-outline-success rounded-pill px-3">
                            <i class="bi bi-whatsapp"></i> WhatsApp
                        </a>
                    }
                    <a asp-action="AdicionarManual" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                        <i class="bi bi-plus-lg"></i> Marcar aula
                    </a>
                </div>
            }
        </div>
    }
</div>
