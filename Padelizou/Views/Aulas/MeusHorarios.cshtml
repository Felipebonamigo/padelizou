@model IEnumerable<HorarioDisponivel>
@{
    ViewData["Title"] = "Meus Horários - Padelizou";
    var locais = (IEnumerable<LocalAula>)ViewBag.Locais;
    string[] diasSemana = { "Domingo", "Segunda", "Terça", "Quarta", "Quinta", "Sexta", "Sábado" };
    // No celular o dia vai abreviado: "Segunda" sozinho custa o dobro da largura de "Seg",
    // e numa tela de 320px é a diferença entre ler a tabela e ter que arrastá-la.
    string[] diasCurtos = { "Dom", "Seg", "Ter", "Qua", "Qui", "Sex", "Sáb" };
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold" style="color: var(--pdz-ink);">Meus Horários</h2>
            <p class="text-muted mb-0">Defina sua disponibilidade semanal recorrente por local.</p>
        </div>
        @* Volta pro Painel, não pra Agenda: foi de lá que a pessoa saiu (é o botão do painel
           que traz pra cá), e a Agenda era um desvio que obrigava a clicar duas vezes. *@
        <a asp-controller="Aulas" asp-action="Dashboard" class="btn btn-outline-secondary rounded-pill">
            <i class="bi bi-arrow-left"></i> Voltar ao Painel
        </a>
    </div>

    @* Quem chegou aqui empurrado pelo painel precisa saber por quê — redirecionamento sem
       explicação parece defeito, e a pessoa tenta voltar em vez de resolver. *@
    @if (TempData["AvisoCadastroProfessor"] != null)
    {
        <div class="alert alert-warning border-0 shadow-sm">
            <i class="bi bi-exclamation-triangle-fill me-1"></i>
            @TempData["AvisoCadastroProfessor"]
        </div>
    }

    @if (!locais.Any())
    {
        <div class="alert alert-warning">
            Cadastre pelo menos um <a asp-controller="Aulas" asp-action="MeusLocais">local</a> antes de definir horários.
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body">
                <h6 class="fw-bold text-muted mb-3">Novo horário</h6>

                @if (TempData["ErroHorario"] != null)
                {
                    <div class="alert alert-warning border-0 shadow-sm py-2">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i> @TempData["ErroHorario"]
                    </div>
                }
                @if (TempData["SucessoHorario"] != null)
                {
                    <div class="alert alert-success border-0 shadow-sm py-2">
                        <i class="bi bi-check-circle-fill me-1"></i> @TempData["SucessoHorario"]
                    </div>
                }

                <form asp-controller="Aulas" asp-action="CriarHorario" method="post">
                    <div class="row g-2 mb-2">
                        <div class="col-md-4">
                            <label class="form-label small text-muted mb-1">Local</label>
                            <select name="localAulaId" class="form-select" required>
                                @foreach (var local in locais)
                                {
                                    <option value="@local.Id">@local.Nome</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3 col-6">
                            <label class="form-label small text-muted mb-1">Começa</label>
                            <input type="time" name="horaInicio" class="form-control" required />
                        </div>
                        <div class="col-md-3 col-6">
                            <label class="form-label small text-muted mb-1">Termina</label>
                            <input type="time" name="horaFim" class="form-control" required />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small text-muted mb-1">Aula de (min)</label>
                            <input type="number" name="duracaoMinutos" class="form-control" value="60" min="15" step="15" required />
                        </div>
                    </div>

                    @* Vários dias de uma vez: quem dá aula seg/qua/sex no mesmo horário marca os
                       três e cadastra a semana num clique, em vez de repetir o formulário 3x. *@
                    <label class="form-label small text-muted mb-1 d-block">Dias da semana (marque quantos quiser)</label>
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        @for (int i = 0; i < diasSemana.Length; i++)
                        {
                            <input type="checkbox" class="btn-check" name="diasSemana" value="@i" id="diaHorario_@i" autocomplete="off" />
                            <label class="btn btn-outline-secondary btn-sm rounded-pill px-3" for="diaHorario_@i">@diasSemana[i]</label>
                        }
                        <button type="submit" class="btn btn-padel rounded-pill px-4 ms-auto">
                            <i class="bi bi-plus-lg"></i> Adicionar
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="table-responsive">
            @* Sem text-nowrap na tabela inteira: nome de local comprido não quebrava e sozinho
               empurrava a tabela pra 674px numa tela de 320. Só as horas seguem sem quebrar.
               No celular, Fim/Duração/Status saem das colunas e viram uma linha embaixo da
               hora de início — a mesma informação, empilhada em vez de arrastada de lado. *@
            <table class="table align-middle bg-white shadow-sm rounded">
                <thead>
                    <tr>
                        <th>Dia</th>
                        <th>Local</th>
                        <th>Início</th>
                        <th class="d-none d-sm-table-cell">Fim</th>
                        <th class="d-none d-md-table-cell">Duração</th>
                        <th class="d-none d-sm-table-cell">Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var h in Model)
                        {
                            <tr class="@(h.Ativo ? "" : "text-muted")">
                                <td class="text-nowrap">
                                    <span class="d-none d-sm-inline">@diasSemana[h.DiaSemana]</span>
                                    <span class="d-sm-none">@diasCurtos[h.DiaSemana]</span>
                                </td>
                                <td>@h.LocalAula.Nome</td>
                                <td>
                                    @* O nowrap fica só na hora: na linha auxiliar ele forçaria
                                       ~110px numa célula que precisa caber em 320px de tela. *@
                                    <span class="text-nowrap">@h.HoraInicio.ToString(@"hh\:mm")</span>
                                    @* No celular, o que saiu das colunas volta aqui embaixo. *@
                                    <div class="d-sm-none small text-muted">
                                        até @h.HoraFim.ToString(@"hh\:mm") · @h.DuracaoMinutos min
                                        @if (!h.Ativo)
                                        {
                                            <span class="badge bg-secondary ms-1">Inativo</span>
                                        }
                                    </div>
                                </td>
                                <td class="text-nowrap d-none d-sm-table-cell">@h.HoraFim.ToString(@"hh\:mm")</td>
                                <td class="text-nowrap d-none d-md-table-cell">@h.DuracaoMinutos min</td>
                                <td class="d-none d-sm-table-cell">
                                    <span class="badge @(h.Ativo ? "bg-success" : "bg-secondary")">@(h.Ativo ? "Ativo" : "Inativo")</span>
                                </td>
                                <td>
                                    <form asp-controller="Aulas" asp-action="AlternarHorario" method="post">
                                        <input type="hidden" name="id" value="@h.Id" />
                                        @* No celular fica só o ícone (com title e aria-label pra
                                           não virar botão mudo); o texto volta a partir de sm. *@
                                        <button type="submit" class="btn btn-sm @(h.Ativo ? "btn-outline-danger" : "btn-outline-success")"
                                                title="@(h.Ativo ? "Desativar" : "Reativar")"
                                                aria-label="@(h.Ativo ? "Desativar horário" : "Reativar horário")">
                                            <i class="bi @(h.Ativo ? "bi-pause-fill" : "bi-play-fill") d-sm-none"></i>
                                            <span class="d-none d-sm-inline">@(h.Ativo ? "Desativar" : "Reativar")</span>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        @* Último degrau da escada do professor: com cidade e local prontos mas
                           sem nenhum horário, o aluno percorre quatro telas pra descobrir na
                           quinta que não há quando marcar. *@
                        <tr>
                            <td colspan="7" class="border-0">
                                <partial name="_Vazio" model='@(new EstadoVazio("Nenhum horário cadastrado. Enquanto não houver, o aluno chega até você e não consegue marcar."))' />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
