@model Padelizou.ViewModels.AgendaProfessorVM
@{
    ViewData["Title"] = "Minha Agenda - Padelizou";

    // Cor por status, igual nos três modos de ver — o professor aprende uma vez só.
    string CorDe(string status) => status switch
    {
        "Pendente" => "#f0ad4e",
        "Confirmada" => "#2c6fbb",
        "Realizada" => "#2e9e5b",
        // Roxo, e não o vermelho do resto: "a recuperar" não é aula perdida — é aula que
        // vai acontecer noutro dia, e ler igual a cancelada é o erro que a cor tem que evitar.
        PoliticaAula.ARecuperar => "#7a5cbf",
        _ => "#b34a4a",
    };

    // A cor de UMA AULA: o dinheiro fala mais alto que o status (pedido de um professor,
    // 28/08/2026 — "deixar em amarelo o a receber na agenda"). Aula dada e não paga era verde
    // igual à paga, e a diferença só existia no Financeiro; agora a agenda conta a mesma
    // história. A régua é a MESMA das outras telas (Services/RecebimentoDaAula) e o âmbar é o
    // MESMO do selo "A receber" do modal — refazer a conta ou a cor aqui é como duas telas
    // passam a discordar sobre dinheiro.
    //
    // ⚠️ O card colapsado da turma passa aqui com o `PagaEm` DA SESSÃO (AgendaDeTurma): só
    // fica verde quando todos pagaram, que é a única leitura honesta de um preço somado.
    string CorDa(Aula aula) =>
        RecebimentoDaAula.EstaAReceber(aula) ? "#c78a1e" : CorDe(aula.Status);

    // O nome que o aluno deu NA SOLICITAÇÃO vem primeiro: é como ele se apresenta pra esta
    // aula, e pode não ser o nome do cadastro.
    string NomeDoAluno(Aula a) => a.NomeCompletoAluno ?? a.Aluno?.Nome ?? a.NomeAlunoAvulso ?? "Aluno avulso";

    var hoje = DateTime.Today;

    // Séries pendentes ganham bloco próprio: aceitar 12 aulas uma a uma seria castigo.
    var seriesPendentes = Model.Pendentes
        .Where(a => a.RecorrenciaId != null)
        .GroupBy(a => a.RecorrenciaId!.Value)
        .ToList();
    var idsEmSerie = seriesPendentes.SelectMany(g => g.Select(a => a.Id)).ToHashSet();
    var pendentesAvulsas = Model.Pendentes.Where(a => !idsEmSerie.Contains(a.Id)).ToList();
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-0" style="color: var(--pdz-ink);">Minha Agenda</h2>
            <p class="text-muted mb-0 small">Seus compromissos, no calendário ou em lista.</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="AdicionarManual" class="btn btn-padel rounded-pill btn-sm">
                <i class="bi bi-plus-lg"></i> Adicionar Aula
            </a>
            <a asp-action="MeusLocais" class="btn btn-outline-primary rounded-pill btn-sm"><i class="bi bi-geo-alt"></i> Locais</a>
            <a asp-action="MeusHorarios" class="btn btn-outline-primary rounded-pill btn-sm"><i class="bi bi-clock"></i> Horários</a>
            <a asp-action="Relatorio" class="btn btn-outline-primary rounded-pill btn-sm"><i class="bi bi-graph-up"></i> Relatório</a>
            @if (Model.GoogleConectado)
            {
                <span class="btn btn-sm btn-success rounded-pill disabled"><i class="bi bi-check-circle"></i> Google Agenda conectada</span>
                @* Fora do aviso amarelo de propósito: aquele bloco só aparece com aula
                   pendente de ENVIO, e o botão de importar sumiria depois da primeira
                   sincronização — bug de visibilidade silencioso. *@
                <a asp-action="ImportarDoGoogle" class="btn btn-sm btn-outline-primary rounded-pill">
                    <i class="bi bi-cloud-download"></i> Trazer do Google
                </a>
            }
            else
            {
                <a asp-controller="GoogleAuth" asp-action="Conectar" class="btn btn-sm btn-outline-danger rounded-pill">
                    <i class="bi bi-google"></i> Conectar Google Agenda
                </a>
            }
            <a asp-action="Dashboard" class="btn btn-outline-secondary rounded-pill btn-sm">
                <i class="bi bi-arrow-left"></i> Voltar ao Painel
            </a>
        </div>
    </div>

    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success">@TempData["Sucesso"]</div>
    }
    @if (TempData["Erro"] != null)
    {
        <div class="alert alert-danger">@TempData["Erro"]</div>
    }
    @if (TempData["WhatsAppLink"] != null)
    {
        <div class="alert alert-light border d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
            @* Serve pra dois momentos — aula MARCADA (o convite com pedido de confirmação e o
               link de cadastro, ver Services/ConviteDaAulaMarcada) e aula MUDADA. O texto é
               neutro porque a própria mensagem já diz qual é o caso; "também" só fazia sentido
               na edição, onde havia um aviso automático antes. *@
            <span>Quer avisar o aluno pelo WhatsApp?</span>
            <a href="@TempData["WhatsAppLink"]" target="_blank" class="btn btn-sm btn-success rounded-pill fw-bold align-self-start align-self-sm-auto">
                <i class="bi bi-whatsapp"></i> Avisar aluno
            </a>
        </div>
    }

    @* Aula que ficou fora da Google Agenda. O evento nasce junto com a aula, e quando aquele
       instante dá errado (conta ainda não conectada, chamada recusada) nada tenta de novo —
       era isso que aparecia como "algumas aulas vão pro Google, outras não". *@
    @if (Model.AulasForaDoGoogle > 0)
    {
        <div class="alert alert-warning d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
            <span>
                <i class="bi bi-calendar-x"></i>
                <strong>@Model.AulasForaDoGoogle aula(s)</strong> ainda não estão na sua Google Agenda —
                foram marcadas antes de você conectar a conta, ou o envio falhou na hora.
            </span>
            <form asp-action="SincronizarGoogle" method="post" class="flex-shrink-0">
                <button type="submit" class="btn btn-sm btn-warning rounded-pill fw-bold">
                    <i class="bi bi-arrow-repeat"></i> Enviar pro Google
                </button>
            </form>
        </div>
    }

    @* ── Barra de controle: navegar, escolher período, trocar de vista ───────────────── *@
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body py-2 d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div class="d-flex align-items-center gap-1">
                <a class="btn btn-sm btn-outline-secondary rounded-circle" title="Anterior"
                   asp-action="MinhaAgenda" asp-route-vista="@Model.Vista" asp-route-periodo="@Model.Periodo"
                   asp-route-esporte="@Model.EsporteFiltro"
                   asp-route-data="@PeriodoAgenda.Deslocar(Model.Periodo, Model.Referencia, -1).ToString("yyyy-MM-dd")">
                    <i class="bi bi-chevron-left"></i>
                </a>
                <a class="btn btn-sm btn-outline-secondary rounded-pill px-3"
                   asp-action="MinhaAgenda" asp-route-vista="@Model.Vista" asp-route-periodo="@Model.Periodo"
                   asp-route-esporte="@Model.EsporteFiltro">Hoje</a>
                <a class="btn btn-sm btn-outline-secondary rounded-circle" title="Próximo"
                   asp-action="MinhaAgenda" asp-route-vista="@Model.Vista" asp-route-periodo="@Model.Periodo"
                   asp-route-esporte="@Model.EsporteFiltro"
                   asp-route-data="@PeriodoAgenda.Deslocar(Model.Periodo, Model.Referencia, 1).ToString("yyyy-MM-dd")">
                    <i class="bi bi-chevron-right"></i>
                </a>
                <strong class="ms-2 text-capitalize" style="color: var(--pdz-ink);">@Model.Titulo</strong>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <div class="btn-group btn-group-sm" role="group" aria-label="Período">
                    @foreach (var (valor, rotulo) in new[] { (PeriodoAgenda.Dia, "Dia"), (PeriodoAgenda.Semana, "Semana"), (PeriodoAgenda.Mes, "Mês") })
                    {
                        <a class="btn @(Model.Periodo == valor ? "btn-primary" : "btn-outline-primary")"
                           asp-action="MinhaAgenda" asp-route-vista="@Model.Vista" asp-route-periodo="@valor"
                           asp-route-esporte="@Model.EsporteFiltro"
                           asp-route-data="@Model.Referencia.ToString("yyyy-MM-dd")">@rotulo</a>
                    }
                </div>

                <div class="btn-group btn-group-sm" role="group" aria-label="Modo de exibição">
                    <a class="btn @(Model.Vista == PeriodoAgenda.VistaCalendario ? "btn-secondary" : "btn-outline-secondary")"
                       asp-action="MinhaAgenda" asp-route-vista="@PeriodoAgenda.VistaCalendario"
                       asp-route-periodo="@Model.Periodo" asp-route-esporte="@Model.EsporteFiltro"
                       asp-route-data="@Model.Referencia.ToString("yyyy-MM-dd")">
                        <i class="bi bi-calendar3"></i> Calendário
                    </a>
                    <a class="btn @(Model.Vista == PeriodoAgenda.VistaLista ? "btn-secondary" : "btn-outline-secondary")"
                       asp-action="MinhaAgenda" asp-route-vista="@PeriodoAgenda.VistaLista"
                       asp-route-periodo="@Model.Periodo" asp-route-esporte="@Model.EsporteFiltro"
                       asp-route-data="@Model.Referencia.ToString("yyyy-MM-dd")">
                        <i class="bi bi-list-ul"></i> Lista
                    </a>
                </div>
            </div>
        </div>

        @* Só aparece pra quem já lançou aula de mais de um esporte — quem só dá padel nunca
           teria o que escolher aqui (pedido do Felipe, 23/08/2026: "seria legal um campo pra
           isso" sobre o João dar tênis e beach tênis também). *@
        @if (Model.EsportesDoProfessor.Count > 1)
        {
            <div class="card-body pt-0 pb-2 d-flex align-items-center gap-2 flex-wrap">
                <span class="small text-muted">Esporte:</span>
                <div class="btn-group btn-group-sm" role="group" aria-label="Filtrar por esporte">
                    <a class="btn @(Model.EsporteFiltro == null ? "btn-secondary" : "btn-outline-secondary")"
                       asp-action="MinhaAgenda" asp-route-vista="@Model.Vista" asp-route-periodo="@Model.Periodo"
                       asp-route-data="@Model.Referencia.ToString("yyyy-MM-dd")">Todos</a>
                    @foreach (var opcao in Model.EsportesDoProfessor)
                    {
                        <a class="btn @(Model.EsporteFiltro == opcao ? "btn-secondary" : "btn-outline-secondary")"
                           asp-action="MinhaAgenda" asp-route-vista="@Model.Vista" asp-route-periodo="@Model.Periodo"
                           asp-route-esporte="@opcao"
                           asp-route-data="@Model.Referencia.ToString("yyyy-MM-dd")">@opcao</a>
                    }
                </div>
            </div>
        }
    </div>

    @* ── Pendências (sempre visíveis, de qualquer data) ──────────────────────────────── *@
    @if (seriesPendentes.Any() || pendentesAvulsas.Any())
    {
        <div class="card border-0 shadow-sm mb-3" style="border-left: 5px solid #f0ad4e !important;">
            <div class="card-body">
                <h6 class="fw-bold mb-1" style="color: var(--pdz-ink);">
                    <i class="bi bi-hourglass-split text-warning"></i>
                    Esperando sua resposta (@(seriesPendentes.Count + pendentesAvulsas.Count))
                </h6>
                <p class="small text-muted mb-3">Aparecem aqui em qualquer data, pra não vencerem enquanto você olha outra semana.</p>

                @foreach (var serie in seriesPendentes)
                {
                    var aulasDaSerie = serie.OrderBy(a => a.DataHora).ToList();
                    var primeira = aulasDaSerie[0];
                    <div class="border rounded p-2 mb-2">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                            <strong><i class="bi bi-arrow-repeat"></i> Série de @aulasDaSerie.Count aula(s) — @NomeDoAluno(primeira)</strong>
                            <span class="text-muted small">
                                <i class="bi bi-geo-alt-fill text-danger"></i> @primeira.LocalAula.Nome
                                · @primeira.DataHora.ToString("dd/MM") a @aulasDaSerie[^1].DataHora.ToString("dd/MM")
                            </span>
                        </div>
                        <div class="d-flex gap-2">
                            <form asp-action="ConfirmarSerie" method="post">
                                <input type="hidden" name="recorrenciaId" value="@serie.Key" />
                                <input type="hidden" name="aceitar" value="true" />
                                <button type="submit" class="btn btn-sm btn-success"><i class="bi bi-check2-all"></i> Aceitar todas</button>
                            </form>
                            <form asp-action="ConfirmarSerie" method="post">
                                <input type="hidden" name="recorrenciaId" value="@serie.Key" />
                                <input type="hidden" name="aceitar" value="false" />
                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-x-circle"></i> Recusar todas</button>
                            </form>
                        </div>
                    </div>
                }

                @foreach (var aula in pendentesAvulsas)
                {
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 border-bottom py-2">
                        <span>
                            <strong>@NomeDoAluno(aula)</strong>
                            <span class="text-muted small">
                                · @aula.DataHora.ToString("dd/MM/yyyy HH:mm")
                                · @aula.LocalAula.Nome · @aula.Preco.ToString("C")
                            </span>
                        </span>
                        <div class="d-flex gap-1">
                            <form asp-action="ConfirmarSolicitacao" method="post">
                                <input type="hidden" name="aulaId" value="@aula.Id" />
                                <input type="hidden" name="aceitar" value="true" />
                                <button type="submit" class="btn btn-sm btn-success"><i class="bi bi-check2"></i> Aceitar</button>
                            </form>
                            <form asp-action="ConfirmarSolicitacao" method="post">
                                <input type="hidden" name="aulaId" value="@aula.Id" />
                                <input type="hidden" name="aceitar" value="false" />
                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-x"></i></button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @* A fila de reposição. Aparece acima do calendário e em qualquer data, porque a aula
       que ficou devendo é quase sempre de outra semana — deixá-la só no dia em que ela
       seria devolveria o controle pro WhatsApp, que é de onde ele veio. *@
    @if (Model.ARecuperar.Any())
    {
        <div class="card border-0 shadow-sm mb-3" style="border-left: 5px solid #7a5cbf !important;">
            <div class="card-body">
                <h6 class="fw-bold mb-1" style="color: var(--pdz-ink);">
                    <i class="bi bi-arrow-counterclockwise" style="color:#7a5cbf;"></i>
                    A recuperar (@Model.ARecuperar.Count)
                </h6>
                <p class="small text-muted mb-3">
                    Aulas já cobradas que o aluno vai repor. Escolha o dia e o horário pra encaixar —
                    a reposição entra na agenda <strong>sem cobrar de novo</strong>.
                </p>

                @foreach (var aula in Model.ARecuperar)
                {
                    <div class="border rounded p-2 mb-2">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                            <strong>@NomeDoAluno(aula)</strong>
                            <span class="text-muted small">
                                era @aula.DataHora.ToString("dd/MM/yyyy 'às' HH:mm")
                                · @aula.LocalAula.Nome · @aula.Preco.ToString("C") cobrado
                            </span>
                        </div>

                        <form asp-action="Encaixar" method="post" class="row g-1 align-items-end">
                            <input type="hidden" name="aulaId" value="@aula.Id" />
                            @* ⚠️ DOIS CAMPOS, e não um `datetime-local` — mesma razão das telas de
                               Adicionar e Editar (25/08/2026, pedido do Felipe): no Android o
                               datetime-local abre a RODINHA, sem calendário e sem dia da semana.
                               E aqui a pergunta É o dia da semana: "que dia você pode repor?".

                               O `id` carrega o id da AULA porque este formulário se repete uma
                               vez por aula na fila — id fixo faria a segunda linha escrever o
                               dia da semana em cima da primeira. *@
                            <div class="col-6 col-md-4">
                                <label class="form-label small text-muted mb-0">Quando</label>
                                <div class="row g-1">
                                    <div class="col-7">
                                        <input type="date" name="data" class="form-control form-control-sm"
                                               data-dia-da-semana="dia-encaixe-@aula.Id" required />
                                    </div>
                                    <div class="col-5">
                                        <input type="time" name="hora" class="form-control form-control-sm" required />
                                    </div>
                                </div>
                                <div class="form-text fw-bold small" id="dia-encaixe-@aula.Id"></div>
                            </div>
                            <div class="col-6 col-md-4">
                                <label class="form-label small text-muted mb-0">Onde</label>
                                <select name="localId" class="form-select form-select-sm" required>
                                    @foreach (var local in Model.Locais)
                                    {
                                        @* O local da aula original já vem escolhido: reposição
                                           quase sempre é na mesma quadra. *@
                                        <option value="@local.Id" selected="@(local.Id == aula.LocalAulaId)">@local.Nome</option>
                                    }
                                </select>
                            </div>
                            <div class="col-12 col-md-4 d-flex gap-1">
                                <button type="submit" class="btn btn-sm btn-primary flex-grow-1">
                                    <i class="bi bi-calendar-plus"></i> Encaixar
                                </button>
                            </div>
                        </form>

                        @* A outra saída da fila: combinaram que não vai ter reposição. Vira
                           falta cobrada — o dinheiro já estava contado — e some daqui. *@
                        <form asp-action="NaoVaiRecuperar" method="post" class="mt-1"
                              onsubmit="return confirm('Tirar esta aula da fila de reposição? Ela fica registrada como falta cobrada.');">
                            <input type="hidden" name="aulaId" value="@aula.Id" />
                            <button type="submit" class="btn btn-sm btn-link text-muted text-decoration-none p-0">
                                não vai mais recuperar
                            </button>
                        </form>
                    </div>
                }
            </div>
        </div>
    }

    @* ══ CALENDÁRIO ══════════════════════════════════════════════════════════════════ *@
    @if (Model.Vista == PeriodoAgenda.VistaCalendario)
    {
        @if (Model.Periodo == PeriodoAgenda.Mes)
        {
            var grade = PeriodoAgenda.GradeDoMes(Model.Referencia);
            <div class="card border-0 shadow-sm">
                <div class="table-responsive">
                    <table class="table table-bordered mb-0 pdz-mes">
                        <thead>
                            <tr>
                                @for (int d = 0; d < 7; d++)
                                {
                                    <th class="text-center small text-uppercase text-muted py-2">@PeriodoAgenda.DiaCurto((DayOfWeek)d)</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < grade.Count; i += 7)
                            {
                                <tr>
                                    @for (int d = 0; d < 7; d++)
                                    {
                                        var dia = grade[i + d];
                                        var doMes = dia.Month == Model.Referencia.Month;
                                        var ehHoje = dia == hoje;
                                        <td class="align-top p-1 @(doMes ? "" : "pdz-fora-do-mes")" style="height: 108px; width: 14.28%;">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <span class="small @(ehHoje ? "pdz-hoje" : "text-muted")">@dia.Day</span>
                                            </div>
                                            @foreach (var aula in Model.Do(dia))
                                            {
                                                <button type="button" class="pdz-chip" data-aula="@aula.Id"
                                                        style="background:@CorDa(aula);"
                                                        title="@aula.DataHora.ToString("HH:mm") @NomeDoAluno(aula)">
                                                    @aula.DataHora.ToString("HH:mm") @NomeDoAluno(aula)
                                                </button>
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else
        {
            var dias = new List<DateTime>();
            for (var d = Model.Inicio; d < Model.Fim; d = d.AddDays(1)) dias.Add(d);
            var (primeiraHora, ultimaHora) = PeriodoAgenda.FaixaDeHoras(Model.NoPeriodo.Select(a => a.DataHora));

            @* Sete dias com nome de aluno não cabem em 320px — nenhuma diminuição de fonte
               resolve isso. A grade rola dentro do próprio card (a página não rola de lado),
               e aqui o celular ganha as duas coisas que faltavam: saber que dá pra arrastar,
               e o atalho pra lista, que mostra a semana inteira sem arrastar nada. *@
            <div class="d-sm-none small text-muted mb-2 d-flex justify-content-between align-items-center gap-2">
                <span><i class="bi bi-arrow-left-right"></i> Arraste a grade pro lado</span>
                <a asp-action="MinhaAgenda"
                   asp-route-vista="lista"
                   asp-route-periodo="@Model.Periodo"
                   asp-route-data="@Model.Inicio.ToString("yyyy-MM-dd")"
                   class="text-decoration-none fw-bold">ver em lista</a>
            </div>
            // 1 px por minuto: uma aula de 60 min ocupa 60px de altura — o mesmo espaço
            // que ela ocupa na agenda de verdade. Sem isso, uma aula de 7h às 8h e uma de
            // 7h às 7h30 pareciam do mesmo tamanho, e o buraco entre uma aula e outra não
            // se via — parecia que a agenda tinha espaço livre onde não tinha (estilo
            // Google Agenda, pedido do Felipe em 23/08/2026).
            const int pxPorMinuto = 1;
            var alturaGrade = (ultimaHora - primeiraHora + 1) * 60 * pxPorMinuto;
            <div class="card border-0 shadow-sm">
                @* ⚠️ UM WRAPPER SÓ PRA ROLAGEM, com o cabeçalho E o corpo dentro. Enquanto o
                   `overflow-x` morava só no corpo, as duas faixas rolavam separadas: o corpo
                   por dentro do card e o cabeçalho TRANSBORDANDO pra fora dele — os dias
                   "QUI 27" e "SEX 28" apareciam flutuando sobre o fundo da página, e a data
                   de cima não batia com a coluna de baixo. Defeito visto em produção, no
                   celular (25/08/2026). *@
                <div class="pdz-grade-rolagem">
                <div class="pdz-grade-cabecalho">
                    <div class="pdz-grade-gutter"></div>
                    @foreach (var dia in dias)
                    {
                        <div class="pdz-grade-col-cabecalho text-center small py-2 @(dia == hoje ? "pdz-col-hoje" : "")">
                            <div class="text-uppercase text-muted">@PeriodoAgenda.DiaCurto(dia.DayOfWeek)</div>
                            <div class="@(dia == hoje ? "pdz-hoje d-inline-block" : "fw-bold")">@dia.Day</div>
                        </div>
                    }
                </div>
                <div class="pdz-grade-corpo" style="height:@(alturaGrade)px;">
                    <div class="pdz-grade-gutter">
                        @for (int h = primeiraHora; h <= ultimaHora; h++)
                        {
                            <div class="pdz-hora-rotulo" style="top:@((h - primeiraHora) * 60 * pxPorMinuto)px;">@h.ToString("00"):00</div>
                        }
                    </div>
                    @foreach (var dia in dias)
                    {
                        <div class="pdz-grade-coluna @(dia == hoje ? "pdz-col-hoje" : "")" data-dia="@dia.ToString("yyyy-MM-dd")"
                             data-primeira-hora="@primeiraHora" data-px-por-minuto="@pxPorMinuto">
                            @for (int h = primeiraHora; h <= ultimaHora; h++)
                            {
                                <div class="pdz-linha-hora" style="top:@((h - primeiraHora) * 60 * pxPorMinuto)px;"></div>
                            }
                            @foreach (var aula in Model.Do(dia))
                            {
                                var minutosDoTopo = (aula.DataHora.Hour * 60 + aula.DataHora.Minute) - (primeiraHora * 60);
                                <button type="button" class="pdz-evento" data-aula="@aula.Id"
                                        style="top:@(minutosDoTopo * pxPorMinuto)px; height:@(aula.DuracaoMinutos * pxPorMinuto)px; background:@CorDa(aula);"
                                        title="@aula.DataHora.ToString("HH:mm")–@DuracaoDaAula.Fim(aula).ToString("HH:mm") @NomeDoAluno(aula)">
                                    @aula.DataHora.ToString("HH:mm") @NomeDoAluno(aula)
                                </button>
                            }
                        </div>
                    }
                </div>
                </div>
            </div>
        }

        @if (!Model.NoPeriodo.Any())
        {
            <p class="text-center text-muted small mt-3 mb-0">
                <i class="bi bi-calendar-x"></i> Nenhuma aula neste período.
            </p>
        }
    }
    else
    {
        @* ══ LISTA ═══════════════════════════════════════════════════════════════════ *@
        @if (!Model.NoPeriodo.Any())
        {
            <div class="text-center py-5 rounded-3 bg-light" style="border: 2px dashed var(--pdz-border);">
                <i class="bi bi-calendar-x display-4 text-muted mb-3"></i>
                <h5 class="fw-bold text-secondary">Nenhuma aula neste período</h5>
                <p class="text-muted mb-0">Use as setas ou troque o filtro pra ver outro intervalo.</p>
            </div>
        }
        else
        {
            @foreach (var grupo in Model.PorDia())
            {
                <div class="mb-3">
                    <h6 class="fw-bold text-uppercase small text-muted mb-2">
                        @PeriodoAgenda.DiaCurto(grupo.Key.DayOfWeek), @grupo.Key.Day de @PeriodoAgenda.NomeDoMes(grupo.Key.Month)
                        @if (grupo.Key == hoje)
                        {
                            <span class="badge rounded-pill bg-primary ms-1">hoje</span>
                        }
                    </h6>
                    <div class="list-group shadow-sm">
                        @foreach (var aula in grupo.OrderBy(a => a.DataHora))
                        {
                            <button type="button" class="list-group-item list-group-item-action d-flex align-items-center gap-3"
                                    data-aula="@aula.Id">
                                @* Hora de início em cima, fim embaixo: com aulas de 1h30 e 2h na
                                   mesma coluna, só o começo não diz quando a quadra vaga. *@
                                <span class="fw-bold text-center lh-1" style="min-width:52px; color: var(--pdz-ink);">
                                    @aula.DataHora.ToString("HH:mm")
                                    <small class="d-block fw-normal text-muted" style="font-size:.72rem;">
                                        @DuracaoDaAula.Fim(aula).ToString("HH:mm")
                                    </small>
                                </span>
                                <span class="rounded-circle flex-shrink-0" style="width:10px;height:10px;background:@CorDa(aula);"></span>
                                <span class="flex-grow-1 text-start">
                                    <strong style="color: var(--pdz-ink);">@NomeDoAluno(aula)</strong>
                                    <small class="d-block text-muted">
                                        <i class="bi bi-geo-alt-fill text-danger"></i> @aula.LocalAula.Nome
                                        · @aula.Preco.ToString("C")
                                        @* O tamanho vai junto do preço porque é ele que explica
                                           a diferença: R$ 110 numa linha e R$ 150 na outra, sem
                                           nada na tela dizendo por quê, parece erro. Individual
                                           fica calado — é a maioria, e escrever em toda linha
                                           viraria ruído na tela que ele abre o dia todo. *@
                                        @if (aula.QuantidadeAlunos > 1)
                                        {
                                            <span class="ms-1"><i class="bi bi-people-fill"></i> @PrecoDaAula.Rotulo(aula.QuantidadeAlunos).ToLowerInvariant()</span>
                                        }
                                        @if (aula.RecorrenciaId != null)
                                        {
                                            <span class="ms-1"><i class="bi bi-arrow-repeat"></i> recorrente</span>
                                        }
                                    </small>
                                </span>
                                <span class="badge" style="background:@CorDa(aula);">@aula.Status</span>
                            </button>
                        }
                    </div>
                </div>
            }
        }
    }

    @* Legenda: as cores só ajudam se alguém disser o que elas querem dizer. *@
    <div class="d-flex gap-3 flex-wrap mt-3 small text-muted">
        @foreach (var s in new[] { "Pendente", "Confirmada", "Realizada", PoliticaAula.ARecuperar, "Cancelada" })
        {
            <span><span class="d-inline-block rounded-circle me-1" style="width:10px;height:10px;background:@CorDe(s);"></span>@s</span>
        }
        @* O âmbar do dinheiro em aberto — a mesma régua e a mesma cor do selo do modal. *@
        <span><span class="d-inline-block rounded-circle me-1" style="width:10px;height:10px;background:#c78a1e;"></span>A receber</span>
    </div>
</div>

@* Um modal só, preenchido por JS: com 30 aulas na tela, 30 modais seria peso à toa. *@
<div class="modal fade" id="modalAula" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="mAluno">Aula</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <p class="mb-1"><i class="bi bi-clock"></i> <span id="mQuando"></span></p>
                <p class="mb-1"><i class="bi bi-geo-alt-fill text-danger"></i> <span id="mLocal"></span></p>
                <p class="mb-1"><i class="bi bi-cash text-success"></i> <span id="mPreco"></span> <span class="text-muted" id="mTamanho"></span></p>
                @* Quantos vêm muda o treino e quantas bolas levar — some quando o aluno vem só. *@
                <p class="mb-1 d-none" id="mAcompanhantesLinha">
                    <i class="bi bi-people-fill"></i> Vem mais gente: <span id="mAcompanhantes"></span>
                </p>
                @* Só na aula que repõe outra: é o que explica o R$ 0,00 logo acima. *@
                <p class="mb-1 d-none small text-muted" id="mReposicaoLinha">
                    <i class="bi bi-arrow-counterclockwise"></i> <span id="mReposicao"></span> — já cobrada lá.
                </p>
                <p class="mb-0">
                    <span class="badge" id="mStatus"></span>
                    @* Recebimento é um eixo À PARTE do status (ver Models/Aula.PagaEm): a aula
                       pode estar "Realizada" e o dinheiro não ter entrado. Duas etiquetas
                       porque são duas perguntas. *@
                    <span class="badge d-none" id="mRecebimento"></span>
                </p>
                @* Qual aula está fora do Google — o aviso do topo dá o total, este diz quem. *@
                <p class="mb-0 mt-2 small text-warning d-none" id="mForaDoGoogle">
                    <i class="bi bi-calendar-x"></i> Esta aula não está na sua Google Agenda.
                </p>
            </div>
            <div class="modal-footer flex-wrap gap-2">
                <a href="#" id="mWhats" class="btn btn-sm btn-success rounded-pill fw-bold d-none" target="_blank">
                    <i class="bi bi-whatsapp"></i> Chamar aluno
                </a>
                <a href="#" id="mAnotacoes" class="btn btn-sm btn-outline-secondary rounded-pill fw-bold">
                    <i class="bi bi-journal-text"></i> Anotações
                </a>
                @* Editar em vez de apagar e lançar de novo: apagar leva as anotações junto e
                   troca o id, matando o link do caderno que o aluno já tem. *@
                <a href="#" id="mEditar" class="btn btn-sm btn-outline-primary rounded-pill fw-bold d-none">
                    <i class="bi bi-pencil"></i> Editar
                </a>

                <form asp-action="ConfirmarSolicitacao" method="post" class="d-none" id="fAceitar">
                    <input type="hidden" name="aulaId" id="mAceitarId" />
                    <input type="hidden" name="aceitar" value="true" />
                    <button type="submit" class="btn btn-sm btn-success"><i class="bi bi-check2"></i> Aceitar</button>
                </form>
                <form asp-action="ConfirmarSolicitacao" method="post" class="d-none" id="fRecusar">
                    <input type="hidden" name="aulaId" id="mRecusarId" />
                    <input type="hidden" name="aceitar" value="false" />
                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-x"></i> Recusar</button>
                </form>
                @* "Concluir" deixou de querer dizer "recebi" (pedido do Felipe em 25/08/2026:
                   "tem alunos que pagam depois ou por mês"). Os dois botões ficam lado a lado,
                   do mesmo tamanho, porque o clique de fechar a aula é o MESMO instante em que
                   o professor sabe se o dinheiro entrou — deixar pra depois é o passo que
                   ninguém dá, e era assim que aula não paga entrava no "Recebido". *@
                <form asp-action="AtualizarStatus" method="post" class="d-none" id="fConcluirPago">
                    <input type="hidden" name="aulaId" id="mConcluirPagoId" />
                    <input type="hidden" name="novoStatus" value="Realizada" />
                    <input type="hidden" name="recebido" value="true" />
                    <button type="submit" class="btn btn-sm btn-success">
                        <i class="bi bi-check2-all"></i> Concluir e recebi
                    </button>
                </form>
                <form asp-action="AtualizarStatus" method="post" class="d-none" id="fConcluir">
                    <input type="hidden" name="aulaId" id="mConcluirId" />
                    <input type="hidden" name="novoStatus" value="Realizada" />
                    <input type="hidden" name="recebido" value="false" />
                    <button type="submit" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-check2"></i> Concluir, receber depois
                    </button>
                </form>

                @* O Pix que chega na sexta pela aula de terça: dar baixa é outro momento, e a
                   aula já está concluída quando ele chega. *@
                <form asp-action="MarcarRecebida" method="post" class="d-none" id="fRecebi">
                    <input type="hidden" name="aulaId" id="mRecebiId" />
                    <input type="hidden" name="recebida" value="true" />
                    <button type="submit" class="btn btn-sm btn-outline-success">
                        <i class="bi bi-cash-coin"></i> Recebi
                    </button>
                </form>
                <form asp-action="MarcarRecebida" method="post" class="d-none" id="fNaoRecebi">
                    <input type="hidden" name="aulaId" id="mNaoRecebiId" />
                    <input type="hidden" name="recebida" value="false" />
                    <button type="submit" class="btn btn-sm btn-link text-muted text-decoration-none">
                        <i class="bi bi-arrow-counterclockwise"></i> Não recebi
                    </button>
                </form>
                @* "Vai recuperar": o aluno não vem, a aula é cobrada assim mesmo e o horário
                   fica livre pra outro. Fica ao lado de Cancelar de propósito — é a escolha
                   que o professor faz no mesmo instante, e sobre o mesmo aluno. *@
                <form asp-action="MarcarParaRecuperar" method="post" class="d-none" id="fRecuperar">
                    <input type="hidden" name="aulaId" id="mRecuperarId" />
                    <button type="submit" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-arrow-counterclockwise"></i> Vai recuperar
                    </button>
                </form>
                <form asp-action="AtualizarStatus" method="post" class="d-none" id="fCancelar">
                    <input type="hidden" name="aulaId" id="mCancelarId" />
                    <input type="hidden" name="novoStatus" value="Cancelada" />
                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-x-circle"></i> Cancelar</button>
                </form>

                @* Apagar é o desfazer de quem lançou errado — dia trocado, série criada duas
                   vezes, aluno errado. Diferente de Cancelar, que é um fato registrado e
                   continua na tela. Sempre disponível, inclusive em aula já cancelada, que é
                   justamente a que o professor quer tirar da frente. *@
                <form asp-action="ExcluirAula" method="post" id="fExcluir">
                    <input type="hidden" name="aulaId" id="mExcluirId" />
                    <button type="submit" class="btn btn-sm btn-link text-danger text-decoration-none">
                        <i class="bi bi-trash"></i> Apagar
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@* O _Layout só tem seção "Scripts" — o CSS fica no corpo mesmo, em vez de mudar um
   layout que todas as telas usam por causa de uma. *@
<style>
        .pdz-chip {
            display: block; width: 100%; border: 0; border-radius: 4px;
            color: #fff; font-size: .72rem; line-height: 1.25;
            padding: 2px 5px; margin-bottom: 2px; text-align: left;
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
            cursor: pointer;
        }
        .pdz-chip:hover { filter: brightness(1.12); }
        .pdz-fora-do-mes { background: rgba(128,128,128,.07); }
        .pdz-col-hoje { background: rgba(44,111,187,.06); }
        .pdz-hoje {
            background: var(--padel-green, #2e9e5b); color: #fff;
            border-radius: 50%; width: 22px; height: 22px;
            display: inline-flex; align-items: center; justify-content: center;
        }
        .pdz-mes td { vertical-align: top; }
        /* O mês não cabe em tela de celular sem encolher: 7 colunas com nome de aluno. */
        @@media (max-width: 576px) {
            .pdz-mes td { height: 82px !important; }
            .pdz-chip { font-size: .62rem; }
        }

        /* ── Grade de Dia/Semana: cada aula ocupa o tanto de altura que a duração dela pede
           (1px por minuto), do jeito que a Google Agenda mostra — em vez de um chip de
           tamanho fixo dentro de uma hora cheia, que fazia uma aula de 30 min parecer do
           mesmo tamanho que uma de 2h e escondia o buraco livre entre uma aula e outra. */
        /* Quem rola é o wrapper, com as DUAS faixas dentro — ver o comentário no HTML. */
        .pdz-grade-rolagem { overflow-x: auto; }

        /* ⚠️ `width: max-content` COM `min-width: 100%`: sem o max-content as duas faixas
           parariam na largura do card e as colunas se espremeriam; sem o min-width elas
           encolheriam abaixo do card em tela larga, deixando um vão à direita. Juntos dão as
           duas coisas — preenche no desktop, cresce e rola no celular — e, o que mais
           importa aqui, dão a MESMA largura pras duas, que é o que mantém o dia alinhado
           com a coluna dele. */
        .pdz-grade-cabecalho, .pdz-grade-corpo { display: flex; width: max-content; min-width: 100%; }
        .pdz-grade-corpo { position: relative; }
        .pdz-grade-gutter { flex: 0 0 56px; position: relative; }
        .pdz-grade-col-cabecalho {
            flex: 1 1 0; min-width: 96px; border-left: 1px solid var(--pdz-border, #e2e5ea);
            /* A grade estilo Google (25/08) alargou as colunas e o cabecalho ficou GRITANDO
               em cima de cards de .68rem — reclamacao de professor em 28/08: "aumentou a
               fonte do calendario, antes era menor". O rotulo do dia e orientacao, nao
               conteudo; menor que o conteudo e o tamanho certo dele. */
            font-size: .72rem;
        }
        .pdz-grade-coluna {
            flex: 1 1 0; min-width: 96px; position: relative;
            border-left: 1px solid var(--pdz-border, #e2e5ea);
            cursor: pointer;
        }
        .pdz-hora-rotulo {
            position: absolute; right: 6px; transform: translateY(-50%);
            font-size: .68rem; color: var(--pdz-ink-fraco, #8a93a3); white-space: nowrap;
        }
        .pdz-linha-hora {
            position: absolute; left: 0; right: 0; border-top: 1px solid var(--pdz-border, #eef0f3);
            pointer-events: none;
        }
        .pdz-evento {
            position: absolute; left: 2px; right: 2px; min-height: 16px;
            border: 0; border-radius: 4px; color: #fff; font-size: .68rem; line-height: 1.15;
            padding: 2px 4px; text-align: left; white-space: nowrap; overflow: hidden;
            text-overflow: ellipsis; cursor: pointer; z-index: 2;
        }
        .pdz-evento:hover { filter: brightness(1.12); }
        @@media (max-width: 576px) {
            .pdz-grade-gutter { flex-basis: 44px; }
            .pdz-grade-col-cabecalho, .pdz-grade-coluna { min-width: 76px; }
            .pdz-grade-col-cabecalho { font-size: .65rem; }
            .pdz-evento { font-size: .6rem; }
        }
</style>

@section Scripts {
    <script>
        (function () {
            // Os dados das aulas vêm do servidor de uma vez: clicar num chip não pode
            // depender de rede, senão no ginásio (3G ruim) o professor clica e não abre nada.
            var AULAS = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                Model.NoPeriodo.Select(a => new {
                    id = a.Id,
                    aluno = a.NomeCompletoAluno ?? (a.Aluno != null ? a.Aluno.Nome : (a.NomeAlunoAvulso ?? "Aluno avulso")),
                    acompanhantes = a.Acompanhantes,
                    // Com duração de verdade, a aula tem fim: "14/08/2026 às 17:00 às 19:00"
                    // ficaria pior que dizer o intervalo de uma vez.
                    quando = a.DataHora.ToString("dd/MM/yyyy") + " · " + DuracaoDaAula.Faixa(a.DataHora, a.DuracaoMinutos),
                    local = a.LocalAula.Nome,
                    preco = a.Preco.ToString("C"),
                    // "Individual"/"Em dupla"/"Em trio" — sem isto o professor via R$ 150 numa
                    // aula e R$ 110 na outra sem nada na tela explicando a diferença.
                    tamanho = PrecoDaAula.Rotulo(a.QuantidadeAlunos),
                    status = a.Status,
                    // As duas perguntas do recebimento, respondidas pela MESMA régua do
                    // servidor (Services/RecebimentoDaAula) — refazer a conta em JS é como as
                    // duas telas passam a discordar sobre dinheiro.
                    // ⚠️ Na turma o card traz o PagaEm da SESSÃO: só paga quando todos pagaram.
                    paga = RecebimentoDaAula.EstaPaga(a),
                    aReceber = RecebimentoDaAula.EstaAReceber(a),
                    pagaEm = a.PagaEm != null ? a.PagaEm.Value.ToString("dd/MM") : null,
                    // Por que esta aula custa R$ 0,00. Sem isto, o professor abre a agenda duas
                    // semanas depois e vê uma aula de graça sem nenhuma explicação na tela.
                    reposicaoDe = a.RecuperaAula != null
                        ? Reposicao.EtiquetaDaReposicao(a.RecuperaAula.DataHora)
                        : null,
                    iso = a.DataHora.ToString("o"),
                    // Só aula de pé se edita — realizada e cancelada já viraram fato (ver
                    // Services/EdicaoDeAula).
                    podeEditar = EdicaoDeAula.PodeEditar(a),
                    // Aula sem evento no Google. Só vira aviso com a conta conectada: sem ela,
                    // "não está no Google" valeria pra todas e não seria notícia nenhuma.
                    foraDoGoogle = Model.GoogleConectado && a.GoogleEventId == null
                                   && a.Status == "Confirmada" && a.DataHora >= DateTime.Now,
                    // A frase da confirmação muda com o que está em jogo: apagar lançamento
                    // errado de ontem não é o mesmo que desmarcar quem está esperando.
                    confirmacaoExcluir = ExclusaoDeAula.Confirmacao(a, DateTime.Now),
                    whats = string.IsNullOrEmpty(a.Aluno != null ? a.Aluno.Celular : a.TelefoneAlunoAvulso)
                        ? null
                        : WhatsAppLinkHelper.GerarLink(
                            (a.Aluno != null ? a.Aluno.Celular : a.TelefoneAlunoAvulso)!,
                            $"Olá, {(a.Aluno != null ? a.Aluno.Nome : a.NomeAlunoAvulso)}! Tudo certo para a nossa aula de Padel dia {a.DataHora:dd/MM}?")
                })));

            var porId = {};
            AULAS.forEach(function (a) { porId[a.id] = a; });

            var modalEl = document.getElementById('modalAula');
            var modal = new bootstrap.Modal(modalEl);
            var cores = {
                'Pendente': '#f0ad4e', 'Confirmada': '#2c6fbb', 'Realizada': '#2e9e5b',
                '@PoliticaAula.ARecuperar': '#7a5cbf'
            };

            function mostrar(id) {
                var a = porId[id];
                if (!a) return;

                document.getElementById('mAluno').textContent = a.aluno;
                document.getElementById('mQuando').textContent = a.quando;
                document.getElementById('mLocal').textContent = a.local;
                document.getElementById('mPreco').textContent = a.preco;
                // Só quando não é individual: escrever "Individual" em toda aula seria ruído
                // na tela que o professor abre trinta vezes por dia.
                document.getElementById('mTamanho').textContent = a.tamanho === 'Individual' ? '' : '· ' + a.tamanho;

                document.getElementById('mAcompanhantesLinha').classList.toggle('d-none', !a.acompanhantes);
                document.getElementById('mAcompanhantes').textContent = a.acompanhantes || '';

                document.getElementById('mReposicaoLinha').classList.toggle('d-none', !a.reposicaoDe);
                document.getElementById('mReposicao').textContent = a.reposicaoDe || '';

                var badge = document.getElementById('mStatus');
                badge.textContent = a.status;
                badge.style.background = cores[a.status] || '#b34a4a';

                // Verde só quando o dinheiro entrou. "A receber" fica em âmbar e não em
                // vermelho: não é erro nem atraso, é a conta ainda aberta.
                var recebimento = document.getElementById('mRecebimento');
                recebimento.classList.toggle('d-none', !a.paga && !a.aReceber);
                recebimento.textContent = a.paga ? 'Recebido em ' + a.pagaEm : 'A receber';
                recebimento.style.background = a.paga ? '#2e9e5b' : '#c78a1e';

                // Cada ação aparece só onde faz sentido: aceitar/recusar em Pendente,
                // concluir/cancelar em Confirmada. Aula Realizada ou Cancelada não volta.
                function alterna(formId, campoId, visivel) {
                    document.getElementById(formId).classList.toggle('d-none', !visivel);
                    document.getElementById(campoId).value = a.id;
                }
                alterna('fAceitar', 'mAceitarId', a.status === 'Pendente');
                alterna('fRecusar', 'mRecusarId', a.status === 'Pendente');
                alterna('fConcluirPago', 'mConcluirPagoId', a.status === 'Confirmada');
                alterna('fConcluir', 'mConcluirId', a.status === 'Confirmada');
                alterna('fCancelar', 'mCancelarId', a.status === 'Confirmada');
                // "Recebi" só onde há o que receber, e "Não recebi" só onde há o que desfazer:
                // os dois juntos ofereceriam desfazer um recebimento que nunca houve.
                alterna('fRecebi', 'mRecebiId', a.aReceber);
                alterna('fNaoRecebi', 'mNaoRecebiId', a.paga);
                // Mesma janela do Cancelar: é a escolha entre "desmarca e não cobra" e
                // "não vem, paga e repõe" — as duas sobre uma aula que ainda está de pé.
                alterna('fRecuperar', 'mRecuperarId', a.status === 'Confirmada');
                // Apagar vale em qualquer status — o erro de lançamento pode estar em todos.
                document.getElementById('mExcluirId').value = a.id;

                var whats = document.getElementById('mWhats');
                whats.classList.toggle('d-none', !a.whats || a.status === 'Pendente');
                if (a.whats) whats.href = a.whats;

                // Mudar horário/local/valor sem apagar a aula.
                var editar = document.getElementById('mEditar');
                editar.classList.toggle('d-none', !a.podeEditar);
                editar.href = '/Aulas/Editar/' + a.id;

                // Por que ESTA aula não está no Google: sem isso o professor só via o total no
                // topo, sem saber quais eram.
                document.getElementById('mForaDoGoogle').classList.toggle('d-none', !a.foraDoGoogle);

                // O caderno da aula: sempre disponível — anotar vale antes ("focar na
                // bandeja") e depois ("evoluiu no voleio") da aula acontecer.
                document.getElementById('mAnotacoes').href = '/Aulas/Anotacoes/' + a.id;

                modal.show();
            }

            document.querySelectorAll('[data-aula]').forEach(function (el) {
                el.addEventListener('click', function () { mostrar(parseInt(el.dataset.aula, 10)); });
            });

            function doisDigitos(n) { return n < 10 ? '0' + n : '' + n; }

            // Clicar num espaço VAZIO da grade de Dia/Semana já abre "Adicionar Aula" com o
            // horário daquele espaço — estilo Google Agenda (pedido do Felipe, 23/08/2026).
            document.querySelectorAll('.pdz-grade-coluna').forEach(function (coluna) {
                coluna.addEventListener('click', function (e) {
                    // 🐛 Clique numa AULA borbulha até aqui — o card ([data-aula]) mora DENTRO
                    // da coluna, e o comentário antigo dizia que "nunca chega a borbulhar":
                    // dizia errado, nada impedia. O professor clicava no card pra concluir e a
                    // página navegava pro "Adicionar Aula" por cima do modal (28/08/2026).
                    if (e.target.closest('[data-aula]')) return;

                    var retangulo = coluna.getBoundingClientRect();
                    var pxPorMinuto = parseFloat(coluna.dataset.pxPorMinuto) || 1;
                    var primeiraHora = parseInt(coluna.dataset.primeiraHora, 10) || 0;

                    var minutosDoTopo = (e.clientY - retangulo.top) / pxPorMinuto;
                    // Arredonda pros 15 min mais próximos — ninguém precisa marcar aula às 9h03.
                    minutosDoTopo = Math.round(minutosDoTopo / 15) * 15;

                    var totalMinutos = primeiraHora * 60 + minutosDoTopo;
                    var hora = Math.floor(totalMinutos / 60);
                    var minuto = totalMinutos % 60;

                    var dataHora = coluna.dataset.dia + 'T' + doisDigitos(hora) + ':' + doisDigitos(minuto);
                    window.location.href = '@Url.Action("AdicionarManual", "Aulas")?dataHora=' + encodeURIComponent(dataHora);
                });
            });

            // Mesma política de 24h que já existia: cancelar em cima da hora cobra o aluno,
            // e o professor precisa saber disso ANTES de confirmar.
            document.getElementById('fCancelar').addEventListener('submit', function (e) {
                var a = porId[parseInt(document.getElementById('mCancelarId').value, 10)];
                var horas = a ? (new Date(a.iso) - new Date()) / 36e5 : 99;
                var msg = horas < 24
                    ? 'Essa aula é em menos de 24 horas. Pela política do Padelizou, o aluno deve ser cobrado normalmente mesmo com o cancelamento. Confirmar o cancelamento mesmo assim?'
                    : 'Confirmar o cancelamento desta aula?';
                if (!confirm(msg)) e.preventDefault();
            });

            // Apagar não tem volta e some do histórico — a confirmação explica isso, e explica
            // diferente quando tem alguém do outro lado esperando (ver Services/ExclusaoDeAula).
            document.getElementById('fExcluir').addEventListener('submit', function (e) {
                var a = porId[parseInt(document.getElementById('mExcluirId').value, 10)];
                if (!confirm(a ? a.confirmacaoExcluir : 'Apagar esta aula?')) e.preventDefault();
            });
        })();
    </script>
}
