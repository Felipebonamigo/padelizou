@model IEnumerable<LocalAula>
@{
    ViewData["Title"] = "Adicionar Aula - Padelizou";

    // Os acordos particulares deste professor ("o Pedro paga 90"), pra tela já sugerir o valor
    // certo quando ele digita o nome de um aluno que tem preço combinado.
    var precosCombinados = ViewBag.PrecosCombinados as Dictionary<string, decimal> ?? new Dictionary<string, decimal>();

    // A tabela de preços de cada local vai inteira pro JS: trocar o tamanho da aula não pode
    // depender de rede, senão na quadra com sinal ruim o campo fica vazio.
    var tabelaDeLocais = Model.ToDictionary(
        l => l.Id,
        l => new { individual = l.PrecoPadrao, dupla = l.PrecoDupla, trio = l.PrecoTrio });
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-7">
            @* Era a única tela do painel sem saída: quem abria e desistia só voltava pelo
               botão do navegador (ou pelo menu, dando a volta pelo perfil). *@
            <a asp-controller="Aulas" asp-action="Dashboard" class="btn btn-outline-secondary rounded-pill mb-3">
                <i class="bi bi-arrow-left"></i> Voltar ao Painel
            </a>

            <div class="card shadow-sm border-0" style="border-top: 4px solid var(--padel-green);">
                <div class="card-body p-4 p-md-5">
                    <div class="text-center mb-4">
                        <i class="bi bi-calendar-plus display-4" style="color: var(--padel-green);"></i>
                        <h3 class="fw-bold mt-2" style="color: var(--pdz-ink);">Adicionar Aula</h3>
                        <p class="text-muted">Para alunos que combinaram com você fora do sistema.</p>
                    </div>

                    @if (TempData["Erro"] != null)
                    {
                        <div class="alert alert-danger">@TempData["Erro"]</div>
                    }

                    @if (!Model.Any())
                    {
                        <div class="alert alert-warning">
                            Você ainda não tem nenhum local ativo cadastrado.
                            <a asp-action="MeusLocais">Cadastre um local</a> antes de adicionar uma aula.
                        </div>
                    }
                    else
                    {
                        <form asp-controller="Aulas" asp-action="AdicionarManual" method="post">
                            <div class="mb-3">
                                <label class="form-label fw-bold text-muted small">Local</label>
                                <select id="select-local" name="localId" class="form-select bg-light" required>
                                    <option value="">-- Escolha um local --</option>
                                    @foreach (var local in Model)
                                    {
                                        <option value="@local.Id">
                                            @local.Nome (R$ @local.PrecoPadrao.ToString("N2"))
                                        </option>
                                    }
                                </select>
                            </div>

                            @* Quantos alunos dividem a quadra. Não é detalhe: é o que muda o
                               preço. O professor de verdade que estreou o sistema cobrava três
                               valores diferentes e a agenda só sabia de um. *@
                            <div class="mb-3">
                                <label class="form-label fw-bold text-muted small">Quantos alunos nessa aula</label>
                                <div class="btn-group w-100" role="group" aria-label="Quantidade de alunos">
                                    @foreach (var (valor, rotulo) in new[] { (1, "Individual"), (2, "Em dupla"), (3, "Em trio") })
                                    {
                                        <input type="radio" class="btn-check" name="quantidadeAlunos" id="qtd-@valor"
                                               value="@valor" autocomplete="off" checked="@(valor == 1)" />
                                        <label class="btn btn-outline-primary" for="qtd-@valor">@rotulo</label>
                                    }
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold text-muted small">Nome do aluno</label>
                                <input type="text" name="nomeAluno" id="input-nome-aluno" class="form-control bg-light" required maxlength="100" />
                                @* Aparece só quando o nome digitado bate com um acordo. É o
                                   aviso de que o valor sugerido não é o da tabela do local. *@
                                <div class="form-text text-success d-none" id="aviso-preco-combinado"></div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold text-muted small">Telefone / WhatsApp</label>
                                <input type="text" name="telefoneAluno" class="form-control bg-light" required
                                       data-mascara="celular" inputmode="numeric" placeholder="(00) 00000-0000" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold text-muted small">Data e hora</label>
                                <input type="datetime-local" name="dataHora" class="form-control bg-light" required />
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold text-muted small">Preço (deixe vazio pra usar o sugerido)</label>
                                <input type="number" step="0.01" min="0" name="preco" id="input-preco" class="form-control bg-light" />
                            </div>

                            <div class="form-check mb-3">
                                <input type="checkbox" class="form-check-input" id="check-recorrente" name="recorrente" value="true" />
                                <label class="form-check-label" for="check-recorrente">Aula fixa toda semana nesse horário?</label>
                            </div>

                            <div class="mb-4" id="grupo-semanas" style="display:none;">
                                <label class="form-label fw-bold text-muted small">Repetir por quantas semanas (incluindo essa)?</label>
                                <input type="number" min="2" max="26" value="4" name="semanasRecorrencia" class="form-control bg-light" />
                            </div>

                            <button type="submit" class="btn btn-padel btn-lg w-100 rounded-pill">
                                <i class="bi bi-check-circle-fill me-1"></i> Adicionar Aula
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            var $checkRecorrente = $('#check-recorrente');
            var $grupoSemanas = $('#grupo-semanas');
            var $selectLocal = $('#select-local');
            var $inputPreco = $('#input-preco');
            var $inputNome = $('#input-nome-aluno');
            var $avisoCombinado = $('#aviso-preco-combinado');

            // A tabela de preços de cada local e os acordos por aluno, mandados de uma vez pelo
            // servidor. O preço tem que aparecer no instante em que o professor escolhe o
            // tamanho da aula, e uma ida ao servidor por clique falharia na quadra sem sinal.
            var LOCAIS = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(tabelaDeLocais));
            var COMBINADOS = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(precosCombinados));

            $checkRecorrente.on('change', function () {
                $grupoSemanas.toggle(this.checked);
            });

            // Mesma conta do servidor (Services/PrecoDaAula): sem preço pro tamanho pedido,
            // cai pro tamanho menor mais próximo que o professor informou. Se as duas contas
            // discordarem, o professor vê um valor e salva outro.
            function precoDoLocal(local, quantos) {
                if (quantos === 3) return local.trio ?? local.dupla ?? local.individual;
                if (quantos === 2) return local.dupla ?? local.individual;
                return local.individual;
            }

            // O acordo particular vale na aula INDIVIDUAL daquele aluno: o desconto foi dado a
            // uma pessoa, não à quadra inteira. Em dupla ou trio manda o preço do tamanho.
            function combinadoDoNome(nome) {
                var chave = 'avulso-' + (nome || '').trim().toLowerCase();
                return Object.prototype.hasOwnProperty.call(COMBINADOS, chave) ? COMBINADOS[chave] : null;
            }

            function atualizarSugestao() {
                var local = LOCAIS[$selectLocal.val()];
                if (!local) {
                    $inputPreco.attr('placeholder', '');
                    $avisoCombinado.addClass('d-none');
                    return;
                }

                var quantos = parseInt($('input[name="quantidadeAlunos"]:checked').val(), 10) || 1;
                var combinado = quantos === 1 ? combinadoDoNome($inputNome.val()) : null;
                var preco = combinado !== null ? combinado : precoDoLocal(local, quantos);

                $inputPreco.attr('placeholder', 'R$ ' + Number(preco).toFixed(2));

                $avisoCombinado.toggleClass('d-none', combinado === null);
                if (combinado !== null) {
                    $avisoCombinado.text('Preço combinado com esse aluno: R$ ' + Number(combinado).toFixed(2) + '.');
                }
            }

            $selectLocal.on('change', atualizarSugestao);
            $('input[name="quantidadeAlunos"]').on('change', atualizarSugestao);
            $inputNome.on('input', atualizarSugestao);
        });
    </script>
}
