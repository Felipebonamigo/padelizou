@model IEnumerable<LocalAula>
@{
    ViewData["Title"] = "Adicionar Aula - Padelizou";

    // Os acordos particulares deste professor ("o Pedro paga 90"), pra tela já sugerir o valor
    // certo quando ele digita o nome de um aluno que tem preço combinado.
    var precosCombinados = ViewBag.PrecosCombinados as Dictionary<string, decimal> ?? new Dictionary<string, decimal>();

    // A tabela de preços de cada local vai inteira pro JS: trocar o tamanho da aula não pode
    // depender de rede, senão na quadra com sinal ruim o campo fica vazio.
    var tabelaDeLocais = Model.ToDictionary(
        l => l.Id,
        l => new
        {
            individual = l.PrecoPadrao,
            // Mapa tamanho -> preço, e não um campo por tamanho: o teto já subiu uma vez
            // (de trio pra sexteto, pelo beach) e com campos fixos ele sobe de novo aqui.
            turmas = PrecoDaAula.PorTamanho(l.PrecosDeTurma),
        });

    // Quem já fez aula com este professor. Vai inteiro pro JS pelo mesmo motivo dos preços:
    // filtrar no navegador funciona com o sinal que a quadra tiver.
    var meusAlunos = ViewBag.MeusAlunos as List<Padelizou.Services.AlunoDoProfessor>
                     ?? new List<Padelizou.Services.AlunoDoProfessor>();
    var alunosParaJs = meusAlunos.Select(a => new
    {
        alunoId = a.AlunoId,
        nome = a.Nome,
        celular = a.Celular,
        total = a.TotalDeAulas,
        recorrente = a.Recorrente,
        temConta = a.TemConta,
    });
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-7">
            @* Era a única tela do painel sem saída: quem abria e desistia só voltava pelo
               botão do navegador (ou pelo menu, dando a volta pelo perfil). *@
            <a asp-controller="Aulas" asp-action="Dashboard" class="btn btn-outline-secondary rounded-pill mb-3">
                <i class="bi bi-arrow-left"></i> Voltar ao Painel
            </a>

            <div class="card shadow-sm border-0" style="border-top: 4px solid var(--padel-green);">
                <div class="card-body p-4 p-md-5">
                    <div class="text-center mb-4">
                        <i class="bi bi-calendar-plus display-4" style="color: var(--padel-green);"></i>
                        <h3 class="fw-bold mt-2" style="color: var(--pdz-ink);">Adicionar Aula</h3>
                        <p class="text-muted">Para alunos que combinaram com você fora do sistema.</p>
                    </div>

                    @if (TempData["Erro"] != null)
                    {
                        <div class="alert alert-danger">@TempData["Erro"]</div>
                    }

                    @if (!Model.Any())
                    {
                        <div class="alert alert-warning">
                            Você ainda não tem nenhum local ativo cadastrado.
                            <a asp-action="MeusLocais">Cadastre um local</a> antes de adicionar uma aula.
                        </div>
                    }
                    else
                    {
                        <form asp-controller="Aulas" asp-action="AdicionarManual" method="post">
                            <div class="mb-3">
                                <label class="form-label fw-bold text-muted small">Local</label>
                                <select id="select-local" name="localId" class="form-select bg-light" required>
                                    <option value="">-- Escolha um local --</option>
                                    @foreach (var local in Model)
                                    {
                                        <option value="@local.Id">
                                            @local.Nome (R$ @local.PrecoPadrao.ToString("N2"))
                                        </option>
                                    }
                                </select>
                            </div>

                            @* Nasce em Padel — quem só dá padel nem repara nesse campo. Existe pro
                               professor que também dá tênis/beach tênis (Services/EsporteDaAula). *@
                            <div class="mb-3">
                                <label class="form-label fw-bold text-muted small" for="select-esporte">Esporte</label>
                                <select name="esporte" id="select-esporte" class="form-select bg-light">
                                    @foreach (var opcao in (IEnumerable<string>)ViewBag.Esportes)
                                    {
                                        <option value="@opcao" selected="@(opcao == Padelizou.Services.EsporteDaAula.Padrao)">@opcao</option>
                                    }
                                </select>
                            </div>

                            @* Quantos alunos dividem a quadra. Não é detalhe: é o que muda o
                               preço. O professor de verdade que estreou o sistema cobrava três
                               valores diferentes e a agenda só sabia de um. *@
                            <div class="mb-3">
                                <label class="form-label fw-bold text-muted small">Quantos alunos nessa aula</label>
                                @* Só o NÚMERO em cada botão. Com o teto em seis (turma de beach),
                                   "Individual / Em dupla / Em trio / Em quarteto / ..." não cabe
                                   na largura de um celular — e é na beira da quadra que esta tela
                                   é usada. O nome do tamanho aparece embaixo, no que está marcado. *@
                                <div class="btn-group w-100" role="group" aria-label="Quantidade de alunos">
                                    @for (var valor = PrecoDaAula.MinAlunos; valor <= PrecoDaAula.MaxAlunos; valor++)
                                    {
                                        <input type="radio" class="btn-check" name="quantidadeAlunos" id="qtd-@valor"
                                               value="@valor" autocomplete="off" checked="@(valor == 1)" />
                                        <label class="btn btn-outline-primary" for="qtd-@valor"
                                               title="@PrecoDaAula.Rotulo(valor)">@valor</label>
                                    }
                                </div>
                                <small class="text-muted d-block mt-1" id="rotulo-tamanho">@PrecoDaAula.Rotulo(1)</small>
                            </div>

                            <div id="bloco-aluno-unico">
                                <div class="mb-3">
                                    <label class="form-label fw-bold text-muted small" for="input-nome-aluno">Nome do aluno</label>
                                    <input type="text" name="nomeAluno" id="input-nome-aluno" class="form-control bg-light"
                                           required maxlength="100" autocomplete="off"
                                           placeholder="Digite pra buscar entre os seus alunos" />
                                    @* Guarda a conta do aluno escolhido. Sem isto a aula nascia
                                       como nome solto mesmo pra quem tem cadastro — e aí o aluno
                                       não via a própria aula no app. *@
                                    <input type="hidden" name="alunoId" id="input-aluno-id" value="" />

                                    @* Atalho: os alunos dele, filtrados enquanto digita. Marcar a
                                       aula do aluno de toda terça passa a ser um toque. *@
                                    <div id="lista-alunos" class="list-group mt-1 d-none"
                                         style="max-height: 240px; overflow-y: auto;"></div>

                                    <div class="d-flex align-items-center gap-2 mt-2 flex-wrap">
                                        <div id="aluno-escolhido" class="small d-none"></div>
                                        @* Procurar no cadastro do site é sob demanda, nunca por
                                           tecla: é chamada de rede, e a lista de cima já resolve
                                           o caso comum sem sair do aparelho. *@
                                        <button type="button" id="btn-buscar-sistema"
                                                class="btn btn-sm btn-outline-secondary rounded-pill d-none">
                                            <i class="bi bi-search"></i> Procurar no Padelizou
                                        </button>
                                    </div>

                                    @* Aparece só quando o nome digitado bate com um acordo. É o
                                       aviso de que o valor sugerido não é o da tabela do local. *@
                                    <div class="form-text text-success d-none" id="aviso-preco-combinado"></div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-bold text-muted small">
                                        Telefone / WhatsApp <span class="fw-normal">(opcional)</span>
                                    </label>
                                    @* Deixou de ser obrigatório em 04/08/2026: quem marca é o
                                       professor, e ele quase nunca tem o número do aluno na mão
                                       na beira da quadra. *@
                                    <input type="text" name="telefoneAluno" id="input-telefone-aluno"
                                           class="form-control bg-light"
                                           data-mascara="celular" inputmode="numeric" placeholder="(00) 00000-0000" />
                                </div>
                            </div>

                            @* Turma de 2+: cada aluno com seu nome e sua cobrança (o pedido do
                               Felipe — "cada um recebe sua cobrança individualmente"). Os blocos
                               nascem em branco toda vez que o tamanho muda: trocar de "em trio"
                               pra "em dupla" no meio do preenchimento não deveria arriscar mandar
                               o nome de um aluno pro campo errado. *@
                            <div id="blocos-turma" class="d-none mb-3"></div>

                            @* ⚠️ DOIS CAMPOS, E NÃO UM `datetime-local` (25/08/2026, pedido do Felipe).
                               No Android o `datetime-local` abre a RODINHA de rolagem, onde a data é
                               um número solto — e o motivo de o professor marcar aula olhando o
                               calendário é justamente SABER QUE DIA DA SEMANA CAI. `type="date"` abre o
                               calendário do sistema (com os dias da semana no cabeçalho) e
                               `type="time"` abre o relógio.

                               O servidor recebe os dois separados e junta em
                               Services/DataEHoraDoFormulario — parsing invariante, porque a cultura
                               pt-BR do app leria "2026-08-18" ao contrário e cairia fora calada. *@
                            <div class="mb-3">
                                <label class="form-label fw-bold text-muted small" for="input-data">Data e hora</label>
                                @* data-hora-sugerida (js/hora-sugerida.js): o seletor do celular abre no
                                   minuto atual, e o professor girava até a hora cheia toda santa aula. *@
                                <div class="row g-2">
                                    <div class="col-7">
                                        <input type="date" name="data" id="input-data" class="form-control bg-light"
                                               value="@(ViewBag.DataHoraSugerida is DateTime sugeridaData ? Padelizou.Services.DataEHoraDoFormulario.ParaCampoDeData(sugeridaData) : "")"
                                               data-hora-sugerida data-dia-da-semana="dia-da-semana" required />
                                    </div>
                                    <div class="col-5">
                                        <input type="time" name="hora" id="input-hora" class="form-control bg-light"
                                               value="@(ViewBag.DataHoraSugerida is DateTime sugeridaHora ? Padelizou.Services.DataEHoraDoFormulario.ParaCampoDeHora(sugeridaHora) : "")"
                                               data-hora-sugerida required />
                                    </div>
                                </div>
                                @* O dia da semana POR EXTENSO, embaixo do campo: o calendário mostra ele
                                   enquanto está aberto, mas depois de fechar sobra "18/08/2026" — e é
                                   exatamente essa a pergunta que o professor está respondendo.
                                   Quem escreve é js/dia-da-semana.js (global) — a mesma régua das telas
                                   de Editar e do encaixe, desde que elas passaram a ter calendário. *@
                                <div class="form-text fw-bold" id="dia-da-semana"></div>
                            </div>

                            @* Aula de padel raramente é de uma hora redonda: a quadra é alugada
                               em bloco de 1h30 ou 2h. O sistema fingia que toda aula durava 60
                               min — o evento na Google Agenda acabava no meio do treino. *@
                            <div class="mb-3">
                                <label class="form-label fw-bold text-muted small" for="select-duracao">Duração</label>
                                <select name="duracaoMinutos" id="select-duracao" class="form-select bg-light">
                                    @foreach (var minutos in Padelizou.Services.DuracaoDaAula.Opcoes)
                                    {
                                        <option value="@minutos" selected="@(minutos == Padelizou.Services.DuracaoDaAula.Padrao)">
                                            @Padelizou.Services.DuracaoDaAula.Rotulo(minutos)
                                        </option>
                                    }
                                </select>
                                <div class="form-text" id="aviso-fim-aula"></div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold text-muted small">Preço (deixe vazio pra usar o sugerido)</label>
                                <input type="number" step="0.01" min="0" name="preco" id="input-preco" class="form-control bg-light" />
                            </div>

                            @* Às vezes o aluno acerta o aluguel direto com o clube. Marcado,
                               o custo do local não conta como despesa do professor NESTA aula. *@
                            <div class="form-check mb-3">
                                <input type="checkbox" class="form-check-input" id="check-aluno-paga-quadra" name="alunoPagaQuadra" value="true" />
                                <label class="form-check-label" for="check-aluno-paga-quadra">O aluno paga a quadra por fora</label>
                                <div class="form-text">O aluguel da quadra não entra como custo seu no financeiro.</div>
                            </div>

                            <div class="form-check mb-3">
                                <input type="checkbox" class="form-check-input" id="check-recorrente" name="recorrente" value="true" />
                                <label class="form-check-label" for="check-recorrente">Aula fixa toda semana nesse horário?</label>
                            </div>

                            <div class="mb-4" id="grupo-semanas" style="display:none;">
                                @* O combinado com o aluno quase nunca tem data pra acabar. Antes
                                   o professor tinha que inventar um N: marcava 26 e a série
                                   morria calada no fim do semestre; marcava 4 e voltava aqui
                                   todo mês. "Sem prazo" repõe as semanas sozinho. *@
                                <div class="p-2 rounded mb-3" style="background: var(--pdz-surface-alt);">
                                    <div class="form-check">
                                        <input type="radio" class="form-check-input" name="semPrazo" id="prazo-contado" value="false" checked />
                                        <label class="form-check-label" for="prazo-contado">Por um número de semanas</label>
                                    </div>
                                    <div class="form-check">
                                        <input type="radio" class="form-check-input" name="semPrazo" id="prazo-indeterminado" value="true" />
                                        <label class="form-check-label" for="prazo-indeterminado">
                                            Sem prazo definido — repete até você encerrar
                                        </label>
                                    </div>
                                </div>

                                <div id="bloco-prazo-contado">
                                    <label class="form-label fw-bold text-muted small">Repetir por quantas semanas (incluindo essa)?</label>
                                    <input type="number" min="2" max="26" value="4" name="semanasRecorrencia" id="input-semanas" class="form-control bg-light" />

                                    @* As datas geradas, uma a uma, pra ele desmarcar o que não vale.
                                       "Repetir por N semanas" sozinho obrigava a adivinhar o N: mês
                                       com 5 sextas, feriado no meio, a semana da viagem — nada disso
                                       cabe num número, e o conserto era apagar aula por aula depois. *@
                                    <div class="mt-3">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <label class="form-label fw-bold text-muted small mb-0">
                                                Datas que vão ser criadas
                                            </label>
                                            <span class="small text-muted" id="contador-datas"></span>
                                        </div>
                                        <div class="border rounded p-2" id="lista-datas" style="max-height: 260px; overflow-y: auto;"></div>
                                        <div class="form-text">
                                            Desmarque as datas que não vão ter aula. Dá pra mudar a hora de cada uma.
                                        </div>
                                    </div>
                                </div>

                                <div id="bloco-prazo-indeterminado" class="alert alert-light border small mb-0" style="display:none;">
                                    <i class="bi bi-arrow-repeat"></i>
                                    As próximas <strong>@Padelizou.Services.RenovacaoDaAulaFixa.HorizonteSemanas semanas</strong>
                                    já entram na agenda, e o sistema vai repondo as seguintes sozinho.
                                    Quando o aluno parar, é só abrir uma aula da série e
                                    <strong>encerrar a repetição</strong> — as aulas já marcadas continuam lá.
                                </div>
                            </div>

                            <button type="submit" class="btn btn-padel btn-lg w-100 rounded-pill">
                                <i class="bi bi-check-circle-fill me-1"></i> Adicionar Aula
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            var $checkRecorrente = $('#check-recorrente');
            var $grupoSemanas = $('#grupo-semanas');
            var $selectLocal = $('#select-local');
            var $inputPreco = $('#input-preco');
            var $inputNome = $('#input-nome-aluno');
            var $avisoCombinado = $('#aviso-preco-combinado');
            var $inputAlunoId = $('#input-aluno-id');
            var $inputTelefone = $('#input-telefone-aluno');
            var $listaAlunos = $('#lista-alunos');
            var $escolhido = $('#aluno-escolhido');
            var $btnBuscar = $('#btn-buscar-sistema');
            // Trava pra escolher um aluno não disparar o handler que LIMPA a escolha.
            var escolhendo = false;

            // A tabela de preços de cada local e os acordos por aluno, mandados de uma vez pelo
            // servidor. O preço tem que aparecer no instante em que o professor escolhe o
            // tamanho da aula, e uma ida ao servidor por clique falharia na quadra sem sinal.
            var LOCAIS = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(tabelaDeLocais));
            var COMBINADOS = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(precosCombinados));
            var MEUS_ALUNOS = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(alunosParaJs));

            // ── As datas da aula fixa ────────────────────────────────────────────────────
            // A tela GERA as datas e o professor desmarca o que não vale. Antes ele mandava só
            // um número de semanas e descobria o estrago depois, apagando aula por aula: mês
            // com 5 sextas, feriado no meio, a semana em que ele viaja.
            var $inputData = $('#input-data');
            var $inputHora = $('#input-hora');
            var $inputSemanas = $('#input-semanas');

            // A base "yyyy-MM-ddTHH:mm" que o resto desta tela consome — o MESMO texto que o
            // `<input type="datetime-local">` mandava antes de virar dois campos. Por isso
            // nada além desta função mudou aqui embaixo.
            //
            // ⚠️ COM A HORA JUNTO, `new Date(texto)` é lido como hora LOCAL; só a data
            // ("2026-08-18") seria lida como UTC e voltaria o DIA ANTERIOR em fuso negativo —
            // ou seja, no Brasil inteiro. É por isso que quem gera datas continua recebendo a
            // string completa, e nunca só a parte da data.
            function baseDataHora() {
                var dia = $inputData.val();
                var hora = $inputHora.val();
                // O `<input type="time">` pode mandar "HH:mm:ss" quando tem step em segundos.
                return (dia && hora) ? dia + 'T' + hora.substring(0, 5) : '';
            }
            var $listaDatas = $('#lista-datas');
            var $contadorDatas = $('#contador-datas');

            var DIAS = ['dom', 'seg', 'ter', 'qua', 'qui', 'sex', 'sáb'];

            function doisDigitos(n) { return n < 10 ? '0' + n : '' + n; }

            // "yyyy-MM-ddTHH:mm" — o mesmo formato que o <input type="datetime-local"> manda e
            // que o servidor lê como invariante (Services/DatasDaAulaFixa). Montado na mão
            // porque toISOString() converte pra UTC: 08:00 de Brasília viraria 11:00.
            function paraTexto(d) {
                return d.getFullYear() + '-' + doisDigitos(d.getMonth() + 1) + '-' + doisDigitos(d.getDate())
                     + 'T' + doisDigitos(d.getHours()) + ':' + doisDigitos(d.getMinutes());
            }

            function contar() {
                var marcadas = $listaDatas.find('input[name="datas"]:checked').length;
                $contadorDatas.text(marcadas + ' de ' + $listaDatas.find('input[name="datas"]').length + ' marcadas');
            }

            function gerarDatas() {
                var base = baseDataHora();
                if (!base) {
                    $listaDatas.html('<div class="small text-muted p-2">Escolha a data e a hora da primeira aula.</div>');
                    $contadorDatas.text('');
                    return;
                }

                var primeira = new Date(base);
                if (isNaN(primeira)) return;

                var quantas = Math.min(Math.max(parseInt($inputSemanas.val(), 10) || 1, 1), 26);
                var linhas = '';

                for (var i = 0; i < quantas; i++) {
                    // setDate com o dia + 7*i atravessa virada de mês e de ano sozinho.
                    var d = new Date(primeira.getTime());
                    d.setDate(d.getDate() + 7 * i);

                    var valor = paraTexto(d);
                    var rotulo = DIAS[d.getDay()] + ', ' + doisDigitos(d.getDate()) + '/' + doisDigitos(d.getMonth() + 1);

                    linhas += '<div class="d-flex align-items-center gap-2 py-1" data-linha>'
                        + '<input class="form-check-input mt-0 flex-shrink-0" type="checkbox" name="datas" value="' + valor + '" checked />'
                        + '<span class="flex-grow-1 small">' + rotulo + '</span>'
                        + '<input type="time" class="form-control form-control-sm" style="width: 108px;"'
                        + ' value="' + doisDigitos(d.getHours()) + ':' + doisDigitos(d.getMinutes()) + '" data-hora />'
                        + '</div>';
                }

                $listaDatas.html(linhas);
                contar();
            }

            // Mudar a hora de UMA data: a semana em que a quadra só tem 9h não obriga a
            // remarcar a série inteira.
            $listaDatas.on('change', 'input[data-hora]', function () {
                var $linha = $(this).closest('[data-linha]');
                var $check = $linha.find('input[name="datas"]');
                var hora = this.value || '00:00';
                $check.val($check.val().substring(0, 11) + hora);
                // Mexeu na hora, é porque quer essa data: desmarcada, o ajuste não iria a lugar nenhum.
                $check.prop('checked', true);
                contar();
            });

            $listaDatas.on('change', 'input[name="datas"]', contar);

            $checkRecorrente.on('change', function () {
                $grupoSemanas.toggle(this.checked);
                if (this.checked) gerarDatas();
            });

            // ── Prazo da série ───────────────────────────────────────────────────────────
            // Sem prazo, a lista de datas some: não existe lista pra uma série que não acaba,
            // e deixar os checkboxes na tela faria o professor achar que só aquelas valem.
            var $blocoContado = $('#bloco-prazo-contado');
            var $blocoIndeterminado = $('#bloco-prazo-indeterminado');

            $('input[name="semPrazo"]').on('change', function () {
                var indeterminado = $('#prazo-indeterminado').prop('checked');
                $blocoContado.toggle(!indeterminado);
                $blocoIndeterminado.toggle(indeterminado);
                if (!indeterminado) gerarDatas();
            });

            // ── O dia da semana sai daqui em 25/08/2026 ──────────────────────────────────
            // Ele continua embaixo do campo — quem escreve agora é wwwroot/js/dia-da-semana.js,
            // pedido pelo `data-dia-da-semana` do <input>. Foi pra lá quando as telas de Editar
            // e de encaixe ganharam calendário: três cópias da mesma régua é como duas passam a
            // discordar, e a discordância aqui é muda (a data errada não dá erro nenhum).

            // ── Quando a aula termina ────────────────────────────────────────────────────
            // O professor escolhe o começo e a duração; quem erra o encaixe na quadra é quem
            // não vê o fim. A conta é a mesma de Services/DuracaoDaAula.
            var $selectDuracao = $('#select-duracao');
            var $avisoFim = $('#aviso-fim-aula');

            function mostrarFim() {
                var base = baseDataHora();
                var minutos = parseInt($selectDuracao.val(), 10);
                if (!base || !minutos) { $avisoFim.text(''); return; }

                var inicio = new Date(base);
                if (isNaN(inicio)) { $avisoFim.text(''); return; }

                var fim = new Date(inicio.getTime() + minutos * 60000);
                $avisoFim.text('Termina às ' + doisDigitos(fim.getHours()) + ':' + doisDigitos(fim.getMinutes()) + '.');
            }

            $selectDuracao.on('change', mostrarFim);
            $inputData.add($inputHora).on('change', mostrarFim);

            // Regerar quando a base muda descarta o que ele já tinha desmarcado — é o certo:
            // mudou o dia da semana, as datas velhas não valem mais.
            $inputData.add($inputHora).on('change', function () { if ($checkRecorrente.prop('checked')) gerarDatas(); });
            $inputSemanas.on('change input', gerarDatas);

            // Mesma conta do servidor (Services/PrecoDaAula): sem preço pro tamanho pedido,
            // cai pro tamanho menor mais próximo que o professor informou. Se as duas contas
            // discordarem, o professor vê um valor e salva outro.
            // Mesma queda degrau a degrau do servidor (Services/PrecoDaAula.DoLocal): sem
            // preço pro tamanho pedido, vale o maior tamanho MENOR que o professor anunciou.
            // Divergir daqui faria a tela mostrar um valor e o banco gravar outro.
            function precoDoLocal(local, quantos) {
                for (var t = quantos; t >= 2; t--) {
                    if (local.turmas && local.turmas[t] != null) return local.turmas[t];
                }
                return local.individual;
            }

            var ROTULOS = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                Enumerable.Range(PrecoDaAula.MinAlunos, PrecoDaAula.MaxAlunos - PrecoDaAula.MinAlunos + 1)
                    .ToDictionary(n => n.ToString(), n => PrecoDaAula.Rotulo(n))));

            // O acordo particular vale na aula INDIVIDUAL daquele aluno: o desconto foi dado a
            // uma pessoa, não à quadra inteira. Em dupla ou trio manda o preço do tamanho.
            //
            // Com aluno escolhido da lista a chave é a CONTA dele; sem conta, o nome. É a
            // mesma regra do servidor (Services/PrecoDaAula.Chave) — se divergir, o professor
            // vê um valor na tela e grava outro.
            function combinadoDoNome(nome) {
                var id = $inputAlunoId.val();
                var chave = id ? ('aluno-' + id) : ('avulso-' + (nome || '').trim().toLowerCase());
                return Object.prototype.hasOwnProperty.call(COMBINADOS, chave) ? COMBINADOS[chave] : null;
            }

            function atualizarSugestao() {
                var local = LOCAIS[$selectLocal.val()];

                // Fora do `if` de propósito: o nome do tamanho é do tamanho, não do local —
                // quem marca "6" antes de escolher a quadra tem que ler "Em sexteto" na hora.
                $('#rotulo-tamanho').text(
                    ROTULOS[parseInt($('input[name="quantidadeAlunos"]:checked').val(), 10) || 1] || '');

                if (!local) {
                    $inputPreco.attr('placeholder', '');
                    $avisoCombinado.addClass('d-none');
                    return;
                }

                var quantos = parseInt($('input[name="quantidadeAlunos"]:checked').val(), 10) || 1;
                var combinado = quantos === 1 ? combinadoDoNome($inputNome.val()) : null;
                var preco = combinado !== null ? combinado : precoDoLocal(local, quantos);

                $inputPreco.attr('placeholder', 'R$ ' + Number(preco).toFixed(2));

                $avisoCombinado.toggleClass('d-none', combinado === null);
                if (combinado !== null) {
                    $avisoCombinado.text('Preço combinado com esse aluno: R$ ' + Number(combinado).toFixed(2) + '.');
                }
            }

            $selectLocal.on('change', atualizarSugestao);
            $('input[name="quantidadeAlunos"]').on('change', function () {
                atualizarSugestao();
                renderizarBlocosDeTurma();
            });

            // ── Turma: um bloco de nome por aluno ───────────────────────────────────────
            // "Em dupla/trio/..." deixa de ser um nome só com o resto anotado à parte — cada
            // aluno tem o campo dele, e o servidor racha o preço da turma entre os N
            // (PrecoDaAula.DivididoIgualmente). Trocar o tamanho reconstrói os blocos do
            // zero: preencheu 3 e voltou pra 2, não tem "qual dos três eu descarto" — some
            // tudo e o professor preenche de novo, que é 2 toques, não um dilema.
            var $blocoUnico = $('#bloco-aluno-unico');
            var $blocosTurma = $('#blocos-turma');

            function blocoTurmaHtml(indice) {
                return '<div class="mb-3 p-3 border rounded" style="background: var(--pdz-surface-alt);" data-indice="' + indice + '">'
                    + '<label class="form-label fw-bold text-muted small">Aluno ' + (indice + 1) + '</label>'
                    + '<input type="text" name="nomesAlunos" class="form-control bg-light nome-turma"'
                    + ' required maxlength="100" autocomplete="off" placeholder="Digite pra buscar entre os seus alunos" />'
                    + '<input type="hidden" name="alunoIds" class="id-turma" value="" />'
                    + '<div class="list-group mt-1 d-none lista-turma" style="max-height: 200px; overflow-y: auto;"></div>'
                    + '<input type="text" name="telefonesAlunos" class="form-control bg-light mt-2 telefone-turma"'
                    + ' data-mascara="celular" inputmode="numeric" placeholder="Telefone / WhatsApp (opcional)" />'
                    + '</div>';
            }

            function renderizarBlocosDeTurma() {
                var quantos = parseInt($('input[name="quantidadeAlunos"]:checked').val(), 10) || 1;

                if (quantos <= 1) {
                    $blocosTurma.addClass('d-none').empty();
                    $blocoUnico.removeClass('d-none');
                    $inputNome.prop('required', true);
                    return;
                }

                $blocoUnico.addClass('d-none');
                $inputNome.prop('required', false);

                var html = '';
                for (var i = 0; i < quantos; i++) html += blocoTurmaHtml(i);
                $blocosTurma.html(html).removeClass('d-none');

                // A máscara de celular (js/mascaras.js) só varre a página no carregamento;
                // estes campos acabaram de nascer, então precisam ser religados na mão.
                if (window.aplicarMascarasEm) window.aplicarMascarasEm($blocosTurma[0]);
            }

            $blocosTurma.on('input', '.nome-turma', function () {
                var $bloco = $(this).closest('[data-indice]');
                $bloco.find('.id-turma').val('');
                filtrarNoBloco($bloco);
            });

            $blocosTurma.on('focus', '.nome-turma', function () {
                filtrarNoBloco($(this).closest('[data-indice]'));
            });

            function filtrarNoBloco($bloco) {
                var $nome = $bloco.find('.nome-turma');
                var $lista = $bloco.find('.lista-turma');
                var termo = semAcento($nome.val());
                if (!termo) { $lista.addClass('d-none'); return; }

                var achados = MEUS_ALUNOS.filter(function (a) {
                    return semAcento(a.nome).indexOf(termo) >= 0;
                }).slice(0, 8);

                $lista.empty();
                if (!achados.length) { $lista.addClass('d-none'); return; }

                achados.forEach(function (a) {
                    $(linha(a)).on('click', function () {
                        $nome.val(a.nome);
                        $bloco.find('.id-turma').val(a.alunoId || '');
                        var $telefone = $bloco.find('.telefone-turma');
                        if (a.celular && !$telefone.val()) $telefone.val(a.celular);
                        $lista.addClass('d-none');
                    }).appendTo($lista);
                });
                $lista.removeClass('d-none');
            }

            $(document).on('click', function (e) {
                if (!$(e.target).closest('.nome-turma, .lista-turma').length) {
                    $blocosTurma.find('.lista-turma').addClass('d-none');
                }
            });

            // ── Atalho dos alunos ────────────────────────────────────────────────────────
            // O professor marca a aula PELO aluno, e antes disto redigitava nome e telefone
            // toda vez — inclusive pro aluno de toda terça. A lista dele vem pronta do
            // servidor; procurar no cadastro do site é botão, nunca por tecla.

            function selo(a) {
                if (a.recorrente) return '<span class="badge bg-success-subtle text-success-emphasis ms-1">aluno recorrente</span>';
                if (a.temConta || a.alunoId) return '<span class="badge bg-secondary-subtle text-secondary-emphasis ms-1">tem conta</span>';
                return '';
            }

            // A legenda não repete o que o selo já disse. Quem vem da busca não tem contagem
            // de aulas, então ali o útil é o apelido ou o telefone — serve pra distinguir dois
            // homônimos, que é a única dúvida real nessa hora.
            function linha(a) {
                var sub = a.total
                    ? (a.total + (a.total === 1 ? ' aula' : ' aulas'))
                    : (a.apelido || a.celular || '');
                return '<button type="button" class="list-group-item list-group-item-action py-2">'
                    + '<span class="fw-semibold">' + $('<div>').text(a.nome).html() + '</span>'
                    + selo(a)
                    + (sub ? '<div class="small text-muted">' + $('<div>').text(sub).html() + '</div>' : '')
                    + '</button>';
            }

            function mostrarLista(itens) {
                $listaAlunos.empty();
                if (!itens.length) { $listaAlunos.addClass('d-none'); return; }

                itens.slice(0, 12).forEach(function (a) {
                    $(linha(a)).on('click', function () { escolher(a); }).appendTo($listaAlunos);
                });
                $listaAlunos.removeClass('d-none');
            }

            function escolher(a) {
                escolhendo = true;
                $inputNome.val(a.nome);
                $inputAlunoId.val(a.alunoId || '');
                // Só preenche o telefone se estiver vazio: o que o professor digitou na mão
                // vale mais que o do cadastro, que pode estar velho.
                if (a.celular && !$inputTelefone.val()) $inputTelefone.val(a.celular);

                $listaAlunos.addClass('d-none');
                $btnBuscar.addClass('d-none');
                $escolhido
                    .removeClass('d-none')
                    .html(a.alunoId
                        ? '<i class="bi bi-person-check-fill text-success"></i> Aula ligada à conta de <strong>'
                          + $('<div>').text(a.nome).html() + '</strong> — ele vai ver no app dele.'
                        : '<i class="bi bi-person"></i> <strong>' + $('<div>').text(a.nome).html()
                          + '</strong> ainda não tem conta no Padelizou.');
                atualizarSugestao();
                escolhendo = false;
            }

            function filtrarLocal() {
                var termo = semAcento($inputNome.val());
                if (!termo) { $listaAlunos.addClass('d-none'); $btnBuscar.addClass('d-none'); return; }

                var achados = MEUS_ALUNOS.filter(function (a) {
                    return semAcento(a.nome).indexOf(termo) >= 0;
                });
                mostrarLista(achados);

                // A porta pro cadastro do site aparece quando a lista dele não resolve.
                $btnBuscar.toggleClass('d-none', termo.length < 3);
            }

            function semAcento(t) {
                return (t || '').normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().trim();
            }

            $inputNome.on('input', function () {
                if (escolhendo) return;
                // Mudou o nome depois de escolher: deixou de ser aquela pessoa, e manter o
                // vínculo penduraria a aula na conta errada.
                $inputAlunoId.val('');
                $escolhido.addClass('d-none');
                filtrarLocal();
                atualizarSugestao();
            });

            $inputNome.on('focus', filtrarLocal);

            $btnBuscar.on('click', function () {
                var $b = $(this).prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span> Procurando…');
                $.getJSON('@Url.Action("BuscarAlunoNoSistema", "Aulas")', { termo: $inputNome.val() })
                    .done(function (r) {
                        if (r.erro) { alert(r.erro); return; }
                        if (!r.encontrados || !r.encontrados.length) {
                            $listaAlunos.html('<div class="list-group-item small text-muted">'
                                + 'Ninguém com esse nome no Padelizou. Pode marcar assim mesmo — '
                                + 'quando essa pessoa criar conta, dá pra ligar o histórico a ela.</div>')
                                .removeClass('d-none');
                            return;
                        }
                        mostrarLista(r.encontrados);
                    })
                    .fail(function () { alert('Não deu pra procurar agora. Marque pelo nome mesmo.'); })
                    .always(function () { $b.prop('disabled', false).html('<i class="bi bi-search"></i> Procurar no Padelizou'); });
            });

            // Clicar fora fecha a lista, mas não quando o clique é NELA — senão o item some
            // antes do próprio clique chegar.
            $(document).on('click', function (e) {
                if (!$(e.target).closest('#lista-alunos, #input-nome-aluno, #btn-buscar-sistema').length) {
                    $listaAlunos.addClass('d-none');
                }
            });
        });
    </script>
}
