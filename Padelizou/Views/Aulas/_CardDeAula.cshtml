@model padelizou.Models.Aula
@*
    O card de UMA aula na tela do aluno. Vale pras duas listas (próximas e anteriores) —
    duas cópias do mesmo HTML é como as duas metades da tela começam a discordar.

    Quem decide o que é "próxima" é o PoliticaAula, o mesmo que o controller usa pra separar
    as listas: o card não pode achar que a aula já passou enquanto a lista diz que não.
*@
@{
    var aula = Model;
    var aindaVai = Padelizou.Services.PoliticaAula.AindaVaiAcontecer(aula, DateTime.Now);

    var badgeClass = aula.Status switch
    {
        "Pendente" => "bg-warning text-dark",
        "Confirmada" => "bg-primary",
        "Realizada" => "bg-success",
        _ => "bg-danger"
    };

    var mensagemWhats = $"Olá, Prof. {aula.Professor.Nome}! Tudo certo para o nosso treino dia {aula.DataHora:dd/MM}?";
    var linkWhatsApp = WhatsAppLinkHelper.GerarLink(aula.Professor.Celular, mensagemWhats);
}

<div class="col-md-6 col-lg-4 mb-4">
    <div class="card shadow-sm border-0 h-100" style="border-left: 5px solid var(--pdz-navy-fixed);">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="badge @badgeClass text-uppercase shadow-sm">@aula.Status</span>
                @* Até quando o aluno tem que segurar a agenda: a aula pode ser
                   de 1h30 ou 2h, e só a hora de início não diz isso. *@
                <span class="text-muted fw-bold small">
                    <i class="bi bi-clock-history"></i>
                    @aula.DataHora.ToString("dd/MM/yyyy") · @Padelizou.Services.DuracaoDaAula.Faixa(aula.DataHora, aula.DuracaoMinutos)
                </span>
            </div>

            <h5 class="fw-bold mb-1" style="color: var(--pdz-ink);">
                @if (!string.IsNullOrEmpty(aula.Professor.FotoPerfil))
                {
                    <img src="@aula.Professor.FotoPerfil" alt="Prof" class="rounded-circle me-2" style="width: 30px; height: 30px; object-fit: cover;" />
                }
                else
                {
                    <i class="bi bi-person-video3 text-muted me-1"></i>
                }
                Prof. @aula.Professor.Nome
            </h5>

            <p class="text-muted small mb-1">
                <i class="bi bi-geo-alt-fill text-danger"></i> @aula.LocalAula.Nome
            </p>
            <p class="text-muted small mb-3">
                <i class="bi bi-cash text-success"></i> @aula.Preco.ToString("C")
            </p>

            @* Só enquanto a aula ainda vai acontecer. O pedido que ficou pra trás sem
               resposta continua "Pendente" pra sempre, e dizer "aguardando confirmação"
               de uma aula de semana passada é prometer uma resposta que não vem mais. *@
            @if (aindaVai && aula.Status == "Pendente")
            {
                <p class="small text-warning-emphasis mb-2"><i class="bi bi-hourglass-split"></i> Aguardando confirmação do professor</p>
            }

            <a href="@linkWhatsApp" target="_blank" class="btn btn-sm btn-outline-success rounded-pill w-100 fw-bold">
                <i class="bi bi-whatsapp"></i> Falar com o Professor
            </a>
            <a asp-action="Anotacoes" asp-route-id="@aula.Id" class="btn btn-sm btn-outline-secondary rounded-pill w-100 fw-bold mt-1">
                <i class="bi bi-journal-text"></i> Anotações da aula
            </a>
        </div>
    </div>
</div>
