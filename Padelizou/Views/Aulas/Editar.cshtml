@model Aula
@{
    ViewData["Title"] = "Editar Aula - Padelizou";

    var locais = ViewBag.Locais as List<LocalAula> ?? new List<LocalAula>();

    string NomeDoAluno(Aula a) => a.NomeCompletoAluno ?? a.Aluno?.Nome ?? a.NomeAlunoAvulso ?? "Aluno avulso";

    // A tabela de preços de cada local vai inteira pro JS, igual à tela de adicionar: trocar o
    // local não pode depender de rede, senão na quadra com sinal ruim a sugestão não aparece.
    var tabelaDeLocais = locais.ToDictionary(
        l => l.Id,
        l => new { individual = l.PrecoPadrao, turmas = PrecoDaAula.PorTamanho(l.PrecosDeTurma) });
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <a asp-action="MinhaAgenda" asp-route-data="@Model.DataHora.ToString("yyyy-MM-dd")"
               class="btn btn-outline-secondary rounded-pill mb-3">
                <i class="bi bi-arrow-left"></i> Voltar à Agenda
            </a>

            <div class="card shadow-sm border-0" style="border-top: 4px solid var(--padel-green);">
                <div class="card-body p-4 p-md-5">
                    <div class="text-center mb-4">
                        <i class="bi bi-pencil-square display-4" style="color: var(--padel-green);"></i>
                        <h3 class="fw-bold mt-2" style="color: var(--pdz-ink);">Editar aula</h3>
                        <p class="text-muted mb-0">
                            Aula de <strong>@NomeDoAluno(Model)</strong>
                            @if (Model.QuantidadeAlunos > 1)
                            {
                                <span>· @PrecoDaAula.Rotulo(Model.QuantidadeAlunos).ToLowerInvariant()</span>
                            }
                        </p>
                    </div>

                    @if (TempData["Erro"] != null)
                    {
                        <div class="alert alert-danger">@TempData["Erro"]</div>
                    }

                    @* A série existe pra criar várias de uma vez, não pra andarem juntas pra
                       sempre. Mudar as 12 porque uma virou 9h seria pior do que o problema —
                       mas o professor precisa saber que as outras ficam onde estão. *@
                    @if (Model.RecorrenciaId != null)
                    {
                        <div class="alert alert-info small">
                            <i class="bi bi-arrow-repeat"></i>
                            Esta aula faz parte de uma série semanal. A mudança vale
                            <strong>só para esta data</strong> — as outras seguem como estão.
                            @if (Model.RecorrenciaSemFim)
                            {
                                <div class="mt-2">
                                    A série é <strong>sem prazo</strong>: novas semanas entram na agenda sozinhas.
                                </div>
                                <form asp-action="EncerrarRepeticao" method="post" class="mt-2"
                                      onsubmit="return confirm('Parar de repetir essa aula fixa? As aulas já marcadas continuam na agenda.');">
                                    <input type="hidden" name="aulaId" value="@Model.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill">
                                        <i class="bi bi-stop-circle"></i> Encerrar a repetição
                                    </button>
                                </form>
                            }
                        </div>
                    }

                    <form asp-action="Editar" method="post">
                        <input type="hidden" name="aulaId" value="@Model.Id" />

                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted small">Local</label>
                            <select id="select-local" name="localId" class="form-select bg-light" required>
                                @foreach (var local in locais)
                                {
                                    <option value="@local.Id" selected="@(local.Id == Model.LocalAulaId)">
                                        @local.Nome@(local.Ativo ? "" : " (desativado)")
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted small">Data e hora</label>
                            @* O formato tem que ser o do HTML (yyyy-MM-ddTHH:mm) e não o do
                               pt-BR: com "09/08/2026 22:00" o navegador considera o valor
                               inválido e abre o campo VAZIO, sem reclamar de nada. *@
                            <input type="datetime-local" name="dataHora" class="form-control bg-light"
                                   value="@Model.DataHora.ToString("yyyy-MM-ddTHH:mm")" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted small" for="select-duracao">Duração</label>
                            <select name="duracaoMinutos" id="select-duracao" class="form-select bg-light">
                                @foreach (var minutos in Padelizou.Services.DuracaoDaAula.Opcoes)
                                {
                                    <option value="@minutos" selected="@(minutos == Model.DuracaoMinutos)">
                                        @Padelizou.Services.DuracaoDaAula.Rotulo(minutos)
                                    </option>
                                }
                            </select>
                            <div class="form-text">
                                Hoje: @Padelizou.Services.DuracaoDaAula.Faixa(Model.DataHora, Model.DuracaoMinutos).
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted small">Valor da aula</label>
                            @* DinheiroNoCampo, e não @Model.Preco direto: com a cultura pt-BR
                               isto escreveria "110,00", que é valor inválido num
                               <input type="number"> — o campo abriria vazio e o professor
                               "confirmaria" um preço que ele nunca digitou. *@
                            <input type="number" step="0.01" min="0" name="preco" id="input-preco"
                                   class="form-control bg-light"
                                   value="@DinheiroNoCampo.Valor(Model.Preco)" required />
                            <div class="form-text" id="aviso-preco"></div>
                        </div>

                        <button type="submit" class="btn btn-padel w-100 rounded-pill fw-bold py-2">
                            <i class="bi bi-check-circle"></i> Salvar mudanças
                        </button>
                    </form>

                    @if (Model.AlunoId != null)
                    {
                        <p class="small text-muted text-center mt-3 mb-0">
                            <i class="bi bi-bell"></i> O aluno é avisado automaticamente quando o
                            horário ou o local mudam.
                        </p>
                    }
                    else
                    {
                        <p class="small text-muted text-center mt-3 mb-0">
                            <i class="bi bi-whatsapp"></i> Esse aluno não tem conta no Padelizou —
                            depois de salvar, a agenda te dá a mensagem pronta pra avisar.
                        </p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var LOCAIS = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(tabelaDeLocais));
            var QUANTOS = @PrecoDaAula.Tamanho(Model.QuantidadeAlunos);

            var $select = document.getElementById('select-local');
            var $aviso = document.getElementById('aviso-preco');

            // Só SUGERE: trocar o valor sozinho apagaria o acordo particular com aquele aluno
            // ("o Pedro paga 90"), que é justamente o que não está na tabela do local.
            function sugerir() {
                var local = LOCAIS[$select.value];
                if (!local) { $aviso.textContent = ''; return; }

                // Queda degrau a degrau, igual ao servidor (Services/PrecoDaAula.DoLocal).
                var preco = local.individual;
                for (var t = QUANTOS; t >= 2; t--) {
                    if (local.turmas && local.turmas[t] != null) { preco = local.turmas[t]; break; }
                }

                $aviso.textContent = 'Tabela deste local: R$ ' + Number(preco).toFixed(2).replace('.', ',');
            }

            $select.addEventListener('change', sugerir);
            sugerir();
        })();
    </script>
}
