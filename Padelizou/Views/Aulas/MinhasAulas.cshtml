@model Padelizou.ViewModels.MinhasAulasVM
@{
    ViewData["Title"] = "Aulas marcadas - Padelizou";
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-0" style="color: var(--pdz-ink);">Minhas aulas</h2>
            <p class="text-muted mb-0">O que está marcado e o que já aconteceu.</p>
        </div>
        <a asp-controller="Auth" asp-action="Perfil" class="btn btn-outline-secondary rounded-pill">Voltar ao Perfil</a>
    </div>

    <partial name="_AbasDaAula" />

    @* PRÓXIMAS PRIMEIRO, da mais perto pra mais longe. É a única pergunta que a pessoa leva
       pra esta tela — o histórico ela olha por curiosidade, não com a agenda na mão. *@
    <h5 class="fw-bold mt-4 mb-3" style="color: var(--pdz-ink);">
        <i class="bi bi-calendar-check"></i> Próximas
        @if (Model.Proximas.Any())
        {
            <span class="text-muted fw-normal">(@Model.Proximas.Count)</span>
        }
    </h5>

    @if (Model.Proximas.Any())
    {
        <div class="row">
            @foreach (var aula in Model.Proximas)
            {
                <partial name="_CardDeAula" model="aula" />
            }
        </div>
    }
    else
    {
        <div class="text-center py-4 rounded-3 mb-4" style="border: 2px dashed var(--pdz-border);">
            <i class="bi bi-calendar2-minus display-6 text-muted"></i>
            <p class="text-muted mb-1 mt-2">Nenhuma aula marcada.</p>
            <a asp-controller="Aulas" asp-action="Solicitar" class="btn btn-sm btn-padel rounded-pill px-4 mt-2 fw-bold">
                Marcar uma aula
            </a>
        </div>
    }

    @if (Model.Anteriores.Any())
    {
        @* "Histórico", e não "já aconteceram": aqui também cai a aula FUTURA que foi
           desmarcada ou recusada — ela não aconteceu nem vai acontecer, e o título tem que
           valer pras duas coisas. *@
        <h5 class="fw-bold mt-4 mb-3" style="color: var(--pdz-ink);">
            <i class="bi bi-clock-history"></i> Histórico
            <span class="text-muted fw-normal">(@Model.Anteriores.Count)</span>
        </h5>

        <div class="row">
            @foreach (var aula in Model.Anteriores)
            {
                <partial name="_CardDeAula" model="aula" />
            }
        </div>
    }
</div>
