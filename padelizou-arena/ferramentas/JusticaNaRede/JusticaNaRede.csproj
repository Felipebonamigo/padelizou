<Project Sdk="Microsoft.NET.Sdk">
  <!-- Justiça na rede: o mesmo humano simulado no local, no host e no cliente, sob latência simulada (docs/JUSTICA-NA-REDE.md). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Padel.Core/Padel.Core.csproj" />
  </ItemGroup>
</Project>
